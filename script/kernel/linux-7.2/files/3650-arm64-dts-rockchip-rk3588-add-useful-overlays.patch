diff --speed-large-files --no-dereference --minimal -Naur linux-7.1.4/arch/arm64/boot/dts/rockchip/overlay/rockchip-rk3588-gpu-opp-allow-1ghz-opp-at-low-bins.dtso linux-7.1.4/arch/arm64/boot/dts/rockchip/overlay/rockchip-rk3588-gpu-opp-allow-1ghz-opp-at-low-bins.dtso
--- linux-7.1.4/arch/arm64/boot/dts/rockchip/overlay/rockchip-rk3588-gpu-opp-allow-1ghz-opp-at-low-bins.dtso	1970-01-01 01:00:00.000000000 +0100
+++ linux-7.1.4/arch/arm64/boot/dts/rockchip/overlay/rockchip-rk3588-gpu-opp-allow-1ghz-opp-at-low-bins.dtso	2026-07-24 10:03:28.644830787 +0200
@@ -0,0 +1,20 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+// DTS overlay: raise GPU OPP voltages to reach 900/1000 MHz
+// The PVTPLL ring oscillator frequency is voltage-dependent.
+// Default OPP voltages (825/875 mV) are too low for the PVTPLL
+// to produce 900/1000 MHz, causing BL31 to fall back to NPLL at 850 MHz.
+
+/dts-v1/;
+/plugin/;
+
+&{/opp-table-gpu} {
+	opp-900000000 {
+		opp-hz = /bits/ 64 <900000000>;
+		opp-microvolt = <900000 900000 950000>;
+	};
+
+	opp-1000000000 {
+		opp-hz = /bits/ 64 <1000000000>;
+		opp-microvolt = <950000 950000 950000>;
+	};
+};
