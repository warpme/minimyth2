+static int codec_h264_multi_host_config(struct amvdec_session *sess);
+
+/* Cache request controls for per-picture hardware programming. */
+void meson_amvdec_codec_h264_multi_set_params(struct amvdec_session *sess,
+				 const struct v4l2_ctrl_h264_sps *sps,
+				 const struct v4l2_ctrl_h264_pps *pps,
+				 const struct v4l2_ctrl_h264_decode_params *dec)
+{
+	struct codec_h264 *h264 = sess->priv;
+	struct amvdec_core *core = sess->core;
+	u32 cfg, frame_size, max_refs, max_list, pic_h_mbs;
+	u32 req_width_mbs, req_height_mbs, fmt_width_mbs, fmt_height_mbs;
+
+	if (!h264 || !h264->open_vaddr)
+		return;
+
+	h264->multi_pic_top_poc = dec->top_field_order_cnt;
+	h264->multi_pic_bottom_poc = dec->bottom_field_order_cnt;
+	h264->multi_sps_max_refs = sps->max_num_ref_frames;
+	h264->multi_sps = *sps;
+	h264->multi_pps = *pps;
+	memset(&h264->multi_request_picture, 0, sizeof(h264->multi_request_picture));
+	h264->multi_request_picture.frame_num = dec->frame_num;
+	h264->multi_request_picture.pps_id = pps->pic_parameter_set_id;
+	h264->multi_request_picture.idr = !!(dec->flags & V4L2_H264_DECODE_PARAM_FLAG_IDR_PIC);
+	h264->multi_request_picture.idr_pic_id = dec->idr_pic_id;
+	h264->multi_request_picture.nal_ref_idc = dec->nal_ref_idc;
+	h264->multi_request_picture.field_pic =
+		!!(dec->flags & V4L2_H264_DECODE_PARAM_FLAG_FIELD_PIC);
+	h264->multi_request_picture.bottom_field =
+		!!(dec->flags & V4L2_H264_DECODE_PARAM_FLAG_BOTTOM_FIELD);
+	if (sps->pic_order_cnt_type == 0) {
+		h264->multi_request_picture.poc_lsb = dec->pic_order_cnt_lsb;
+		if (!h264->multi_request_picture.field_pic &&
+		    (pps->flags & V4L2_H264_PPS_FLAG_BOTTOM_FIELD_PIC_ORDER_IN_FRAME_PRESENT))
+			h264->multi_request_picture.delta_poc_bottom =
+				dec->delta_pic_order_cnt_bottom;
+	} else if (sps->pic_order_cnt_type == 1 &&
+		   !(sps->flags & V4L2_H264_SPS_FLAG_DELTA_PIC_ORDER_ALWAYS_ZERO)) {
+		h264->multi_request_picture.delta_poc[0] = dec->delta_pic_order_cnt0;
+		if (!h264->multi_request_picture.field_pic &&
+		    (pps->flags & V4L2_H264_PPS_FLAG_BOTTOM_FIELD_PIC_ORDER_IN_FRAME_PRESENT))
+			h264->multi_request_picture.delta_poc[1] = dec->delta_pic_order_cnt1;
+	}
+	memcpy(h264->multi_dpb, dec->dpb, sizeof(h264->multi_dpb));
+	h264->multi_nal_ref_idc = dec->nal_ref_idc;
+	h264->multi_pic_valid = true;
+	h264->multi_params_error = 0;
+
+	/*
+	 * With frame_mbs_only_flag = 0 the SPS counts map units, which are
+	 * field height: FrameHeightInMbs is twice PicHeightInMapUnits (7-18).
+	 * Using it directly would size an MBAFF frame at half its height.
+	 */
+	pic_h_mbs = sps->pic_height_in_map_units_minus1 + 1;
+	if (!(sps->flags & V4L2_H264_SPS_FLAG_FRAME_MBS_ONLY))
+		pic_h_mbs *= 2;
+	req_width_mbs = sps->pic_width_in_mbs_minus1 + 1;
+	req_height_mbs = pic_h_mbs;
+	fmt_width_mbs = DIV_ROUND_UP(sess->width, 16);
+	fmt_height_mbs = DIV_ROUND_UP(sess->height, 16);
+	if (!fmt_width_mbs || !fmt_height_mbs ||
+	    req_width_mbs > fmt_width_mbs || req_height_mbs > fmt_height_mbs ||
+	    (h264->multi_geometry_valid &&
+	     (req_width_mbs != h264->multi_geometry_width_mbs ||
+	      req_height_mbs != h264->multi_geometry_height_mbs))) {
+		dev_warn_ratelimited(core->dev_dec,
+				     "h264 multi: rejected SPS geometry %ux%u MBs for negotiated %ux%u MBs (active %ux%u MBs)\n",
+			req_width_mbs, req_height_mbs,
+			fmt_width_mbs, fmt_height_mbs,
+			h264->multi_geometry_valid ? h264->multi_geometry_width_mbs : 0,
+			h264->multi_geometry_valid ? h264->multi_geometry_height_mbs : 0);
+		h264->multi_pic_valid = false;
+		h264->multi_params_error = -EINVAL;
+		return;
+	}
+	h264->multi_geometry_valid = true;
+	h264->multi_geometry_width_mbs = req_width_mbs;
+	h264->multi_geometry_height_mbs = req_height_mbs;
+	frame_size = (sps->pic_width_in_mbs_minus1 + 1) * pic_h_mbs;
+	cfg = (h264_flag(sps->flags, V4L2_H264_SPS_FLAG_FRAME_MBS_ONLY) << 31) |
+	      (sps->max_num_ref_frames << 24) | (frame_size << 8) |
+	      (sps->pic_width_in_mbs_minus1 + 1);
+
+	h264->multi_sps_mbaff = !(sps->flags & V4L2_H264_SPS_FLAG_FRAME_MBS_ONLY) &&
+			    !!(sps->flags & V4L2_H264_SPS_FLAG_MB_ADAPTIVE_FRAME_FIELD);
+	/*
+	 * The decoder applies frame implicit weights to MBAFF field pairs,
+	 * without the per-field weights required by H.264 8.4.2.3.1.
+	 */
+	if (h264->multi_sps_mbaff && pps->weighted_bipred_idc == 2)
+		dev_warn_once(core->dev_dec,
+			      "H.264 MBAFF with implicit weighted bi-prediction is not bit-exact on this hardware\n");
+	h264->mb_width = (sps->pic_width_in_mbs_minus1 + 4) & ~3u;
+	h264->mb_height = (pic_h_mbs + 3) & ~3u;
+	max_refs = clamp_t(u32, sps->max_num_ref_frames, 0,
+			   V4L2_H264_NUM_DPB_ENTRIES);
+
+	max_list = (pps->num_ref_idx_l1_default_active_minus1 + 1) +
+		   (pps->num_ref_idx_l0_default_active_minus1 + 1);
+	if (max_list > max_refs)
+		max_refs = max_list;
+	h264->multi_sps_max_refs = max_refs;
+
+	dev_dbg(core->dev_dec,
+		"h264 multi params: poc=%d nrefs=%u | sps_id=%u pps_id=%u mb=%ux%u seq_cfg=%#x max_refs=%u\n",
+		 dec->top_field_order_cnt,
+		 ({
+			unsigned int k, c = 0;
+
+			for (k = 0; k < V4L2_H264_NUM_DPB_ENTRIES; k++)
+				if (dec->dpb[k].flags & V4L2_H264_DPB_ENTRY_FLAG_ACTIVE)
+					c++;
+			c;
+		 }),
+		 sps->seq_parameter_set_id, pps->pic_parameter_set_id,
+		 h264->mb_width, h264->mb_height, cfg, max_refs);
+}
+
+/* ------------------------------------------------------------------------ */
+/*                      Open firmware (oh264-sl) path                        */
+/* ------------------------------------------------------------------------ */
+
+/* Record word 2: register-bit variant the firmware selects per SoC. */
+static u16 codec_h264_open_soc(struct amvdec_core *core)
+{
+	switch (core->platform->revision) {
+	case AMVDEC_REVISION_GXBB:
+		return 0;
+	case AMVDEC_REVISION_GXL:
+	case AMVDEC_REVISION_GXLX:
+		return 1;
+	case AMVDEC_REVISION_GXM:
+		return 2;
+	case AMVDEC_REVISION_G12A:
+		return 3;
+	case AMVDEC_REVISION_SM1:
+	default:
+		return 4;
+	}
+}
+
+/* Words of the record the firmware reads: the header and @nslices slice entries. */
+static u32 codec_h264_open_rec_words(u32 nslices)
+{
+	return OH264_SLICE_TABLE + nslices * OH264_SLICE_WORDS;
+}
+
+/*
+ * LMEM DMA byte order: the four halfwords of every 8-byte group are reversed.
+ * Only the words the firmware reads are written (it fetches slice entries by
+ * index up to the count in word 12); what lies beyond is stale and unread.
+ */
+static void codec_h264_open_write_record(u16 *dst, const u16 *w, u32 words)
+{
+	u32 i;
+
+	BUILD_BUG_ON(OH264_SLICE_TABLE % 4 || OH264_SLICE_WORDS % 4);
+	for (i = 0; i < words; i += 4) {
+		dst[i + 0] = w[i + 3];
+		dst[i + 1] = w[i + 2];
+		dst[i + 2] = w[i + 1];
+		dst[i + 3] = w[i + 0];
+	}
+}
+
+static void codec_h264_open_put32(u16 *w, u32 v)
+{
+	w[0] = v & 0xffff;
+	w[1] = v >> 16;
+}
+
+static int codec_h264_open_start(struct amvdec_session *sess)
+{
+	struct codec_h264 *h264 = sess->priv;
+	struct amvdec_core *core = sess->core;
+	u32 i;
+
+	BUILD_BUG_ON(OH264_REC_WORDS != 2352);
+	BUILD_BUG_ON(OH264_REC_WORDS * 2 > 0x1400);	/* below the debug LMEM dump */
+
+	h264->open_slices = kvcalloc(OH264_MAX_SLICES, sizeof(*h264->open_slices),
+				     GFP_KERNEL);
+	h264->open_rec = kvcalloc(OH264_REC_WORDS, sizeof(*h264->open_rec), GFP_KERNEL);
+	if (!h264->open_slices || !h264->open_rec)
+		return -ENOMEM;
+
+	/*
+	 * Record at the start (8-byte aligned), then the firmware workspace
+	 * at the next 64 KiB boundary: the MC bottom-row banks are addressed
+	 * with the MB column in address bits 12:5.
+	 */
+	h264->open_size = OH264_REC_AREAS * OH264_REC_AREA + OH264_WS_ALIGN + OH264_WS_SIZE;
+	h264->open_vaddr = dma_alloc_coherent(core->dev, h264->open_size,
+					      &h264->open_paddr, GFP_KERNEL);
+	if (!h264->open_vaddr)
+		return -ENOMEM;
+	memset(h264->open_vaddr, 0, h264->open_size);
+	h264->open_ws_paddr = ALIGN(h264->open_paddr + OH264_REC_AREAS * OH264_REC_AREA,
+				    OH264_WS_ALIGN);
+	h264->pipe = h264_pipeline;
+	h264->pipe_halt = false;
+	h264->pipe_run = -1;
+	for (i = 0; i < OH264_PIPE_SLOTS; i++)
+		h264->pipe_pic[i].rec_off = i * OH264_REC_AREA;
+
+	/*
+	 * The decode-pipeline reset pulses of codec_h264_start(), once, with
+	 * the clocks running and no FIFO programmed yet (the firmware leaves
+	 * out the per-picture pulse of the vendor boot: it breaks the VLD
+	 * prefetch of an already filled FIFO).
+	 */
+	meson_amvdec_write_dos(core, DOS_SW_RESET0, BIT(7) | BIT(6) | BIT(4));
+	meson_amvdec_write_dos(core, DOS_SW_RESET0, 0);
+	meson_amvdec_read_dos(core, DOS_SW_RESET0);
+	meson_amvdec_write_dos(core, DOS_SW_RESET0, BIT(9) | BIT(8));
+	meson_amvdec_write_dos(core, DOS_SW_RESET0, 0);
+	meson_amvdec_read_dos(core, DOS_SW_RESET0);
+
+	h264->multi_powered = true;
+	h264->multi_hw_started = false;
+	dev_dbg(core->dev_dec, "h264 open fw: record=%pad workspace=%pad\n",
+		&h264->open_paddr, &h264->open_ws_paddr);
+
+	/* Colocated MV stores, one per CAPTURE slot. */
+	return codec_h264_multi_host_config(sess);
+}
+
+/*
+ * Slice header length in the escaped bytes of the NAL (after its header byte):
+ * the RBSP length plus every emulation prevention byte before the RBSP byte
+ * holding the first slice-data bit (h264_host.py header_bits_raw).
+ */
+static u32 codec_h264_open_raw_bits(const u8 *nal, u32 len, u32 rbsp_bits)
+{
+	u32 i, o = 0, zeros = 0, epb = 0, last = rbsp_bits / 8;
+
+	for (i = 1; i < len && o <= last; i++) {
+		u8 b = nal[i];
+
+		if (zeros >= 2 && b == 0x03) {
+			zeros = 0;
+			epb++;
+			continue;
+		}
+		zeros = b ? 0 : zeros + 1;
+		o++;
+	}
+	return rbsp_bits + 8 * epb;
+}
+
+/* Every slice NAL of the access unit, parsed in full. */
+static int codec_h264_open_parse(struct amvdec_session *sess)
+{
+	struct codec_h264 *h264 = sess->priv;
+	const struct v4l2_ctrl_h264_sps *sps = &h264->multi_sps;
+	const struct h264_slice_refs *pic = &h264->multi_request_picture;
+	const u8 *buf = h264->multi_slice_data;
+	u32 len = h264->multi_slice_size, cursor = 0, n = 0, prev_mb = 0;
+	u32 units;
+	int ret;
+
+	units = (sps->pic_width_in_mbs_minus1 + 1) *
+		(sps->pic_height_in_map_units_minus1 + 1);
+	if (!(sps->flags & V4L2_H264_SPS_FLAG_FRAME_MBS_ONLY) && !pic->field_pic &&
+	    !(sps->flags & V4L2_H264_SPS_FLAG_MB_ADAPTIVE_FRAME_FIELD))
+		units *= 2;
+
+	while (cursor < len) {
+		struct h264_open_slice *s;
+		const u8 *nal;
+		u32 nal_len = 0, type;
+
+		nal = h264_find_first_slice(buf + cursor, len - cursor, &nal_len);
+		if (!nal)
+			break;
+		cursor = (u32)(nal - buf) + nal_len;
+		if (n >= OH264_MAX_SLICES)
+			return -EOPNOTSUPP;
+		s = &h264->open_slices[n];
+		ret = h264_parse_slice_refs_mode(nal, nal_len, sps, &h264->multi_pps, true,
+						 &s->refs, &sess->feed.h264_parse);
+		if (ret)
+			return ret;
+		/* Redundant coded slices are dropped, as the host stand-in does. */
+		if (s->refs.redundant_pic_cnt)
+			continue;
+		type = s->refs.slice_type % 5;
+		if (!h264_same_frame_picture(&s->refs, pic) ||
+		    s->refs.first_mb >= units || (n && s->refs.first_mb <= prev_mb))
+			return -EINVAL;
+		/* Record v1 carries 16 entries per list. */
+		if (type != 2 && (!s->refs.num_ref_idx_active[0] ||
+				  s->refs.num_ref_idx_active[0] > OH264_LIST_LEN))
+			return -EOPNOTSUPP;
+		if (type == 1 && (!s->refs.num_ref_idx_active[1] ||
+				  s->refs.num_ref_idx_active[1] > OH264_LIST_LEN))
+			return -EOPNOTSUPP;
+		s->nal_off = (u32)(nal - buf);
+		s->nal_len = nal_len;
+		s->raw_bits = codec_h264_open_raw_bits(nal, nal_len, s->refs.header_bits);
+		prev_mb = s->refs.first_mb;
+		n++;
+	}
+	if (!n)
+		return -EINVAL;
+	h264->open_nslices = n;
+	return 0;
+}
+
+/*
+ * VIFIFO content (ABI): 8 zero bytes, every slice NAL of the picture behind a
+ * 3-byte start code, an end-of-stream NAL, then zeros the VLD may read ahead
+ * into.  Copied into a driver-owned buffer: the OUTPUT buffer can carry other
+ * NAL units and has no room reserved before its first start code.
+ */
+static void codec_h264_open_fifo_free(struct amvdec_core *core, struct h264_open_fifo *f)
+{
+	if (f->vaddr)
+		dma_free_coherent(core->dev, f->size, f->vaddr, f->paddr);
+	f->vaddr = NULL;
+	f->size = 0;
+	f->payload = 0;
+}
+
+static int codec_h264_open_fifo(struct amvdec_session *sess, struct h264_open_fifo *f)
+{
+	static const u8 eos[] = { 0x00, 0x00, 0x00, 0x01, 0x0b };
+	struct codec_h264 *h264 = sess->priv;
+	struct amvdec_core *core = sess->core;
+	u32 need = OH264_FIFO_LEAD + sizeof(eos), size, pos, i;
+	u8 *p;
+
+	for (i = 0; i < h264->open_nslices; i++)
+		need += 3 + h264->open_slices[i].nal_len;
+	size = ALIGN(need + OH264_FIFO_PAD + OH264_FIFO_ALIGN, SZ_64K);
+	if (size > f->size) {
+		codec_h264_open_fifo_free(core, f);
+		f->vaddr = dma_alloc_coherent(core->dev, size, &f->paddr, GFP_KERNEL);
+		if (!f->vaddr)
+			return -ENOMEM;
+		f->size = size;
+	}
+
+	p = f->vaddr;
+	memset(p, 0, OH264_FIFO_LEAD);
+	pos = OH264_FIFO_LEAD;
+	for (i = 0; i < h264->open_nslices; i++) {
+		struct h264_open_slice *s = &h264->open_slices[i];
+
+		p[pos++] = 0;
+		p[pos++] = 0;
+		p[pos++] = 1;
+		s->fifo_off = pos;
+		memcpy(p + pos, h264->multi_slice_data + s->nal_off, s->nal_len);
+		pos += s->nal_len;
+	}
+	memcpy(p + pos, eos, sizeof(eos));
+	pos += sizeof(eos);
+	memset(p + pos, 0, min_t(u32, f->size - pos,
+				 OH264_FIFO_PAD + 2 * OH264_FIFO_ALIGN));
+	f->payload = pos;
+	return 0;
+}
+
+static u32 codec_h264_open_colo(const struct codec_h264 *h264, u32 slot)
+{
+	return h264->colocate_paddr + h264->colocate_buf_size * slot;
+}
+
+/*
+ * What a reference store looks like to the firmware: vendor surface structure
+ * (parity of the first field for a field-decoded store, 2 frame, 3 MBAFF),
+ * the H264_BUFFER_INFO info0 word and its POCs, a single-field store carrying
+ * that field's POC in both halves (h264_run.py buffer_info()/pocs()).
+ */
+struct h264_open_ref {
+	u32 slot;
+	u8 structure;
+	u16 info0;
+	s32 top, bottom;
+};
+
+static void codec_h264_open_ref(struct amvdec_session *sess, u32 slot,
+				const struct v4l2_h264_dpb_entry *e,
+				struct h264_open_ref *r)
+{
+	struct codec_h264 *h264 = sess->priv;
+	const struct h264_field_surface *sf = &h264->multi_field_slots[slot];
+	bool both;
+
+	r->slot = slot;
+	r->top = e->top_field_order_cnt;
+	r->bottom = e->bottom_field_order_cnt;
+	if (sf->valid && sf->timestamp == e->reference_ts &&
+	    sf->vb2_idx == sess->fw_idx_to_vb2_idx[slot]) {
+		/* A field pair's claim records the second field's parity. */
+		r->structure = sf->structure < 2 ? h264->open_first_bottom[slot] :
+			       sf->structure;
+		both = sf->decoded_fields == V4L2_H264_FRAME_REF;
+		if (both) {
+			r->top = sf->top_poc;
+			r->bottom = sf->bottom_poc;
+		} else {
+			r->top = sf->poc;
+			r->bottom = sf->poc;
+		}
+	} else if (e->flags & V4L2_H264_DPB_ENTRY_FLAG_FIELD) {
+		r->structure = e->fields == V4L2_H264_BOTTOM_FIELD_REF ? 1 : 0;
+		both = e->fields == V4L2_H264_FRAME_REF;
+		if (!both) {
+			r->top = r->structure ? e->bottom_field_order_cnt :
+				 e->top_field_order_cnt;
+			r->bottom = r->top;
+		}
+	} else {
+		r->structure = h264->multi_sps_mbaff ? 3 : 2;
+		both = true;
+	}
+	r->info0 = 0xf400 | r->structure << 6;
+	if (both && r->bottom < r->top)
+		r->info0 |= 0x100;
+	if (e->flags & V4L2_H264_DPB_ENTRY_FLAG_LONG_TERM)
+		r->info0 |= (e->fields & V4L2_H264_TOP_FIELD_REF ? 0x10 : 0) |
+			    (e->fields & V4L2_H264_BOTTOM_FIELD_REF ? 0x20 : 0);
+}
+
+/* List bytes: slot | view << 5 (3 frame, 1 top, 2 bottom), padded with the last. */
+static int codec_h264_open_list(u16 *w, const struct h264_ref *l, u32 n, u32 active)
+{
+	u8 b[OH264_LIST_LEN] = { 0 };
+	u32 k;
+
+	if (active && !n)
+		return -EINVAL;
+	for (k = 0; k < active && k < OH264_LIST_LEN; k++) {
+		const struct h264_ref *r = &l[k < n ? k : n - 1];
+
+		b[k] = (r->fw & 0x1f) | ((r->view ? r->view : 3) << 5);
+	}
+	for (k = 0; k < OH264_LIST_LEN / 2; k++)
+		w[k] = (b[2 * k] << 8) | b[2 * k + 1];
+	return 0;
+}
+
+/* The parameter record of docs/abi-h264.md, as h264_run.py record() builds it. */
+static int codec_h264_open_record(struct amvdec_session *sess)
+{
+	struct codec_h264 *h264 = sess->priv;
+	struct amvdec_core *core = sess->core;
+	const struct v4l2_ctrl_h264_sps *sps = &h264->multi_sps;
+	const struct v4l2_ctrl_h264_pps *pps = &h264->multi_pps;
+	const struct h264_slice_refs *pic = &h264->multi_request_picture;
+	struct h264_open_ref refs[16];
+	u16 *w = h264->open_rec;
+	u32 slot = h264->multi_pic_fw_idx;
+	u32 mbw = sps->pic_width_in_mbs_minus1 + 1;
+	bool frame_mbs_only = sps->flags & V4L2_H264_SPS_FLAG_FRAME_MBS_ONLY;
+	bool field = h264->multi_field_picture;
+	bool direct8 = frame_mbs_only &&
+		       (sps->flags & V4L2_H264_SPS_FLAG_DIRECT_8X8_INFERENCE);
+	u32 unit, nd = 0, i, k;
+	s32 top = h264->multi_pic_top_poc, bottom = h264->multi_pic_bottom_poc;
+	u8 cur;
+	int ret;
+
+	if (slot >= OH264_MAX_SLOTS || !sess->fw_buf_canvas[slot])
+		return -EINVAL;
+	if (field)
+		cur = pic->bottom_field ? 1 : 0;
+	else
+		cur = h264->multi_sps_mbaff ? 3 : 2;
+	/* A first field: its own POC in both halves; a second: the pair's. */
+	if (field && !h264->multi_field_mate) {
+		top = pic->bottom_field ? bottom : top;
+		bottom = top;
+	}
+	unit = H264_COLOCATE_BYTES_PER_MB * (cur != 2 ? 2 : 1);
+
+	memset(w, 0, codec_h264_open_rec_words(h264->open_nslices) * sizeof(*w));
+	w[0] = OH264_MAGIC;
+	w[1] = OH264_VERSION;
+	w[2] = codec_h264_open_soc(core);
+	w[3] = h264_flag(sps->flags, V4L2_H264_SPS_FLAG_FRAME_MBS_ONLY) |
+	       h264_flag(sps->flags, V4L2_H264_SPS_FLAG_MB_ADAPTIVE_FRAME_FIELD) << 1 |
+	       h264_flag(sps->flags, V4L2_H264_SPS_FLAG_DIRECT_8X8_INFERENCE) << 2 |
+	       h264_flag(pps->flags, V4L2_H264_PPS_FLAG_ENTROPY_CODING_MODE) << 3 |
+	       h264_flag(pps->flags, V4L2_H264_PPS_FLAG_TRANSFORM_8X8_MODE) << 4 |
+	       h264_flag(pps->flags, V4L2_H264_PPS_FLAG_CONSTRAINED_INTRA_PRED) << 5 |
+	       h264_flag(pps->flags, V4L2_H264_PPS_FLAG_WEIGHTED_PRED) << 6 |
+	       (pps->weighted_bipred_idc & 3) << 7 |
+	       h264_flag(pps->flags, V4L2_H264_PPS_FLAG_DEBLOCKING_FILTER_CONTROL_PRESENT) << 9 |
+	       h264_flag(pps->flags,
+			 V4L2_H264_PPS_FLAG_BOTTOM_FIELD_PIC_ORDER_IN_FRAME_PRESENT) << 10 |
+	       h264_flag(pps->flags, V4L2_H264_PPS_FLAG_REDUNDANT_PIC_CNT_PRESENT) << 11 |
+	       (h264->open_scaling ? BIT(12) : 0) |
+	       (field && h264->multi_field_mate ? BIT(13) : 0) |
+	       (pic->idr ? BIT(14) : 0);
+	w[4] = field ? (pic->bottom_field ? 2 : 1) : 3;
+	w[5] = mbw;
+	w[6] = (sps->pic_height_in_map_units_minus1 + 1) * (frame_mbs_only ? 1 : 2);
+	w[7] = sps->chroma_format_idc | sps->bit_depth_luma_minus8 << 4 |
+	       sps->bit_depth_chroma_minus8 << 8 |
+	       h264_flag(sps->flags, V4L2_H264_SPS_FLAG_DELTA_PIC_ORDER_ALWAYS_ZERO) << 12;
+	w[8] = (sps->log2_max_frame_num_minus4 + 4) |
+	       (sps->log2_max_pic_order_cnt_lsb_minus4 + 4) << 5 |
+	       sps->pic_order_cnt_type << 12;
+	w[9] = sps->max_num_ref_frames | (pps->num_ref_idx_l0_default_active_minus1 + 1) << 8;
+	w[10] = (pps->num_ref_idx_l1_default_active_minus1 + 1) |
+		((pps->pic_init_qp_minus26 + 26) & 0xff) << 8;
+	w[11] = (pps->chroma_qp_index_offset & 0xff) |
+		(pps->second_chroma_qp_index_offset & 0xff) << 8;
+	w[12] = h264->multi_nal_ref_idc | h264->open_nslices << 8;
+	w[13] = pic->frame_num;
+	codec_h264_open_put32(&w[14], top);
+	codec_h264_open_put32(&w[16], bottom);
+	codec_h264_open_put32(&w[18], sess->fw_buf_canvas[slot]);
+	codec_h264_open_put32(&w[20], codec_h264_open_colo(h264, slot));
+	w[22] = slot;
+	w[23] = 0;		/* debug stop word */
+
+	/* DPB: the reference stores of the V4L2 DPB that have a CAPTURE slot. */
+	for (i = 0; i < V4L2_H264_NUM_DPB_ENTRIES && nd < ARRAY_SIZE(refs); i++) {
+		const struct v4l2_h264_dpb_entry *e = &h264->multi_dpb[i];
+		struct h264_open_ref *r = &refs[nd];
+		int fw;
+
+		if (!(e->flags & V4L2_H264_DPB_ENTRY_FLAG_ACTIVE))
+			continue;
+		fw = codec_h264_multi_ref_fw_idx(sess, e);
+		if (fw < 0 || fw >= OH264_MAX_SLOTS || !sess->fw_buf_canvas[fw] ||
+		    ((u32)fw == slot && !h264->multi_field_mate)) {
+			dev_dbg(core->dev_dec, "h264 open fw: DPB entry ts=%llu not a stored picture (slot %d)\n",
+				e->reference_ts, fw);
+			continue;
+		}
+		codec_h264_open_ref(sess, fw, e, r);
+		w[24 + 4 * nd] = BIT(0) |
+			h264_flag(e->flags, V4L2_H264_DPB_ENTRY_FLAG_LONG_TERM) << 1 |
+			(e->fields & V4L2_H264_TOP_FIELD_REF ? BIT(2) : 0) |
+			(e->fields & V4L2_H264_BOTTOM_FIELD_REF ? BIT(3) : 0) |
+			(r->structure != 2 ? BIT(4) : 0) | fw << 8;
+		w[25 + 4 * nd] = r->info0;
+		codec_h264_open_put32(&w[26 + 4 * nd], sess->fw_buf_canvas[fw]);
+		codec_h264_open_put32(&w[88 + 4 * nd], r->top);
+		codec_h264_open_put32(&w[90 + 4 * nd], r->bottom);
+		codec_h264_open_put32(&w[152 + 2 * nd], codec_h264_open_colo(h264, fw));
+		nd++;
+	}
+	codec_h264_open_put32(&w[184], h264->open_ws_paddr);
+
+	/*
+	 * Scaling lists: 6 x 16 then Y intra/inter 8 x 64 in transmitted
+	 * (zig-zag) order, two per word, first byte high.  The control holds
+	 * them in raster order with every fall-back already resolved.
+	 */
+	for (i = 0; i < 6 * 16 + 2 * 64; i += 2) {
+		u8 b[2];
+
+		for (k = 0; k < 2; k++) {
+			u32 j = i + k;
+
+			if (!h264->open_scaling)
+				b[k] = 16;
+			else if (j < 96)
+				b[k] = h264->open_sm.scaling_list_4x4[j / 16]
+						[h264_zigzag_4x4[j % 16]];
+			else
+				b[k] = h264->open_sm.scaling_list_8x8[(j - 96) / 64]
+						[h264_zigzag_8x8[(j - 96) % 64]];
+		}
+		w[192 + i / 2] = (b[0] << 8) | b[1];
+	}
+
+	/* Slice table. */
+	for (i = 0; i < h264->open_nslices; i++) {
+		const struct h264_open_slice *s = &h264->open_slices[i];
+		const struct h264_slice_refs *sr = &s->refs;
+		u16 *e = &w[OH264_SLICE_TABLE + i * OH264_SLICE_WORDS];
+		u32 type = sr->slice_type % 5;
+		u32 a0 = type != 2 ? sr->num_ref_idx_active[0] : 0;
+		u32 a1 = type == 1 ? sr->num_ref_idx_active[1] : 0;
+		u32 n0, n1, wr, rd = 0;
+
+		/* The shared builder works on multi_slice_refs. */
+		h264->multi_slice_refs = *sr;
+		ret = codec_h264_multi_build_ref_lists(sess, &n0, &n1);
+		if (ret)
+			return ret;
+
+		codec_h264_open_put32(&e[0], s->fifo_off);
+		e[2] = s->raw_bits;
+		e[3] = type == 1 ? 1 : type == 2 ? 2 : 0;
+		codec_h264_open_put32(&e[4], sr->first_mb);
+		e[6] = a0 | a1 << 8;
+		e[7] = sr->cabac_init_idc | sr->direct_spatial_mv_pred << 4 |
+		       sr->disable_deblocking_filter_idc << 8;
+		e[8] = ((u8)sr->slice_qp_delta) |
+		       ((u8)sr->slice_alpha_c0_offset_div2 & 0xf) << 8 |
+		       ((u8)sr->slice_beta_offset_div2 & 0xf) << 12;
+		ret = codec_h264_open_list(&e[9], h264->wrl_l0, n0, a0);
+		if (!ret)
+			ret = codec_h264_open_list(&e[17], h264->wrl_l1, n1, a1);
+		if (ret) {
+			dev_err_ratelimited(core->dev_dec,
+					    "h264 open fw: slice %u type %u has no references (active %u/%u)\n",
+					    i, type, a0, a1);
+			return ret;
+		}
+		e[25] = sr->header_bits;
+
+		/* Co-located MV store: this slice's write position ... */
+		if ((((u64)sr->first_mb + 1) * unit >> (direct8 ? 2 : 0)) >
+		    h264->colocate_buf_size)
+			return -EINVAL;
+		wr = codec_h264_open_colo(h264, slot) +
+		     ((sr->first_mb * unit) >> (direct8 ? 2 : 0));
+		/* ... and, for direct prediction in B slices, L1[0]'s. */
+		if (type == 1 && n1) {
+			const struct h264_ref *l1 = &h264->wrl_l1[0];
+			const struct h264_open_ref *r = NULL;
+			u32 ref, parity, offset;
+
+			for (k = 0; k < nd; k++)
+				if (refs[k].slot == (u32)l1->fw)
+					r = &refs[k];
+			if (!r)
+				return -EINVAL;
+			if (field) {
+				/* The referenced field of a field-decoded store. */
+				ref = l1->field ? (l1->view == V4L2_H264_BOTTOM_FIELD_REF) :
+				      r->structure;
+				parity = l1->view == V4L2_H264_BOTTOM_FIELD_REF;
+			} else {
+				s32 c = min(top, bottom);
+
+				ref = r->structure;
+				parity = abs((s64)c - r->top) < abs((s64)c - r->bottom) ? 0 : 1;
+			}
+			offset = h264_colocate_read_offset(sr->first_mb, mbw, cur, ref, direct8);
+			if (offset >= h264->colocate_buf_size)
+				return -EINVAL;
+			rd = ((codec_h264_open_colo(h264, r->slot) + offset) >> 3) |
+			     ref << 30 | parity << 29;
+		}
+		codec_h264_open_put32(&e[26], wr);
+		codec_h264_open_put32(&e[28], rd);
+	}
+	dev_dbg(core->dev_dec,
+		"h264 open fw: rec slot=%u struct=%u second=%u idr=%u poc=%d/%d slices=%u dpb=%u flags=%#x\n",
+		slot, w[4], !!(w[3] & BIT(13)), pic->idr, top, bottom,
+		h264->open_nslices, nd, w[3]);
+	return 0;
+}
+
+/* Hand the picture to the firmware: FIFO, record, then restart the AMRISC. */
+static void codec_h264_open_kick(struct amvdec_session *sess,
+				 const struct h264_open_fifo *f, dma_addr_t rec)
+{
+	struct codec_h264 *h264 = sess->priv;
+	struct amvdec_core *core = sess->core;
+	dma_addr_t src = f->paddr;
+	u32 payload = f->payload;
+	int i;
+
+	/* Halt the processors before touching the VLD; drain their DMA. */
+	meson_amvdec_write_dos(core, MPSR, 0);
+	meson_amvdec_write_dos(core, CPSR, 0);
+	for (i = 0; i < 1000; i++) {
+		if (!(meson_amvdec_read_dos(core, IMEM_DMA_CTRL) & 0x8000))
+			break;
+		udelay(10);
+	}
+	for (i = 0; i < 1000; i++) {
+		if (!(meson_amvdec_read_dos(core, LMEM_DMA_CTRL) & 0x8000))
+			break;
+		udelay(10);
+	}
+
+	meson_amvdec_write_dos(core, VLD_MEM_VIFIFO_CONTROL, 0);
+	meson_amvdec_write_dos(core, DOS_SW_RESET0, BIT(5) | BIT(4) | BIT(3));
+	meson_amvdec_write_dos(core, DOS_SW_RESET0, 0);
+	meson_amvdec_write_dos(core, POWER_CTL_VLD, BIT(4));
+
+	/* Input: the driver-owned copy (codec_mpeg12_sl_input() sequence). */
+	meson_amvdec_write_dos(core, VLD_MEM_VIFIFO_START_PTR, src);
+	meson_amvdec_write_dos(core, VLD_MEM_VIFIFO_END_PTR,
+			       src + f->size - OH264_FIFO_ALIGN);
+	meson_amvdec_write_dos(core, VLD_MEM_VIFIFO_CURR_PTR, src);
+	meson_amvdec_write_dos(core, VLD_MEM_VIFIFO_CONTROL, 1);
+	meson_amvdec_write_dos(core, VLD_MEM_VIFIFO_CONTROL, 0);
+	meson_amvdec_write_dos(core, VLD_MEM_VIFIFO_BUF_CNTL, 2);
+	meson_amvdec_write_dos(core, VLD_MEM_VIFIFO_RP, src);
+	meson_amvdec_write_dos(core, VLD_MEM_VIFIFO_WP,
+			       round_down(src + payload + OH264_FIFO_PAD, OH264_FIFO_ALIGN));
+	meson_amvdec_write_dos(core, VLD_MEM_VIFIFO_BUF_CNTL, 3);
+	meson_amvdec_write_dos(core, VLD_MEM_VIFIFO_BUF_CNTL, 2);
+	meson_amvdec_write_dos(core, VLD_MEM_VIFIFO_CONTROL,
+			       (0x11 << 16) | BIT(10) | (7 << 3));
+	meson_amvdec_write_dos(core, VIFF_BIT_CNT, payload * 8);
+
+	/* The registers the harness (amrisc_test mode 3) sets before MPSR = 1. */
+	meson_amvdec_write_dos(core, MPEG1_2_REG, 0);
+	meson_amvdec_write_dos(core, PSCALE_CTRL, 0);
+	meson_amvdec_write_dos(core, PIC_HEAD_INFO, 0x380);
+	meson_amvdec_write_dos(core, M4_CONTROL_REG, 0);
+	meson_amvdec_write_dos(core, ASSIST_MBOX1_CLR_REG, 1);
+	meson_amvdec_write_dos(core, ASSIST_MBOX1_MASK, 1);
+	meson_amvdec_write_dos(core, AV_SCRATCH_2, 0);
+	meson_amvdec_write_dos(core, AV_SCRATCH_3, 0);
+	meson_amvdec_write_dos(core, AV_SCRATCH_N, 0);
+	meson_amvdec_write_dos(core, AV_SCRATCH_1, rec);
+	meson_amvdec_write_dos(core, AV_SCRATCH_0, OH264_CMD_DECODE);
+	if (sess->pixfmt_cap == V4L2_PIX_FMT_NV12M)
+		meson_amvdec_write_dos_bits(core, MDEC_PIC_DC_CTRL, BIT(17));
+	meson_amvdec_clear_dos_bits(core, MDEC_PIC_DC_CTRL, BIT(16));
+	meson_amvdec_write_dos_bits(core, VLD_MEM_VIFIFO_CONTROL, 0x6);
+
+	/* Order the record, the FIFO and every store above before the start. */
+	dma_wmb();
+	meson_amvdec_write_dos(core, DOS_SW_RESET0, BIT(12) | BIT(11));
+	meson_amvdec_write_dos(core, DOS_SW_RESET0, 0);
+	meson_amvdec_read_dos(core, DOS_SW_RESET0);
+	meson_amvdec_write_dos(core, MPSR, 1);
+	h264->bench_kick = ktime_get();
+	if (h264->bench_done) {
+		u32 us = ktime_us_delta(h264->bench_kick, h264->bench_done);
+
+		h264->bench_sum_gap += us;
+		h264->bench_max_gap = max(h264->bench_max_gap, us);
+		h264->bench_n_gap++;
+	}
+	h264_prof_start(core);
+}
+
+/* ------------------------------------------------------------------------ */
+/*        Open firmware pipeline (h264_pipeline, frame pictures only)        */
+/* ------------------------------------------------------------------------ */
+
+#define OH264_PIPE_DRAIN_MS	1000
+
+/* The oldest slot in @state, or NULL. */
+static struct h264_open_pic *codec_h264_pipe_find(struct codec_h264 *h264, u8 state)
+{
+	struct h264_open_pic *best = NULL;
+	u32 i;
+
+	for (i = 0; i < OH264_PIPE_SLOTS; i++) {
+		struct h264_open_pic *p = &h264->pipe_pic[i];
+
+		if (READ_ONCE(p->state) == state &&
+		    (!best || (s32)(p->seq - best->seq) < 0))
+			best = p;
+	}
+	return best;
+}
+
+/* The oldest slot READY, RUN or DONE (holding buffers nobody claimed), or NULL. */
+static struct h264_open_pic *codec_h264_pipe_oldest(struct codec_h264 *h264)
+{
+	struct h264_open_pic *best = NULL;
+	u32 i;
+
+	for (i = 0; i < OH264_PIPE_SLOTS; i++) {
+		struct h264_open_pic *p = &h264->pipe_pic[i];
+
+		u8 st = READ_ONCE(p->state);
+
+		if (st != OH264_PIPE_FREE && st != OH264_PIPE_RETIRING &&
+		    (!best || (s32)(p->seq - best->seq) < 0))
+			best = p;
+	}
+	return best;
+}
+
+/* Start @p on the idle decoder. pipe_lock held. */
+static void codec_h264_pipe_kick_locked(struct amvdec_session *sess, struct h264_open_pic *p)
+{
+	struct codec_h264 *h264 = sess->priv;
+
+	lockdep_assert_held(&h264->pipe_lock);
+	WRITE_ONCE(p->state, OH264_PIPE_RUN);
+	WRITE_ONCE(h264->pipe_run, p - h264->pipe_pic);
+	h264->multi_hw_started = true;
+	codec_h264_open_kick(sess, &p->fifo, h264->open_paddr + p->rec_off);
+	dev_dbg(sess->core->dev_dec, "h264 open fw: pipe kick seq=%u slot=%u vb2=%u fifo=%u bytes\n",
+		p->seq, p->fw_idx, p->dst->vb2_buf.index, p->fifo.payload);
+}
+
+/* The oldest READY picture, if the decoder is idle and may be started. */
+static void codec_h264_pipe_try_kick_locked(struct amvdec_session *sess)
+{
+	struct codec_h264 *h264 = sess->priv;
+	struct h264_open_pic *p;
+
+	lockdep_assert_held(&h264->pipe_lock);
+	if (h264->pipe_run >= 0 || h264->pipe_halt)
+		return;
+	p = codec_h264_pipe_find(h264, OH264_PIPE_READY);
+	if (p)
+		codec_h264_pipe_kick_locked(sess, p);
+}
+
+/* Nothing prepared or running (or never again): the serial path may take over. */
+static bool codec_h264_pipe_quiet(struct codec_h264 *h264)
+{
+	return READ_ONCE(h264->pipe_halt) ||
+	       (READ_ONCE(h264->pipe_run) < 0 &&
+		!codec_h264_pipe_find(h264, OH264_PIPE_READY));
+}
+
+/* No slot left to prepare into: the feed must wait for a retirement. */
+static bool codec_h264_pipe_full(struct codec_h264 *h264)
+{
+	return h264->pipe && !codec_h264_pipe_find(h264, OH264_PIPE_FREE);
+}
+
+/*
+ * Return both buffers of a DONE picture (or, with @cancel, of any picture
+ * being discarded at stop). Worker context (sess->lock) or stop.
+ */
+static void codec_h264_pipe_complete(struct amvdec_session *sess, struct h264_open_pic *p,
+				     bool cancel)
+{
+	struct codec_h264 *h264 = sess->priv;
+	struct vb2_v4l2_buffer *dst = p->dst, *src = p->src;
+	bool failed = cancel || p->status != OH264_STATUS_DONE;
+	u32 plane, size;
+
+	if (failed && dst && p->fw_idx < ARRAY_SIZE(h264->multi_field_slots)) {
+		struct h264_field_surface *sf = &h264->multi_field_slots[p->fw_idx];
+
+		/* A failed picture is no reference surface (recorded at prepare). */
+		if (sf->valid && sf->vb2_idx == dst->vb2_buf.index &&
+		    sf->timestamp == dst->vb2_buf.timestamp)
+			sf->valid = false;
+	}
+	if (dst && failed) {
+		for (plane = 0; plane < dst->vb2_buf.num_planes; plane++)
+			vb2_set_plane_payload(&dst->vb2_buf, plane, 0);
+		dst->sequence = sess->sequence_cap++;
+		v4l2_m2m_buf_done(dst, VB2_BUF_STATE_ERROR);
+	} else if (dst) {
+		size = meson_amvdec_get_output_size(sess);
+		switch (sess->pixfmt_cap) {
+		case V4L2_PIX_FMT_NV12M:
+			vb2_set_plane_payload(&dst->vb2_buf, 0, size);
+			vb2_set_plane_payload(&dst->vb2_buf, 1, size / 2);
+			break;
+		case V4L2_PIX_FMT_YUV420M:
+			vb2_set_plane_payload(&dst->vb2_buf, 0, size);
+			vb2_set_plane_payload(&dst->vb2_buf, 1, size / 4);
+			vb2_set_plane_payload(&dst->vb2_buf, 2, size / 4);
+			break;
+		}
+		dst->field = V4L2_FIELD_NONE;
+		dst->sequence = sess->sequence_cap++;
+		/* Concealed damage: usable, and kept as a reference, but flagged. */
+		v4l2_m2m_buf_done(dst, p->err ? VB2_BUF_STATE_ERROR : VB2_BUF_STATE_DONE);
+		meson_amvdec_trace(sess, AMVDEC_TR_SIGNAL, dst->vb2_buf.index, 0, 0);
+	}
+	if (src) {
+		meson_amvdec_src_buf_done(sess, src, failed ? VB2_BUF_STATE_ERROR :
+					  VB2_BUF_STATE_DONE);
+		atomic_dec(&sess->esparser_queued_bufs);
+	}
+	p->src = NULL;
+	p->dst = NULL;
+}
+
+/*
+ * Retire every DONE picture in decode order (worker), then start a READY one
+ * the threaded ISR left alone (a stop was requested when it ran).
+ */
+static void codec_h264_pipe_retire(struct amvdec_session *sess)
+{
+	struct codec_h264 *h264 = sess->priv;
+	struct h264_open_pic *p;
+
+	if (!h264->pipe)
+		return;
+	for (;;) {
+		mutex_lock(&h264->pipe_lock);
+		p = codec_h264_pipe_find(h264, OH264_PIPE_DONE);
+		if (p)
+			WRITE_ONCE(p->state, OH264_PIPE_RETIRING);
+		mutex_unlock(&h264->pipe_lock);
+		if (!p)
+			break;
+		codec_h264_bench_account(sess, p->bench_feed);
+		codec_h264_pipe_complete(sess, p, false);
+		mutex_lock(&h264->pipe_lock);
+		WRITE_ONCE(p->state, OH264_PIPE_FREE);
+		mutex_unlock(&h264->pipe_lock);
+	}
+	mutex_lock(&h264->pipe_lock);
+	codec_h264_pipe_try_kick_locked(sess);
+	mutex_unlock(&h264->pipe_lock);
+}
+
+/*
+ * Before a picture takes the serial path (field pictures): let every
+ * pipelined picture finish and retire it, so the decoder, the first record
+ * area and the surface provenance are the serial path's alone.
+ */
+static int codec_h264_pipe_drain(struct amvdec_session *sess)
+{
+	struct codec_h264 *h264 = sess->priv;
+
+	if (!h264->pipe)
+		return 0;
+	codec_h264_pipe_retire(sess);
+	if (!wait_event_timeout(h264->pipe_wq, codec_h264_pipe_quiet(h264),
+				msecs_to_jiffies(OH264_PIPE_DRAIN_MS)))
+		return -ETIMEDOUT;
+	if (READ_ONCE(h264->pipe_halt))
+		return -EIO;
+	codec_h264_pipe_retire(sess);
+	return 0;
+}
+
+/* Stop/abort: no picture is started any more from here on. */
+static void codec_h264_pipe_halt(struct amvdec_session *sess)
+{
+	struct codec_h264 *h264 = sess->priv;
+
+	if (!h264)
+		return;
+	mutex_lock(&h264->pipe_lock);
+	WRITE_ONCE(h264->pipe_halt, true);
+	mutex_unlock(&h264->pipe_lock);
+	wake_up(&h264->pipe_wq);
+}
+
+/*
+ * Session stop, after the processors are halted and the IRQ is synchronised:
+ * hand back every buffer the pipeline still owns - prepared, running, or
+ * decoded but not yet retired - as errors, oldest first.
+ */
+static void codec_h264_pipe_discard(struct amvdec_session *sess)
+{
+	struct codec_h264 *h264 = sess->priv;
+	struct h264_open_pic *p;
+
+	codec_h264_pipe_halt(sess);
+	for (;;) {
+		mutex_lock(&h264->pipe_lock);
+		p = codec_h264_pipe_oldest(h264);
+		if (p)
+			WRITE_ONCE(p->state, OH264_PIPE_RETIRING);
+		WRITE_ONCE(h264->pipe_run, -1);
+		mutex_unlock(&h264->pipe_lock);
+		if (!p)
+			break;
+		codec_h264_pipe_complete(sess, p, true);
+		mutex_lock(&h264->pipe_lock);
+		WRITE_ONCE(p->state, OH264_PIPE_FREE);
+		mutex_unlock(&h264->pipe_lock);
+	}
+}
+
+/*
+ * Commit a parsed frame picture to a free slot: FIFO and record into the
+ * slot's buffers, CAPTURE taken off the ready queue with the OUTPUT metadata
+ * (so the next picture resolves this one by timestamp), its reference surface
+ * recorded now rather than at completion, both buffers kept for retirement.
+ * Then the m2m job ends: the next request is prepared while this one waits
+ * or decodes. Nothing is committed unless everything succeeds, so an error
+ * return leaves the buffers to esparser_src_error() as in the serial path.
+ */
+static int codec_h264_pipe_prepare(struct amvdec_session *sess)
+{
+	struct codec_h264 *h264 = sess->priv;
+	struct amvdec_core *core = sess->core;
+	struct h264_open_pic *p = codec_h264_pipe_find(h264, OH264_PIPE_FREE);
+	struct h264_field_surface *surface;
+	struct vb2_v4l2_buffer *dst;
+	u32 slot = h264->multi_pic_fw_idx;
+	int ret;
+
+	if (!p || !h264->multi_src_vbuf || slot >= ARRAY_SIZE(h264->multi_field_slots))
+		return -EBUSY;
+	dst = v4l2_m2m_next_dst_buf(sess->m2m_ctx);
+	if (!dst || dst->vb2_buf.index != h264->multi_pic_vb2_idx)
+		return -EINVAL;
+
+	ret = codec_h264_open_fifo(sess, &p->fifo);
+	if (!ret)
+		ret = codec_h264_open_record(sess);
+	if (ret) {
+		dev_err_ratelimited(core->dev_dec, "h264 open fw: picture refused: %d\n", ret);
+		return ret;
+	}
+	codec_h264_open_write_record(h264->open_vaddr + p->rec_off, h264->open_rec,
+				     codec_h264_open_rec_words(h264->open_nslices));
+
+	/* ---- commit, unless a stop got in first: nothing below fails ---- */
+	mutex_lock(&h264->pipe_lock);
+	if (h264->pipe_halt) {
+		mutex_unlock(&h264->pipe_lock);
+		return -ESHUTDOWN;
+	}
+	v4l2_m2m_dst_buf_remove_by_buf(sess->m2m_ctx, dst);
+	amvdec_m2m_copy_metadata(h264->multi_src_vbuf, dst);
+
+	surface = &h264->multi_field_slots[slot];
+	memset(surface, 0, sizeof(*surface));
+	surface->valid = true;
+	surface->decoded_fields = V4L2_H264_FRAME_REF;
+	surface->structure = codec_h264_multi_current_structure(h264);
+	surface->frame_num = h264->multi_slice_refs.frame_num;
+	surface->timestamp = h264->multi_pic_ts;
+	surface->vb2_idx = h264->multi_pic_vb2_idx;
+	surface->top_poc = h264->multi_pic_top_poc;
+	surface->bottom_poc = h264->multi_pic_bottom_poc;
+	surface->poc = min(h264->multi_pic_top_poc, h264->multi_pic_bottom_poc);
+	surface->sps = h264->multi_sps;
+	surface->reference = !!h264->multi_nal_ref_idc;
+
+	p->src = h264->multi_src_vbuf;
+	p->dst = dst;
+	p->fw_idx = slot;
+	p->first_off = h264->open_slices[0].fifo_off;
+	p->bench_feed = h264->bench_feed;
+	p->status = 0;
+	p->err = 0;
+	p->seq = h264->pipe_seq++;
+	/* The OUTPUT buffer now belongs to the slot, not to the serial path. */
+	h264->multi_src_vbuf = NULL;
+	h264->multi_slice_data = NULL;
+	dev_dbg(core->dev_dec, "h264 open fw: pipe prepared seq=%u pic=%u slot=%u vb2=%u fifo=%u bytes\n",
+		p->seq, h264->multi_pic_count, slot, dst->vb2_buf.index, p->fifo.payload);
+	h264->multi_pic_count++;
+
+	WRITE_ONCE(p->state, OH264_PIPE_READY);
+	codec_h264_pipe_try_kick_locked(sess);
+	mutex_unlock(&h264->pipe_lock);
+
+	v4l2_m2m_job_finish(sess->m2m_dev, sess->m2m_ctx);
+	return 0;
+}
+
+static int codec_h264_open_feed(struct amvdec_session *sess, struct vb2_buffer *vb)
+{
+	struct codec_h264 *h264 = sess->priv;
+	struct amvdec_core *core = sess->core;
+	u32 payload = vb2_get_plane_payload(vb, 0);
+	bool pipe;
+	int ret;
+
+	h264->multi_src_vaddr = vb2_plane_vaddr(vb, 0);
+	if (!payload || !h264->multi_src_vaddr)
+		return -EINVAL;
+	/* esparser_queue() copied this access unit from the (uncached) OUTPUT
+	 * buffer just before the feed and nothing modified it since (open mode
+	 * splices no headers): reuse that copy instead of reading it again.
+	 */
+	if (h264->scan_fresh && h264->scan_src == h264->multi_src_vaddr &&
+	    h264->scan_len == payload)
+		h264->multi_slice_data = h264->scan_copy;
+	else
+		h264->multi_slice_data = meson_amvdec_codec_h264_scan_copy(sess,
+							h264->multi_src_vaddr, payload,
+							vb2_plane_size(vb, 0));
+	h264->scan_fresh = false;
+	h264->multi_slice_size = payload;
+	h264->multi_slice_cursor = 0;
+	h264->multi_slice_count = 0;
+	h264->multi_done_error = false;
+	h264->open_done_concealed = false;
+	if (!h264->multi_slice_data)
+		return -EINVAL;
+	if (!h264->multi_pic_valid)
+		return h264->multi_params_error ? h264->multi_params_error : -EINVAL;
+	if (!h264->open_vaddr || !h264->open_slices || !h264->open_rec ||
+	    !h264->colocate_vaddr)
+		return -EINVAL;
+
+	ret = codec_h264_open_parse(sess);
+	if (ret) {
+		dev_err_ratelimited(core->dev_dec, "h264 open fw: access unit refused: %d\n", ret);
+		return ret;
+	}
+
+	/*
+	 * Frame pictures are pipelined; a field picture (field-pair provenance,
+	 * mate detection) keeps the serial path, on an idle pipeline.
+	 */
+	pipe = h264->pipe && !h264->multi_request_picture.field_pic;
+	if (!pipe) {
+		ret = codec_h264_pipe_drain(sess);
+		if (ret) {
+			dev_err_ratelimited(core->dev_dec,
+					    "h264 open fw: pipeline did not drain: %d\n", ret);
+			return ret;
+		}
+	}
+
+	/* The picture as the shared surface/list code sees it. */
+	h264->multi_field_picture = h264->multi_request_picture.field_pic;
+	h264->multi_field_mate = false;
+	h264->multi_field_phase = 0;
+	h264->multi_decoded_fields = 0;
+	h264->multi_fields[0] = h264->open_slices[0].refs;
+	h264->multi_slice_refs = h264->open_slices[0].refs;
+	h264->multi_slice_count = h264->open_nslices;
+
+	ret = codec_h264_multi_pick_capture(sess);
+	if (ret)
+		return ret;
+	if (h264->multi_pic_fw_idx >= OH264_MAX_SLOTS)
+		return -EINVAL;
+	if (pipe)
+		return codec_h264_pipe_prepare(sess);
+
+	/* Field pairs: the vendor surface structure is the first field's parity. */
+	if (h264->multi_field_picture && !h264->multi_field_mate)
+		h264->open_first_bottom[h264->multi_pic_fw_idx] =
+			h264->multi_request_picture.bottom_field;
+
+	ret = codec_h264_open_fifo(sess, &h264->open_fifo);
+	if (!ret)
+		ret = codec_h264_open_record(sess);
+	if (ret) {
+		dev_err_ratelimited(core->dev_dec, "h264 open fw: picture refused: %d\n", ret);
+		return ret;
+	}
+	codec_h264_open_write_record(h264->open_vaddr, h264->open_rec,
+				     codec_h264_open_rec_words(h264->open_nslices));
+
+	h264->multi_pic_started = true;
+	h264->multi_hw_started = true;
+	codec_h264_open_kick(sess, &h264->open_fifo, h264->open_paddr);
+	dev_dbg(core->dev_dec, "h264 open fw: kick pic=%u slot=%u vb2=%u fifo=%u bytes\n",
+		h264->multi_pic_count, h264->multi_pic_fw_idx, h264->multi_pic_vb2_idx,
+		h264->open_fifo.payload);
+	h264->multi_pic_count++;
+	return 0;
+}
+
+static irqreturn_t codec_h264_open_threaded_isr(struct amvdec_session *sess)
+{
+	struct codec_h264 *h264 = sess->priv;
+	struct amvdec_core *core = sess->core;
+	u32 st = meson_amvdec_read_dos(core, AV_SCRATCH_0);
+	struct h264_open_pic *pic = NULL;
+	u32 err, nmb;
+
+	if (st != OH264_STATUS_DONE && st != OH264_STATUS_ERROR)
+		return IRQ_HANDLED;
+	err = meson_amvdec_read_dos(core, AV_SCRATCH_2);
+	nmb = meson_amvdec_read_dos(core, AV_SCRATCH_3);
+	h264_prof_stop();
+	h264->bench_done = ktime_get();
+	if (h264_bench) {
+		u32 n = meson_amvdec_read_dos(core, AV_SCRATCH_N);
+
+		h264->bench_drain_to += n & 0xff;
+		h264->bench_drain_to1 += n >> 8;
+		if (n)
+			h264->bench_drain_val = meson_amvdec_read_dos(core, AV_SCRATCH_M);
+	}
+	if (h264_bench && h264->bench_kick) {
+		u32 us = ktime_us_delta(ktime_get(), h264->bench_kick);
+
+		h264->bench_sum_hw += us;
+		h264->bench_max_hw = max(h264->bench_max_hw, us);
+		h264->bench_n_hw++;
+		h264->bench_kick = 0;
+	}
+	/*
+	 * A pipelined picture (pipe_run) or the serial one. pipe_lock is held
+	 * from here to the next kick, so the worker cannot start one meanwhile.
+	 */
+	if (h264->pipe) {
+		mutex_lock(&h264->pipe_lock);
+		if (h264->pipe_run >= 0 &&
+		    h264->pipe_pic[h264->pipe_run].state == OH264_PIPE_RUN)
+			pic = &h264->pipe_pic[h264->pipe_run];
+		else
+			mutex_unlock(&h264->pipe_lock);
+	}
+	if (st == OH264_STATUS_ERROR) {
+		const u8 *f = pic ? pic->fifo.vaddr : h264->open_fifo.vaddr;
+		u32 o = pic ? pic->first_off :
+			h264->open_nslices ? h264->open_slices[0].fifo_off : 0;
+
+		dev_err_ratelimited(core->dev_dec,
+				    "H.264 open fw: picture failed, error %u after %u MBs (stage %#x) nal=%#x bits=%#x peek=%08x fifo[%u]=%*ph\n",
+				    err, nmb, meson_amvdec_read_dos(core, AV_SCRATCH_J),
+				    meson_amvdec_read_dos(core, AV_SCRATCH_I),
+				    meson_amvdec_read_dos(core, AV_SCRATCH_K),
+				    meson_amvdec_read_dos(core, AV_SCRATCH_L), o,
+				    8, f ? f + (o >= 4 ? o - 4 : 0) : (const u8 *)"\0\0\0\0\0\0\0\0");
+	}
+	else if (err)
+		dev_dbg(core->dev_dec, "H.264 open fw: %u errors concealed\n", err);
+	/* Acknowledge: the firmware waits for 0 before its next command. */
+	meson_amvdec_write_dos(core, AV_SCRATCH_0, 0);
+	if (pic) {
+		pic->status = st;
+		pic->err = err;
+		WRITE_ONCE(pic->state, OH264_PIPE_DONE);
+		WRITE_ONCE(h264->pipe_run, -1);
+		/* The next picture first; retirement can wait for the worker. */
+		if (!READ_ONCE(sess->should_stop))
+			codec_h264_pipe_try_kick_locked(sess);
+		mutex_unlock(&h264->pipe_lock);
+		wake_up(&h264->pipe_wq);
+		amvdec_queue_esparser(sess);
+		return IRQ_HANDLED;
+	}
+	if (!h264->multi_pic_started || !h264->multi_src_vbuf)
+		return IRQ_HANDLED;
+	h264->multi_pic_started = false;
+	h264->multi_done_error = st != OH264_STATUS_DONE;
+	h264->open_done_concealed = st == OH264_STATUS_DONE && err;
+	if (h264->multi_field_picture && !codec_h264_multi_field_advance(h264, 0, 2)) {
+		codec_h264_multi_abort(sess);
+		return IRQ_HANDLED;
+	}
+	/* Retire from the worker, which owns the m2m queues. */
+	h264->multi_done_fw_idx = h264->multi_pic_fw_idx;
+	h264->multi_done_pending = true;
+	amvdec_queue_esparser(sess);
+	return IRQ_HANDLED;
+}
+
+static int codec_h264_start(struct amvdec_session *sess)
+{
+	return codec_h264_open_start(sess);
+}
+
+static int codec_h264_stop(struct amvdec_session *sess)
+{
+	struct codec_h264 *h264 = sess->priv;
+	struct amvdec_core *core = sess->core;
+	u32 i;
+
+	h264_prof_stop();
+	/* Pipelined pictures own an OUTPUT and a CAPTURE buffer each. */
+	codec_h264_pipe_discard(sess);
+	/*
+	 * An access unit in flight is off the m2m ready queue and owned by
+	 * this codec, so vdec_stop_streaming()'s drain cannot see it. Return
+	 * it here or vb2 waits for a buffer that is never coming back.
+	 */
+	if (h264->multi_src_vbuf) {
+		h264->multi_slice_data = NULL;
+		meson_amvdec_src_buf_done(sess, h264->multi_src_vbuf, VB2_BUF_STATE_ERROR);
+		h264->multi_src_vbuf = NULL;
+	}
+	h264->multi_done_pending = false;
+	h264->multi_pic_started = false;
+	h264->multi_hw_started = false;
+	h264->multi_powered = false;
+
+	if (h264->colocate_vaddr)
+		dma_free_coherent(core->dev, h264->colocate_size,
+				  h264->colocate_vaddr, h264->colocate_paddr);
+
+	if (h264->open_vaddr)
+		dma_free_coherent(core->dev, h264->open_size,
+				  h264->open_vaddr, h264->open_paddr);
+	codec_h264_open_fifo_free(core, &h264->open_fifo);
+	for (i = 0; i < OH264_PIPE_SLOTS; i++)
+		codec_h264_open_fifo_free(core, &h264->pipe_pic[i].fifo);
+	kvfree(h264->open_slices);
+	kvfree(h264->open_rec);
+	h264->open_slices = NULL;
+	h264->open_rec = NULL;
+	/* The access-unit scan copy is freed with the session. */
+	kvfree(h264->scan_copy);
+	h264->scan_copy = NULL;
+	h264->scan_copy_size = 0;
+	h264->scan_fresh = false;
+
+	return 0;
+}
+
+/*
+ * oh264_sl.bin is a single 16 KiB IMEM image without swap segments:
+ * everything it runs is in IMEM already, loaded by amvdec_1.
+ */
+static int codec_h264_load_firmware(struct amvdec_session *sess,
+				    const u8 *data, u32 len)
+{
+	struct codec_h264 *h264;
+
+	if (len > SZ_16K)
+		return -EINVAL;
+
+	h264 = kzalloc_obj(*h264);
+	if (!h264)
+		return -ENOMEM;
+
+	spin_lock_init(&h264->multi_field_lock);
+	mutex_init(&h264->pipe_lock);
+	init_waitqueue_head(&h264->pipe_wq);
+	h264->pipe_run = -1;
+	sess->priv = h264;
+	dev_dbg(sess->core->dev_dec, "h264: open firmware %s\n", sess->fmt_out->firmware_path);
+	return 0;
+}
+
+/*
+ * One colocated MV slot per CAPTURE frame, indexed by canvas position, so a B
+ * picture can read the MVs of its L1[0] without the firmware owning the
+ * mapping. Each slot holds 96 bytes per macroblock.
+ */
+static int codec_h264_multi_alloc_colocate(struct amvdec_session *sess)
+{
+	struct codec_h264 *h264 = sess->priv;
+	struct amvdec_core *core = sess->core;
+	u32 mb_total;
+
+	if (h264->colocate_vaddr)
+		return 0;
+
+	mb_total = h264->mb_width * h264->mb_height;
+	if (!mb_total)
+		return -EINVAL;
+
+	/*
+	 * Allocate MV storage for every firmware canvas slot so CAPTURE can grow
+	 * without resizing the store during decoding.
+	 * MBAFF stores motion vectors for both halves of each macroblock pair
+	 * and requires twice the progressive-frame storage.
+	 */
+	/* The firmware's host (h264_run.py) always sizes for two. */
+	h264->colocate_buf_size = mb_total * H264_COLOCATE_BYTES_PER_MB * 2;
+	h264->colocate_size = h264->colocate_buf_size * H264_MULTI_MAX_FW_BUFS;
+	h264->colocate_vaddr = dma_alloc_coherent(core->dev,
+						  h264->colocate_size,
+						  &h264->colocate_paddr,
+						  GFP_KERNEL);
+	if (!h264->colocate_vaddr) {
+		dev_err_ratelimited(core->dev_dec,
+				    "h264 multi: colocated MV alloc failed (%u bytes)\n",
+			h264->colocate_size);
+		return -ENOMEM;
+	}
+
+	dev_dbg(core->dev_dec,
+		"h264 multi: colocated MV store paddr=%pad per_buf=%#x total=%#x slots=%u\n",
+		 &h264->colocate_paddr, h264->colocate_buf_size,
+		 h264->colocate_size, (u32)H264_MULTI_MAX_FW_BUFS);
+	return 0;
+}
+
+/* Configure capture canvases and colocated-MV storage before feeding pictures. */
+static int codec_h264_multi_host_config(struct amvdec_session *sess)
+{
+	struct codec_h264 *h264 = sess->priv;
+	struct amvdec_core *core = sess->core;
+
+	h264->mb_width = DIV_ROUND_UP(sess->width, 16);
+	h264->mb_height = DIV_ROUND_UP(sess->height, 16);
+
+	/* Apply sequence geometry from each request SPS. */
+	dev_dbg(core->dev_dec,
+		"h264 multi host config: %ux%u mb=%ux%u fw_bufs=%u\n",
+		 sess->width, sess->height, h264->mb_width, h264->mb_height,
+		 sess->num_fw_bufs);
+
+	return codec_h264_multi_alloc_colocate(sess);
+}
+
+static irqreturn_t codec_h264_threaded_isr(struct amvdec_session *sess)
+{
+	if (!sess->priv)
+		return IRQ_HANDLED;
+	return codec_h264_open_threaded_isr(sess);
+}
+
+static irqreturn_t codec_h264_isr(struct amvdec_session *sess)
+{
+	struct amvdec_core *core = sess->core;
+
+	meson_amvdec_write_dos(core, ASSIST_MBOX1_CLR_REG, 1);
+
+	return IRQ_WAKE_THREAD;
+}
+
+static void codec_h264_post_start(struct amvdec_session *sess)
+{
+	struct codec_h264 *h264 = sess->priv;
+
+	if (!h264)
+		return;
+
+	/* amvdec_1_start() leaves direct-input firmware halted. The first feed
+	 * publishes input and context before it releases the processors.
+	 */
+	meson_amvdec_write_dos(sess->core, MPSR, 0);
+	meson_amvdec_write_dos(sess->core, CPSR, 0);
+	dev_dbg(sess->core->dev_dec, "h264 multi: halted until first feed\n");
+}
+
+/*
+ * Use OUTPUT as the VLD stream FIFO. Align the base to eight bytes and
+ * provide a padding window for hardware read-ahead.
+ */
+
+/* One access unit in flight: the VLD is pointed at that buffer. */
+bool meson_amvdec_codec_h264_multi_busy(struct amvdec_session *sess)
+{
+	struct codec_h264 *h264 = sess->priv;
+
+	/* Pipeline: also while no slot is free for the next picture. */
+	return h264 && (h264->multi_src_vbuf || codec_h264_pipe_full(h264));
+}
+
+/*
+ * Retire OUTPUT and CAPTURE from the feed worker. Copy the OUTPUT
+ * timestamp to CAPTURE so later requests can name it as a reference.
+ */
+void meson_amvdec_codec_h264_multi_finish_picture(struct amvdec_session *sess)
+{
+	struct codec_h264 *h264 = sess->priv;
+	struct amvdec_core *core = sess->core;
+	struct vb2_v4l2_buffer *dst;
+
+	/* Pipelined pictures retire on their own (no m2m job). */
+	if (h264)
+		codec_h264_pipe_retire(sess);
+	if (!h264 || !h264->multi_done_pending)
+		return;
+	h264->multi_done_pending = false;
+	codec_h264_bench_account(sess, h264->bench_feed);
+	if (h264->multi_done_error)
+		dev_warn_ratelimited(core->dev_dec,
+				     "h264 multi: completing incomplete picture as an error\n");
+
+	dst = v4l2_m2m_dst_buf_remove_by_idx(sess->m2m_ctx,
+					     sess->fw_idx_to_vb2_idx[h264->multi_done_fw_idx]);
+	if (h264->multi_field_picture &&
+	    !codec_h264_multi_field_claim(h264, dst && h264->multi_src_vbuf)) {
+		dev_err_ratelimited(core->dev_dec, "h264 field: aborted or lost completion buffer\n");
+		h264->multi_slice_data = NULL;
+		codec_h264_multi_abort(sess);
+		if (dst)
+			v4l2_m2m_buf_done(dst, VB2_BUF_STATE_ERROR);
+		if (h264->multi_src_vbuf) {
+			h264->multi_slice_data = NULL;
+			meson_amvdec_src_buf_done(sess, h264->multi_src_vbuf, VB2_BUF_STATE_ERROR);
+			h264->multi_src_vbuf = NULL;
+			atomic_dec(&sess->esparser_queued_bufs);
+		}
+		v4l2_m2m_job_finish(sess->m2m_dev, sess->m2m_ctx);
+		return;
+	}
+	/* A failed field is no first field to pair with. */
+	if (h264->multi_done_error &&
+	    h264->multi_done_fw_idx < ARRAY_SIZE(h264->multi_field_slots))
+		h264->multi_field_slots[h264->multi_done_fw_idx].valid = false;
+	if (dst && h264->multi_src_vbuf && !h264->multi_done_error &&
+	    !h264->multi_field_picture &&
+	    h264->multi_done_fw_idx < ARRAY_SIZE(h264->multi_field_slots)) {
+		struct h264_field_surface *surface =
+			&h264->multi_field_slots[h264->multi_done_fw_idx];
+
+		memset(surface, 0, sizeof(*surface));
+		surface->valid = true;
+		surface->decoded_fields = V4L2_H264_FRAME_REF;
+		surface->structure = codec_h264_multi_current_structure(h264);
+		surface->frame_num = h264->multi_slice_refs.frame_num;
+		surface->timestamp = h264->multi_pic_ts;
+		surface->vb2_idx = h264->multi_pic_vb2_idx;
+		surface->top_poc = h264->multi_pic_top_poc;
+		surface->bottom_poc = h264->multi_pic_bottom_poc;
+		surface->poc = min(h264->multi_pic_top_poc, h264->multi_pic_bottom_poc);
+		surface->sps = h264->multi_sps;
+		surface->reference = !!h264->multi_nal_ref_idc;
+	}
+
+	if (dst && h264->multi_src_vbuf && h264->multi_done_error) {
+		u32 plane;
+
+		amvdec_m2m_copy_metadata(h264->multi_src_vbuf, dst);
+		for (plane = 0; plane < dst->vb2_buf.num_planes; plane++)
+			vb2_set_plane_payload(&dst->vb2_buf, plane, 0);
+		dst->sequence = sess->sequence_cap++;
+		v4l2_m2m_buf_done(dst, VB2_BUF_STATE_ERROR);
+	} else if (dst && h264->multi_src_vbuf) {
+		u32 output_size = meson_amvdec_get_output_size(sess);
+
+		switch (sess->pixfmt_cap) {
+		case V4L2_PIX_FMT_NV12M:
+			vb2_set_plane_payload(&dst->vb2_buf, 0, output_size);
+			vb2_set_plane_payload(&dst->vb2_buf, 1, output_size / 2);
+			break;
+		case V4L2_PIX_FMT_YUV420M:
+			vb2_set_plane_payload(&dst->vb2_buf, 0, output_size);
+			vb2_set_plane_payload(&dst->vb2_buf, 1, output_size / 4);
+			vb2_set_plane_payload(&dst->vb2_buf, 2, output_size / 4);
+			break;
+		}
+		amvdec_m2m_copy_metadata(h264->multi_src_vbuf, dst);
+		dst->field = V4L2_FIELD_NONE;
+		if (h264->multi_field_mate)
+			dst->field = h264->multi_pic_top_poc < h264->multi_pic_bottom_poc ?
+				     V4L2_FIELD_INTERLACED_TB : V4L2_FIELD_INTERLACED_BT;
+		if (h264->multi_field_picture)
+			dev_dbg(core->dev_dec,
+				"h264 field complete: mate=%u fw=%u vb2=%u ts=%llu fields=%u field=%u top=%d bottom=%d\n",
+				 h264->multi_field_mate, h264->multi_pic_fw_idx, dst->vb2_buf.index,
+				 dst->vb2_buf.timestamp,
+				 h264->multi_field_slots[h264->multi_pic_fw_idx].decoded_fields,
+				 dst->field, h264->multi_pic_top_poc, h264->multi_pic_bottom_poc);
+		dst->sequence = sess->sequence_cap++;
+		/* Concealed damage: usable, and kept as a reference, but flagged. */
+		v4l2_m2m_buf_done(dst, h264->open_done_concealed ?
+				  VB2_BUF_STATE_ERROR : VB2_BUF_STATE_DONE);
+		h264->open_done_concealed = false;
+		meson_amvdec_trace(sess, AMVDEC_TR_SIGNAL, dst->vb2_buf.index, 0, 0);
+		dev_dbg(core->dev_dec, "h264 multi done: vb2=%u ts=%llu\n",
+			dst->vb2_buf.index, dst->vb2_buf.timestamp);
+	} else if (!dst) {
+		dev_err_ratelimited(core->dev_dec,
+				    "h264 multi: fw_idx %u has no CAPTURE buffer\n",
+			h264->multi_done_fw_idx);
+	} else {
+		/*
+		 * Return the owned destination as an error when no source supplies metadata.
+		 */
+		dev_err_ratelimited(core->dev_dec,
+				    "h264 multi drop: vb2=%u removed with no OUTPUT buffer\n",
+			dst->vb2_buf.index);
+	}
+
+	if (h264->multi_src_vbuf) {
+		h264->multi_slice_data = NULL;
+		meson_amvdec_src_buf_done(sess, h264->multi_src_vbuf,
+				    h264->multi_done_error ? VB2_BUF_STATE_ERROR :
+				    VB2_BUF_STATE_DONE);
+		h264->multi_src_vbuf = NULL;
+		atomic_dec(&sess->esparser_queued_bufs);
+	}
+	h264->multi_done_error = false;
+	/*
+	 * The firmware starts every picture from scratch: a failed picture
+	 * fails alone, the session goes on.
+	 */
+
+	v4l2_m2m_job_finish(sess->m2m_dev, sess->m2m_ctx);
+}
+
+/*
+ * Called only before direct VLD feed, while the session worker owns the job.
+ * The rejected destination is newly queued; already-DONE CAPTUREs are untouched.
+ */
+void meson_amvdec_codec_h264_multi_discard_capture(struct amvdec_session *sess, u32 vb2_idx)
+{
+	struct codec_h264 *h264 = sess->priv;
+	u32 fw;
+
+	if (!h264)
+		return;
+	if (vb2_idx >= ARRAY_SIZE(sess->vb2_idx_to_fw_idx))
+		return;
+	fw = sess->vb2_idx_to_fw_idx[vb2_idx];
+	if (fw >= H264_MULTI_MAX_FW_BUFS || fw >= sess->num_fw_bufs ||
+	    sess->fw_idx_to_vb2_idx[fw] != vb2_idx)
+		return;
+	h264->multi_field_slots[fw].valid = false;
+}
+
+void meson_amvdec_codec_h264_multi_hold_src(struct amvdec_session *sess,
+			       struct vb2_v4l2_buffer *vbuf)
+{
+	struct codec_h264 *h264 = sess->priv;
+
+	if (h264) {
+		h264->multi_src_vbuf = vbuf;
+		if (!vbuf) {
+			h264->multi_decoded_fields = 0;
+			h264->multi_slice_data = NULL;
+			h264->multi_slice_size = 0;
+		}
+	}
+}
+
+/*
+ * Copy each access unit into cached memory for repeated byte-wise header
+ * parsing. Hardware and synthesized-header writes still use the coherent
+ * OUTPUT buffer. Fall back to parsing OUTPUT if allocation fails.
+ */
+const u8 *meson_amvdec_codec_h264_scan_copy(struct amvdec_session *sess, const u8 *src,
+			       u32 len, u32 cap)
+{
+	struct codec_h264 *h264 = sess->priv;
+
+	if (!h264 || !src || !len || len > cap)
+		return src;
+	if (cap > h264->scan_copy_size) {
+		kvfree(h264->scan_copy);
+		h264->scan_copy = kvmalloc(cap, GFP_KERNEL);
+		h264->scan_copy_size = h264->scan_copy ? cap : 0;
+		if (!h264->scan_copy)
+			return src;
+	}
+	memcpy(h264->scan_copy, src, len);
+	h264->scan_src = src;
+	h264->scan_len = len;
+	h264->scan_fresh = true;
+	return h264->scan_copy;
+}
+
+int meson_amvdec_codec_h264_multi_feed_buffer(struct amvdec_session *sess,
+				 struct vb2_buffer *vb)
+{
+	struct codec_h264 *h264 = sess->priv;
+
+	if (!h264)
+		return -EINVAL;
+	h264->bench_feed = ktime_get();
+	return codec_h264_open_feed(sess, vb);
+}
+
+/*
+ * H.264 feeds one access unit at a time (direct_input: no parser VIFIFO).
+ * Keep the processors halted until the first request supplies input and
+ * context.
+ */
+struct amvdec_codec_ops meson_amvdec_codec_h264_multi_ops = {
+	.start = codec_h264_start,
+	.stop = codec_h264_stop,
+	.pre_stop = codec_h264_pre_stop,
+	.job_abort = codec_h264_job_abort,
+	.load_firmware = codec_h264_load_firmware,
+	.post_start = codec_h264_post_start,
+	.isr = codec_h264_isr,
+	.threaded_isr = codec_h264_threaded_isr,
+	.direct_input = true,
+};
diff --speed-large-files --no-dereference --minimal -Naur linux-7.2.8/drivers/media/platform/amlogic/amvdec/codec_h264.h linux-7.2.8/drivers/media/platform/amlogic/amvdec/codec_h264.h
