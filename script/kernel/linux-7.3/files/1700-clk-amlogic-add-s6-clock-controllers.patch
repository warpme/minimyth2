From 3c69588b645e9eb0100590d8122ef61e2572a3e1 Mon Sep 17 00:00:00 2001
From: Piotr Oniszczuk <piotr.oniszczuk@gmail.com>
Date: Tue, 17 Nov 2026 20:53:04 +0100
Subject: [PATCH 5/5] clk: meson: add support for the S6 peripherals clock
 controller

Add a driver for the peripherals clock controller of the Amlogic S6 SoC,
modelled on the S4 one. Parent clocks provided by the PLL driver and by
SCMI are referenced through firmware names.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 drivers/clk/meson/Kconfig          |   12 +
 drivers/clk/meson/Makefile         |    1 +
 drivers/clk/meson/s6-peripherals.c | 4527 ++++++++++++++++++++++++++++
 3 files changed, 4540 insertions(+)
 create mode 100644 drivers/clk/meson/s6-peripherals.c

diff --git a/drivers/clk/meson/Kconfig b/drivers/clk/meson/Kconfig
index 3b0e1ab2d..68ac0f1fe 100644
--- a/drivers/clk/meson/Kconfig
+++ b/drivers/clk/meson/Kconfig
@@ -218,6 +218,18 @@ config COMMON_CLK_S6_PLL
 	  dividers, which are the parents of most peripherals.
 	  Say Y if you want the board to work.
 
+config COMMON_CLK_S6_PERIPHERALS
+	tristate "S6 SoC peripherals clock controller support"
+	depends on ARM64 || COMPILE_TEST
+	default ARCH_MESON
+	select COMMON_CLK_MESON_CLKC_UTILS
+	select COMMON_CLK_MESON_REGMAP
+	select COMMON_CLK_MESON_DUALDIV
+	imply COMMON_CLK_SCMI
+	help
+	  Support for the peripherals clock controller on Amlogic S6 based
+	  devices. Say Y if you want peripherals to work.
+
 config COMMON_CLK_S4_PLL
 	tristate "S4 SoC PLL clock controllers support"
 	depends on ARM64
diff --git a/drivers/clk/meson/Makefile b/drivers/clk/meson/Makefile
index b60664e8f..f06595c4d 100644
--- a/drivers/clk/meson/Makefile
+++ b/drivers/clk/meson/Makefile
@@ -29,5 +29,6 @@ obj-$(CONFIG_COMMON_CLK_MESON8B) += meson8b.o meson8-ddr.o
 obj-$(CONFIG_COMMON_CLK_S4_PLL) += s4-pll.o
 obj-$(CONFIG_COMMON_CLK_S4_PERIPHERALS) += s4-peripherals.o
 obj-$(CONFIG_COMMON_CLK_S6_PLL) += s6-pll.o
+obj-$(CONFIG_COMMON_CLK_S6_PERIPHERALS) += s6-peripherals.o
 obj-$(CONFIG_COMMON_CLK_T7_CPU) += t7-cpu-clkc.o
 obj-$(CONFIG_COMMON_CLK_T7_PLL) += t7-pll.o
 obj-$(CONFIG_COMMON_CLK_T7_PERIPHERALS) += t7-peripherals.o
diff --git a/drivers/clk/meson/s6-peripherals.c b/drivers/clk/meson/s6-peripherals.c
new file mode 100644
index 000000000..278b01d4f
--- /dev/null
+++ b/drivers/clk/meson/s6-peripherals.c
@@ -0,0 +1,4527 @@
