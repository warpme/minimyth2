+/* Reject unsupported sequence syntax before a client commits to hardware. */
+static int vdec_h264_try_ctrl(struct v4l2_ctrl *ctrl)
+{
+	switch (ctrl->id) {
+	case V4L2_CID_STATELESS_H264_SPS:
+		return h264_sps_validate(ctrl->p_new.p_h264_sps) ? -EINVAL : 0;
+	case V4L2_CID_STATELESS_H264_PPS:
+		return ctrl->p_new.p_h264_pps->num_slice_groups_minus1 ?
+		       -EINVAL : 0;
+	case V4L2_CID_STATELESS_H264_SCALING_MATRIX: {
+		const struct v4l2_ctrl_h264_scaling_matrix *sm =
+			ctrl->p_new.p_h264_scaling_matrix;
+		unsigned int i, j;
+
+		if (h264_multi_scaling_lists)
+			return 0;
+
+		/* Only 4:2:0 is admitted by the SPS control. Lists 2..5
+		 * of the 8x8 matrix are unused and may be zero-filled.
+		 */
+		for (i = 0; i < ARRAY_SIZE(sm->scaling_list_4x4); i++)
+			for (j = 0; j < ARRAY_SIZE(sm->scaling_list_4x4[0]); j++)
+				if (sm->scaling_list_4x4[i][j] != 16)
+					return -EINVAL;
+		for (i = 0; i < 2; i++)
+			for (j = 0; j < ARRAY_SIZE(sm->scaling_list_8x8[0]); j++)
+				if (sm->scaling_list_8x8[i][j] != 16)
+					return -EINVAL;
+		return 0;
+	}
+	default:
+		return 0;
+	}
