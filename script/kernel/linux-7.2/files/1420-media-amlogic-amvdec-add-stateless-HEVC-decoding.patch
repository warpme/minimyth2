 	.vertical_size = 16,
@@ -1789,6 +1851,52 @@ static int vdec_init_ctrls(struct amvdec_session *sess)
 				v4l2_ctrl_new_custom(ctrl_handler,
 						     &mpeg2_ctrls[i], NULL);
 		}
