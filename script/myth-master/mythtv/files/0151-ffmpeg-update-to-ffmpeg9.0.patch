+#define SWS_FOR_U8_READ_PACKED(MACRO, ...) \
+    MACRO(__VA_ARGS__, u8_read_packed_xy                       , SWS_PIXEL_U8 , SWS_UOP_READ_PACKED     , 0x3) \
