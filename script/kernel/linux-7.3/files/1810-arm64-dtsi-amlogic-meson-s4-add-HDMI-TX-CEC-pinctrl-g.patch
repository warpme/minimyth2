arm64: dts: amlogic: meson-s4: add HDMI TX CEC pinctrl
 group

Add a pinctrl group routing the AO-CEC-B function to GPIOH_3, next to
the existing HDMI TX HPD and DDC groups. Boards wiring the HDMI CEC
line to this pin can reference it from the CEC node.

---
 arch/arm64/boot/dts/amlogic/meson-s4.dtsi | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/arch/arm64/boot/dts/amlogic/meson-s4.dtsi b/arch/arm64/boot/dts/amlogic/meson-s4.dtsi
index b204307..8b3bfe1 100644
--- a/arch/arm64/boot/dts/amlogic/meson-s4.dtsi
+++ b/arch/arm64/boot/dts/amlogic/meson-s4.dtsi
@@ -890,6 +890,14 @@
 					};
 				};
 
+				hdmitx_cec_pins: hdmitx-cec {
+					mux {
+						groups = "ao_cec_b";
+						function = "ao_cec_b";
+						bias-disable;
+					};
+				};
+
 			};
 
 			gpio_intc: interrupt-controller@4080 {
