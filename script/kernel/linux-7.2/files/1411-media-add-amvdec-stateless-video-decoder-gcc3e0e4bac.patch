+ */
+
+#ifndef __MESON_AMVDEC_CODEC_MPEG12_H_
+#define __MESON_AMVDEC_CODEC_MPEG12_H_
+
+#include "amvdec.h"
+
+extern struct amvdec_codec_ops codec_mpeg12_ops;
+extern struct amvdec_codec_ops codec_mpeg12_sl_ops;
+
+int codec_mpeg12_sl_feed(struct amvdec_session *sess, struct vb2_buffer *vb,
+			 const struct v4l2_ctrl_mpeg2_picture *pic,
+			 u16 temporal_ref);
+bool codec_mpeg12_sl_second_field(struct amvdec_session *sess,
+				  const struct v4l2_ctrl_mpeg2_picture *pic,
+				  u16 *temporal_ref);
+
