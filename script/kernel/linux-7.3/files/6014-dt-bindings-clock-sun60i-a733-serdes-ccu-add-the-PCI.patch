From 494096102da640da0eb8fb1a633199551d099d53 Mon Sep 17 00:00:00 2001
From: Jernej Skrabec <jernej.skrabec@gmail.com>
Date: Thu, 3 Sep 2026 07:01:31 +0200
Subject: [PATCH 057/211] dt-bindings: clock: sun60i-a733-serdes-ccu: add the
 PCIe gate and a syscon

The SerDes subsystem also gates the bus clocks of the PCIe controller,
and the combo PHY driver has to flip a couple of its registers, so
expose the block as a syscon as well.

Signed-off-by: Jernej Skrabec <jernej.skrabec@gmail.com>
---
 .../clock/allwinner,sun60i-a733-serdes-ccu.yaml       | 11 +++++++----
 include/dt-bindings/clock/sun60i-a733-serdes-ccu.h    |  1 +
 2 files changed, 8 insertions(+), 4 deletions(-)

diff --git a/Documentation/devicetree/bindings/clock/allwinner,sun60i-a733-serdes-ccu.yaml b/Documentation/devicetree/bindings/clock/allwinner,sun60i-a733-serdes-ccu.yaml
index b92d670d7a..f21a46228c 100644
--- a/Documentation/devicetree/bindings/clock/allwinner,sun60i-a733-serdes-ccu.yaml
+++ b/Documentation/devicetree/bindings/clock/allwinner,sun60i-a733-serdes-ccu.yaml
@@ -13,7 +13,8 @@ description:
   The SerDes subsystem of the A733 hosts the USB3 controller and the
   PCIe controller. Its top level registers gate the bus clocks of those
   controllers, select the source of the USB3 PIPE clock and hold the
-  reset of the USB2 PHY of the USB3 controller.
+  reset of the USB2 PHY of the USB3 controller. The combo PHY driver
+  needs a few more of the registers, hence the syscon.
 
 properties:
   "#clock-cells":
@@ -23,7 +24,9 @@ properties:
     const: 1
 
   compatible:
-    const: allwinner,sun60i-a733-serdes-ccu
+    items:
+      - const: allwinner,sun60i-a733-serdes-ccu
+      - const: syscon
 
   reg:
     maxItems: 1
@@ -66,8 +69,8 @@ examples:
     #include <dt-bindings/reset/sun60i-a733-ccu.h>
 
     clock-controller@6c00000 {
-        compatible = "allwinner,sun60i-a733-serdes-ccu";
-        reg = <0x06c00000 0x1000>;
+        compatible = "allwinner,sun60i-a733-serdes-ccu", "syscon";
+        reg = <0x06c00000 0x400>;
         clocks = <&ccu CLK_AHB_SERDES>, <&ccu CLK_MBUS_SERDES>,
                  <&ccu CLK_SERDES_PHY>, <&ccu CLK_USB2_U2_PIPE>;
         clock-names = "ahb", "mbus", "cfg", "u2-pipe";
diff --git a/include/dt-bindings/clock/sun60i-a733-serdes-ccu.h b/include/dt-bindings/clock/sun60i-a733-serdes-ccu.h
index a9f5492d38..f3038460f6 100644
--- a/include/dt-bindings/clock/sun60i-a733-serdes-ccu.h
+++ b/include/dt-bindings/clock/sun60i-a733-serdes-ccu.h
@@ -9,5 +9,6 @@
 #define CLK_SERDES_USB3_HCLK	0
 #define CLK_SERDES_USB3_ACLK	1
 #define CLK_SERDES_USB3_PIPE	2
+#define CLK_SERDES_PCIE		3
 
 #endif /* _DT_BINDINGS_CLK_SUN60I_A733_SERDES_CCU_H_ */
-- 
2.53.0

