+	ts = hevc->tile_row_start[ty] * hevc->lcu_x_num +
+	     (hevc->tile_row_start[ty + 1] - hevc->tile_row_start[ty]) *
+	     hevc->tile_col_start[tx];
+	return ts + (y - hevc->tile_row_start[ty]) * w +
+	       x - hevc->tile_col_start[tx];
