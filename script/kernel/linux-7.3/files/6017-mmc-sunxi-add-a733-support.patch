From 4e9d2c3505655c82920f2abe28740dfb314b8b1d Mon Sep 17 00:00:00 2001
From: Jernej Skrabec <jernej.skrabec@gmail.com>
Date: Sun, 23 Aug 2026 15:23:11 +0200
Subject: [PATCH 081/211] mmc: sunxi: Double the module clock for UHS DDR50

The new timing mode requires a doubled module clock for every DDR
timing, but the internal divider was only set up for MMC DDR52. Cover
UHS DDR50 as well, so the delay-chain tuning path clocks it correctly
once boards enable signal voltage switching.

Signed-off-by: Jernej Skrabec <jernej.skrabec@gmail.com>
---
 drivers/mmc/host/sunxi-mmc.c | 12 +++++-------
 1 file changed, 5 insertions(+), 7 deletions(-)

diff --git a/drivers/mmc/host/sunxi-mmc.c b/drivers/mmc/host/sunxi-mmc.c
index 35ebc9d90c..243180a6d7 100644
--- a/drivers/mmc/host/sunxi-mmc.c
+++ b/drivers/mmc/host/sunxi-mmc.c
@@ -781,14 +781,12 @@ static int sunxi_mmc_clk_set_rate(struct sunxi_mmc_host *host,
 	 * Under the old timing mode, 8 bit DDR requires the module
 	 * clock to be double the card clock. Under the new timing
 	 * mode, all DDR modes require a doubled module clock.
-	 *
-	 * We currently only support the standard MMC DDR52 mode.
-	 * This block should be updated once support for other DDR
-	 * modes is added.
 	 */
-	if (ios->timing == MMC_TIMING_MMC_DDR52 &&
-	    (host->use_new_timings ||
-	     ios->bus_width == MMC_BUS_WIDTH_8)) {
+	if ((ios->timing == MMC_TIMING_MMC_DDR52 &&
+	     ios->bus_width == MMC_BUS_WIDTH_8) ||
+	    (host->use_new_timings &&
+	     (ios->timing == MMC_TIMING_MMC_DDR52 ||
+	      ios->timing == MMC_TIMING_UHS_DDR50))) {
 		div = 2;
 		clock <<= 1;
 	}
-- 
2.53.0

From 082a8cfa805abf3d99de4419eff6936eeb2bf14d Mon Sep 17 00:00:00 2001
From: Jernej Skrabec <jernej.skrabec@gmail.com>
Date: Sat, 22 Aug 2026 07:11:01 +0200
Subject: [PATCH 082/211] mmc: sunxi: Add A523 clock phases

The A523 v5p3x controller uses register-selected drive and sample
phases. Program the SDK defaults when the card clock changes.

Signed-off-by: Jernej Skrabec <jernej.skrabec@gmail.com>
---
 drivers/mmc/host/sunxi-mmc.c | 106 ++++++++++++++++++++++++++++++-----
 1 file changed, 91 insertions(+), 15 deletions(-)

diff --git a/drivers/mmc/host/sunxi-mmc.c b/drivers/mmc/host/sunxi-mmc.c
index 243180a6d7..ae9aec8d8b 100644
--- a/drivers/mmc/host/sunxi-mmc.c
+++ b/drivers/mmc/host/sunxi-mmc.c
@@ -9,6 +9,7 @@
  * (C) Copyright 2017 Sootech SA
  */
 
+#include <linux/bitfield.h>
 #include <linux/clk.h>
 #include <linux/clk/sunxi-ng.h>
 #include <linux/delay.h>
@@ -224,8 +225,17 @@
 #define SDXC_CLK_50M		2
 #define SDXC_CLK_50M_DDR	3
 #define SDXC_CLK_50M_DDR_8BIT	4
+#define SDXC_CLK_HIGH_SPEED	5
+#define SDXC_CLK_MODES		6
 
+/* SDXC_REG_SD_NTSR bits */
 #define SDXC_2X_TIMING_MODE	BIT(31)
+#define SDXC_STIMING_DAT_PH	GENMASK(9, 8)
+#define SDXC_STIMING_CMD_PH	GENMASK(5, 4)
+
+/* SDXC_REG_DRV_DL bits, 0 selects 90 and 1 selects 180 degrees */
+#define SDXC_DAT_DRV_PH_SEL	BIT(17)
+#define SDXC_CMD_DRV_PH_SEL	BIT(16)
 
 #define SDXC_CAL_START		BIT(15)
 #define SDXC_CAL_DONE		BIT(14)
@@ -241,6 +251,13 @@ struct sunxi_mmc_clk_delay {
 	u32 sample;
 };
 
+struct sunxi_mmc_timing {
+	u8 cmd_drv_phase;
+	u8 dat_drv_phase;
+	u8 cmd_sample_phase;
+	u8 dat_sample_phase;
+};
+
 struct sunxi_idma_des {
 	__le32 config;
 	__le32 buf_size;
@@ -253,6 +270,8 @@ struct sunxi_mmc_cfg {
 	u32 idma_des_shift;
 	const struct sunxi_mmc_clk_delay *clk_delays;
 
+	const struct sunxi_mmc_timing *timings;
+
 	/* does the IP block support autocalibration? */
 	bool can_calibrate;
 
@@ -718,6 +737,26 @@ static int sunxi_mmc_calibrate(struct sunxi_mmc_host *host, int reg_off)
 	return 0;
 }
 
+static int sunxi_mmc_clk_mode(struct mmc_ios *ios, u32 rate)
+{
+	if (rate <= 400000)
+		return SDXC_CLK_400K;
+
+	if (rate <= 25000000)
+		return SDXC_CLK_25M;
+
+	if (rate <= 52000000) {
+		if (ios->timing != MMC_TIMING_UHS_DDR50 &&
+		    ios->timing != MMC_TIMING_MMC_DDR52)
+			return SDXC_CLK_50M;
+		if (ios->bus_width == MMC_BUS_WIDTH_8)
+			return SDXC_CLK_50M_DDR_8BIT;
+		return SDXC_CLK_50M_DDR;
+	}
+
+	return SDXC_CLK_HIGH_SPEED;
+}
+
 static int sunxi_mmc_clk_set_phase(struct sunxi_mmc_host *host,
 				   struct mmc_ios *ios, u32 rate)
 {
@@ -731,21 +770,8 @@ static int sunxi_mmc_clk_set_phase(struct sunxi_mmc_host *host,
 	if (!host->cfg->clk_delays)
 		return 0;
 
-	/* determine delays */
-	if (rate <= 400000) {
-		index = SDXC_CLK_400K;
-	} else if (rate <= 25000000) {
-		index = SDXC_CLK_25M;
-	} else if (rate <= 52000000) {
-		if (ios->timing != MMC_TIMING_UHS_DDR50 &&
-		    ios->timing != MMC_TIMING_MMC_DDR52) {
-			index = SDXC_CLK_50M;
-		} else if (ios->bus_width == MMC_BUS_WIDTH_8) {
-			index = SDXC_CLK_50M_DDR_8BIT;
-		} else {
-			index = SDXC_CLK_50M_DDR;
-		}
-	} else {
+	index = sunxi_mmc_clk_mode(ios, rate);
+	if (index == SDXC_CLK_HIGH_SPEED) {
 		dev_dbg(mmc_dev(host->mmc), "Invalid clock... returning\n");
 		return -EINVAL;
 	}
@@ -759,6 +785,32 @@ static int sunxi_mmc_clk_set_phase(struct sunxi_mmc_host *host,
 			     host->cfg->clk_delays[index].output);
 }
 
+static void sunxi_mmc_set_timing_phase(struct sunxi_mmc_host *host,
+				       struct mmc_ios *ios, u32 rate)
+{
+	const struct sunxi_mmc_timing *timing;
+	u32 rval;
+
+	if (!host->cfg->timings || !host->use_new_timings)
+		return;
+
+	timing = &host->cfg->timings[sunxi_mmc_clk_mode(ios, rate)];
+
+	rval = mmc_readl(host, REG_DRV_DL);
+	rval &= ~(SDXC_CMD_DRV_PH_SEL | SDXC_DAT_DRV_PH_SEL);
+	if (timing->cmd_drv_phase)
+		rval |= SDXC_CMD_DRV_PH_SEL;
+	if (timing->dat_drv_phase)
+		rval |= SDXC_DAT_DRV_PH_SEL;
+	mmc_writel(host, REG_DRV_DL, rval);
+
+	rval = mmc_readl(host, REG_SD_NTSR);
+	rval &= ~(SDXC_STIMING_CMD_PH | SDXC_STIMING_DAT_PH);
+	rval |= FIELD_PREP(SDXC_STIMING_CMD_PH, timing->cmd_sample_phase);
+	rval |= FIELD_PREP(SDXC_STIMING_DAT_PH, timing->dat_sample_phase);
+	mmc_writel(host, REG_SD_NTSR, rval);
+}
+
 static int sunxi_mmc_clk_set_rate(struct sunxi_mmc_host *host,
 				  struct mmc_ios *ios)
 {
@@ -844,6 +896,8 @@ static int sunxi_mmc_clk_set_rate(struct sunxi_mmc_host *host,
 	if (ret)
 		return ret;
 
+	sunxi_mmc_set_timing_phase(host, ios, rate);
+
 	ret = sunxi_mmc_calibrate(host, SDXC_REG_SAMP_DL_REG);
 	if (ret)
 		return ret;
@@ -1199,6 +1253,27 @@ static const struct sunxi_mmc_cfg sun50i_h616_cfg = {
 	.needs_new_timings = true,
 };
 
+static const struct sunxi_mmc_timing sun55i_a523_timings[SDXC_CLK_MODES] = {
+	[SDXC_CLK_400K]		= { .cmd_drv_phase = 1 },
+	[SDXC_CLK_25M]		= { .cmd_drv_phase = 1 },
+	[SDXC_CLK_50M]		= { .cmd_drv_phase = 1, .dat_drv_phase = 1,
+				    .cmd_sample_phase = 1, .dat_sample_phase = 1 },
+	[SDXC_CLK_50M_DDR]	= { .cmd_drv_phase = 1, .dat_drv_phase = 1,
+				    .cmd_sample_phase = 1, .dat_sample_phase = 1 },
+	[SDXC_CLK_50M_DDR_8BIT]	= { .cmd_drv_phase = 1, .dat_drv_phase = 1,
+				    .cmd_sample_phase = 1, .dat_sample_phase = 1 },
+	[SDXC_CLK_HIGH_SPEED]	= { .cmd_drv_phase = 1 },
+};
+
+static const struct sunxi_mmc_cfg sun55i_a523_cfg = {
+	.idma_des_size_bits = 13,
+	.idma_des_shift = 2,
+	.can_calibrate = true,
+	.mask_data0 = true,
+	.needs_new_timings = true,
+	.timings = sun55i_a523_timings,
+};
+
 static const struct sunxi_mmc_cfg sun50i_a100_emmc_cfg = {
 	.idma_des_size_bits = 13,
 	.idma_des_shift = 2,
@@ -1219,6 +1294,7 @@ static const struct of_device_id sunxi_mmc_of_match[] = {
 	{ .compatible = "allwinner,sun50i-a100-mmc", .data = &sun20i_d1_cfg },
 	{ .compatible = "allwinner,sun50i-a100-emmc", .data = &sun50i_a100_emmc_cfg },
 	{ .compatible = "allwinner,sun50i-h616-mmc", .data = &sun50i_h616_cfg },
+	{ .compatible = "allwinner,sun55i-a523-mmc", .data = &sun55i_a523_cfg },
 	{ /* sentinel */ }
 };
 MODULE_DEVICE_TABLE(of, sunxi_mmc_of_match);
-- 
2.53.0

From e627cbd63183911332500b7d130929fa2b959d5c Mon Sep 17 00:00:00 2001
From: Jernej Skrabec <jernej.skrabec@gmail.com>
Date: Sat, 22 Aug 2026 07:11:19 +0200
Subject: [PATCH 083/211] mmc: sunxi: Add A523 delay-chain tuning

Switch A523 SDR50, SDR104 and HS200 to 1x mode and scan the sampling
delay. Match the SDK scan parameters and FIFO threshold settings. Keep
older generations on their existing timing paths.

DDR50 keeps using the 2x timing mode and its phase settings: the
sampling scan finds no working delay at all in DDR mode, while the
phase table works, and both were checked on a Cubie A5E.

Signed-off-by: Jernej Skrabec <jernej.skrabec@gmail.com>
---
 drivers/mmc/host/sunxi-mmc.c | 175 +++++++++++++++++++++++++++++++++--
 1 file changed, 168 insertions(+), 7 deletions(-)

diff --git a/drivers/mmc/host/sunxi-mmc.c b/drivers/mmc/host/sunxi-mmc.c
index ae9aec8d8b..036a92a974 100644
--- a/drivers/mmc/host/sunxi-mmc.c
+++ b/drivers/mmc/host/sunxi-mmc.c
@@ -71,6 +71,7 @@
 /* New registers introduced in A64 */
 #define SDXC_REG_A12A		0x058 /* SMC Auto Command 12 Register */
 #define SDXC_REG_SD_NTSR	0x05C /* SMC New Timing Set Register */
+#define SDXC_REG_THLD		0x100 /* SMC card threshold control */
 #define SDXC_REG_DRV_DL		0x140 /* Drive Delay Control Register */
 #define SDXC_REG_SAMP_DL_REG	0x144 /* SMC sample delay control */
 #define SDXC_REG_DS_DL_REG	0x148 /* SMC data strobe delay control */
@@ -228,6 +229,14 @@
 #define SDXC_CLK_HIGH_SPEED	5
 #define SDXC_CLK_MODES		6
 
+/* SDXC_REG_THLD bits */
+#define SDXC_CARD_RD_THLD	GENMASK(27, 16)
+#define SDXC_CARD_RD_THLD_ENB	BIT(0)
+
+/* SDXC_REG_SAMP_DL bits */
+#define SDXC_SAMP_DL_SW		GENMASK(5, 0)
+#define SDXC_SAMP_DL_SW_EN	BIT(7)
+
 /* SDXC_REG_SD_NTSR bits */
 #define SDXC_2X_TIMING_MODE	BIT(31)
 #define SDXC_STIMING_DAT_PH	GENMASK(9, 8)
@@ -271,6 +280,7 @@ struct sunxi_mmc_cfg {
 	const struct sunxi_mmc_clk_delay *clk_delays;
 
 	const struct sunxi_mmc_timing *timings;
+	bool can_tune;
 
 	/* does the IP block support autocalibration? */
 	bool can_calibrate;
@@ -323,6 +333,9 @@ struct sunxi_mmc_host {
 	/* vqmmc */
 	bool		vqmmc_enabled;
 
+	u32		sample_delay;
+	bool		tuning;
+
 	/* timings */
 	bool		use_new_timings;
 };
@@ -489,7 +502,11 @@ static void sunxi_mmc_send_manual_stop(struct sunxi_mmc_host *host,
 			   1, 1000000);
 
 	if (!(ri & SDXC_COMMAND_DONE) || (ri & SDXC_INTERRUPT_ERROR_BIT)) {
-		dev_err(mmc_dev(host->mmc), "send stop command failed\n");
+		if (host->tuning)
+			dev_dbg(mmc_dev(host->mmc), "send stop command failed\n");
+		else
+			dev_err_ratelimited(mmc_dev(host->mmc),
+					    "send stop command failed\n");
 		if (req->stop)
 			req->stop->resp[0] = -ETIMEDOUT;
 	} else {
@@ -657,7 +674,11 @@ static irqreturn_t sunxi_mmc_handle_manual_stop(int irq, void *dev_id)
 		return IRQ_HANDLED;
 	}
 
-	dev_err(mmc_dev(host->mmc), "data error, sending stop command\n");
+	if (host->tuning)
+		dev_dbg(mmc_dev(host->mmc), "data error, sending stop command\n");
+	else
+		dev_err_ratelimited(mmc_dev(host->mmc),
+				    "data error, sending stop command\n");
 
 	/*
 	 * We will never have more than one outstanding request,
@@ -811,6 +832,71 @@ static void sunxi_mmc_set_timing_phase(struct sunxi_mmc_host *host,
 	mmc_writel(host, REG_SD_NTSR, rval);
 }
 
+#define SUNXI_MMC_SAMPLE_DELAYS		64
+#define SUNXI_MMC_SAMPLE_WINDOW_MIN	12
+#define SUNXI_MMC_TUNING_RETRIES	20
+
+/*
+ * The sample delay chain is only connected to the input latches in 1x
+ * mode, so tuned timings must run with the 2x timing mode disabled.
+ */
+static bool sunxi_mmc_timing_needs_tuning(struct sunxi_mmc_host *host,
+					  struct mmc_ios *ios)
+{
+	if (!host->cfg->can_tune)
+		return false;
+
+	switch (ios->timing) {
+	case MMC_TIMING_UHS_SDR50:
+	case MMC_TIMING_UHS_SDR104:
+	case MMC_TIMING_MMC_HS200:
+		return true;
+	default:
+		return false;
+	}
+}
+
+/* Leave the RX trigger level free when the block is buffered in the FIFO. */
+#define SUNXI_MMC_FIFO_BYTES		1024
+#define SUNXI_MMC_FIFO_RX_TRIGGER	(7 * 4)
