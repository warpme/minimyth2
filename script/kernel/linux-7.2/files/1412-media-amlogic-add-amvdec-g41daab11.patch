+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Userspace equivalence check of codec_hevc_open_rec.h (the driver's open-HEVC
+ * record builder) against hevc_host.py, on controls built as FFmpeg builds
+ * them (ohevc_rec_gen.py).
+ *
+ *   gcc -O2 -Wall -I.. -o ohevc_rec_test ohevc_rec_test.c
+ *   ./ohevc_rec_gen.py t.txt t.bin streams... && ./ohevc_rec_test t.txt t.bin
+ *
+ * Compared word for word: the picture record (except the three scaling IDX
+ * words), every slice-segment record (header bits, NAL offsets, lists,
+ * flags, weights), the stream buffer bytes.  Where V4L2 carries a derived
+ * form instead of the syntax, the comparison is on what the hardware
+ * computes from the record:
+ *   - scaling: per (size, matrix) the effective coefficients and DC (a LUT
+ *     slot, or the built-in default 14/15);
+ *   - weights: per list entry LumaWeight, luma offset, ChromaWeight and the
+ *     clipped ChromaOffset (7-56) from (flag, deltas).
+ * Differences that are FFmpeg's (a 16th weighted reference: FFmpeg fills 15)
+ * are counted apart.
+ */
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <linux/v4l2-controls.h>
+
+typedef uint8_t u8;
+typedef uint16_t u16;
+typedef uint32_t u32;
+typedef uint64_t u64;
+typedef int8_t s8;
+typedef int16_t s16;
+typedef int32_t s32;
+
+#define BIT(n)		(1u << (n))
+
+#include "codec_hevc_open_rec.h"
+
+static const char *const why_str[] = {
+	"ok", "format", "tiles", "slices", "nal", "header", "ref", "stream",
+};
+
+static char *tok;
+
+static long next_long(void)
+{
+	char *end;
+	long v = strtol(tok, &end, 0);
+
+	tok = end;
+	return v;
+}
+
+static long next_hex(void)
+{
+	char *end;
+	long v = strtol(tok, &end, 16);
+
+	tok = end;
+	return v;
+}
+
+/* effective (coefs, dc) of (size, m) from a LUT image + IDX words */
+static void eff_matrix(const u8 *lut, const u32 *idx, u32 size, u32 m, u8 *c, u32 *dc)
+{
+	u32 mm = size < 3 ? m : m / 3, reg = size < 2 ? size : 2;
+	u32 shift = size < 3 ? 4 * mm : 24 + 4 * mm, v = (idx[reg] >> shift) & 0xf;
+	u32 n = size ? 64 : 16, i, base;
+
+	if (v == 14 || v == 15) {
+		for (i = 0; i < n; i++)
+			c[i] = n == 16 ? 16 : ohevc_default8[v == 15][i];
+		*dc = 16;
+		return;
+	}
+	base = size == 0 ? 0x380 + 16 * v : size == 1 ? 64 * v : size == 2 ? 0x180 + 64 * v : 0x300 + 64 * v;
+	memcpy(c, lut + base, n);
+	*dc = size == 2 ? lut[0x3e0 + v] : size == 3 ? lut[0x3e6 + v] : 16;
+}
+
+static int clip3(int lo, int hi, int v)
+{
+	return v < lo ? lo : v > hi ? hi : v;
+}
+
+/* effective weights of entry i of list li from a slice record */
+static void eff_weight(const u16 *q, u32 li, u32 i, int *o)
+{
+	u32 ld = q[OHEVC_S_WP] & 7, j;
+	int cd = ld + (s8)(q[OHEVC_S_WP] >> 8);
+	const u16 *e = q + (li ? OHEVC_S_WT1 : OHEVC_S_WT0) + 4 * i;
+	bool lf = q[OHEVC_S_WPF + 2 * li] >> i & 1, cf = q[OHEVC_S_WPF + 2 * li + 1] >> i & 1;
+	int dcw[2] = { (s8)(e[0] >> 8), (s8)e[1] }, dco[2] = { (s16)e[2], (s16)e[3] };
+
+	o[0] = (1 << ld) + (lf ? (s8)e[0] : 0);
+	o[1] = lf ? (s8)(e[1] >> 8) : 0;
+	for (j = 0; j < 2; j++) {
+		int w = (1 << cd) + (cf ? dcw[j] : 0);
+
+		o[2 + j] = w;
+		o[4 + j] = cf ? clip3(-128, 127, 128 - ((128 * w) >> cd) + dco[j]) : 0;
+	}
+}
+
+/*
+ * A slice header with an emulation-prevention byte inside it (none of the
+ * conformance vectors has one): FFmpeg counts data_byte_offset from the NAL
+ * start in unescaped bytes.
+ */
+static int selftest_epb(void)
+{
+	static const u8 d[] = { 0, 0, 1, 0x26, 0x01, 0xa0, 0x00, 0x00, 0x03, 0x01, 0x80, 0x55, 0xaa };
+	struct v4l2_ctrl_hevc_slice_params s = {
+		.nal_unit_type = 19, .data_byte_offset = 3 + 7, .bit_size = (10 - 7) * 8,
+	};
+	u32 start, end, hbits;
+
+	if (ohevc_nal(d, sizeof(d), 0, &s, &start, &end, &hbits) != OHEVC_OK ||
+	    start != 3 || end != sizeof(d) || hbits != 48) {
+		printf("selftest: EPB inside the slice header: start %u end %u header bits %u (expected 3 %zu 48)\n",
+		       start, end, hbits, sizeof(d));
+		return 1;
+	}
+	return 0;
+}
+
+int main(int argc, char **argv)
+{
