--- linux-7.3/drivers/clk/meson/sc2_clk_regmap.c	1970-01-01 01:00:00.000000000 +0100
+++ linux-7.3/drivers/clk/meson/sc2_clk_regmap.c	2026-10-27 16:22:58.250112042 +0100
@@ -0,0 +1,233 @@
+// SPDX-License-Identifier: GPL-2.0
