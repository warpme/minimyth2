diff --speed-large-files --no-dereference --minimal -Naur linux-7.3-rc3/arch/arm64/boot/dts/rockchip/rk3568-rock-3b.dts linux-7.3-rc3/arch/arm64/boot/dts/rockchip/rk3568-rock-3b.dts
--- linux-7.3-rc3/arch/arm64/boot/dts/rockchip/rk3568-rock-3b.dts	2026-09-13 23:38:02.000000000 +0200
+++ linux-7.3-rc3/arch/arm64/boot/dts/rockchip/rk3568-rock-3b.dts	2026-09-15 19:36:59.562102457 +0200
@@ -15,8 +15,8 @@
 	aliases {
 		ethernet0 = &gmac0;
 		ethernet1 = &gmac1;
-		mmc0 = &sdhci;
-		mmc1 = &sdmmc0;
+		mmc1 = &sdhci;
+		mmc0 = &sdmmc0;
 		mmc2 = &sdmmc2;
 	};
 
@@ -40,6 +40,8 @@
 		gpios = <&gpio0 RK_PC2 GPIO_ACTIVE_LOW>;
 		pinctrl-names = "default";
 		pinctrl-0 = <&pwm3_ir>;
+		linux,rc-map-name = "rc-beelink-gs1";
+		status = "okay";
 	};
 
 	leds {
@@ -50,9 +52,9 @@
 		led-0 {
 			color = <LED_COLOR_ID_GREEN>;
 			default-state = "on";
-			function = LED_FUNCTION_HEARTBEAT;
+			function = LED_FUNCTION_DISK_ACTIVITY;
 			gpios = <&gpio0 RK_PB7 GPIO_ACTIVE_HIGH>;
-			linux,default-trigger = "heartbeat";
+			linux,default-trigger = "disk-activity";
 		};
 	};
 
