+static void codec_h264_multi_dump_recovery_regs(struct amvdec_session *sess,
+						 const char *tag)
+{
+	struct amvdec_core *core = sess->core;
+	u32 scratch[16];
+	int i;
+
+	if (!READ_ONCE(h264_multi_recovery_dump))
+		return;
+
+	for (i = 0; i < 16; i++)
+		scratch[i] = amvdec_read_dos(core, AV_SCRATCH_0 + i * 4);
+
+	dev_info(core->dev_dec,
+		 "H264_A7_DUMP tag=%s viff=%#x decode_size=%#x vififo_start=%#x curr=%#x end=%#x wp=%#x rp=%#x level=%#x buf_cntl=%#x bytes=%#x wrap=%#x\n",
+		 tag, amvdec_read_dos(core, VIFF_BIT_CNT),
+		 amvdec_read_dos(core, H264_DECODE_SIZE),
+		 amvdec_read_dos(core, VLD_MEM_VIFIFO_START_PTR),
+		 amvdec_read_dos(core, VLD_MEM_VIFIFO_CURR_PTR),
+		 amvdec_read_dos(core, VLD_MEM_VIFIFO_END_PTR),
+		 amvdec_read_dos(core, VLD_MEM_VIFIFO_WP),
+		 amvdec_read_dos(core, VLD_MEM_VIFIFO_RP),
+		 amvdec_read_dos(core, VLD_MEM_VIFIFO_LEVEL),
+		 amvdec_read_dos(core, VLD_MEM_VIFIFO_BUF_CNTL),
+		 amvdec_read_dos(core, VLD_MEM_VIFIFO_BYTES_AVAIL),
+		 amvdec_read_dos(core, VLD_MEM_VIFIFO_WRAP_COUNT));
+	dev_info(core->dev_dec,
+		 "H264_A7_DUMP tag=%s power_vld=%#x vld_decode=%#x wrrsp=%#x lmem_dma=%#x imem_dma=%#x debug1=%#x init=%#x mpc_e=%#x\n",
+		 tag, amvdec_read_dos(core, POWER_CTL_VLD),
+		 amvdec_read_dos(core, VLD_DECODE_CONTROL),
+		 amvdec_read_dos(core, WRRSP_LMEM),
+		 amvdec_read_dos(core, LMEM_DMA_CTRL),
+		 amvdec_read_dos(core, IMEM_DMA_CTRL),
+		 amvdec_read_dos(core, DEBUG_REG1),
+		 amvdec_read_dos(core, INIT_FLAG_REG),
+		 amvdec_read_dos(core, MPC_E));
+	dev_info(core->dev_dec,
+		 "H264_A7_DUMP tag=%s pic_dc_ctrl=%#x pic_dc_status=%#x dos_gen=%#x mmc_ctrl1=%#x pic_dc_mux=%#x nal_search=%#x mpsr=%#x cpsr=%#x\n",
+		 tag, amvdec_read_dos(core, MDEC_PIC_DC_CTRL),
+		 amvdec_read_dos(core, MDEC_PIC_DC_STATUS),
+		 amvdec_read_dos(core, DOS_GEN_CTRL0),
+		 amvdec_read_dos(core, VDEC_ASSIST_MMC_CTRL1),
+		 amvdec_read_dos(core, MDEC_PIC_DC_MUX_CTRL),
+		 amvdec_read_dos(core, NAL_SEARCH_CTL),
+		 amvdec_read_dos(core, MPSR), amvdec_read_dos(core, CPSR));
+	dev_info(core->dev_dec,
+		 "H264_A7_DUMP tag=%s scratch0_7=%#x,%#x,%#x,%#x,%#x,%#x,%#x,%#x\n",
+		 tag, scratch[0], scratch[1], scratch[2], scratch[3], scratch[4],
+		 scratch[5], scratch[6], scratch[7]);
+	dev_info(core->dev_dec,
+		 "H264_A7_DUMP tag=%s scratch8_n=%#x,%#x,%#x,%#x,%#x,%#x,%#x,%#x\n",
+		 tag, scratch[8], scratch[9], scratch[10], scratch[11], scratch[12],
+		 scratch[13], scratch[14], scratch[15]);
+}
+
+static void codec_h264_multi_abort_summary(struct amvdec_session *sess,
+					   const char *tag)
+{
+	struct amvdec_core *core = sess->core;
+	u32 rp0 = amvdec_read_dos(core, VLD_MEM_VIFIFO_RP);
+	u32 rp1;
+
+	udelay(30);
+	rp1 = amvdec_read_dos(core, VLD_MEM_VIFIFO_RP);
+	dev_info(core->dev_dec,
+		 "H264_ABORT_STATE tag=%s wrrsp_low=%#x lmem_busy=%u imem_busy=%u mpsr=%#x cpsr=%#x rp0=%#x rp1=%#x rp_moving=%u\n",
+		 tag, amvdec_read_dos(core, WRRSP_LMEM) & 0xfff,
+		 !!(amvdec_read_dos(core, LMEM_DMA_CTRL) & 0x8000),
+		 !!(amvdec_read_dos(core, IMEM_DMA_CTRL) & 0x8000),
+		 amvdec_read_dos(core, MPSR), amvdec_read_dos(core, CPSR),
+		 rp0, rp1, rp0 != rp1);
+}
+
+static void codec_h264_multi_maybe_recovery_reset(struct amvdec_session *sess)
+{
+	struct amvdec_core *core = sess->core;
+	u32 action = READ_ONCE(h264_multi_recovery_reset7);
+	u32 bits = 0;
+
+	if (!action)
+		return;
+	WRITE_ONCE(h264_multi_recovery_reset7, 0);
+
+	if (action == 1)
+		bits = BIT(13) | BIT(14);
+	else if (action == 2)
+		bits = BIT(15);
+	else {
+		dev_warn(core->dev_dec, "H264_RECOVERY_RESET7 unknown action=%u\n", action);
+		return;
+	}
+
+	dev_info(core->dev_dec, "H264_RECOVERY_RESET7 action=%u bits=%#x\n", action, bits);
+	amvdec_reset7_level_toggle(core, bits);
+}
+
+static void codec_h264_multi_warn_poison(struct amvdec_session *sess, u32 status,
+						u32 bit_count, u32 level, u32 rp,
+						u32 wp)
+{
+	struct codec_h264 *h264 = sess->priv;
+	struct amvdec_core *core = sess->core;
+	u32 now_crc;
+
+	if (!h264 || h264->multi_poison_warned || !h264->multi_slice_data ||
+	    h264->multi_pic_count != 1 || status != H264_SEARCH_BUFEMPTY ||
+	    bit_count || !level)
+		return;
+
+	h264->multi_poison_warned = true;
+	now_crc = crc32_le(0, h264->multi_slice_data, h264->multi_src_payload);
+	dev_warn(core->dev_dec,
+		 "H264_MULTI_POISON first-picture status=%#x bit_count=%#x level=%#x src=%pad payload=%u crc_queue=%08x crc_now=%08x workspace=%pad lmem=%pad aux=%pad colocate=%pad ext=%pad start=%#x rp=%#x wp=%#x\n",
+		 status, bit_count, level, &h264->multi_src_dma,
+		 h264->multi_src_payload, h264->multi_src_crc, now_crc,
+		 &h264->workspace_paddr, &h264->lmem_paddr, &h264->aux_paddr,
+		 &h264->colocate_paddr, &h264->ext_fw_paddr,
+		 amvdec_read_dos(core, VLD_MEM_VIFIFO_START_PTR), rp, wp);
+}
+
+static void codec_h264_multi_vendor_stop(struct amvdec_session *sess,
+					 const char *tag)
+{
+	struct codec_h264 *h264 = sess->priv;
+	struct amvdec_core *core = sess->core;
+	u32 rp0, rp1;
+	int i;
+
+	if (!READ_ONCE(h264_multi_halt_on_abort) || !h264 || !h264->multi_blob ||
+	    !h264->multi_powered || !h264->multi_hw_started)
+		return;
+
+	dev_info(core->dev_dec, "H264_VENDOR_STOP tag=%s begin\n", tag);
+	amvdec_write_dos(core, MPSR, 0);
+	amvdec_write_dos(core, CPSR, 0);
+
+	for (i = 0; i < 1000; i++) {
+		if (!(amvdec_read_dos(core, IMEM_DMA_CTRL) & 0x8000))
+			break;
+		udelay(10);
+	}
+	if (i == 1000)
+		dev_warn(core->dev_dec, "H264_VENDOR_STOP tag=%s IMEM DMA did not drain ctrl=%#x\n",
+			 tag, amvdec_read_dos(core, IMEM_DMA_CTRL));
+
+	for (i = 0; i < 1000; i++) {
+		if (!(amvdec_read_dos(core, LMEM_DMA_CTRL) & 0x8000))
+			break;
+		udelay(10);
+	}
+	if (i == 1000)
+		dev_warn(core->dev_dec, "H264_VENDOR_STOP tag=%s LMEM DMA did not drain ctrl=%#x\n",
+			 tag, amvdec_read_dos(core, LMEM_DMA_CTRL));
+
+	for (i = 0; i < 1000; i++) {
+		if (!(amvdec_read_dos(core, WRRSP_LMEM) & 0xfff))
+			break;
+		udelay(10);
+	}
+	if (i == 1000)
+		dev_warn(core->dev_dec, "H264_VENDOR_STOP tag=%s WRRSP_LMEM did not drain wrrsp=%#x\n",
+			 tag, amvdec_read_dos(core, WRRSP_LMEM));
+
+	amvdec_write_dos(core, DOS_SW_RESET0, BIT(12) | BIT(11));
+	amvdec_write_dos(core, DOS_SW_RESET0, 0);
+	amvdec_read_dos(core, DOS_SW_RESET0);
+
+	for (i = 0; i < 100; i++) {
+		rp0 = amvdec_read_dos(core, VLD_MEM_VIFIFO_RP);
+		udelay(30);
+		rp1 = amvdec_read_dos(core, VLD_MEM_VIFIFO_RP);
+		if (rp0 == rp1)
+			break;
+	}
+	if (i == 100)
+		dev_warn(core->dev_dec, "H264_VENDOR_STOP tag=%s VIFIFO_RP still moving rp0=%#x rp1=%#x\n",
+			 tag, rp0, rp1);
+
+	amvdec_write_dos(core, VLD_MEM_VIFIFO_CONTROL, BIT(15));
+	h264->multi_hw_started = false;
+	dev_info(core->dev_dec,
+		 "H264_VENDOR_STOP tag=%s done rp0=%#x rp1=%#x level=%#x bitcnt=%#x\n",
+		 tag, rp0, rp1, amvdec_read_dos(core, VLD_MEM_VIFIFO_LEVEL),
+		 amvdec_read_dos(core, VIFF_BIT_CNT));
+}
+
+static void codec_h264_job_abort(struct amvdec_session *sess)
+{
+	codec_h264_multi_vendor_stop(sess, "timeout");
+}
+
+static void codec_h264_pre_stop(struct amvdec_session *sess)
+{
+	codec_h264_multi_vendor_stop(sess, "stop");
+}
+
+static void codec_h264_multi_abort(struct amvdec_session *sess)
+{
+	struct codec_h264 *h264 = sess->priv;
+	unsigned long flags;
+
+	if (h264 && h264->multi_blob) {
+		codec_h264_multi_abort_summary(sess, "abort");
+		codec_h264_multi_vendor_stop(sess, "abort");
+	}
+
+	if (h264->multi_field_picture) {
+		spin_lock_irqsave(&h264->multi_field_lock, flags);
+		/* A later abort cannot revoke an already claimed result. */
+		if (h264->multi_field_phase != 4) {
+			h264->multi_decoded_fields = 0;
+			h264->multi_field_phase = 3;
+			if (h264->multi_pic_fw_idx < ARRAY_SIZE(h264->multi_field_slots))
+				h264->multi_field_slots[h264->multi_pic_fw_idx].valid = false;
+		}
+		spin_unlock_irqrestore(&h264->multi_field_lock, flags);
+	}
+	amvdec_abort(sess);
+}
+
+static bool codec_h264_multi_field_claim(struct codec_h264 *h264, bool have_buffers)
+{
+	unsigned long flags;
+	bool claimed;
+
+	spin_lock_irqsave(&h264->multi_field_lock, flags);
+	claimed = have_buffers && h264->multi_field_phase == 2 &&
+		  h264->multi_decoded_fields == BIT(h264->multi_fields[0].bottom_field) &&
+		  h264->multi_done_fw_idx == h264->multi_pic_fw_idx &&
+		  h264->multi_done_fw_idx < ARRAY_SIZE(h264->multi_field_slots);
+	if (claimed) {
+		struct h264_field_surface *surface =
+			&h264->multi_field_slots[h264->multi_done_fw_idx];
+
+		h264->multi_field_phase = 4;
+		*surface = (struct h264_field_surface) {
+			.valid = true, .bottom = h264->multi_fields[0].bottom_field,
+			.decoded_fields = h264->multi_field_mate ? 3 : h264->multi_decoded_fields,
+			.structure = h264->multi_fields[0].bottom_field ? 1 : 0,
+			.frame_num = h264->multi_fields[0].frame_num,
+			.timestamp = h264->multi_pic_ts, .vb2_idx = h264->multi_pic_vb2_idx,
+			.top_poc = h264->multi_pic_top_poc,
+			.bottom_poc = h264->multi_pic_bottom_poc,
+			.poc = h264->multi_fields[0].bottom_field ?
+				h264->multi_pic_bottom_poc : h264->multi_pic_top_poc,
+			.sps = h264->multi_sps,
+			.reference = !!h264->multi_fields[0].nal_ref_idc,
+		};
+	} else if (h264->multi_field_phase != 4) {
+		h264->multi_decoded_fields = 0;
+		h264->multi_field_phase = 3;
+		if (h264->multi_pic_fw_idx < ARRAY_SIZE(h264->multi_field_slots))
+			h264->multi_field_slots[h264->multi_pic_fw_idx].valid = false;
+	}
+	spin_unlock_irqrestore(&h264->multi_field_lock, flags);
+	return claimed;
+}
+
+/* Match the frame HEADER inventory check before any FIFO/firmware write. */
+static int codec_h264_multi_frame_preflight(struct amvdec_session *sess)
+{
+	struct codec_h264 *h264 = sess->priv;
+	struct h264_slice_refs slice;
+	bool has_fields = false, checked = false;
+	u32 cursor = 0, count = 0, i;
+	int ret;
+
+	ret = h264_frame_refs_preflight(h264->multi_slice_data,
+					h264->multi_slice_size,
+					&h264->multi_sps,
+					&h264->multi_pps,
+					&h264->multi_request_picture);
+	if (ret)
+		return ret;
+
+	for (i = 0; i < ARRAY_SIZE(h264->multi_dpb); i++) {
+		const struct v4l2_h264_dpb_entry *e = &h264->multi_dpb[i];
+		int fw;
+
+		if (!(e->flags & V4L2_H264_DPB_ENTRY_FLAG_ACTIVE))
+			continue;
+		fw = codec_h264_multi_ref_fw_idx(sess, e);
+		if ((e->flags & V4L2_H264_DPB_ENTRY_FLAG_FIELD) ||
+		    (fw >= 0 && fw < H264_MULTI_MAX_FW_BUFS &&
+		     h264->multi_field_slots[fw].valid))
+			has_fields = true;
+	}
+	if (!has_fields)
+		return 0;
+
+	while (!(ret = h264_next_slice_refs(h264->multi_slice_data,
+		 h264->multi_slice_size, &cursor, &h264->multi_sps,
+		 &h264->multi_pps, &slice))) {
+		if (!h264_same_frame_picture(&slice, &h264->multi_request_picture))
+			return -EINVAL;
+		count++;
+		/* Intra slices do not consume the active DPB inventory. */
+		if (slice.slice_type % 5 == 2 || checked)
+			continue;
+		for (i = 0; i < ARRAY_SIZE(h264->multi_dpb); i++) {
+			const struct v4l2_h264_dpb_entry *e = &h264->multi_dpb[i];
+			int fw;
+
+			if (!(e->flags & V4L2_H264_DPB_ENTRY_FLAG_ACTIVE))
+				continue;
+			fw = codec_h264_multi_ref_fw_idx(sess, e);
+			if (fw < 0 && !(e->flags & V4L2_H264_DPB_ENTRY_FLAG_FIELD))
+				continue;
+			if (fw < 0 || fw >= H264_MULTI_MAX_FW_BUFS ||
+			    !h264_surface_view_valid(&h264->multi_field_slots[fw], e,
+					V4L2_H264_FRAME_REF, &h264->multi_sps)) {
+				dev_dbg(sess->core->dev_dec,
+					 "H264_FRAME_REF prefeed refused fw=%d fields=%u flags=%#x ts=%llu poc=%d/%d\n",
+					 fw, e->fields, e->flags, e->reference_ts,
+					 e->top_field_order_cnt, e->bottom_field_order_cnt);
+				return -EINVAL;
+			}
+		}
+		checked = true;
+	}
+	return ret == -ENOENT && count ? 0 : (ret == -ENOENT ? -EINVAL : ret);
+}
+
+static int codec_h264_multi_field_preflight(struct amvdec_session *sess)
+{
+	struct codec_h264 *h264 = sess->priv;
+	struct h264_ref refs[V4L2_H264_REF_LIST_LEN];
+	struct h264_slice_refs first;
+	u32 count, cursor = 0;
+	int ret;
+
+	h264->multi_field_picture = false;
+	h264->multi_field_mate = false;
+	h264->multi_field_phase = 0;
+	h264->multi_decoded_fields = 0;
+	if (!h264->multi_request_picture.field_pic)
+		return 0;
+	ret = h264_parse_single_field(h264->multi_slice_data, h264->multi_slice_size,
+		&h264->multi_sps, &h264->multi_pps, &h264->multi_request_picture,
+		&h264->multi_fields[0],
+		READ_ONCE(h264_multi_allow_mixed_mbaff_fields));
+	if (ret < 0) {
+		dev_err_ratelimited(sess->core->dev_dec,
+			"H264_FIELD_PREFLIGHT rejected err=%d poc_type=%u sps_flags=%#x pps_flags=%#x weighted_bipred=%u type=%u ref_idc=%u\n",
+			ret, h264->multi_sps.pic_order_cnt_type, h264->multi_sps.flags,
+			h264->multi_pps.flags, h264->multi_pps.weighted_bipred_idc,
+			h264->multi_request_picture.slice_type,
+			h264->multi_request_picture.nal_ref_idc);
+		return ret;
+	}
+	/* All slices belong to one field; coalescing is not supported. */
+	if (ret < 1 || !h264_multi_per_slice)
+		return -EOPNOTSUPP;
+	/* Only POC0 carries pic_order_cnt_lsb; POC1 uses the client POCs. */
+	if (h264->multi_sps.pic_order_cnt_type == 0 &&
+	    ((s64)(h264->multi_fields[0].bottom_field ?
+	     h264->multi_pic_bottom_poc : h264->multi_pic_top_poc) -
+	     h264->multi_fields[0].poc_lsb) %
+	    (1U << (h264->multi_sps.log2_max_pic_order_cnt_lsb_minus4 + 4)))
+		return -EINVAL;
+	/* Resolve actual completed reference views before firmware owns this job.
+	 * A refused mixed-picture request can leave later controls naming a
+	 * missing surface; HEADER-time discovery would abort the whole session.
+	 */
+	first = h264->multi_fields[0];
+	{
+		struct vb2_v4l2_buffer *dst = v4l2_m2m_next_dst_buf(sess->m2m_ctx);
+		u32 fw = H264_MULTI_MAX_FW_BUFS, idx;
+
+		if (!dst || !h264->multi_src_vbuf)
+			return -EINVAL;
+		idx = dst->vb2_buf.index;
+		/* QBUF may clear CAPTURE's timestamp; resolve a mate to its own
+		 * completed first field before vb2_find_buffer() searches it.
+		 * No canvas is allocated or programmed during this preflight.
+		 */
+		v4l2_m2m_buf_copy_metadata(h264->multi_src_vbuf, dst);
+		if (idx < ARRAY_SIZE(sess->vb2_idx_to_fw_idx)) {
+			u32 mapped = sess->vb2_idx_to_fw_idx[idx];
+
+			if (mapped < sess->num_fw_bufs && mapped < H264_MULTI_MAX_FW_BUFS &&
+			    sess->fw_idx_to_vb2_idx[mapped] == idx)
+				fw = mapped;
+		}
+		h264->multi_pic_fw_idx = fw;
+		h264->multi_field_mate = fw < H264_MULTI_MAX_FW_BUFS &&
+			h264_field_is_mate(&h264->multi_field_slots[fw], &h264->multi_fields[0],
+				h264->multi_src_vbuf->vb2_buf.timestamp, idx,
+				&h264->multi_sps, &h264->multi_pps);
+		/* Every slice can carry independent active counts and B lists. */
+		while (!(ret = h264_next_slice_refs_mode(h264->multi_slice_data,
+				h264->multi_slice_size, &cursor, &h264->multi_sps,
+				&h264->multi_pps, true, &h264->multi_fields[0]))) {
+			u32 type = h264->multi_fields[0].slice_type % 5;
+
+			if (type == 2)
+				continue;
+			ret = codec_h264_multi_field_refs(sess, refs, &count, 0, true);
+			if (!ret && type == 1)
+				ret = codec_h264_multi_field_refs(sess, refs, &count, 1, true);
+			if (ret)
+				break;
+		}
+		h264->multi_fields[0] = first;
+		if (ret != -ENOENT)
+			return ret;
+	}
+	h264->multi_field_picture = true;
+	return 0;
+}
+
+static int codec_h264_multi_next_slice(struct amvdec_session *sess)
+{
+	struct codec_h264 *h264 = sess->priv;
+	struct h264_slice_refs sr;
+	u32 bytes_per_unit = H264_COLOCATE_BYTES_PER_MB;
+	u32 first_mb, type, type_bit;
+	u64 units;
+	int ret;
+
+	if (!h264->multi_src_vbuf || !h264->multi_slice_data || !h264->lmem_vaddr)
+		return -EINVAL;
+	ret = h264_next_slice_refs_mode(h264->multi_slice_data, h264->multi_slice_size,
+				   &h264->multi_slice_cursor, &h264->multi_sps,
+				   &h264->multi_pps, h264->multi_field_picture, &sr);
+	if (ret)
+		return ret;
+	first_mb = codec_h264_multi_lmem_word(h264, 0xf0);
+	type = codec_h264_multi_lmem_word(h264, 0x82) % 5;
+	if (sr.first_mb != first_mb || sr.slice_type % 5 != type ||
+	    !h264_same_frame_picture(&sr, &h264->multi_request_picture))
+		return -EINVAL;
+	units = (u64)(h264->multi_sps.pic_width_in_mbs_minus1 + 1) *
+		(h264->multi_sps.pic_height_in_map_units_minus1 + 1);
+	if (!(h264->multi_sps.flags & V4L2_H264_SPS_FLAG_FRAME_MBS_ONLY) &&
+	    !sr.field_pic && !sr.mbaff)
+		units *= 2;
+	if (sr.first_mb >= units ||
+	    (!h264->multi_slice_count && sr.first_mb) ||
+	    (h264->multi_slice_count && sr.first_mb <= h264->multi_slice_refs.first_mb))
+		return -EINVAL;
+	if (sr.field_pic &&
+	    (!h264->multi_field_picture || READ_ONCE(h264->multi_field_phase) ||
+	     codec_h264_multi_lmem_word(h264, 0x80) != (sr.idr ? 5 : 1) ||
+	     codec_h264_multi_lmem_word(h264, 0x81) != sr.nal_ref_idc ||
+	     codec_h264_multi_lmem_word(h264, 0x7c) != (sr.bottom_field ? 2 : 1)))
+		return -EINVAL;
+	type_bit = BIT(type);
+	if ((h264->multi_slice_uniform || sr.slice_type >= 5) &&
+	    (h264->multi_slice_type_mask & ~type_bit))
+		return -EINVAL;
+	h264->multi_slice_uniform |= sr.slice_type >= 5;
+	h264->multi_slice_type_mask |= type_bit;
+	/* first_mb is not doubled; field/MBAFF MV units are 192 bytes. */
+	if (sr.field_pic || sr.mbaff)
+		bytes_per_unit *= 2;
+	if ((codec_h264_multi_lmem_word(h264, 0x8c) & 6) == 6)
+		bytes_per_unit >>= 2;
+	if ((u64)(sr.first_mb + 1) * bytes_per_unit > h264->colocate_buf_size)
+		return -EINVAL;
+	h264->multi_slice_mv_offset = sr.first_mb * bytes_per_unit;
+	h264->multi_slice_refs = sr;
+	h264->multi_slice_count++;
+	dev_dbg(sess->core->dev_dec, "H264_MULTI_SLICE n=%u first_mb=%u type=%u mv_offset=%u\n",
+		h264->multi_slice_count, sr.first_mb, type, h264->multi_slice_mv_offset);
+	return 0;
+}
+
+static int codec_h264_multi_config_decode_buf(struct amvdec_session *sess)
+{
+	struct codec_h264 *h264 = sess->priv;
+	struct amvdec_core *core = sess->core;
+	u32 fw_idx = h264->multi_pic_fw_idx;
+	u32 info_slots = h264_multi_full_canvas_info ? H264_MULTI_MAX_FW_BUFS :
+			 V4L2_H264_NUM_DPB_ENTRIES + 1;
+	u32 canvas, info0;
+	s32 top_poc = h264->multi_pic_top_poc;
+	s32 bottom_poc = h264->multi_pic_bottom_poc;
+	u32 colocate_wr;
+	u32 i;
+
+	if (fw_idx >= sess->num_fw_bufs) {
+		dev_err_ratelimited(core->dev_dec,
+			"H264_MULTI_DECBUF invalid fw_idx=%u fw_bufs=%u\n",
+			fw_idx, sess->num_fw_bufs);
+		return -EINVAL;
+	}
+
+	/* Before the mate is decoded, only the first field's POC is valid. */
+	if (h264->multi_field_picture &&
+	    !READ_ONCE(h264->multi_field_phase) && !h264->multi_field_mate) {
+		s32 first_poc = h264->multi_fields[0].bottom_field ? bottom_poc : top_poc;
+
+		top_poc = first_poc;
+		bottom_poc = first_poc;
+	}
+	/* A matched field mate restores frame_poc=min(top,bottom), vendor DPB. */
+	/* Picture order counts: frame, then top, then bottom. */
+	amvdec_write_dos(core, H264_CURRENT_POC_IDX_RESET, 0);
+	amvdec_write_dos(core, H264_CURRENT_POC,
+			 min(top_poc, bottom_poc));
+	amvdec_write_dos(core, H264_CURRENT_POC, top_poc);
+	amvdec_write_dos(core, H264_CURRENT_POC, bottom_poc);
+
+	/* Reconstruction and deblock canvases for the chosen CAPTURE buffer. */
+	amvdec_write_dos(core, CURR_CANVAS_CTRL, fw_idx << 24);
+	canvas = amvdec_read_dos(core, CURR_CANVAS_CTRL) & 0xffffff;
+	amvdec_write_dos(core, REC_CANVAS_ADDR, canvas);
+	amvdec_write_dos(core, DBKR_CANVAS_ADDR, canvas);
+	amvdec_write_dos(core, DBKW_CANVAS_ADDR, canvas);
+
+	/*
+	 * Buffer info table, written exactly as the vendor does it. Index 16
+	 * onwards carries one info0/top_poc/bottom_poc triple per frame slot:
+	 * 0xf480 is "progressive frame", bit 8 marks a bottom-first pair and
+	 * the low nibble marks the slot being decoded into. Indices 0 and 8
+	 * carry reference lists 0 and 1, four packed entries per word, eight
+	 * words each - written even when a list is empty.
+	 */
+	/*
+	 * Picture structure, as the vendor encodes it (vmh264.c:2100):
+	 * 0xf4c0 MBAFF frame, 0xf400 top field, 0xf440 bottom field,
+	 * 0xf480 progressive frame; retain this tag for legacy single-I fields.
+	 */
+	switch (codec_h264_multi_current_structure(h264)) {
+	case 0:
+		info0 = 0xf400;
+		break;
+	case 1:
+		info0 = 0xf440;
+		break;
+	case 3:
+		info0 = 0xf4c0;
+		break;
+	case 2:
+	default:
+		info0 = 0xf480;
+		break;
+	}
+	if (bottom_poc < top_poc)
+		info0 |= 0x100;
+
+	/*
+	 * This table is indexed by firmware canvas position, not DPB entry.
+	 * CAPTURE allocation/reordering can put a retained picture above slot
+	 * 16 even with at most 16 DPB entries. Cover the same 24 slots as
+	 * canvas mapping and the colocated MV allocation. The vendor writes
+	 * one triple per canvas position across mDPB.size (up to 27).
+	 * Leave every unused slot zero, including slots not mapped yet.
+	 * The load-time diagnostic switch retains the old 17-slot bound.
+	 */
+	amvdec_write_dos(core, H264_BUFFER_INFO_INDEX, 16);
+	for (i = 0; i < info_slots; i++) {
+		const struct v4l2_h264_dpb_entry *ref;
+		u32 r_info0 = 0;
+		s32 r_top = 0, r_bot = 0;
+
+		if (i == fw_idx) {
+			r_info0 = info0 | 0xf;
+			r_top = top_poc;
+			r_bot = bottom_poc;
+		} else if ((ref = codec_h264_multi_ref_in_slot(sess, i))) {
+			/*
+			 * A reference keeps the structure it was decoded with:
+			 * the vendor replays the per-buffer info0 it stored at
+			 * decode time (vmh264.c:2100-2107, 2139-2140), so an
+			 * MBAFF reference reads 0xf4c0, not "progressive frame".
+			 * MbaffFrameFlag is constant across a sequence of frame
+			 * pictures, so the current flag applies to every slot.
+			 */
+			const struct h264_field_surface *surface = &h264->multi_field_slots[i];
+
+			r_info0 = h264->multi_sps_mbaff ? 0xf4c0 : 0xf480;
+			r_top = ref->top_field_order_cnt;
+			r_bot = ref->bottom_field_order_cnt;
+			if (surface->valid && surface->timestamp == ref->reference_ts &&
+			    surface->vb2_idx == sess->fw_idx_to_vb2_idx[i]) {
+				r_info0 = h264_surface_info0(surface);
+				r_top = surface->top_poc;
+				r_bot = surface->bottom_poc;
+				if (surface->decoded_fields != V4L2_H264_FRAME_REF)
+					r_top = r_bot = surface->poc;
+			} else if (r_bot < r_top) {
+				r_info0 |= 0x100;
+			}
+			if (ref->flags & V4L2_H264_DPB_ENTRY_FLAG_LONG_TERM)
+				r_info0 |= (ref->fields & V4L2_H264_TOP_FIELD_REF ? 0x10 : 0) |
+					   (ref->fields & V4L2_H264_BOTTOM_FIELD_REF ? 0x20 : 0);
+		}
+		if (h264->multi_field_picture && r_info0)
+			dev_dbg(core->dev_dec, "H264_FIELD_SLOT fw=%u current=%u info0=%#x top=%d bottom=%d\n",
+				 i, i == fw_idx, r_info0, r_top, r_bot);
+		amvdec_write_dos(core, H264_BUFFER_INFO_DATA, r_info0);
+		amvdec_write_dos(core, H264_BUFFER_INFO_DATA, r_top);
+		amvdec_write_dos(core, H264_BUFFER_INFO_DATA, r_bot);
+	}
+
+	if (codec_h264_multi_write_ref_lists(sess))
+		return -EINVAL;
+
+	/*
+	 * Colocated MV store. One slot per CAPTURE frame keyed by canvas
+	 * index, so a later B picture can find the MVs of its L1[0].
+	 * Each slice writes/reads at its macroblock (or MBAFF pair) offset.
+	 * Slot spacing remains the existing per-CAPTURE allocation stride.
+	 */
+	if (!h264->colocate_vaddr || !h264->colocate_buf_size) {
+		dev_err_ratelimited(core->dev_dec, "H264_MULTI_DECBUF no colocated MV store\n");
+		return -EINVAL;
+	}
+	if (h264->multi_field_picture) {
+		for (i = 0; i < 1000; i++) {
+			if (!(amvdec_read_dos(core, H264_CO_MB_RW_CTL) & BIT(11)))
+				break;
+			udelay(1);
+		}
+		if (i == 1000) {
+			dev_err_ratelimited(core->dev_dec, "H264_FIELD CO_MB_RW_CTL busy phase=%u\n",
+				READ_ONCE(h264->multi_field_phase));
+			return -ETIMEDOUT; /* HEADER caller aborts both queues. */
+		}
+	} else {
+		while (amvdec_read_dos(core, H264_CO_MB_RW_CTL) & BIT(11))
+			cpu_relax();
+	}
+	colocate_wr = h264->colocate_paddr + h264->colocate_buf_size * fw_idx;
+	if (h264_multi_per_slice)
+		colocate_wr += h264->multi_slice_mv_offset;
+	amvdec_write_dos(core, H264_CO_MB_WR_ADDR, colocate_wr);
+	if (h264->multi_l1_valid) {
+		/*
+		 * Direct mode reads the colocated MVs of L1[0]. Bits 31:30
+		 * carry that picture's coding structure (2 = frame) and bit
+		 * 29 selects which field of it to use; for a frame picture
+		 * the vendor picks by POC distance.
+		 */
+		u32 rd = h264->colocate_paddr +
+			 h264->colocate_buf_size * h264->multi_l1_fw_idx;
+		s32 cur = min(h264->multi_pic_top_poc,
+			      h264->multi_pic_bottom_poc);
+		u32 ref_type = abs(cur - h264->multi_l1_top) <
+			       abs(cur - h264->multi_l1_bottom) ? 0 : 1;
+
+		u8 cur_structure = codec_h264_multi_current_structure(h264);
+		bool direct_8x8 = (codec_h264_multi_lmem_word(h264, 0x8c) & 6) == 6;
+		u32 offset = 0, value;
+
+		/* Field bit29 selects L1[0]'s parity, not the current field's. */
+		if (h264->multi_field_picture)
+			ref_type = h264->multi_l1_view == V4L2_H264_BOTTOM_FIELD_REF;
+		if (h264_multi_per_slice)
+			offset = h264_colocate_read_offset(h264->multi_slice_refs.first_mb,
+				h264->multi_sps.pic_width_in_mbs_minus1 + 1, cur_structure,
+				h264->multi_l1_structure, direct_8x8);
+		if (offset >= h264->colocate_buf_size)
+			return -EINVAL;
+		rd += offset;
+		value = (rd >> 3) | ((u32)h264->multi_l1_structure << 30) |
+			(ref_type << 29);
+		amvdec_write_dos(core, H264_CO_MB_RD_ADDR, value);
+		if (h264->multi_field_picture || h264->multi_l1_structure < 2)
+			dev_dbg(core->dev_dec,
+				 "H264_FIELD_MV cur=%u l1_fw=%u structure=%u view=%u bit29=%u direct8=%u offset=%#x addr=%#x value=%#x\n",
+				 cur_structure, h264->multi_l1_fw_idx, h264->multi_l1_structure,
+				 h264->multi_l1_view, ref_type, direct_8x8, offset, rd, value);
+	}
+
+	dev_dbg(core->dev_dec,
+		 "H264_MULTI_DECBUF fw_idx=%u vb2_idx=%u canvas=%#x poc=(%d,%d) info0=%#x colo_wr=%#x\n",
+		 fw_idx, h264->multi_pic_vb2_idx, canvas,
+		 top_poc, bottom_poc, info0, colocate_wr);
+
+	return 0;
+}
+
+/* Inverse of codec_h264_multi_lmem_word()'s 4-word swizzle. */
+static void codec_h264_multi_lmem_set(struct codec_h264 *h264, u32 i, u16 v)
+{
+	u16 *lmem = h264->lmem_vaddr;
+
+	if (!lmem)
+		return;
+	lmem[(i & ~3) + 3 - (i & 3)] = v;
+}
+
+/*
+ * Write the sequence-level RPM fields the firmware needs but has not got.
+ *
+ * Measured at H264_SLICE_HEAD_DONE on g12a_h264_multi.bin: the firmware parses
+ * the slice header correctly (NAL type, slice type, QP, first_mb) and, with an
+ * in-band PPS, the PPS fields too - but the SPS-derived geometry is never
+ * populated: MB_X_NUM reads 0xffff, MB_HEIGHT and TOTAL_MB_HEIGHT read 0. With
+ * no picture dimensions it then decodes zero macroblocks. Supply them from the
+ * host-parsed SPS, in the window after the firmware's slice-header parse has
+ * landed and before it is told to decode.
+ */
+static void codec_h264_multi_inject_sps_rpm(struct amvdec_session *sess)
+{
+	struct codec_h264 *h264 = sess->priv;
+	const struct v4l2_ctrl_h264_sps *sps = &h264->multi_sps;
+	u32 mb_w = h264->mb_width, mb_h = h264->mb_height;
+
+	if (!h264->lmem_vaddr || !h264->multi_pic_valid)
+		return;
+
+	codec_h264_multi_lmem_set(h264, H264_RPM_LOG2_MAX_FRAME_NUM,
+				  sps->log2_max_frame_num_minus4 + 4);
+	codec_h264_multi_lmem_set(h264, H264_RPM_FRAME_MBS_ONLY_FLAG,
+		!!(sps->flags & V4L2_H264_SPS_FLAG_FRAME_MBS_ONLY));
+	codec_h264_multi_lmem_set(h264, H264_RPM_PIC_ORDER_CNT_TYPE,
+				  sps->pic_order_cnt_type);
+	codec_h264_multi_lmem_set(h264, H264_RPM_LOG2_MAX_POC_LSB,
+				  sps->log2_max_pic_order_cnt_lsb_minus4 + 4);
+	codec_h264_multi_lmem_set(h264, H264_RPM_TOTAL_MB_HEIGHT, mb_h);
+	codec_h264_multi_lmem_set(h264, H264_RPM_MB_X_NUM, mb_w);
+	codec_h264_multi_lmem_set(h264, H264_RPM_MB_HEIGHT, mb_h);
+	codec_h264_multi_lmem_set(h264, H264_RPM_PREV_MB_WIDTH, mb_w);
+	codec_h264_multi_lmem_set(h264, H264_RPM_PREV_FRAME_SIZE_IN_MB,
+				  mb_w * mb_h);
+
+	dev_dbg(sess->core->dev_dec,
+		 "H264_RPM_INJECT mb=%ux%u log2_frame_num=%u mbs_only=%u poc_type=%u\n",
+		 mb_w, mb_h, sps->log2_max_frame_num_minus4 + 4,
+		 !!(sps->flags & V4L2_H264_SPS_FLAG_FRAME_MBS_ONLY),
+		 sps->pic_order_cnt_type);
+}
+
+/*
+ * CPU-written SPS/PPS parameter records.
+ *
+ * Per Zhentao Guo (Amlogic): in stateless mode the host writes these into DDR
+ * and the AMRISC does not parse SPS/PPS at all; the layout is the same on G12
+ * as on S4. Field packing and register side effects follow config_sps_params()
+ * and config_pps_params() from the S4 stateless driver
+ * (20260914-b4-s4-vdec-upstream-v9, drivers/media/platform/amlogic/vdec).
+ *
+ * MEM_SPS_BASE/MEM_PPS_BASE match the offsets this program had already
+ * inferred from a workspace canary sweep (H28), which is a useful cross-check.
+ */
+#define PARAM_BASE_VAL				0x414d
+#define GET_SPS_PROFILE_IDC(x)			(((x) & 0xff) << 8)
+#define GET_SPS_LEVEL_IDC(x)			((x) & 0xff)
+#define GET_SPS_SEQ_PARAM_SET_ID(x)		(((x) & 0x1f) << 8)
+#define GET_SPS_CHROMA_FORMAT_IDC(x)		((x) << 8)
+#define GET_SPS_NUM_REF_FRAMES(x)		((x) & 0xff)
+#define GET_SPS_GAPS_ALLOWED_FLAG(x)		((x) << 8)
+#define GET_SPS_LOG2_MAX_FRAME_NUM(x)		((x) + 4)
+#define GET_SPS_PIC_ORDER_CNT_LSB(x)		((x) + 4)
+#define GET_SPS_PIC_ORDER_TYPE(x)		(x)
+#define GET_SPS_OFF_NONREF_HIGH(x)		(((x) & 0xffff0000) >> 16)
+#define GET_SPS_OFF_NONREF_LOW(x)		((x) & 0xffff)
+#define GET_SPS_OFF_TOPBOT_HIGH(x)		(((x) & 0xffff0000) >> 16)
+#define GET_SPS_OFF_TOPBOT_LOW(x)		((x) & 0xffff)
+#define GET_SPS_PIC_WIDTH_IN_MBS(x)		((x) + 1)
+#define GET_SPS_PIC_HEIGHT_IN_MBS(x)		((x) + 1)
+#define GET_SPS_DIRECT_8X8_FLAGS(x)		(((x) & 0x1) << 2)
+#define GET_SPS_MB_ADAPTIVE_FRAME_FIELD_FLAGS(x) (((x) & 0x1) << 1)
+#define GET_SPS_FRAME_MBS_ONLY_FLAGS(x)		((x) & 0x1)
+
+#define GET_PPS_PIC_PARAM_SET_ID(x)		((x) & 0xff)
+#define GET_PPS_SEQ_PARAM_SET_ID(x)		(((x) & 0x1f) << 8)
+#define GET_PPS_ENTROPY_CODING_MODE_FLAG(x)	(((x) & 0x1) << 13)
+#define GET_PPS_PIC_ORDER_PRESENT_FLAG(x)	(((x) & 0x1) << 14)
+#define GET_PPS_NUM_IDX_REF_L0_MINUS1(x)	((x) & 0x1f)
+#define GET_PPS_NUM_IDX_REF_L1_MINUS1(x)	(((x) & 0x1f) << 5)
+#define GET_PPS_WEIGHTED_PRED_FLAG(x)		(((x) & 0x1) << 10)
+#define GET_PPS_WEIGHTED_BIPRED_IDC(x)		(((x) & 0x3) << 11)
+#define GET_PPS_INIT_QS_MINUS26(x)		(((x) & 0xff) << 8)
+#define GET_PPS_INIT_QP_MINUS26(x)		((x) & 0xff)
+#define GET_PPS_CHROMA_QP_INDEX_OFFSET(x)	((x) & 0xff)
+#define GET_PPS_DEBLOCK_FILTER_CTRL_PRESENT_FLAG(x) (((x) & 0x1) << 8)
+#define GET_PPS_CONSTRAIN_INTRA_PRED_FLAG(x)	(((x) & 0x1) << 9)
+#define GET_PPS_REDUNDANT_PIC_CNT_PRESENT_FLAG(x) (((x) & 0x1) << 10)
+#define GET_PPS_SCALING_MATRIX_PRESENT_FLAG(x)	(((x) & 0x1) << 1)
+#define GET_PPS_TRANSFORM_8X8_FLAG(x)		((x) & 0x1)
+
+static u16 h264_flag(u32 flags, u32 bit)
+{
+	return !!(flags & bit);
+}
+
+/* The firmware reads these records with a 4-word byte-swizzle. */
+static void codec_h264_store_param_record(u16 *base, const u16 *src)
+{
+	int i, ii;
+
+	for (i = 0; i < 0x100; i += 4)
+		for (ii = 0; ii < 4; ii++)
+			base[i + 3 - ii] = src[i + ii];
+}
+
+static void codec_h264_dump_multi_lmem(struct amvdec_session *sess, u32 status)
+{
+	struct codec_h264 *h264 = sess->priv;
+	u32 frame_mbs, mb_height, mb_width = 0;
+	u32 i;
+
+	if (!h264->lmem_vaddr) {
+		dev_err_ratelimited(sess->core->dev_dec,
+			"H264_MULTI_LMEM unavailable status=%#04x\n", status);
+		return;
+	}
+
+	for (i = 0; i < LMEM_DUMP_WORDS; i += 8)
+		dev_dbg(sess->core->dev_dec,
+			 "H264_MULTI_LMEM off=%03x %04x %04x %04x %04x %04x %04x %04x %04x\n",
+			 i, codec_h264_multi_lmem_word(h264, i),
+			 codec_h264_multi_lmem_word(h264, i + 1),
+			 codec_h264_multi_lmem_word(h264, i + 2),
+			 codec_h264_multi_lmem_word(h264, i + 3),
+			 codec_h264_multi_lmem_word(h264, i + 4),
+			 codec_h264_multi_lmem_word(h264, i + 5),
+			 codec_h264_multi_lmem_word(h264, i + 6),
+			 codec_h264_multi_lmem_word(h264, i + 7));
+
+	frame_mbs = codec_h264_multi_lmem_word(h264,
+					       H264_MULTI_LMEM_FRAME_MBS);
+	mb_height = codec_h264_multi_lmem_word(h264,
+					       H264_MULTI_LMEM_TOTAL_MB_HEIGHT);
+	if (mb_height && !(frame_mbs % mb_height))
+		mb_width = frame_mbs / mb_height;
+
+	dev_dbg(sess->core->dev_dec,
+		 "H264_MULTI_LMEM_FIELDS status=%#04x mb_width=%u total_mb_height=%u mb_height=%u frame_mbs=%u level_idc=%u max_refs=%u slice_type=%u first_mb=%u prev_mb_width=%u\n",
+		 status, mb_width, mb_height,
+		 codec_h264_multi_lmem_word(h264,
+					    H264_MULTI_LMEM_MB_HEIGHT),
+		 frame_mbs,
+		 codec_h264_multi_lmem_word(h264,
+					    H264_MULTI_LMEM_LEVEL_IDC),
+		 codec_h264_multi_lmem_word(h264,
+					    H264_MULTI_LMEM_MAX_REFS),
+		 codec_h264_multi_lmem_word(h264,
+					    H264_MULTI_LMEM_SLICE_TYPE),
+		 codec_h264_multi_lmem_word(h264,
+					    H264_MULTI_LMEM_FIRST_MB),
+		 codec_h264_multi_lmem_word(h264,
+					    H264_MULTI_LMEM_PREV_MB_WIDTH));
+}
+
+static u32 codec_h264_blob_u32(const u8 *p)
+{
+	u32 v;
+
+	memcpy(&v, p, sizeof(v));
+	return le32_to_cpu(v);
+}
+
+static bool codec_h264_workspace_bounds(struct amvdec_session *sess,
+					u32 off, u32 len, const char *name)
+{
+	struct codec_h264 *h264 = sess->priv;
+	u32 workspace_size = h264->workspace_size ?: SIZE_WORKSPACE;
+
+	if (off > workspace_size || len > workspace_size - off) {
+		dev_err_ratelimited(sess->core->dev_dec,
+			"H264_H27 %s outside workspace: off=%#x len=%#x workspace=%#x\n",
+			name, off, len, workspace_size);
+		return false;
+	}
+
+	return true;
+}
+
+static void codec_h264_dump_param_slot(struct amvdec_session *sess,
+				       const char *tag, const char *name,
+				       u32 off, u32 len)
+{
+	struct codec_h264 *h264 = sess->priv;
+	const u16 *words = h264->workspace_vaddr + off;
+	dma_addr_t paddr = h264->workspace_paddr + off;
+	u32 word_count = len / sizeof(u16);
+	unsigned int i;
+
+	if (!codec_h264_workspace_bounds(sess, off, len, name))
+		return;
+
+	dev_dbg(sess->core->dev_dec,
+		 "H264_WS tag=%s rec=%s off=%06x paddr=%pad words=%u\n",
+		 tag, name, off, &paddr, word_count);
+	for (i = 0; i < word_count; i += 8)
+		dev_dbg(sess->core->dev_dec,
+			 "H264_WS tag=%s rec=%s off=%03x %04x %04x %04x %04x %04x %04x %04x %04x\n",
+			 tag, name, i, words[i], words[i + 1],
+			 words[i + 2], words[i + 3], words[i + 4],
+			 words[i + 5], words[i + 6], words[i + 7]);
+}
+
+static void codec_h264_dump_workspace(struct amvdec_session *sess,
+				      const char *tag)
+{
+	if (!READ_ONCE(h264_workspace_dump))
+		return;
+
+	codec_h264_dump_param_slot(sess, tag, "sps0", H264_WS_SPS_OFFSET,
+				   H264_WS_SPS_STRIDE);
+	codec_h264_dump_param_slot(sess, tag, "pps0", H264_WS_PPS_OFFSET,
+				   H264_WS_PPS_STRIDE);
+}
+
+static void codec_h264_canary_workspace(struct amvdec_session *sess)
+{
+	struct codec_h264 *h264 = sess->priv;
+	u16 *sps = h264->workspace_vaddr + H264_WS_SPS_OFFSET;
+	u16 *pps = h264->workspace_vaddr + H264_WS_PPS_OFFSET;
+	unsigned int i;
+
+	if (!READ_ONCE(h264_workspace_canary))
+		return;
+
+	if (!codec_h264_workspace_bounds(sess, H264_WS_SPS_OFFSET,
+					 H264_WS_SPS_STRIDE, "sps0") ||
+	    !codec_h264_workspace_bounds(sess, H264_WS_PPS_OFFSET,
+					 H264_WS_PPS_STRIDE, "pps0"))
+		return;
+
+	for (i = 0; i < H264_WS_SPS_STRIDE / sizeof(u16); i++)
+		sps[i] = 0xa000 | (i & 0x0fff);
+	for (i = 0; i < H264_WS_PPS_STRIDE / sizeof(u16); i++)
+		pps[i] = 0xb000 | (i & 0x0fff);
+
+	dev_dbg(sess->core->dev_dec,
+		 "H264_WS_CANARY sps_off=%#x sps_words=%zu pps_off=%#x pps_words=%zu\n",
+		 H264_WS_SPS_OFFSET, H264_WS_SPS_STRIDE / sizeof(u16),
+		 H264_WS_PPS_OFFSET, H264_WS_PPS_STRIDE / sizeof(u16));
+}
+
+static int codec_h264_inject_params(struct amvdec_session *sess)
+{
+	struct codec_h264 *h264 = sess->priv;
+	const struct firmware *fw;
+	const char *path = h264_inject_path;
+	u8 *sps_dst = h264->workspace_vaddr + H264_WS_SPS_OFFSET;
+	u8 *pps_dst = h264->workspace_vaddr + H264_WS_PPS_OFFSET;
+	u32 magic, version, sps_id, pps_id, sps_len, pps_len;
+	u32 expected_size;
+	int ret;
+
+	if (!path || !path[0])
+		return 0;
+	if (h264->multi_blob)
+		return 0;
+
+	if (!codec_h264_workspace_bounds(sess, H264_WS_SPS_OFFSET,
+					 H264_PARAM_RECORD_SIZE, "sps0") ||
+	    !codec_h264_workspace_bounds(sess, H264_WS_PPS_OFFSET,
+					 H264_PARAM_RECORD_SIZE, "pps0"))
+		return -EINVAL;
+
+	ret = request_firmware(&fw, path, sess->core->dev_dec);
+	if (ret) {
+		dev_err_ratelimited(sess->core->dev_dec,
+			"H264_H27 failed to load parameter blob %s: %d\n",
+			path, ret);
+		return ret;
+	}
+
+	magic = codec_h264_blob_u32(fw->data);
+	expected_size = magic == H264_REPLAY_MAGIC ?
+		       H264_REPLAY_BLOB_SIZE : H264_PARAM_BLOB_SIZE;
+	if (fw->size != expected_size) {
+		dev_err_ratelimited(sess->core->dev_dec,
+			"H264_H27 bad parameter blob size %zu expected %u\n",
+			fw->size, expected_size);
+		ret = -EINVAL;
+		goto out;
+	}
+
+	version = codec_h264_blob_u32(fw->data + 4);
+	sps_id = codec_h264_blob_u32(fw->data + 8);
+	pps_id = codec_h264_blob_u32(fw->data + 12);
+	sps_len = codec_h264_blob_u32(fw->data + 16);
+	pps_len = codec_h264_blob_u32(fw->data + 20);
+	if (version != H264_PARAM_VERSION ||
+	    sps_id != 0 || pps_id != 0 ||
+	    !((magic == H264_PARAM_MAGIC &&
+	       sps_len == H264_PARAM_RECORD_SIZE &&
+	       pps_len == H264_PARAM_RECORD_SIZE) ||
+	      (magic == H264_REPLAY_MAGIC &&
+	       sps_len == H264_WS_SPS_STRIDE &&
+	       pps_len == H264_WS_PPS_STRIDE))) {
+		dev_err_ratelimited(sess->core->dev_dec,
+			"H264_H27 bad parameter blob header magic=%08x version=%u sps=%u pps=%u sizes=%u/%u\n",
+			magic, version, sps_id, pps_id, sps_len, pps_len);
+		ret = -EINVAL;
+		goto out;
+	}
+
+	memset(sps_dst, 0, H264_WS_SPS_STRIDE);
+	memset(pps_dst, 0, H264_WS_PPS_STRIDE);
+	memcpy(sps_dst, fw->data + H264_PARAM_BLOB_HEADER,
+	       sps_len);
+	memcpy(pps_dst, fw->data + H264_PARAM_BLOB_HEADER +
+	       sps_len, pps_len);
+	dev_dbg(sess->core->dev_dec,
+		 "H264_H27 injected SPS/PPS path=%s magic=%08x sps_off=%#x pps_off=%#x bytes=%u/%u\n",
+		 path, magic, H264_WS_SPS_OFFSET, H264_WS_PPS_OFFSET,
+		 sps_len, pps_len);
+
+out:
+	release_firmware(fw);
+	return ret;
+}
+
+static void codec_h264_write_lmem_canary(struct amvdec_session *sess)
+{
+	struct codec_h264 *h264 = sess->priv;
+	u16 *lmem = h264->lmem_vaddr;
+	unsigned int i;
+
+	if (!READ_ONCE(h264_lmem_canary) || !lmem)
+		return;
+
+	memset(lmem, 0, SIZE_LMEM);
+	for (i = H264_LMEM_CANARY_FIRST; i < H264_LMEM_CANARY_LAST; i++)
+		lmem[i] = 0x5a00 | (i & 0xff);
+
+	dev_dbg(sess->core->dev_dec,
+		 "H264_LMEM_CANARY first=%#x last=%#x paddr=%pad\n",
+		 H264_LMEM_CANARY_FIRST, H264_LMEM_CANARY_LAST - 1,
+		 &h264->lmem_paddr);
+}
+
+static int codec_h264_multi_host_config(struct amvdec_session *sess);
+
+/*
+ * Host-parsed picture parameters for the multi blob.
+ *
+ * Per Zhentao Guo (Amlogic), the host parses SPS/PPS and decides which frame is
+ * displayed or referenced; the firmware parses only part of the slice header.
+ * esparser_queue() already holds the request's controls when it feeds an access
+ * unit, so stash what the per-picture programming needs from there.
+ */
+void codec_h264_multi_set_params(struct amvdec_session *sess,
+				 const struct v4l2_ctrl_h264_sps *sps,
+				 const struct v4l2_ctrl_h264_pps *pps,
+				 const struct v4l2_ctrl_h264_decode_params *dec)
+{
+	struct codec_h264 *h264 = sess->priv;
+	struct amvdec_core *core = sess->core;
+	u16 *rec, data[0x100];
+	u32 offset, cfg, frame_size, max_refs, max_list, pic_h_mbs;
+	u32 req_width_mbs, req_height_mbs, fmt_width_mbs, fmt_height_mbs;
+
+	if (!h264 || !h264->multi_blob || !h264->workspace_vaddr)
+		return;
+
+	h264->multi_pic_top_poc = dec->top_field_order_cnt;
+	h264->multi_pic_bottom_poc = dec->bottom_field_order_cnt;
+	h264->multi_sps_max_refs = sps->max_num_ref_frames;
+	h264->multi_pic_is_b = !!(dec->flags & V4L2_H264_DECODE_PARAM_FLAG_BFRAME);
+	h264->multi_sps = *sps;
+	h264->multi_pps = *pps;
+	memset(&h264->multi_request_picture, 0, sizeof(h264->multi_request_picture));
+	h264->multi_request_picture.frame_num = dec->frame_num;
+	h264->multi_request_picture.pps_id = pps->pic_parameter_set_id;
+	h264->multi_request_picture.idr = !!(dec->flags & V4L2_H264_DECODE_PARAM_FLAG_IDR_PIC);
+	h264->multi_request_picture.idr_pic_id = dec->idr_pic_id;
+	h264->multi_request_picture.nal_ref_idc = dec->nal_ref_idc;
+	h264->multi_request_picture.field_pic =
+		!!(dec->flags & V4L2_H264_DECODE_PARAM_FLAG_FIELD_PIC);
+	h264->multi_request_picture.bottom_field =
+		!!(dec->flags & V4L2_H264_DECODE_PARAM_FLAG_BOTTOM_FIELD);
+	if (sps->pic_order_cnt_type == 0) {
+		h264->multi_request_picture.poc_lsb = dec->pic_order_cnt_lsb;
+		if (!h264->multi_request_picture.field_pic &&
+		    (pps->flags & V4L2_H264_PPS_FLAG_BOTTOM_FIELD_PIC_ORDER_IN_FRAME_PRESENT))
+			h264->multi_request_picture.delta_poc_bottom =
+				dec->delta_pic_order_cnt_bottom;
+	} else if (sps->pic_order_cnt_type == 1 &&
+		   !(sps->flags & V4L2_H264_SPS_FLAG_DELTA_PIC_ORDER_ALWAYS_ZERO)) {
+		h264->multi_request_picture.delta_poc[0] = dec->delta_pic_order_cnt0;
+		if (!h264->multi_request_picture.field_pic &&
+		    (pps->flags & V4L2_H264_PPS_FLAG_BOTTOM_FIELD_PIC_ORDER_IN_FRAME_PRESENT))
+			h264->multi_request_picture.delta_poc[1] = dec->delta_pic_order_cnt1;
+	}
+	memcpy(h264->multi_dpb, dec->dpb, sizeof(h264->multi_dpb));
+	h264->multi_nal_ref_idc = dec->nal_ref_idc;
+	h264->multi_pic_valid = true;
+	h264->multi_params_error = 0;
+
+	/* ---- SPS record ---- */
+	memset(data, 0, sizeof(data));
+	offset = 0;
+	data[offset] = PARAM_BASE_VAL;
+	offset += 2;
+	data[offset++] = GET_SPS_PROFILE_IDC(sps->profile_idc);
+	data[offset++] = GET_SPS_SEQ_PARAM_SET_ID(sps->seq_parameter_set_id) |
+			 GET_SPS_LEVEL_IDC(sps->level_idc);
+	if (sps->profile_idc >= 100) {
+		data[offset++] = GET_SPS_CHROMA_FORMAT_IDC(sps->chroma_format_idc);
+		data[offset++] = (sps->chroma_format_idc ^ 1) << 1;
+	}
+	data[offset++] = GET_SPS_LOG2_MAX_FRAME_NUM(sps->log2_max_frame_num_minus4);
+	data[offset++] = GET_SPS_PIC_ORDER_TYPE(sps->pic_order_cnt_type);
+	if (sps->pic_order_cnt_type == 0) {
+		data[offset++] =
+		  GET_SPS_PIC_ORDER_CNT_LSB(sps->log2_max_pic_order_cnt_lsb_minus4);
+	} else if (sps->pic_order_cnt_type == 1) {
+		data[offset++] = h264_flag(sps->flags,
+			V4L2_H264_SPS_FLAG_DELTA_PIC_ORDER_ALWAYS_ZERO);
+		data[offset++] = GET_SPS_OFF_NONREF_LOW(sps->offset_for_non_ref_pic);
+		data[offset++] = GET_SPS_OFF_NONREF_HIGH(sps->offset_for_non_ref_pic);
+		data[offset++] =
+		  GET_SPS_OFF_TOPBOT_LOW(sps->offset_for_top_to_bottom_field);
+		data[offset++] =
+		  GET_SPS_OFF_TOPBOT_HIGH(sps->offset_for_top_to_bottom_field);
+		data[offset++] = sps->num_ref_frames_in_pic_order_cnt_cycle;
+	}
+	data[offset++] = GET_SPS_NUM_REF_FRAMES(sps->max_num_ref_frames) |
+			 GET_SPS_GAPS_ALLOWED_FLAG(h264_flag(sps->flags,
+			   V4L2_H264_SPS_FLAG_GAPS_IN_FRAME_NUM_VALUE_ALLOWED));
+	data[offset++] = GET_SPS_PIC_WIDTH_IN_MBS(sps->pic_width_in_mbs_minus1);
+	data[offset++] =
+	  GET_SPS_PIC_HEIGHT_IN_MBS(sps->pic_height_in_map_units_minus1);
+	data[offset++] = GET_SPS_DIRECT_8X8_FLAGS(h264_flag(sps->flags,
+				V4L2_H264_SPS_FLAG_DIRECT_8X8_INFERENCE)) |
+			 GET_SPS_MB_ADAPTIVE_FRAME_FIELD_FLAGS(h264_flag(sps->flags,
+				V4L2_H264_SPS_FLAG_MB_ADAPTIVE_FRAME_FIELD)) |
+			 GET_SPS_FRAME_MBS_ONLY_FLAGS(h264_flag(sps->flags,
+				V4L2_H264_SPS_FLAG_FRAME_MBS_ONLY));
+
+	/*
+	 * The firmware addresses its workspace from AV_SCRATCH_8, which is
+	 * the CMA base plus DCAC_READ_MARGIN. Both the S4 driver and the
+	 * vendor G12 driver place the records relative to that margined base
+	 * (S4 folds the margin into workspace_vaddr itself). Writing them at
+	 * the un-margined base put every record 64 KiB below where the
+	 * firmware looked, which is exactly why its sequence fields read as
+	 * uninitialised.
+	 */
+	rec = h264->workspace_vaddr + DCAC_READ_MARGIN + H264_WS_SPS_OFFSET +
+	      sps->seq_parameter_set_id * H264_WS_SPS_STRIDE;
+	if (!h264->multi_blob)
+		codec_h264_store_param_record(rec, data);
+
+	/*
+	 * With frame_mbs_only_flag = 0 the SPS counts map units, which are
+	 * field height: FrameHeightInMbs is twice PicHeightInMapUnits (7-18).
+	 * Using it directly would size an MBAFF frame at half its height.
+	 */
+	pic_h_mbs = sps->pic_height_in_map_units_minus1 + 1;
+	if (!(sps->flags & V4L2_H264_SPS_FLAG_FRAME_MBS_ONLY))
+		pic_h_mbs *= 2;
+	req_width_mbs = sps->pic_width_in_mbs_minus1 + 1;
+	req_height_mbs = pic_h_mbs;
+	fmt_width_mbs = DIV_ROUND_UP(sess->width, 16);
+	fmt_height_mbs = DIV_ROUND_UP(sess->height, 16);
+	if (!fmt_width_mbs || !fmt_height_mbs ||
+	    req_width_mbs > fmt_width_mbs || req_height_mbs > fmt_height_mbs ||
+	    (h264->multi_geometry_valid &&
+	     (req_width_mbs != h264->multi_geometry_width_mbs ||
+	      req_height_mbs != h264->multi_geometry_height_mbs))) {
+		dev_warn_ratelimited(core->dev_dec,
+			"H264_MULTI rejected SPS geometry %ux%u MBs for negotiated %ux%u MBs (active %ux%u MBs)\n",
+			req_width_mbs, req_height_mbs,
+			fmt_width_mbs, fmt_height_mbs,
+			h264->multi_geometry_valid ? h264->multi_geometry_width_mbs : 0,
+			h264->multi_geometry_valid ? h264->multi_geometry_height_mbs : 0);
+		h264->multi_pic_valid = false;
+		h264->multi_params_error = -EINVAL;
+		return;
+	}
+	h264->multi_geometry_valid = true;
+	h264->multi_geometry_width_mbs = req_width_mbs;
+	h264->multi_geometry_height_mbs = req_height_mbs;
+	frame_size = (sps->pic_width_in_mbs_minus1 + 1) * pic_h_mbs;
+	cfg = (h264_flag(sps->flags, V4L2_H264_SPS_FLAG_FRAME_MBS_ONLY) << 31) |
+	      (sps->max_num_ref_frames << 24) | (frame_size << 8) |
+	      (sps->pic_width_in_mbs_minus1 + 1);
+	/*
+	 * Keep these: the per-picture VLD reset in the feed path runs after
+	 * this point, so they are re-applied there rather than relied on here.
+	 */
+	h264->multi_seq_cfg = cfg;
+	h264->multi_seq_cfg2 = (h264_flag(sps->flags,
+				V4L2_H264_SPS_FLAG_DIRECT_8X8_INFERENCE) << 15) |
+			       sps->chroma_format_idc;
+	h264->multi_seq_cfgb = (sps->max_num_ref_frames << 8) | sps->level_idc;
+	h264->multi_nal_search_or = ((sps->level_idc & 0xff) << 7) | BIT(2);
+
+	h264->multi_sps_mbaff = !(sps->flags & V4L2_H264_SPS_FLAG_FRAME_MBS_ONLY) &&
+			    !!(sps->flags & V4L2_H264_SPS_FLAG_MB_ADAPTIVE_FRAME_FIELD);
