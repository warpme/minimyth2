diff --git a/mythtv/external/FFmpeg/tests/checkasm/mpeg4videodsp.c b/mythtv/external/FFmpeg/tests/checkasm/mpeg4videodsp.c
new file mode 100644
index 00000000000..7c7e82c4b0d
--- /dev/null
+++ b/mythtv/external/FFmpeg/tests/checkasm/mpeg4videodsp.c
@@ -0,0 +1,156 @@
+/*
+ * This file is part of FFmpeg.
+ *
+ * FFmpeg is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 2 of the License, or
