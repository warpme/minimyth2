
# Device config
# board=s905w2.tv98
board=s905w2.tanix_w2

# Chainloading mainline bootloader (e.g. for network boot)
#
# - disable in boot.config with: chainload=no
# - chainload_method, uboot_uimg, uboot_img, uboot_addr, uboot_tmp_addr can be
#   changed in boot.config
# - if the image is missing, unreadable or the jump returns, we just continue
#   and boot Linux directly. To recover from a broken u-boot image remove or
#   rename it, or set chainload=no
#

# chainload=no
# chainload_method=bootm


# Making boot from SD card permanent (without need of pressing upgrade button at boot)
#
#   persist_env=no     do not run saveenv: nothing is changed permanently and
#                      the update button of the box has to be used every time
#   persist_env=yes    run saveenv: permanently install the multiboot bootcmd
#                      (small risk that your u-boot boot procedure will not
#                      work anymore). Also "1"; "0" is the same as "no"
# Without boot.config, or without persist_env in it, persist_default=no is used.

# persist_env=yes
