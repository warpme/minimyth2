From: Jernej Skrabec <jernej.skrabec@gmail.com>
Date: Sat, 20 Jun 2026 18:46:30 +0200
Subject: [PATCH 05/16] media: cedrus: vc1: program EPHS before consuming the
 bitstream

The VE_DEC_VC1_EPHS register, which enables start-code and
emulation-prevention-byte (EPTB) detection, was programmed only after the
data_bit_offset GET_BITS skip loop that advances the hardware bit reader
past the (software-parsed) picture header.

data_bit_offset is counted on the EPTB-removed (RBSP) bitstream, so the
hardware reader must strip the 0x000003 emulation bytes while skipping.
With EPTB detection still disabled during the skip, the reader counted raw
bytes and desynchronised by 8 bits per emulation byte present in the
header, making the VLD start mid-symbol and the picture decode to garbage.

Only streams whose picture header contains emulation-prevention bytes were
affected (e.g. interlaced-frame content with inline coded bitplanes).
Program EPHS before the bitstream is touched so EPTB stripping is active
during the skip. Streams without emulation bytes are unaffected.

Co-Authored-By: Claude Opus 4.8 (1M context) <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01Tj82JZ5jPRRbNkByAQPcy7
Developed-by: Piotr Oniszczuk <piotr.oniszczuk@gmail.com>
Signed-off-by: Piotr Oniszczuk <piotr.oniszczuk@gmail.com>

[Ported to the VC-1 stateless uAPI revision 3 (gus bourg): the metadata
flags are sequence flags. With the start code now in Advanced profile
buffers, EPTB stripping is also active while the start code is skipped.]

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../staging/media/sunxi/cedrus/cedrus_vc1.c   | 63 +++++++++++--------
 1 file changed, 36 insertions(+), 27 deletions(-)

diff --git a/drivers/staging/media/sunxi/cedrus/cedrus_vc1.c b/drivers/staging/media/sunxi/cedrus/cedrus_vc1.c
index 9aab963c8..f20476924 100644
--- a/drivers/staging/media/sunxi/cedrus/cedrus_vc1.c
+++ b/drivers/staging/media/sunxi/cedrus/cedrus_vc1.c
@@ -232,6 +232,42 @@ static int cedrus_vc1_setup(struct cedrus_ctx *ctx, struct cedrus_run *run)
 
 	cedrus_engine_enable(ctx);
 
+	/*
+	 * Program EPHS first so that start-code / emulation-prevention-byte
+	 * (EPTB) detection is enabled before any bitstream is consumed. The
+	 * data_bit_offset skip below counts EPTB-removed (RBSP) bits, matching
+	 * the value ffmpeg reports, so the hardware bit reader must strip the
+	 * 0x000003 emulation bytes while skipping. If EPHS is programmed only
+	 * after the skip, headers containing emulation-prevention bytes desync
+	 * the VLD and the picture decodes to garbage.
+	 */
+	reg = VE_DEC_VC1_EPHS_PROFILE(sequence->profile);
+	if (entrypoint->flags & V4L2_VC1_ENTRYPOINT_HEADER_FLAG_LOOPFILTER)
+		reg |= VE_DEC_VC1_EPHS_LOOPFILTER;
+	if (sequence->flags & V4L2_VC1_SEQUENCE_FLAG_MULTIRES)
+		reg |= VE_DEC_VC1_EPHS_MULTIRES;
+	if (entrypoint->flags & V4L2_VC1_ENTRYPOINT_HEADER_FLAG_FASTUVMC)
+		reg |= VE_DEC_VC1_EPHS_FASTUVMC;
+	if (entrypoint->flags & V4L2_VC1_ENTRYPOINT_HEADER_FLAG_EXTENDED_DMV)
+		reg |= VE_DEC_VC1_EPHS_EXTENDEDMV;
+	reg |= VE_DEC_VC1_EPHS_DQUANT(entrypoint->dquant);
+	if (entrypoint->flags & V4L2_VC1_ENTRYPOINT_HEADER_FLAG_VSTRANSFORM)
+		reg |= VE_DEC_VC1_EPHS_VSTRANSFORM;
+	if (entrypoint->flags & V4L2_VC1_ENTRYPOINT_HEADER_FLAG_OVERLAP)
+		reg |= VE_DEC_VC1_EPHS_OVERLAP;
+	reg |= VE_DEC_VC1_EPHS_QUANTIZER(entrypoint->quantizer);
+	if (sequence->flags & V4L2_VC1_SEQUENCE_FLAG_RANGERED)
+		reg |= VE_DEC_VC1_EPHS_RANGERED;
+	if (sequence->flags & V4L2_VC1_SEQUENCE_FLAG_FINTERPFLAG)
+		reg |= VE_DEC_VC1_EPHS_FINTERPFLAG;
+	if (sequence->flags & V4L2_VC1_SEQUENCE_FLAG_SYNCMARKER)
+		reg |= VE_DEC_VC1_EPHS_SYNCMARKER;
+	if (advanced)
+		reg |= VE_DEC_VC1_EPHS_STARTCODE_DET_EN;
+	else
+		reg |= VE_DEC_VC1_EPHS_EPTB_DET_BYPASS;
+	cedrus_write(dev, VE_DEC_VC1_EPHS, reg);
+
 	/* Set bitstream source */
 
 	slice_bytes = vb2_get_plane_payload(src_buf, 0);
@@ -286,33 +322,6 @@ static int cedrus_vc1_setup(struct cedrus_ctx *ctx, struct cedrus_run *run)
 	cedrus_write(dev, VE_DEC_VC1_PICHDRLEN,
 		     VE_DEC_VC1_PICHDRLEN_LENGTH(0));
 
-	reg = VE_DEC_VC1_EPHS_PROFILE(sequence->profile);
-	if (entrypoint->flags & V4L2_VC1_ENTRYPOINT_HEADER_FLAG_LOOPFILTER)
-		reg |= VE_DEC_VC1_EPHS_LOOPFILTER;
-	if (sequence->flags & V4L2_VC1_SEQUENCE_FLAG_MULTIRES)
-		reg |= VE_DEC_VC1_EPHS_MULTIRES;
-	if (entrypoint->flags & V4L2_VC1_ENTRYPOINT_HEADER_FLAG_FASTUVMC)
-		reg |= VE_DEC_VC1_EPHS_FASTUVMC;
-	if (entrypoint->flags & V4L2_VC1_ENTRYPOINT_HEADER_FLAG_EXTENDED_DMV)
-		reg |= VE_DEC_VC1_EPHS_EXTENDEDMV;
-	reg |= VE_DEC_VC1_EPHS_DQUANT(entrypoint->dquant);
-	if (entrypoint->flags & V4L2_VC1_ENTRYPOINT_HEADER_FLAG_VSTRANSFORM)
-		reg |= VE_DEC_VC1_EPHS_VSTRANSFORM;
-	if (entrypoint->flags & V4L2_VC1_ENTRYPOINT_HEADER_FLAG_OVERLAP)
-		reg |= VE_DEC_VC1_EPHS_OVERLAP;
-	reg |= VE_DEC_VC1_EPHS_QUANTIZER(entrypoint->quantizer);
-	if (sequence->flags & V4L2_VC1_SEQUENCE_FLAG_RANGERED)
-		reg |= VE_DEC_VC1_EPHS_RANGERED;
-	if (sequence->flags & V4L2_VC1_SEQUENCE_FLAG_FINTERPFLAG)
-		reg |= VE_DEC_VC1_EPHS_FINTERPFLAG;
-	if (sequence->flags & V4L2_VC1_SEQUENCE_FLAG_SYNCMARKER)
-		reg |= VE_DEC_VC1_EPHS_SYNCMARKER;
-	if (advanced)
-		reg |= VE_DEC_VC1_EPHS_STARTCODE_DET_EN;
-	else
-		reg |= VE_DEC_VC1_EPHS_EPTB_DET_BYPASS;
-	cedrus_write(dev, VE_DEC_VC1_EPHS, reg);
-
 	/*
 	 * CONDOVER is only coded in Advanced profile I and BI pictures; the
 	 * hardware also wants the value which applies to the other pictures.
