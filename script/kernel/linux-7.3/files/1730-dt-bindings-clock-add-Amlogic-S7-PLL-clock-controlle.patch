From e4413184e5f0243a237642dba3468f304b225ec8 Mon Sep 17 00:00:00 2001
From: Piotr Oniszczuk <piotr.oniszczuk@gmail.com>
Date: Wed, 25 Nov 2026 14:29:52 +0100
Subject: [PATCH] dt-bindings: clock: add Amlogic S7 PLL clock controller

Add the bindings and the clock IDs of the PLL clock controller of the
Amlogic S7 SoC family (S805X3, S905Y5). It provides the fixed PLL with
its dividers and the gp0, hifi and hifi1 PLLs.

Signed-off-by: Piotr Oniszczuk <piotr.oniszczuk@gmail.com>
---
 .../bindings/clock/amlogic,s7-pll-clkc.yaml   | 54 +++++++++++++++++++
 .../dt-bindings/clock/amlogic,s7-pll-clkc.h   | 32 +++++++++++
 2 files changed, 86 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/clock/amlogic,s7-pll-clkc.yaml
 create mode 100644 include/dt-bindings/clock/amlogic,s7-pll-clkc.h

diff --git a/Documentation/devicetree/bindings/clock/amlogic,s7-pll-clkc.yaml b/Documentation/devicetree/bindings/clock/amlogic,s7-pll-clkc.yaml
new file mode 100644
index 000000000..abab1538d
--- /dev/null
+++ b/Documentation/devicetree/bindings/clock/amlogic,s7-pll-clkc.yaml
@@ -0,0 +1,54 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/clock/amlogic,s7-pll-clkc.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Amlogic S7 PLL Clock Controller
+
+maintainers:
+  - Piotr Oniszczuk <piotr.oniszczuk@gmail.com>
+
+description:
+  The PLL clock controller of the Amlogic S7 SoC family (S805X3, S905Y5).
+  It provides the fixed PLL and its dividers, and the gp0, hifi and hifi1
+  PLLs. The sys, gp1 and cpu PLLs are owned by the firmware and are
+  reached through SCMI.
+
+properties:
+  compatible:
+    const: amlogic,s7-pll-clkc
+
+  reg:
+    maxItems: 1
+
+  clocks:
+    maxItems: 1
+
+  clock-names:
+    items:
+      - const: xtal
+
+  "#clock-cells":
+    const: 1
+
+required:
+  - compatible
+  - reg
+  - clocks
+  - clock-names
+  - "#clock-cells"
+
+additionalProperties: false
+
+examples:
+  - |
+    clock-controller@fe008000 {
+      compatible = "amlogic,s7-pll-clkc";
+      reg = <0xfe008000 0x384>;
+      clocks = <&xtal>;
+      clock-names = "xtal";
+      #clock-cells = <1>;
+    };
+
+...
diff --git a/include/dt-bindings/clock/amlogic,s7-pll-clkc.h b/include/dt-bindings/clock/amlogic,s7-pll-clkc.h
new file mode 100644
index 000000000..2cdda78c8
--- /dev/null
+++ b/include/dt-bindings/clock/amlogic,s7-pll-clkc.h
@@ -0,0 +1,32 @@
+/* SPDX-License-Identifier: (GPL-2.0-only OR MIT) */
+/*
+ * Copyright (c) 2019 Amlogic, Inc. All rights reserved.
+ */
+
+#ifndef _DT_BINDINGS_CLOCK_AMLOGIC_S7_PLL_CLKC_H
+#define _DT_BINDINGS_CLOCK_AMLOGIC_S7_PLL_CLKC_H
+
+#define CLKID_FIXED_PLL_DCO			0
+#define CLKID_FIXED_PLL				1
+#define CLKID_GP0_PLL_DCO			2
+#define CLKID_GP0_PLL				3
+#define CLKID_HIFI_PLL_DCO			4
+#define CLKID_HIFI_PLL				5
+#define CLKID_HIFI1_PLL_DCO			6
+#define CLKID_HIFI1_PLL				7
+#define CLKID_FCLK_50M_DIV			8
+#define CLKID_FCLK_50M				9
+#define CLKID_FCLK_DIV2_DIV			10
+#define CLKID_FCLK_DIV2				11
+#define CLKID_FCLK_DIV2P5_DIV			12
+#define CLKID_FCLK_DIV2P5			13
+#define CLKID_FCLK_DIV3_DIV			14
+#define CLKID_FCLK_DIV3				15
+#define CLKID_FCLK_DIV4_DIV			16
+#define CLKID_FCLK_DIV4				17
+#define CLKID_FCLK_DIV5_DIV			18
+#define CLKID_FCLK_DIV5				19
+#define CLKID_FCLK_DIV7_DIV			20
+#define CLKID_FCLK_DIV7				21
+
+#endif /* _DT_BINDINGS_CLOCK_AMLOGIC_S7_PLL_CLKC_H */
