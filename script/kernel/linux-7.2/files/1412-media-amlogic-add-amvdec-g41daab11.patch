+/* ======================================================================== */
+/*     Open firmware (ovp9-sl): stateless VP9, one command per coded frame  */
+/*     per coded frame, everything in a parameter record (abi-vp9.md).       */
+/* ======================================================================== */
+
+/*
+ * The host side of the ABI is the Python stand-in vp9_host.py (record(),
+ * prepare()/complete(), session_writes(), Layout) and the T-VP9-2 runner
+ * vp9_run.py, measured on the VIM3 (G12B) on 2026-09-29: 238/305 test
+ * vectors bit-exact.  This is that host, fed from the V4L2 controls instead
+ * of a header parser (record and state rules: codec_vp9_open_rec.h).
+ * Profile 2 (abi-vp9.md 7): 10-bit decodes into compressed (FBC) references
+ * with the 8-bit NV12 double write into NV12M CAPTURE (private headers and
+ * bodies, as the vendor path's downsample mode); AM21C CAPTURE takes the
+ * compressed frame only (header = the plane, body = pages owned by the
+ * CAPTURE memory, codec_hevc_common.c), for either depth.
+ * Serial: one frame in flight, the request-job flow of the vendor stateless
+ * path (esparser_queue() -> ..._open_feed(), threaded ISR ->
+ * meson_amvdec_request_signal() -> the feed worker retires the request).
+ */
+static uint vp9_open_timeout_ms = 1000;
+module_param(vp9_open_timeout_ms, uint, 0644);
+MODULE_PARM_DESC(vp9_open_timeout_ms,
+		 "VP9: fail a frame the firmware has not answered after this many ms");
+#ifdef AMVDEC_OUCODE_DEV
+static uint vp9_bench;
+module_param(vp9_bench, uint, 0644);
+MODULE_PARM_DESC(vp9_bench,
+		 "VP9: log kick->done, done->kick and the parts of done->kick every N frames (0 = off)");
+static uint vp9_bench_startup_us;
+module_param(vp9_bench_startup_us, uint, 0644);
+MODULE_PARM_DESC(vp9_bench_startup_us,
+		 "VP9, with vp9_bench: after each start busy-poll the firmware's progress register for up to this many us to time kick->tiles and kick->first superblock (0 = off; costs CPU)");
+#else
+/* Development build only (OUCODE_DEV=1): diagnostics, constant off here. */
+static const uint vp9_bench;
+static const uint vp9_bench_startup_us;
+#endif
+/*
+ * vp9_open_pipeline: the next frame is prepared (record, stream copy, SAO-MMU
+ * map, buffers) while the current one decodes and started from the completion
+ * interrupt, as h264_pipeline.  Off: one frame at a time (the request flow).
+ */
+static bool vp9_open_pipeline = true;
+module_param(vp9_open_pipeline, bool, 0644);
+MODULE_PARM_DESC(vp9_open_pipeline,
+		 "VP9: prepare the next frame while the current one decodes, start it from the completion interrupt (read at session start; default on)");
+/*
+ * vp9_open_fbc8: 8-bit into NV12M the profile-2 way (abi-vp9.md 7) -
+ * compressed references in private MMU-mode headers and bodies, the NV12M
+ * planes written by the double write only.  Motion compensation then reads
+ * compressed references (less DDR traffic than linear NV12).
+ */
+static bool vp9_open_fbc8 = true;
+module_param(vp9_open_fbc8, bool, 0644);
+MODULE_PARM_DESC(vp9_open_fbc8,
+		 "VP9: decode 8-bit into NV12M through compressed (FBC) references + the NV12 double write (G12A/SM1; read at session start; default on: ~35% faster at 4K on G12B)");
+static bool vp9_open_reload = true;
+module_param(vp9_open_reload, bool, 0644);
+MODULE_PARM_DESC(vp9_open_reload,
+		 "VP9: DMA the 16 KiB image into IMEM before every frame (0 = only for the first frame and after a failed one; the core is reset before every frame either way)");
+
+#define OVP9_FW_PATH		"meson/vdec/ovp9_sl.bin"
+#define OVP9_CMD_DECODE		1
+#define OVP9_STATUS_DONE	0x80
+#define OVP9_STATUS_ERROR	0x81
+
+/* SCRATCH_2 with 0x80 */
+#define OVP9_DONE_ADAPT		BIT(0)	/* counts + forward-updated table saved: host adapts */
+#define OVP9_DONE_WARNINGS	(BIT(8) | BIT(9) | BIT(10))
+
+#define OVP9_WS_ALIGN		SZ_64K
+/* stream buffer: 16-byte AMLV envelope, the frame, zeros the fetch may read */
+#define OVP9_FIFO_PAD		SZ_1K		/* covered by the write pointer (harness fifo_pad) */
+#define OVP9_FIFO_SLACK		SZ_4K		/* zeros beyond it */
+#define OVP9_FIFO_ALIGN		8
+
+/*
+ * Frame slots.  Serial: slot 0 only, its buffers are the request job's.
+ * Pipeline: slot 1 has its own record and SAO-MMU map (the map a running
+ * frame's DMA reads is never rewritten), after the ABI workspace.
+ */
+enum {
+	OVP9_SLOT_FREE,
+	OVP9_SLOT_READY,	/* pipeline: prepared, waiting for the core */
+	OVP9_SLOT_RUN,		/* started */
+	OVP9_SLOT_DONE,		/* pipeline: answered (or failed unstarted), buffers not returned yet */
+};
+#define OVP9_SLOTS		2
+#define OVP9_PIPE_DRAIN_MS	1000
+#define OVP9_WS_REC1		(OVP9_WS_RECORD + 0x400)
+#define OVP9_WS_MAP1		OVP9_WS_SIZE
+#define OVP9_WS_ALLOC		(OVP9_WS_SIZE + OVP9_WS_MMU_MAP_SIZE)
+#define OVP9_WS_MMU_MAP_SIZE	0x8000
+
+/* SCRATCH_J progress stages (abi-vp9.md 1) timed by vp9_bench_startup_us */
+#define OVP9_STAGE_TILES	0x20
+#define OVP9_STAGE_SB0		0x22
+
+struct codec_vp9_open_slot {
+	u8 state;
+	u32 seq;			/* prepare order: start and retirement order */
+	u32 rec_off, map_off;		/* record, SAO-MMU map (workspace offsets) */
+	void *fifo_vaddr;
+	dma_addr_t fifo_paddr;
+	size_t fifo_size;
+	u32 bytes;			/* AMLV envelope + frame */
+	struct codec_vp9_open_cur cur;
+	bool prev_kf;			/* adaptation: the frame before it was a key frame */
+	bool ok;			/* pipeline: the verdict */
+	/* the frame's buffers: CAPTURE (serial: the request job's), OUTPUT (pipeline) */
+	struct vb2_v4l2_buffer *src, *dst;
+	u64 ts;
+};
+
+struct ovp9_acc {
+	u64 sum;
+	u32 max, n;
+};
+
+struct codec_vp9_open {
+	struct amvdec_session *sess;
+	u32 soc;
+	u32 stream_ctl;			/* HEVC_STREAM_CONTROL reset bits (0x0eb14000 on G12B) */
+
+	void *ws_alloc;
+	dma_addr_t ws_alloc_paddr;
+	u8 *ws;
+	dma_addr_t ws_paddr;
+
+	void *fw_vaddr;			/* private copy of the image, reloaded into IMEM */
+	dma_addr_t fw_paddr;
+	bool need_reload;		/* vp9_open_reload 0: first frame, after 0x81 / timeout */
+	bool fbc8;			/* vp9_open_fbc8 latched: 8-bit NV12M via FBC + double write */
+
+	/* MV buffers: written by every frame, read by the next (ping-pong) */
+	void *mv_vaddr[2];
+	dma_addr_t mv_paddr[2];
+	size_t mv_size;
+
+	u8 *adapt_buf;			/* cached pre | cur | counts for the adaptation */
+	u16 rec[OVP9_REC_WORDS];
+
+	/*
+	 * Decoder state.  Pipeline: a prepared frame's ovp9_done() is applied
+	 * at once (speculatively), so the next one is built on it; a failure
+	 * undoes it (codec_vp9_open_pipe_failed()).
+	 */
+	struct codec_vp9_open_state st;
+
+	/* frames */
+	bool pipe;			/* vp9_open_pipeline, latched at start */
+	bool halt;			/* stop: nothing is started any more */
+	int run;			/* slot on the core, -1 = idle */
+	u32 seq;
+	wait_queue_head_t wq;
+	struct codec_vp9_open_slot slot[OVP9_SLOTS];
+	atomic_t running;
+	struct delayed_work timeout;
+	ktime_t deadline;
+
+	/* vp9_bench */
+	ktime_t t_kick, t_done, t_cpl, t_feed, t_kick0, t_rst;
+	struct ovp9_acc hw, irq, gap, cpl, adapt, sched, feed, rst, prog, fw_tiles, fw_sb0;
+	u32 n_isr_kick;
+};
+
+static void ovp9_acc_add(struct ovp9_acc *a, s64 us)
+{
+	if (us < 0)
+		return;
+	a->sum += us;
+	a->max = max_t(u32, a->max, us);
+	a->n++;
+}
+
+static u32 ovp9_acc_avg(const struct ovp9_acc *a)
+{
+	return a->n ? div_u64(a->sum, a->n) : 0;
+}
+
+static void codec_vp9_open_free_mv(struct device *dev, struct codec_vp9_open *o)
+{
+	int i;
+
+	for (i = 0; i < 2; i++) {
+		if (o->mv_vaddr[i])
+			dma_free_coherent(dev, o->mv_size, o->mv_vaddr[i], o->mv_paddr[i]);
+		o->mv_vaddr[i] = NULL;
+	}
+	o->mv_size = 0;
+}
+
+static void codec_vp9_open_free(struct device *dev, struct codec_vp9_open *o)
+{
+	int i;
+
+	codec_vp9_open_free_mv(dev, o);
+	for (i = 0; i < OVP9_SLOTS; i++)
+		if (o->slot[i].fifo_vaddr)
+			dma_free_coherent(dev, o->slot[i].fifo_size, o->slot[i].fifo_vaddr,
+					  o->slot[i].fifo_paddr);
+	if (o->fw_vaddr)
+		dma_free_coherent(dev, AMVDEC_FW_SIZE, o->fw_vaddr, o->fw_paddr);
+	if (o->ws_alloc)
+		dma_free_coherent(dev, OVP9_WS_ALLOC + OVP9_WS_ALIGN, o->ws_alloc,
+				  o->ws_alloc_paddr);
+	kfree(o->adapt_buf);
+	kfree(o);
+}
+
+static void codec_vp9_open_timeout(struct work_struct *work);
+
+static int codec_vp9_open_start(struct amvdec_session *sess, struct codec_vp9 *vp9)
+{
+	struct amvdec_core *core = sess->core;
+	struct codec_vp9_open *o;
+	u32 ctl;
+
+	o = kzalloc_obj(*o);
+	if (!o)
+		return -ENOMEM;
+	o->sess = sess;
+	o->soc = core->platform->revision == AMVDEC_REVISION_SM1 ?
+		 OVP9_SOC_SM1 : OVP9_SOC_G12A;
+	atomic_set(&o->running, 0);
+	INIT_DELAYED_WORK(&o->timeout, codec_vp9_open_timeout);
+	init_waitqueue_head(&o->wq);
+	o->pipe = vp9_open_pipeline;
+	o->run = -1;
+	o->need_reload = true;
+	o->slot[0].rec_off = OVP9_WS_RECORD;
+	o->slot[0].map_off = OVP9_WS_MMU_MAP;
+	o->slot[1].rec_off = OVP9_WS_REC1;
+	o->slot[1].map_off = OVP9_WS_MAP1;
+
+	o->adapt_buf = kmalloc(2 * ADAPT_PROB_SIZE + COUNT_SIZE, GFP_KERNEL);
+	/*
+	 * One allocation, 64 KiB aligned by hand, zeroed: the deblock
+	 * parameters must start zeroed (the vendor image clears them at boot,
+	 * ovp9-sl does not), the MMU maps are read even for NV12 output, the
+	 * segment map and the context slots start empty.
+	 */
+	o->ws_alloc = dma_alloc_coherent(core->dev, OVP9_WS_ALLOC + OVP9_WS_ALIGN,
+					 &o->ws_alloc_paddr, GFP_KERNEL);
+	o->fw_vaddr = dma_alloc_coherent(core->dev, AMVDEC_FW_SIZE, &o->fw_paddr,
+					 GFP_KERNEL);
+	if (!o->adapt_buf || !o->ws_alloc || !o->fw_vaddr) {
+		dev_err(core->dev, "VP9 open fw: workspace allocation failed\n");
+		codec_vp9_open_free(core->dev, o);
+		return -ENOMEM;
+	}
+	memset(o->ws_alloc, 0, OVP9_WS_ALLOC + OVP9_WS_ALIGN);
+	o->ws_paddr = ALIGN(o->ws_alloc_paddr, OVP9_WS_ALIGN);
+	o->ws = (u8 *)o->ws_alloc + (o->ws_paddr - o->ws_alloc_paddr);
+
+	/* amvdec_hevc_load_firmware() has just put the image there */
+	memcpy(o->fw_vaddr, core->fw_vaddr, AMVDEC_FW_SIZE);
+
+	/*
+	 * Frame-based stream input needs HEVC_STREAM_CONTROL's reset bits
+	 * (measured on G12B: with them zeroed the start-code search never
+	 * matches).  The core was just reset and conf_esparser() has not run:
+	 * keep what is there, without fetch, parser-fed WP and endian.
+	 */
+	ctl = meson_amvdec_read_dos(core, HEVC_STREAM_CONTROL);
+	o->stream_ctl = ctl & ~(BIT(3) | BIT(0) | (7 << 4));
+	if (!o->stream_ctl) {
+		dev_warn(core->dev,
+			 "VP9 open fw: HEVC_STREAM_CONTROL reads %#x at start; using the G12B reset value\n",
+			 ctl);
+		o->stream_ctl = 0x0eb14000;
+	}
+
+	/* The image boots when __vdec_hevc_start() releases it and idles on SCRATCH_0. */
+	meson_amvdec_write_dos(core, HEVC_ASSIST_SCRATCH_0, 0);
+	meson_amvdec_write_dos(core, HEVC_ASSIST_MBOX1_CLR_REG, 1);
+	meson_amvdec_write_dos(core, HEVC_ASSIST_MBOX1_MASK, 1);
+
+	/*
+	 * vp9_open_fbc8 (NV12M CAPTURE only; the open path runs on G12A/SM1
+	 * only): the shared buffer code then gives every CAPTURE buffer an
+	 * 8-bit private FBC header and MMU body, as for 10-bit downsampling.
+	 */
+	o->fbc8 = READ_ONCE(vp9_open_fbc8) && sess->pixfmt_cap == V4L2_PIX_FMT_NV12M;
+	vp9->common.dw8 = o->fbc8;
+
+	vp9->open = o;
+	dev_info(core->dev_dec, "VP9: open firmware %s (stream control %#x%s%s%s)\n",
+		 OVP9_FW_PATH, o->stream_ctl, o->pipe ? ", pipelined" : "",
+		 vp9_open_reload ? "" : ", image kept in IMEM",
+		 o->fbc8 ? ", 8-bit via FBC references + NV12 double write" : "");
+	return 0;
+}
+
+static void codec_vp9_open_bench_log(struct amvdec_session *sess, struct codec_vp9_open *o)
+{
+	struct device *dev = sess->core->dev_dec;
+
+	dev_info(dev,
+		 "vp9 bench (open%s%s): %u frames, kick->done avg %u us max %u us, done->kick avg %u us max %u us\n",
+		 o->pipe ? " pipe" : "", o->fbc8 ? " fbc8" : "", o->hw.n, ovp9_acc_avg(&o->hw), o->hw.max,
+		 ovp9_acc_avg(&o->gap), o->gap.max);
+	dev_info(dev,
+		 "vp9 bench (open%s): irq->thread %u, complete %u (adapt %u us x%u), signal->feed %u, feed %u, reset+reload %u (max %u), programme+start %u us avg; %u of %u started from the interrupt\n",
+		 o->pipe ? " pipe" : "", ovp9_acc_avg(&o->irq), ovp9_acc_avg(&o->cpl),
+		 ovp9_acc_avg(&o->adapt), o->adapt.n, ovp9_acc_avg(&o->sched),
+		 ovp9_acc_avg(&o->feed), ovp9_acc_avg(&o->rst), o->rst.max,
+		 ovp9_acc_avg(&o->prog), o->n_isr_kick, o->gap.n);
+	if (o->fw_tiles.n || o->fw_sb0.n)
+		dev_info(dev,
+			 "vp9 bench (open%s): firmware kick->tiles avg %u us max %u us (%u), kick->first SB avg %u us max %u us (%u)\n",
+			 o->pipe ? " pipe" : "", ovp9_acc_avg(&o->fw_tiles), o->fw_tiles.max,
+			 o->fw_tiles.n, ovp9_acc_avg(&o->fw_sb0), o->fw_sb0.max, o->fw_sb0.n);
+}
+
+static void codec_vp9_open_retire_slot(struct amvdec_session *sess,
+				       struct codec_vp9_open_slot *s, bool cancel);
+
+/*
+ * Return the buffers of every pipeline slot still holding some, oldest first,
+ * as errors (session stop).  The core is halted: nothing runs any more.
+ */
+static void codec_vp9_open_discard_slots(struct amvdec_session *sess, struct codec_vp9_open *o)
+{
+	struct codec_vp9_open_slot *s, tmp;
+	u32 i;
+
+	for (;;) {
+		s = NULL;
+		for (i = 0; i < OVP9_SLOTS; i++)
+			if (o->slot[i].state != OVP9_SLOT_FREE && o->slot[i].src &&
+			    (!s || (s32)(o->slot[i].seq - s->seq) < 0))
+				s = &o->slot[i];
+		if (!s)
+			break;
+		tmp = *s;
+		s->src = NULL;
+		s->dst = NULL;
+		s->state = OVP9_SLOT_FREE;
+		codec_vp9_open_retire_slot(sess, &tmp, true);
+	}
+}
+
+/* After the core has been halted and quiesced (__vdec_hevc_stop()). */
+static void codec_vp9_open_stop(struct amvdec_session *sess, struct codec_vp9 *vp9)
+{
+	struct codec_vp9_open *o = vp9->open;
+
+	cancel_delayed_work_sync(&o->timeout);
+	mutex_lock(&vp9->lock);
+	o->halt = true;
+	vp9->open = NULL;
+	mutex_unlock(&vp9->lock);
+	wake_up_all(&o->wq);
+	if (vp9_bench && o->hw.n)
+		codec_vp9_open_bench_log(sess, o);
+	/*
+	 * Serial: the request in flight, if any, is cancelled by
+	 * vdec_stop_streaming().  Pipeline: the slots' buffers go back here.
+	 */
+	codec_vp9_open_discard_slots(sess, o);
+	codec_vp9_open_free(sess->core->dev, o);
+}
+
+/*
+ * vdec_stop_streaming() when the stop failed before ->stop() (the workspace is
+ * retained): the pipeline's buffers still go back to vb2.
+ */
+void meson_amvdec_codec_vp9_open_discard(struct amvdec_session *sess)
+{
+	struct codec_vp9 *vp9 = sess->priv;
+	struct codec_vp9_open *o;
+
+	if (!vp9 || sess->fmt_out->pixfmt != V4L2_PIX_FMT_VP9_FRAME)
+		return;
+	mutex_lock(&vp9->lock);
+	o = vp9->open;
+	if (o)
+		o->halt = true;
+	mutex_unlock(&vp9->lock);
+	if (o)
+		codec_vp9_open_discard_slots(sess, o);
+}
+
+/*
+ * Backward adaptation (abi-vp9.md 3.3): slot[ctx] = adapt(slot[ctx] as it was
+ * before the frame - the firmware only reads it -, this frame's forward-
+ * updated table at +0x4000, the counts).  adapt_coef_probs() is the vendor
+ * path's routine on the same layouts; vp9_adapt.py was checked bit-exact
+ * against it.  The coherent (uncached) buffers are copied once each way.
+ */
+static void codec_vp9_open_adapt(struct codec_vp9_open *o, u32 ctx, bool intra, bool prev_kf)
+{
+	u8 *slot = o->ws + OVP9_WS_PROB + ctx * OVP9_PROB_SLOT;
+	u8 *pre = o->adapt_buf, *cur = pre + ADAPT_PROB_SIZE, *cnt = cur + ADAPT_PROB_SIZE;
+
+	memcpy(pre, slot, ADAPT_PROB_SIZE);
+	memcpy(cur, o->ws + OVP9_WS_PROB + OVP9_PROB_CUR, ADAPT_PROB_SIZE);
+	memcpy(cnt, o->ws + OVP9_WS_COUNT, COUNT_SIZE);
+	adapt_coef_probs(prev_kf, intra, ctx, (unsigned int *)pre,
+			 (unsigned int *)cur, (unsigned int *)cnt);
+	memcpy(slot, cur, ADAPT_PROB_SIZE);
+}
+
+/*
+ * vp9_host.complete() for a 0x80, up to the state update; false when the
+ * frame must be failed.  @s->prev_kf is the update-factor input (the frame
+ * before this one was a key frame), taken when the frame was built: the
+ * serial path's st.last_was_key at completion, which a pipeline has moved on.
+ */
+static bool codec_vp9_open_complete(struct amvdec_session *sess, struct codec_vp9_open *o,
+				    struct codec_vp9_open_slot *s, u32 s2, u32 s3)
+{
+	struct codec_vp9_open_cur *c = &s->cur;
+	struct device *dev = sess->core->dev_dec;
+
+	if (s2 & OVP9_DONE_WARNINGS)
+		dev_warn_ratelimited(dev, "VP9 open fw: frame %ux%u done with warnings %#x\n",
+				     c->w, c->h, s2);
+	if (s3 != c->sbs)
+		dev_warn_ratelimited(dev, "VP9 open fw: %u of %u superblocks decoded\n",
+				     s3, c->sbs);
+	if (c->adapt) {
+		ktime_t t0 = vp9_bench ? ktime_get() : 0;
+
+		if (!(s2 & OVP9_DONE_ADAPT)) {
+			dev_err_ratelimited(dev,
+					    "VP9 open fw: no counts for backward adaptation (done flags %#x)\n",
+					    s2);
+			return false;
+		}
+		codec_vp9_open_adapt(o, c->ctx, c->intra, s->prev_kf);
+		if (vp9_bench)
+			ovp9_acc_add(&o->adapt, ktime_us_delta(ktime_get(), t0));
+	} else if (s2 & OVP9_DONE_ADAPT) {
+		dev_warn_ratelimited(dev, "VP9 open fw: unexpected adaptation request (%#x) ignored\n",
+				     s2);
+	}
+	return true;
+}
+
+static void codec_vp9_open_bench_done(struct amvdec_session *sess, struct codec_vp9_open *o)
+{
+	u64 isr_ns;
+
+	o->t_done = ktime_get();
+	if (!vp9_bench || !o->t_kick)
+		return;
+	ovp9_acc_add(&o->hw, ktime_us_delta(o->t_done, o->t_kick));
+	isr_ns = READ_ONCE(sess->vp9_isr_ns);
+	if (isr_ns && isr_ns > ktime_to_ns(o->t_kick))
+		ovp9_acc_add(&o->irq, div_u64(ktime_to_ns(o->t_done) - isr_ns, NSEC_PER_USEC));
+	if (o->hw.n % vp9_bench == 0)
+		codec_vp9_open_bench_log(sess, o);
+}
+
+static int codec_vp9_open_kick(struct amvdec_session *sess, struct codec_vp9_open *o,
+			       struct codec_vp9_open_slot *s);
+
+/* The oldest slot in @state, or NULL. */
+static struct codec_vp9_open_slot *codec_vp9_open_find(struct codec_vp9_open *o, u8 state)
+{
+	struct codec_vp9_open_slot *best = NULL;
+	u32 i;
+
+	for (i = 0; i < OVP9_SLOTS; i++)
+		if (o->slot[i].state == state &&
+		    (!best || (s32)(o->slot[i].seq - best->seq) < 0))
+			best = &o->slot[i];
+	return best;
+}
+
+/*
+ * Pipeline: start the oldest READY frame on the idle core.  vp9->lock held.
+ * A reset failure leaves the core unusable: that frame fails, the session is
+ * aborted.
+ */
+static void codec_vp9_open_pipe_kick(struct amvdec_session *sess, struct codec_vp9_open *o)
+{
+	struct codec_vp9_open_slot *s;
+
+	if (o->run >= 0 || o->halt)
+		return;
+	s = codec_vp9_open_find(o, OVP9_SLOT_READY);
+	if (!s)
+		return;
+	if (codec_vp9_open_kick(sess, o, s)) {
+		s->ok = false;
+		s->state = OVP9_SLOT_DONE;
+		o->halt = true;
+		ovp9_invalidate(&o->st, s->cur.dst_idx);
+		meson_amvdec_abort(sess);
+		amvdec_queue_esparser(sess);
+	}
+}
+
+/*
+ * Pipeline: @s failed although its ovp9_done() was applied when it was
+ * prepared.  Leave the state as the serial path would have it.  A frame
+ * prepared on top of it was built on that state: a key frame does not depend
+ * on anything @s left (contexts, segment map and previous-frame rules all
+ * restart; only its MV buffer choice differs, which nothing reads), anything
+ * else is failed unstarted - where the serial path would have refused it
+ * (it references @s) or decoded it from invalidated contexts.
+ */
+static void codec_vp9_open_pipe_failed(struct codec_vp9_open *o, struct codec_vp9_open_slot *s)
+{
+	struct codec_vp9_open_slot *n = codec_vp9_open_find(o, OVP9_SLOT_READY);
+
+	if (n && n->cur.key) {
+		o->st.buf[s->cur.dst_idx].valid = false;
+		return;
+	}
+	if (n) {
+		n->ok = false;
+		n->state = OVP9_SLOT_DONE;
+		ovp9_invalidate(&o->st, n->cur.dst_idx);
+	}
+	ovp9_invalidate(&o->st, s->cur.dst_idx);
+}
+
+/*
+ * The frame on the core has an answer (@ok) or timed out.  vp9->lock held,
+ * running already cleared.  Serial: returns the request's CAPTURE buffer for
+ * meson_amvdec_request_signal() (after the unlock).  Pipeline: the slot is
+ * DONE, the next prepared frame started unless a stop is pending; the worker
+ * retires it.
+ */
+static struct vb2_v4l2_buffer *codec_vp9_open_finish(struct amvdec_session *sess,
+						     struct codec_vp9_open *o, bool ok)
+{
+	struct codec_vp9_open_slot *s = &o->slot[o->run];
+	struct vb2_v4l2_buffer *dst = NULL;
+
+	o->run = -1;
+	if (!ok)
+		o->need_reload = true;
+	if (!o->pipe) {
+		if (ok)
+			ovp9_done(&o->st, &s->cur);
+		else
+			ovp9_invalidate(&o->st, s->cur.dst_idx);
+		dst = s->dst;
+		s->dst = NULL;
+		s->state = OVP9_SLOT_FREE;
+		return dst;
+	}
+	s->ok = ok;
+	s->state = OVP9_SLOT_DONE;
+	if (!ok)
+		codec_vp9_open_pipe_failed(o, s);
+	/* the next frame first; its retirement can wait for the worker */
+	if (!READ_ONCE(sess->should_stop)) {
+		codec_vp9_open_pipe_kick(sess, o);
+		if (o->run >= 0)
+			o->n_isr_kick++;
+	}
+	return NULL;
+}
+
+static irqreturn_t codec_vp9_open_threaded_isr(struct amvdec_session *sess)
+{
+	struct codec_vp9 *vp9 = sess->priv;
+	struct amvdec_core *core = sess->core;
+	struct codec_vp9_open_slot *s;
+	struct codec_vp9_open *o;
+	struct vb2_v4l2_buffer *dst;
+	u32 st, s2, s3;
+	bool ok, pipe;
+
+	mutex_lock(&vp9->lock);
+	o = vp9->open;
+	if (!o) {
+		/* codec_vp9_open_stop() ran first: the core is halted and gated */
+		mutex_unlock(&vp9->lock);
+		return IRQ_HANDLED;
+	}
+	meson_amvdec_write_dos(core, HEVC_ASSIST_MBOX1_CLR_REG, 1);
+	st = meson_amvdec_read_dos(core, HEVC_ASSIST_SCRATCH_0);
+	if ((st != OVP9_STATUS_DONE && st != OVP9_STATUS_ERROR) || o->run < 0 ||
+	    atomic_cmpxchg(&o->running, 1, 0) != 1) {
+		/* not a verdict, or one the timeout already answered */
+		mutex_unlock(&vp9->lock);
+		return IRQ_HANDLED;
+	}
+	s2 = meson_amvdec_read_dos(core, HEVC_ASSIST_SCRATCH_2);
+	s3 = meson_amvdec_read_dos(core, HEVC_ASSIST_SCRATCH_3);
+	/* Acknowledge (ABI: the host clears it to 0). */
+	meson_amvdec_write_dos(core, HEVC_ASSIST_SCRATCH_0, 0);
+	cancel_delayed_work(&o->timeout);
+	codec_vp9_open_bench_done(sess, o);
+	/* The status was read relaxed: order the DDR reads after it. */
+	rmb();
+
+	s = &o->slot[o->run];
+	if (st == OVP9_STATUS_ERROR) {
+		dev_err_ratelimited(core->dev_dec,
+				    "VP9 open fw: frame failed: error %u stage %#x detail %#x (progress %#x) %ux%u %s ctx %u%s\n",
+				    s2 & 0xff, (s2 >> 8) & 0xff, s3,
+				    meson_amvdec_read_dos(core, HEVC_ASSIST_SCRATCH_J),
+				    s->cur.w, s->cur.h,
+				    s->cur.key ? "key" : s->cur.intra_only ? "intra-only" : "inter",
+				    s->cur.ctx, s->cur.adapt ? " adapt" : "");
+		ok = false;
+	} else {
+		ok = codec_vp9_open_complete(sess, o, s, s2, s3);
+	}
+	if (vp9_bench) {
+		o->t_cpl = ktime_get();
+		ovp9_acc_add(&o->cpl, ktime_us_delta(o->t_cpl, o->t_done));
+	}
+	pipe = o->pipe;
+	dst = codec_vp9_open_finish(sess, o, ok);
+	mutex_unlock(&vp9->lock);
+
+	if (pipe) {
+		wake_up_all(&o->wq);
+		amvdec_queue_esparser(sess);
+		return IRQ_HANDLED;
+	}
+	if (!ok)
+		sess->request_job.error = true;
+	meson_amvdec_request_signal(sess, dst);
+	return IRQ_HANDLED;
+}
+
+/*
+ * The firmware bounds every wait and answers 0x81 itself; this catches a lost
+ * interrupt or a hung core.  A stale run (the frame it was armed for has
+ * completed and the next one started) sees the new deadline and re-arms.
+ */
+static void codec_vp9_open_timeout(struct work_struct *work)
+{
+	struct codec_vp9_open *o = container_of(to_delayed_work(work),
+						struct codec_vp9_open, timeout);
+	struct amvdec_session *sess = o->sess;
+	struct codec_vp9 *vp9 = sess->priv;
+	struct amvdec_core *core = sess->core;
+	struct vb2_v4l2_buffer *dst;
+	ktime_t now = ktime_get();
+	bool pipe;
+
+	mutex_lock(&vp9->lock);
+	if (!atomic_read(&o->running) || o->run < 0) {
+		mutex_unlock(&vp9->lock);
+		return;
+	}
+	if (ktime_before(now, o->deadline)) {
+		mod_delayed_work(system_dfl_wq, &o->timeout,
+				 usecs_to_jiffies(ktime_us_delta(o->deadline, now)) + 1);
+		mutex_unlock(&vp9->lock);
+		return;
+	}
+	if (atomic_cmpxchg(&o->running, 1, 0) != 1) {
+		mutex_unlock(&vp9->lock);
+		return;
+	}
+	dev_err(core->dev_dec,
+		"VP9 open fw: no answer after %u ms: status %#x progress %#x scratch2 %#x scratch3 %#x stream rd %#x wr %#x level %#x shift bytes %#x lcu %#x\n",
+		vp9_open_timeout_ms,
+		meson_amvdec_read_dos(core, HEVC_ASSIST_SCRATCH_0),
+		meson_amvdec_read_dos(core, HEVC_ASSIST_SCRATCH_J),
+		meson_amvdec_read_dos(core, HEVC_ASSIST_SCRATCH_2),
+		meson_amvdec_read_dos(core, HEVC_ASSIST_SCRATCH_3),
+		meson_amvdec_read_dos(core, HEVC_STREAM_RD_PTR),
+		meson_amvdec_read_dos(core, HEVC_STREAM_WR_PTR),
+		meson_amvdec_read_dos(core, HEVC_STREAM_LEVEL),
+		meson_amvdec_read_dos(core, HEVC_SHIFT_BYTE_COUNT),
+		meson_amvdec_read_dos(core, HEVC_PARSER_LCU_START));
+	/* Halt it; the next frame resets the core and reloads the image anyway. */
+	meson_amvdec_write_dos(core, HEVC_MPSR, 0);
+	meson_amvdec_write_dos(core, HEVC_CPSR, 0);
+	pipe = o->pipe;
+	dst = codec_vp9_open_finish(sess, o, false);
+	mutex_unlock(&vp9->lock);
+
+	if (pipe) {
+		wake_up_all(&o->wq);
+		amvdec_queue_esparser(sess);
+		return;
+	}
+	sess->request_job.error = true;
+	meson_amvdec_request_signal(sess, dst);
+}
+
+/*
+ * Bench only (vp9_bench_startup_us): how long the firmware takes from the
+ * start to the tiles (record, frame registers, start code, probability
+ * context, compressed header) and to the first superblock of tile 0, from
+ * its progress register.  Busy-polls the CPU.
+ */
+static void codec_vp9_open_bench_startup(struct amvdec_core *core, struct codec_vp9_open *o)
+{
+	ktime_t t0 = o->t_kick, now;
+	bool tiles = false;
+	u32 j;
+
+	for (;;) {
+		j = meson_amvdec_read_dos(core, HEVC_ASSIST_SCRATCH_J);
+		now = ktime_get();
+		if (!tiles && j >= OVP9_STAGE_TILES && j < OVP9_STATUS_DONE) {
+			tiles = true;
+			ovp9_acc_add(&o->fw_tiles, ktime_us_delta(now, t0));
+		}
+		if (j == OVP9_STAGE_SB0) {
+			ovp9_acc_add(&o->fw_sb0, ktime_us_delta(now, t0));
+			return;
+		}
+		if (j >= OVP9_STATUS_DONE || ktime_us_delta(now, t0) > vp9_bench_startup_us)
+			return;
+		cpu_relax();
+	}
+}
+
+/*
+ * One coded frame: the session programme of vp9_host.session_writes(), the
+ * stream window of the harness's ah_host_stream(), SCRATCH_1/0, start.  The
+ * core is reset first, as the harness (power cycle) and the vendor's
+ * multi-instance run() (hevc_reset_core) do per frame, so nothing from the
+ * previous frame's engines or shifter survives.  The image is DMAed into IMEM
+ * again unless vp9_open_reload is 0 (the vendor's run() keeps a loaded image
+ * across that reset too: vdec->mc_loaded) and the last frame completed.
+ */
+static int codec_vp9_open_kick(struct amvdec_session *sess, struct codec_vp9_open *o,
+			       struct codec_vp9_open_slot *s)
+{
+	struct amvdec_core *core = sess->core;
+	dma_addr_t src = s->fifo_paddr;
+	u32 pic = (3 << 29) | BIT(24) | BIT(22) | BIT(7) | BIT(4) | BIT(0);
+	u32 tmo = vp9_open_timeout_ms ?: 1000;
+	u32 width = s->cur.w, height = s->cur.h;
+	bool fbc = s->cur.mode != OVP9_OUT_NV12, nv12 = s->cur.mode != OVP9_OUT_FBC;
+	bool reload = vp9_open_reload || o->need_reload;
+	u32 cfgb, v;
+	int i, ret;
+
+	if (vp9_bench)
+		o->t_kick0 = ktime_get();
+	ret = meson_amvdec_hevc_fw_reset_reload(core, reload ? o->fw_paddr : 0);
+	if (ret) {
+		dev_err(core->dev_dec, "VP9 open fw: core reset failed (%d)\n", ret);
+		return ret;
+	}
+	o->need_reload = false;
+	if (vp9_bench)
+		o->t_rst = ktime_get();
+
+	/* --- session programme: before the stream fetch is enabled (measured) */
+	v = meson_amvdec_read_dos(core, HEVC_PARSER_INT_CONTROL) & ~BIT(31);
+	meson_amvdec_write_dos(core, HEVC_PARSER_INT_CONTROL, v | pic);
+	meson_amvdec_write_dos_bits(core, HEVC_SHIFT_STATUS, BIT(0));
+	meson_amvdec_write_dos(core, HEVC_SHIFT_CONTROL, BIT(10) | BIT(9) |
+			       (3 << 6) | BIT(5) | BIT(2) | BIT(1) | BIT(0));
+	meson_amvdec_write_dos(core, HEVC_CABAC_CONTROL, BIT(0));
+	meson_amvdec_write_dos(core, HEVC_PARSER_CORE_CONTROL, BIT(0));
+	meson_amvdec_write_dos(core, HEVC_SHIFT_STARTCODE, 0x00000001);
+	meson_amvdec_write_dos(core, HEVC_PARSER_CMD_WRITE, BIT(16));
+	for (i = 0; i < ARRAY_SIZE(meson_amvdec_hevc_parser_cmd); ++i)
+		meson_amvdec_write_dos(core, HEVC_PARSER_CMD_WRITE,
+				       meson_amvdec_hevc_parser_cmd[i]);
+	meson_amvdec_write_dos(core, HEVC_PARSER_CMD_SKIP_0, PARSER_CMD_SKIP_CFG_0);
+	meson_amvdec_write_dos(core, HEVC_PARSER_CMD_SKIP_1, PARSER_CMD_SKIP_CFG_1);
+	meson_amvdec_write_dos(core, HEVC_PARSER_CMD_SKIP_2, PARSER_CMD_SKIP_CFG_2);
+	meson_amvdec_write_dos(core, HEVC_PARSER_IF_CONTROL, BIT(5) | BIT(2) | BIT(0));
+	meson_amvdec_write_dos(core, HEVCD_IPP_TOP_CNTL, BIT(0));
+	meson_amvdec_write_dos(core, HEVCD_IPP_TOP_CNTL, BIT(1));
+	meson_amvdec_write_dos(core, HEVC_ASSIST_MBOX1_CLR_REG, 1);
+	meson_amvdec_write_dos(core, HEVC_PSCALE_CTRL, 0);
+
+	/*
+	 * output format (vp9_host.session_writes()): NV12 = 2-plane reference
+	 * reads and DBLK_CFGB bit 9 (NV12 write); compressed (abi-vp9.md 7) =
+	 * bit 8, bit 9 only with the double write, the SAO-MMU VH0/VH1 buffer.
+	 * HEVC_DBLK_CFGB[5:4] (deblocker pipeline mode) is the firmware's, per
+	 * frame from the record width.
+	 */
+	cfgb = o->soc == OVP9_SOC_SM1 ? 0xfc01 : ((0x54 << 8) | BIT(0));
+	if (nv12)
+		cfgb |= BIT(9);
+	if (fbc)
+		cfgb |= BIT(8);
+	else
+		meson_amvdec_write_dos(core, HEVCD_MPP_DECOMP_CTL1, BIT(31));
+	meson_amvdec_write_dos(core, HEVC_DBLK_CFGB, cfgb);
+	v = meson_amvdec_read_dos(core, HEVC_SAO_CTRL1) & ~0x3ff0;
+	meson_amvdec_write_dos(core, HEVC_SAO_CTRL1, v | 0xff0);
+	v = meson_amvdec_read_dos(core, HEVC_SAO_CTRL5) & ~0xff0000;
+	meson_amvdec_write_dos(core, HEVC_SAO_CTRL5, v);
+	v = meson_amvdec_read_dos(core, HEVCD_IPP_AXIIF_CONFIG) & ~0x103f;
+	meson_amvdec_write_dos(core, HEVCD_IPP_AXIIF_CONFIG, v | 0xf);
+	if (fbc) {
+		meson_amvdec_write_dos(core, HEVC_SAO_MMU_VH0_ADDR, o->ws_paddr + OVP9_WS_MMU_VBH);
+		meson_amvdec_write_dos(core, HEVC_SAO_MMU_VH1_ADDR,
+				       o->ws_paddr + OVP9_WS_MMU_VBH + OVP9_MMU_VBH_SIZE / 2);
+	}
+	if (o->soc == OVP9_SOC_SM1)
+		meson_amvdec_write_dos(core, HEVC_DBLK_CFG3,
+				       width * height <= 4096 * 2304 ? 0x404010 : 0x808020);
+	if (fbc) {
+		/*
+		 * The frame's decode head (vp9_host.output_writes(), the
+		 * vendor path's meson_amvdec_codec_hevc_setup_decode_head()):
+		 * 8-bit mem-saving layout, MMU reference reads, body and
+		 * header lengths for this size.
+		 */
+		u32 body = meson_amvdec_amfbc_body_size(width, height, s->cur.ten, 1);
+
+		if (s->cur.ten)
+			meson_amvdec_clear_dos_bits(core, HEVC_SAO_CTRL5, BIT(9));
+		else
+			meson_amvdec_write_dos_bits(core, HEVC_SAO_CTRL5, BIT(9));
+		meson_amvdec_write_dos(core, HEVCD_MPP_DECOMP_CTL1, BIT(4));
+		meson_amvdec_write_dos(core, HEVCD_MPP_DECOMP_CTL2, 0);
+		meson_amvdec_write_dos(core, HEVC_CM_BODY_LENGTH, body);
+		meson_amvdec_write_dos(core, HEVC_CM_HEADER_OFFSET, body);
+		meson_amvdec_write_dos(core, HEVC_CM_HEADER_LENGTH,
+				       meson_amvdec_amfbc_head_size(width, height));
+	}
+
+	/*
+	 * --- stream: frame mode over the driver's buffer.  No ESPARSER
+	 * (DOS_GEN_CTRL0 and CONTROL bit 3 clear: with them the write pointer
+	 * reads back 0 and the core fetches around the ring), reset bits kept,
+	 * endian 6:4 = 7, FIFO_CTL bit 29, fetch on last.
+	 */
+	meson_amvdec_write_dos(core, DOS_GEN_CTRL0, 0);
+	meson_amvdec_write_dos(core, HEVC_STREAM_CONTROL, o->stream_ctl);
+	meson_amvdec_write_dos(core, HEVC_STREAM_START_ADDR, src);
+	meson_amvdec_write_dos(core, HEVC_STREAM_END_ADDR, src + s->fifo_size);
+	meson_amvdec_write_dos(core, HEVC_STREAM_RD_PTR, src);
+	meson_amvdec_write_dos(core, HEVC_STREAM_WR_PTR,
+			       round_down(src + s->bytes + OVP9_FIFO_PAD, OVP9_FIFO_ALIGN));
+	meson_amvdec_write_dos(core, HEVC_STREAM_CONTROL, o->stream_ctl | (7 << 4));
+	meson_amvdec_write_dos_bits(core, HEVC_STREAM_FIFO_CTL, BIT(29));
+	meson_amvdec_write_dos(core, HEVC_STREAM_CONTROL, o->stream_ctl | (7 << 4) | BIT(0));
+
+	/* --- command */
+	meson_amvdec_write_dos(core, HEVC_ASSIST_MBOX1_CLR_REG, 1);
+	meson_amvdec_write_dos(core, HEVC_ASSIST_MBOX1_MASK, 1);
+	meson_amvdec_write_dos(core, HEVC_ASSIST_SCRATCH_K, 0);
+	meson_amvdec_write_dos(core, HEVC_ASSIST_SCRATCH_L, 0);
+	meson_amvdec_write_dos(core, HEVC_ASSIST_SCRATCH_2, 0);
+	meson_amvdec_write_dos(core, HEVC_ASSIST_SCRATCH_3, 0);
+	meson_amvdec_write_dos(core, HEVC_ASSIST_SCRATCH_1, o->ws_paddr + s->rec_off);
+	meson_amvdec_write_dos(core, HEVC_ASSIST_SCRATCH_0, OVP9_CMD_DECODE);
+
+	/* The record, the stream and the MV/context buffers before the start. */
+	wmb();
+	s->state = OVP9_SLOT_RUN;
+	o->run = s - o->slot;
+	atomic_set(&o->running, 1);
+	o->deadline = ktime_add_ms(ktime_get(), tmo);
+	mod_delayed_work(system_dfl_wq, &o->timeout, msecs_to_jiffies(tmo) + 1);
+	o->t_kick = ktime_get();
+	if (vp9_bench) {
+		if (o->t_done)
+			ovp9_acc_add(&o->gap, ktime_us_delta(o->t_kick, o->t_done));
+		ovp9_acc_add(&o->rst, ktime_us_delta(o->t_rst, o->t_kick0));
+		ovp9_acc_add(&o->prog, ktime_us_delta(o->t_kick, o->t_rst));
+	}
+	meson_amvdec_hevc_fw_start(core);
+	if (vp9_bench && vp9_bench_startup_us)
+		codec_vp9_open_bench_startup(core, o);
+	return 0;
+}
+
+static int codec_vp9_open_mv(struct amvdec_session *sess, struct codec_vp9_open *o, u32 sbs)
+{
+	struct device *dev = sess->core->dev;
+	size_t need = PAGE_ALIGN((size_t)sbs * OVP9_MV_UNIT);
+	int i;
+
+	if (o->mv_size >= need)
+		return 0;
+	/* at session start or a larger picture: no MVs to carry over */
+	codec_vp9_open_free_mv(dev, o);
+	o->st.last_valid = false;
+	for (i = 0; i < 2; i++) {
+		o->mv_vaddr[i] = dma_alloc_coherent(dev, need, &o->mv_paddr[i], GFP_KERNEL);
+		if (!o->mv_vaddr[i]) {
+			codec_vp9_open_free_mv(dev, o);
+			return -ENOMEM;
+		}
+	}
+	o->mv_size = need;
+	return 0;
+}
+
+static int codec_vp9_open_fifo(struct amvdec_session *sess, struct codec_vp9_open_slot *s,
+			       u32 len)
+{
+	struct device *dev = sess->core->dev;
+	size_t need = ALIGN(OVP9_AMLV_LEN + len + OVP9_FIFO_PAD + OVP9_FIFO_SLACK, SZ_64K);
+
+	if (s->fifo_vaddr && s->fifo_size >= need)
+		return 0;
+	if (s->fifo_vaddr)
+		dma_free_coherent(dev, s->fifo_size, s->fifo_vaddr, s->fifo_paddr);
+	s->fifo_size = 0;
+	s->fifo_vaddr = dma_alloc_coherent(dev, need, &s->fifo_paddr, GFP_KERNEL);
+	if (!s->fifo_vaddr)
+		return -ENOMEM;
+	s->fifo_size = need;
+	return 0;
+}
+
+/* FBC header of a CAPTURE buffer: the AM21C plane, else the private one (downsample mode). */
+static dma_addr_t codec_vp9_open_fbc_head(struct amvdec_session *sess, struct codec_vp9 *vp9,
+					  struct vb2_buffer *vb)
+{
+	if (sess->pixfmt_cap == V4L2_PIX_FMT_AM21C)
+		return vb->num_planes ? vb2_dma_contig_plane_dma_addr(vb, 0) : 0;
+	return vb->index < MAX_REF_PIC_NUM ? vp9->common.mmu_header_paddr[vb->index] : 0;
+}
+
+/*
+ * Pipeline: wait until nothing is prepared or running (the threaded ISR
+ * starts and completes them), for what must not happen under a running frame:
+ * MV buffer reallocation, the vendor buffer setup that programmes the core's
+ * ANC2AXI table.  Called and returns with vp9->lock held; false if the
+ * pipeline did not empty or the session is stopping.
+ */
+static bool codec_vp9_open_quiesce(struct codec_vp9 *vp9, struct codec_vp9_open *o)
+{
+	unsigned long end = jiffies + msecs_to_jiffies(OVP9_PIPE_DRAIN_MS);
+
+	lockdep_assert_held(&vp9->lock);
+	if (!o->pipe)
+		return !atomic_read(&o->running);
+	for (;;) {
+		if (o->halt)
+			break;
+		/*
+		 * A READY frame the threaded ISR left for the worker (a stop was
+		 * pending): the worker is here, so start it here.
+		 */
+		codec_vp9_open_pipe_kick(o->sess, o);
+		if (o->halt)
+			break;
+		if (o->run < 0)
+			return true;
+		if (time_after(jiffies, end))
+			break;
+		mutex_unlock(&vp9->lock);
+		wait_event_timeout(o->wq, READ_ONCE(o->halt) || READ_ONCE(o->run) < 0,
+				   msecs_to_jiffies(OVP9_PIPE_DRAIN_MS));
+		mutex_lock(&vp9->lock);
+	}
+	dev_err_ratelimited(o->sess->core->dev_dec, "VP9 open fw: pipeline did not drain\n");
+	return false;
+}
+
+/* Pipeline: no free slot to prepare into (esparser_queue() must wait for a retirement). */
+bool meson_amvdec_codec_vp9_open_busy(struct amvdec_session *sess)
+{
+	struct codec_vp9 *vp9 = sess->priv;
+	struct codec_vp9_open *o;
+	bool busy = false;
+
+	if (!vp9 || sess->fmt_out->pixfmt != V4L2_PIX_FMT_VP9_FRAME)
+		return false;
+	mutex_lock(&vp9->lock);
+	o = vp9->open;
+	if (o && o->pipe)
+		busy = !codec_vp9_open_find(o, OVP9_SLOT_FREE);
+	mutex_unlock(&vp9->lock);
+	return busy;
+}
+
+/* Complete a pipeline slot's buffers (a copy: the slot itself is FREE again). */
+static void codec_vp9_open_retire_slot(struct amvdec_session *sess,
+				       struct codec_vp9_open_slot *s, bool cancel)
+{
+	meson_amvdec_request_complete(sess, s->src, s->dst, s->ts, cancel || !s->ok);
+}
+
+/*
+ * Worker (esparser_queue_all_src(), sess->lock): return the buffers of every
+ * DONE frame in decode order, then start a READY one the threaded ISR left
+ * alone (a stop was pending when it ran).
+ */
+void meson_amvdec_codec_vp9_open_retire(struct amvdec_session *sess)
+{
+	struct codec_vp9 *vp9 = sess->priv;
+	struct codec_vp9_open_slot *s, tmp;
+	struct codec_vp9_open *o;
+	u32 i;
+
+	if (!vp9 || sess->fmt_out->pixfmt != V4L2_PIX_FMT_VP9_FRAME)
+		return;
+	for (;;) {
+		mutex_lock(&vp9->lock);
+		o = vp9->open;
+		if (!o || !o->pipe) {
+			mutex_unlock(&vp9->lock);
+			return;
+		}
+		/* the oldest frame holding buffers, if it is DONE */
+		s = NULL;
+		for (i = 0; i < OVP9_SLOTS; i++)
+			if (o->slot[i].state != OVP9_SLOT_FREE &&
+			    (!s || (s32)(o->slot[i].seq - s->seq) < 0))
+				s = &o->slot[i];
+		if (!s || s->state != OVP9_SLOT_DONE)
+			break;
+		tmp = *s;
+		s->src = NULL;
+		s->dst = NULL;
+		s->state = OVP9_SLOT_FREE;
+		mutex_unlock(&vp9->lock);
+		codec_vp9_open_retire_slot(sess, &tmp, false);
+	}
+	codec_vp9_open_pipe_kick(sess, o);
+	mutex_unlock(&vp9->lock);
+}
+
+static const char * const ovp9_why_str[] = {
+	[OVP9_OK] = "ok",
+	[OVP9_BAD_FORMAT] = "not 8-bit profile 0 or 10-bit profile 2 (compressed references) up to 4096x2304",
+	[OVP9_BAD_FRAME] = "not a decodable frame (marker, show_existing_frame, header sizes, intra-only header)",
+	[OVP9_BAD_TILES] = "tile layout",
+	[OVP9_BAD_REF] = "reference not decoded in this session (in this output mode) or not scalable",
+};
+
+/*
+ * Decode the frame of @vb (the request job's OUTPUT buffer) into the job's
+ * CAPTURE buffer with the references the job resolved.  Errors before the
+ * kick leave both buffers to the caller.  Serial: after the kick, completion
+ * comes from the ISR or the timeout.  Pipeline: the frame is prepared into a
+ * free slot, takes the job's buffers and credit, the job ends (the next
+ * request is prepared at once) and the frame starts now if the core is idle,
+ * else from the completion interrupt of the one before it.
+ */
+int meson_amvdec_codec_vp9_open_feed(struct amvdec_session *sess,
+				     struct vb2_buffer *vb,
+				     const struct v4l2_ctrl_vp9_frame *fr)
+{
+	struct codec_vp9 *vp9 = sess->priv;
+	struct amvdec_core *core = sess->core;
+	struct device *dev = core->dev_dec;
+	const u64 ref_ts[3] = { fr->last_frame_ts, fr->golden_frame_ts, fr->alt_frame_ts };
+	u32 w = fr->frame_width_minus_1 + 1, h = fr->frame_height_minus_1 + 1;
+	u32 out_size = meson_amvdec_get_output_size(sess);
+	u32 payload = vb2_get_plane_payload(vb, 0);
+	struct codec_vp9_open_in in = { .fr = fr };
+	struct codec_vp9_open_slot *s;
+	struct codec_vp9_open_cur c;
+	struct codec_vp9_open *o;
+	enum ovp9_why why;
+	struct vb2_buffer *dst;
+	ktime_t t_feed = vp9_bench ? ktime_get() : 0;
+	bool ten = fr->bit_depth == 10;
+	int mode;
+	u32 i;
+	u8 *p;
+	int ret;
+
+	if (!vp9 || !sess->request_job.dst)
+		return -EINVAL;
+	dst = &sess->request_job.dst->vb2_buf;
+	in.data = vb2_plane_vaddr(vb, 0);
+
+	mutex_lock(&vp9->lock);
+	o = vp9->open;
+	ret = -EBUSY;
+	if (!o || o->halt || (!o->pipe && atomic_read(&o->running)))
+		goto out;
+	s = o->pipe ? codec_vp9_open_find(o, OVP9_SLOT_FREE) :
+		      o->slot[0].state == OVP9_SLOT_FREE ? &o->slot[0] : NULL;
+	if (!s)
+		goto out;
+	if (vp9_bench) {
+		/* serial: the worker's share of done->kick (retire, next job, controls) */
+		if (!o->pipe && o->t_cpl && !atomic_read(&o->running))
+			ovp9_acc_add(&o->sched, ktime_us_delta(t_feed, o->t_cpl));
+		o->t_feed = t_feed;
+	}
+
+	/*
+	 * --- output (abi-vp9.md 7): 8-bit into NV12M as before; 10-bit into
+	 * NV12M = compressed references in driver-private headers and bodies
+	 * plus the 8-bit double write; AM21C (any depth) = compressed only.
+	 */
+	if (sess->pixfmt_cap == V4L2_PIX_FMT_AM21C)
+		mode = OVP9_OUT_FBC;
+	else if (sess->pixfmt_cap == V4L2_PIX_FMT_NV12M)
+		mode = ten || o->fbc8 ? OVP9_OUT_FBC_NV12 : OVP9_OUT_NV12;
+	else
+		mode = -1;
+	in.mode = mode;
+
+	/* --- buffers: CAPTURE of the negotiated size and format, one frame of input */
+	ret = -EINVAL;
+	if (mode < 0 || w != sess->width || h != sess->height ||
+	    (mode != OVP9_OUT_NV12 && dst->index >= MAX_REF_PIC_NUM) ||
+	    (mode != OVP9_OUT_FBC &&
+	     (dst->num_planes < 2 || vb2_plane_size(dst, 0) < out_size ||
+	      vb2_plane_size(dst, 1) < out_size / 2)) ||
+	    (mode == OVP9_OUT_FBC &&
+	     (dst->num_planes < 1 || vb2_plane_size(dst, 0) < AM21C_HEADER_SIZE))) {
+		dev_err_ratelimited(dev,
+				    "VP9 open fw: %ux%u %u-bit into CAPTURE %u (%ux%u, format %p4cc) not possible\n",
+				    w, h, fr->bit_depth, dst->index, sess->width, sess->height,
+				    &sess->pixfmt_cap);
+		goto out;
+	}
+	/* the FBC buffers are sized for the session depth (esparser: fixed per session) */
+	if (mode != OVP9_OUT_NV12 && sess->bitdepth != fr->bit_depth) {
+		dev_err_ratelimited(dev, "VP9 open fw: %u-bit frame in a %u-bit session\n",
+				    fr->bit_depth, sess->bitdepth);
+		ret = -EOPNOTSUPP;
+		goto out;
+	}
+	if (!in.data || !payload || ovp9_frame_len(in.data, payload, &in.len)) {
+		dev_err_ratelimited(dev, "VP9 open fw: empty buffer or superframe in one request\n");
+		goto out;
+	}
+	in.ts = sess->request_job.timestamp;
+	in.dst_idx = dst->index;
+	if (mode != OVP9_OUT_FBC) {
+		in.dst_y = vb2_dma_contig_plane_dma_addr(dst, 0);
+		in.dst_uv = vb2_dma_contig_plane_dma_addr(dst, 1);
+	}
+	if (mode != OVP9_OUT_NV12) {
+		/*
+		 * The destination's header and body (AM21C: the body is grown on
+		 * the CAPTURE memory and held by the codec until it stops;
+		 * NV12M: the downsample-mode private header and body).  Setup
+		 * also writes the vendor ANC2AXI table: harmless on an idle
+		 * core that is reset before the frame, so a pipeline first lets
+		 * the frames in flight finish.
+		 */
+		ret = -EBUSY;
+		if (o->pipe &&
+		    !meson_amvdec_codec_hevc_frame_buffer_ready(sess, &vp9->common, dst, ten) &&
+		    !codec_vp9_open_quiesce(vp9, o))
+			goto out;
+		ret = meson_amvdec_codec_hevc_ensure_frame_buffer(sess, &vp9->common, dst, ten);
+		if (ret)
+			goto out;
+		ret = -EINVAL;
+		in.fbc_head = codec_vp9_open_fbc_head(sess, vp9, dst);
+		in.fbc_body = meson_amvdec_codec_hevc_fbc_body_addr(sess, &vp9->common, dst);
+		if (!in.fbc_head || !in.fbc_body) {
+			dev_err_ratelimited(dev, "VP9 open fw: CAPTURE %u has no FBC header/body\n",
+					    dst->index);
+			goto out;
+		}
+	}
+	for (i = 0; i < 3; i++) {
+		struct vb2_buffer *ref = sess->request_job.refs[i];
+
+		in.ref_idx[i] = U32_MAX;
+		if (fr->flags & (V4L2_VP9_FRAME_FLAG_KEY_FRAME | V4L2_VP9_FRAME_FLAG_INTRA_ONLY))
+			continue;
+		/* the job resolved them by timestamp; the state checks what they hold */
+		if (!ref || sess->request_job.ref_ts[i] != ref_ts[i])
+			continue;
+		if (mode == OVP9_OUT_NV12) {
+			if (ref->num_planes < 2)
+				continue;
+			in.ref_y[i] = vb2_dma_contig_plane_dma_addr(ref, 0);
+			in.ref_uv[i] = vb2_dma_contig_plane_dma_addr(ref, 1);
+		} else {
+			/* compressed reference: its FBC header in both words */
+			in.ref_y[i] = codec_vp9_open_fbc_head(sess, vp9, ref);
+			in.ref_uv[i] = in.ref_y[i];
+			if (!in.ref_y[i])
+				continue;
+		}
+		in.ref_idx[i] = ref->index;
+	}
+	in.soc = o->soc;
+	in.out_size = out_size;
+	in.ws = o->ws_paddr;
+
+	why = ovp9_check(&o->st, &in, o->rec);
+	if (why != OVP9_OK) {
+		dev_err_ratelimited(dev, "VP9 open fw: frame refused: %s (%ux%u, flags %#x, first byte %#04x)\n",
+				    ovp9_why_str[why], w, h, fr->flags, in.data[0]);
+		ret = why == OVP9_BAD_FORMAT ? -EOPNOTSUPP : -EINVAL;
+		goto out;
+	}
+
+	/*
+	 * --- buffers that must fit this picture (the MV buffers are shared by
+	 * the frames in flight: reallocated on an idle pipeline only)
+	 */
+	ret = -EBUSY;
+	if (o->pipe && o->mv_size < PAGE_ALIGN((size_t)DIV_ROUND_UP(w, 64) *
+					       DIV_ROUND_UP(h, 64) * OVP9_MV_UNIT) &&
+	    !codec_vp9_open_quiesce(vp9, o))
+		goto out;
+	ret = codec_vp9_open_mv(sess, o, DIV_ROUND_UP(w, 64) * DIV_ROUND_UP(h, 64));
+	if (!ret)
+		ret = codec_vp9_open_fifo(sess, s, in.len);
+	if (ret)
+		goto out;
+	in.mv[0] = o->mv_paddr[0];
+	in.mv[1] = o->mv_paddr[1];
+
+	/*
+	 * --- compressed output: the SAO-MMU map lists this frame's body pages
+	 * (the map DMA reads it at the first tile; NV12 leaves it zeroed)
+	 */
+	if (mode != OVP9_OUT_NV12) {
+		ret = meson_amvdec_codec_hevc_fill_mmu_map_at(sess, &vp9->common, dst, ten,
+							      (u32 *)(o->ws + s->map_off));
+		if (ret) {
+			dev_err_ratelimited(dev, "VP9 open fw: SAO-MMU map of CAPTURE %u failed (%d)\n",
+					    dst->index, ret);
+			goto out;
+		}
+	}
+
+	/* --- state and record; nothing fails from here up to the kick */
+	s->prev_kf = o->st.last_was_key;
+	ovp9_build(&o->st, &in, &c, o->rec);
+	if (s->map_off != OVP9_WS_MMU_MAP)
+		ovp9_put32(o->rec, OVP9_W_MMU_MAP, o->ws_paddr + s->map_off);
+	ovp9_write_record((u16 *)(o->ws + s->rec_off), o->rec);
+
+	/* --- the stream: AMLV envelope, the frame as coded, zeros */
+	p = s->fifo_vaddr;
+	put_unaligned_be32(in.len + 4, p);
+	put_unaligned_be32(~(in.len + 4), p + 4);
+	p[8] = 0;
+	p[9] = 0;
+	p[10] = 0;
+	p[11] = 1;
+	memcpy(p + 12, "AMLV", 4);
+	memcpy(p + OVP9_AMLV_LEN, in.data, in.len);
+	/* only what the fetch can reach: the buffer may be sized for a far larger frame */
+	memset(p + OVP9_AMLV_LEN + in.len, 0,
+	       min_t(size_t, s->fifo_size - OVP9_AMLV_LEN - in.len,
+		     OVP9_FIFO_PAD + OVP9_FIFO_SLACK));
+
+	s->cur = c;
+	s->bytes = OVP9_AMLV_LEN + in.len;
+	s->dst = sess->request_job.dst;
+	dev_dbg(dev,
+		"vp9 open fw: %s %ux%u %s show=%u buf=%u ctx=%u%s%s prevmv=%u mv=%u seg=%#x tiles=%ux%u uh=%u ch=%u bytes=%u slot=%td\n",
+		c.key ? "key" : c.intra_only ? "intra" : "inter", w, h,
+		mode == OVP9_OUT_NV12 ? "nv12" : mode == OVP9_OUT_FBC ? "fbc" : "fbc+nv12",
+		c.show, c.dst_idx,
+		c.ctx, c.init ? "i" : "", c.adapt ? " adapt" : "",
+		!!(o->rec[OVP9_W_FLAGS] & OVP9_F_PREV_MVS), c.mv, o->rec[OVP9_W_SEG],
+		1 << fr->tile_cols_log2, 1 << fr->tile_rows_log2,
+		fr->uncompressed_header_size, fr->compressed_header_size, in.len, s - o->slot);
+	if (vp9_bench)
+		ovp9_acc_add(&o->feed, ktime_us_delta(ktime_get(), t_feed));
+
+	if (o->pipe) {
+		/*
+		 * --- commit: the frame is assumed to succeed (the next one is
+		 * built on its state), takes the job's buffers and credit
+		 */
+		ovp9_done(&o->st, &c);
+		s->src = sess->request_job.src;
+		s->ts = sess->request_job.timestamp;
+		s->ok = true;
+		s->seq = o->seq++;
+		s->state = OVP9_SLOT_READY;
+		codec_vp9_open_pipe_kick(sess, o);
+		mutex_unlock(&vp9->lock);
+		meson_amvdec_request_detach(sess);
+		return 0;
+	}
+
+	ret = codec_vp9_open_kick(sess, o, s);
+	if (ret) {
+		s->dst = NULL;
+		ovp9_invalidate(&o->st, c.dst_idx);
+		o->need_reload = true;
+		mutex_unlock(&vp9->lock);
+		/* the core did not quiesce: nothing more can run on it */
+		meson_amvdec_abort(sess);
+		return ret;
+	}
+out:
+	mutex_unlock(&vp9->lock);
+	return ret;
+}
+
+/*
+ * None of the vendor image's workspace, MV buffers or session registers: the
+ * core is reset and programmed before every frame (codec_vp9_open_kick()).
+ */
+static int codec_vp9_start(struct amvdec_session *sess)
+{
+	struct codec_vp9 *vp9;
+	int ret;
+
+	vp9 = kzalloc_obj(*vp9);
+	if (!vp9)
+		return -ENOMEM;
+
+	mutex_init(&vp9->lock);
+	ret = codec_vp9_open_start(sess, vp9);
+	if (ret) {
+		mutex_destroy(&vp9->lock);
+		kfree(vp9);
+		return ret;
+	}
+	sess->priv = vp9;
+	return 0;
+}
+
+static int codec_vp9_stop(struct amvdec_session *sess)
+{
+	struct codec_vp9 *vp9 = sess->priv;
+
+	/* Before vp9->lock: the timeout work takes it. */
+	if (vp9->open)
+		codec_vp9_open_stop(sess, vp9);
+
+	/*
+	 * The core is halted and quiesced: private FBC headers and bodies go
+	 * back, the codec's references on AM21C CAPTURE memory are dropped.
+	 */
+	mutex_lock(&vp9->lock);
+	meson_amvdec_codec_hevc_free_fbc_buffers(sess, &vp9->common);
+	mutex_unlock(&vp9->lock);
+	mutex_destroy(&vp9->lock);
+
+	return 0;
+}
+
+static irqreturn_t codec_vp9_threaded_isr(struct amvdec_session *sess)
+{
+	if (!sess->priv)
+		return IRQ_HANDLED;
+	return codec_vp9_open_threaded_isr(sess);
+}
+
+static irqreturn_t codec_vp9_isr(struct amvdec_session *sess)
+{
+#ifdef AMVDEC_OUCODE_DEV
+	/* vp9_bench: interrupt -> threaded handler latency */
+	if (vp9_bench)
+		WRITE_ONCE(sess->vp9_isr_ns, ktime_get_ns());
+#endif
+	meson_amvdec_hevc_dbg_dump(sess, "irq");
+	return IRQ_WAKE_THREAD;
+}
+
+struct amvdec_codec_ops meson_amvdec_codec_vp9_ops = {
+	.start = codec_vp9_start,
+	.stop = codec_vp9_stop,
+	.isr = codec_vp9_isr,
+	.threaded_isr = codec_vp9_threaded_isr,
+};
diff --speed-large-files --no-dereference --minimal -Naur linux-7.2.8/drivers/media/platform/amlogic/amvdec/codec_vp9.h linux-7.2.8/drivers/media/platform/amlogic/amvdec/codec_vp9.h
--- linux-7.2.8/drivers/media/platform/amlogic/amvdec/codec_vp9.h	1970-01-01 01:00:00.000000000 +0100
+++ linux-7.2.8/drivers/media/platform/amlogic/amvdec/codec_vp9.h	2026-10-02 08:55:53.000000000 +0200
@@ -0,0 +1,23 @@
+/* SPDX-License-Identifier: GPL-2.0+ */
+/*
+ * Copyright (C) 2018 Maxime Jourdan <maxi.jourdan@wanadoo.fr>
+ * Copyright (C) 2026 Christian Hewitt <christianshewitt@gmail.com>
+ *
+ * VP9 request decoding with the open firmware (ovp9-sl).
+ */
+
+#ifndef __MESON_AMVDEC_CODEC_VP9_H_
+#define __MESON_AMVDEC_CODEC_VP9_H_
+
+#include "amvdec.h"
+
+extern struct amvdec_codec_ops meson_amvdec_codec_vp9_ops;
+
+bool meson_amvdec_codec_vp9_open_busy(struct amvdec_session *sess);
+void meson_amvdec_codec_vp9_open_retire(struct amvdec_session *sess);
+void meson_amvdec_codec_vp9_open_discard(struct amvdec_session *sess);
+int meson_amvdec_codec_vp9_open_feed(struct amvdec_session *sess,
+				     struct vb2_buffer *vb,
+				     const struct v4l2_ctrl_vp9_frame *frame);
+
+#endif
diff --speed-large-files --no-dereference --minimal -Naur linux-7.2.8/drivers/media/platform/amlogic/amvdec/codec_vp9_open_rec.h linux-7.2.8/drivers/media/platform/amlogic/amvdec/codec_vp9_open_rec.h
--- linux-7.2.8/drivers/media/platform/amlogic/amvdec/codec_vp9_open_rec.h	1970-01-01 01:00:00.000000000 +0100
+++ linux-7.2.8/drivers/media/platform/amlogic/amvdec/codec_vp9_open_rec.h	2026-10-02 08:55:53.000000000 +0200
@@ -0,0 +1,623 @@
+/* SPDX-License-Identifier: GPL-2.0+ */
+/*
+ * Open VP9 firmware (ovp9-sl): the host half of the record ABI v1
+ * (abi-vp9.md; section 7: profile 2 / compressed output), as pure
+ * functions over the V4L2 VP9_FRAME control and the
+ * decoder state carried between frames.  No kernel dependencies beyond the
+ * basic types and helpers, so the same code runs in the userspace
+ * equivalence check against the Python stand-in vp9_host.py
+ * (tools: ovp9_rec_test.c + ovp9_rec_gen.py).
+ *
+ * Included by codec_vp9.c only.
+ */
+#ifndef __MESON_AMVDEC_CODEC_VP9_OPEN_REC_H_
+#define __MESON_AMVDEC_CODEC_VP9_OPEN_REC_H_
+
+#define OVP9_MAGIC		0x5639		/* 'V9' */
+#define OVP9_VERSION		1
+#define OVP9_REC_WORDS		280
+#define OVP9_SOC_G12A		3		/* G12A, G12B */
+#define OVP9_SOC_SM1		4
+
+/* record word indices (abi-vp9.md section 4, vp9_host.py W_*) */
+#define OVP9_W_MAGIC		0
+#define OVP9_W_VERSION		1
+#define OVP9_W_SOC		2
+#define OVP9_W_FLAGS		3
+#define OVP9_W_FMT		4
+#define OVP9_W_WIDTH		5
+#define OVP9_W_HEIGHT		6
+#define OVP9_W_TILES		7
+#define OVP9_W_UHSIZE		8
+#define OVP9_W_CHSIZE		9
+#define OVP9_W_CTX		10
+#define OVP9_W_BASEQ		11
+#define OVP9_W_DQ0		12
+#define OVP9_W_DQ1		13
+#define OVP9_W_LF		14
+#define OVP9_W_REFD01		15
+#define OVP9_W_REFD23		16
+#define OVP9_W_MODED		17
+#define OVP9_W_SEG		18
+#define OVP9_W_SEGP		19
+#define OVP9_W_SEGF		24
+#define OVP9_W_REF		42
+#define OVP9_REF_WORDS		12
+#define OVP9_W_SCALE		78
+#define OVP9_W_OUT_Y		80
+#define OVP9_W_OUT_UV		82
+#define OVP9_W_OUT_YLEN		84
+#define OVP9_W_FBC_BODY		86
+#define OVP9_W_FBC_HEAD		88
+#define OVP9_W_MV_WR		90
+#define OVP9_W_MV_RD		92
+#define OVP9_W_IPP		94
+#define OVP9_W_DBLK_PARA	96
+#define OVP9_W_DBLK_DATA	98
+#define OVP9_W_MPRED_ABV	100
+#define OVP9_W_PROB		102
+#define OVP9_W_COUNT		104
+#define OVP9_W_SEGMAP		106
+#define OVP9_W_MMU_MAP		108
+#define OVP9_W_DEBUG		110
+#define OVP9_W_TCOL		128
+#define OVP9_W_TROW		145
+#define OVP9_W_TSIZE		152
+
+/* record word 3 */
+#define OVP9_F_KEY		BIT(0)
+#define OVP9_F_INTRA_ONLY	BIT(1)
+#define OVP9_F_ER		BIT(2)
+#define OVP9_F_SHOW		BIT(3)
+#define OVP9_F_REFRESH_CTX	BIT(4)
+#define OVP9_F_PARALLEL		BIT(5)
+#define OVP9_F_HP		BIT(6)
+#define OVP9_F_LOSSLESS		BIT(7)
+#define OVP9_F_PREV_MVS		BIT(8)
+#define OVP9_F_LF_DELTA		BIT(9)
+#define OVP9_F_OUT_NV12		BIT(10)
+#define OVP9_F_OUT_FBC		BIT(11)
+
+/*
+ * Workspace (abi-vp9.md section 2; the offsets of vp9_host.Layout from its
+ * workspace base).  Sized for the ABI maximum, 64 x 36 superblocks =
+ * 4096x2304: the segment map is 24 bytes per superblock.
+ */
+#define OVP9_WS_IPP		0x000000	/* IPP line buffer, 0x4000 */
+#define OVP9_WS_DBLK_PARA	0x004000	/* deblock parameters, 0x80000, zeroed once */
+#define OVP9_WS_DBLK_DATA	0x084000	/* deblock data, 0x80000 */
+#define OVP9_WS_MPRED_ABV	0x104000	/* MPRED above MV line, 0x10000 */
+#define OVP9_WS_PROB		0x114000	/* 4 context slots + this frame's table */
+#define OVP9_WS_COUNT		0x119000	/* count buffer, 0x3000 */
+#define OVP9_WS_SEGMAP		0x11c000	/* segment map, 0xd800, persistent */
+#define OVP9_WS_MMU_MAP		0x12a000	/* read by the SAO map DMA even for NV12, 0x8000 */
+#define OVP9_WS_RECORD		0x132000	/* parameter record, 560 of 0x1000 bytes */
+#define OVP9_WS_MMU_VBH		0x133000	/* SAO-MMU VH0/VH1, compressed output only */
+#define OVP9_WS_SIZE		0x138000
+#define OVP9_MMU_VBH_SIZE	0x5000
+#define OVP9_PROB_SLOT		0x1000
+#define OVP9_PROB_CUR		0x4000
+#define OVP9_SEGMAP_BYTES	0xd800
+#define OVP9_SB_SEGMAP		24
+#define OVP9_MV_UNIT		0x240		/* MV buffer bytes per 64x64 superblock */
+#define OVP9_MAX_SB_COLS	64
+#define OVP9_MAX_SB_ROWS	64
+#define OVP9_MAX_TILE_COLS	16
+#define OVP9_MAX_TILE_ROWS	4
+#define OVP9_AMLV_LEN		16
+
+#define OVP9_MAX_BUFS		64		/* CAPTURE vb2 indices tracked */
+
+/*
+ * Output of a frame (abi-vp9.md 7).  10-bit decodes into compressed (FBC)
+ * references; NV12M CAPTURE then gets the 8-bit double write, AM21C CAPTURE
+ * (any depth) the compressed frame only.
+ */
+enum ovp9_out {
+	OVP9_OUT_NV12,		/* 8-bit into NV12M */
+	OVP9_OUT_FBC_NV12,	/* 10-bit into NV12M: private FBC references + double write */
+	OVP9_OUT_FBC,		/* AM21C: compressed only */
+};
+
+/* refusal reasons (ovp9_check()) */
+enum ovp9_why {
+	OVP9_OK,
+	OVP9_BAD_FORMAT,	/* not 8-bit profile 0 / 10-bit profile 2 (FBC) / too large */
+	OVP9_BAD_FRAME,		/* marker, show_existing, header sizes */
+	OVP9_BAD_TILES,
+	OVP9_BAD_REF,		/* reference not decoded here, or none within the scaling limits */
+};
+
+struct codec_vp9_open_buf {
+	u64 ts;			/* timestamp the picture was decoded with */
+	u16 w, h;
+	bool valid;		/* decoded by this session, usable as a reference */
+	u8 mode;		/* enum ovp9_out it was decoded in */
+	bool ten;		/* 10-bit */
+};
+
+/* The decoder state carried between frames (vp9_host.HostVP9). */
+struct codec_vp9_open_state {
+	struct codec_vp9_open_buf buf[OVP9_MAX_BUFS];
+	bool ctx_valid[4];
+	bool segmap_valid;
+	bool last_valid;		/* previous decoded frame (its MVs, size, type) */
+	u16 last_w, last_h;
+	u8 last_mv;
+	bool last_show, last_intra_only, last_key;
+	bool last_was_key;
+	bool seg_abs;			/* abs_or_delta_update in force (spec: reset by setup_past_independence) */
+};
+
+/* What the frame in flight needs at completion (vp9_host.complete()). */
+struct codec_vp9_open_cur {
+	u32 dst_idx;
+	u64 ts;
+	u16 w, h;
+	u8 ctx, mv;
+	bool key, intra, intra_only, show, adapt, seg_map, init;
+	u8 mode;		/* enum ovp9_out */
+	bool ten;
+	u32 sbs;
+};
+
+/* One frame as the driver hands it over: controls, bytes, buffers. */
+struct codec_vp9_open_in {
+	const struct v4l2_ctrl_vp9_frame *fr;
+	const u8 *data;
+	u32 len;			/* frame bytes, superframe index stripped */
+	u64 ts;				/* this request's timestamp */
+	u32 dst_idx, dst_y, dst_uv;		/* NV12 planes (not with OVP9_OUT_FBC) */
+	u32 fbc_head, fbc_body;			/* compressed output: header, body */
+	/* inter frames: NV12 planes, or with compressed output the FBC header in both */
+	u32 ref_idx[3], ref_y[3], ref_uv[3];
+	u32 mode;				/* enum ovp9_out */
+	u32 soc, out_size, ws, mv[2];
+	/* intra-only frames, from the bitstream (ovp9_check()) */
+	u8 io_reset, io_ctx;
+};
+
+static inline void ovp9_put32(u16 *w, u32 i, u32 v)
+{
+	w[i] = v & 0xffff;
+	w[i + 1] = v >> 16;
+}
+
+static inline u16 ovp9_s8(s8 a, s8 b)
+{
+	return (u8)a | ((u8)b << 8);
+}
+
+/* The record in DDR: the four halfwords of every 8-byte group reversed (LMEM DMA order). */
+static inline void ovp9_write_record(u16 *dst, const u16 *w)
+{
+	int i;
+
+	for (i = 0; i < OVP9_REC_WORDS; i += 4) {
+		dst[i + 0] = w[i + 3];
+		dst[i + 1] = w[i + 2];
+		dst[i + 2] = w[i + 1];
+		dst[i + 3] = w[i + 0];
+	}
+}
+
+/*
+ * A superframe index (Annex B) at the end: V4L2 VP9_FRAME carries one frame
+ * per request, so accept it only around a single frame and strip it.
+ */
+static inline int ovp9_frame_len(const u8 *d, u32 len, u32 *frame_len)
+{
+	u8 m = d[len - 1];
+	u32 nf, sz, idx, n, i;
+
+	*frame_len = len;
+	if ((m & 0xe0) != 0xc0)
+		return 0;
+	nf = (m & 7) + 1;
+	sz = ((m >> 3) & 3) + 1;
+	idx = 2 + sz * nf;
+	if (len < idx || d[len - idx] != m)
+		return 0;
+	if (nf != 1)
+		return -1;
+	for (n = 0, i = 0; i < sz; i++)
+		n |= (u32)d[len - idx + 1 + i] << (8 * i);
+	if (!n || n > len - idx)
+		return -1;
+	*frame_len = n;
+	return 0;
+}
+
+/* Tile starts in superblocks and tile sizes (vp9_bits.tile_layout()). */
+static inline int ovp9_tiles(const u8 *d, u32 len, const struct v4l2_ctrl_vp9_frame *fr,
+			     u32 sbc, u32 sbr, u16 *w)
+{
+	u32 tcl = fr->tile_cols_log2, trl = fr->tile_rows_log2;
+	u32 min_log2 = 0, max_log2 = 1;
+	u32 tc, tr, p, r, c, i, n;
+
+	while (((u32)OVP9_MAX_SB_COLS << min_log2) < sbc)
+		min_log2++;
+	while ((sbc >> max_log2) >= 4)
+		max_log2++;
+	max_log2--;
+	if (tcl < min_log2 || tcl > max(min_log2, max_log2) || trl > 2)
+		return -1;
+	tc = 1 << tcl;
+	tr = 1 << trl;
+	if (tc > OVP9_MAX_TILE_COLS || tr > OVP9_MAX_TILE_ROWS)
+		return -1;
+	for (i = 0; i <= tc; i++)
+		w[OVP9_W_TCOL + i] = i == tc ? sbc : min((i * sbc) >> tcl, sbc);
+	for (i = 0; i <= tr; i++)
+		w[OVP9_W_TROW + i] = i == tr ? sbr : min((i * sbr) >> trl, sbr);
+
+	p = fr->uncompressed_header_size + fr->compressed_header_size;
+	i = 0;
+	for (r = 0; r < tr; r++) {
+		for (c = 0; c < tc; c++, i++) {
+			if (r == tr - 1 && c == tc - 1) {
+				n = len - p;
+			} else {
+				if (len - p < 4)
+					return -1;
+				n = get_unaligned_be32(d + p);
+				p += 4;
+			}
+			if (n > len - p)
+				return -1;
+			ovp9_put32(w, OVP9_W_TSIZE + 2 * i, n);
+			p += n;
+		}
+	}
+	return 0;
+}
+
+/*
+ * reset_frame_context and the coded frame_context_idx of a profile-0 or
+ * profile-2 intra-only frame, read from its uncompressed header.  The V4L2 control
+ * cannot be trusted with the index here: FFmpeg reports 0 for key and
+ * intra-only frames (as the decode uses slot 0), but reset_frame_context 2
+ * resets the *coded* slot (spec 7.2 setup_past_independence, libvpx).
+ */
+static inline int ovp9_intra_only_ctx(const u8 *d, u32 len, u8 *reset, u8 *ctx)
+{
+	u32 pos = 0, prof;
+	bool er;
+
+#define OVP9_BITS(n) ({							\
+	u32 _v = 0, _n = (n);						\
+	while (_n--) {							\
+		if (pos >= 8 * len)					\
+			return -1;					\
+		_v = (_v << 1) | ((d[pos >> 3] >> (7 - (pos & 7))) & 1);	\
+		pos++;							\
+	}								\
+	_v; })
+	if (OVP9_BITS(2) != 2)			/* frame_marker */
+		return -1;
+	prof = OVP9_BITS(1);
+	prof |= OVP9_BITS(1) << 1;
+	if (prof != 0 && prof != 2)
+		return -1;
+	/* !show_existing, non-key, hidden */
+	if (OVP9_BITS(3) != ((0 << 2) | (1 << 1) | 0))
+		return -1;
+	er = OVP9_BITS(1);
+	if (!OVP9_BITS(1))			/* intra_only */
+		return -1;
+	*reset = er ? 0 : OVP9_BITS(2);
+	if (OVP9_BITS(24) != 0x498342)		/* frame_sync_code */
+		return -1;
+	if (prof == 2) {			/* color_config(): 4:2:0, never RGB */
+		OVP9_BITS(1);			/* ten_or_twelve_bit */
+		if (OVP9_BITS(3) == 7)		/* color_space CS_RGB */
+			return -1;
+		OVP9_BITS(1);			/* color_range */
+	}
+	OVP9_BITS(8);				/* refresh_frame_flags */
+	OVP9_BITS(32);				/* frame_size */
+	if (OVP9_BITS(1))			/* render_and_frame_size_different */
+		OVP9_BITS(32);
+	if (!er)
+		OVP9_BITS(2);			/* refresh_frame_context, parallel */
+	*ctx = OVP9_BITS(2);
+#undef OVP9_BITS
+	return 0;
+}
+
+/*
+ * Everything that can refuse the frame, before any state changes: format,
+ * frame bytes, tiles (into @r), references (into @r, scale bits).  @r is
+ * cleared here.
+ */
+static inline enum ovp9_why ovp9_check(const struct codec_vp9_open_state *st,
+				       struct codec_vp9_open_in *in, u16 *r)
+{
+	const struct v4l2_ctrl_vp9_frame *fr = in->fr;
+	const u64 ref_ts[3] = { fr->last_frame_ts, fr->golden_frame_ts, fr->alt_frame_ts };
+	u32 w = fr->frame_width_minus_1 + 1, h = fr->frame_height_minus_1 + 1;
+	u32 sbc = (w + 63) >> 6, sbr = (h + 63) >> 6;
+	bool intra = fr->flags & (V4L2_VP9_FRAME_FLAG_KEY_FRAME | V4L2_VP9_FRAME_FLAG_INTRA_ONLY);
+	const struct codec_vp9_open_buf *b[3];
+	bool fbc = in->mode != OVP9_OUT_NV12, ten = fr->bit_depth == 10;
+	u32 i, scale = 0, sub = 3;
+	bool ok[3];
+
+	memset(r, 0, OVP9_REC_WORDS * sizeof(*r));
+	/* 8-bit profile 0 in any mode; 10-bit profile 2 into compressed references only */
+	if (!((fr->profile == 0 && fr->bit_depth == 8) ||
+	      (fr->profile == 2 && fr->bit_depth == 10 && fbc)) ||
+	    in->mode > OVP9_OUT_FBC || sbc > OVP9_MAX_SB_COLS ||
+	    sbr > OVP9_MAX_SB_ROWS || sbc * sbr * OVP9_SB_SEGMAP > OVP9_SEGMAP_BYTES ||
+	    in->dst_idx >= OVP9_MAX_BUFS)
+		return OVP9_BAD_FORMAT;
+	/*
+	 * frame_marker 2, the control's profile (0 or 2), show_existing_frame 0
+	 * (a redisplay is the client's)
+	 */
+	if (!in->len || (in->data[0] >> 6) != 2 ||
+	    (((in->data[0] >> 5) & 1) | ((in->data[0] >> 3) & 2)) != fr->profile ||
+	    (in->data[0] & 0x08) ||
+	    !fr->uncompressed_header_size || !fr->compressed_header_size ||
+	    (u32)fr->uncompressed_header_size + fr->compressed_header_size >= in->len)
+		return OVP9_BAD_FRAME;
+	if (ovp9_tiles(in->data, in->len, fr, sbc, sbr, r))
+		return OVP9_BAD_TILES;
+	if (intra) {
+		if (!(fr->flags & V4L2_VP9_FRAME_FLAG_KEY_FRAME) &&
+		    ovp9_intra_only_ctx(in->data, in->len, &in->io_reset, &in->io_ctx))
+			return OVP9_BAD_FRAME;
+		return OVP9_OK;
+	}
+	for (i = 0; i < 3; i++) {
+		if (in->ref_idx[i] >= OVP9_MAX_BUFS || in->ref_idx[i] == in->dst_idx)
+			return OVP9_BAD_REF;
+		b[i] = &st->buf[in->ref_idx[i]];
+		/* a compressed reference cannot be read as NV12 or at another depth */
+		if (!b[i]->valid || b[i]->ts != ref_ts[i] || (b[i]->mode != OVP9_OUT_NV12) != fbc ||
+		    b[i]->ten != ten)
+			return OVP9_BAD_REF;
+		/* spec 7.2 (libvpx valid_ref_frame_size): at most 2x larger, 16x smaller */
+		ok[i] = 2 * w >= b[i]->w && 2 * h >= b[i]->h &&
+			w <= 16u * b[i]->w && h <= 16u * b[i]->h;
+		if (ok[i] && sub == 3)
+			sub = i;
+	}
+	/*
+	 * An out-of-range reference may be listed (SVC) but no block may use
+	 * it, and its ratio would not fit REFINFO's 16 bits: it gets the first
+	 * valid reference's entry (vp9_host.prepare()).  None valid: refuse.
+	 */
+	if (sub == 3)
+		return OVP9_BAD_REF;
+	for (i = 0; i < 3; i++) {
+		u32 base = OVP9_W_REF + OVP9_REF_WORDS * i, k = ok[i] ? i : sub;
+		const struct codec_vp9_open_buf *bk = b[k];
+
+		/* the reference's own size: its planes are laid out for it */
+		ovp9_put32(r, base, in->ref_y[k]);
+		ovp9_put32(r, base + 2, in->ref_uv[k]);
+		r[base + 4] = bk->w;
+		r[base + 5] = bk->h;
+		r[base + 6] = ((u32)bk->w << 14) / w;
+		r[base + 7] = ((u32)bk->h << 14) / h;
+		/*
+		 * compressed body size (meson_amvdec_amfbc_body_size()): NV12, no
+		 * MMU: 3072 per 64x32; compressed through the SAO-MMU: 4096 10-bit,
+		 * 3200 8-bit
+		 */
+		ovp9_put32(r, base + 8, ((fbc ? (ten ? 4096 : 3200) : 3072) *
+					 ((bk->w + 63) / 64) * ((bk->h + 31) / 32)) >> 5);
+		/* VP9D_MPP_REF_SCALE_ENBL is a per-reference mask (measured) */
+		if (bk->w != w || bk->h != h)
+			scale |= BIT(i);
+	}
+	r[OVP9_W_SCALE] = scale;
+	return OVP9_OK;
+}
+
+/*
+ * vp9_host.prepare() + record() for a frame ovp9_check() accepted: the
+ * context, MV and segment-map rules update @st, the rest of @r is filled and
+ * @c describes the frame for ovp9_done().  Cannot fail.
+ */
+static inline void ovp9_build(struct codec_vp9_open_state *st,
+			      const struct codec_vp9_open_in *in,
+			      struct codec_vp9_open_cur *c, u16 *r)
+{
+	const struct v4l2_ctrl_vp9_frame *fr = in->fr;
+	u32 flags = fr->flags, seg = fr->seg.flags;
+	u32 w = fr->frame_width_minus_1 + 1, h = fr->frame_height_minus_1 + 1;
+	bool er = flags & V4L2_VP9_FRAME_FLAG_ERROR_RESILIENT;
+	bool refresh = flags & V4L2_VP9_FRAME_FLAG_REFRESH_FRAME_CTX;
+	bool parallel = flags & V4L2_VP9_FRAME_FLAG_PARALLEL_DEC_MODE;
+	bool use_prev;
+	u8 tp[7], pp[3];
+	u32 i;
+
+	memset(c, 0, sizeof(*c));
+	c->key = flags & V4L2_VP9_FRAME_FLAG_KEY_FRAME;
+	c->intra_only = !c->key && (flags & V4L2_VP9_FRAME_FLAG_INTRA_ONLY);
+	c->intra = c->key || c->intra_only;
+	c->show = flags & V4L2_VP9_FRAME_FLAG_SHOW_FRAME;
+	c->w = w;
+	c->h = h;
+	c->sbs = ((w + 63) >> 6) * ((h + 63) >> 6);
+	c->dst_idx = in->dst_idx;
+	c->ts = in->ts;
+	c->mode = in->mode;
+	c->ten = fr->bit_depth == 10;
+
+	/*
+	 * contexts: spec 7.2 reset rules (reset_frame_context as coded: 2 the
+	 * coded slot, 3 all); intra-only / error-resilient frames use slot 0
+	 */
+	if (c->key || er || (c->intra_only && in->io_reset == 3))
+		memset(st->ctx_valid, 0, sizeof(st->ctx_valid));
+	else if (c->intra_only && in->io_reset == 2)
+		st->ctx_valid[in->io_ctx & 3] = false;
+	c->ctx = (c->intra || er) ? 0 : fr->frame_context_idx & 3;
+	c->init = !st->ctx_valid[c->ctx];
+	st->ctx_valid[c->ctx] = true;	/* the firmware writes the defaults into it */
+	c->adapt = refresh && !parallel && !er;
+
+	/*
+	 * previous-frame MVs (spec 7.2 UsePrevFrameMvs), never after a key
+	 * frame: measured on silicon, a key frame leaves no usable MV records
+	 * (vp9_host prev_mvs_after_key=False).  MV buffers ping-pong: this
+	 * frame writes the one the previous frame did not.
+	 */
+	use_prev = st->last_valid && !c->intra && !er && st->last_w == w && st->last_h == h &&
+		   st->last_show && !st->last_intra_only && !st->last_key;
+	c->mv = st->last_valid ? !st->last_mv : 0;
+
+	/* previous segment ids: a map written since the last reset, same size */
+	if (c->intra || er || (st->last_valid && (st->last_w != w || st->last_h != h)))
+		st->segmap_valid = false;
+	/*
+	 * FFmpeg leaves temporal_update and abs_or_delta_update stale when
+	 * they are not coded: take them only where the syntax codes them.
+	 */
+	if (!(seg & V4L2_VP9_SEGMENTATION_FLAG_ENABLED))
+		seg = 0;
+	if (!(seg & V4L2_VP9_SEGMENTATION_FLAG_UPDATE_MAP))
+		seg &= ~V4L2_VP9_SEGMENTATION_FLAG_TEMPORAL_UPDATE;
+	if (c->intra || er)
+		st->seg_abs = false;
+	if (seg & V4L2_VP9_SEGMENTATION_FLAG_UPDATE_DATA)
+		st->seg_abs = seg & V4L2_VP9_SEGMENTATION_FLAG_ABS_OR_DELTA_UPDATE;
+	c->seg_map = seg & V4L2_VP9_SEGMENTATION_FLAG_UPDATE_MAP;
+
+	/* this buffer is being overwritten: no longer a reference */
+	st->buf[in->dst_idx].valid = false;
+
+	r[OVP9_W_MAGIC] = OVP9_MAGIC;
+	r[OVP9_W_VERSION] = OVP9_VERSION;
+	r[OVP9_W_SOC] = in->soc;
+	r[OVP9_W_FLAGS] = (c->key ? OVP9_F_KEY : 0) |
+			  (c->intra_only ? OVP9_F_INTRA_ONLY : 0) |
+			  (er ? OVP9_F_ER : 0) |
+			  (c->show ? OVP9_F_SHOW : 0) |
+			  (refresh ? OVP9_F_REFRESH_CTX : 0) |
+			  (parallel ? OVP9_F_PARALLEL : 0) |
+			  (!c->intra && (flags & V4L2_VP9_FRAME_FLAG_ALLOW_HIGH_PREC_MV) ?
+			   OVP9_F_HP : 0) |
+			  (!fr->quant.base_q_idx && !fr->quant.delta_q_y_dc &&
+			   !fr->quant.delta_q_uv_dc && !fr->quant.delta_q_uv_ac ?
+			   OVP9_F_LOSSLESS : 0) |
+			  (use_prev ? OVP9_F_PREV_MVS : 0) |
+			  (fr->lf.flags & V4L2_VP9_LOOP_FILTER_FLAG_DELTA_ENABLED ?
+			   OVP9_F_LF_DELTA : 0) |
+			  (in->mode != OVP9_OUT_FBC ? OVP9_F_OUT_NV12 : 0) |
+			  (in->mode != OVP9_OUT_NV12 ? OVP9_F_OUT_FBC : 0);
+	/*
+	 * Bit depth code (0 = 8, 1 = 10) and profile (0 or 2).  The
+	 * interpolation filter is in libvpx numbering in V4L2 already; intra
+	 * frames code neither it nor the sign biases (the client's values are
+	 * stale there).
+	 */
+	r[OVP9_W_FMT] = (c->ten ? 1 : 0) | ((fr->profile & 3) << 2);
+	if (!c->intra)
+		r[OVP9_W_FMT] |= ((fr->interpolation_filter & 7) << 4) |
+				 ((fr->ref_frame_sign_bias & 7) << 8);
+	r[OVP9_W_WIDTH] = w;
+	r[OVP9_W_HEIGHT] = h;
+	r[OVP9_W_TILES] = fr->tile_cols_log2 | (fr->tile_rows_log2 << 8);
+	r[OVP9_W_UHSIZE] = fr->uncompressed_header_size;
+	r[OVP9_W_CHSIZE] = fr->compressed_header_size;
+	r[OVP9_W_CTX] = c->ctx | (c->init ? BIT(2) : 0) | (c->ctx << 4);
+	r[OVP9_W_BASEQ] = fr->quant.base_q_idx;
+	r[OVP9_W_DQ0] = ovp9_s8(fr->quant.delta_q_y_dc, fr->quant.delta_q_uv_dc);
+	r[OVP9_W_DQ1] = (u8)fr->quant.delta_q_uv_ac;
+	r[OVP9_W_LF] = (fr->lf.level & 0x3f) | ((fr->lf.sharpness & 7) << 8);
+	/* the deltas in force: the client keeps them across frames */
+	r[OVP9_W_REFD01] = ovp9_s8(fr->lf.ref_deltas[0], fr->lf.ref_deltas[1]);
+	r[OVP9_W_REFD23] = ovp9_s8(fr->lf.ref_deltas[2], fr->lf.ref_deltas[3]);
+	r[OVP9_W_MODED] = ovp9_s8(fr->lf.mode_deltas[0], fr->lf.mode_deltas[1]);
+	r[OVP9_W_SEG] = (seg & V4L2_VP9_SEGMENTATION_FLAG_ENABLED ? BIT(0) : 0) |
+			(seg & V4L2_VP9_SEGMENTATION_FLAG_UPDATE_MAP ? BIT(1) : 0) |
+			(seg & V4L2_VP9_SEGMENTATION_FLAG_TEMPORAL_UPDATE ? BIT(2) : 0) |
+			(st->seg_abs ? BIT(3) : 0) |
+			(st->segmap_valid ? BIT(4) : 0);
+	/* 255 when not coded (FFmpeg keeps stale tree probabilities) */
+	for (i = 0; i < 7; i++)
+		tp[i] = seg & V4L2_VP9_SEGMENTATION_FLAG_UPDATE_MAP ? fr->seg.tree_probs[i] : 255;
+	for (i = 0; i < 3; i++)
+		pp[i] = seg & V4L2_VP9_SEGMENTATION_FLAG_TEMPORAL_UPDATE ?
+			fr->seg.pred_probs[i] : 255;
+	r[OVP9_W_SEGP + 0] = tp[0] | (tp[1] << 8);
+	r[OVP9_W_SEGP + 1] = tp[2] | (tp[3] << 8);
+	r[OVP9_W_SEGP + 2] = tp[4] | (tp[5] << 8);
+	r[OVP9_W_SEGP + 3] = tp[6] | (pp[0] << 8);
+	r[OVP9_W_SEGP + 4] = pp[1] | (pp[2] << 8);
+	/* the feature data in force (the client keeps it across frames) */
+	for (i = 0; i < 8; i++) {
+		u8 en = fr->seg.feature_enabled[i];
+		bool q = en & BIT(V4L2_VP9_SEG_LVL_ALT_Q);
+		bool lf = en & BIT(V4L2_VP9_SEG_LVL_ALT_L);
+		bool ref = en & BIT(V4L2_VP9_SEG_LVL_REF_FRAME);
+
+		r[OVP9_W_SEGF + 2 * i] = q ?
+			(u16)fr->seg.feature_data[i][V4L2_VP9_SEG_LVL_ALT_Q] : 0;
+		r[OVP9_W_SEGF + 2 * i + 1] =
+			(q ? BIT(0) : 0) | (lf ? BIT(1) : 0) | (ref ? BIT(2) : 0) |
+			(en & BIT(V4L2_VP9_SEG_LVL_SKIP) ? BIT(3) : 0) |
+			(ref ? (fr->seg.feature_data[i][V4L2_VP9_SEG_LVL_REF_FRAME] & 3) << 4 : 0) |
+			(lf ? (u8)fr->seg.feature_data[i][V4L2_VP9_SEG_LVL_ALT_L] << 8 : 0);
+	}
+	if (in->mode != OVP9_OUT_FBC) {
+		ovp9_put32(r, OVP9_W_OUT_Y, in->dst_y);
+		ovp9_put32(r, OVP9_W_OUT_UV, in->dst_uv);
+	}
+	ovp9_put32(r, OVP9_W_OUT_YLEN, in->out_size);
+	if (in->mode != OVP9_OUT_NV12) {
+		ovp9_put32(r, OVP9_W_FBC_BODY, in->fbc_body);
+		ovp9_put32(r, OVP9_W_FBC_HEAD, in->fbc_head);
+	}
+	ovp9_put32(r, OVP9_W_MV_WR, in->mv[c->mv]);
+	ovp9_put32(r, OVP9_W_MV_RD, st->last_valid && !c->intra ?
+		   in->mv[st->last_mv] : in->mv[c->mv]);
+	ovp9_put32(r, OVP9_W_IPP, in->ws + OVP9_WS_IPP);
+	ovp9_put32(r, OVP9_W_DBLK_PARA, in->ws + OVP9_WS_DBLK_PARA);
+	ovp9_put32(r, OVP9_W_DBLK_DATA, in->ws + OVP9_WS_DBLK_DATA);
+	ovp9_put32(r, OVP9_W_MPRED_ABV, in->ws + OVP9_WS_MPRED_ABV);
+	ovp9_put32(r, OVP9_W_PROB, in->ws + OVP9_WS_PROB);
+	ovp9_put32(r, OVP9_W_COUNT, in->ws + OVP9_WS_COUNT);
+	ovp9_put32(r, OVP9_W_SEGMAP, in->ws + OVP9_WS_SEGMAP);
+	ovp9_put32(r, OVP9_W_MMU_MAP, in->ws + OVP9_WS_MMU_MAP);
+	r[OVP9_W_DEBUG] = 0;
+}
+
+/* vp9_host.complete() after a good frame (the adaptation itself is the caller's). */
+static inline void ovp9_done(struct codec_vp9_open_state *st, const struct codec_vp9_open_cur *c)
+{
+	st->buf[c->dst_idx].ts = c->ts;
+	st->buf[c->dst_idx].w = c->w;
+	st->buf[c->dst_idx].h = c->h;
+	st->buf[c->dst_idx].mode = c->mode;
+	st->buf[c->dst_idx].ten = c->ten;
+	st->buf[c->dst_idx].valid = true;
+	st->last_valid = true;
+	st->last_w = c->w;
+	st->last_h = c->h;
+	st->last_mv = c->mv;
+	st->last_show = c->show;
+	st->last_intra_only = c->intra_only;
+	st->last_key = c->key;
+	st->last_was_key = c->key;
+	if (c->seg_map)
+		st->segmap_valid = true;
+}
+
+/* A frame that did not decode: nothing it would have left behind is usable. */
+static inline void ovp9_invalidate(struct codec_vp9_open_state *st, u32 dst_idx)
+{
+	if (dst_idx < OVP9_MAX_BUFS)
+		st->buf[dst_idx].valid = false;
+	memset(st->ctx_valid, 0, sizeof(st->ctx_valid));
+	st->segmap_valid = false;
+	st->last_valid = false;
+}
+
+#endif
