diff --speed-large-files --no-dereference --minimal -Naur htop-3.5.3/linux/LibSensors.c htop-3.5.3/linux/LibSensors.c
--- htop-3.5.3/linux/LibSensors.c	2026-11-08 12:27:44.827820696 +0100
+++ htop-3.5.3/linux/LibSensors.c	2026-11-08 12:27:25.694249864 +0100
@@ -166,6 +166,9 @@
       /* Allwinner A733 */
       { "cpul_thermal",       0 },
       { "cpub_thermal",       0 },
+      /* Amlogic T7 */
+      { "a73_thermal",        0 },
+      { "a53_thermal",        0 },
       /* Low priority drivers */
       { "acpitz",             1 },
    };
@@ -356,6 +359,28 @@
                coreTempCount += 2;
                continue;
             }
+
+            /* Map temperature values to Amlogic t7 cores
+            *
+            *   fast a73 cores  -> cores 1..4
+            *   slow a53 cores  -> cores 5..8
+            */
+            if (String_eq(chip->prefix, "a73_thermal")) {
+               data[1] = temp;
+               data[2] = temp;
+               data[3] = temp;
+               data[4] = temp;
+               coreTempCount += 4;
+               continue;
+            }
+            if (String_eq(chip->prefix, "a53_thermal")) {
+               data[5] = temp;
+               data[6] = temp;
+               data[7] = temp;
+               data[8] = temp;
+               coreTempCount += 4;
+               continue;
+            }
          }
 
          /* Rockchip RK3566 */
