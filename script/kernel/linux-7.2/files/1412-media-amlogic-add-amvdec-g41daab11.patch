+/* SPDX-License-Identifier: GPL-2.0+ */
+/*
+ * Copyright (C) 2018 Maxime Jourdan <maxi.jourdan@wanadoo.fr>
+ * Copyright (C) 2026 Christian Hewitt <christianshewitt@gmail.com>
+ *
+ * HEVC request decoding with the open firmware (ohevc-sl).
+ */
+
+#ifndef __MESON_AMVDEC_CODEC_HEVC_H_
+#define __MESON_AMVDEC_CODEC_HEVC_H_
+
+#include "amvdec.h"
+
+extern struct amvdec_codec_ops meson_amvdec_codec_hevc_ops;
+
+/*
+ * Refuse single-column pictures with multiple CTB rows: reconstruction is
+ * inexact (WPP_D measured wrong with ohevc-sl).
+ */
+static inline bool hevc_sps_bad_geometry(const struct v4l2_ctrl_hevc_sps *sps)
+{
+	u32 ctb_log2 = sps->log2_min_luma_coding_block_size_minus3 + 3 +
+		       sps->log2_diff_max_min_luma_coding_block_size;
+
+	return ctb_log2 >= 4 && ctb_log2 <= 6 &&
+	       sps->pic_width_in_luma_samples <= (1U << ctb_log2) &&
+	       sps->pic_height_in_luma_samples > (1U << ctb_log2);
+}
+
+int meson_amvdec_codec_hevc_open_feed(struct amvdec_session *sess,
+				      struct vb2_buffer *vb,
+				      const struct v4l2_ctrl_hevc_sps *sps,
+				      const struct v4l2_ctrl_hevc_pps *pps,
+				      const struct v4l2_ctrl_hevc_decode_params *dp,
+				      const struct v4l2_ctrl_hevc_scaling_matrix *sm);
+
+#endif
diff --speed-large-files --no-dereference --minimal -Naur linux-7.2.8/drivers/media/platform/amlogic/amvdec/codec_hevc_open_rec.h linux-7.2.8/drivers/media/platform/amlogic/amvdec/codec_hevc_open_rec.h
--- linux-7.2.8/drivers/media/platform/amlogic/amvdec/codec_hevc_open_rec.h	1970-01-01 01:00:00.000000000 +0100
+++ linux-7.2.8/drivers/media/platform/amlogic/amvdec/codec_hevc_open_rec.h	2026-10-02 08:55:53.000000000 +0200
@@ -0,0 +1,881 @@
+/* SPDX-License-Identifier: GPL-2.0+ */
+/*
+ * Open HEVC firmware (ohevc-sl): the host half of the record ABI v1
+ * (abi-hevc.md), as pure functions over the V4L2 stateless HEVC controls
+ * (SPS, PPS, DECODE_PARAMS, SLICE_PARAMS array, SCALING_MATRIX) and the
+ * request's OUTPUT bytes.  No kernel dependencies beyond the basic types, so
+ * the same code runs in the userspace equivalence check against the Python
+ * stand-in hevc_host.py (tools: ohevc_rec_test.c + ohevc_rec_gen.py).
+ *
+ * Nothing here depends on the EXT_SPS_ST_RPS / EXT_SPS_LT_RPS controls: the
+ * reference picture set comes from DECODE_PARAMS (poc_st_curr_before/after,
+ * poc_lt_curr, the DPB with its POCs and long-term flags) and the lists from
+ * each slice's ref_idx_l0/l1.
+ *
+ * Control -> record mapping of what V4L2 does not carry directly:
+ *
+ *  - NAL position: FFmpeg (frame-based, ANNEX_B) writes 00 00 01 + the escaped
+ *    NAL unit for every slice segment and sets data_byte_offset = NAL start +
+ *    D, bit_size = (NAL bytes - D) * 8, with D = sh->data_offset, the slice
+ *    header length in *unescaped* bytes including the 2-byte NAL header and
+ *    byte_alignment().  The NAL start is found by searching back from
+ *    data_byte_offset for the 00 00 01 (emulation prevention guarantees none
+ *    inside the NAL unit); the NAL ends where bit_size puts it, counted from
+ *    data_byte_offset or (FFmpeg 8) from the segment's start code, whichever
+ *    lands on the next start code prefix or the end of the bytes,
+ *    trailing zero bytes (zero_byte of the next
+ *    4-byte start code, trailing_zero_8bits) dropped as hevc_bits does.
+ *  - Header bits (slice record word 8): D = data_byte_offset - NAL start is
+ *    taken as unescaped (FFmpeg); the last unescaped header byte holds
+ *    alignment_bit_equal_to_one followed by zeros, so
+ *    header_bits = 8 * (D - 1) + 7 - ctz(that byte).  A client that counts
+ *    D in escaped bytes differs only when the header itself contains an
+ *    emulation-prevention byte; the firmware then reports error 5 (alignment
+ *    bit) instead of decoding garbage.
+ *  - Weighted prediction: V4L2 carries ChromaOffset (clipped, s8) and no
+ *    per-entry flags.  delta_chroma_offset = ChromaOffset - 128 +
+ *    ((128 * ChromaWeight) >> ChromaLog2WeightDenom) inverts (7-56) exactly
+ *    whenever the clip was not active, and gives the same clipped value
+ *    otherwise (always within -512..511 for a conforming stream).  The luma
+ *    / chroma flag of an entry is set when any of its values differs from
+ *    the default (flag 0 and flag 1 with zero deltas decode identically).
+ *  - Scaling lists: V4L2 carries the final matrices in raster order.  Each
+ *    one equal to its default (Table 7-5/7-6, DC 16) maps to the hardware's
+ *    built-in table (14 intra / 15 inter), every other one gets its own LUT
+ *    slot in coded (up-right diagonal) order; all defaults = 0xfefffeee x 3
+ *    and no LUT.  Same effective matrices as the stand-in's coded /
+ *    predicted / default mapping.
+ *  - Deblocking offsets in force: FFmpeg leaves the slice's beta/tc stale
+ *    when an override disables the filter; they are unused then and the
+ *    record takes the PPS values, as the stand-in does.
+ *  - collocated_from_l0: FFmpeg leaves it stale without TMVP; 1 then.
+ *
+ * ABI v2 (abi-hevc.md 6): 10-bit (luma depth = chroma depth, 8 or 10) and
+ * compressed output.  in->fbc / in->nv12 choose the output: 8-bit NV12
+ * (version 1, unchanged), FBC only (AM21C CAPTURE: header = the plane, body =
+ * the buffer's pages), or FBC references + the 8-bit NV12 double write
+ * (NV12M CAPTURE of a Main 10 stream).  With FBC the record carries the
+ * decode-head words 256-265 (MMU mode), word 266 (8-bit mem-saving layout),
+ * the SAO-MMU VH0/VH1 halves, this picture's header and body, and every DPB
+ * entry's FBC header in place of its planes.  The caller fills the SAO-MMU
+ * map (word 72) with the body's page numbers before the command.  The slice
+ * words 17-19 and 36-39 feed only the Q7 debug experiments (debug bits 3, 6,
+ * 9, which the driver never sets) and stay 0.
+ *
+ * Included by codec_hevc.c only.
+ */
+#ifndef __MESON_AMVDEC_CODEC_HEVC_OPEN_REC_H_
+#define __MESON_AMVDEC_CODEC_HEVC_OPEN_REC_H_
+
+#define OHEVC_MAGIC		0x4835		/* 'H5' */
+#define OHEVC_VERSION		1		/* 8-bit NV12 */
+#define OHEVC_VERSION_FBC	2		/* ABI v2: Main 10 / compressed (FBC) output */
+#define OHEVC_VERSION_LINREF	3		/* ABI v2.1: FBC + NV12 output, NV12 reference reads */
+#define OHEVC_PIC_WORDS		320
+#define OHEVC_SLICE_WORDS	192
+#define OHEVC_LUT_WORDS		500		/* 1000 byte entries */
+#define OHEVC_SOC_GXBB		0
+#define OHEVC_SOC_GXL		1		/* GXL, GXM */
+#define OHEVC_SOC_G12A		3		/* G12A, G12B */
+#define OHEVC_SOC_SM1		4
+
+/* picture record (abi-hevc.md 4.1, hevc_host.py P_*) */
+#define OHEVC_P_MAGIC		0
+#define OHEVC_P_VERSION		1
+#define OHEVC_P_SOC		2
+#define OHEVC_P_FLAGS		3
+#define OHEVC_P_WIDTH		4
+#define OHEVC_P_HEIGHT		5
+#define OHEVC_P_GEOM		6
+#define OHEVC_P_GEOM2		7
+#define OHEVC_P_DEPTH		8
+#define OHEVC_P_PCM		9
+#define OHEVC_P_CQP		10
+#define OHEVC_P_TILES		11
+#define OHEVC_P_TCOL		12
+#define OHEVC_P_TROW		29
+#define OHEVC_P_NSLICES		46
+#define OHEVC_P_SLICE_ADDR	48
+#define OHEVC_P_OUT_Y		50
+#define OHEVC_P_OUT_UV		52
+#define OHEVC_P_OUT_YLEN	54
+#define OHEVC_P_MV_WR		56
+#define OHEVC_P_IPP		58
+#define OHEVC_P_SAO_ABV		60
+#define OHEVC_P_SAO_VB		62
+#define OHEVC_P_DBLK_PARA	64
+#define OHEVC_P_DBLK_DATA	66
+#define OHEVC_P_DBLK_DATA2	68
+#define OHEVC_P_MPRED_ABV	70
+#define OHEVC_P_MMU_MAP		72
+#define OHEVC_P_LUT		74
+#define OHEVC_P_SCALE_IDX	80
+#define OHEVC_P_CUR_POC		86
+#define OHEVC_P_DEBUG		88
+#define OHEVC_P_DPB		96
+/* ABI v2 (compressed output): decode head, SAO_CTRL5 bit 9, SAO-MMU VH0/VH1 */
+#define OHEVC_P_FBC_BODY	76
+#define OHEVC_P_FBC_HEAD	78
+#define OHEVC_P_DHEAD		256		/* DECOMP_CTL1, DECOMP_CTL2, CM_BODY_LENGTH, CM_HEADER_OFFSET, CM_HEADER_LENGTH */
+#define OHEVC_P_DHEAD_FL	266
+#define OHEVC_P_VH0		268
+#define OHEVC_P_VH1		270
+#define OHEVC_DPB_WORDS		10
+#define OHEVC_MAX_DPB		16
+
+/* picture flags (word 3) */
+#define OHEVC_PF_SIGN_HIDING	BIT(0)
+#define OHEVC_PF_TSKIP		BIT(1)
+#define OHEVC_PF_CIP		BIT(2)
+#define OHEVC_PF_TQ_BYPASS	BIT(3)
+#define OHEVC_PF_AMP		BIT(4)
+#define OHEVC_PF_CU_QP_DELTA	BIT(5)
+#define OHEVC_PF_PCM		BIT(6)
+#define OHEVC_PF_PCM_LF_DIS	BIT(7)
+#define OHEVC_PF_STRONG_INTRA	BIT(8)
+#define OHEVC_PF_SCALING	BIT(9)
+#define OHEVC_PF_TILES		BIT(10)
+#define OHEVC_PF_WPP		BIT(11)
+#define OHEVC_PF_LF_TILES	BIT(12)
+#define OHEVC_PF_NV12		BIT(13)
+#define OHEVC_PF_FBC		BIT(14)
+#define OHEVC_PF_MAP_DMA	BIT(15)
+
+/* slice-segment record (abi-hevc.md 4.2, hevc_host.py S_*) */
+#define OHEVC_S_ADDR		0
+#define OHEVC_S_FLAGS		1
+#define OHEVC_S_TYPE		2
+#define OHEVC_S_QP		3
+#define OHEVC_S_NREF		4
+#define OHEVC_S_MERGE		5
+#define OHEVC_S_CQP		6
+#define OHEVC_S_DBK		7
+#define OHEVC_S_HBITS		8
+#define OHEVC_S_NCTU		9
+#define OHEVC_S_NALOFF		10
+#define OHEVC_S_WP		12
+#define OHEVC_S_WPF		13
+#define OHEVC_S_L0		20
+#define OHEVC_S_L1		28
+#define OHEVC_S_WT0		64
+#define OHEVC_S_WT1		128
+
+#define OHEVC_SF_DEP		BIT(0)
+#define OHEVC_SF_SAO_L		BIT(1)
+#define OHEVC_SF_SAO_C		BIT(2)
+#define OHEVC_SF_MVD_L1_ZERO	BIT(3)
+#define OHEVC_SF_CABAC_INIT	BIT(4)
+#define OHEVC_SF_TMVP		BIT(5)
+#define OHEVC_SF_COL_L0		BIT(6)
+#define OHEVC_SF_DBK_DIS	BIT(7)
+#define OHEVC_SF_LF_SLICES	BIT(8)
+#define OHEVC_SF_WEIGHTED	BIT(9)
+#define OHEVC_SF_FIRST		BIT(10)
+#define OHEVC_SF_LAST		BIT(11)
+#define OHEVC_SF_LDC		BIT(12)
+
+/*
+ * Workspace (abi-hevc.md section 2, the regions of hevc_host.Layout), offsets
+ * from a 64 KiB aligned base.  SAO vertical line: (sao_unit + 32) *
+ * PicHeightInCtbs * (tile columns + 1) + 32 bytes, checked per picture
+ * against its 0x80000 (4096x2304: at most 176 * 144 * 17 + 32 = 0x69320),
+ * with a readable pad of one column ((sao_unit + 32) * PicHeightInCtbs <=
+ * 0xea00) below it; 800 slice records of 384 bytes.
+ */
+#define OHEVC_WS_IPP		0x000000	/* IPP line buffer, 0x4000 */
+#define OHEVC_WS_SAO_ABV	0x004000	/* SAO above line, 0x30000 */
+#define OHEVC_WS_SAO_VB		0x044000	/* SAO vertical line, 0x80000; 0x10000 pad below */
+#define OHEVC_WS_DBLK_PARA	0x0c4000	/* deblock parameters, 0x40000, zeroed once */
+#define OHEVC_WS_DBLK_DATA	0x104000	/* deblock data, 0x80000 */
+#define OHEVC_WS_DBLK_DATA2	0x184000	/* deblock data 2 (G12A+), 0x80000 */
+#define OHEVC_WS_MPRED_ABV	0x204000	/* MPRED above line, 0x8000 */
+#define OHEVC_WS_MMU_MAP	0x20c000	/* SAO-MMU map, read even for NV12 on G12A, 0x8000 zeroed */
+#define OHEVC_WS_LUT		0x214000	/* scaling LUT image, 1000 bytes */
+#define OHEVC_WS_RECORD		0x215000	/* picture record, 640 bytes */
+#define OHEVC_WS_SLICES		0x216000	/* slice records, 384 bytes each */
+#define OHEVC_MAX_SLICES	800
+#define OHEVC_WS_MMU_VBH	(OHEVC_WS_SLICES + OHEVC_MAX_SLICES * OHEVC_SLICE_WORDS * 2)
+#define OHEVC_MMU_VBH_SIZE	0x5000		/* SAO-MMU VH0/VH1 (FBC only), halves */
+#define OHEVC_WS_SIZE		(OHEVC_WS_MMU_VBH + OHEVC_MMU_VBH_SIZE)
+
+#define OHEVC_WS_SAO_VB_SIZE	0x80000
+
+/* firmware limits (error 2): 4096-pixel line buffer, 256 x 144 CTBs, 16 x 16 tiles */
+#define OHEVC_MAX_W		4096
+/* deblock data / data 2 hold 64 bytes per picture line: 0x80000 = 8192 lines (PICSIZE_A measured) */
+#define OHEVC_MAX_H		8192
+/* FBC layout (driver meson_amvdec_amfbc_*_size(), MMU mode) */
+#define OHEVC_FBC_BODY(w, h, ten)	(((ten) ? 4096u : 3200u) * (((w) + 63) / 64) * (((h) + 31) / 32))
+#define OHEVC_FBC_HEAD(w, h)		(32u * (((w) + 127) / 128) * (((h) + 63) / 64))
+#define OHEVC_MAX_CTB_COLS	256
+#define OHEVC_MAX_CTB_ROWS	144
+#define OHEVC_SAO_UNIT(log2_ctb)	(((log2_ctb) == 4 ? 9 : (log2_ctb) == 5 ? 14 : 24) << 4)
+#define OHEVC_MAX_TILES		16
+/* MV buffer bytes for a picture: PicSizeInCtbs x {16: 0x20, 32: 0x80, 64: 0x200} <= this */
+#define OHEVC_MV_SIZE(w, h)	((((w) + 63) & ~63u) * (((h) + 63) & ~63u) / 8)
+/* stream: 00 00 00 01 + NAL per segment (at most one more byte than FFmpeg's 00 00 01), then zeros */
+#define OHEVC_STREAM_PAD	64
+#define OHEVC_STREAM_NEED(len, nsl)	((len) + (nsl) + OHEVC_STREAM_PAD)
+
+/* refusal reasons (ohevc_build()) */
+enum ohevc_why {
+	OHEVC_OK,
+	OHEVC_BAD_FORMAT,	/* not 8-bit 4:2:0 Main, CTB 8, too large, tiles + WPP, > 16x16 tiles */
+	OHEVC_BAD_TILES,	/* tile layout does not fit the picture */
+	OHEVC_BAD_SLICES,	/* segment addresses / count */
+	OHEVC_BAD_NAL,		/* NAL unit not found where the slice parameters put it */
+	OHEVC_BAD_HEADER,	/* slice header length / NAL header inconsistent */
+	OHEVC_BAD_REF,		/* reference lists outside the current RPS / DPB */
+	OHEVC_BAD_STREAM,	/* stream buffer too small */
+};
+
+/* One DPB entry of DECODE_PARAMS resolved to planes (the driver's job). */
+struct ohevc_ref {
+	u32 y, uv, mv;
+};
+
+struct ohevc_in {
+	const struct v4l2_ctrl_hevc_sps *sps;
+	const struct v4l2_ctrl_hevc_pps *pps;
+	const struct v4l2_ctrl_hevc_decode_params *dp;
+	const struct v4l2_ctrl_hevc_slice_params *sl;
+	u32 nsl;
+	const struct v4l2_ctrl_hevc_scaling_matrix *sm;	/* NULL: not provided */
+	const u8 *data;			/* the request's OUTPUT payload */
+	u32 len;
+	u32 soc, debug;
+	u32 out_y, out_uv, out_size, mv_wr;
+	u32 ws;				/* workspace base (OHEVC_WS_*) */
+	/*
+	 * Output: NV12 planes (out_y/uv) and/or FBC (header = the SAO-MMU page
+	 * header, 0x48000; body = the pages the SAO-MMU map lists).  10-bit
+	 * needs FBC; with FBC the DPB entries' y/uv are the references' FBC
+	 * headers.
+	 */
+	bool nv12, fbc;
+	/*
+	 * ABI v2.1: with FBC + NV12 output at 8 bits, read the references
+	 * from their NV12 planes (ref[].y/uv = planes, DECOMP_CTL1 bit 31)
+	 * instead of their FBC headers - for a picture with a reference that
+	 * was never decoded (the grey NV12 stand-in has no compressed form).
+	 */
+	bool linref;
+	u32 fbc_head, fbc_body;
+	struct ohevc_ref ref[OHEVC_MAX_DPB];	/* per DECODE_PARAMS dpb[] entry */
+};
+
+/* What the build found, for the driver's log. */
+struct ohevc_info {
+	u32 w, h, ctbs, log2_ctb;
+	u32 ntable;			/* current references */
+	u32 bad_slice;			/* segment of a refusal */
+	u32 stream_len;
+};
+
+/* up-right diagonal scan (6.5.3): raster position of coded index i */
+static const u8 ohevc_diag4[16] = {
+	0, 4, 1, 8, 5, 2, 12, 9, 6, 3, 13, 10, 7, 14, 11, 15,
+};
+
+static const u8 ohevc_diag8[64] = {
+	0, 8, 1, 16, 9, 2, 24, 17, 10, 3, 32, 25, 18, 11, 4, 40,
+	33, 26, 19, 12, 5, 48, 41, 34, 27, 20, 13, 6, 56, 49, 42, 35,
+	28, 21, 14, 7, 57, 50, 43, 36, 29, 22, 15, 58, 51, 44, 37, 30,
+	23, 59, 52, 45, 38, 31, 60, 53, 46, 39, 61, 54, 47, 62, 55, 63,
+};
+
+/* Table 7-6 default 8x8 (and larger) lists, coded order */
+static const u8 ohevc_default8[2][64] = {
+	{ 16, 16, 16, 16, 16, 16, 16, 16, 16, 16, 17, 16, 17, 16, 17, 18,
+	  17, 18, 18, 17, 18, 21, 19, 20, 21, 20, 19, 21, 24, 22, 22, 24,
+	  24, 22, 22, 24, 25, 25, 27, 30, 27, 25, 25, 29, 31, 35, 35, 31,
+	  29, 36, 41, 44, 41, 36, 47, 54, 54, 47, 65, 70, 65, 88, 88, 115 },
+	{ 16, 16, 16, 16, 16, 16, 16, 16, 16, 16, 17, 17, 17, 17, 17, 18,
+	  18, 18, 18, 18, 18, 20, 20, 20, 20, 20, 20, 20, 24, 24, 24, 24,
+	  24, 24, 24, 24, 25, 25, 25, 25, 25, 25, 25, 28, 28, 28, 28, 28,
+	  28, 33, 33, 33, 33, 33, 41, 41, 41, 41, 54, 54, 54, 71, 71, 91 },
+};
+
+static inline void ohevc_put32(u16 *r, u32 i, u32 v)
+{
+	r[i] = v & 0xffff;
+	r[i + 1] = v >> 16;
+}
+
+/* DDR image of @n record words: 8-byte groups halfword-reversed (LMEM DMA order) */
+static inline void ohevc_write_words(u16 *dst, const u16 *w, u32 n)
+{
+	u32 i;
+
+	for (i = 0; i + 3 < n; i += 4) {
+		dst[i] = w[i + 3];
+		dst[i + 1] = w[i + 2];
+		dst[i + 2] = w[i + 1];
+		dst[i + 3] = w[i];
+	}
+}
+
+/* Tile column and row starts in CTBs (tile_bounds()); 0 or -1. */
+static inline int ohevc_tiles(const struct v4l2_ctrl_hevc_pps *pps, u32 W, u32 H,
+			      u16 *cols, u32 *nc, u16 *rows, u32 *nr)
+{
+	bool tiles = pps->flags & V4L2_HEVC_PPS_FLAG_TILES_ENABLED;
+	bool uniform = !tiles || (pps->flags & V4L2_HEVC_PPS_FLAG_UNIFORM_SPACING);
+	u32 i;
+
+	*nc = tiles ? pps->num_tile_columns_minus1 + 1 : 1;
+	*nr = tiles ? pps->num_tile_rows_minus1 + 1 : 1;
+	if (*nc > OHEVC_MAX_TILES || *nr > OHEVC_MAX_TILES)
+		return -1;
+	cols[0] = 0;
+	rows[0] = 0;
+	for (i = 1; i < *nc; i++)
+		cols[i] = uniform ? (i * W) / *nc :
+			  cols[i - 1] + (u32)pps->column_width_minus1[i - 1] + 1;
+	for (i = 1; i < *nr; i++)
+		rows[i] = uniform ? (i * H) / *nr :
+			  rows[i - 1] + (u32)pps->row_height_minus1[i - 1] + 1;
+	cols[*nc] = W;
+	rows[*nr] = H;
+	for (i = 0; i < *nc; i++)
+		if (cols[i + 1] <= cols[i])
+			return -1;
+	for (i = 0; i < *nr; i++)
+		if (rows[i + 1] <= rows[i])
+			return -1;
+	return 0;
+}
+
+/* CtbAddrRsToTs (6-5) of one address */
+static inline u32 ohevc_rs2ts(u32 a, u32 W, const u16 *cols, u32 nc, const u16 *rows, u32 nr)
+{
+	u32 x = a % W, y = a / W, tx = 0, ty = 0;
+
+	while (tx + 1 < nc && cols[tx + 1] <= x)
+		tx++;
+	while (ty + 1 < nr && rows[ty + 1] <= y)
+		ty++;
+	return W * rows[ty] + (rows[ty + 1] - rows[ty]) * cols[tx] +
+	       (y - rows[ty]) * (cols[tx + 1] - cols[tx]) + x - cols[tx];
+}
+
+/*
+ * The NAL unit of one slice segment in the OUTPUT bytes (see the mapping at
+ * the top): [*start, *end) escaped, *hbits unescaped header bits.  @lo = end
+ * of the previous segment's NAL unit.
+ */
+static inline enum ohevc_why ohevc_nal(const u8 *d, u32 len, u32 lo,
+				       const struct v4l2_ctrl_hevc_slice_params *s,
+				       u32 *start, u32 *end, u32 *hbits)
+{
+	u32 dbo = s->data_byte_offset, bytes = s->bit_size / 8, e, raw, p, i, n, z, hdr;
+	u8 last = 0;
+
+	if ((s->bit_size & 7) || dbo > len || dbo < lo + 3 + 3)
+		return OHEVC_BAD_NAL;
+	for (p = dbo - 3;; p--) {
+		if (!d[p] && !d[p + 1] && d[p + 2] == 1)
+			break;
+		if (p == lo)
+			return OHEVC_BAD_NAL;
+	}
+	*start = p + 3;
+	/*
+	 * Where the NAL unit ends.  Clients count bit_size two ways: the slice
+	 * data from data_byte_offset (FFmpeg v4l2-request in LibreELEC), or the
+	 * whole segment including its 3-byte start code (FFmpeg 8 v4l2-request).
+	 * Take the smallest candidate that lands on the end of the bytes or on a
+	 * start code prefix (00 00 01, after any zero bytes): none can occur
+	 * inside the NAL unit, so that is its end, while a larger candidate can
+	 * run past a short next segment onto the one after it.  Only a few
+	 * bytes are read: the OUTPUT buffer is uncached, so scanning a whole
+	 * slice for the next start code costs ~125 ns a byte (tens of ms for a
+	 * 4K picture at high bitrate).
+	 */
+	raw = 0;
+	for (i = 0; i < 3; i++) {
+		u32 c = i == 0 ? dbo + bytes : i == 1 ? *start - 3 + bytes : *start + bytes;
+
+		if (c <= dbo || c > len || (raw && c >= raw))
+			continue;
+		if (c < len) {
+			for (p = c, z = 0; p < len && !d[p] && z < 8; p++, z++)
+				;
+			if (z < 2 || p >= len || d[p] != 1)
+				continue;
+		}
+		raw = c;
+	}
+	if (!raw)
+		return OHEVC_BAD_NAL;
+	e = raw;
+	while (e > dbo && !d[e - 1])
+		e--;
+	if (e <= dbo)
+		return OHEVC_BAD_NAL;
+	*end = e;
+	/* NAL header: forbidden_zero_bit, the segment's type, nuh_layer_id 0, TemporalId + 1 > 0 */
+	hdr = dbo - *start;
+	if (hdr < 3 || (d[*start] & 0x80) || ((d[*start] >> 1) & 0x3f) != s->nal_unit_type ||
+	    (d[*start] & 1) || (d[*start + 1] >> 3) || !(d[*start + 1] & 7))
+		return OHEVC_BAD_HEADER;
+	/* the hdr-th unescaped byte (hevc_bits.unescape() rules) */
+	for (i = *start, n = 0, z = 0; i < e && n < hdr; i++) {
+		if (z >= 2 && d[i] == 3 && (i + 1 >= e || d[i + 1] <= 3)) {
+			z = 0;
+			continue;
+		}
+		last = d[i];
+		n++;
+		z = d[i] ? 0 : z + 1;
+	}
+	if (n != hdr || !last)
+		return OHEVC_BAD_HEADER;
+	*hbits = 8 * (hdr - 1) + 7 - __builtin_ctz(last);
+	return OHEVC_OK;
+}
+
+static inline bool ohevc_default_list(const u8 *c, u32 n, u32 dc, bool intra)
+{
+	u32 i;
+
+	if (dc != 16)
+		return false;
+	for (i = 0; i < n; i++)
+		if (c[i] != (n == 16 ? 16 : ohevc_default8[!intra][i]))
+			return false;
+	return true;
+}
+
+/*
+ * LUT image (1000 entries: 8x8 at 64 m, 16x16 at 0x180 + 64 m, 32x32 at
+ * 0x300 + 64 m, 4x4 at 0x380 + 16 m, DC at 0x3e0 + m / 0x3e6 + m, coded
+ * order) and the three IDX words from the final matrices.
+ */
+static inline void ohevc_scaling(const struct v4l2_ctrl_hevc_scaling_matrix *sm,
+				 u8 *lut, u32 *idx)
+{
+	u32 size, m, i, mm, reg, shift, v, n, base, dc;
+	bool all_default = true;
+	const u8 *raster;
+	u8 c[64];
+
+	memset(lut, 0, 1000);
+	idx[0] = idx[1] = idx[2] = 0x10543210;
+	for (size = 0; size < 4; size++) {
+		reg = size < 2 ? size : 2;
+		for (m = 0; m < 6; m += size == 3 ? 3 : 1) {
+			mm = size < 3 ? m : m / 3;
+			shift = size < 3 ? 4 * mm : 24 + 4 * mm;
+			n = size ? 64 : 16;
+			if (!sm) {
+				raster = NULL;
+				dc = 16;
+			} else if (size == 0) {
+				raster = sm->scaling_list_4x4[m];
+				dc = 16;
+			} else if (size == 1) {
+				raster = sm->scaling_list_8x8[m];
+				dc = 16;
+			} else if (size == 2) {
+				raster = sm->scaling_list_16x16[m];
+				dc = sm->scaling_list_dc_coef_16x16[m];
+			} else {
+				raster = sm->scaling_list_32x32[mm];
+				dc = sm->scaling_list_dc_coef_32x32[mm];
+			}
+			for (i = 0; i < n; i++)
+				c[i] = !raster ? (n == 16 ? 16 : ohevc_default8[m >= 3][i]) :
+				       raster[n == 16 ? ohevc_diag4[i] : ohevc_diag8[i]];
+			if (ohevc_default_list(c, n, dc, size < 3 ? m < 3 : m == 0)) {
+				v = (size < 3 ? m < 3 : m == 0) ? 14 : 15;
+			} else {
+				all_default = false;
+				v = mm;
+				base = size == 0 ? 0x380 + 16 * mm : size == 1 ? 64 * mm :
+				       size == 2 ? 0x180 + 64 * mm : 0x300 + 64 * mm;
+				memcpy(lut + base, c, n);
+				if (size == 2)
+					lut[0x3e0 + mm] = dc;
+				else if (size == 3)
+					lut[0x3e6 + mm] = dc;
+			}
+			idx[reg] = (idx[reg] & ~(0xfu << shift)) | v << shift;
+		}
+	}
+	if (all_default)
+		idx[0] = idx[1] = idx[2] = 0xfefffeee;
+}
+
+/* One reference list's weights (4 words per entry) and flag words. */
+static inline void ohevc_weights(u16 *r, u32 base, u32 fwords, u32 n, u32 cdenom,
+				 const s8 *dlw, const s8 *lo, const s8 (*dcw)[2], const s8 (*co)[2])
+{
+	u32 i, j, lf = 0, cf = 0;
+	s32 dco[2];
+
+	for (i = 0; i < n; i++) {
+		u16 *e = r + base + 4 * i;
+
+		if (dlw[i] || lo[i])
+			lf |= BIT(i);
+		if (dcw[i][0] || dcw[i][1] || co[i][0] || co[i][1])
+			cf |= BIT(i);
+		for (j = 0; j < 2; j++) {
+			s32 w = (1 << cdenom) + dcw[i][j];
+
+			/* (7-56) inverted: ChromaOffset = Clip3(-128, 127, 128 - ((128 w) >> d) + dco) */
+			dco[j] = co[i][j] - 128 + ((128 * w) >> cdenom);
+		}
+		e[0] = (u8)dlw[i] | (u8)dcw[i][0] << 8;
+		e[1] = (u8)dcw[i][1] | (u8)lo[i] << 8;
+		e[2] = dco[0] & 0xffff;
+		e[3] = dco[1] & 0xffff;
+	}
+	r[fwords] = lf;
+	r[fwords + 1] = cf;
+}
+
+/*
+ * hevc_host.prepare() + pic_record() + slice_record() + scaling() +
+ * stream_bytes() for one request: @r (OHEVC_PIC_WORDS), @srec (nsl x
+ * OHEVC_SLICE_WORDS), @lut (1000 bytes), @stream (@cap bytes, the length in
+ * @info->stream_len).  Nothing is left half-valid on a refusal that matters:
+ * the caller fails the request.
+ */
+static inline enum ohevc_why ohevc_build(const struct ohevc_in *in, u16 *r, u16 *srec,
+					 u8 *lut, u8 *stream, u32 cap,
+					 struct ohevc_info *info)
+{
+	const struct v4l2_ctrl_hevc_sps *sps = in->sps;
+	const struct v4l2_ctrl_hevc_pps *pps = in->pps;
+	const struct v4l2_ctrl_hevc_decode_params *dp = in->dp;
+	u32 w = sps->pic_width_in_luma_samples, h = sps->pic_height_in_luma_samples;
+	u32 log2_min_cb = sps->log2_min_luma_coding_block_size_minus3 + 3;
+	u32 log2_ctb = log2_min_cb + sps->log2_diff_max_min_luma_coding_block_size;
+	u32 log2_min_tb = sps->log2_min_luma_transform_block_size_minus2 + 2;
+	u32 log2_max_tb = log2_min_tb + sps->log2_diff_max_min_luma_transform_block_size;
+	bool pcm = sps->flags & V4L2_HEVC_SPS_FLAG_PCM_ENABLED;
+	bool tiles = pps->flags & V4L2_HEVC_PPS_FLAG_TILES_ENABLED;
+	bool wpp = pps->flags & V4L2_HEVC_PPS_FLAG_ENTROPY_CODING_SYNC_ENABLED;
+	u32 depth8 = sps->bit_depth_luma_minus8;
+	u32 W, H, ctbs, nc, nr, i, k, fl, pos = 0, lo = 0, prev_ts = 0;
+	u8 table[OHEVC_MAX_DPB], slot[OHEVC_MAX_DPB], ntable = 0;
+	u16 cols[OHEVC_MAX_TILES + 1], rows[OHEVC_MAX_TILES + 1];
+	u32 idx[3];
+	enum ohevc_why why;
+
+	memset(r, 0, OHEVC_PIC_WORDS * sizeof(*r));
+	memset(info, 0, sizeof(*info));
+	info->w = w;
+	info->h = h;
+	info->log2_ctb = log2_ctb;
+
+	/* ---- what this firmware decodes (hevc_host.prepare() "unsupported") */
+	if (sps->chroma_format_idc != 1 || (depth8 != 0 && depth8 != 2) ||
+	    sps->bit_depth_chroma_minus8 != depth8 ||
+	    (sps->flags & V4L2_HEVC_SPS_FLAG_SEPARATE_COLOUR_PLANE) ||
+	    (depth8 && !in->fbc) || (!in->fbc && !in->nv12) ||
+	    (in->linref && (depth8 || !in->fbc || !in->nv12)) ||
+	    (in->fbc && in->soc < OHEVC_SOC_G12A) ||
+	    log2_ctb < 4 || log2_ctb > 6 || log2_min_tb > log2_max_tb || log2_max_tb > 5 ||
+	    !w || !h || w > OHEVC_MAX_W || h > OHEVC_MAX_H || (tiles && wpp) ||
+	    /* one CTB column with WPP: measured wrong on silicon (WPP_D), the
+	     * vendor path refuses one-column pictures too - let the client fall back */
+	    (wpp && ((w + (1u << log2_ctb) - 1) >> log2_ctb) == 1) ||
+	    (pcm && (sps->pcm_sample_bit_depth_luma_minus1 > 7u + depth8 ||
+		     sps->pcm_sample_bit_depth_chroma_minus1 > 7u + depth8 ||
+		     sps->log2_min_pcm_luma_coding_block_size_minus3 +
+		     sps->log2_diff_max_min_pcm_luma_coding_block_size > 2)))
+		return OHEVC_BAD_FORMAT;
+	W = (w + (1 << log2_ctb) - 1) >> log2_ctb;
+	H = (h + (1 << log2_ctb) - 1) >> log2_ctb;
+	ctbs = W * H;
+	info->ctbs = ctbs;
+	if (W > OHEVC_MAX_CTB_COLS || H > OHEVC_MAX_CTB_ROWS)
+		return OHEVC_BAD_FORMAT;
+	if (ohevc_tiles(pps, W, H, cols, &nc, rows, &nr))
+		return tiles && (pps->num_tile_columns_minus1 >= OHEVC_MAX_TILES ||
+				 pps->num_tile_rows_minus1 >= OHEVC_MAX_TILES) ?
+		       OHEVC_BAD_FORMAT : OHEVC_BAD_TILES;
+	/* SAO vertical line of this layout within its region (and the pad below within 0x10000) */
+	if ((OHEVC_SAO_UNIT(log2_ctb) + 32) * H * (nc + 1) + 32 > OHEVC_WS_SAO_VB_SIZE)
+		return OHEVC_BAD_FORMAT;
+	if (!in->nsl || in->nsl > OHEVC_MAX_SLICES)
+		return OHEVC_BAD_SLICES;
+
+	/* ---- DPB table: RefPicSetStCurrBefore, StCurrAfter, LtCurr (DPB indices, no duplicates) */
+	if (dp->num_active_dpb_entries > OHEVC_MAX_DPB ||
+	    (u32)dp->num_poc_st_curr_before + dp->num_poc_st_curr_after + dp->num_poc_lt_curr >
+	    OHEVC_MAX_DPB)
+		return OHEVC_BAD_REF;
+	memset(slot, 0xff, sizeof(slot));
+	for (i = 0; i < (u32)dp->num_poc_st_curr_before + dp->num_poc_st_curr_after +
+		    dp->num_poc_lt_curr; i++) {
+		u32 j = i < dp->num_poc_st_curr_before ? dp->poc_st_curr_before[i] :
+			i < (u32)dp->num_poc_st_curr_before + dp->num_poc_st_curr_after ?
+			dp->poc_st_curr_after[i - dp->num_poc_st_curr_before] :
+			dp->poc_lt_curr[i - dp->num_poc_st_curr_before - dp->num_poc_st_curr_after];
+
+		if (j >= dp->num_active_dpb_entries)
+			return OHEVC_BAD_REF;
+		if (slot[j] == 0xff) {
+			slot[j] = ntable;
+			table[ntable++] = j;
+		}
+	}
+	info->ntable = ntable;
+
+	/* ---- picture record */
+	fl = 0;
+	if (in->nv12)
+		fl |= OHEVC_PF_NV12;
+	if (in->fbc)
+		fl |= OHEVC_PF_FBC | OHEVC_PF_MAP_DMA;	/* FBC is written through the SAO-MMU */
+	if (pps->flags & V4L2_HEVC_PPS_FLAG_SIGN_DATA_HIDING_ENABLED)
+		fl |= OHEVC_PF_SIGN_HIDING;
+	if (pps->flags & V4L2_HEVC_PPS_FLAG_TRANSFORM_SKIP_ENABLED)
+		fl |= OHEVC_PF_TSKIP;
+	if (pps->flags & V4L2_HEVC_PPS_FLAG_CONSTRAINED_INTRA_PRED)
+		fl |= OHEVC_PF_CIP;
+	if (pps->flags & V4L2_HEVC_PPS_FLAG_TRANSQUANT_BYPASS_ENABLED)
+		fl |= OHEVC_PF_TQ_BYPASS;
+	if (sps->flags & V4L2_HEVC_SPS_FLAG_AMP_ENABLED)
+		fl |= OHEVC_PF_AMP;
+	if (pps->flags & V4L2_HEVC_PPS_FLAG_CU_QP_DELTA_ENABLED)
+		fl |= OHEVC_PF_CU_QP_DELTA;
+	if (pcm)
+		fl |= OHEVC_PF_PCM;
+	if (pcm && (sps->flags & V4L2_HEVC_SPS_FLAG_PCM_LOOP_FILTER_DISABLED))
+		fl |= OHEVC_PF_PCM_LF_DIS;
+	if (sps->flags & V4L2_HEVC_SPS_FLAG_STRONG_INTRA_SMOOTHING_ENABLED)
+		fl |= OHEVC_PF_STRONG_INTRA;
+	if (sps->flags & V4L2_HEVC_SPS_FLAG_SCALING_LIST_ENABLED)
+		fl |= OHEVC_PF_SCALING;
+	if (tiles)
+		fl |= OHEVC_PF_TILES;
+	if (wpp)
+		fl |= OHEVC_PF_WPP;
+	if (tiles && (pps->flags & V4L2_HEVC_PPS_FLAG_LOOP_FILTER_ACROSS_TILES_ENABLED))
+		fl |= OHEVC_PF_LF_TILES;
+	if (in->soc >= OHEVC_SOC_G12A)
+		fl |= OHEVC_PF_MAP_DMA;
+	r[OHEVC_P_MAGIC] = OHEVC_MAGIC;
+	r[OHEVC_P_VERSION] = OHEVC_VERSION;
+	r[OHEVC_P_SOC] = in->soc;
+	r[OHEVC_P_FLAGS] = fl;
+	r[OHEVC_P_WIDTH] = w;
+	r[OHEVC_P_HEIGHT] = h;
+	r[OHEVC_P_GEOM] = log2_ctb | log2_min_cb << 4 | log2_min_tb << 8 | log2_max_tb << 12;
+	r[OHEVC_P_GEOM2] = sps->max_transform_hierarchy_depth_inter |
+			   sps->max_transform_hierarchy_depth_intra << 4 |
+			   (pps->flags & V4L2_HEVC_PPS_FLAG_CU_QP_DELTA_ENABLED ?
+			    pps->diff_cu_qp_delta_depth : 0) << 8 |
+			   (pps->log2_parallel_merge_level_minus2 + 2) << 12;
+	r[OHEVC_P_DEPTH] = depth8 | depth8 << 4;
+	if (pcm) {
+		r[OHEVC_P_DEPTH] |= (sps->pcm_sample_bit_depth_luma_minus1 + 1) << 8 |
+				    (sps->pcm_sample_bit_depth_chroma_minus1 + 1) << 12;
+		r[OHEVC_P_PCM] = sps->log2_min_pcm_luma_coding_block_size_minus3 |
+				 (sps->log2_min_pcm_luma_coding_block_size_minus3 +
+				  sps->log2_diff_max_min_pcm_luma_coding_block_size) << 4;
+	}
+	r[OHEVC_P_CQP] = (u8)pps->pps_cb_qp_offset | (u8)pps->pps_cr_qp_offset << 8;
+	r[OHEVC_P_TILES] = nc | nr << 8;
+	for (i = 0; i <= nc; i++)
+		r[OHEVC_P_TCOL + i] = cols[i];
+	for (i = 0; i <= nr; i++)
+		r[OHEVC_P_TROW + i] = rows[i];
+	r[OHEVC_P_NSLICES] = in->nsl;
+	ohevc_put32(r, OHEVC_P_SLICE_ADDR, in->ws + OHEVC_WS_SLICES);
+	ohevc_put32(r, OHEVC_P_OUT_Y, in->out_y);
+	ohevc_put32(r, OHEVC_P_OUT_UV, in->out_uv);
+	ohevc_put32(r, OHEVC_P_OUT_YLEN, in->out_size);
+	ohevc_put32(r, OHEVC_P_MV_WR, in->mv_wr);
+	ohevc_put32(r, OHEVC_P_IPP, in->ws + OHEVC_WS_IPP);
+	ohevc_put32(r, OHEVC_P_SAO_ABV, in->ws + OHEVC_WS_SAO_ABV);
+	ohevc_put32(r, OHEVC_P_SAO_VB, in->ws + OHEVC_WS_SAO_VB);
+	ohevc_put32(r, OHEVC_P_DBLK_PARA, in->ws + OHEVC_WS_DBLK_PARA);
+	ohevc_put32(r, OHEVC_P_DBLK_DATA, in->ws + OHEVC_WS_DBLK_DATA);
+	ohevc_put32(r, OHEVC_P_DBLK_DATA2, in->ws + OHEVC_WS_DBLK_DATA2);
+	ohevc_put32(r, OHEVC_P_MPRED_ABV, in->ws + OHEVC_WS_MPRED_ABV);
+	ohevc_put32(r, OHEVC_P_MMU_MAP, in->ws + OHEVC_WS_MMU_MAP);
+	ohevc_put32(r, OHEVC_P_LUT, in->ws + OHEVC_WS_LUT);
+	ohevc_put32(r, OHEVC_P_CUR_POC, dp->pic_order_cnt_val);
+	r[OHEVC_P_DEBUG] = in->debug;
+	if (in->fbc) {
+		u32 body = OHEVC_FBC_BODY(w, h, depth8), dh[5];
+
+		/* HEVCD_MPP_DECOMP_CTL1: MMU (compressed references) / NV12 reads */
+		dh[0] = in->linref ? BIT(31) : BIT(4);
+		dh[1] = 0;			/* DECOMP_CTL2 */
+		dh[2] = body;			/* HEVC_CM_BODY_LENGTH */
+		dh[3] = body;			/* HEVC_CM_HEADER_OFFSET */
+		dh[4] = OHEVC_FBC_HEAD(w, h);	/* HEVC_CM_HEADER_LENGTH */
+		r[OHEVC_P_VERSION] = OHEVC_VERSION_FBC;
+		ohevc_put32(r, OHEVC_P_FBC_BODY, in->fbc_body);
+		ohevc_put32(r, OHEVC_P_FBC_HEAD, in->fbc_head);
+		for (i = 0; i < 5; i++)
+			ohevc_put32(r, OHEVC_P_DHEAD + 2 * i, dh[i]);
+		/* b0 8-bit FBC: mem-saving layout (SAO_CTRL5 bit 9); b1 linear references */
+		r[OHEVC_P_DHEAD_FL] = (depth8 ? 0 : 1) | in->linref << 1;
+		if (in->linref)
+			r[OHEVC_P_VERSION] = OHEVC_VERSION_LINREF;
+		ohevc_put32(r, OHEVC_P_VH0, in->ws + OHEVC_WS_MMU_VBH);
+		ohevc_put32(r, OHEVC_P_VH1, in->ws + OHEVC_WS_MMU_VBH + OHEVC_MMU_VBH_SIZE / 2);
+	}
+	for (k = 0; k < ntable; k++) {
+		u32 b = OHEVC_P_DPB + OHEVC_DPB_WORDS * k, j = table[k];
+
+		ohevc_put32(r, b, in->ref[j].y);
+		ohevc_put32(r, b + 2, in->ref[j].uv);
+		ohevc_put32(r, b + 4, in->ref[j].mv);
+		ohevc_put32(r, b + 6, dp->dpb[j].pic_order_cnt_val);
+		r[b + 8] = 1 | (dp->dpb[j].flags & V4L2_HEVC_DPB_ENTRY_LONG_TERM_REFERENCE ? 2 : 0);
+	}
+	if (fl & OHEVC_PF_SCALING) {
+		ohevc_scaling(in->sm, lut, idx);
+	} else {
+		memset(lut, 0, 1000);
+		idx[0] = idx[1] = idx[2] = 0;
+	}
+	for (i = 0; i < 3; i++)
+		ohevc_put32(r, OHEVC_P_SCALE_IDX + 2 * i, idx[i]);
+
+	/* ---- slice segments, and the stream */
+	if (in->sl[0].slice_segment_addr ||
+	    (in->sl[0].flags & V4L2_HEVC_SLICE_PARAMS_FLAG_DEPENDENT_SLICE_SEGMENT))
+		return OHEVC_BAD_SLICES;
+	for (k = 0; k < in->nsl; k++) {
+		const struct v4l2_ctrl_hevc_slice_params *s = &in->sl[k];
+		const struct v4l2_hevc_pred_weight_table *pw = &s->pred_weight_table;
+		u16 *q = srec + k * OHEVC_SLICE_WORDS;
+		u32 st = s->slice_type, n0 = 0, n1 = 0, ts, next, start, end, hbits, cdenom;
+		bool dbk_dis = s->flags & V4L2_HEVC_SLICE_PARAMS_FLAG_SLICE_DEBLOCKING_FILTER_DISABLED;
+		bool tmvp = s->flags & V4L2_HEVC_SLICE_PARAMS_FLAG_SLICE_TEMPORAL_MVP_ENABLED;
+		bool weighted, ldc = true;
+		u8 l[2][OHEVC_MAX_DPB];
+
+		info->bad_slice = k;
+		memset(q, 0, OHEVC_SLICE_WORDS * sizeof(*q));
+		if (st > 2 || s->slice_segment_addr >= ctbs)
+			return OHEVC_BAD_SLICES;
+		ts = ohevc_rs2ts(s->slice_segment_addr, W, cols, nc, rows, nr);
+		if (k && ts <= prev_ts)
+			return OHEVC_BAD_SLICES;
+		next = k + 1 < in->nsl ?
+		       (in->sl[k + 1].slice_segment_addr < ctbs ?
+			ohevc_rs2ts(in->sl[k + 1].slice_segment_addr, W, cols, nc, rows, nr) : 0) :
+		       ctbs;
+		if (next <= ts)
+			return OHEVC_BAD_SLICES;
+		prev_ts = ts;
+
+		/* reference lists as DPB-table indices */
+		if (st != 2) {
+			n0 = s->num_ref_idx_l0_active_minus1 + 1;
+			n1 = st == 0 ? s->num_ref_idx_l1_active_minus1 + 1 : 0;
+			if (!ntable || n0 > OHEVC_MAX_DPB || n1 > OHEVC_MAX_DPB)
+				return OHEVC_BAD_REF;
+			for (i = 0; i < n0 + n1; i++) {
+				u32 j = i < n0 ? s->ref_idx_l0[i] : s->ref_idx_l1[i - n0];
+
+				if (j >= OHEVC_MAX_DPB || slot[j] == 0xff)
+					return OHEVC_BAD_REF;
+				l[i >= n0][i < n0 ? i : i - n0] = slot[j];
+				if (dp->dpb[j].pic_order_cnt_val > dp->pic_order_cnt_val)
+					ldc = false;
+			}
+			if (tmvp && s->collocated_ref_idx >=
+			    (st == 0 && !(s->flags & V4L2_HEVC_SLICE_PARAMS_FLAG_COLLOCATED_FROM_L0) ?
+			     n1 : n0))
+				return OHEVC_BAD_REF;
+		}
+
+		/* the NAL unit and its place in the stream */
+		why = ohevc_nal(in->data, in->len, lo, s, &start, &end, &hbits);
+		if (why != OHEVC_OK)
+			return why;
+		lo = end;
+		if (pos + 4 + (end - start) + OHEVC_STREAM_PAD > cap)
+			return OHEVC_BAD_STREAM;
+		stream[pos] = 0;
+		stream[pos + 1] = 0;
+		stream[pos + 2] = 0;
+		stream[pos + 3] = 1;
+		pos += 4;
+		memcpy(stream + pos, in->data + start, end - start);
+
+		weighted = (st == 1 && (pps->flags & V4L2_HEVC_PPS_FLAG_WEIGHTED_PRED)) ||
+			   (st == 0 && (pps->flags & V4L2_HEVC_PPS_FLAG_WEIGHTED_BIPRED));
+		fl = 0;
+		if (s->flags & V4L2_HEVC_SLICE_PARAMS_FLAG_DEPENDENT_SLICE_SEGMENT)
+			fl |= OHEVC_SF_DEP;
+		if (s->flags & V4L2_HEVC_SLICE_PARAMS_FLAG_SLICE_SAO_LUMA)
+			fl |= OHEVC_SF_SAO_L;
+		if (s->flags & V4L2_HEVC_SLICE_PARAMS_FLAG_SLICE_SAO_CHROMA)
+			fl |= OHEVC_SF_SAO_C;
+		if (st == 0 && (s->flags & V4L2_HEVC_SLICE_PARAMS_FLAG_MVD_L1_ZERO))
+			fl |= OHEVC_SF_MVD_L1_ZERO;
+		if (st != 2 && (s->flags & V4L2_HEVC_SLICE_PARAMS_FLAG_CABAC_INIT))
+			fl |= OHEVC_SF_CABAC_INIT;
+		if (tmvp)
+			fl |= OHEVC_SF_TMVP;
+		if (!tmvp || st != 0 || (s->flags & V4L2_HEVC_SLICE_PARAMS_FLAG_COLLOCATED_FROM_L0))
+			fl |= OHEVC_SF_COL_L0;
+		if (dbk_dis)
+			fl |= OHEVC_SF_DBK_DIS;
+		if (s->flags & V4L2_HEVC_SLICE_PARAMS_FLAG_SLICE_LOOP_FILTER_ACROSS_SLICES_ENABLED)
+			fl |= OHEVC_SF_LF_SLICES;
+		if (weighted)
+			fl |= OHEVC_SF_WEIGHTED;
+		if (!k)
+			fl |= OHEVC_SF_FIRST;
+		if (k + 1 == in->nsl)
+			fl |= OHEVC_SF_LAST;
+		if (st != 2 && ldc)
+			fl |= OHEVC_SF_LDC;
+		q[OHEVC_S_ADDR] = s->slice_segment_addr;
+		q[OHEVC_S_FLAGS] = fl;
+		q[OHEVC_S_TYPE] = st | s->nal_unit_type << 8;
+		q[OHEVC_S_QP] = (u16)(26 + pps->init_qp_minus26 + s->slice_qp_delta);
+		q[OHEVC_S_NREF] = n0 | n1 << 8;
+		q[OHEVC_S_MERGE] = (st == 2 ? 5 : 5 - s->five_minus_max_num_merge_cand) |
+				   (tmvp && st != 2 ? s->collocated_ref_idx : 0) << 8;
+		q[OHEVC_S_CQP] = (u8)s->slice_cb_qp_offset | (u8)s->slice_cr_qp_offset << 8;
+		if (dbk_dis)
+			q[OHEVC_S_DBK] = (u8)pps->pps_beta_offset_div2 | (u8)pps->pps_tc_offset_div2 << 8;
+		else
+			q[OHEVC_S_DBK] = (u8)s->slice_beta_offset_div2 | (u8)s->slice_tc_offset_div2 << 8;
+		q[OHEVC_S_HBITS] = hbits;
+		q[OHEVC_S_NCTU] = next - ts;
+		ohevc_put32(q, OHEVC_S_NALOFF, pos);
+		for (i = 0; i < n0; i++)
+			q[OHEVC_S_L0 + i / 2] |= l[0][i] << (8 * (i & 1));
+		for (i = 0; i < n1; i++)
+			q[OHEVC_S_L1 + i / 2] |= l[1][i] << (8 * (i & 1));
+		if (weighted) {
+			if (pw->luma_log2_weight_denom > 7 ||
+			    pw->luma_log2_weight_denom + pw->delta_chroma_log2_weight_denom < 0 ||
+			    pw->luma_log2_weight_denom + pw->delta_chroma_log2_weight_denom > 7)
+				return OHEVC_BAD_HEADER;
+			cdenom = pw->luma_log2_weight_denom + pw->delta_chroma_log2_weight_denom;
+			q[OHEVC_S_WP] = pw->luma_log2_weight_denom |
+					(u8)pw->delta_chroma_log2_weight_denom << 8;
+			ohevc_weights(q, OHEVC_S_WT0, OHEVC_S_WPF, n0, cdenom,
+				      pw->delta_luma_weight_l0, pw->luma_offset_l0,
+				      pw->delta_chroma_weight_l0, pw->chroma_offset_l0);
+			if (st == 0)
+				ohevc_weights(q, OHEVC_S_WT1, OHEVC_S_WPF + 2, n1, cdenom,
+					      pw->delta_luma_weight_l1, pw->luma_offset_l1,
+					      pw->delta_chroma_weight_l1, pw->chroma_offset_l1);
+		}
+		pos += end - start;
+	}
+	memset(stream + pos, 0, OHEVC_STREAM_PAD);
+	pos += OHEVC_STREAM_PAD;
+	info->stream_len = pos;
+	return OHEVC_OK;
+}
+
+#endif
diff --speed-large-files --no-dereference --minimal -Naur linux-7.2.8/drivers/media/platform/amlogic/amvdec/codec_mpeg12.c linux-7.2.8/drivers/media/platform/amlogic/amvdec/codec_mpeg12.c
--- linux-7.2.8/drivers/media/platform/amlogic/amvdec/codec_mpeg12.c	1970-01-01 01:00:00.000000000 +0100
+++ linux-7.2.8/drivers/media/platform/amlogic/amvdec/codec_mpeg12.c	2026-10-02 08:55:53.000000000 +0200
@@ -0,0 +1,478 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Copyright (C) 2018 BayLibre, SAS
+ * Author: Maxime Jourdan <mjourdan@baylibre.com>
+ * Copyright (C) 2026 Christian Hewitt <christianshewitt@gmail.com>
+ *
+ * MPEG-2 request decoding with the open firmware (ompeg2-sl).
+ */
+
+#include <linux/delay.h>
+#include <media/v4l2-mem2mem.h>
+#include <media/videobuf2-dma-contig.h>
+
+#include "codec_mpeg12.h"
+#include "dos_regs.h"
+#include "amvdec_helpers.h"
+
+static irqreturn_t codec_mpeg12_isr(struct amvdec_session *sess)
+{
+	return IRQ_WAKE_THREAD;
+}
+
+/*
+ * Open firmware (ompeg2-sl, docs/abi-mpeg2.md in the openucode repository):
+ * the host parses nothing beyond what the V4L2 controls already carry; the
+ * firmware takes a 128-halfword parameter record and the picture, which the
+ * host prepends with synthesized sequence and picture headers.  Every
+ * picture, field pictures included, is one command; the record carries the
+ * field pairing.
+ */
+#define OSL_WORKSPACE_SIZE		SZ_16K		/* record + optional MB log */
+#define MPEG12_SL_PADDING		SZ_1K
+#define MPEG12_SL_FIFO_ALIGN		8
+
+#define OSL_CMD_DECODE		1
+#define OSL_STATUS_DONE		0x80
+#define OSL_STATUS_ERROR	0x81
+#define OSL_REC_WORDS		128
+
+#ifdef AMVDEC_OUCODE_DEV
+static uint mpeg12_bench;
+module_param(mpeg12_bench, uint, 0644);
+MODULE_PARM_DESC(mpeg12_bench, "log kick->done latency every N pictures (0 = off)");
+#endif
+
+struct codec_mpeg12_sl {
+	void	  *workspace_vaddr;
+	dma_addr_t workspace_paddr;
+	u32 canvas_spec[VB2_MAX_FRAME];
+
+	/*
+	 * A field picture is one command; the second field of a pair names
+	 * the same CAPTURE buffer with the opposite parity and carries the
+	 * first field's temporal reference.
+	 */
+	bool cur_first_field;
+	u32 cur_structure;
+	u16 cur_temporal_ref;
+	bool pair_pending;
+	u32 pair_dst;
+	u32 pair_structure;
+	u16 pair_temporal_ref;
+	/*
+	 * Grey NV12 surface standing in for a reference the request names but
+	 * nothing decoded in this session (leading B pictures of a closed GOP,
+	 * seeks): what FFmpeg's software decoder predicts from as well.
+	 */
+	void *grey_vaddr;
+	dma_addr_t grey_paddr;
+	size_t grey_size;
+	u32 grey_spec;
+#ifdef AMVDEC_OUCODE_DEV
+	/* mpeg12_bench: kick -> done latency in us */
+	ktime_t bench_t0;
+	u64 bench_sum;
+	u32 bench_max, bench_n;
+#endif
+};
+
+static int codec_mpeg12_sl_start(struct amvdec_session *sess)
+{
+	struct amvdec_core *core = sess->core;
+	struct codec_mpeg12_sl *m;
+
+	m = kzalloc_obj(*m);
+	if (!m)
+		return -ENOMEM;
+	m->workspace_vaddr = dma_alloc_coherent(core->dev, OSL_WORKSPACE_SIZE,
+						&m->workspace_paddr, GFP_KERNEL);
+	if (!m->workspace_vaddr) {
+		kfree(m);
+		return -ENOMEM;
+	}
+	memset(m->workspace_vaddr, 0, OSL_WORKSPACE_SIZE);
+
+	sess->priv = m;
+	return 0;
+}
+
+static int codec_mpeg12_sl_stop(struct amvdec_session *sess)
+{
+	struct codec_mpeg12_sl *m = sess->priv;
+	struct amvdec_core *core = sess->core;
+
+	if (!m)
+		return 0;
+	dma_free_coherent(core->dev, OSL_WORKSPACE_SIZE,
+			  m->workspace_vaddr, m->workspace_paddr);
+	if (m->grey_vaddr)
+		dma_free_coherent(core->dev, m->grey_size, m->grey_vaddr, m->grey_paddr);
+	return 0;
+}
+
+/* Canvas spec of the grey reference surface, allocated on first use. */
+static int codec_mpeg12_sl_grey_canvas(struct amvdec_session *sess, u32 *spec)
+{
+	struct codec_mpeg12_sl *m = sess->priv;
+	struct amvdec_core *core = sess->core;
+	u32 w = ALIGN(sess->width, 64), h = ALIGN(sess->height, 32);
+	size_t size = (size_t)w * h * 3 / 2;
+	int ret;
+
+	if (m->grey_vaddr && m->grey_size < size) {
+		dma_free_coherent(core->dev, m->grey_size, m->grey_vaddr, m->grey_paddr);
+		m->grey_vaddr = NULL;
+		m->grey_spec = 0;
+	}
+	if (!m->grey_vaddr) {
+		m->grey_vaddr = dma_alloc_coherent(core->dev, size, &m->grey_paddr, GFP_KERNEL);
+		if (!m->grey_vaddr)
+			return -ENOMEM;
+		m->grey_size = size;
+		memset(m->grey_vaddr, 0x80, size);
+	}
+	ret = meson_amvdec_canvas_nv12_paddr_spec(sess, m->grey_paddr, w, h, &m->grey_spec);
+	if (!ret)
+		*spec = m->grey_spec;
+	return ret;
+}
+
+static int codec_mpeg12_sl_canvas(struct amvdec_session *sess,
+				  struct vb2_buffer *vb, u32 *spec)
+{
+	struct codec_mpeg12_sl *m = sess->priv;
+	int ret;
+
+	if (vb->index >= VB2_MAX_FRAME)
+		return -EINVAL;
+	ret = meson_amvdec_canvas_nv12m_spec(sess, vb, ALIGN(sess->width, 64),
+				       ALIGN(sess->height, 32),
+				       &m->canvas_spec[vb->index]);
+	if (!ret)
+		*spec = m->canvas_spec[vb->index];
+	return ret;
+}
+
+/*
+ * Is the job at hand the second field of the pair the firmware has open?  If
+ * so it must carry the first field's temporal reference and no sequence
+ * header.
+ */
+bool meson_amvdec_codec_mpeg12_sl_second_field(struct amvdec_session *sess,
+				  const struct v4l2_ctrl_mpeg2_picture *pic,
+				  u16 *temporal_ref)
+{
+	struct codec_mpeg12_sl *m = sess->priv;
+
+	if (!m || !m->pair_pending || !sess->request_job.dst ||
+	    pic->picture_structure == V4L2_MPEG2_PIC_FRAME ||
+	    pic->picture_structure == m->pair_structure ||
+	    sess->request_job.dst->vb2_buf.index != m->pair_dst)
+		return false;
+	*temporal_ref = m->pair_temporal_ref;
+	return true;
+}
+
+/* LMEM DMA byte order: the four halfwords of every 8-byte group are reversed */
+static void osl_write_record(u16 *dst, const u16 *w)
+{
+	int i;
+
+	for (i = 0; i < OSL_REC_WORDS; i += 4) {
+		dst[i + 0] = w[i + 3];
+		dst[i + 1] = w[i + 2];
+		dst[i + 2] = w[i + 1];
+		dst[i + 3] = w[i + 0];
+	}
+}
+
+static void osl_build_record(struct amvdec_session *sess,
+			     const struct v4l2_ctrl_mpeg2_picture *pic, bool second,
+			     u32 dst, u32 fwd, u32 bwd, u16 *w)
+{
+	const struct v4l2_ctrl_mpeg2_sequence *seq = &sess->feed.mpeg2_seq;
+	const struct v4l2_ctrl_mpeg2_quantisation *q = &sess->feed.mpeg2_quant;
+	u32 mbw = DIV_ROUND_UP(seq->horizontal_size, 16);
+	u32 mbh = DIV_ROUND_UP(seq->vertical_size, 16);
+	bool frame = pic->picture_structure == V4L2_MPEG2_PIC_FRAME;
+	u32 flags;
+	int i;
+
+	memset(w, 0, OSL_REC_WORDS * sizeof(*w));
+	/*
+	 * bit0: MPEG-2 mode.  The controls do not say MPEG-1 vs MPEG-2; MPEG-1
+	 * streams also lack full-pel information in the controls, so MPEG-2
+	 * is assumed (MPEG-1 support is a known gap of the stateless API).
+	 */
+	flags = BIT(0) |
+		(pic->flags & V4L2_MPEG2_PIC_FLAG_FRAME_PRED_DCT ? BIT(1) : 0) |
+		(pic->flags & V4L2_MPEG2_PIC_FLAG_CONCEALMENT_MV ? BIT(2) : 0) |
+		(pic->flags & V4L2_MPEG2_PIC_FLAG_Q_SCALE_TYPE ? BIT(3) : 0) |
+		(pic->flags & V4L2_MPEG2_PIC_FLAG_INTRA_VLC ? BIT(4) : 0) |
+		(pic->flags & V4L2_MPEG2_PIC_FLAG_ALT_SCAN ? BIT(5) : 0) |
+		(pic->flags & V4L2_MPEG2_PIC_FLAG_TOP_FIELD_FIRST ? BIT(6) : 0) |
+		(pic->flags & V4L2_MPEG2_PIC_FLAG_REPEAT_FIRST ? BIT(7) : 0) |
+		(pic->flags & V4L2_MPEG2_PIC_FLAG_PROGRESSIVE ? BIT(8) : 0) |
+		BIT(11) | BIT(12) | (second ? BIT(13) : 0);
+	w[0] = 0x4d32;
+	w[1] = 1;
+	w[2] = mbw;
+	w[3] = frame ? mbh : DIV_ROUND_UP(seq->vertical_size, 32);
+	w[4] = pic->picture_coding_type;
+	w[5] = pic->picture_structure;
+	w[6] = flags;
+	w[7] = (pic->f_code[0][0] << 12) | (pic->f_code[0][1] << 8) |
+	       (pic->f_code[1][0] << 4) | pic->f_code[1][1];
+	w[8] = pic->intra_dc_precision;
+	w[9] = mbh;
+	w[10] = dst & 0xffff;
+	w[11] = dst >> 16;
+	w[12] = fwd & 0xffff;
+	w[13] = fwd >> 16;
+	w[14] = bwd & 0xffff;
+	w[15] = bwd >> 16;
+	for (i = 0; i < 32; i++) {
+		w[16 + i] = (q->intra_quantiser_matrix[2 * i] << 8) |
+			    q->intra_quantiser_matrix[2 * i + 1];
+		w[48 + i] = (q->non_intra_quantiser_matrix[2 * i] << 8) |
+			    q->non_intra_quantiser_matrix[2 * i + 1];
+	}
+}
+
+static void codec_mpeg12_sl_input(struct amvdec_core *core, dma_addr_t src,
+				  u32 fifo_size, u32 payload)
+{
+	meson_amvdec_write_dos(core, VLD_MEM_VIFIFO_START_PTR, src);
+	meson_amvdec_write_dos(core, VLD_MEM_VIFIFO_END_PTR,
+			 src + fifo_size - MPEG12_SL_FIFO_ALIGN);
+	meson_amvdec_write_dos(core, VLD_MEM_VIFIFO_CURR_PTR, src);
+	meson_amvdec_write_dos(core, VLD_MEM_VIFIFO_CONTROL, 1);
+	meson_amvdec_write_dos(core, VLD_MEM_VIFIFO_CONTROL, 0);
+	meson_amvdec_write_dos(core, VLD_MEM_VIFIFO_BUF_CNTL, 2);
+	meson_amvdec_write_dos(core, VLD_MEM_VIFIFO_RP, src);
+	meson_amvdec_write_dos(core, VLD_MEM_VIFIFO_WP,
+			 round_down(src + payload + MPEG12_SL_PADDING,
+				    MPEG12_SL_FIFO_ALIGN));
+	meson_amvdec_write_dos(core, VLD_MEM_VIFIFO_BUF_CNTL, 3);
+	meson_amvdec_write_dos(core, VLD_MEM_VIFIFO_BUF_CNTL, 2);
+	meson_amvdec_write_dos(core, VLD_MEM_VIFIFO_CONTROL,
+			 (0x11 << 16) | BIT(10) | (7 << 3));
+	meson_amvdec_write_dos(core, VIFF_BIT_CNT, payload * 8);
+}
+
+/*
+ * Decode one picture.  @vb already starts with the synthesized headers.  The
+ * destination and the resolved references are those of the request job.
+ */
+int meson_amvdec_codec_mpeg12_sl_feed(struct amvdec_session *sess, struct vb2_buffer *vb,
+			 const struct v4l2_ctrl_mpeg2_picture *pic,
+			 u16 temporal_ref)
+{
+	struct codec_mpeg12_sl *m = sess->priv;
+	struct amvdec_core *core = sess->core;
+	dma_addr_t src = vb2_dma_contig_plane_dma_addr(vb, 0);
+	u32 payload = vb2_get_plane_payload(vb, 0);
+	u32 fifo_size = round_down(vb2_plane_size(vb, 0), MPEG12_SL_FIFO_ALIGN);
+	u8 *data = vb2_plane_vaddr(vb, 0);
+	struct vb2_buffer *dst, *fwd, *bwd;
+	bool field = pic->picture_structure != V4L2_MPEG2_PIC_FRAME;
+	u16 rec_words[OSL_REC_WORDS];
+	u32 rec, ref0, ref1;
+	bool second;
+	u16 tref;
+	int i, ret;
+
+	if (!m || !data || !sess->request_job.dst)
+		return -EINVAL;
+	if (!payload || fifo_size <= MPEG12_SL_PADDING ||
+	    payload >= fifo_size - MPEG12_SL_PADDING ||
+	    !IS_ALIGNED(src, MPEG12_SL_FIFO_ALIGN))
+		return -EINVAL;
+
+	dst = &sess->request_job.dst->vb2_buf;
+	/* every field is a full command; the record carries the pairing */
+	second = meson_amvdec_codec_mpeg12_sl_second_field(sess, pic, &tref);
+	m->pair_pending = false;
+	m->cur_first_field = field && !second;
+	m->cur_structure = pic->picture_structure;
+	m->cur_temporal_ref = temporal_ref;
+
+	fwd = sess->request_job.refs[0];
+	bwd = sess->request_job.refs[1];
+	ret = codec_mpeg12_sl_canvas(sess, dst, &rec);
+	if (ret)
+		return ret;
+	switch (pic->picture_coding_type) {
+	case V4L2_MPEG2_PIC_CODING_TYPE_I:
+		/* Unused roles still get a valid, owned surface. */
+		ref0 = rec;
+		ref1 = rec;
+		break;
+	case V4L2_MPEG2_PIC_CODING_TYPE_P:
+		/*
+		 * The P field that completes an I field predicts from its
+		 * mate alone and may have no other picture to name.
+		 */
+		if (!fwd && field) {
+			ref0 = rec;
+			ref1 = rec;
+			break;
+		}
+		/* A reference nothing decoded (stream start, seek): grey. */
+		if (!fwd || fwd == dst)
+			ret = codec_mpeg12_sl_grey_canvas(sess, &ref1);
+		else
+			ret = codec_mpeg12_sl_canvas(sess, fwd, &ref1);
+		if (ret)
+			return ret;
+		ref0 = ref1;
+		break;
+	case V4L2_MPEG2_PIC_CODING_TYPE_B:
+		if (!fwd || fwd == dst)
+			ret = codec_mpeg12_sl_grey_canvas(sess, &ref0);
+		else
+			ret = codec_mpeg12_sl_canvas(sess, fwd, &ref0);
+		if (!ret) {
+			if (!bwd || bwd == dst)
+				ret = codec_mpeg12_sl_grey_canvas(sess, &ref1);
+			else
+				ret = codec_mpeg12_sl_canvas(sess, bwd, &ref1);
+		}
+		if (ret)
+			return ret;
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	/*
+	 * The engine reads ahead of the picture: a sequence_end_code, then
+	 * zeros.
+	 */
+	memset(data + payload, 0, MPEG12_SL_PADDING);
+	data[payload + 2] = 1;
+	data[payload + 3] = 0xb7;
+	dma_sync_single_for_device(core->dev, src, payload + MPEG12_SL_PADDING,
+				   DMA_TO_DEVICE);
+
+	/* Halt the processors before touching the VLD; drain their DMA. */
+	meson_amvdec_write_dos(core, MPSR, 0);
+	meson_amvdec_write_dos(core, CPSR, 0);
+	for (i = 0; i < 1000; i++) {
+		if (!(meson_amvdec_read_dos(core, IMEM_DMA_CTRL) & 0x8000))
+			break;
+		udelay(10);
+	}
+	for (i = 0; i < 1000; i++) {
+		if (!(meson_amvdec_read_dos(core, LMEM_DMA_CTRL) & 0x8000))
+			break;
+		udelay(10);
+	}
+
+	/* Input: the VLD FIFO is the OUTPUT buffer itself. */
+	meson_amvdec_write_dos(core, VLD_MEM_VIFIFO_CONTROL, 0);
+	meson_amvdec_write_dos(core, DOS_SW_RESET0, BIT(5) | BIT(4) | BIT(3));
+	meson_amvdec_write_dos(core, DOS_SW_RESET0, 0);
+	meson_amvdec_write_dos(core, POWER_CTL_VLD, BIT(4));
+
+#ifdef AMVDEC_OUCODE_DEV
+	m->bench_t0 = ktime_get();
+#endif
+	codec_mpeg12_sl_input(core, src, fifo_size, payload);
+
+	osl_build_record(sess, pic, second, rec, ref0, ref1, rec_words);
+	osl_write_record(m->workspace_vaddr, rec_words);
+	meson_amvdec_write_dos(core, MPEG1_2_REG, 0);
+	meson_amvdec_write_dos(core, PSCALE_CTRL, 0);
+	meson_amvdec_write_dos(core, PIC_HEAD_INFO, 0x380);
+	meson_amvdec_write_dos(core, M4_CONTROL_REG, 0);
+	meson_amvdec_write_dos(core, ASSIST_MBOX1_CLR_REG, 1);
+	meson_amvdec_write_dos(core, ASSIST_MBOX1_MASK, 1);
+	meson_amvdec_write_dos(core, AV_SCRATCH_2, 0);
+	meson_amvdec_write_dos(core, AV_SCRATCH_1, m->workspace_paddr);
+	meson_amvdec_write_dos(core, AV_SCRATCH_0, OSL_CMD_DECODE);
+	if (sess->pixfmt_cap == V4L2_PIX_FMT_NV12M)
+		meson_amvdec_write_dos_bits(core, MDEC_PIC_DC_CTRL, BIT(17));
+	meson_amvdec_clear_dos_bits(core, MDEC_PIC_DC_CTRL, BIT(16));
+	meson_amvdec_write_dos_bits(core, VLD_MEM_VIFIFO_CONTROL, 0x6);
+	dev_dbg(core->dev,
+		"mpeg2 open fw: type=%u struct=%u second=%u payload=%u rec=%06x fwd=%06x bwd=%06x dst=%u\n",
+		pic->picture_coding_type, pic->picture_structure, second, payload,
+		rec, ref0, ref1, dst->index);
+	/* Order every store above before the processors are released. */
+	dma_wmb();
+	meson_amvdec_write_dos(core, DOS_SW_RESET0, BIT(12) | BIT(11));
+	meson_amvdec_write_dos(core, DOS_SW_RESET0, 0);
+	meson_amvdec_read_dos(core, DOS_SW_RESET0);
+	meson_amvdec_write_dos(core, MPSR, 1);
+	return 0;
+}
+
+#ifdef AMVDEC_OUCODE_DEV
+static void codec_mpeg12_sl_bench(struct amvdec_session *sess, struct codec_mpeg12_sl *m)
+{
+	u32 us = ktime_us_delta(ktime_get(), m->bench_t0);
+
+	if (!mpeg12_bench || !m->bench_t0)
+		return;
+	m->bench_sum += us;
+	m->bench_max = max(m->bench_max, us);
+	if (++m->bench_n % mpeg12_bench == 0) {
+		dev_info(sess->core->dev, "mpeg2 bench (open): %u pictures, avg %llu us, max %u us\n",
+			 m->bench_n, div_u64(m->bench_sum, m->bench_n), m->bench_max);
+	}
+}
+#else
+static inline void codec_mpeg12_sl_bench(struct amvdec_session *sess, struct codec_mpeg12_sl *m)
+{
+}
+#endif
+
+static irqreturn_t codec_mpeg12_sl_threaded_isr(struct amvdec_session *sess)
+{
+	struct codec_mpeg12_sl *m = sess->priv;
+	struct amvdec_core *core = sess->core;
+	bool concealed = false;
+	u32 st;
+
+	meson_amvdec_write_dos(core, ASSIST_MBOX1_CLR_REG, 1);
+
+	st = meson_amvdec_read_dos(core, AV_SCRATCH_0);
+	if (st != OSL_STATUS_DONE && st != OSL_STATUS_ERROR)
+		return IRQ_HANDLED;
+	if (st == OSL_STATUS_ERROR)
+		dev_err_ratelimited(core->dev,
+				    "MPEG-2: picture failed, firmware error %u after %u MBs\n",
+				    meson_amvdec_read_dos(core, AV_SCRATCH_2),
+				    meson_amvdec_read_dos(core, AV_SCRATCH_3));
+	else if (meson_amvdec_read_dos(core, AV_SCRATCH_2)) {
+		/* damaged slices were concealed: the picture is usable but flagged */
+		dev_dbg(core->dev, "MPEG-2: %u errors concealed\n",
+			meson_amvdec_read_dos(core, AV_SCRATCH_2));
+		concealed = true;
+	}
+	meson_amvdec_write_dos(core, AV_SCRATCH_0, 0);
+	codec_mpeg12_sl_bench(sess, m);
+	if (!sess->request_job.dst)
+		return IRQ_HANDLED;
+	if (m->cur_first_field) {
+		/* the second field comes as its own request, same CAPTURE buffer */
+		m->cur_first_field = false;
+		m->pair_pending = true;
+		m->pair_dst = sess->request_job.dst->vb2_buf.index;
+		m->pair_structure = m->cur_structure;
+		m->pair_temporal_ref = m->cur_temporal_ref;
+	}
+	if (st == OSL_STATUS_ERROR || concealed)
+		sess->request_job.error = true;
+	meson_amvdec_request_signal(sess, sess->request_job.dst);
+	return IRQ_HANDLED;
+}
+
+struct amvdec_codec_ops meson_amvdec_codec_mpeg12_sl_ops = {
+	.start = codec_mpeg12_sl_start,
+	.stop = codec_mpeg12_sl_stop,
+	.isr = codec_mpeg12_isr,
+	.threaded_isr = codec_mpeg12_sl_threaded_isr,
+};
