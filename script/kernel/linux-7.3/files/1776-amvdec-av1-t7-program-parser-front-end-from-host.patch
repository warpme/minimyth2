diff --speed-large-files --no-dereference --minimal -Naur -r a/drivers/media/platform/amlogic/amvdec/codec_av1.c b/drivers/media/platform/amlogic/amvdec/codec_av1.c
--- a/drivers/media/platform/amlogic/amvdec/codec_av1.c	2026-11-16 21:38:15.450831789 +0100
+++ b/drivers/media/platform/amlogic/amvdec/codec_av1.c	2026-11-16 21:38:15.530680009 +0100
@@ -440,6 +440,27 @@
 	meson_amvdec_write_dos(core, AV1_LMEM_DUMP_ADR, ws + AV1_LMEM_OFF);
 }
 
+/*
+ * The S4/SC2 AV1 microcode programs the stream and parser front-end itself.
+ * The T7 microcode leaves these registers at their reset values, never starts
+ * parsing and only answers AOM_NAL_DECODE_DONE (0x25) without a sequence or
+ * frame header. The vendor driver sets them from the host
+ * (aom_init_decoder_hw()/vav1_prot_init()); the values are what the S4
+ * microcode leaves in the registers while it decodes.
+ */
+static void av1_host_parser_init(struct amvdec_core *core)
+{
+	meson_amvdec_write_dos(core, HEVC_SHIFT_STARTCODE, 1);
+	meson_amvdec_write_dos(core, HEVC_SHIFT_EMULATECODE, 0x300);
+	meson_amvdec_write_dos(core, HEVC_CABAC_CONTROL, BIT(0));
+	meson_amvdec_write_dos(core, HEVC_PARSER_CORE_CONTROL, BIT(0));
+	meson_amvdec_write_dos(core, HEVC_PARSER_IF_CONTROL,
+			       BIT(5) | BIT(2) | BIT(0));
+	meson_amvdec_write_dos(core, HEVC_PARSER_INT_CONTROL, 0x6d400091);
+	/* start code check on */
+	meson_amvdec_write_dos_bits(core, HEVC_SHIFT_STATUS, BIT(0));
+}
+
 static int codec_av1_start(struct amvdec_session *sess)
 {
 	struct codec_av1 *av1;
@@ -462,6 +483,8 @@
 	}
 	sess->priv = av1;
 	av1_hw_init(sess, av1);
+	if (sess->core->platform->av1_host_parser)
+		av1_host_parser_init(sess->core);
 	return 0;
 }
 
