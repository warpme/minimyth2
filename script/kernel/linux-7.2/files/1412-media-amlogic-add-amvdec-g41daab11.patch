+    bne r11, #7, b1
+    nop
+    ori r13, r13, #0x1
+b1: beq r11, #7, b2
+    nop
+    ori r13, r13, #0x2
+b2: bgt r11, #7, b3
+    nop
+    ori r13, r13, #0x4
+b3: ble r11, #7, b4
+    nop
+    ori r13, r13, #0x8
+b4: bge r11, #7, b5
+    nop
+    ori r13, r13, #0x10
+b5: blt r11, #7, b6
+    nop
+    ori r13, r13, #0x20
+b6: xori r13, r13, #0x3f
+    ret
+    nop
+bcc_probe1:
+    movi r13, #0
+    bne r11, #1, c1
+    nop
+    ori r13, r13, #0x1
+c1: beq r11, #1, c2
+    nop
+    ori r13, r13, #0x2
+c2: bgt r11, #1, c3
+    nop
+    ori r13, r13, #0x4
+c3: ble r11, #1, c4
+    nop
+    ori r13, r13, #0x8
