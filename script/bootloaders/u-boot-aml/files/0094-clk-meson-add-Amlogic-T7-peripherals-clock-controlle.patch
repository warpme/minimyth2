+/*
+ * Amlogic T7 (A311D2) peripherals clock controller
+ *
+ * Register layout and bit positions follow the Linux
+ * drivers/clk/meson/t7-peripherals.c driver.
+ *
+ * On T7 the fixed PLL, the fdivX dividers and the sys clock are owned
+ * by the SCP firmware and exposed through SCMI. U-Boot does not touch
+ * them: they are taken as external inputs ("fdiv2", "sys", ...) from
+ * the device tree, typically as fixed-rate clocks set up by BL2.
+ *
+ * Following operations are supported:
+ * - calculating clock frequency on a limited tree
+ * - reading muxes and dividers
+ * - enabling/disabling gates without propagation
+ * - reparenting without rate propagation, only on muxes
+ * - setting rates with limited reparenting, only on the SD/eMMC
+ *   dividers with mux parent
+ */
+
+#include <clk-uclass.h>
+#include <dm.h>
+#include <regmap.h>
+#include <dt-bindings/clock/amlogic,t7-peripherals-clkc.h>
+#include "clk_meson.h"
+
+#define SYS_CLK_EN0_REG0	0x044
+#define SYS_CLK_EN0_REG1	0x048
+#define SYS_CLK_EN0_REG2	0x04c
+#define SYS_CLK_EN0_REG3	0x050
+#define ETH_CLK_CTRL		0x164
+#define NAND_CLK_CTRL		0x168
+#define SD_EMMC_CLK_CTRL	0x16c
+
+/* External clock IDs. Those should not overlap with regular IDs */
+enum {
+	EXTERNAL_XTAL = CLKID_SYS_PWM_AO_GH + 1,
+	EXTERNAL_FDIV2,
+	EXTERNAL_FDIV2P5,
+	EXTERNAL_FDIV3,
+	EXTERNAL_FDIV4,
+	EXTERNAL_FDIV5,
+	EXTERNAL_FDIV7,
+	EXTERNAL_HIFI,
+	EXTERNAL_MPLL2,
+	EXTERNAL_MPLL3,
+	EXTERNAL_GP0,
+	EXTERNAL_GP1,
+	EXTERNAL_SYS,
+};
+
+#define T7_SD_EMMC_PARENTS {	\
+	EXTERNAL_XTAL,		\
+	EXTERNAL_FDIV2,		\
+	EXTERNAL_FDIV3,		\
+	EXTERNAL_HIFI,		\
+	EXTERNAL_FDIV2P5,	\
+	EXTERNAL_MPLL2,		\
+	EXTERNAL_MPLL3,		\
+	EXTERNAL_GP0,		\
+}
+
+#define T7_SYS_GATE(_id, _name, _reg, _bit) \
+	[_id] = CLK_GATE(_name, _reg, _bit, EXTERNAL_SYS)
