diff --speed-large-files --no-dereference --minimal -Naur linux-7.2.6/drivers/staging/media/meson/vdec/vdec_platform.c linux-7.2.6/drivers/staging/media/meson/vdec/vdec_platform.c
--- linux-7.2.6/drivers/staging/media/meson/vdec/vdec_platform.c	2026-09-23 10:47:01.151665117 +0200
+++ linux-7.2.6/drivers/staging/media/meson/vdec/vdec_platform.c	2026-09-23 10:36:17.977994058 +0200
@@ -462,6 +462,67 @@
 	},
 };
 
+static const struct amvdec_format vdec_formats_sm1_stateless[] = {
+	{
+		/* The H.264 firmware parses complete Annex B pictures. */
+		.pixfmt = V4L2_PIX_FMT_H264_SLICE,
+		.min_buffers = 16,
+		.max_buffers = 24,
+		.max_width = 3840,
+		.max_height = 2160,
+		.vdec_ops = &vdec_1_ops,
+		.codec_ops = &codec_h264_ops,
+		.firmware_path = "meson/vdec/sm1_h264_multi.bin",
+		.pixfmts_cap = { V4L2_PIX_FMT_NV12M, 0 },
+		.flags = V4L2_FMT_FLAG_COMPRESSED,
+	}, {
+		/* Stateless requests feed whole VP9 frames through the HEVC parser. */
+		.pixfmt = V4L2_PIX_FMT_VP9_FRAME,
+		.min_buffers = 16,
+		.max_buffers = 24,
+		.max_width = 3840,
+		.max_height = 2160,
+		.vdec_ops = &vdec_hevc_ops,
+		.codec_ops = &codec_vp9_ops,
+		.firmware_path = "meson/vdec/sm1_vp9_mmu.bin",
+		.pixfmts_cap = { V4L2_PIX_FMT_NV12M, 0 },
+		.flags = V4L2_FMT_FLAG_COMPRESSED,
+	}, {
+		/* Use the SM1 HEVC firmware; MMU use is selected at runtime.
+		 * t.b.c is Main 10 or AM21C uses MMU; VPS/SPS/PPS are synthesized.
+		 */
+		.pixfmt = V4L2_PIX_FMT_HEVC_SLICE,
+		.min_buffers = 16,
+		.max_buffers = 24,
+		.max_width = 3840,
+		.max_height = 2160,
+		.vdec_ops = &vdec_hevc_ops,
+		.codec_ops = &codec_hevc_ops,
+		.firmware_path = "meson/vdec/sm1_hevc_mmu.bin",
+		.pixfmts_cap = { V4L2_PIX_FMT_NV12M,
+				 V4L2_PIX_FMT_MESON_AM21C, 0 },
+		.flags = V4L2_FMT_FLAG_COMPRESSED,
+	}, {
+		/*
+		 * Stateless MPEG-1/2.  The firmware parses picture headers, so
+		 * MPEG2_SLICE (slice data only) needs the sequence and picture
+		 * headers synthesized in-driver from the V4L2 controls, the same
+		 * way HEVC_SLICE does.
+		 */
+		.pixfmt = V4L2_PIX_FMT_MPEG2_SLICE,
+		.min_buffers = 2,
+		.max_buffers = 24,
+		.max_width = 1920,
+		/* 1080 lines are coded as 1088: whole macroblocks, in field pairs */
+		.max_height = 1088,
+		.vdec_ops = &vdec_1_ops,
+		.codec_ops = &codec_mpeg12_sl_ops,
+		.firmware_path = "meson/vdec/gxl_mpeg12_multi.bin",
+		.pixfmts_cap = { V4L2_PIX_FMT_NV12M, 0 },
+		.flags = V4L2_FMT_FLAG_COMPRESSED,
+	},
+};
+
 const struct vdec_platform vdec_platform_gxbb = {
 	.formats = vdec_formats_gxbb,
 	.num_formats = ARRAY_SIZE(vdec_formats_gxbb),
@@ -504,6 +565,12 @@
 	.revision = VDEC_REVISION_SM1,
 };
 
+const struct vdec_platform vdec_platform_sm1_stateless = {
+	.formats = vdec_formats_sm1_stateless,
+	.num_formats = ARRAY_SIZE(vdec_formats_sm1_stateless),
+	.revision = VDEC_REVISION_SM1,
+};
+
 MODULE_FIRMWARE("meson/vdec/g12a_h264.bin");
 MODULE_FIRMWARE("meson/vdec/g12a_vp9.bin");
 MODULE_FIRMWARE("meson/vdec/gxbb_h264.bin");

