 .../media/platform/amlogic/amvdec/amvdec.h    |  35 ++++++
 .../platform/amlogic/amvdec/amvdec_helpers.c  |  34 ++++++
 .../platform/amlogic/amvdec/codec_h264.c      |   6 ++
 .../platform/amlogic/amvdec/codec_hevc.c      |  11 ++
