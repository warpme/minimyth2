+
+#define CLK_SERDES_USB3_HCLK	0
+#define CLK_SERDES_USB3_ACLK	1
+#define CLK_SERDES_USB3_PIPE	2
+
+#endif /* _DT_BINDINGS_CLK_SUN60I_A733_SERDES_CCU_H_ */
