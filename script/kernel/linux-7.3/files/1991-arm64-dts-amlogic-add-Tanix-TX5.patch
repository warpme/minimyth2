
From: Piotr Oniszczuk <piotr.oniszczuk@gmail.com>
Subject: [PATCH] arm64: dts: amlogic: add Tanix TX5

Add the device tree of the Tanix TX5 TV box (Amlogic S905Y5, 2 GiB RAM),
based on its Android device tree. It enables the serial console, the SD
card, the eMMC, the 10/100 ethernet, USB ports, HDMI, HDMI audio, video
decoder, CEC, IR, THS and 7-seg diplay LED.

Signed-off-by: Piotr Oniszczuk <piotr.oniszczuk@gmail.com>

diff --speed-large-files --no-dereference --minimal -Naur linux-7.3.6/arch/arm64/boot/dts/amlogic/amlogic-s7-s905y5-tanix-tx5.dts linux-7.3.6/arch/arm64/boot/dts/amlogic/amlogic-s7-s905y5-tanix-tx5.dts
--- linux-7.3.6/arch/arm64/boot/dts/amlogic/amlogic-s7-s905y5-tanix-tx5.dts	1970-01-01 01:00:00.000000000 +0100
+++ linux-7.3.6/arch/arm64/boot/dts/amlogic/amlogic-s7-s905y5-tanix-tx5.dts	2026-11-27 09:54:04.347286044 +0100
@@ -0,0 +1,278 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+/*
+ * Copyright (c) 2026 Piotr Oniszczuk <piotr.oniszczuk@gmail.com>
+ *
+ * Based on the Amlogic S7 BSP device tree of the Tanix TX5 (s7_s905y5_bh201)
+ */
+
+/dts-v1/;
+
+#include "amlogic-s7.dtsi"
+//#include <dt-bindings/leds/common.h>
+
+/ {
+	model = "Tanix TX5";
+	compatible = "oranth,tx5", "amlogic,s7";
+	interrupt-parent = <&gic>;
+	#address-cells = <2>;
+	#size-cells = <2>;
+
+	aliases {
+		serial0 = &uart_b;
+		mmc1 = &emmc;
+		mmc0 = &sd;
+		ethernet0 = &ethmac;
+	};
+
+	chosen {
+		stdout-path = "serial0:921600n8";
+	};
+
+	memory@0 {
+		device_type = "memory";
+		reg = <0x0 0x0 0x0 0x80000000>;
+	};
+
+	reserved-memory {
+		#address-cells = <2>;
+		#size-cells = <2>;
+		ranges;
+
+		/* 35 MiB reserved for ARM Trusted Firmware */
+		secmon_reserved: secmon@5000000 {
+			compatible = "shared-dma-pool";
+			reg = <0x0 0x05000000 0x0 0x2300000>;
+			no-map;
+		};
+	};
+
+	hdmi-connector {
+		compatible = "hdmi-connector";
+		type = "a";
+
+		port {
+			hdmi_connector_in: endpoint {
+				remote-endpoint = <&hdmi_tx_tmds_out>;
+			};
+		};
+	};
+
+	emmc_pwrseq: emmc-pwrseq {
+		compatible = "mmc-pwrseq-emmc";
+		reset-gpios = <&gpiob 9 GPIO_ACTIVE_LOW>;
+	};
+
+	main_12v: regulator-main-12v {
+		compatible = "regulator-fixed";
+		regulator-name = "12V";
+		regulator-min-microvolt = <12000000>;
+		regulator-max-microvolt = <12000000>;
+		regulator-always-on;
+	};
+
+	vddao_3v3: regulator-vddao-3v3 {
+		compatible = "regulator-fixed";
+		regulator-name = "VDDAO_3V3";
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+		vin-supply = <&main_12v>;
+		regulator-always-on;
+	};
+
+	usb_pwr: regulator-usb-pwr {
+		compatible = "regulator-fixed";
+		regulator-name = "USB_PWR";
+		regulator-min-microvolt = <5000000>;
+		regulator-max-microvolt = <5000000>;
+		gpio = <&gpioh 8 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+	};
+
+	vddio_ao1v8: regulator-vddio-ao1v8 {
+		compatible = "regulator-fixed";
+		regulator-name = "VDD_AO18_LDO";
+		regulator-min-microvolt = <1800000>;
+		regulator-max-microvolt = <1800000>;
+		vin-supply = <&vddao_3v3>;
+		regulator-always-on;
+	};
+
+	sound {
+		compatible = "amlogic,axg-sound-card";
+		model = "TANIX-TX5";
+		audio-aux-devs = <&tdmout_b>;
+		audio-routing = "TDMOUT_B IN 0", "FRDDR_A OUT 1",
+				"TDMOUT_B IN 1", "FRDDR_B OUT 1",
+				"TDMOUT_B IN 2", "FRDDR_C OUT 1",
+				"TDM_B Playback", "TDMOUT_B OUT";
+		clocks = <&clkc_pll CLKID_HIFI_PLL>,
+			 <&clkc_pll CLKID_HIFI1_PLL>;
+		assigned-clocks = <&clkc_pll CLKID_HIFI_PLL>,
+				  <&clkc_pll CLKID_HIFI1_PLL>;
+		assigned-clock-rates = <491520000>,
+				       <451584000>;
+
+		dai-link-0 {
+			sound-dai = <&frddr_a>;
+		};
+
+		dai-link-1 {
+			sound-dai = <&frddr_b>;
+		};
+
+		dai-link-2 {
+			sound-dai = <&frddr_c>;
+		};
+
+		dai-link-3 {
+			sound-dai = <&tdmif_b>;
+			dai-format = "i2s";
+			dai-tdm-slot-tx-mask-0 = <1 1>;
+			mclk-fs = <256>;
+
+			codec {
+				sound-dai = <&tohdmitx TOHDMITX_I2S_IN_B>;
+			};
+		};
+
+		dai-link-4 {
+			sound-dai = <&tohdmitx TOHDMITX_I2S_OUT>;
+
+			codec {
+				sound-dai = <&hdmi_tx>;
+			};
+		};
+	};
+
+	openvfd {
+		compatible = "open,vfd";
+		dev_name = "openvfd";
+		openvfd_gpio_clk = <&gpiod 7 GPIO_ACTIVE_HIGH>;
+		openvfd_gpio_dat = <&gpiod 6 GPIO_ACTIVE_HIGH>;
+		openvfd_gpio_stb = <&gpiod 5 GPIO_ACTIVE_HIGH>;
+		openvfd_chars = [02 01 02 03 04];
+		openvfd_dot_bits = [01 00 03 04 02 05 06];
+		openvfd_display_type = <0x03000000>;
+		status = "okay";
+	};
+};
+
+&uart_b {
+	status = "okay";
+};
+
+&vpu {
+	status = "okay";
+};
+
+&gpu {
+	status = "okay";
+};
+
+&hdmi_tx {
+	pinctrl-0 = <&hdmitx_hpd_pins>, <&hdmitx_ddc_pins>;
+	pinctrl-names = "default";
+	status = "okay";
+};
+
+&hdmi_tx_tmds_port {
+	hdmi_tx_tmds_out: endpoint {
+		remote-endpoint = <&hdmi_connector_in>;
+	};
+};
+
+&ethmac {
+	pinctrl-0 = <&eth_led_pins>;
+	pinctrl-names = "default";
+	phy-handle = <&internal_ephy>;
+	phy-mode = "rmii";
+	status = "okay";
+};
+
+&ir {
+	linux,rc-map-name = "rc-beelink-gs1";
+	pinctrl-0 = <&remote_input_pins>;
+	pinctrl-names = "default";
+	status = "okay";
+};
+
+&sd {
+	pinctrl-0 = <&sdcard_pins>;
+	pinctrl-1 = <&sdcard_clk_gate_pins>;
+	pinctrl-names = "default", "clk-gate";
+	bus-width = <4>;
+	cap-sd-highspeed;
+	max-frequency = <52000000>;
+	disable-wp;
+	cd-gpios = <&gpioc 6 GPIO_ACTIVE_LOW>;
+	vmmc-supply = <&vddao_3v3>;
+	vqmmc-supply = <&vddao_3v3>;
+	status = "okay";
+};
+
+/*
+ * The bootloader starts the CPUs at 1704 MHz and sets VDDCPU (PWM J) for
+ * that rate
+ * tests shows PWM J registers are readable but NOT writable from the
+ * non-secure world (writes silently dropped). VDDCPU always stays at
+ * the boot ~989 mV. SCMI rate requests are ignored. No error in dmesg.
+ * It looks on this box TEE limits CPU clocks always to 1704MHz
+ * Higher OPP will require changed vendor TEE.
+ */
+&cpu0 {
+	operating-points-v2 = <&cpu_opp_table>;
+};
+
+&cpu1 {
+	operating-points-v2 = <&cpu_opp_table>;
+};
+
+&cpu2 {
+	operating-points-v2 = <&cpu_opp_table>;
+};
+
+&cpu3 {
+	operating-points-v2 = <&cpu_opp_table>;
+};
+
+&cecb {
+	pinctrl-0 = <&hdmitx_cec_pins>;
+	pinctrl-names = "default";
+	status = "okay";
+};
+
+&emmc {
+	pinctrl-0 = <&emmc_pins>, <&emmc_clk_pins>, <&emmc_ds_pins>;
+	pinctrl-1 = <&emmc_clk_gate_pins>;
+	pinctrl-names = "default", "clk-gate";
+	bus-width = <8>;
+	cap-mmc-highspeed;
+	max-frequency = <52000000>;
+	non-removable;
+	disable-wp;
+	mmc-pwrseq = <&emmc_pwrseq>;
+	vmmc-supply = <&vddao_3v3>;
+	vqmmc-supply = <&vddio_ao1v8>;
+	status = "okay";
+};
+
+&vdec {
+	status = "okay";
+};
+
+&usb0 {
+	status = "okay";
+};
+
+&usb1 {
+	status = "okay";
+};
+
+&usb2_phy0 {
+	phy-supply = <&usb_pwr>;
+	status = "okay";
+};
+
+&usb2_phy1 {
+	status = "okay";
+};
diff --speed-large-files --no-dereference --minimal -Naur linux-7.3.6/arch/arm64/boot/dts/amlogic/Makefile linux-7.3.6/arch/arm64/boot/dts/amlogic/Makefile
--- linux-7.3.6/arch/arm64/boot/dts/amlogic/Makefile	2026-11-27 10:16:26.641344446 +0100
+++ linux-7.3.6/arch/arm64/boot/dts/amlogic/Makefile	2026-11-27 10:15:30.725797486 +0100
@@ -7,6 +7,7 @@
 dtb-$(CONFIG_ARCH_MESON) += amlogic-s6-s905x5-bl201.dtb
 dtb-$(CONFIG_ARCH_MESON) += amlogic-s6-s905x5-bl209.dtb
 dtb-$(CONFIG_ARCH_MESON) += amlogic-s7-s805x3-bp201.dtb
+dtb-$(CONFIG_ARCH_MESON) += amlogic-s7-s905y5-tanix-tx5.dtb
 dtb-$(CONFIG_ARCH_MESON) += amlogic-s7d-s905x5m-bm202.dtb
 dtb-$(CONFIG_ARCH_MESON) += amlogic-t7-a311d2-an400.dtb
 dtb-$(CONFIG_ARCH_MESON) += amlogic-t7-a311d2-khadas-vim4.dtb
