+    mtspi M4_CONTROL_REG, #0
+    mtspi VLD_STATUS_CTRL, #2
+    movi r20, #0
+    movi r25, #0x9999
+    movi r26, #0
+    movi r21, #0xffff
+    movhi r21, #0x00ff
+w:  mfsp r7, VLD_STATUS_CTRL
