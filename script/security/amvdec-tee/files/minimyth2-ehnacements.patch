+static void fill_entry(struct pack_entry *e, const uint8_t *buf, size_t off)
+{
+	const uint8_t *h1 = buf + off;
+	const uint8_t *h2 = buf + off + ENTRY_ALIGN;
+
+	e->offset = off;
+	e->data_offset = off + ENTRY_HDR_SIZE;
+	copy_field(e->name, h1 + 0x00, NAME_LEN);
+	copy_field(e->format, h1 + 0x20, NAME_LEN);
+	copy_field(e->soc, h1 + 0x40, NAME_LEN);
+	e->crc = le32(h2 + 4);
+	copy_field(e->version, h2 + 0x58, NAME_LEN);
+	copy_field(e->author, h2 + 0x78, NAME_LEN);
+	copy_field(e->date, h2 + 0x98, NAME_LEN);
+	e->timestamp = le32(h2 + 0xcc);
+}
