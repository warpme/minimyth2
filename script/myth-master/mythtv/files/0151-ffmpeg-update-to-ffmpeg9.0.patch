diff --git a/mythtv/external/FFmpeg/libavfilter/vf_pp7dsp.h b/mythtv/external/FFmpeg/libavfilter/vf_pp7dsp.h
new file mode 100644
index 00000000000..cb405f4f581
--- /dev/null
+++ b/mythtv/external/FFmpeg/libavfilter/vf_pp7dsp.h
@@ -0,0 +1,65 @@
+/*
+ * Copyright (c) 2005 Michael Niedermayer <michaelni@gmx.at>
+ * Copyright (c) 2014 Arwa Arif <arwaarif1994@gmail.com>
+ *
+ * This file is part of FFmpeg.
