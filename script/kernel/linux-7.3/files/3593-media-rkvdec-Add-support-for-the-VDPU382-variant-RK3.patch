@@ -625,6 +625,15 @@ static int rkvdec_hevc_run(struct rkvdec_ctx *ctx)
 
 static int rkvdec_hevc_try_ctrl(struct rkvdec_ctx *ctx, struct v4l2_ctrl *ctrl)
 {
+	if (ctx->dev->variant->is_vdpu382 &&
+	    ctrl->id == V4L2_CID_STATELESS_HEVC_SPS) {
+		const struct v4l2_ctrl_hevc_sps *sps = ctrl->p_new.p_hevc_sps;
+
+		/* VDPU382 only supports 8-bit and 10-bit 4:2:0 HEVC */
+		if (sps->chroma_format_idc != 1)
+			return -EINVAL;
+	}
+
 	if (ctrl->id == V4L2_CID_STATELESS_HEVC_SPS)
 		return rkvdec_hevc_validate_sps(ctx, ctrl->p_new.p_hevc_sps);
 
