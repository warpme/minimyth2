+; 0xfffffffd (-3) * 5: SCRATCH_3 = low32 (0xfffffff1 either way),
+;   SCRATCH_4 = >>32 (0xffffffff if signed multiply, 0x4 if unsigned)
+; SCRATCH_5.._8 = mfmul with m=1,2,3,4 (a=0) on the first product
+; SCRATCH_9 = 0xdd end; SCRATCH_A = MAC_CTRL1 readback
