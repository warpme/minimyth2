index b7cce25d57..a95811387c 100644
--- a/drivers/media/platform/amlogic/amvdec/esparser.c
+++ b/drivers/media/platform/amlogic/amvdec/esparser.c
@@ -21,6 +21,7 @@
 
 #include "dos_regs.h"
 #include "esparser.h"
+#include "amvdec_hevc.h"
 #include "codec_vc1.h"
 #include "amvdec_helpers.h"
 #include "codec_h264_synth.h"
@@ -564,6 +565,30 @@ esparser_queue(struct amvdec_session *sess, struct vb2_v4l2_buffer *vbuf)
 			}
 			if (!offset)
 				sess->bitdepth = f->vp9_frame.bit_depth;
+			/*
+			 * The 2 GiB restart (see meson_amvdec_codec_vp9_arm_restream()) is
+			 * only safe before a key frame. A VP9 inter frame may
+			 * take its size from a reference, and the firmware
+			 * resolves that from state a restart wipes: the next
+			 * header parses as 0x0. Backward-adapted probability
+			 * contexts are lost the same way. A key frame codes its
+			 * size and resets both, so wait for one. The previous
+			 * picture is complete and nothing is queued, so the
+			 * FIFO holds nothing to lose; recompute this buffer's
+			 * offset on the restarted scale.
+			 */
+			if (meson_amvdec_codec_vp9_restream_pending(sess) &&
+			    (f->vp9_frame.flags & V4L2_VP9_FRAME_FLAG_KEY_FRAME) &&
+			    !sess->should_stop &&
+			    !atomic_read(&sess->esparser_queued_bufs)) {
+				ret = meson_amvdec_hevc_restream(sess);
+				if (ret) {
+					dev_err(core->dev, "VP9 restream failed (%d)\n", ret);
+					esparser_src_error(sess, vbuf);
+					return ret;
+				}
+				offset = esparser_get_offset(sess);
+			}
 			vp9_frame_ptr = &f->vp9_frame;
 		} else if (sess->fmt_out->pixfmt == V4L2_PIX_FMT_HEVC_SLICE) {
 			u8 *vaddr = vb2_plane_vaddr(vb, 0);
@@ -1203,6 +1228,26 @@ void meson_amvdec_esparser_queue_all_src(struct work_struct *work)
 			 meson_amvdec_codec_h264_multi_busy(sess), q);
 	}
 
+	/*
+	 * The stream position counter must not reach 0x80000000. Restart the
+	 * core here, before anything is fed: the firmware is parked after a
+	 * completed picture and the VIFIFO is empty, so nothing is lost.
+	 * VP9 restarts at a key frame instead: see esparser_queue().
+	 */
+	if (sess->fmt_out->pixfmt == V4L2_PIX_FMT_HEVC_SLICE &&
+	    meson_amvdec_codec_hevc_restream_pending(sess) &&
+	    !sess->should_stop && !sess->hevc_draining &&
+	    !atomic_read(&sess->esparser_queued_bufs)) {
+		ret = meson_amvdec_hevc_restream(sess);
+		if (ret) {
+			dev_err(sess->core->dev,
+				"HEVC restream failed (%d)\n", ret);
+			meson_amvdec_abort(sess);
+			mutex_unlock(&sess->lock);
+			return;
+		}
+	}
+
 	v4l2_m2m_for_each_src_buf_safe(sess->m2m_ctx, buf, n) {
 		if (sess->should_stop ||
 		    (sess->hevc_draining && sess->hevc_input_done))
