DEFAULT MiniMyth2
MENU TITLE Boot Menu
PROMPT 0
TIMEOUT 0

LABEL MiniMyth2
  LINUX /mm2-nfs-networkboot-arm64-latest/boot/Image
  FDT   /mm2-nfs-networkboot-arm64-latest/boot/dtbs/qcom/qcs6490-radxa-dragon-q6a.dtb

  # to overwrite edid add: drm.edid_firmware=edid/s2-tek.bin
  # to force hdmi instead of dvi add: video=HDMI-A-1:e

  # mount nfsroot with DHCP
  APPEND root=/dev/nfs nfsroot=192.168.1.254:/var/tftpboot/PXEclient/mm2-nfs-networkboot-arm64-latest/rootfs,v3 ip=dhcp console=ttyMSM0,115200n8 earlycon consoleblank=0 console=tty1 coherent_pool=2M irqchip.gicv3_pseudo_nmi=0 debug

