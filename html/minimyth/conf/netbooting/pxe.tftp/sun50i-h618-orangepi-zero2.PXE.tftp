DEFAULT MiniMyth2
MENU TITLE Boot Menu
PROMPT 0
TIMEOUT 0

LABEL MiniMyth2
  LINUX /mm2-nfs-networkboot-latest/boot/Image
  FDT   /mm2-nfs-networkboot-latest/boot/dtbs/allwinner/sun50i-h616-orangepi-zero2.dtb

  # to overwrite edid add: drm.edid_firmware=edid/s2-tek.bin
  # to force hdmi instead of dvi add: video=HDMI-A-1:e

  APPEND root=/dev/nfs nfsroot=192.168.1.254:/var/tftpboot/PXEclient/mm2-nfs-networkboot-latest/rootfs,v3 ip=dhcp earlycon console=ttyS0,115200n8 debug
