+        ldr             r7,  [r2, #4]
+        ldr_post        r6,  r2,  r3
+        ldrd_post       r8,  r9,  r0,  r1
+        usada8          r12,  r4,  r6,  r12
+        pld             [r2, r3]
+        usada8          lr,  r5,  r7,  lr
+        ldr             r7,  [r2, #4]
+        ldr_post        r6,  r2,  r3
+        beq             2f
+        ldrd_post       r4,  r5,  r0,  r1
+        usada8          r12,  r8,  r6,  r12
+        pld             [r2, r3]
+        usada8          lr,  r9,  r7,  lr
+        b               1b
