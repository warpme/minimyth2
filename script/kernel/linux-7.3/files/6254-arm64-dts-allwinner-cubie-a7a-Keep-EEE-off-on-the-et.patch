From 882dab950e510d3f0046697eaa662760e1c86e40 Mon Sep 17 00:00:00 2001
From: Jernej Skrabec <jernej.skrabec@gmail.com>
Date: Sat, 5 Sep 2026 14:53:24 +0200
Subject: [PATCH 208/211] arm64: dts: allwinner: cubie-a7a: Keep EEE off on the
 ethernet PHY

With Energy Efficient Ethernet negotiated the gigabit link drops every
few minutes under load and sometimes comes back with the data path
dead until the interface is bounced. The 1000BASE-T idle error counter
saturates and the MAC reports EEE wake-up errors; with the EEE
advertisement cleared the link ran for a quarter of an hour under load
with no drop and no idle error. The vendor driver for this Maxio PHY
clears the EEE advertisement outright, so mark both modes broken.

Signed-off-by: Jernej Skrabec <jernej.skrabec@gmail.com>
---
 arch/arm64/boot/dts/allwinner/sun60i-a733-cubie-a7a.dts | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/arch/arm64/boot/dts/allwinner/sun60i-a733-cubie-a7a.dts b/arch/arm64/boot/dts/allwinner/sun60i-a733-cubie-a7a.dts
index 19ee6a0c1a..33babe5ac9 100644
--- a/arch/arm64/boot/dts/allwinner/sun60i-a733-cubie-a7a.dts
+++ b/arch/arm64/boot/dts/allwinner/sun60i-a733-cubie-a7a.dts
@@ -192,6 +192,13 @@ ext_rgmii_phy: ethernet-phy@1 {
 		reset-gpios = <&pio 7 16 GPIO_ACTIVE_LOW>; /* PH16 */
 		reset-assert-us = <10000>;
 		reset-deassert-us = <150000>;
+		/*
+		 * With EEE negotiated the link drops every few minutes under
+		 * load and comes back with a dead data path; the vendor driver
+		 * for this PHY clears the EEE advertisement outright.
+		 */
+		eee-broken-100tx;
+		eee-broken-1000t;
 	};
 };
 
