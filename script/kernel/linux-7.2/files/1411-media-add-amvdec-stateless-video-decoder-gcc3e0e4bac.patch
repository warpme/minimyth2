diff --speed-large-files --no-dereference --minimal -Naur linux-7.2.7/drivers/staging/media/meson/amvdec/Kconfig linux-7.2.7/drivers/staging/media/meson/amvdec/Kconfig
--- linux-7.2.7/drivers/staging/media/meson/amvdec/Kconfig	1970-01-01 01:00:00.000000000 +0100
+++ linux-7.2.7/drivers/staging/media/meson/amvdec/Kconfig	2026-09-24 06:19:43.000000000 +0200
@@ -0,0 +1,19 @@
+# SPDX-License-Identifier: GPL-2.0
+
+config VIDEO_MESON_AMVDEC
+	tristate "Amlogic video decoder driver"
+	depends on VIDEO_DEV && HAS_DMA
+	select MEDIA_CONTROLLER
+	depends on ARCH_MESON || COMPILE_TEST
+	select VIDEOBUF2_DMA_CONTIG
+	select V4L2_MEM2MEM_DEV
+	select V4L2_H264
+	select MESON_CANVAS
+	help
+	Support for the video decoder found in the Amlogic GXBB, GXL, GXM,
+	G12A, G12B and SM1 SoCs: stateful MPEG-1/2, MPEG-4, H.263, VC-1,
+	H.264, HEVC and VP9 decoding, and with stateless=1 the request-API
+	MPEG-2, H.264, HEVC and VP9 slice formats.
+
+	To compile this driver as a module, choose M here: the module will
+	be called meson-amvdec.
diff --speed-large-files --no-dereference --minimal -Naur linux-7.2.7/drivers/staging/media/meson/amvdec/Makefile linux-7.2.7/drivers/staging/media/meson/amvdec/Makefile
