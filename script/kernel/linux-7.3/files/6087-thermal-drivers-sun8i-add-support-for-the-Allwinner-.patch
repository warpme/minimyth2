diff --speed-large-files --no-dereference --minimal -Naur linux-7.3-rc3/drivers/thermal/sun8i_thermal.c linux-7.3-rc3/drivers/thermal/sun8i_thermal.c
--- linux-7.3-rc3/drivers/thermal/sun8i_thermal.c	2026-09-16 21:59:42.838381784 +0200
+++ linux-7.3-rc3/drivers/thermal/sun8i_thermal.c	2026-09-16 21:59:18.151333843 +0200
@@ -25,7 +25,7 @@
 
 #include "thermal_hwmon.h"
 
-#define MAX_SENSOR_NUM	4
+#define MAX_SENSOR_NUM	5
 
 #define FT_TEMP_MASK				GENMASK(11, 0)
 #define TEMP_CALIB_MASK				GENMASK(11, 0)
@@ -65,6 +65,16 @@
 #define SUN55I_A523_SCALE_ABOVE			74
 #define SUN55I_A523_SCALE_BELOW			65
 
+/*
+ * The A733 curve is described by two straight lines rather than one, and the
+ * register value falls as the temperature rises.
+ */
+#define SUN60I_A733_THS_KNEE			1769
+#define SUN60I_A733_THS_OFFSET_HOT		(-2822)
+#define SUN60I_A733_THS_SCALE_HOT		(-62)
+#define SUN60I_A733_THS_OFFSET_COLD		(-2835)
+#define SUN60I_A733_THS_SCALE_COLD		(-59)
+
 struct tsensor {
 	struct ths_device		*tmdev;
 	struct thermal_zone_device	*tzd;
@@ -111,6 +121,17 @@
 	return tmdev->chip->offset - (reg * tmdev->chip->scale / 10);
 }
 
+static int sun60i_a733_calc_temp(struct ths_device *tmdev,
+				 int id, int reg)
+{
+	if (reg > SUN60I_A733_THS_KNEE)
+		return (reg + SUN60I_A733_THS_OFFSET_HOT) *
+		       SUN60I_A733_THS_SCALE_HOT;
+
+	return (reg + SUN60I_A733_THS_OFFSET_COLD) *
+	       SUN60I_A733_THS_SCALE_COLD;
+}
+
 static int sun50i_h5_calc_temp(struct ths_device *tmdev,
 			       int id, int reg)
 {
@@ -598,6 +619,64 @@
 	return 0;
 }
 
+/* Pull one of the packed 12-bit fields out of the calibration blob. */
+static u32 sun60i_a733_ths_caldata_field(u16 *caldata, int index)
+{
+	int bit = index * 12;
+	u32 word;
+
+	word = caldata[bit / 16] | (u32)caldata[bit / 16 + 1] << 16;
+
+	return (word >> (bit % 16)) & TEMP_CALIB_MASK;
+}
+
+static int sun60i_a733_ths_calibrate(struct ths_device *tmdev,
+				     u16 *caldata, int callen)
+{
+	struct device *dev = tmdev->dev;
+	int i, ft_temp;
+
+	if (callen < 12)
+		return -EINVAL;
+
+	/*
+	 * The efuse holds the ambient temperature of the factory test, in
+	 * tenths of a degree, followed by what each sensor read at that
+	 * temperature, as seven 12-bit fields packed back to back.
+	 */
+	ft_temp = sun60i_a733_ths_caldata_field(caldata, 0);
+	if (!ft_temp)
+		return 0;
+
+	for (i = 0; i < tmdev->chip->sensor_num; i++) {
+		int sensor_reg, sensor_temp, cdata, offset;
+
+		sensor_reg = sun60i_a733_ths_caldata_field(caldata, i + 1);
+		sensor_temp = tmdev->chip->calc_temp(tmdev, i, sensor_reg);
+
+		/*
+		 * Turn the difference between what the sensor read and what
+		 * it should have read back into register counts, and offset
+		 * the sensor by it.
+		 */
+		cdata = CALIBRATE_DEFAULT -
+			(ft_temp * 100 - sensor_temp) /
+			SUN60I_A733_THS_SCALE_HOT;
+		if (cdata & ~TEMP_CALIB_MASK) {
+			dev_warn(dev, "sensor%d is not calibrated.\n", i);
+			continue;
+		}
+
+		offset = (i % 2) * 16;
+		regmap_update_bits(tmdev->regmap,
+				   SUN50I_H6_THS_TEMP_CALIB + (i / 2 * 4),
+				   TEMP_CALIB_MASK << offset,
+				   cdata << offset);
+	}
+
+	return 0;
+}
+
 static int sun50i_h6_thermal_init(struct ths_device *tmdev)
 {
 	int val;
@@ -860,6 +939,17 @@
 	.calc_temp = sun55i_a523_calc_temp,
 };
 
+static const struct ths_thermal_chip sun60i_a733_ths = {
+	.sensor_num = 5,
+	.has_mod_clk = true,
+	.has_bus_clk_reset = true,
+	.temp_data_base = SUN50I_H6_THS_TEMP_DATA,
+	.calibrate = sun60i_a733_ths_calibrate,
+	.init = sun50i_h6_thermal_init,
+	.irq_ack = sun50i_h6_irq_ack,
+	.calc_temp = sun60i_a733_calc_temp,
+};
+
 static const struct of_device_id of_ths_match[] = {
 	{ .compatible = "allwinner,sun8i-a83t-ths", .data = &sun8i_a83t_ths },
 	{ .compatible = "allwinner,sun8i-h3-ths", .data = &sun8i_h3_ths },
@@ -872,6 +962,7 @@
 	{ .compatible = "allwinner,sun50i-h616-ths", .data = &sun50i_h616_ths },
 	{ .compatible = "allwinner,sun55i-a523-ths0", .data = &sun55i_a523_ths0 },
 	{ .compatible = "allwinner,sun55i-a523-ths1", .data = &sun55i_a523_ths1 },
+	{ .compatible = "allwinner,sun60i-a733-ths", .data = &sun60i_a733_ths },
 	{ /* sentinel */ },
 };
 MODULE_DEVICE_TABLE(of, of_ths_match);
