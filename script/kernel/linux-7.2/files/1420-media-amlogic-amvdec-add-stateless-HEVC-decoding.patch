+		if (s->flags & ~V4L2_HEVC_EXT_SPS_ST_RPS_FLAG_INTER_REF_PIC_SET_PRED ||
+		    s->num_negative_pics + s->num_positive_pics > HEVC_RPS_MAX_REFS)
+			return -EINVAL;
