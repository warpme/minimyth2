diff --git a/mythtv/external/FFmpeg/tests/checkasm/hevc_pred.c b/mythtv/external/FFmpeg/tests/checkasm/hevc_pred.c
new file mode 100644
index 00000000000..a1662174413
--- /dev/null
+++ b/mythtv/external/FFmpeg/tests/checkasm/hevc_pred.c
@@ -0,0 +1,350 @@
