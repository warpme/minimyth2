From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Piotr Oniszczuk <piotr.oniszczuk@gmail.com>
Date: Thu, 26 Nov 2026 17:10:36 +0100
Subject: [PATCH] arm64: dts: amlogic: s7: add USB controllers and PHYs

Add the two USB controllers of the Amlogic S7 SoC. They are the CRG
xHCI controllers of the S6, each with a USB2 PHY; S7 has no USB3.
The controller at 0x350000 with PHY 0 is the OTG capable one, as in
the vendor device tree.

Signed-off-by: Piotr Oniszczuk <piotr.oniszczuk@gmail.com>
---
 arch/arm64/boot/dts/amlogic/amlogic-s7.dtsi | 64 +++++++++++++++++++++
 1 file changed, 64 insertions(+)

diff --git a/arch/arm64/boot/dts/amlogic/amlogic-s7.dtsi b/arch/arm64/boot/dts/amlogic/amlogic-s7.dtsi
index 6b888ee..44dc822 100644
--- a/arch/arm64/boot/dts/amlogic/amlogic-s7.dtsi
+++ b/arch/arm64/boot/dts/amlogic/amlogic-s7.dtsi
@@ -1070,6 +1070,70 @@
 				resets = <&clkc_audio AUD_RESET_PDM>;
 			};
 
+			/*
+			 * USB. Two CRG (xHCI) controllers with one USB2 PHY each,
+			 * no USB3 on S7. usb0 (with PHY 0) is the OTG capable one.
+			 */
+			usb1: usb@340000 {
+				compatible = "amlogic,s7-xhci", "amlogic,s6-xhci";
+				reg = <0x0 0x340000 0x0 0x8000>;
+				interrupts = <GIC_SPI 130 IRQ_TYPE_EDGE_RISING>;
+				clocks = <&clkc_periphs CLKID_SYS_USB>;
+				clock-names = "core";
+				resets = <&reset RESET_USB1>;
+				power-domains = <&pwrc PWRC_S7_USB_COMB_ID>;
+				phys = <&usb2_phy1>;
+				phy-names = "usb2-phy";
+				dr_mode = "host";
+				usb2-lpm-disable;
+				status = "disabled";
+			};
+
+			usb2_phy1: phy@348000 {
+				compatible = "amlogic,s7-usb2-phy";
+				reg = <0x0 0x348000 0x0 0x10>,
+				      <0x0 0x34c000 0x0 0x60>,
+				      <0x0 0x10330 0x0 0x4>;
+				reg-names = "ctrl", "cfg", "trim";
+				clocks = <&clkc_periphs CLKID_SYS_USB>;
+				clock-names = "general";
+				resets = <&reset RESET_USBPHY21>,
+					 <&reset RESET_USB1_COMB>;
+				reset-names = "phy", "comb";
+				#phy-cells = <0>;
+				status = "disabled";
+			};
+
+			usb0: usb@350000 {
+				compatible = "amlogic,s7-xhci", "amlogic,s6-xhci";
+				reg = <0x0 0x350000 0x0 0x8000>;
+				interrupts = <GIC_SPI 131 IRQ_TYPE_EDGE_RISING>;
+				clocks = <&clkc_periphs CLKID_SYS_USB>;
+				clock-names = "core";
+				resets = <&reset RESET_USB0>;
+				power-domains = <&pwrc PWRC_S7_USB_COMB_ID>;
+				phys = <&usb2_phy0>;
+				phy-names = "usb2-phy";
+				dr_mode = "host";
+				usb2-lpm-disable;
+				status = "disabled";
+			};
+
+			usb2_phy0: phy@358000 {
+				compatible = "amlogic,s7-usb2-phy";
+				reg = <0x0 0x358000 0x0 0x10>,
+				      <0x0 0x35c000 0x0 0x60>,
+				      <0x0 0x10330 0x0 0x4>;
+				reg-names = "ctrl", "cfg", "trim";
+				clocks = <&clkc_periphs CLKID_SYS_USB>;
+				clock-names = "general";
+				resets = <&reset RESET_USBPHY20>,
+					 <&reset RESET_USB0_COMB>;
+				reset-names = "phy", "comb";
+				#phy-cells = <0>;
+				status = "disabled";
+			};
+
 			eth_phy: mdio-multiplexer@360000 {
 				compatible = "amlogic,s7-mdio-mux";
 				reg = <0x0 0x360000 0x0 0xa4>;
-- 
2.43.0

