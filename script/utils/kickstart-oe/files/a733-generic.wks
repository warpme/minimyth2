# for vendor uboot
# dd conv=notrunc,fsync if=boot0_sdcard.bin of=${sd_drive} bs=512 seek=256
# dd conv=notrunc,fsync if=boot_package.fex of=${sd_drive} bs=512 seek=32800
part /SPL --source rawcopy --sourceparams="file=@MM_HOME@/images/main/boot/a733loaderfiles/boot0_sdcard.bin" --ondisk mmcblk --no-table --align 128
part /SPL --source rawcopy --sourceparams="file=@MM_HOME@/images/main/boot/a733loaderfiles/boot_package.fex" --ondisk mmcblk --no-table --align 16400

# for future mainline?
# dd if=u-boot-sunxi-with-spl.bin of=/dev/rdisk2 bs=1024 seek=8
# part /SPL --source rawcopy --sourceparams="file=@MM_HOME@/images/main/boot/a733loaderfiles/u-boot-sunxi-with-spl.bin" --ondisk mmcblk --no-table --align 8
