diff --speed-large-files --no-dereference --minimal -Naur u-boot-2026.07/configs/orangepi_zero3_defconfig u-boot-2026.07/configs/orangepi_zero3_defconfig
--- u-boot-2026.07/configs/orangepi_zero3_defconfig	2026-08-22 11:55:51.044495974 +0200
+++ u-boot-2026.07/configs/orangepi_zero3_defconfig	2026-08-22 11:52:39.564085329 +0200
@@ -31,3 +31,28 @@
 CONFIG_USB_OHCI_HCD=y
 CONFIG_USB_MUSB_GADGET=y
 CONFIG_OF_LIBFDT_OVERLAY=y
+CONFIG_USB1_VBUS_PIN="PC16"
+CONFIG_PWRLED="PC13"
+CONFIG_SPI_FLASH_ZBIT=y
+CONFIG_SUPPORT_EMMC_BOOT=y
+CONFIG_SYS_MMCSD_RAW_MODE_U_BOOT_SECTOR=0x40
+CONFIG_MMC_SUNXI_SLOT_EXTRA=2
+CONFIG_PHY_ETHERNET_ID=y
+CONFIG_PHY_FIXED=y
+CONFIG_PHY_NCSI=y
+CONFIG_LOGLEVEL=7
+CONFIG_PHY_REALTEK=y
+CONFIG_I2C3_ENABLE=y
+CONFIG_CMD_NET=y
+CONFIG_CMD_DHCP=y
+CONFIG_CMD_WGET=y
+CONFIG_CMD_TFTPBOOT=y
+CONFIG_CMD_PING=y
+CONFIG_CMD_MII=y
+CONFIG_CMD_MDIO=y
+CONFIG_CMD_WGET_LWIP=y
+CONFIG_PROT_TCP=y
+CONFIG_LIB_RAND=y
+CONFIG_WGET=y
+CONFIG_NET_LWIP=y
+CONFIG_BOOTCOMMAND="if dhcp ${scriptaddr} /PXEclient/pxelinux.cfg/sun50i-h618-orangepi-zero3.scr; then source ${scriptaddr}; fi; run distro_bootcmd"
diff --speed-large-files --no-dereference --minimal -Naur u-boot-2026.07/dts/upstream/src/arm64/allwinner/sun50i-h618-orangepi-zero3.dts u-boot-2026.07/dts/upstream/src/arm64/allwinner/sun50i-h618-orangepi-zero3.dts
--- u-boot-2026.07/dts/upstream/src/arm64/allwinner/sun50i-h618-orangepi-zero3.dts	2026-07-07 01:50:43.000000000 +0200
+++ u-boot-2026.07/dts/upstream/src/arm64/allwinner/sun50i-h618-orangepi-zero3.dts	2026-08-22 11:46:48.410249896 +0200
@@ -5,16 +5,37 @@
 
 /dts-v1/;
 
+#include <dt-bindings/leds/common.h>
 #include "sun50i-h616-orangepi-zero.dtsi"
-#include "sun50i-h616-cpu-opp.dtsi"
 
 / {
 	model = "OrangePi Zero3";
-	compatible = "xunlong,orangepi-zero3", "allwinner,sun50i-h618";
-};
+	compatible = "xunlong,orangepi-zero3", "allwinner,sun50i-h616";
 
-&cpu0 {
-	cpu-supply = <&reg_dcdc2>;
+	aliases {
+		ethernet0 = &emac0;
+		serial0 = &uart0;
+		mmc0 = &mmc0;  /* mmc0/mmcblk0 for SD */
+		mmc1 = &mmc1;  /* mmc1/mmcblk1 for SDIO */
+	};
+
+	leds: leds {
+		compatible = "gpio-leds";
+
+		led-red {
+			function = LED_FUNCTION_DISK_ACTIVITY;
+			label = "red_led";
+			gpios = <&pio 2 12 GPIO_ACTIVE_HIGH>; /* PC12 */
+			linux,default-trigger = "mmc0";
+		};
+
+		led-green {
+			function = LED_FUNCTION_STATUS;
+			label = "green_led";
+			gpios = <&pio 2 13 GPIO_ACTIVE_HIGH>; /* PC13 */
+			linux,default-trigger = "heartbeat";
+		};
+	};
 };
 
 &emac0 {
@@ -103,3 +124,70 @@
 	vcc-ph-supply = <&reg_dldo1>;
 	vcc-pi-supply = <&reg_dldo1>;
 };
+
+&spi0  {
+	status = "okay";
+	pinctrl-names = "default";
+	pinctrl-0 = <&spi0_pins>, <&spi0_cs0_pin>;
+
+	flash@0 {
+		#address-cells = <1>;
+		#size-cells = <1>;
+		compatible = "jedec,spi-nor";
+		reg = <0>;
+		spi-max-frequency = <40000000>;
+	};
+};
+
+&usbotg {
+	/*
+	 * PHY0 pins are connected to a USB-C socket, but a role switch
+	 * is not implemented: both CC pins are pulled to GND.
+	 * The VBUS pins power the device, so a fixed peripheral mode
+	 * is the best choice.
+	 * The board can be powered via GPIOs, in this case port0 *can*
+	 * act as a host (with a cable/adapter ignoring CC), as VBUS is
+	 * then provided by the GPIOs. Any user of this setup would
+	 * need to adjust the DT accordingly: dr_mode set to "host",
+	 * enabling OHCI0 and EHCI0.
+	 */
+	dr_mode = "peripheral";
+	status = "okay";
+};
+
+&usbphy {
+	usb1_vbus-supply = <&reg_usb1_vbus>;
+	status = "okay";
+};
+
+&ehci0 {
+	status = "disabled";
+};
+
+&ehci1 {
+	status = "okay";
+};
+
+&ehci2 {
+	status = "okay";
+};
+
+&ehci3 {
+	status = "okay";
+};
+
+&ohci0 {
+	status = "disabled";
+};
+
+&ohci1 {
+	status = "okay";
+};
+
+&ohci2 {
+	status = "okay";
+};
+
+&ohci3 {
+	status = "okay";
+};
--

