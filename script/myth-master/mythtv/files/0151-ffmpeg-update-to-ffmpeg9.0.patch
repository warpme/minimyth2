+.macro put_chroma_h8_xx_neon shift
+        // dst         .req x0
+        // _src        .req x1
+        // _src_stride .req x2
+        // height      .req x3
+        // hf          .req x4
+        // vf          .req x5
+        // width       .req x6
+        mov             x9, #(VVC_MAX_PB_SIZE * 2)
+        ldr             s0, [x4]
+        sub             x1, x1, #2
+        sub             x2, x2, #16
+        sxtl            v0.8h, v0.8b
