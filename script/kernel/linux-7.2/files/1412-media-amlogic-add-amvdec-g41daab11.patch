+            pcm = sps['pcm']
+            sflags = 0
+            for k, b in SPS_F.items():
+                if sps.get(k):
+                    sflags |= b
+            if not pcm:
+                sflags &= ~SPS_F['pcm_loop_filter_disabled']
+            Q = [sps['width'], sps['height'], sps['bit_depth_luma'] - 8, sps['bit_depth_chroma'] - 8,
+                 sps['log2_min_cb'] - 3, sps['log2_ctb'] - sps['log2_min_cb'], sps['log2_min_tb'] - 2,
