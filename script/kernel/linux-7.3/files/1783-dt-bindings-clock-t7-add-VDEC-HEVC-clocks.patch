Subject: [PATCH] bindings: clk: amlogic: t7-peripherals: add VDEC, HEVCF and HEVCB clocks

Add the video decoder clocks (cts_vdec_clk, cts_hevcf_clk,
cts_hevcb_clk). 


diff --git a/include/dt-bindings/clock/amlogic,t7-peripherals-clkc.h b/include/dt-bindings/clock/amlogic,t7-peripherals-clkc.h
index 32c4b62..91d015e 100644
--- a/include/dt-bindings/clock/amlogic,t7-peripherals-clkc.h
+++ b/include/dt-bindings/clock/amlogic,t7-peripherals-clkc.h
@@ -225,4 +225,26 @@
 #define CLKID_SYS_PWM_AO_EF		216
 #define CLKID_SYS_PWM_AO_GH		217
 
+#define CLKID_VDEC_0_SEL		218
+#define CLKID_VDEC_0_DIV		219
+#define CLKID_VDEC_0			220
+#define CLKID_VDEC_1_SEL		221
+#define CLKID_VDEC_1_DIV		222
+#define CLKID_VDEC_1			223
+#define CLKID_VDEC			224
+#define CLKID_HEVCF_0_SEL		225
+#define CLKID_HEVCF_0_DIV		226
+#define CLKID_HEVCF_0			227
+#define CLKID_HEVCF_1_SEL		228
+#define CLKID_HEVCF_1_DIV		229
+#define CLKID_HEVCF_1			230
+#define CLKID_HEVCF			231
+#define CLKID_HEVCB_0_SEL		232
+#define CLKID_HEVCB_0_DIV		233
+#define CLKID_HEVCB_0			234
+#define CLKID_HEVCB_1_SEL		235
+#define CLKID_HEVCB_1_DIV		236
+#define CLKID_HEVCB_1			237
+#define CLKID_HEVCB			238
+
 #endif /* __T7_PERIPHERALS_CLKC_H */
