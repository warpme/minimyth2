+		.num_parents = 1,					\
+	},								\
+}
+
+S6_FCLK_DIV(fclk50m, 1, 40, 4);
+S6_FCLK_DIV(fclk_div2, 1, 2, 20);
+S6_FCLK_DIV(fclk_div2p5, 2, 5, 8);
+S6_FCLK_DIV(fclk_div3, 1, 3, 16);
+S6_FCLK_DIV(fclk_div4, 1, 4, 17);
+S6_FCLK_DIV(fclk_div5, 1, 5, 18);
+S6_FCLK_DIV(fclk_div7, 1, 7, 19);
+
+/* Array of all clocks provided by this provider */
+static struct clk_hw *s6_pll_hw_clks[] = {
