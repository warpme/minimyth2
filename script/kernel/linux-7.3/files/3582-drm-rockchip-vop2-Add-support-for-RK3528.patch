+			break;
+		case ROCKCHIP_VOP2_ESMART1:
+			mask = RK3528_OVL_SYS_PORT_SEL__ESMART1;
+			break;
+		case ROCKCHIP_VOP2_ESMART2:
+			mask = RK3528_OVL_SYS_PORT_SEL__ESMART2;
+			break;
+		case ROCKCHIP_VOP2_ESMART3:
+			mask = RK3528_OVL_SYS_PORT_SEL__ESMART3;
+			break;
+		default:
+			continue;
+		}
+
+		port_sel &= ~mask;
+		port_sel |= (vp->id << __ffs(mask)) & mask;
+	}
+
+	vop2_writel(vop2, RK3528_OVL_SYS_PORT_SEL_IMD, port_sel);
+
+	mutex_unlock(&vop2->ovl_lock);
