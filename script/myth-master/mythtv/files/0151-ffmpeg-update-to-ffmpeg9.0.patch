+    %endif
+%endmacro
+
+%macro shl_log2 2 ; dst, amount
+    %if %2 == 64
+        shl %1, 6
+    %elif %2 == 32
+        shl %1, 5
+    %elif %2 == 16
+        shl %1, 4
+    %elif %2 == 8
+        shl %1, 3
+    %elif %2 == 4
+        shl %1, 2
+    %elif %2 == 2
