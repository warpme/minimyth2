+    %undef NAME
+    %undef UOP
+    %undef TYPE
+    %undef MASK
+    %undef X
+    %undef Y
+    %undef Z
+    %undef W
+    %undef COMPS
+    %undef BYTES
+    %undef BITS
+    %undef BLOCK_SIZE
+    %undef BLOCK_WIDTH
+    %undef ADD_MUL
+%endmacro
+
+; Declare a set of operations with a custom name suffix
+%macro decl_suffix 2+ ; suffix, func
+    %xdefine NAME_SUFFIX %1
+    %2
+    %undef NAME_SUFFIX
+%endmacro
+
+; Declare a set of operations with the high half enabled / disabled
+%macro decl_v2 2+ ; v2, func
+    %assign V2 %1
+    %2
+    %undef V2
+%endmacro
