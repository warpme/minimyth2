+			 * instead of mpll0. S7 has no MPLL, so the mst_in1..3
+			 * inputs are not connected.
+			 */
+			clkc_audio: clock-controller@330000 {
+				compatible = "amlogic,s7-audio-clkc", "amlogic,s4-audio-clkc";
+				reg = <0x0 0x330000 0x0 0xd8>,
+				      <0x0 0x330e80 0x0 0x10>;
+				#clock-cells = <1>;
+				#reset-cells = <1>;
+				power-domains = <&pwrc PWRC_S7_AUDIO_ID>;
+				clocks = <&clkc_periphs CLKID_SYS_AUDIO>,
+					 <&clkc_pll CLKID_HIFI1_PLL>,
+					 <&clkc_pll CLKID_HIFI_PLL>,
+					 <&clkc_pll CLKID_FCLK_DIV3>,
+					 <&clkc_pll CLKID_FCLK_DIV4>,
+					 <&clkc_pll CLKID_FCLK_DIV5>;
+				clock-names = "pclk", "mst_in0", "mst_in4", "mst_in5",
+					      "mst_in6", "mst_in7";
+				resets = <&reset RESET_AUDIO>;
+			};
+
