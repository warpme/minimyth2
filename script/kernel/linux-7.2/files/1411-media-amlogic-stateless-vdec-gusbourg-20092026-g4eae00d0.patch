+	/* The G12A/G12B VP9 firmware cannot safely run below this floor. */
+	if (frame->frame_width_minus_1 + 1 < 256 ||
+	    frame->frame_height_minus_1 + 1 < 144)
+		return -EINVAL;
+
+	return 0;
