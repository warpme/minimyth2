diff --speed-large-files --no-dereference --minimal -Naur linux-7.3-rc6/arch/arm64/boot/dts/amlogic/meson-s4.dtsi linux-7.3-rc6/arch/arm64/boot/dts/amlogic/meson-s4.dtsi
--- linux-7.3-rc6/arch/arm64/boot/dts/amlogic/meson-s4.dtsi	2026-10-10 12:08:52.140043578 +0200
+++ linux-7.3-rc6/arch/arm64/boot/dts/amlogic/meson-s4.dtsi	2026-10-09 20:25:46.169022778 +0200
@@ -210,6 +350,28 @@
 				};
 			};
 
+			vdec: video-decoder@320000 {
+				compatible = "amlogic,s4-vdec";
+				reg = <0x0 0x320000 0x0 0x10000>,
+				      <0x0 0x36000 0x0 0x400>;
+				reg-names = "dos", "dmc";
+				interrupts = <GIC_SPI 92 IRQ_TYPE_EDGE_RISING>;
+				interrupt-names = "vdec";
+				clocks = <&clkc_periphs CLKID_DOS>,
+					 <&clkc_periphs CLKID_VDEC_SEL>,
+					 <&clkc_periphs CLKID_HEVCF_SEL>;
+				clock-names = "dos", "vdec_1", "vdec_hevc";
+				power-domains = <&pwrc PWRC_S4_DOS_VDEC_ID>,
+						<&pwrc PWRC_S4_DOS_HEVC_ID>;
+				power-domain-names = "vdec", "hevc";
+				resets = <&reset RESET_BRG_HEVCF_PIPL0>,
+					 <&reset RESET_BRG_HEVCF_PIPL1>,
+					 <&reset RESET_BRG_HEVCB_PIPL1>;
+				reset-names = "hevcf-pipl0", "hevcf-pipl1",
+					      "hevcb-pipl1";
+				amlogic,canvas = <&canvas>;
+			};
+
 			clkc_periphs: clock-controller@0 {
 				compatible = "amlogic,s4-peripherals-clkc";
 				reg = <0x0 0x0 0x0 0x49c>;
@@ -1077,34 +1281,33 @@
 			power-domains = <&pwrc PWRC_S4_VPU_HDMI_ID>;
 
 			clocks = <&clkc_periphs CLKID_VPU>,
-				 <&clkc_periphs CLKID_VAPB>;
+					<&clkc_periphs CLKID_VAPB>;
 			clock-names = "vpu", "vapb";
 
 			/*
-			 * VPU clocking is provided by two identical clock paths
-			 * VPU_0 and VPU_1 muxed to a single clock by a glitch
-			 * free mux to safely change frequency while running.
-			 * Same for VAPB but with a final gate after the glitch free mux.
-			 */
+			* VPU clocking is provided by two identical clock paths
+			* VPU_0 and VPU_1 muxed to a single clock by a glitch
+			* free mux to safely change frequency while running.
+			* Same for VAPB but with a final gate after the glitch free mux.
+			*/
 			assigned-clocks = <&clkc_periphs CLKID_VPU_0_SEL>,
-					  <&clkc_periphs CLKID_VPU_0>,
-					  <&clkc_periphs CLKID_VPU>, /* Glitch free mux */
-					  <&clkc_periphs CLKID_VAPB_0_SEL>,
-					  <&clkc_periphs CLKID_VAPB_0>,
-					  <&clkc_periphs CLKID_VAPB>; /* Glitch free mux */
-			assigned-clock-parents = <&clkc_periphs CLKID_FCLK_DIV3>,
-						 <0>, /* Do Nothing */
-						 <&clkc_periphs CLKID_VPU_0>,
-						 <&clkc_periphs CLKID_FCLK_DIV4>,
-						 <0>, /* Do Nothing */
-						 <&clkc_periphs CLKID_VAPB_0>;
+							<&clkc_periphs CLKID_VPU_0>,
+							<&clkc_periphs CLKID_VPU>, /* Glitch free mux */
+							<&clkc_periphs CLKID_VAPB_0_SEL>,
+							<&clkc_periphs CLKID_VAPB_0>,
+							<&clkc_periphs CLKID_VAPB>; /* Glitch free mux */
+			assigned-clock-parents = <&clkc_pll CLKID_FCLK_DIV3>,
+									<0>, /* Do Nothing */
+									<&clkc_periphs CLKID_VPU_0>,
+									<&clkc_pll CLKID_FCLK_DIV4>,
+									<0>, /* Do Nothing */
+									<&clkc_periphs CLKID_VAPB_0>;
 			assigned-clock-rates = <0>, /* Do Nothing */
-					       <666666666>,
-					       <0>, /* Do Nothing */
-					       <0>, /* Do Nothing */
-					       <250000000>,
-					       <0>; /* Do Nothing */
-
+									<666666666>,
+									<0>, /* Do Nothing */
+									<0>, /* Do Nothing */
+									<250000000>,
+									<0>; /* Do Nothing */
 			/* CVBS VDAC output port */
 			cvbs_vdac_port: port@0 {
 				reg = <0>;
