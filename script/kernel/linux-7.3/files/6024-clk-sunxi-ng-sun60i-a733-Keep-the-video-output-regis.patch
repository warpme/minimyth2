From c23c0550f645303ee5aa48739d6028c10eb299ea Mon Sep 17 00:00:00 2001
From: Jernej Skrabec <jernej.skrabec@gmail.com>
Date: Sat, 5 Sep 2026 00:42:59 +0200
Subject: [PATCH 182/211] clk: sunxi-ng: sun60i-a733: Keep the video output
 register bus running

The two video output islands hold the display tops, the TV timing
controllers and HDMI, and their register bus arrives through the
ahb-vid-cout0 and ahb-vid-cout1 gates. Nothing in the tree claims either
gate, so clk_disable_unused() switched them off before any display driver
looked at the hardware. From then on every register in those islands read
back as zero and swallowed writes, which showed up as the HDMI controller
reporting an identifier of 0000:00:00 and refusing to probe.

Mark them critical, as ahb-de already is for the same reason.

Signed-off-by: Jernej Skrabec <jernej.skrabec@gmail.com>
---
 drivers/clk/sunxi-ng/ccu-sun60i-a733.c | 10 ++++++++--
 1 file changed, 8 insertions(+), 2 deletions(-)

diff --git a/drivers/clk/sunxi-ng/ccu-sun60i-a733.c b/drivers/clk/sunxi-ng/ccu-sun60i-a733.c
index 33618ebc70..00307a44cb 100644
--- a/drivers/clk/sunxi-ng/ccu-sun60i-a733.c
+++ b/drivers/clk/sunxi-ng/ccu-sun60i-a733.c
@@ -499,10 +499,16 @@ static SUNXI_CCU_GATE_HWS(ahb_ve_enc_clk, "ahb-ve-enc", ahb_hws,
 			  0x5c0, BIT(1), 0);
 static SUNXI_CCU_GATE_HWS(ahb_vid_in_clk, "ahb-vid-in", ahb_hws,
 			  0x5c0, BIT(2), 0);
+/*
+ * These two carry the register bus into the video output islands, which hold
+ * the display tops, the timing controllers and HDMI. Nothing else turns them
+ * on, and with them off those blocks read back zero and swallow writes, so
+ * keep them running.
+ */
 static SUNXI_CCU_GATE_HWS(ahb_vid_cout0_clk, "ahb-vid-cout0", ahb_hws,
-			  0x5c0, BIT(3), 0);
+			  0x5c0, BIT(3), CLK_IS_CRITICAL);
 static SUNXI_CCU_GATE_HWS(ahb_vid_cout1_clk, "ahb-vid-cout1", ahb_hws,
-			  0x5c0, BIT(4), 0);
+			  0x5c0, BIT(4), CLK_IS_CRITICAL);
 /*
  * The display engine reaches memory through these two gates, and nothing
  * else turns them on, so keep them running.
-- 
