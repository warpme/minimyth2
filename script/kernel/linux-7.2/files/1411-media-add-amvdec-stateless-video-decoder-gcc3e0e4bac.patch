+static int codec_vp9_adapt_pending(struct amvdec_session *sess, u32 prob_status)
+{
+	struct codec_vp9 *vp9 = sess->priv;
+	struct amvdec_core *core = sess->core;
+	if ((prob_status & 0xff) == 0xfd && vp9->cur_frame) {
+		if ((prob_status >> 8) >= 4)
+			return -EINVAL;
+		/* VP9_REQ_ADAPT_PROB */
+		u8 *prev_prob_b = ((u8 *)vp9->workspace_vaddr +
+					 PROB_OFFSET) +
+					((prob_status >> 8) * 0x1000);
+		u8 *cur_prob_b = ((u8 *)vp9->workspace_vaddr +
+					 PROB_OFFSET) + 0x4000;
+		u8 *count_b = (u8 *)vp9->workspace_vaddr +
+				   COUNT_OFFSET;
+		int last_frame_type = vp9->prev_frame ?
+						vp9->prev_frame->type :
+						KEY_FRAME;
+
+		/*
+		 * VP9 8.4: an intra-only frame is an intra frame.  It produces
+		 * no inter-mode or motion-vector counts, so adapting those
+		 * probabilities from its counts walks over the context that
+		 * the following inter frames decode with.
+		 */
+		adapt_coef_probs(last_frame_type == KEY_FRAME,
+				 vp9->cur_frame->type == KEY_FRAME ||
+				 vp9->cur_frame->intra_only ? 1 : 0,
+				 prob_status >> 8,
+				 (unsigned int *)prev_prob_b,
+				 (unsigned int *)cur_prob_b,
+				 (unsigned int *)count_b);
+
+		memcpy(prev_prob_b, cur_prob_b, ADAPT_PROB_SIZE);
+		amvdec_write_dos(core, VP9_ADAPT_PROB_REG, 0);
+	}
+
+	return 0;
+}
+
+void codec_vp9_request_input_ready(struct amvdec_session *sess, u32 end)
+{
+	struct codec_vp9 *vp9 = sess->priv;
+	struct amvdec_core *core = sess->core;
+
+	if (!vp9 || !vp9->request_mode)
+		return;
+	amvdec_trace(sess, AMVDEC_TR_READY, end, vp9->request_parked,
+		     amvdec_read_dos(core, VP9_DEC_STATUS_REG));
+	mutex_lock(&vp9->lock);
+	/*
+	 * A small picture can be decoded, and the firmware parked at 0x0a,
+	 * before the feed worker that submitted it gets here.  The input being
+	 * reported is then the picture that has just completed, not the next
+	 * one: there is nothing to release and nothing wrong.
+	 */
+	if (vp9->request_parked && vp9->cur_frame &&
+	    end == vp9->cur_frame->input_end) {
+		mutex_unlock(&vp9->lock);
+		return;
+	}
+	if (vp9->request_parked && !vp9->request_failed) {
+		if (!vp9->cur_frame || end <= vp9->cur_frame->input_end ||
+		    amvdec_read_dos(core, VP9_DEC_STATUS_REG) != 0x0a) {
+			dev_err(core->dev,
+				"invalid next request: end=%u prev_end=%d status=%x\n",
+				end, vp9->cur_frame ? (int)vp9->cur_frame->input_end : -1,
+				amvdec_read_dos(core, VP9_DEC_STATUS_REG));
+			vp9->request_failed = true;
+			amvdec_abort(sess);
+		} else {
+			amvdec_write_dos(core, HEVC_DECODE_SIZE, end);
+			vp9->request_parked = false;
+			dev_dbg(core->dev, "resume endpoint=%u queued=%d\n",
+				 end, atomic_read(&sess->esparser_queued_bufs));
+			amvdec_write_dos_action(core, VP9_DEC_STATUS_REG, 0xff);
+		}
+	}
+	mutex_unlock(&vp9->lock);
+}
+
+static irqreturn_t codec_vp9_threaded_isr(struct amvdec_session *sess)
+{
+	struct amvdec_core *core = sess->core;
+	struct codec_vp9 *vp9 = sess->priv;
+	u32 dec_status = amvdec_read_dos(core, VP9_DEC_STATUS_REG);
+	u32 prob_status = amvdec_read_dos(core, VP9_ADAPT_PROB_REG);
+	int rpm_ret;
+	int i;
+
+	if (!vp9)
+		return IRQ_HANDLED;
+
+	mutex_lock(&vp9->lock);
+	if (!vp9->workspace_vaddr) {
+		/*
+		 * codec_vp9_stop() ran while this interrupt was in flight and
+		 * took the lock first.  Everything below reads the workspace,
+		 * and the per-frame MV buffers are freed under this same lock
+		 * once this pointer is NULL, so they are covered too.
+		 */
+		goto unlock;
+	}
+
+	dev_dbg(core->dev_dec, "VP9 dec_status: %08X prob_status: %08X\n",
+		 dec_status, prob_status);
+
+	if (vp9->request_mode) {
+		amvdec_trace(sess, AMVDEC_TR_IRQ, dec_status,
+			     amvdec_read_dos(core, HEVC_SHIFT_BYTE_COUNT),
+			     amvdec_read_dos(core, HEVC_DECODE_SIZE));
+		dev_dbg(core->dev, "request irq status=%x shift=%u size=%u prob=%x lcu=%x\n",
+			 dec_status, amvdec_read_dos(core, HEVC_SHIFT_BYTE_COUNT),
+			 amvdec_read_dos(core, HEVC_DECODE_SIZE), prob_status,
+			 amvdec_read_dos(core, HEVC_PARSER_LCU_START));
+		if (vp9->request_failed)
+			goto unlock;
+		if (dec_status == VP9_DECPIC_DATA_DONE) {
+			struct vp9_frame *f = vp9->cur_frame;
+
+			if (!vp9->request_size || !f || f->done || vp9->request_parked ||
+			    codec_vp9_adapt_pending(sess, prob_status))
+				goto request_fail;
+			f->done = 1;
+			vp9->frames_num--;
+			vp9->request_parked = true;
+			codec_vp9_arm_restream(sess);
+			amvdec_trace(sess, AMVDEC_TR_DONE, amvdec_read_dos(core, HEVC_SHIFT_BYTE_COUNT),
+				     f->index, f->show);
+			dev_dbg(core->dev, "done ts=%llu idx=%u show=%u; parked\n",
+				 f->vbuf->vb2_buf.timestamp, f->index, f->show);
+			amvdec_request_signal(sess, f->vbuf);
+			goto unlock;
+		}
+		/*
+		 * The request path aborts on anything that is not a finished
+		 * picture or a parsed header, which swallows three statuses
+		 * that are not decode failures at all - and made the benign
+		 * handling in the switch below unreachable in request mode:
+		 *
+		 *  - BUFEMPTY: the firmware has consumed the VIFIFO and wants
+		 *    more input; the feed worker is already writing it.
+		 *  - ACTION_DONE: the token the host itself writes to resume
+		 *    the firmware after publishing an endpoint, read back
+		 *    before the firmware has replaced it with a verdict.
+		 *
+		 * The same two mistakes cost HEVC roughly one long run in five
+		 * before they were fixed there; VP9 drives the same core, the
+		 * same status register and the same resume handshake.
+		 */
+		if (dec_status == VP9_SEARCH_BUFEMPTY ||
+		    dec_status == VP9_DECODE_BUFEMPTY ||
+		    dec_status == VP9_ACTION_DONE) {
+			dev_dbg(core->dev,
+				"not a verdict status=%x; ignoring\n",
+				dec_status);
+			goto unlock;
+		}
+		if (dec_status != VP9_HEAD_PARSER_DONE) {
+request_fail:
+			dev_err(core->dev,
+				"request failed: event=%x parked=%d queued=%d frames=%u cur=%d show=%d size=%u shift=%u prob=%x\n",
+				dec_status, vp9->request_parked,
+				atomic_read(&sess->esparser_queued_bufs), vp9->frames_num,
+				vp9->cur_frame ? (int)vp9->cur_frame->index : -1,
+				vp9->cur_frame ? (int)vp9->cur_frame->show : -1,
+				amvdec_read_dos(core, HEVC_DECODE_SIZE),
+				amvdec_read_dos(core, HEVC_SHIFT_BYTE_COUNT), prob_status);
+			vp9->request_failed = true;
+			amvdec_abort(sess);
+			goto unlock;
+		}
+	}
+	switch (dec_status) {
+	case VP9_NAL_DECODE_DONE:
+	case VP9_DECODE_BUFEMPTY:
+	case VP9_SEARCH_BUFEMPTY:
+		goto unlock;
+	case VP9_DECPIC_DATA_DONE:
+		codec_vp9_complete_frame(sess, vp9->cur_frame);
+		goto unlock;
+	case VP9_EOS:
+		codec_vp9_flush_output_locked(sess);
+		goto unlock;
+	case VP9_HEAD_PARSER_DONE:
+		break;
+	default:
+		dev_err_ratelimited(core->dev_dec, "Unrecognized dec_status: %08X\n",
+			dec_status);
+		amvdec_abort(sess);
+		goto unlock;
+	}
+
+	pr_debug("ISR: %08X;%08X\n", dec_status, prob_status);
+	sess->keyframe_found = 1;
+
+	if (codec_vp9_adapt_pending(sess, prob_status)) {
+		amvdec_abort(sess);
+		goto unlock;
+	}
+
+	/* Invalidate first 3 refs */
+	for (i = 0; i < REFS_PER_FRAME ; ++i)
+		vp9->frame_refs[i] = NULL;
+
+	vp9->prev_frame = vp9->cur_frame;
+	if (!codec_vp9_is_stateless(sess))
+		codec_vp9_update_ref(vp9);
+	codec_vp9_complete_hidden_frame(sess, vp9->prev_frame);
+
+	codec_vp9_fetch_rpm(sess);
+	rpm_ret = codec_vp9_process_rpm(sess, vp9);
+	if (rpm_ret < 0) {
+		amvdec_abort(sess);
+		goto unlock;
+	}
+	if (rpm_ret) {
+		/* No frame is actually processed */
+		vp9->cur_frame = NULL;
+
+		/* Show the remaining frame */
+		codec_vp9_show_frame(sess);
+
+		/* FIXME: Save refs for resized frame */
+		if (!codec_vp9_is_stateless(sess) && vp9->frames_num)
+			codec_vp9_save_refs(vp9);
+
+		/*
+		 * amvdec_src_change() calls ->resume() directly when the
+		 * capture queue already suits the new format, and
+		 * codec_vp9_resume() takes vp9->lock - which this thread is
+		 * holding.  Drop it first: the pending frame has been shown
+		 * and the refs saved, so there is nothing left here that the
+		 * lock protects.
+		 */
+		mutex_unlock(&vp9->lock);
+		amvdec_src_change(sess, vp9->width, vp9->height, 16,
+				  vp9->is_10bit ? 10 : 8);
+		return IRQ_HANDLED;
+	}
+
+	codec_vp9_process_lf(vp9);
+	codec_vp9_process_frame(sess);
+	codec_vp9_show_frame(sess);
+
+unlock:
+	mutex_unlock(&vp9->lock);
+	return IRQ_HANDLED;
+}
+
+static irqreturn_t codec_vp9_isr(struct amvdec_session *sess)
+{
+	return IRQ_WAKE_THREAD;
+}
+
+struct amvdec_codec_ops codec_vp9_ops = {
+	.start = codec_vp9_start,
+	.stop = codec_vp9_stop,
+	.isr = codec_vp9_isr,
+	.threaded_isr = codec_vp9_threaded_isr,
+	.num_pending_bufs = codec_vp9_num_pending_bufs,
+	.drain = codec_vp9_flush_output,
+	.resume = codec_vp9_resume,
+};
