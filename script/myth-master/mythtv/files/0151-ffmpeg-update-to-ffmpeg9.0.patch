diff --git a/mythtv/external/FFmpeg/tests/checkasm/ext/src/riscv/cpu.c b/mythtv/external/FFmpeg/tests/checkasm/ext/src/riscv/cpu.c
new file mode 100644
index 00000000000..9248babedd0
--- /dev/null
+++ b/mythtv/external/FFmpeg/tests/checkasm/ext/src/riscv/cpu.c
@@ -0,0 +1,210 @@
+/*
+ * Copyright © 2022-2025 Rémi Denis-Courmont.
+ * All rights reserved.
+ *
+ * Redistribution and use in source and binary forms, with or without
+ * modification, are permitted provided that the following conditions are met:
