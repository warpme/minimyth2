diff --git a/drivers/media/platform/rockchip/rkvdec/rkvdec-vdpu381-h264.c b/drivers/media/platform/rockchip/rkvdec/rkvdec-vdpu381-h264.c
index b961fddc8..0a8aefd73 100644
--- a/drivers/media/platform/rockchip/rkvdec/rkvdec-vdpu381-h264.c
+++ b/drivers/media/platform/rockchip/rkvdec/rkvdec-vdpu381-h264.c
@@ -247,6 +247,10 @@ static void config_registers(struct rkvdec_ctx *ctx,
 	regs->common.reg013_en_mode_set.cur_pic_is_idr =
 		!!(dec_params->flags & V4L2_H264_DECODE_PARAM_FLAG_IDR_PIC);
 
+	/* VDPU382 only removes the emulation prevention bytes on request */
+	if (ctx->dev->variant->is_vdpu382)
+		regs->common.reg013_en_mode_set.strmd_zero_rm_en = 1;
+
 	/* Set input stream length */
 	regs->common.reg016_stream_len = vb2_get_plane_payload(&src_buf->vb2_buf, 0);
 
@@ -453,6 +457,16 @@ static int rkvdec_h264_run(struct rkvdec_ctx *ctx)
 
 static int rkvdec_h264_try_ctrl(struct rkvdec_ctx *ctx, struct v4l2_ctrl *ctrl)
 {
+	if (ctx->dev->variant->is_vdpu382 &&
+	    ctrl->id == V4L2_CID_STATELESS_H264_SPS) {
+		const struct v4l2_ctrl_h264_sps *sps = ctrl->p_new.p_h264_sps;
+
+		/* VDPU382 only supports 8-bit 4:2:0 H.264 */
+		if (sps->chroma_format_idc > 1 || sps->bit_depth_luma_minus8 ||
+		    sps->bit_depth_chroma_minus8)
+			return -EINVAL;
+	}
+
 	if (ctrl->id == V4L2_CID_STATELESS_H264_SPS)
 		return rkvdec_h264_validate_sps(ctx, ctrl->p_new.p_h264_sps);
 
diff --git a/drivers/media/platform/rockchip/rkvdec/rkvdec-vdpu381-hevc.c b/drivers/media/platform/rockchip/rkvdec/rkvdec-vdpu381-hevc.c
index e1936e87f..ddacb4cff 100644
