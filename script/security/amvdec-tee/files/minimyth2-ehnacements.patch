+static bool soc_matches(const struct pack_entry *e, const char *soc)
+{
+	size_t n;
+
+	if (!soc)
+		return true;
+
+	n = strlen(soc);
+	return (!strncmp(e->name, soc, n) && e->name[n] == '_') ||
+	       !strcmp(e->soc, soc);
+}
+
+/* Count the entries for @soc; placeholders are counted separately. */
+static size_t count_soc(const struct package *pkg, const char *soc,
+			size_t *empty)
+{
+	size_t i, n = 0;
+
+	*empty = 0;
+	for (i = 0; i < pkg->n_entries; i++) {
+		if (!soc_matches(&pkg->entries[i], soc))
+			continue;
+		if (pkg->entries[i].empty)
+			(*empty)++;
+		else
+			n++;
+	}
+
+	return n;
+}
