+/* A driver-owned VIFIFO for the open firmware (coherent, grown on demand). */
+struct h264_open_fifo {
+	void      *vaddr;
+	dma_addr_t paddr;
+	u32        size;
+	u32        payload;
+};
+
+/*
+ * Open-firmware pipeline (h264_pipeline): a frame picture is prepared - record,
+ * FIFO, CAPTURE buffer and everything its retirement needs - while the previous
+ * one decodes, and the threaded ISR kicks it the moment that one is done.
+ *
+ * FREE -> READY (worker, prepared) -> RUN (kicked: worker or threaded ISR)
+ *      -> DONE (threaded ISR) -> RETIRING -> FREE (worker returns both buffers).
+ * State transitions and kicks are under pipe_lock. Whoever moves a slot to
+ * RETIRING (the worker, or stop for any READY/RUN/DONE slot) completes its
+ * buffers, outside the lock, exactly once. A FREE slot's FIFO is the worker's.
+ */
+enum {
+	OH264_PIPE_FREE,
+	OH264_PIPE_READY,
+	OH264_PIPE_RUN,
+	OH264_PIPE_DONE,
+	OH264_PIPE_RETIRING,	/* claimed by one completer (worker or stop), buffers in hand */
+};
+#define OH264_PIPE_SLOTS	2
+
+struct h264_open_pic {
+	u8         state;
+	u32        seq;		/* prepare order: kick and retirement order */
+	u32        rec_off;	/* record offset in open_vaddr */
+	struct h264_open_fifo fifo;
+	u32        first_off;	/* FIFO offset of slice 0 (error report) */
+	/* retirement snapshot */
+	struct vb2_v4l2_buffer *src, *dst;
+	u32        fw_idx;
+	ktime_t    bench_feed;
+	/* result, from the threaded ISR */
+	u32        status, err;
+};
