@@ -78,6 +99,11 @@
 	};
 
 	firmware {
+		optee {
+			compatible = "linaro,optee-tz";
+			method = "smc";
+		};
+
 		sm: secure-monitor {
 			compatible = "amlogic,meson-gxbb-sm";
 
@@ -88,6 +114,15 @@
 		};
 	};
 
+	cpu_temp: temperature-sensor@fe020000 {
+		compatible = "amlogic,s4-thermal", "amlogic,t7-thermal";
+		reg = <0x0 0xfe020000 0x0 0x50>;
+		interrupts = <GIC_SPI 30 IRQ_TYPE_LEVEL_HIGH>;
+		clocks = <&clkc_periphs CLKID_TS>;
+		#thermal-sensor-cells = <0>;
+		amlogic,secure-monitor = <&sm 1>;
+	};
+
 	saradc: adc@fe026000 {
 		compatible = "amlogic,meson-s4-saradc",
 			     "amlogic,meson-g12a-saradc";
@@ -102,6 +137,75 @@
 		status = "disabled";
 	};
 
+	cpu_opp_table: opp-table-cpu {
+		compatible = "amlogic,s4-cpu-operating-points";
+		amlogic,secure-monitor = <&sm>;
+		opp-shared;
+
+		opp-100000000 {
+			opp-hz = /bits/ 64 <100000000>;
+			opp-microvolt = <769000>;
+			opp-microvolt-bin2 = <759000>;
+			opp-microvolt-bin3 = <759000>;
+		};
+
+		opp-250000000 {
+			opp-hz = /bits/ 64 <250000000>;
+			opp-microvolt = <769000>;
+			opp-microvolt-bin2 = <759000>;
+			opp-microvolt-bin3 = <759000>;
+		};
+
+		opp-500000000 {
+			opp-hz = /bits/ 64 <500000000>;
+			opp-microvolt = <769000>;
+			opp-microvolt-bin2 = <759000>;
+			opp-microvolt-bin3 = <759000>;
+		};
+
+		opp-666666666 {
+			opp-hz = /bits/ 64 <666666666>;
+			opp-microvolt = <769000>;
+			opp-microvolt-bin2 = <759000>;
+			opp-microvolt-bin3 = <759000>;
+		};
+
+		opp-1000000000 {
+			opp-hz = /bits/ 64 <1000000000>;
+			opp-microvolt = <769000>;
+			opp-microvolt-bin2 = <759000>;
+			opp-microvolt-bin3 = <759000>;
+		};
+
+		opp-1200000000 {
+			opp-hz = /bits/ 64 <1200000000>;
+			opp-microvolt = <769000>;
+			opp-microvolt-bin2 = <759000>;
+			opp-microvolt-bin3 = <759000>;
+		};
+
+		opp-1500000000 {
+			opp-hz = /bits/ 64 <1500000000>;
+			opp-microvolt = <829000>;
+			opp-microvolt-bin2 = <769000>;
+			opp-microvolt-bin3 = <759000>;
+		};
+
+		opp-1608000000 {
+			opp-hz = /bits/ 64 <1608000000>;
+			opp-microvolt = <869000>;
+			opp-microvolt-bin2 = <799000>;
+			opp-microvolt-bin3 = <769000>;
+		};
+
+		opp-1704000000 {
+			opp-hz = /bits/ 64 <1704000000>;
+			opp-microvolt = <909000>;
+			opp-microvolt-bin2 = <829000>;
+			opp-microvolt-bin3 = <809000>;
+		};
+	};
+
 	gpu_opp_table: opp-table-gpu {
 		compatible = "operating-points-v2";
 
@@ -135,6 +239,49 @@
 		};
 	};
 
+	thermal-zones {
+		cpu_thermal: cpu-thermal {
+			polling-delay = <1000>;
+			polling-delay-passive = <100>;
+			thermal-sensors = <&cpu_temp>;
+
+			trips {
+				cpu_passive: cpu-passive {
+					temperature = <85000>; /* millicelsius */
+					hysteresis = <5000>; /* millicelsius */
+					type = "passive";
+				};
+
+				cpu_hot: cpu-hot {
+					temperature = <95000>; /* millicelsius */
+					hysteresis = <5000>; /* millicelsius */
+					type = "hot";
+				};
+
+				cpu_critical: cpu-critical {
+					temperature = <105000>; /* millicelsius */
+					hysteresis = <1000>; /* millicelsius */
+					type = "critical";
+				};
+			};
+
+			cooling-maps {
+				map0 {
+					trip = <&cpu_passive>;
+					cooling-device = <&gpu THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
+				};
+
+				map1 {
+					trip = <&cpu_passive>;
+					cooling-device = <&cpu0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
+							 <&cpu1 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
+							 <&cpu2 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
+							 <&cpu3 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
+				};
+			};
+		};
+	};
+
 	soc {
 		compatible = "simple-bus";
 		#address-cells = <2>;
