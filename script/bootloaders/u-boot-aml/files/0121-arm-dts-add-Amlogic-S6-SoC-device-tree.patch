+// #include <dt-bindings/reset/amlogic,s6-reset.h>
+#include <dt-bindings/power/amlogic,s6-pwrc.h>
+#include "amlogic-s6-reset.h"
+#include <dt-bindings/clock/axg-audio-clkc.h>
+#include <dt-bindings/reset/amlogic,meson-axg-audio-arb.h>
+#include <dt-bindings/reset/amlogic,meson-g12a-audio-reset.h>
+#include <dt-bindings/sound/meson-g12a-tohdmitx.h>
+#include <dt-bindings/thermal/thermal.h>
+
+/ {
+	cpus {
+		#address-cells = <2>;
+		#size-cells = <0>;
+
+		cpu0: cpu@0 {
+			device_type = "cpu";
+			compatible = "arm,cortex-a510";
+			reg = <0x0 0x0>;
+			enable-method = "psci";
+			clocks = <&scmi_clk CLKID_CPU_CLK>;
+			operating-points-v2 = <&cpu_opp_table>;
+			dynamic-power-coefficient = <230>;
+			#cooling-cells = <2>;
+		};
+
+		cpu1: cpu@100 {
+			device_type = "cpu";
+			compatible = "arm,cortex-a510";
+			reg = <0x0 0x100>;
+			enable-method = "psci";
+			clocks = <&scmi_clk CLKID_CPU_CLK>;
+			operating-points-v2 = <&cpu_opp_table>;
+			dynamic-power-coefficient = <230>;
+			#cooling-cells = <2>;
+		};
+
+		cpu2: cpu@200 {
+			device_type = "cpu";
+			compatible = "arm,cortex-a510";
+			reg = <0x0 0x200>;
+			enable-method = "psci";
+			clocks = <&scmi_clk CLKID_CPU_CLK>;
+			operating-points-v2 = <&cpu_opp_table>;
+			dynamic-power-coefficient = <230>;
+			#cooling-cells = <2>;
+		};
+
+		cpu3: cpu@300 {
+			device_type = "cpu";
+			compatible = "arm,cortex-a510";
+			reg = <0x0 0x300>;
+			enable-method = "psci";
+			clocks = <&scmi_clk CLKID_CPU_CLK>;
+			operating-points-v2 = <&cpu_opp_table>;
+			dynamic-power-coefficient = <230>;
+			#cooling-cells = <2>;
+		};
+	};
+
+	sm: secure-monitor {
+		compatible = "amlogic,meson-gxbb-sm";
+
+		pwrc: power-controller {
+			compatible = "amlogic,s6-pwrc";
+			#power-domain-cells = <1>;
+		};
+	};
+
+	timer {
+		compatible = "arm,armv8-timer";
+		interrupts = <GIC_PPI 13 IRQ_TYPE_LEVEL_LOW>,
+			     <GIC_PPI 14 IRQ_TYPE_LEVEL_LOW>,
+			     <GIC_PPI 11 IRQ_TYPE_LEVEL_LOW>,
+			     <GIC_PPI 10 IRQ_TYPE_LEVEL_LOW>;
+	};
+
+	pmu {
+		compatible = "arm,cortex-a510-pmu";
+		interrupts = <GIC_SPI 364 IRQ_TYPE_LEVEL_HIGH>,
+			     <GIC_SPI 365 IRQ_TYPE_LEVEL_HIGH>,
+			     <GIC_SPI 366 IRQ_TYPE_LEVEL_HIGH>,
+			     <GIC_SPI 367 IRQ_TYPE_LEVEL_HIGH>;
+		interrupt-affinity = <&cpu0>, <&cpu1>, <&cpu2>, <&cpu3>;
+	};
+
+	psci {
+		compatible = "arm,psci-1.0";
+		method = "smc";
+	};
+
+	vrtc: rtc@fe010288 {
+		compatible = "amlogic,meson-vrtc";
+		reg = <0x0 0xfe010288 0x0 0x4>;
+	};
+
+	xtal: xtal-clk {
+		compatible = "fixed-clock";
+		clock-frequency = <24000000>;
+		clock-output-names = "xtal";
+		#clock-cells = <0>;
+	};
+
+	sram@50f6000 {
+		compatible = "mmio-sram";
+		reg = <0x0 0x50f6000 0x0 0x100>;
+		#address-cells = <1>;
+		#size-cells = <1>;
+		ranges = <0 0x0 0x50f6000 0x100>;
+
+		scmi_shmem: sram@0 {
+			compatible = "arm,scmi-shmem";
+			reg = <0x0 0x100>;
+		};
+	};
+
+	firmware {
+		optee {
+			compatible = "linaro,optee-tz";
+			method = "smc";
+		};
+
+		scmi: scmi {
+			compatible = "arm,scmi-smc";
+			arm,smc-id = <0x820000c1>;
+			shmem = <&scmi_shmem>;
+			#address-cells = <1>;
+			#size-cells = <0>;
+
+			scmi_clk: protocol@14 {
+				reg = <0x14>;
+				#clock-cells = <1>;
+			};
+		};
+	};
+
+	cpu_opp_table: opp-table-cpu {
+		compatible = "amlogic,s6-cpu-operating-points";
+		amlogic,secure-monitor = <&sm>;
+		opp-shared;
+
+		opp-500000000 {
+			opp-hz = /bits/ 64 <500000000>;
+			opp-microvolt = <799000>;
+			opp-microvolt-bin1 = <789000>;
+			opp-microvolt-bin2 = <779000>;
+			opp-microvolt-bin3 = <759000>;
+		};
+
+		opp-666666000 {
+			opp-hz = /bits/ 64 <666666000>;
+			opp-microvolt = <799000>;
+			opp-microvolt-bin1 = <789000>;
+			opp-microvolt-bin2 = <779000>;
+			opp-microvolt-bin3 = <759000>;
+		};
+
+		opp-1000000000 {
+			opp-hz = /bits/ 64 <1000000000>;
+			opp-microvolt = <799000>;
+			opp-microvolt-bin1 = <789000>;
+			opp-microvolt-bin2 = <779000>;
+			opp-microvolt-bin3 = <759000>;
+		};
+
+		opp-1200000000 {
+			opp-hz = /bits/ 64 <1200000000>;
+			opp-microvolt = <839000>;
+			opp-microvolt-bin1 = <809000>;
+			opp-microvolt-bin2 = <799000>;
+			opp-microvolt-bin3 = <779000>;
+		};
+
+		opp-1404000000 {
+			opp-hz = /bits/ 64 <1404000000>;
+			opp-microvolt = <859000>;
+			opp-microvolt-bin1 = <829000>;
+			opp-microvolt-bin2 = <819000>;
+			opp-microvolt-bin3 = <799000>;
+		};
+
+		opp-1608000000 {
+			opp-hz = /bits/ 64 <1608000000>;
+			opp-microvolt = <879000>;
+			opp-microvolt-bin1 = <849000>;
+			opp-microvolt-bin2 = <839000>;
+			opp-microvolt-bin3 = <809000>;
+		};
+
+		opp-1800000000 {
+			opp-hz = /bits/ 64 <1800000000>;
+			opp-microvolt = <909000>;
+			opp-microvolt-bin1 = <879000>;
+			opp-microvolt-bin2 = <869000>;
+			opp-microvolt-bin3 = <819000>;
+		};
+
+		opp-2004000000 {
+			opp-hz = /bits/ 64 <2004000000>;
+			opp-microvolt = <919000>;
+			opp-microvolt-bin1 = <899000>;
+			opp-microvolt-bin2 = <889000>;
+			opp-microvolt-bin3 = <839000>;
+		};
+
+		/* Only on the better bins (1-3) */
+		opp-2208000000 {
+			opp-hz = /bits/ 64 <2208000000>;
+			opp-supported-hw = <0xe>;
+			opp-microvolt-bin1 = <959000>;
+			opp-microvolt-bin2 = <949000>;
+			opp-microvolt-bin3 = <899000>;
+		};
+
+		/* Only on the better bins (1-3) */
+		opp-2304000000 {
+			opp-hz = /bits/ 64 <2304000000>;
+			opp-supported-hw = <0xe>;
+			opp-microvolt-bin1 = <989000>;
+			opp-microvolt-bin2 = <979000>;
+			opp-microvolt-bin3 = <919000>;
+		};
+
+		/* Only on the better bins (1-3) */
+		opp-2400000000 {
+			opp-hz = /bits/ 64 <2400000000>;
+			opp-supported-hw = <0xe>;
+			opp-microvolt-bin1 = <1019000>;
+			opp-microvolt-bin2 = <1009000>;
+			opp-microvolt-bin3 = <939000>;
+		};
