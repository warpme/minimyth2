From c5dcc31dac2456b6a3c5eb8e7ba12840250d77a4 Mon Sep 17 00:00:00 2001
From: Piotr Oniszczuk <piotr.oniszczuk@gmail.com>
Date: Tue, 17 Nov 2026 20:53:04 +0100
Subject: [PATCH 4/5] clk: meson: add support for the S6 PLL clock controller

Add a driver for the PLL controller of the Amlogic S6 SoC, modelled on
the S4 one. It registers the GP0, HIFI, HIFI1 and MCLK PLLs (DCO plus
output divider) and the fixed PLL dividers fclk_div2..7.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 drivers/clk/meson/Kconfig  |  14 ++
 drivers/clk/meson/Makefile |   1 +
 drivers/clk/meson/s6-pll.c | 465 +++++++++++++++++++++++++++++++++++++
 3 files changed, 480 insertions(+)
 create mode 100644 drivers/clk/meson/s6-pll.c

diff --git a/drivers/clk/meson/Kconfig b/drivers/clk/meson/Kconfig
index d460514bb..3b0e1ab2d 100644
--- a/drivers/clk/meson/Kconfig
+++ b/drivers/clk/meson/Kconfig
@@ -204,6 +204,20 @@ config COMMON_CLK_G12A
 	  Support for the clock controller on Amlogic S905D2, S905X2 and S905Y2
 	  devices, aka g12a. Say Y if you want peripherals to work.
 
+config COMMON_CLK_S6_PLL
+	tristate "S6 SoC PLL clock controller support"
+	depends on ARM64 || COMPILE_TEST
+	default ARCH_MESON
+	select COMMON_CLK_MESON_CLKC_UTILS
+	select COMMON_CLK_MESON_PLL
+	select COMMON_CLK_MESON_REGMAP
+	imply COMMON_CLK_SCMI
+	help
+	  Support for the PLL clock controller on Amlogic S6 based devices.
+	  It provides the gp0, hifi, hifi1 and mclk PLLs and the fixed PLL
+	  dividers, which are the parents of most peripherals.
+	  Say Y if you want the board to work.
+
 config COMMON_CLK_S4_PLL
 	tristate "S4 SoC PLL clock controllers support"
 	depends on ARM64
diff --git a/drivers/clk/meson/Makefile b/drivers/clk/meson/Makefile
index 56b04254e..b60664e8f 100644
--- a/drivers/clk/meson/Makefile
+++ b/drivers/clk/meson/Makefile
@@ -28,5 +28,6 @@ obj-$(CONFIG_COMMON_CLK_G12A) += g12a.o g12a-aoclk.o
 obj-$(CONFIG_COMMON_CLK_MESON8B) += meson8b.o meson8-ddr.o
 obj-$(CONFIG_COMMON_CLK_S4_PLL) += s4-pll.o
 obj-$(CONFIG_COMMON_CLK_S4_PERIPHERALS) += s4-peripherals.o
+obj-$(CONFIG_COMMON_CLK_S6_PLL) += s6-pll.o
 obj-$(CONFIG_COMMON_CLK_T7_CPU) += t7-cpu-clkc.o
 obj-$(CONFIG_COMMON_CLK_T7_PLL) += t7-pll.o
 obj-$(CONFIG_COMMON_CLK_T7_PERIPHERALS) += t7-peripherals.o
diff --git a/drivers/clk/meson/s6-pll.c b/drivers/clk/meson/s6-pll.c
new file mode 100644
index 000000000..1b80e04c1
--- /dev/null
+++ b/drivers/clk/meson/s6-pll.c
@@ -0,0 +1,465 @@
+// SPDX-License-Identifier: (GPL-2.0-only OR MIT)
+/*
+ * Amlogic S6 PLL Clock Controller Driver
+ *
+ * Copyright (c) 2019 Amlogic, Inc. All rights reserved.
+ */
+
+#include <linux/clk-provider.h>
+#include <linux/module.h>
+#include <linux/platform_device.h>
+
+#include "clk-pll.h"
+#include "clk-regmap.h"
+#include "meson-clkc-utils.h"
+#include <dt-bindings/clock/amlogic,s6-pll-clkc.h>
+
+#define ANACTRL_FIXPLL_CTRL1			0x044
+#define ANACTRL_GP0PLL_CTRL0			0x080
+#define ANACTRL_GP0PLL_CTRL1			0x084
+#define ANACTRL_GP0PLL_CTRL2			0x088
+#define ANACTRL_GP0PLL_CTRL3			0x08c
+#define ANACTRL_GP0PLL_CTRL4			0x090
+#define ANACTRL_HIFI0PLL_CTRL0			0x100
+#define ANACTRL_HIFI0PLL_CTRL1			0x104
+#define ANACTRL_HIFI0PLL_CTRL2			0x108
+#define ANACTRL_HIFI0PLL_CTRL3			0x10c
+#define ANACTRL_HIFI0PLL_CTRL4			0x110
+#define ANACTRL_HIFI1PLL_CTRL0			0x114
+#define ANACTRL_HIFI1PLL_CTRL1			0x118
+#define ANACTRL_HIFI1PLL_CTRL2			0x11c
+#define ANACTRL_HIFI1PLL_CTRL3			0x120
+#define ANACTRL_HIFI1PLL_CTRL4			0x124
+#define ANACTRL_CSIPLL_CTRL0			0x260
+#define ANACTRL_CSIPLL_CTRL1			0x264
+#define ANACTRL_CSIPLL_CTRL2			0x268
+#define ANACTRL_CSIPLL_CTRL3			0x26c
+
+/*
+ * The S6 PLLs use a power of two N divider, a multiplier given in half
+ * steps (the input is halved), and active low resets. The PLL output
+ * divider (OD) is a power of two divider modeled as a separate clock.
+ */
+#define S6_PLL_DCO_FLAGS	(CLK_MESON_PLL_POWER_OF_TWO |	\
+				 CLK_MESON_PLL_FIXED_EN0P5 |	\
+				 CLK_MESON_PLL_RSTN |		\
+				 CLK_MESON_PLL_L_RSTN)
+
+/* GP0 PLL */
+static const struct pll_params_table s6_gp0_pll_table[] = {
+	PLL_PARAMS(192, 0), /* DCO = 2304M */
+	{ /* sentinel */ }
+};
+
+static const struct reg_sequence s6_gp0_pll_init_regs[] = {
+	{ .reg = ANACTRL_GP0PLL_CTRL0, .def = 0x01010000 },
+	{ .reg = ANACTRL_GP0PLL_CTRL1, .def = 0x11480000 },
+	{ .reg = ANACTRL_GP0PLL_CTRL2, .def = 0x1215b010 },
+	{ .reg = ANACTRL_GP0PLL_CTRL3, .def = 0x20008010 },
+	{ .reg = ANACTRL_GP0PLL_CTRL4, .def = 0x00001000 }
+};
+
+static struct clk_regmap s6_gp0_pll_dco = {
+	.data = &(struct meson_clk_pll_data){
+		.en = {
+			.reg_off = ANACTRL_GP0PLL_CTRL0,
+			.shift   = 28,
+			.width   = 1,
+		},
+		.m = {
+			.reg_off = ANACTRL_GP0PLL_CTRL0,
+			.shift   = 0,
+			.width   = 9,
+		},
+		.n = {
+			.reg_off = ANACTRL_GP0PLL_CTRL0,
+			.shift   = 12,
+			.width   = 3,
+		},
+		.frac = {
+			.reg_off = ANACTRL_GP0PLL_CTRL1,
+			.shift   = 0,
+			.width   = 19,
+		},
+		.l = {
+			.reg_off = ANACTRL_GP0PLL_CTRL0,
+			.shift   = 31,
+			.width   = 1,
+		},
+		.rst = {
+			.reg_off = ANACTRL_GP0PLL_CTRL0,
+			.shift   = 29,
+			.width   = 1,
+		},
+		.l_rst = {
+			.reg_off = ANACTRL_GP0PLL_CTRL3,
+			.shift   = 29,
+			.width   = 1,
+		},
+		.table = s6_gp0_pll_table,
+		.init_regs = s6_gp0_pll_init_regs,
+		.init_count = ARRAY_SIZE(s6_gp0_pll_init_regs),
+		.flags = S6_PLL_DCO_FLAGS | CLK_MESON_PLL_NOINIT_ENABLED,
+	},
+	.hw.init = &(struct clk_init_data){
+		.name = "gp0_pll_dco",
+		.ops = &meson_clk_pll_ops,
+		.parent_data = &(const struct clk_parent_data) {
+			.fw_name = "gp0_pll_src",
+		},
+		.num_parents = 1,
+	},
+};
+
+static struct clk_regmap s6_gp0_pll = {
+	.data = &(struct clk_regmap_div_data){
+		.offset = ANACTRL_GP0PLL_CTRL0,
+		.shift = 20,
+		.width = 3,
+		.flags = CLK_DIVIDER_POWER_OF_TWO,
+	},
+	.hw.init = &(struct clk_init_data){
+		.name = "gp0_pll",
+		.ops = &clk_regmap_divider_ops,
+		.parent_hws = (const struct clk_hw *[]) {
+			&s6_gp0_pll_dco.hw
+		},
+		.num_parents = 1,
+		.flags = CLK_SET_RATE_PARENT,
+	},
+};
+
+/* HIFI and HIFI1 PLLs */
+static const struct pll_params_table s6_hifi_pll_table[] = {
+	PLL_PARAMS(150, 0), /* DCO = 1800M */
+	PLL_PARAMS(163, 0), /* DCO = 1956M */
+	{ /* sentinel */ }
+};
+
+#define S6_HIFI_PLL(_name, _pfx, _flags)					\
+static const struct reg_sequence s6_##_name##_init_regs[] = {		\
+	{ .reg = ANACTRL_##_pfx##_CTRL0, .def = 0x01010000 },		\
+	{ .reg = ANACTRL_##_pfx##_CTRL1, .def = 0x11480000 },		\
+	{ .reg = ANACTRL_##_pfx##_CTRL2, .def = 0x121db010 },		\
+	{ .reg = ANACTRL_##_pfx##_CTRL3, .def = 0x20008010 },		\
+	{ .reg = ANACTRL_##_pfx##_CTRL4, .def = 0x00001000 }		\
+};									\
+									\
+static struct clk_regmap s6_##_name##_dco = {				\
+	.data = &(struct meson_clk_pll_data){				\
+		.en = {							\
+			.reg_off = ANACTRL_##_pfx##_CTRL0,		\
+			.shift   = 28,					\
+			.width   = 1,					\
+		},							\
+		.m = {							\
+			.reg_off = ANACTRL_##_pfx##_CTRL0,		\
+			.shift   = 0,					\
+			.width   = 9,					\
+		},							\
+		.n = {							\
+			.reg_off = ANACTRL_##_pfx##_CTRL0,		\
+			.shift   = 12,					\
+			.width   = 3,					\
+		},							\
+		.frac = {						\
+			.reg_off = ANACTRL_##_pfx##_CTRL1,		\
+			.shift   = 0,					\
+			.width   = 19,					\
+		},							\
+		.l = {							\
+			.reg_off = ANACTRL_##_pfx##_CTRL0,		\
+			.shift   = 31,					\
+			.width   = 1,					\
+		},							\
+		.rst = {						\
+			.reg_off = ANACTRL_##_pfx##_CTRL0,		\
+			.shift   = 29,					\
+			.width   = 1,					\
+		},							\
+		.l_rst = {						\
+			.reg_off = ANACTRL_##_pfx##_CTRL3,		\
+			.shift   = 29,					\
+			.width   = 1,					\
+		},							\
+		.frac_max = 100000,					\
+		.table = s6_hifi_pll_table,				\
+		.init_regs = s6_##_name##_init_regs,			\
+		.init_count = ARRAY_SIZE(s6_##_name##_init_regs),	\
+		.flags = S6_PLL_DCO_FLAGS | CLK_MESON_PLL_ROUND_CLOSEST |	\
+			 (_flags),					\
+	},								\
+	.hw.init = &(struct clk_init_data){				\
+		.name = #_name "_dco",					\
+		.ops = &meson_clk_pll_ops,				\
+		.parent_data = &(const struct clk_parent_data) {	\
+			.fw_name = #_name "_src",			\
+		},							\
+		.num_parents = 1,					\
+	},								\
+};									\
+									\
+static struct clk_regmap s6_##_name = {					\
+	.data = &(struct clk_regmap_div_data){				\
+		.offset = ANACTRL_##_pfx##_CTRL0,			\
+		.shift = 20,						\
+		.width = 3,						\
+		.flags = CLK_DIVIDER_POWER_OF_TWO,			\
+	},								\
+	.hw.init = &(struct clk_init_data){				\
+		.name = #_name,						\
+		.ops = &clk_regmap_divider_ops,				\
+		.parent_hws = (const struct clk_hw *[]) {		\
+			&s6_##_name##_dco.hw				\
+		},							\
+		.num_parents = 1,					\
+		.flags = CLK_SET_RATE_PARENT,				\
+	},								\
+}
+
+S6_HIFI_PLL(hifi_pll, HIFI0PLL, CLK_MESON_PLL_NOINIT_ENABLED);
+S6_HIFI_PLL(hifi1_pll, HIFI1PLL, 0);
+
+/* MCLK PLL, built on the CSI PLL registers */
+static const struct pll_params_table s6_mclk_pll_table[] = {
