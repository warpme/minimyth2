From 9945c839f82d9e2d6bebcafd9316b90c5cff43bf Mon Sep 17 00:00:00 2001
From: Piotr Oniszczuk <piotr.oniszczuk@gmail.com>
Date: Tue, 17 Nov 2026 20:53:03 +0100
Subject: [PATCH 3/5] clk: meson: pll: add optional flags for S6 style PLLs

The Amlogic S6 PLLs differ from the existing ones: the N field is a
power-of-two exponent, the input is halved before the multiplier, the
reset bits are active low and there is an extra lock-reset bit.

Add the opt-in flags POWER_OF_TWO, FIXED_EN0P5, RSTN and L_RSTN and the
l_rst parameter to handle this. All new code is gated by these flags, so
the behaviour of PLLs of other SoCs is unchanged.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 drivers/clk/meson/clk-pll.c | 80 ++++++++++++++++++++++++++++++++-----
 drivers/clk/meson/clk-pll.h | 13 ++++++
 2 files changed, 82 insertions(+), 11 deletions(-)

diff --git a/drivers/clk/meson/clk-pll.c b/drivers/clk/meson/clk-pll.c
index 1ea6579a7..f623701cc 100644
--- a/drivers/clk/meson/clk-pll.c
+++ b/drivers/clk/meson/clk-pll.c
@@ -56,10 +56,18 @@ static unsigned long __pll_params_to_rate(unsigned long parent_rate,
 					  unsigned int frac,
 					  struct meson_clk_pll_data *pll)
 {
-	u64 rate = (u64)parent_rate * m;
+	u64 rate;
 	unsigned int frac_max = pll->frac_max ? pll->frac_max :
 						(1 << pll->frac.width);
 
+	if (pll->flags & CLK_MESON_PLL_POWER_OF_TWO)
+		n = BIT(n);
+
+	if (pll->flags & CLK_MESON_PLL_FIXED_EN0P5)
+		parent_rate >>= 1;
+
+	rate = (u64)parent_rate * m;
+
 	if (frac && MESON_PARM_APPLICABLE(&pll->frac)) {
 		u64 frac_rate = (u64)parent_rate * frac;
 
@@ -83,7 +91,7 @@ static unsigned long meson_clk_pll_recalc_rate(struct clk_hw *hw,
 	 * it would result in a division by zero. The rate can't be
 	 * calculated in this case
 	 */
-	if (n == 0)
+	if (n == 0 && !(pll->flags & CLK_MESON_PLL_POWER_OF_TWO))
 		return 0;
 
 	m = meson_parm_read(clk->map, &pll->m);
@@ -103,10 +111,19 @@ static unsigned int __pll_params_with_frac(unsigned long rate,
 {
 	unsigned int frac_max = pll->frac_max ? pll->frac_max :
 						(1 << pll->frac.width);
-	u64 val = (u64)rate * n;
+	unsigned int div = n;
+	u64 val;
+
+	if (pll->flags & CLK_MESON_PLL_POWER_OF_TWO)
+		div = BIT(n);
+
+	if (pll->flags & CLK_MESON_PLL_FIXED_EN0P5)
+		parent_rate >>= 1;
+
+	val = (u64)rate * div;
 
 	/* Bail out if we are already over the requested rate */
-	if (rate < parent_rate * m / n)
+	if (rate < parent_rate * m / div)
 		return 0;
 
 	if (pll->flags & CLK_MESON_PLL_ROUND_CLOSEST)
@@ -142,8 +159,13 @@ static int meson_clk_get_pll_table_index(unsigned int index,
 					 unsigned int *n,
 					 struct meson_clk_pll_data *pll)
 {
-	if (!pll->table[index].n)
+	/* With a power of two N, n == 0 is a valid entry: look at m instead */
+	if (pll->flags & CLK_MESON_PLL_POWER_OF_TWO) {
+		if (!pll->table[index].m)
+			return -EINVAL;
+	} else if (!pll->table[index].n) {
 		return -EINVAL;
+	}
 
 	*m = pll->table[index].m;
 	*n = pll->table[index].n;
@@ -297,7 +319,8 @@ static int meson_clk_pll_is_enabled(struct clk_hw *hw)
 	struct meson_clk_pll_data *pll = meson_clk_pll_data(clk);
 
 	if (MESON_PARM_APPLICABLE(&pll->rst) &&
-	    meson_parm_read(clk->map, &pll->rst))
+	    !!meson_parm_read(clk->map, &pll->rst) ==
+	    !(pll->flags & CLK_MESON_PLL_RSTN))
 		return 0;
 
 	if (!meson_parm_read(clk->map, &pll->en) ||
@@ -307,6 +330,24 @@ static int meson_clk_pll_is_enabled(struct clk_hw *hw)
 	return 1;
 }
 
+/* Assert or release the PLL reset, whatever its polarity */
+static void meson_pll_reset(struct clk_regmap *clk,
+			    struct meson_clk_pll_data *pll, bool assert)
+{
+	bool active_low = pll->flags & CLK_MESON_PLL_RSTN;
+
+	meson_parm_write(clk->map, &pll->rst, assert != active_low);
+}
+
+/* Assert or release the PLL lock detector reset, whatever its polarity */
+static void meson_pll_lock_reset(struct clk_regmap *clk,
+				 struct meson_clk_pll_data *pll, bool assert)
+{
+	bool active_low = pll->flags & CLK_MESON_PLL_L_RSTN;
+
+	meson_parm_write(clk->map, &pll->l_rst, assert != active_low);
+}
+
 static int meson_clk_pll_init(struct clk_hw *hw)
 {
 	struct clk_regmap *clk = to_clk_regmap(hw);
@@ -327,13 +368,13 @@ static int meson_clk_pll_init(struct clk_hw *hw)
 
 	if (pll->init_count) {
 		if (MESON_PARM_APPLICABLE(&pll->rst))
-			meson_parm_write(clk->map, &pll->rst, 1);
+			meson_pll_reset(clk, pll, true);
 
 		regmap_multi_reg_write(clk->map, pll->init_regs,
 				       pll->init_count);
 
 		if (MESON_PARM_APPLICABLE(&pll->rst))
-			meson_parm_write(clk->map, &pll->rst, 0);
+			meson_pll_reset(clk, pll, false);
 	}
 
 	return 0;
@@ -364,14 +405,31 @@ static int meson_clk_pll_enable(struct clk_hw *hw)
 
 	/* Make sure the pll is in reset */
 	if (MESON_PARM_APPLICABLE(&pll->rst))
-		meson_parm_write(clk->map, &pll->rst, 1);
+		meson_pll_reset(clk, pll, true);
+
+	/* Make sure the lock detector is in reset too */
+	if (MESON_PARM_APPLICABLE(&pll->l_rst))
+		meson_pll_lock_reset(clk, pll, true);
 
 	/* Enable the pll */
 	meson_parm_write(clk->map, &pll->en, 1);
 
+	/*
+	 * Let the pll stabilize before taking it out of reset, otherwise it
+	 * may fail to lock. This is only needed with the lock detector reset.
+	 */
+	if (MESON_PARM_APPLICABLE(&pll->l_rst))
+		udelay(50);
+
 	/* Take the pll out reset */
 	if (MESON_PARM_APPLICABLE(&pll->rst))
-		meson_parm_write(clk->map, &pll->rst, 0);
+		meson_pll_reset(clk, pll, false);
+
+	/* Take the lock detector out of reset */
+	if (MESON_PARM_APPLICABLE(&pll->l_rst)) {
+		udelay(20);
+		meson_pll_lock_reset(clk, pll, false);
+	}
 
 	/*
 	 * Compared with the previous SoCs, self-adaption current module
@@ -405,7 +463,7 @@ static void meson_clk_pll_disable(struct clk_hw *hw)
 
 	/* Put the pll is in reset */
 	if (MESON_PARM_APPLICABLE(&pll->rst))
-		meson_parm_write(clk->map, &pll->rst, 1);
+		meson_pll_reset(clk, pll, true);
 
 	/* Disable the pll */
 	meson_parm_write(clk->map, &pll->en, 0);
diff --git a/drivers/clk/meson/clk-pll.h b/drivers/clk/meson/clk-pll.h
index 949157fb7..04ebf8f73 100644
--- a/drivers/clk/meson/clk-pll.h
+++ b/drivers/clk/meson/clk-pll.h
@@ -29,6 +29,18 @@ struct pll_mult_range {
 
 #define CLK_MESON_PLL_ROUND_CLOSEST	BIT(0)
 #define CLK_MESON_PLL_NOINIT_ENABLED	BIT(1)
+/*
+ * The N field is the exponent of a power of two divider (the divider is
+ * 1 << N). A table entry is then terminated by m == 0, since n == 0 is valid.
+ * Only supported with a params table.
+ */
+#define CLK_MESON_PLL_POWER_OF_TWO	BIT(2)
+/* The input rate is halved before it enters the PLL. Params table only. */
+#define CLK_MESON_PLL_FIXED_EN0P5	BIT(3)
+/* The reset bit is active low */
+#define CLK_MESON_PLL_RSTN		BIT(4)
+/* The lock detector reset bit (l_rst) is active low */
+#define CLK_MESON_PLL_L_RSTN		BIT(5)
 
 struct meson_clk_pll_data {
 	struct parm en;
@@ -37,6 +49,7 @@ struct meson_clk_pll_data {
 	struct parm frac;
 	struct parm l;
 	struct parm rst;
+	struct parm l_rst;
 	struct parm current_en;
 	struct parm l_detect;
 	const struct reg_sequence *init_regs;
-- 
