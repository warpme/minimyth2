Developed-by: Piotr Oniszczuk <piotr.oniszczuk@gmail.com>
Signed-off-by: Piotr Oniszczuk <piotr.oniszczuk@gmail.com>



From 99dc3d33d3d33c53a406dd1da8f0d36e55647ec7 Mon Sep 17 00:00:00 2001
From: Piotr Oniszczuk <piotr.oniszczuk@gmail.com>
Date: Tue, 24 Nov 2026 11:55:49 +0100
Subject: [PATCH 2/2] rockchip: rk3528: Add generic target with Ethernet on
 GMAC0

Add a variant of the generic RK3528 target for TV boxes following the
Rockchip reference design, with eMMC, SD-card and Ethernet on GMAC0
using the integrated 10/100 PHY.

These boards power the logic and CPU rails from PWM regulators
(vdd_logic on PWM2, vdd_arm on PWM1). Describe both and let the
regulator uclass apply the init voltages at probe: 900 mV for vdd_logic
and 953 mV for vdd_arm, as on the Radxa ROCK 2 boards and in the vendor
BSP. Linux does not honour regulator-init-microvolt and only reads the
PWM state back, so without this vdd_logic stays too low until the first
consumer (the Mali GPU through devfreq) sets it, and the integrated
FEPHY links up intermittently and passes no traffic until then. That
breaks NFS root with ip=dhcp.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 arch/arm/dts/rk3528-generic-gmac0-u-boot.dtsi | 11 +++
 arch/arm/dts/rk3528-generic-gmac0.dts         | 99 +++++++++++++++++++
 configs/generic-gmac0-rk3528_defconfig        | 44 +++++++++
 3 files changed, 154 insertions(+)
 create mode 100644 arch/arm/dts/rk3528-generic-gmac0-u-boot.dtsi
 create mode 100644 arch/arm/dts/rk3528-generic-gmac0.dts
 create mode 100644 configs/generic-gmac0-rk3528_defconfig

diff --git a/arch/arm/dts/rk3528-generic-gmac0-u-boot.dtsi b/arch/arm/dts/rk3528-generic-gmac0-u-boot.dtsi
new file mode 100644
index 00000000..3e2fbd81
--- /dev/null
+++ b/arch/arm/dts/rk3528-generic-gmac0-u-boot.dtsi
@@ -0,0 +1,11 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+
+#include "rk3528-u-boot.dtsi"
+
+&vdd_arm {
+	regulator-init-microvolt = <953000>;
+};
+
+&vdd_logic {
+	regulator-init-microvolt = <900000>;
+};
diff --git a/arch/arm/dts/rk3528-generic-gmac0.dts b/arch/arm/dts/rk3528-generic-gmac0.dts
new file mode 100644
index 00000000..e32a266f
--- /dev/null
+++ b/arch/arm/dts/rk3528-generic-gmac0.dts
@@ -0,0 +1,99 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+/*
+ * Minimal generic DT for RK3528 TV boxes with eMMC, SD-card and
+ * Ethernet on GMAC0 using the integrated 10/100 PHY
+ */
+
+/dts-v1/;
+#include <dt-bindings/pwm/pwm.h>
+#include "rk3528.dtsi"
+
+/ {
+	model = "Generic RK3528 (GMAC0)";
+	compatible = "rockchip,rk3528";
+
+	aliases {
+		ethernet0 = &gmac0;
+		mmc0 = &sdhci;
+		mmc1 = &sdmmc;
+		serial0 = &uart0;
+	};
+
+	chosen {
+		stdout-path = "serial0:1500000n8";
+	};
+
+	vcc5v0_sys: regulator-5v0-vcc-sys {
+		compatible = "regulator-fixed";
+		regulator-name = "vcc5v0_sys";
+		regulator-always-on;
+		regulator-boot-on;
+		regulator-min-microvolt = <5000000>;
+		regulator-max-microvolt = <5000000>;
+	};
+
+	vdd_arm: regulator-vdd-arm {
+		compatible = "pwm-regulator";
+		pwms = <&pwm1 0 5000 PWM_POLARITY_INVERTED>;
+		pwm-supply = <&vcc5v0_sys>;
+		regulator-name = "vdd_arm";
+		regulator-always-on;
+		regulator-boot-on;
+		regulator-min-microvolt = <746000>;
+		regulator-max-microvolt = <1201000>;
+		regulator-settling-time-up-us = <250>;
+	};
+
+	vdd_logic: regulator-vdd-logic {
+		compatible = "pwm-regulator";
+		pwms = <&pwm2 0 5000 PWM_POLARITY_INVERTED>;
+		pwm-supply = <&vcc5v0_sys>;
+		regulator-name = "vdd_logic";
+		regulator-always-on;
+		regulator-boot-on;
+		regulator-min-microvolt = <705000>;
+		regulator-max-microvolt = <1006000>;
+		regulator-settling-time-up-us = <250>;
+	};
+};
+
+&gmac0 {
+	status = "okay";
+};
+
+&pwm1 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&pwm1m0_pins>;
+	status = "okay";
+};
+
+&pwm2 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&pwm2m0_pins>;
+	status = "okay";
+};
+
+&sdhci {
+	bus-width = <8>;
+	cap-mmc-highspeed;
+	mmc-hs200-1_8v;
+	no-sd;
+	no-sdio;
+	non-removable;
+	status = "okay";
+};
+
+&sdmmc {
+	bus-width = <4>;
+	cap-sd-highspeed;
+	disable-wp;
+	no-mmc;
+	no-sdio;
+	status = "okay";
+};
+
+&uart0 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&uart0m0_xfer>;
+	status = "okay";
+};
diff --git a/configs/generic-gmac0-rk3528_defconfig b/configs/generic-gmac0-rk3528_defconfig
