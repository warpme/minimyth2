diff --speed-large-files --no-dereference --minimal -Naur linux-7.3.6/drivers/tee/optee/smc_abi.c linux-7.3.6/drivers/tee/optee/smc_abi.c
--- linux-7.3.6/drivers/tee/optee/smc_abi.c	2026-11-26 13:13:51.865262733 +0100
+++ linux-7.3.6/drivers/tee/optee/smc_abi.c	2026-11-26 13:12:23.191137597 +0100
@@ -1775,7 +1775,8 @@
 	if ((sec_caps & OPTEE_SMC_SEC_CAP_HAVE_RESERVED_SHM) &&
 	    (of_machine_is_compatible("amlogic,s4")  ||
 	     of_machine_is_compatible("amlogic,sc2") ||
-	     of_machine_is_compatible("amlogic,t7")))
+	     of_machine_is_compatible("amlogic,t7")  ||
+	     of_machine_is_compatible("amlogic,s6")))
 		sec_caps &= ~OPTEE_SMC_SEC_CAP_DYNAMIC_SHM;
 
 	/*
@@ -1785,7 +1786,8 @@
 	 */
 	if (of_machine_is_compatible("amlogic,s4")  ||
 	    of_machine_is_compatible("amlogic,sc2") ||
-	    of_machine_is_compatible("amlogic,t7")) {
+	    of_machine_is_compatible("amlogic,t7")  ||
+	    of_machine_is_compatible("amlogic,s6")) {
 		struct arm_smccc_res res;
 
 		invoke_fn(OPTEE_SMC_AMLOGIC_SYS_BOOT_COMPLETE,
