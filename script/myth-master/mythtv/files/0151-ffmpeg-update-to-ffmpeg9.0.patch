+
+static inline int imin(const int a, const int b)
+{
+    return a < b ? a : b;
+}
+
+static inline void *checkasm_handle_oom(void *ptr)
+{
+    if (!ptr) {
+        fprintf(stderr, "checkasm: out of memory\n");
+        exit(1);
