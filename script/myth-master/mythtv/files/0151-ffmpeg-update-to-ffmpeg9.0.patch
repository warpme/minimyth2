--- /dev/null
+++ b/mythtv/external/FFmpeg/libavformat/lcevc.c
@@ -0,0 +1,339 @@
+/*
+ * LCEVC helper functions for muxers
+ *
+ * This file is part of FFmpeg.
+ *
