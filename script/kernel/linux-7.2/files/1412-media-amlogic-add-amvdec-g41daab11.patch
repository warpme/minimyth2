+struct h264_field_ref_scratch {
+	struct v4l2_h264_reflist_builder builder;
+	struct v4l2_h264_reference ordered[2][V4L2_H264_REF_LIST_LEN];
+	struct v4l2_ctrl_h264_decode_params params;
+};
