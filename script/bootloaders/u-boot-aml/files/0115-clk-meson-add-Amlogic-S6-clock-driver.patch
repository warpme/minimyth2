+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Amlogic S6 (S905X5) PLL and peripherals clock controllers
+ *
+ * Register layout and bit positions follow the Linux S6 clock drivers
+ * (drivers/clk/meson/s6-pll.c and s6-peripherals.c).
+ *
+ * On S6 the fixed PLL, the GP1/GP2 PLLs, the sys and axi clocks are owned
+ * by the secure firmware and exposed through SCMI. U-Boot does not touch
+ * them: they are taken as external inputs ("fixed_pll", "sys_clk", ...)
+ * from the device tree, typically as fixed-rate clocks matching the rates
+ * set up by BL2.
+ *
+ * PLL controller: only the fixed PLL dividers (fclk_div*) are described.
+ * Their gates are owned by the firmware too, so they are read-only.
+ *
+ * Peripherals controller, following operations are supported:
+ * - calculating clock frequency on a limited tree
+ * - reading muxes and dividers
+ * - enabling/disabling gates without propagation, except for the I2C
+ *   and PWM bus gates which are chained behind the I2C_M_A and PWM_A
+ *   gates
+ * - reparenting without rate propagation, only on muxes
+ * - setting rates with limited reparenting, only on the SD/eMMC
+ *   dividers with mux parent
+ */
+
+#include <clk-uclass.h>
+#include <dm.h>
+#include <log.h>
+#include <regmap.h>
+#include <dt-bindings/clock/amlogic,s6-peripherals-clkc.h>
+#include <dt-bindings/clock/amlogic,s6-pll-clkc.h>
+#include "clk_meson.h"
+
+/* PLL controller registers */
+#define ANACTRL_FIXPLL_CTRL1		0x044
+
+/* Peripherals controller registers */
+#define CLKCTRL_SYS_CLK_EN0_REG0	0x044
+#define CLKCTRL_SYS_CLK_EN0_REG1	0x048
+#define CLKCTRL_SYS_CLK_EN0_REG2	0x04c
+#define CLKCTRL_SYS_CLK_EN0_REG3	0x050
+#define CLKCTRL_AXI_CLK_EN0		0x0ac
+#define CLKCTRL_ETH_CLK_CTRL		0x164
+#define CLKCTRL_NAND_CLK_CTRL		0x168
+#define CLKCTRL_SD_EMMC_CLK_CTRL	0x16c
+
+/*
+ * PLL controller
+ */
+
+/* External clock IDs. Those should not overlap with regular IDs */
+enum {
+	PLL_EXTERNAL_FIXED_PLL = CLKID_FCLK_DIV7 + 1,
+};
+
+#define S6_FCLK(_id, _name, _mult, _div, _bit)				\
+	[_id##_DIV] = CLK_DIV_FIXED_FULL(_name "_div", _mult, _div,	\
+					 PLL_EXTERNAL_FIXED_PLL),	\
+	[_id] = CLK_GATE(_name, ANACTRL_FIXPLL_CTRL1, _bit, _id##_DIV)
+
+static const struct meson_clk_info *meson_pll_clocks[] = {
+	S6_FCLK(CLKID_FCLK50M,		"fclk50m",	1, 40, 4),
+	S6_FCLK(CLKID_FCLK_DIV2,	"fclk_div2",	1, 2, 20),
+	S6_FCLK(CLKID_FCLK_DIV2P5,	"fclk_div2p5",	2, 5, 8),
+	S6_FCLK(CLKID_FCLK_DIV3,	"fclk_div3",	1, 3, 16),
+	S6_FCLK(CLKID_FCLK_DIV4,	"fclk_div4",	1, 4, 17),
+	S6_FCLK(CLKID_FCLK_DIV5,	"fclk_div5",	1, 5, 18),
+	S6_FCLK(CLKID_FCLK_DIV7,	"fclk_div7",	1, 7, 19),
+
+	[PLL_EXTERNAL_FIXED_PLL] = CLK_EXTERNAL("fixed_pll"),
+};
+
+/*
+ * Peripherals controller
+ */
+
+/* External clock IDs. Those should not overlap with regular IDs */
+enum {
+	EXTERNAL_XTAL = CLKID_AXI_CPU_SRAM + 1,
+	EXTERNAL_FCLK_DIV2,
+	EXTERNAL_FCLK_DIV2P5,
+	EXTERNAL_FCLK_DIV3,
+	EXTERNAL_FCLK_DIV4,
+	EXTERNAL_FCLK_DIV5,
+	EXTERNAL_FCLK_DIV7,
+	EXTERNAL_GP0_PLL,
+	EXTERNAL_GP1_PLL,
+	EXTERNAL_HIFI_PLL,
+	EXTERNAL_SYS_CLK,
+	EXTERNAL_AXI_CLK,
+};
+
+/* Mux index 5 is not connected */
+#define S6_SD_EMMC_PARENTS {	\
+	EXTERNAL_XTAL,		\
+	EXTERNAL_FCLK_DIV2,	\
+	EXTERNAL_FCLK_DIV3,	\
+	EXTERNAL_HIFI_PLL,	\
+	EXTERNAL_FCLK_DIV2P5,	\
+	-ENOENT,		\
+	EXTERNAL_GP1_PLL,	\
+	EXTERNAL_GP0_PLL,	\
+}
+
+#define S6_SYS_GATE(_id, _name, _reg, _bit) \
+	[_id] = CLK_GATE(_name, _reg, _bit, EXTERNAL_SYS_CLK)
+
+#define S6_SYS_GATE_CHAINED(_id, _name, _reg, _bit, _parent) \
+	[_id] = CLK_GATE(_name, _reg, _bit, _parent)
+
+#define S6_AXI_GATE(_id, _name, _bit) \
+	[_id] = CLK_GATE(_name, CLKCTRL_AXI_CLK_EN0, _bit, EXTERNAL_AXI_CLK)
+
