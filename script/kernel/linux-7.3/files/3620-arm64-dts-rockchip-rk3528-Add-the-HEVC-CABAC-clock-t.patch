From b6ba2105204b60d43949de78f40a6f89907a5804 Mon Sep 17 00:00:00 2001
From: Piotr Oniszczuk <piotr.oniszczuk@gmail.com>
Date: Mon, 23 Nov 2026 11:44:46 +0100
Subject: [PATCH] arm64: dts: rockchip: rk3528: Add the HEVC CABAC clock to the
 VDEC IOMMU

Without the HEVC CABAC clock of the decoder, the force reset of the
second MMU instance of the video decoder IOMMU times out:

  rk_iommu ff740800.iommu: FORCE_RESET command timed out

Add it to the IOMMU clocks, like the Rockchip vendor kernel does.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 arch/arm64/boot/dts/rockchip/rk3528.dtsi | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/arch/arm64/boot/dts/rockchip/rk3528.dtsi b/arch/arm64/boot/dts/rockchip/rk3528.dtsi
index 53826dfd0..a6b941f72 100644
--- a/arch/arm64/boot/dts/rockchip/rk3528.dtsi
+++ b/arch/arm64/boot/dts/rockchip/rk3528.dtsi
@@ -813,8 +813,9 @@ vdec_mmu: iommu@ff740800 {
 			compatible = "rockchip,rk3528-iommu", "rockchip,rk3568-iommu";
 			reg = <0x0 0xff740800 0x0 0x40>, <0x0 0xff740900 0x0 0x40>;
 			interrupts = <GIC_SPI 95 IRQ_TYPE_LEVEL_HIGH>;
-			clocks = <&cru ACLK_RKVDEC>, <&cru HCLK_RKVDEC>;
-			clock-names = "aclk", "iface";
+			clocks = <&cru ACLK_RKVDEC>, <&cru HCLK_RKVDEC>,
+				 <&cru CLK_HEVC_CA_RKVDEC>;
+			clock-names = "aclk", "iface", "hevc_cabac";
 			#iommu-cells = <0>;
 			status = "disabled";
 		};
