From 6bdef7bdb04926e0063e2768e9c9e203e31b8ccc Mon Sep 17 00:00:00 2001
From: Piotr Oniszczuk <piotr.oniszczuk@gmail.com>
Date: Tue, 24 Nov 2026 11:55:24 +0100
Subject: [PATCH 3/3] arm64: dts: rockchip: rk3528: Add the FEPHY trim cells

Describe the OTP cells holding the factory bandgap trim and Tx amplitude
of the integrated FEPHY, and hand them to the PHY node.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 arch/arm64/boot/dts/rockchip/rk3528.dtsi | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/arch/arm64/boot/dts/rockchip/rk3528.dtsi b/arch/arm64/boot/dts/rockchip/rk3528.dtsi
index a6b941f72..2b22ecc5f 100644
--- a/arch/arm64/boot/dts/rockchip/rk3528.dtsi
+++ b/arch/arm64/boot/dts/rockchip/rk3528.dtsi
@@ -1349,6 +1349,8 @@ rmii0_phy: ethernet-phy@2 {
 					compatible = "ethernet-phy-ieee802.3-c22";
 					reg = <0x2>;
 					clocks = <&cru CLK_MACPHY>;
+					nvmem-cells = <&macphy_txlevel>, <&macphy_bgs>;
+					nvmem-cell-names = "txlevel", "bgs";
 					phy-is-integrated;
 					pinctrl-names = "default";
 					pinctrl-0 = <&fephym0_led_link>,
@@ -1549,6 +1551,14 @@ gpu_leakage: gpu-leakage@1c {
 					reg = <0x1c 0x1>;
 				};
 
+				macphy_bgs: macphy-bgs@2d {
+					reg = <0x2d 0x1>;
+				};
+
+				macphy_txlevel: macphy-txlevel@2e {
+					reg = <0x2e 0x2>;
+				};
+
 				tsadc_trim: tsadc-trim@44 {
 					reg = <0x44 0x2>;
 					bits = <0 10>;
-- 
