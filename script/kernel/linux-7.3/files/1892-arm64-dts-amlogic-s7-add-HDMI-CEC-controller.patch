From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Piotr Oniszczuk <piotr.oniszczuk@gmail.com>
Date: Thu, 26 Nov 2026 14:16:51 +0100
Subject: [PATCH 1892/1893] arm64: dts: amlogic: s7: add HDMI CEC controller

Add the CEC B controller of the Amlogic S7 SoC and its pin (GPIOH_3,
function 2). S7 has only the CEC B controller, version 3, like S4 and
S6, so it falls back to the S4 compatible. The 32768 Hz clock comes
from the CECB dual divider, as on S6.

Signed-off-by: Piotr Oniszczuk <piotr.oniszczuk@gmail.com>
---
 arch/arm64/boot/dts/amlogic/amlogic-s7.dtsi | 21 +++++++++++++++++++++
 1 file changed, 21 insertions(+)

diff --git a/arch/arm64/boot/dts/amlogic/amlogic-s7.dtsi b/arch/arm64/boot/dts/amlogic/amlogic-s7.dtsi
index 134aafa..ca552bd 100644
--- a/arch/arm64/boot/dts/amlogic/amlogic-s7.dtsi
+++ b/arch/arm64/boot/dts/amlogic/amlogic-s7.dtsi
@@ -332,6 +332,13 @@
 					gpio-ranges = <&periphs_pinctrl 0 (AMLOGIC_GPIO_CC<<8) 2>;
 				};
 
+				func-cec {
+					hdmitx_cec_pins: group-cec {
+						pinmux = <AML_PINMUX(AMLOGIC_GPIO_H, 3, 2)>;
+						bias-disable;
+					};
+				};
+
 				func-emmc {
 					emmc_pins: group-emmc-default {
 						pinmux = <AML_PINMUX(AMLOGIC_GPIO_B, 0, 1)>,
@@ -448,6 +455,20 @@
 				reg = <0x0 0x36048 0x0 0x14>;
 			};
 
+			cecb: cec@44040 {
+				compatible = "amlogic,meson-s7-ao-cec",
+					     "amlogic,meson-s4-ao-cec";
+				reg = <0x0 0x44040 0x0 0x14>;
+				interrupts = <GIC_SPI 180 IRQ_TYPE_EDGE_RISING>;
+				clocks = <&clkc_periphs CLKID_CECB_CLK>;
+				clock-names = "core";
+				assigned-clocks = <&clkc_periphs CLKID_CECB_CLK>;
+				assigned-clock-parents = <&clkc_periphs CLKID_CECB_DUAL>;
+				assigned-clock-rates = <32768>;
+				hdmi-phandle = <&hdmi_tx>;
+				status = "disabled";
+			};
+
 			clk_msr: clock-measure@48000 {
 				compatible = "amlogic,s7-clk-measure";
 				reg = <0x0 0x48000 0x0 0x1c>;
-- 
