From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Piotr Oniszczuk <piotr.oniszczuk@gmail.com>
Date: Thu, 26 Nov 2026 16:32:57 +0100
Subject: [PATCH] thermal: amlogic: add S7 support

The S7 temperature sensor is the S6 one: the calibration data comes from
the secure monitor, with the S7 coefficients of the vendor device tree
(cal_coeff = n, m, B, A).

Signed-off-by: Piotr Oniszczuk <piotr.oniszczuk@gmail.com>
---
 drivers/thermal/amlogic_thermal.c | 21 +++++++++++++++++++++
 1 file changed, 21 insertions(+)

diff --git a/drivers/thermal/amlogic_thermal.c b/drivers/thermal/amlogic_thermal.c
index 3fb0fc3..ec61b1f 100644
--- a/drivers/thermal/amlogic_thermal.c
+++ b/drivers/thermal/amlogic_thermal.c
@@ -311,6 +311,23 @@ static const struct amlogic_thermal_data amlogic_thermal_s6_param = {
 	.regmap_config		= &amlogic_thermal_regmap_config_g12a,
 };
 
+/*
+ * S7: the S6 sensor with its own coefficients (vendor cal_coeff, given
+ * as n, m, B, A).
+ */
+static const struct amlogic_thermal_soc_calib_data amlogic_thermal_s7 = {
+	.A = 8739,
+	.B = 2907,
+	.m = 396,
+	.n = 296,
+};
+
+static const struct amlogic_thermal_data amlogic_thermal_s7_param = {
+	.use_sm			= true,
+	.calibration_parameters	= &amlogic_thermal_s7,
+	.regmap_config		= &amlogic_thermal_regmap_config_g12a,
+};
+
 static const struct amlogic_thermal_data amlogic_thermal_t7_param = {
 	.use_sm			= true,
 	.calibration_parameters	= &amlogic_thermal_g12a,
@@ -348,6 +365,10 @@ static const struct of_device_id of_amlogic_thermal_match[] = {
 		.compatible = "amlogic,s6-thermal",
 		.data = &amlogic_thermal_s6_param,
 	},
+	{
+		.compatible = "amlogic,s7-thermal",
+		.data = &amlogic_thermal_s7_param,
+	},
 	{ /* sentinel */ }
 };
 MODULE_DEVICE_TABLE(of, of_amlogic_thermal_match);
-- 
