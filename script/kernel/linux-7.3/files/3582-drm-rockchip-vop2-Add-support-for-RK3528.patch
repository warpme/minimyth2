 static const struct vop2_video_port_data rk3588_vop_video_ports[] = {
 	{
 		.id = 0,
@@ -2456,6 +2690,114 @@ static void rk3576_vop2_setup_overlay(struct vop2_video_port *vp)
 	rk3576_vop2_setup_dly_for_windows(vp);
