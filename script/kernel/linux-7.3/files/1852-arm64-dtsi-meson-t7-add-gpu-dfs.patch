Patch from MiniMyth2 project

Developed-by: Piotr Oniszczuk <piotr.oniszczuk@gmail.com>
Signed-off-by: Piotr Oniszczuk <piotr.oniszczuk@gmail.com>



diff --speed-large-files --no-dereference --minimal -Naur linux-7.3.4/arch/arm64/boot/dts/amlogic/amlogic-t7.dtsi linux-7.3.4/arch/arm64/boot/dts/amlogic/amlogic-t7.dtsi
--- linux-7.3.4/arch/arm64/boot/dts/amlogic/amlogic-t7.dtsi	2026-11-11 22:17:10.018042211 +0100
+++ linux-7.3.4/arch/arm64/boot/dts/amlogic/amlogic-t7.dtsi	2026-11-11 22:16:26.797201845 +0100
@@ -472,6 +472,37 @@
 		};
 	};
 
+	gpu_opp_table: opp-table-gpu {
+		compatible = "operating-points-v2";
+
+		/*
+		 * Frequency-only: the voltage of VDDGPU is board specific.
+		 * Add opp-microvolt and mali-supply in the board dts once the
+		 * voltage per frequency is known.
+		 */
+		opp-124999998 {
+			opp-hz = /bits/ 64 <124999998>;
+		};
+		opp-249999996 {
+			opp-hz = /bits/ 64 <249999996>;
+		};
+		opp-285714281 {
+			opp-hz = /bits/ 64 <285714281>;
+		};
+		opp-399999994 {
+			opp-hz = /bits/ 64 <399999994>;
+		};
+		opp-499999992 {
+			opp-hz = /bits/ 64 <499999992>;
+		};
+		opp-666666656 {
+			opp-hz = /bits/ 64 <666666656>;
+		};
+		opp-799999987 {
+			opp-hz = /bits/ 64 <799999987>;
+		};
+	};
+
 	vrtc: rtc@fe010288 {
 		compatible = "amlogic,meson-vrtc";
 		reg = <0x0 0xfe010288 0x0 0x4>;
@@ -1070,6 +1101,7 @@
 							 <0>,
 							 <&clkc_periphs CLKID_MALI_0>;
 				assigned-clock-rates = <0>, <800000000>, <0>;
+				operating-points-v2 = <&gpu_opp_table>;
 				/* The GPU is IO-coherent (ACE-Lite) on T7 */
 				dma-coherent;
 				#cooling-cells = <2>;
@@ -1506,6 +1538,13 @@
 					type = "critical";
 				};
 			};
+
+			cooling-maps {
+				map0 {
+					trip = <&gpu_passive>;
+					cooling-device = <&gpu THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
+				};
+			};
 		};
 
 		hevc_thermal: hevc-thermal {
--

MiniMyth2

