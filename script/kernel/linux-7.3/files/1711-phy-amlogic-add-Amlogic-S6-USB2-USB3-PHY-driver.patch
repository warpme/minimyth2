@@ -0,0 +1,137 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/phy/amlogic,s6-usb-phy.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Amlogic S6 USB2 and USB3 PHYs
+
+maintainers:
+  - Piotr Oniszczuk <piotr.oniszczuk@gmail.com>
+
+properties:
+  compatible:
+    enum:
+      - amlogic,s6-usb2-phy
+      - amlogic,s6-usb3-phy
+
+  reg:
+    minItems: 2
+    maxItems: 3
+
+  reg-names:
+    minItems: 2
+    maxItems: 3
+
+  clocks:
+    minItems: 1
+    maxItems: 2
+
+  clock-names:
+    minItems: 1
+    maxItems: 2
+
+  resets:
+    minItems: 2
+    maxItems: 2
+
+  reset-names:
+    minItems: 2
+    maxItems: 2
+
+  phy-supply:
+    description:
+      Regulator providing VBUS for the port, enabled while the PHY is in
+      host mode.
+
+  amlogic,pll-sw-cfg:
+    type: boolean
+    description:
+      Configure the USB3 PLLs by software instead of relying on the hardware
+      sequencer.
+
+  "#phy-cells":
+    const: 0
+
+required:
+  - compatible
+  - reg
+  - reg-names
+  - clocks
+  - clock-names
+  - resets
+  - reset-names
+  - "#phy-cells"
+
+allOf:
+  - if:
+      properties:
+        compatible:
+          const: amlogic,s6-usb2-phy
+    then:
+      properties:
+        reg:
+          items:
+            - description: PHY control registers
+            - description: PHY configuration registers
+            - description: eFuse shadow register with the calibration trim
+        reg-names:
+          items:
+            - const: ctrl
+            - const: cfg
+            - const: trim
+        clocks:
+          maxItems: 1
+        clock-names:
+          items:
+            - const: general
+        reset-names:
+          items:
+            - const: phy
+            - const: comb
+        amlogic,pll-sw-cfg: false
+      required:
+        - reg
+  - if:
+      properties:
+        compatible:
+          const: amlogic,s6-usb3-phy
+    then:
+      properties:
+        reg:
+          items:
+            - description: PHY control registers
+            - description: eFuse shadow register with the calibration trim
+        reg-names:
+          items:
+            - const: ctrl
+            - const: trim
+        clocks:
+          minItems: 2
+        clock-names:
+          items:
+            - const: apb
+            - const: pipe
+        reset-names:
+          items:
+            - const: phy
+            - const: apb
+        phy-supply: false
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/clock/amlogic,s6-peripherals-clkc.h>
+    #include <dt-bindings/reset/amlogic,s6-reset.h>
+
+    phy@348000 {
+        compatible = "amlogic,s6-usb2-phy";
+        reg = <0x348000 0x10>, <0x34c000 0x60>, <0x10330 0x4>;
+        reg-names = "ctrl", "cfg", "trim";
+        clocks = <&clkc CLKID_SYS_USB2DRD>;
+        clock-names = "general";
+        resets = <&reset RESET_U2DRD_USB2PHY>, <&reset RESET_U2DRD_COMB>;
+        reset-names = "phy", "comb";
+        #phy-cells = <0>;
+    };
