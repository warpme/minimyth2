# dd if=u-boot.bin.sd.bin of=${sd_drive} conv=fsync,notrunc bs=442 count=1
# dd if=u-boot.bin.sd.bin of=${sd_drive} conv=fsync,notrunc bs=512 skip=1 seek=1

part /u-boot --source amlogic-sdboot --sourceparams="file=@MM_HOME@/images/main/boot/s6loaderfiles/u-boot.bin.sd.bin" --ondisk mmcblk0 --no-table --offset 1s
