diff --speed-large-files --no-dereference --minimal -Naur linux-7.2-rc6/arch/arm64/boot/dts/rockchip/rk3576-nanopi-r76s.dts linux-7.2-rc6/arch/arm64/boot/dts/rockchip/rk3576-nanopi-r76s.dts
--- linux-7.2-rc6/arch/arm64/boot/dts/rockchip/rk3576-nanopi-r76s.dts	2026-08-03 01:24:24.000000000 +0200
+++ linux-7.2-rc6/arch/arm64/boot/dts/rockchip/rk3576-nanopi-r76s.dts	2026-08-04 10:31:37.207717153 +0200
@@ -20,8 +20,8 @@
 	compatible = "friendlyarm,nanopi-r76s", "rockchip,rk3576";
 
 	aliases {
-		mmc0 = &sdhci;
-		mmc1 = &sdmmc;
+		mmc0 = &sdmmc;
+		mmc1 = &sdhci;
 		mmc2 = &sdio;
 	};
 
@@ -58,7 +58,7 @@
 			color = <LED_COLOR_ID_RED>;
 			function = LED_FUNCTION_POWER;
 			gpios = <&gpio2 RK_PB3 GPIO_ACTIVE_HIGH>;
-			linux,default-trigger = "heartbeat";
+			linux,default-trigger = "disk-activity";
 		};
 
 		led-2 {
@@ -79,6 +79,12 @@
 		};
 	};
 
+	usbc_vin2_0 {
+		compatible = "iio-hwmon";
+		io-channels = <&saradc 0 &saradc 1 &saradc 2 &saradc 3 &saradc 4 &saradc 5 &saradc 6 &saradc 7>;
+		status = "okay";
+	};
+
 	sdio_pwrseq: sdio-pwrseq {
 		compatible = "mmc-pwrseq-simple";
 		clocks = <&hym8563>;
@@ -869,3 +875,7 @@
 		remote-endpoint = <&hdmi_in_vp0>;
 	};
 };
+
+&wdt {
+	status= "okay";
+};
--

MiniMyth2

