diff --speed-large-files --no-dereference --minimal -Naur linux-7.2-rc6/include/drm/drm_plane.h linux-7.2-rc6/include/drm/drm_plane.h
--- linux-7.2-rc6/include/drm/drm_plane.h	2026-08-04 18:29:27.448595325 +0200
+++ linux-7.2-rc6/include/drm/drm_plane.h	2026-08-04 18:25:54.257657142 +0200
@@ -976,9 +976,9 @@
