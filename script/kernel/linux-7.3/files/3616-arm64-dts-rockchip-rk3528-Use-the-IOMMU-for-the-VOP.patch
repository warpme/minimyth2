From b0a67531ee1e6bd1c582f55454eeade1e8cac3d3 Mon Sep 17 00:00:00 2001
From: Piotr Oniszczuk <piotr.oniszczuk@gmail.com>
Date: Sun, 22 Nov 2026 16:31:52 +0100
Subject: [PATCH] arm64: dts: rockchip: rk3528: Use the IOMMU for the VOP

Hook up the VOP IOMMU and mark it with rockchip,disable-device-link-resume,
so that it is only resumed by the VOP driver once the VOP aclk pre auto
gating is disabled. Resuming it earlier, through the runtime PM device
link, hangs the system on the first IOMMU register access.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 arch/arm64/boot/dts/rockchip/rk3528.dtsi | 8 +++-----
 1 file changed, 3 insertions(+), 5 deletions(-)

diff --git a/arch/arm64/boot/dts/rockchip/rk3528.dtsi b/arch/arm64/boot/dts/rockchip/rk3528.dtsi
index 53f5320..54dbff9 100644
--- a/arch/arm64/boot/dts/rockchip/rk3528.dtsi
+++ b/arch/arm64/boot/dts/rockchip/rk3528.dtsi
@@ -739,11 +739,7 @@
 				      "hclk",
 				      "dclk_vp0",
 				      "dclk_vp1";
-			/*
-			 * Enabling the VOP IOMMU (iommus = <&vop_mmu>) currently
-			 * hangs the system when it is resumed via its device link
-			 * during the VOP probe, so the VOP uses CMA buffers for now.
-			 */
+			iommus = <&vop_mmu>;
 			power-domains = <&power RK3528_PD_VO>;
 			status = "disabled";
 
@@ -773,6 +769,8 @@
 			clock-names = "aclk", "iface";
 			#iommu-cells = <0>;
 			power-domains = <&power RK3528_PD_VO>;
+			/* must only be enabled by the VOP driver, see vop2_enable() */
+			rockchip,disable-device-link-resume;
 			status = "disabled";
 		};
 
