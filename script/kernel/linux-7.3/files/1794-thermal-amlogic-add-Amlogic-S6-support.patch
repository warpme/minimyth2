From 6f52ae01442fb961b7a81233774adcabf148fc3c Mon Sep 17 00:00:00 2001
From: Piotr Oniszczuk <piotr.oniszczuk@gmail.com>
Date: Wed, 18 Nov 2026 18:14:14 +0100
Subject: [PATCH] thermal: amlogic: add Amlogic S6 support

The S6 temperature sensors use the T7 scheme (calibration data read from
the secure monitor, one index per sensor) but have their own calibration
coefficients (vendor cal_coeff 270 370 2747 9164, mapped like the G12A
324 424 3159 9411 set to n, m, B, A). Add the "amlogic,s6-thermal"
compatible and its binding.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 .../bindings/thermal/amlogic,thermal.yaml      |  5 ++++-
 drivers/thermal/amlogic_thermal.c              | 18 ++++++++++++++++++
 2 files changed, 22 insertions(+), 1 deletion(-)

diff --git a/Documentation/devicetree/bindings/thermal/amlogic,thermal.yaml b/Documentation/devicetree/bindings/thermal/amlogic,thermal.yaml
index e72cb39ac..093d058f1 100644
diff --git a/drivers/thermal/amlogic_thermal.c b/drivers/thermal/amlogic_thermal.c
index 5f2565d02..932eb7777 100644
--- a/drivers/thermal/amlogic_thermal.c
+++ b/drivers/thermal/amlogic_thermal.c
@@ -273,6 +273,20 @@ static const struct amlogic_thermal_data amlogic_thermal_a1_cpu_param = {
 	.regmap_config = &amlogic_thermal_regmap_config_g12a,
 };
 
+/* S6 uses the T7 calibration scheme with its own coefficients (vendor cal_coeff) */
+static const struct amlogic_thermal_soc_calib_data amlogic_thermal_s6 = {
+	.A = 9164,
+	.B = 2747,
+	.m = 370,
+	.n = 270,
+};
+
+static const struct amlogic_thermal_data amlogic_thermal_s6_param = {
+	.use_sm			= true,
+	.calibration_parameters	= &amlogic_thermal_s6,
+	.regmap_config		= &amlogic_thermal_regmap_config_g12a,
+};
+
 static const struct amlogic_thermal_data amlogic_thermal_t7_param = {
 	.use_sm			= true,
 	.calibration_parameters	= &amlogic_thermal_g12a,
@@ -296,6 +310,10 @@ static const struct of_device_id of_amlogic_thermal_match[] = {
 		.compatible = "amlogic,t7-thermal",
 		.data = &amlogic_thermal_t7_param,
 	},
+	{
+		.compatible = "amlogic,s6-thermal",
+		.data = &amlogic_thermal_s6_param,
+	},
 	{ /* sentinel */ }
 };
 MODULE_DEVICE_TABLE(of, of_amlogic_thermal_match);
-- 
