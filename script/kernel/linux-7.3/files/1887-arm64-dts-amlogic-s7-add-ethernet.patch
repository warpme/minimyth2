From ffa5a6ee613505cc68ccede3c48790535defb4c2 Mon Sep 17 00:00:00 2001
From: Piotr Oniszczuk <piotr.oniszczuk@gmail.com>
Date: Wed, 25 Nov 2026 14:33:39 +0100
Subject: [PATCH] arm64: dts: amlogic: s7: add ethernet

Add the ethernet MAC, the MDIO multiplexer with the internal 10/100 PHY
and the ethernet LED pins of the Amlogic S7 SoC, based on the Amlogic
BSP. S7 has no external MII/RGMII pins, only the internal PHY is usable.

The MAC is a GMAC4 (dwmac 4.00) behind the meson8b/axg glue. The MDIO
multiplexer is the G12A one, but the internal PHY PLL needs S7 settings,
hence the dedicated amlogic,s7-mdio-mux compatible.

The TX checksum offload of the MAC produces payload checksum errors on
S7 (large TCP transfers stall), so the DMA runs in threshold mode, like
in the vendor device tree, which also disables TX COE in stmmac.

Signed-off-by: Piotr Oniszczuk <piotr.oniszczuk@gmail.com>
---
 arch/arm64/boot/dts/amlogic/amlogic-s7.dtsi | 62 +++++++++++++++++++++
 1 file changed, 62 insertions(+)

diff --git a/arch/arm64/boot/dts/amlogic/amlogic-s7.dtsi b/arch/arm64/boot/dts/amlogic/amlogic-s7.dtsi
index a9d73aa73..297d767ee 100644
--- a/arch/arm64/boot/dts/amlogic/amlogic-s7.dtsi
+++ b/arch/arm64/boot/dts/amlogic/amlogic-s7.dtsi
@@ -292,6 +292,13 @@ emmc_clk_gate_pins: group-emmc-clk-gate {
 					};
 				};
 
+				func-eth {
+					eth_led_pins: group-eth-led {
+						pinmux = <AML_PINMUX(AMLOGIC_GPIO_H, 10, 1)>,
+							 <AML_PINMUX(AMLOGIC_GPIO_H, 11, 1)>;
+					};
+				};
+
 				func-sdcard {
 					sdcard_pins: group-sdcard-default {
 						pinmux = <AML_PINMUX(AMLOGIC_GPIO_C, 0, 1)>,
@@ -405,6 +412,61 @@ emmc: mmc@8c000 {
 				assigned-clocks = <&clkc_periphs CLKID_SD_EMMC_C>;
 				assigned-clock-rates = <24000000>;
 			};
+
+			eth_phy: mdio-multiplexer@360000 {
+				compatible = "amlogic,s7-mdio-mux";
+				reg = <0x0 0x360000 0x0 0xa4>;
+				#address-cells = <1>;
+				#size-cells = <0>;
+				clocks = <&clkc_periphs CLKID_SYS_ETHPHY>,
+					 <&xtal>,
+					 <&clkc_pll CLKID_FCLK_50M>;
+				clock-names = "pclk", "clkin0", "clkin1";
+				mdio-parent-bus = <&mdio0>;
+
+				ext_mdio: mdio@0 {
+					reg = <0>;
+					#address-cells = <1>;
+					#size-cells = <0>;
+				};
+
+				int_mdio: mdio@1 {
+					reg = <1>;
+					#address-cells = <1>;
+					#size-cells = <0>;
+
+					internal_ephy: ethernet-phy@8 {
+						compatible = "ethernet-phy-id0180.3301",
+							     "ethernet-phy-ieee802.3-c22";
+						interrupts = <GIC_SPI 75 IRQ_TYPE_LEVEL_HIGH>;
+						reg = <8>;
+						max-speed = <100>;
+					};
+				};
+			};
+
+			ethmac: ethernet@368000 {
+				compatible = "amlogic,meson-axg-dwmac",
+					     "snps,dwmac-4.00",
+					     "snps,dwmac";
+				reg = <0x0 0x368000 0x0 0x2000>,
+				      <0x0 0x364000 0x0 0x8>;
+				interrupts = <GIC_SPI 74 IRQ_TYPE_LEVEL_HIGH>;
+				interrupt-names = "macirq";
+				power-domains = <&pwrc PWRC_S7_ETH_ID>;
+				clocks = <&clkc_periphs CLKID_SYS_ETH>,
+					 <&clkc_pll CLKID_FCLK_DIV2>,
+					 <&clkc_pll CLKID_FCLK_50M>;
+				clock-names = "stmmaceth", "clkin0", "clkin1";
+				snps,force_thresh_dma_mode;
+				status = "disabled";
+
+				mdio0: mdio {
+					#address-cells = <1>;
+					#size-cells = <0>;
+					compatible = "snps,dwmac-mdio";
+				};
+			};
 		};
 	};
 };
