From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Piotr Oniszczuk <piotr.oniszczuk@gmail.com>
Date: Thu, 26 Nov 2026 14:34:09 +0100
Subject: [PATCH] arm64: dts: amlogic: tanix-tx5: enable CPU frequency scaling

The bootloader starts the CPUs of the Tanix TX5 at 1704 MHz and sets
VDDCPU (PWM J) for that rate, to about 1.0 V. This is above the voltage
of every OPP of the S7 table, so use the table for frequency scaling
only and keep the boot voltage. The PWM J is not yet handled by Linux.

Signed-off-by: Piotr Oniszczuk <piotr.oniszczuk@gmail.com>
---
 .../amlogic/amlogic-s7-s905y5-tanix-tx5.dts   | 21 +++++++++++++++++++
 1 file changed, 21 insertions(+)

diff --git a/arch/arm64/boot/dts/amlogic/amlogic-s7-s905y5-tanix-tx5.dts b/arch/arm64/boot/dts/amlogic/amlogic-s7-s905y5-tanix-tx5.dts
index 2e74d91..613e1af 100644
--- a/arch/arm64/boot/dts/amlogic/amlogic-s7-s905y5-tanix-tx5.dts
+++ b/arch/arm64/boot/dts/amlogic/amlogic-s7-s905y5-tanix-tx5.dts
@@ -196,6 +196,27 @@
 	status = "okay";
 };
 
+/*
+ * The bootloader starts the CPUs at 1704 MHz and sets VDDCPU (PWM J) for
+ * that rate, about 1.0 V. This is above the voltage of every OPP, so
+ * scale only the frequency and keep the boot voltage.
+ */
+&cpu0 {
+	operating-points-v2 = <&cpu_opp_table>;
+};
+
+&cpu1 {
+	operating-points-v2 = <&cpu_opp_table>;
+};
+
+&cpu2 {
+	operating-points-v2 = <&cpu_opp_table>;
+};
+
+&cpu3 {
+	operating-points-v2 = <&cpu_opp_table>;
+};
+
 &cecb {
 	pinctrl-0 = <&hdmitx_cec_pins>;
 	pinctrl-names = "default";
-- 
2.43.0

