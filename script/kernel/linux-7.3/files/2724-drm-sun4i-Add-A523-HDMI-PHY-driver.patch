index 0000000..17eec76
--- /dev/null
+++ b/drivers/gpu/drm/sun4i/sun55i_hdmi_phy.c
@@ -0,0 +1,570 @@
+// SPDX-License-Identifier: GPL-2.0+
+/* Copyright (c) 2026 Jernej Skrabec <jernej.skrabec@gmail.com> */
+
+/*
+ * Allwinner A523/A527/T527 HDMI PHY (Innosilicon HDMI 2.0 TX PHY).
+ *
+ * The PHY is hosted in the same MMIO region as the Synopsys DesignWare
+ * HDMI controller, starting at offset 0x10000. Register width is 8-bit.
+ *
+ * Programming sequence, register layout and parameters follow the
+ * Allwinner BSP (disp2/hdmi2/aw_hdmi_core/dw_hdmi/phy_inno.c).
+ */
+
+#include <linux/bitfield.h>
+#include <linux/bits.h>
+#include <linux/delay.h>
+#include <linux/io.h>
+#include <linux/iopoll.h>
+#include <linux/math.h>
+
+#include <drm/bridge/dw_hdmi.h>
+#include <drm/drm_modes.h>
+
+#include "sun8i_dw_hdmi.h"
+
+#define SUN55I_HDMI_PHY_RXSENSE_TIMEOUT_US	5000
+#define SUN55I_HDMI_PHY_PLL_TIMEOUT_US		5000
+
+#define SUN55I_HDMI_PHY_CTL0_0			0x00
+#define  SUN55I_HDMI_PHY_CTL0_0_RST_DI		BIT(6)
+#define  SUN55I_HDMI_PHY_CTL0_0_RST_AN		BIT(7)
+
+#define SUN55I_HDMI_PHY_CTL0_2			0x02
+#define  SUN55I_HDMI_PHY_CTL0_2_DATA_SY_CTL	BIT(0)
+
+#define SUN55I_HDMI_PHY_PLL0_0			0xa0
+#define  SUN55I_HDMI_PHY_PLL0_0_PREPLL_POW	BIT(0)
+#define  SUN55I_HDMI_PHY_PLL0_0_PIX_CLK_BP	BIT(1)
+#define SUN55I_HDMI_PHY_PLL0_1			0xa1
+#define  SUN55I_HDMI_PHY_PLL0_1_PREDIV		GENMASK(5, 0)
+#define SUN55I_HDMI_PHY_PLL0_2			0xa2
+#define  SUN55I_HDMI_PHY_PLL0_2_FBDIV1		GENMASK(3, 0)
+#define  SUN55I_HDMI_PHY_PLL0_2_FRA_CTL		GENMASK(5, 4)
+#define SUN55I_HDMI_PHY_PLL0_3			0xa3
+#define SUN55I_HDMI_PHY_PLL1_0			0xa4
+#define  SUN55I_HDMI_PHY_PLL1_0_TMDSCLK_DIV	GENMASK(1, 0)
+#define  SUN55I_HDMI_PHY_PLL1_0_LINKCLK_DIV	GENMASK(3, 2)
+#define  SUN55I_HDMI_PHY_PLL1_0_LINKTMDSCLK_DIV	GENMASK(5, 4)
+#define SUN55I_HDMI_PHY_PLL1_1			0xa5
+#define  SUN55I_HDMI_PHY_PLL1_1_AUXCLK_DIV	GENMASK(4, 0)
+#define  SUN55I_HDMI_PHY_PLL1_1_MAINCLK_DIV	GENMASK(6, 5)
+#define SUN55I_HDMI_PHY_PLL1_2			0xa6
+#define  SUN55I_HDMI_PHY_PLL1_2_PIXCLK_DIV	GENMASK(4, 0)
+#define  SUN55I_HDMI_PHY_PLL1_2_RECLK_DIV	GENMASK(6, 5)
+#define SUN55I_HDMI_PHY_PLL2_1			0xa9
+#define  SUN55I_HDMI_PHY_PLL2_1_PREPLL_LOCK	BIT(0)
+#define SUN55I_HDMI_PHY_PLL2_2			0xaa
+#define  SUN55I_HDMI_PHY_PLL2_2_POSTPLL_POW	BIT(0)
+#define  SUN55I_HDMI_PHY_PLL2_2_POSTDIV_EN	GENMASK(3, 2)
+#define SUN55I_HDMI_PHY_PLL2_3			0xab
+#define  SUN55I_HDMI_PHY_PLL2_3_PRED_DIV	GENMASK(4, 0)
+#define SUN55I_HDMI_PHY_PLL3_0			0xac
+#define SUN55I_HDMI_PHY_PLL3_1			0xad
+#define  SUN55I_HDMI_PHY_PLL3_1_POSTDIV		GENMASK(2, 0)
+#define  SUN55I_HDMI_PHY_PLL3_1_FBDIV1		BIT(4)
+#define SUN55I_HDMI_PHY_PLL3_3			0xaf
+#define  SUN55I_HDMI_PHY_PLL3_3_POSTPLL_LOCK	BIT(0)
+
+#define SUN55I_HDMI_PHY_DR0_0			0xb0
+#define  SUN55I_HDMI_PHY_DR0_0_REFRES		BIT(1)
+#define  SUN55I_HDMI_PHY_DR0_0_BIAS_EN		BIT(2)
+#define SUN55I_HDMI_PHY_DR0_2			0xb2
+#define  SUN55I_HDMI_PHY_DR0_2_DR_EN		GENMASK(3, 0)
+/* pre-emphasis in [2:0], post-emphasis in [7:4] */
+#define SUN55I_HDMI_PHY_DR0_3			0xb3	/* clk */
+#define SUN55I_HDMI_PHY_DR2_3			0xbb	/* ch2 */
+#define SUN55I_HDMI_PHY_DR3_0			0xbc	/* ch1 */
+#define SUN55I_HDMI_PHY_DR3_1			0xbd	/* ch0 */
+#define  SUN55I_HDMI_PHY_PRE_EMPL		GENMASK(2, 0)
+#define  SUN55I_HDMI_PHY_POST_EMPL		GENMASK(7, 4)
+#define SUN55I_HDMI_PHY_DR1_0			0xb4
+#define  SUN55I_HDMI_PHY_DR1_0_LDO_EN		GENMASK(3, 0)
+/* voltage level in [4:0] */
+#define SUN55I_HDMI_PHY_DR1_1			0xb5	/* clk */
+#define SUN55I_HDMI_PHY_DR1_2			0xb6	/* ch2 */
+#define SUN55I_HDMI_PHY_DR1_3			0xb7	/* ch1 */
+#define SUN55I_HDMI_PHY_DR2_0			0xb8	/* ch0 */
+#define  SUN55I_HDMI_PHY_VLEVEL			GENMASK(4, 0)
+#define SUN55I_HDMI_PHY_DR2_1			0xb9
+#define  SUN55I_HDMI_PHY_DR2_1_LDO_CUR		GENMASK(2, 0)
+#define SUN55I_HDMI_PHY_DR3_2			0xbe
+#define  SUN55I_HDMI_PHY_DR3_2_SERI_EN		GENMASK(6, 4)
+#define SUN55I_HDMI_PHY_DR3_3			0xbf
+#define  SUN55I_HDMI_PHY_DR3_3_CH2_CUR_BIAS	GENMASK(3, 0)
+#define  SUN55I_HDMI_PHY_DR3_3_CLK_CUR_BIAS	GENMASK(7, 4)
+#define SUN55I_HDMI_PHY_DR4_0			0xc0
+#define  SUN55I_HDMI_PHY_DR4_0_CH0_CUR_BIAS	GENMASK(3, 0)
+#define  SUN55I_HDMI_PHY_DR4_0_CH1_CUR_BIAS	GENMASK(7, 4)
+#define SUN55I_HDMI_PHY_DR5_1			0xc5
+#define  SUN55I_HDMI_PHY_DR5_1_TERRESCAL_CLKDIV1	GENMASK(6, 0)
+#define  SUN55I_HDMI_PHY_DR5_1_TERRESCAL_BP	BIT(7)
+#define SUN55I_HDMI_PHY_DR5_2			0xc6
+#define SUN55I_HDMI_PHY_DR5_3			0xc7
+#define  SUN55I_HDMI_PHY_DR5_3_TERRES_VAL	GENMASK(2, 1)
+#define  SUN55I_HDMI_PHY_DR5_3_TERRESCAL	GENMASK(6, 4)
+
+#define SUN55I_HDMI_PHY_RXSEN_ESD_0		0xcc
+#define  SUN55I_HDMI_PHY_RXSEN_ESD_0_EN		GENMASK(3, 0)
+#define SUN55I_HDMI_PHY_RXSEN_ESD_1		0xcd
+#define  SUN55I_HDMI_PHY_RXSEN_ESD_1_CH0	GENMASK(1, 0)
+#define  SUN55I_HDMI_PHY_RXSEN_ESD_1_CH1	GENMASK(3, 2)
+#define  SUN55I_HDMI_PHY_RXSEN_ESD_1_CH2	GENMASK(5, 4)
+#define  SUN55I_HDMI_PHY_RXSEN_ESD_1_CLK	GENMASK(7, 6)
+
+#define SUN55I_HDMI_PHY_PLL_FRA_1		0xd1
+#define SUN55I_HDMI_PHY_PLL_FRA_2		0xd2
+#define SUN55I_HDMI_PHY_PLL_FRA_3		0xd3
+
+/*
+ * 32-bit register outside of 8-bit PHY register file. BSP writes 0x100
+ * ("off", 0x33 is "on") there on all PHY revisions except the first one
+ * (T527 A/B). Meaning is not documented.
+ */
+#define SUN55I_HDMI_PHY_CTRL_8004		0x8004
+#define  SUN55I_HDMI_PHY_CTRL_8004_VAL		0x00000100
+
+/*
+ * PHY configuration table. Values are taken verbatim from BSP, including
+ * packing of the multi-field words:
+ *
+ *  prepll_div:      (fbdiv1 << 16) | (fbdiv0 << 8) | prediv
+ *  prepll_clk_div:  (tmdsclk_div << 16) | (linkclk_div << 8) | linktmdsclk_div
+ *  prepll_clk_div1: (auxclk_div << 8) | mainclk_div
+ *  prepll_clk_div2: (pix_clk_bp << 16) | (pixclk_div << 8) | reclk_div
+ *  prepll_fra:      (fra_ctl << 24) | (fra_div0 << 16) | (fra_div1 << 8) | fra_div2
+ *  postpll:         (postdiv_en << 24) | (fbdiv0 << 16) | (fbdiv1 << 8) | pred_div
+ *  cur_bias:        (clk << 24) | (ch2 << 16) | (ch1 << 8) | ch0
+ *  vlevel:          (ch0 << 24) | (ch1 << 16) | (ch2 << 8) | clk
+ *  pre/post_empl:   (ch0 << 24) | (ch1 << 16) | (ch2 << 8) | clk
+ */
+struct sun55i_hdmi_phy_cfg {
+	u32 tmds_khz;
+	u32 prepll_div;
+	u32 prepll_clk_div;
+	u32 prepll_clk_div1;
+	u32 prepll_clk_div2;
+	u32 prepll_fra;
+	u32 postpll;
+	u8  postpll_postdiv;
+	u32 cur_bias;
+	u32 vlevel;
+	u32 pre_empl;
+	u32 post_empl;
+};
+
+/*
+ * BSP "inno_phy_version_2" (A523, SoC mark id 0x5c00 / 0xff10), 8-bit
+ * colour depth entries only. Mainline sun8i dw-hdmi always outputs
+ * RGB888, so deep colour entries are not needed.
+ */
+static const struct sun55i_hdmi_phy_cfg sun55i_a523_phy_cfg[] = {
+	{  25200, 0x00002a01, 0x00010103, 0x00000103, 0x00000403, 0x03000000,
+	   0x03280000, 0x03, 0x00020203, 0x1c1c1c1c, 0x00000000, 0x00000000 },
+	{  27000, 0x00003601, 0x00020202, 0x00000603, 0x00000403, 0x03000000,
+	   0x03280000, 0x03, 0x01010102, 0x1c1c1c1c, 0x00000000, 0x00000000 },
+	{  37125, 0x00006301, 0x00030301, 0x00000102, 0x00000403, 0x03000000,
+	   0x03500004, 0x01, 0x02060708, 0x1c1c1c1c, 0x00000000, 0x05050500 },
+	{  74250, 0x00006301, 0x00020201, 0x00000102, 0x00000403, 0x03000000,
+	   0x03140001, 0x01, 0x01010102, 0x1c1c1c1c, 0x00000000, 0x00000000 },
+	{ 148500, 0x00006301, 0x00010101, 0x00000102, 0x00000202, 0x03000000,
+	   0x030a0001, 0x00, 0x01010102, 0x1c1c1c1c, 0x00000000, 0x00000000 },
+	{ 297000, 0x00006301, 0x00000001, 0x00000102, 0x00000101, 0x03000000,
+	   0x03140002, 0x00, 0x01020304, 0x1c1c1c1c, 0x00000000, 0x05050500 },
+	{ 594000, 0x00006301, 0x00000200, 0x00000100, 0x00000101, 0x03000000,
+	   0x00140004, 0x00, 0x010e0f0f, 0x1c1c1c1c, 0x00000000, 0x00000000 },
+};
+
+static inline u8 sun55i_byte(u32 val, unsigned int idx)
+{
+	return (val >> (idx * 8)) & 0xff;
+}
+
+static void sun55i_phy_mask(struct sun8i_hdmi_phy *phy, u32 reg,
+			    u8 mask, u8 val)
+{
+	u8 cur = readb(phy->base + reg);
+
+	writeb((cur & ~mask) | (val & mask), phy->base + reg);
+}
+
+static void sun55i_phy_field(struct sun8i_hdmi_phy *phy, u32 reg,
+			     u8 mask, u8 val)
+{
+	sun55i_phy_mask(phy, reg, mask, field_prep(mask, val));
+}
+
+static void sun55i_phy_set(struct sun8i_hdmi_phy *phy, u32 reg, u8 bits)
+{
+	sun55i_phy_mask(phy, reg, bits, bits);
+}
+
+static void sun55i_phy_clr(struct sun8i_hdmi_phy *phy, u32 reg, u8 bits)
+{
+	sun55i_phy_mask(phy, reg, bits, 0);
+}
+
+static u32 sun55i_phy_tmds_khz(const struct drm_display_mode *mode)
+{
+	u32 khz = mode->clock;
+
+	/* pixel repetition (480i / 576i) doubles TMDS rate */
+	if (mode->flags & DRM_MODE_FLAG_DBLCLK)
+		khz *= 2;
+
+	return khz;
+}
+
+/*
+ * PHY PLL is programmed from a fixed table and runs from the 24 MHz
+ * reference, while pixel clock for TCON comes from CCU. Both must have
+ * the same frequency, otherwise picture is missing or unstable. BSP picks
+ * the nearest entry, but here only rates which match a table entry within
+ * 0.05% (EDID rounding) are accepted. Unsupported modes are filtered out
+ * by sun55i_hdmi_phy_mode_valid().
+ */
+static const struct sun55i_hdmi_phy_cfg *sun55i_phy_find_cfg(u32 tmds_khz)
+{
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(sun55i_a523_phy_cfg); i++) {
+		u32 rate = sun55i_a523_phy_cfg[i].tmds_khz;
+
+		if (abs((int)rate - (int)tmds_khz) <= rate / 2000)
+			return &sun55i_a523_phy_cfg[i];
+	}
+
+	return NULL;
+}
+
+enum drm_mode_status
+sun55i_hdmi_phy_mode_valid(const struct drm_display_mode *mode)
+{
+	if (!sun55i_phy_find_cfg(sun55i_phy_tmds_khz(mode)))
+		return MODE_CLOCK_RANGE;
+
+	return MODE_OK;
+}
+
+static void sun55i_phy_analog_reset(struct sun8i_hdmi_phy *phy)
+{
+	sun55i_phy_clr(phy, SUN55I_HDMI_PHY_CTL0_0, SUN55I_HDMI_PHY_CTL0_0_RST_AN);
+	usleep_range(10000, 11000);
+	sun55i_phy_set(phy, SUN55I_HDMI_PHY_CTL0_0, SUN55I_HDMI_PHY_CTL0_0_RST_AN);
+}
+
+static void sun55i_phy_digital_reset(struct sun8i_hdmi_phy *phy)
+{
+	sun55i_phy_clr(phy, SUN55I_HDMI_PHY_CTL0_0, SUN55I_HDMI_PHY_CTL0_0_RST_DI);
+	usleep_range(10000, 11000);
+	sun55i_phy_set(phy, SUN55I_HDMI_PHY_CTL0_0, SUN55I_HDMI_PHY_CTL0_0_RST_DI);
+}
+
+static void sun55i_phy_drivers(struct sun8i_hdmi_phy *phy, bool on)
+{
+	sun55i_phy_mask(phy, SUN55I_HDMI_PHY_DR0_2, SUN55I_HDMI_PHY_DR0_2_DR_EN,
+			on ? 0xff : 0);
+}
+
+static void sun55i_phy_serializers(struct sun8i_hdmi_phy *phy, bool on)
+{
+	sun55i_phy_mask(phy, SUN55I_HDMI_PHY_DR3_2, SUN55I_HDMI_PHY_DR3_2_SERI_EN,
+			on ? 0xff : 0);
+}
+
+static void sun55i_phy_ldos(struct sun8i_hdmi_phy *phy, bool on)
+{
+	sun55i_phy_mask(phy, SUN55I_HDMI_PHY_DR1_0, SUN55I_HDMI_PHY_DR1_0_LDO_EN,
+			on ? 0xff : 0);
+	/* not present on T527 A/B PHY revision */
+	sun55i_phy_mask(phy, SUN55I_HDMI_PHY_DR2_1, SUN55I_HDMI_PHY_DR2_1_LDO_CUR,
+			on ? 0xff : 0);
+}
+
+static void sun55i_phy_plls(struct sun8i_hdmi_phy *phy, bool on)
+{
+	/* power down bits */
+	sun55i_phy_mask(phy, SUN55I_HDMI_PHY_PLL2_2,
+			SUN55I_HDMI_PHY_PLL2_2_POSTPLL_POW, on ? 0 : 0xff);
+	sun55i_phy_mask(phy, SUN55I_HDMI_PHY_PLL0_0,
+			SUN55I_HDMI_PHY_PLL0_0_PREPLL_POW, on ? 0 : 0xff);
+}
+
+static void sun55i_phy_rxsense(struct sun8i_hdmi_phy *phy, bool on)
+{
+	sun55i_phy_mask(phy, SUN55I_HDMI_PHY_RXSEN_ESD_0,
+			SUN55I_HDMI_PHY_RXSEN_ESD_0_EN, on ? 0xff : 0);
+}
+
+static void sun55i_phy_bias(struct sun8i_hdmi_phy *phy, bool on)
+{
+	sun55i_phy_mask(phy, SUN55I_HDMI_PHY_DR0_0, SUN55I_HDMI_PHY_DR0_0_BIAS_EN,
+			on ? 0xff : 0);
+}
+
+static void sun55i_phy_off(struct sun8i_hdmi_phy *phy)
+{
+	sun55i_phy_drivers(phy, false);
+	sun55i_phy_serializers(phy, false);
+	sun55i_phy_ldos(phy, false);
+	sun55i_phy_plls(phy, false);
+	sun55i_phy_rxsense(phy, false);
+	sun55i_phy_bias(phy, false);
+}
+
+static bool sun55i_phy_rxsense_all(u8 val)
+{
+	return FIELD_GET(SUN55I_HDMI_PHY_RXSEN_ESD_1_CH0, val) &&
+	       FIELD_GET(SUN55I_HDMI_PHY_RXSEN_ESD_1_CH1, val) &&
+	       FIELD_GET(SUN55I_HDMI_PHY_RXSEN_ESD_1_CH2, val) &&
+	       FIELD_GET(SUN55I_HDMI_PHY_RXSEN_ESD_1_CLK, val);
+}
+
+static void sun55i_phy_wait_rxsense(struct sun8i_hdmi_phy *phy)
+{
+	u8 val;
+	int ret;
+
+	/* BSP first waits for all lanes, then accepts any lane */
+	ret = readb_poll_timeout(phy->base + SUN55I_HDMI_PHY_RXSEN_ESD_1, val,
+				 sun55i_phy_rxsense_all(val), 5,
+				 SUN55I_HDMI_PHY_RXSENSE_TIMEOUT_US / 2);
+	if (!ret)
+		return;
+
+	ret = readb_poll_timeout(phy->base + SUN55I_HDMI_PHY_RXSEN_ESD_1, val,
+				 val, 5, SUN55I_HDMI_PHY_RXSENSE_TIMEOUT_US / 2);
+	/* not fatal, BSP also continues */
+	if (ret)
+		dev_warn(phy->dev, "rxsense detection timeout, forcing config\n");
+}
+
+static int sun55i_phy_wait_pll(struct sun8i_hdmi_phy *phy)
+{
+	u8 val;
+	int ret;
+
+	ret = readb_poll_timeout(phy->base + SUN55I_HDMI_PHY_PLL2_1, val,
+				 val & SUN55I_HDMI_PHY_PLL2_1_PREPLL_LOCK,
+				 5, SUN55I_HDMI_PHY_PLL_TIMEOUT_US);
+	if (ret) {
+		dev_err(phy->dev, "pre-PLL lock timeout\n");
+		return ret;
+	}
+
+	ret = readb_poll_timeout(phy->base + SUN55I_HDMI_PHY_PLL3_3, val,
+				 val & SUN55I_HDMI_PHY_PLL3_3_POSTPLL_LOCK,
+				 5, SUN55I_HDMI_PHY_PLL_TIMEOUT_US);
+	if (ret)
+		dev_err(phy->dev, "post-PLL lock timeout\n");
+
+	return ret;
+}
+
+static void sun55i_phy_config_4k60(struct sun8i_hdmi_phy *phy)
+{
+	/* termination resistor calibration clock: 24 MHz / 240 = 100 kHz */
+	writeb(0xf0, phy->base + SUN55I_HDMI_PHY_DR5_2);
+	sun55i_phy_field(phy, SUN55I_HDMI_PHY_DR5_1,
+			 SUN55I_HDMI_PHY_DR5_1_TERRESCAL_CLKDIV1, 0);
+
+	/* 100 ohm */
+	sun55i_phy_field(phy, SUN55I_HDMI_PHY_DR5_3,
+			 SUN55I_HDMI_PHY_DR5_3_TERRES_VAL, 0);
+	sun55i_phy_set(phy, SUN55I_HDMI_PHY_DR5_3,
+		       SUN55I_HDMI_PHY_DR5_3_TERRESCAL);
+
+	sun55i_phy_set(phy, SUN55I_HDMI_PHY_DR5_1,
+		       SUN55I_HDMI_PHY_DR5_1_TERRESCAL_BP);
+	udelay(5);
+	sun55i_phy_clr(phy, SUN55I_HDMI_PHY_DR5_1,
+		       SUN55I_HDMI_PHY_DR5_1_TERRESCAL_BP);
+}
+
+static void sun55i_phy_config_pll(struct sun8i_hdmi_phy *phy,
+				  const struct sun55i_hdmi_phy_cfg *cfg)
+{
+	/* pre-PLL dividers */
+	sun55i_phy_field(phy, SUN55I_HDMI_PHY_PLL0_1, SUN55I_HDMI_PHY_PLL0_1_PREDIV,
+			 sun55i_byte(cfg->prepll_div, 0));
+	writeb(sun55i_byte(cfg->prepll_div, 1), phy->base + SUN55I_HDMI_PHY_PLL0_3);
+	sun55i_phy_field(phy, SUN55I_HDMI_PHY_PLL0_2, SUN55I_HDMI_PHY_PLL0_2_FBDIV1,
+			 sun55i_byte(cfg->prepll_div, 2));
+
+	sun55i_phy_field(phy, SUN55I_HDMI_PHY_PLL1_0,
+			 SUN55I_HDMI_PHY_PLL1_0_LINKTMDSCLK_DIV,
+			 sun55i_byte(cfg->prepll_clk_div, 0));
+	sun55i_phy_field(phy, SUN55I_HDMI_PHY_PLL1_0,
+			 SUN55I_HDMI_PHY_PLL1_0_LINKCLK_DIV,
+			 sun55i_byte(cfg->prepll_clk_div, 1));
+	sun55i_phy_field(phy, SUN55I_HDMI_PHY_PLL1_0,
+			 SUN55I_HDMI_PHY_PLL1_0_TMDSCLK_DIV,
+			 sun55i_byte(cfg->prepll_clk_div, 2));
+
+	sun55i_phy_field(phy, SUN55I_HDMI_PHY_PLL1_1,
+			 SUN55I_HDMI_PHY_PLL1_1_MAINCLK_DIV,
+			 sun55i_byte(cfg->prepll_clk_div1, 0));
+	sun55i_phy_field(phy, SUN55I_HDMI_PHY_PLL1_1,
+			 SUN55I_HDMI_PHY_PLL1_1_AUXCLK_DIV,
+			 sun55i_byte(cfg->prepll_clk_div1, 1));
+
+	sun55i_phy_field(phy, SUN55I_HDMI_PHY_PLL1_2,
+			 SUN55I_HDMI_PHY_PLL1_2_RECLK_DIV,
+			 sun55i_byte(cfg->prepll_clk_div2, 0));
+	sun55i_phy_field(phy, SUN55I_HDMI_PHY_PLL1_2,
+			 SUN55I_HDMI_PHY_PLL1_2_PIXCLK_DIV,
+			 sun55i_byte(cfg->prepll_clk_div2, 1));
+	sun55i_phy_mask(phy, SUN55I_HDMI_PHY_PLL0_0,
+			SUN55I_HDMI_PHY_PLL0_0_PIX_CLK_BP,
+			sun55i_byte(cfg->prepll_clk_div2, 2) ? 0xff : 0);
+
+	/* pre-PLL fractional part */
+	writeb(sun55i_byte(cfg->prepll_fra, 0), phy->base + SUN55I_HDMI_PHY_PLL_FRA_1);
+	writeb(sun55i_byte(cfg->prepll_fra, 1), phy->base + SUN55I_HDMI_PHY_PLL_FRA_2);
+	writeb(sun55i_byte(cfg->prepll_fra, 2), phy->base + SUN55I_HDMI_PHY_PLL_FRA_3);
+	sun55i_phy_field(phy, SUN55I_HDMI_PHY_PLL0_2, SUN55I_HDMI_PHY_PLL0_2_FRA_CTL,
+			 sun55i_byte(cfg->prepll_fra, 3));
+
+	/* post-PLL */
+	sun55i_phy_field(phy, SUN55I_HDMI_PHY_PLL2_3, SUN55I_HDMI_PHY_PLL2_3_PRED_DIV,
+			 sun55i_byte(cfg->postpll, 0));
+	sun55i_phy_mask(phy, SUN55I_HDMI_PHY_PLL3_1, SUN55I_HDMI_PHY_PLL3_1_FBDIV1,
+			sun55i_byte(cfg->postpll, 1) ? 0xff : 0);
+	writeb(sun55i_byte(cfg->postpll, 2), phy->base + SUN55I_HDMI_PHY_PLL3_0);
+	sun55i_phy_field(phy, SUN55I_HDMI_PHY_PLL2_2, SUN55I_HDMI_PHY_PLL2_2_POSTDIV_EN,
+			 sun55i_byte(cfg->postpll, 3));
+	sun55i_phy_field(phy, SUN55I_HDMI_PHY_PLL3_1, SUN55I_HDMI_PHY_PLL3_1_POSTDIV,
+			 cfg->postpll_postdiv);
+
+	sun55i_phy_plls(phy, true);
+}
+
+static void sun55i_phy_config_drive(struct sun8i_hdmi_phy *phy,
+				    const struct sun55i_hdmi_phy_cfg *cfg)
+{
+	static const u32 vlevel_regs[] = {
+		SUN55I_HDMI_PHY_DR1_1, SUN55I_HDMI_PHY_DR1_2,
+		SUN55I_HDMI_PHY_DR1_3, SUN55I_HDMI_PHY_DR2_0,
+	};
+	static const u32 empl_regs[] = {
+		SUN55I_HDMI_PHY_DR0_3, SUN55I_HDMI_PHY_DR2_3,
+		SUN55I_HDMI_PHY_DR3_0, SUN55I_HDMI_PHY_DR3_1,
+	};
+	unsigned int i;
+
+	sun55i_phy_field(phy, SUN55I_HDMI_PHY_DR4_0,
+			 SUN55I_HDMI_PHY_DR4_0_CH0_CUR_BIAS,
+			 sun55i_byte(cfg->cur_bias, 0));
+	sun55i_phy_field(phy, SUN55I_HDMI_PHY_DR4_0,
+			 SUN55I_HDMI_PHY_DR4_0_CH1_CUR_BIAS,
+			 sun55i_byte(cfg->cur_bias, 1));
+	sun55i_phy_field(phy, SUN55I_HDMI_PHY_DR3_3,
+			 SUN55I_HDMI_PHY_DR3_3_CH2_CUR_BIAS,
+			 sun55i_byte(cfg->cur_bias, 2));
+	sun55i_phy_field(phy, SUN55I_HDMI_PHY_DR3_3,
+			 SUN55I_HDMI_PHY_DR3_3_CLK_CUR_BIAS,
+			 sun55i_byte(cfg->cur_bias, 3));
+
+	for (i = 0; i < ARRAY_SIZE(vlevel_regs); i++)
+		sun55i_phy_field(phy, vlevel_regs[i], SUN55I_HDMI_PHY_VLEVEL,
+				 sun55i_byte(cfg->vlevel, i));
+
+	for (i = 0; i < ARRAY_SIZE(empl_regs); i++) {
+		sun55i_phy_field(phy, empl_regs[i], SUN55I_HDMI_PHY_PRE_EMPL,
+				 sun55i_byte(cfg->pre_empl, i));
+		sun55i_phy_field(phy, empl_regs[i], SUN55I_HDMI_PHY_POST_EMPL,
+				 sun55i_byte(cfg->post_empl, i));
+	}
+}
+
+static int sun55i_phy_config(struct dw_hdmi *hdmi, void *data,
+			     const struct drm_display_info *display,
+			     const struct drm_display_mode *mode)
+{
+	struct sun8i_hdmi_phy *phy = data;
+	const struct sun55i_hdmi_phy_cfg *cfg;
+	u32 tmds_khz = sun55i_phy_tmds_khz(mode);
+	int ret;
+
+	cfg = sun55i_phy_find_cfg(tmds_khz);
+	if (!cfg) {
+		dev_err(phy->dev, "unsupported TMDS rate %u kHz\n", tmds_khz);
+		return -EINVAL;
+	}
+
+	/* controller side PHY interface reset, active low */
+	dw_hdmi_phy_gen1_reset(hdmi);
+
+	sun55i_phy_analog_reset(phy);
+	sun55i_phy_digital_reset(phy);
+
+	sun55i_phy_off(phy);
+
+	sun55i_phy_bias(phy, true);
+	/* off-chip reference resistor */
+	sun55i_phy_clr(phy, SUN55I_HDMI_PHY_DR0_0, SUN55I_HDMI_PHY_DR0_0_REFRES);
+
+	if (phy->base_size > SUN55I_HDMI_PHY_CTRL_8004 + 3)
+		writel(SUN55I_HDMI_PHY_CTRL_8004_VAL,
+		       phy->base + SUN55I_HDMI_PHY_CTRL_8004);
+	else
+		dev_warn_once(phy->dev,
+			      "PHY region too small, can't write reg 0x8004\n");
+
+	sun55i_phy_rxsense(phy, true);
+	sun55i_phy_wait_rxsense(phy);
+
+	if (cfg->tmds_khz == 594000)
+		sun55i_phy_config_4k60(phy);
+
+	sun55i_phy_config_pll(phy, cfg);
+
+	ret = sun55i_phy_wait_pll(phy);
+	if (ret)
+		return ret;
+
+	sun55i_phy_ldos(phy, true);
+	sun55i_phy_serializers(phy, true);
+	sun55i_phy_drivers(phy, true);
+
+	sun55i_phy_config_drive(phy, cfg);
+
+	sun55i_phy_digital_reset(phy);
+
+	/* data sync */
+	sun55i_phy_clr(phy, SUN55I_HDMI_PHY_CTL0_2, SUN55I_HDMI_PHY_CTL0_2_DATA_SY_CTL);
+	usleep_range(1000, 1100);
+	sun55i_phy_set(phy, SUN55I_HDMI_PHY_CTL0_2, SUN55I_HDMI_PHY_CTL0_2_DATA_SY_CTL);
+
+	return 0;
+}
+
+static void sun55i_phy_disable(struct dw_hdmi *hdmi, void *data)
+{
+	struct sun8i_hdmi_phy *phy = data;
+
+	sun55i_phy_off(phy);
+}
+
+static const struct dw_hdmi_phy_ops sun55i_hdmi_phy_ops = {
+	.init		= sun55i_phy_config,
+	.disable	= sun55i_phy_disable,
+	.read_hpd	= dw_hdmi_phy_read_hpd,
+	.update_hpd	= dw_hdmi_phy_update_hpd,
+	.setup_hpd	= dw_hdmi_phy_setup_hpd,
+};
+
+static void sun55i_phy_init(struct sun8i_hdmi_phy *phy)
+{
+	/* Nothing to do here, PHY is fully programmed on each modeset. */
+}
+
+const struct sun8i_hdmi_phy_variant sun55i_a523_hdmi_phy = {
+	/*
+	 * Innosilicon PHY is not Synopsys PHY, so don't rely on
+	 * HDMI_CONFIG2_ID and always use our phy_ops.
+	 */
+	.phy_force_vendor = true,
+	.phy_ops	= &sun55i_hdmi_phy_ops,
+	.phy_init	= sun55i_phy_init,
+};
