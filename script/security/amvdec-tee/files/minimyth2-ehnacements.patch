+static int parse_package(struct package *pkg, const uint8_t *buf, size_t size,
+			 bool force)
+{
+	size_t pack_end, off, cap = 0;
+	int ret = 0;
+
+	memset(pkg, 0, sizeof(*pkg));
+	pkg->buf = buf;
+	pkg->size = size;
+
+	if (size < PACK_HDR_MIN_SIZE) {
+		err("file is too small (%zu bytes) to be a firmware package", size);
+		return -1;
+	}
+
+	if (le32(buf + PACK_OFFSET) != PACK_TAG) {
+		err("no \"PACK\" magic at 0x%x (found 0x%08x)", PACK_OFFSET,
+		    le32(buf + PACK_OFFSET));
+		if (!force)
+			return -1;
+		ret = -1;
+	}
+
+	pkg->pack_size = le32(buf + PACK_OFFSET + 4);
+	pkg->pack_crc = le32(buf + PACK_OFFSET + 8);
+	pkg->pack_count = le32(buf + PACK_OFFSET + 12);
+	pkg->pack_w4 = le32(buf + PACK_OFFSET + 16);
+	pkg->pack_w5 = le32(buf + PACK_OFFSET + 20);
+
+	pack_end = (size_t)PACK_OFFSET + pkg->pack_size;
+	if (pack_end > size) {
+		err("package claims 0x%x bytes, but the file ends at 0x%zx",
+		    pkg->pack_size, size);
+		if (!force)
+			return -1;
+		pack_end = size;
+		ret = -1;
+	}
+
+	/* Walk the entries: each one runs up to the next valid header. */
+	for (off = FIRST_ENTRY; off < pack_end;) {
+		size_t next;
+
+		if (!entry_at(buf, size, off)) {
+			off += ENTRY_ALIGN;
+			continue;
+		}
+
+		if (pkg->n_entries == cap) {
+			struct pack_entry *tmp;
+
+			cap = cap ? cap * 2 : 128;
+			tmp = realloc(pkg->entries, cap * sizeof(*tmp));
+			if (!tmp) {
+				err("out of memory");
+				return -1;
+			}
+			pkg->entries = tmp;
+		}
+
+		fill_entry(&pkg->entries[pkg->n_entries], buf, off);
+
+		for (next = off + ENTRY_HDR_SIZE; next < pack_end; next += ENTRY_ALIGN)
+			if (entry_at(buf, size, next))
+				break;
+		if (next > pack_end)
+			next = pack_end;
+
+		pkg->entries[pkg->n_entries].data_size = next - off - ENTRY_HDR_SIZE;
+		pkg->entries[pkg->n_entries].empty =
+			is_zero(buf + off + ENTRY_HDR_SIZE,
+				pkg->entries[pkg->n_entries].data_size);
+		pkg->n_entries++;
+		off = next;
+	}
+
+	if (pkg->n_entries != pkg->pack_count) {
+		warn("package header lists %u entries, found %zu", pkg->pack_count,
+		     pkg->n_entries);
+		ret = ret ? ret : 1;
+	}
+
+	return ret;
+}
