From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Piotr Oniszczuk <piotr.oniszczuk@gmail.com>
Date: Thu, 26 Nov 2026 17:10:37 +0100
Subject: [PATCH] arm64: dts: amlogic: tanix-tx5: enable USB

Enable both USB host ports of the Tanix TX5. The VBUS of the OTG port
(usb0) is switched by GPIOH_8, as in the vendor device tree.

Signed-off-by: Piotr Oniszczuk <piotr.oniszczuk@gmail.com>
---
 .../amlogic/amlogic-s7-s905y5-tanix-tx5.dts   | 26 +++++++++++++++++++
 1 file changed, 26 insertions(+)

diff --git a/arch/arm64/boot/dts/amlogic/amlogic-s7-s905y5-tanix-tx5.dts b/arch/arm64/boot/dts/amlogic/amlogic-s7-s905y5-tanix-tx5.dts
index 613e1af..47debf5 100644
--- a/arch/arm64/boot/dts/amlogic/amlogic-s7-s905y5-tanix-tx5.dts
+++ b/arch/arm64/boot/dts/amlogic/amlogic-s7-s905y5-tanix-tx5.dts
@@ -90,6 +90,15 @@
 		regulator-always-on;
 	};
 
+	usb_pwr: regulator-usb-pwr {
+		compatible = "regulator-fixed";
+		regulator-name = "USB_PWR";
+		regulator-min-microvolt = <5000000>;
+		regulator-max-microvolt = <5000000>;
+		gpio = <&gpioh 8 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+	};
+
 	vddio_ao1v8: regulator-vddio-ao1v8 {
 		compatible = "regulator-fixed";
 		regulator-name = "VDD_AO18_LDO";
@@ -241,3 +250,20 @@
 &vdec {
 	status = "okay";
 };
+
+&usb0 {
+	status = "okay";
+};
+
+&usb1 {
+	status = "okay";
+};
+
+&usb2_phy0 {
+	phy-supply = <&usb_pwr>;
+	status = "okay";
+};
+
+&usb2_phy1 {
+	status = "okay";
+};
-- 
2.43.0

