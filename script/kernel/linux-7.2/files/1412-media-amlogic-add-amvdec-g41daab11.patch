+            D = [f.poc, len(dpb), len(f.st_before), len(f.st_after), len(f.lt_curr), dflags]
+            D += [dix[id(p)] for p in f.st_before] + [dix[id(p)] for p in f.st_after] + [dix[id(p)] for p in f.lt_curr]
+            for p in dpb:
+                D += [ts_of.get(id(p), 0), p['poc'], DPB_LT if p['lt'] else 0]
+            # resolved planes of every DPB entry
+            T = []
+            for p in dpb:
+                if f.fbc and not f.linref:
+                    T += [L.fbc_head(p['buf']), L.fbc_head(p['buf']), L.mv(p['buf'])]
+                else:
+                    T += [L.y(p['buf']), L.uv(p['buf'], p['w'], p['h']), L.mv(p['buf'])]
+            # ---- SCALING_MATRIX (sent always; stale when scaling is off)
+            if sps['scaling_list_enabled']:
+                ff['sm'] = matrix(sps, pps)
+            M = ff['sm']
+            # ---- SLICE_PARAMS
+            Ls = []
+            for k, (nal, sh, nstart, rawlen) in enumerate(sl):
+                s = f.slices[k]
+                st = sh['slice_type']
+                tmvp = sh['temporal_mvp']
+                if not sh['dependent']:
+                    if st == HB.B_SLICE:
+                        ff['mvd'] = sh['mvd_l1_zero']
+                    if st != HB.I_SLICE:
+                        ff['cabac'] = sh['cabac_init']
+                        ff['col_idx'] = 0
+                        if tmvp:
+                            ff['col_l0'] = sh['collocated_from_l0']
+                            ff['col_idx'] = sh['collocated_ref_idx']
+                    if not (sh['dbk_override'] and sh['dbk_disabled']):
+                        ff['beta'], ff['tc'] = sh['beta_offset_div2'], sh['tc_offset_div2']
+                fl = (SL_SAO_L * sh['sao_luma'] | SL_SAO_C * sh['sao_chroma'] | SL_TMVP * tmvp
+                      | SL_MVD_L1_ZERO * ff['mvd'] | SL_CABAC_INIT * ff['cabac'] | SL_COL_L0 * ff['col_l0']
+                      | SL_DBK_DIS * sh['dbk_disabled'] | SL_LF * sh['lf_across_slices'] | SL_DEP * sh['dependent'])
+                d_off = sh['data_offset']
+                l0 = [dix[id(p)] for p in s['l0']]
+                l1 = [dix[id(p)] for p in s['l1']]
+                wt = [0] * (2 * (16 + 16 + 32 + 32)) + [0, 0]
+                pw = sh['pwt']
+                if pw is not None:
+                    ld = pw['luma_log2_denom']
+                    cd = ld + pw['delta_chroma_log2_denom']
+                    for li, lst in enumerate(('l0', 'l1')):
+                        base = li * 96
+                        for i, e in enumerate(pw.get(lst, [])[:15]):
+                            wt[base + i] = e['dlw'] if e['luma_flag'] else 0
+                            wt[base + 16 + i] = e['lo'] if e['luma_flag'] else 0
+                            for j in range(2):
+                                if e['chroma_flag']:
+                                    w = (1 << cd) + e['dcw'][j]
+                                    co = clip(-128, 127, e['dco'][j] - ((128 * w) >> cd) + 128)
+                                    wt[base + 32 + 2 * i + j] = e['dcw'][j]
+                                    wt[base + 64 + 2 * i + j] = co
+                    wt[192], wt[193] = ld, pw['delta_chroma_log2_denom']
+                Ls.append([((rawlen + 3) if BITSIZE_SEGMENT else (rawlen - d_off)) * 8, nstart + d_off, sh['nal_type'], st, sh['qp_delta'],
+                           sh['cb_qp_offset'], sh['cr_qp_offset'], ff['beta'], ff['tc'],
+                           (5 - sh['max_num_merge_cand']) if st != HB.I_SLICE else 0,
+                           ff['col_idx'] if tmvp else 0,
+                           (len(l0) - 1) if l0 else 0, (len(l1) - 1) if l1 else 0,
+                           sh['segment_address'], fl, *(l0 + [0] * (16 - len(l0))), *(l1 + [0] * (16 - len(l1))),
+                           *wt])
+            off = binf.tell()
+            binf.write(bytes(buf))
+            soff = binf.tell()
+            binf.write(f.stream)
+            txt.write(f'P {n} {off} {len(buf)} {soff} {len(f.stream)}\n')
+            txt.write('Q ' + ' '.join(str(int(v)) for v in Q) + '\n')
+            txt.write('R ' + ' '.join(str(int(v)) for v in R) + '\n')
+            txt.write('D ' + ' '.join(str(int(v)) for v in D) + '\n')
+            txt.write('T ' + ' '.join(str(int(v)) for v in T) + '\n')
+            txt.write('M ' + ' '.join(str(int(v)) for v in M) + '\n')
+            txt.write(f'I {L.y(f.buf)} {L.uv(f.buf, f.w, f.h)} {HH.out_size(f.w, f.h)} {L.mv(f.buf)} {L.ws} {SOC} '
+                      f'{len(Ls)} {int(f.nv12)} {int(f.fbc)} {L.fbc_head(f.buf)} {L.fbc_body(f.buf)} {int(f.linref)}\n')
+            for v in Ls:
+                txt.write('L ' + ' '.join(str(int(x)) for x in v) + '\n')
+            txt.write('E ' + ' '.join(f'{v:x}' for v in f.rec) + '\n')
+            for r in f.srecs:
+                txt.write('F ' + ' '.join(f'{v:x}' for v in r) + '\n')
+            txt.write('U ' + ' '.join(f'{v:x}' for v in f.lut) + '\n')
+            host.complete(f)
+            ts_of[id(f.entry)] = tsn
+        txt.write('X\n')
+    txt.close()
+    binf.close()
+
+
+if __name__ == '__main__':
+    main()
