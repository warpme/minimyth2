Patch from MiniMyth2 project

Developed-by: Piotr Oniszczuk <piotr.oniszczuk@gmail.com>
Signed-off-by: Piotr Oniszczuk <piotr.oniszczuk@gmail.com>



diff --speed-large-files --no-dereference --minimal -Naur linux-7.3.5/arch/arm64/boot/dts/rockchip/rk3528-rock-2a.dts linux-7.3.5/arch/arm64/boot/dts/rockchip/rk3528-rock-2a.dts
--- linux-7.3.5/arch/arm64/boot/dts/rockchip/rk3528-rock-2a.dts	2026-11-17 11:14:21.000000000 +0100
+++ linux-7.3.5/arch/arm64/boot/dts/rockchip/rk3528-rock-2a.dts	2026-11-22 19:15:30.493970424 +0100
@@ -2,6 +2,7 @@
 
 /dts-v1/;
 
+#include <dt-bindings/soc/rockchip,vop2.h>
 #include "rk3528-rock-2.dtsi"
 
 / {
@@ -9,9 +10,23 @@
 	compatible = "radxa,rock-2a", "rockchip,rk3528";
 
 	aliases {
+		mmc0 = &sdmmc;
+		mmc1 = &sdhci;
+		serial0 = &uart0;
 		ethernet0 = &gmac1;
 	};
 
+	hdmi-con {
+		compatible = "hdmi-connector";
+		type = "a";
+
+		port {
+			hdmi_con_in: endpoint {
+				remote-endpoint = <&hdmi_out_con>;
+			};
+		};
+	};
+
 	vcc5v0_usb30_otg: regulator-5v0-vcc-usb30-otg {
 		compatible = "regulator-fixed";
 		enable-active-high;
@@ -36,6 +51,32 @@
 	status = "okay";
 };
 
+&hdmi {
+	avdd-0v9-supply = <&vdd_0v9>;
+	avdd-1v8-supply = <&vcc_1v8>;
+	status = "okay";
+};
+
+&hdmi_in {
+	hdmi_in_vp0: endpoint {
+		remote-endpoint = <&vp0_out_hdmi>;
+	};
+};
+
+&hdmi_out {
+	hdmi_out_con: endpoint {
+		remote-endpoint = <&hdmi_con_in>;
+	};
+};
+
+&hdmi_sound {
+	status = "okay";
+};
+
+&hdmiphy {
+	status = "okay";
+};
+
 &leds {
 	pinctrl-names = "default";
 	pinctrl-0 = <&state_led_b>, <&sys_led_g>;
@@ -43,8 +84,9 @@
 	led-1 {
 		color = <LED_COLOR_ID_GREEN>;
 		default-state = "on";
-		function = LED_FUNCTION_STATUS;
+		function = LED_FUNCTION_HEARTBEAT;
 		gpios = <&gpio3 RK_PC1 GPIO_ACTIVE_LOW>;
+		linux,default-trigger = "heartbeat";
 	};
 };
 
@@ -80,6 +122,14 @@
 	};
 };
 
+&sai3 {
+	status = "okay";
+};
+
+&tsadc {
+	status = "okay";
+};
+
 &usb_host0_xhci {
 	dr_mode = "host";
 	extcon = <&usb2phy>;
@@ -90,3 +140,36 @@
 	phy-supply = <&vcc5v0_usb30_otg>;
 	status = "okay";
 };
+
+&vdec {
+	status = "okay";
+};
+
+&vdec_mmu {
+	status = "okay";
+};
+
+&vop {
+	assigned-clocks = <&cru DCLK_VOP0>;
+	assigned-clock-parents = <&hdmiphy>;
+	status = "okay";
+};
+
+&vop_mmu {
+	status = "okay";
+};
+
+&vp0 {
+	vp0_out_hdmi: endpoint@ROCKCHIP_VOP2_EP_HDMI0 {
+		reg = <ROCKCHIP_VOP2_EP_HDMI0>;
+		remote-endpoint = <&hdmi_in_vp0>;
+	};
+};
+
+&vpu {
+	status = "okay";
+};
+
+&vpu_mmu {
+	status = "okay";
+};
diff --speed-large-files --no-dereference --minimal -Naur linux-7.3.5/arch/arm64/boot/dts/rockchip/rk3528-rock-2.dtsi linux-7.3.5/arch/arm64/boot/dts/rockchip/rk3528-rock-2.dtsi
--- linux-7.3.5/arch/arm64/boot/dts/rockchip/rk3528-rock-2.dtsi	2026-11-17 11:14:21.000000000 +0100
+++ linux-7.3.5/arch/arm64/boot/dts/rockchip/rk3528-rock-2.dtsi	2026-11-22 19:14:31.905010627 +0100
@@ -10,8 +10,8 @@
 / {
 	aliases {
 		i2c1 = &i2c1;
-		mmc0 = &sdhci;
-		mmc1 = &sdmmc;
+		mmc0 = &sdmmc;
+		mmc1 = &sdhci;
 		serial0 = &uart0;
 	};
 
@@ -41,9 +41,9 @@
 		led-0 {
 			color = <LED_COLOR_ID_BLUE>;
 			default-state = "on";
-			function = LED_FUNCTION_HEARTBEAT;
+			function = LED_FUNCTION_STATUS;
 			gpios = <&gpio1 RK_PA3 GPIO_ACTIVE_HIGH>;
-			linux,default-trigger = "heartbeat";
+			linux,default-trigger = "disk-activity";
 		};
 	};
 
--

MiniMyth2

