From 7d8423bf328d5b7d09f3be32f765888d32057440 Mon Sep 17 00:00:00 2001
From: Christian Hewitt <christianshewitt@gmail.com>
Date: Sat, 3 Oct 2026 17:45:44 +0000
Subject: [PATCH 27/32] WIP: configs: khadas-vim1s: enable USB host, power
 domains and debug UART

Enable the USB host stack with storage and keyboard support, the secure
power domains it needs, the regulator command, and the early debug UART
as the G12 Khadas boards do.

Assisted-by: Claude:claude-opus-5-5
Signed-off-by: Christian Hewitt <christianshewitt@gmail.com>
---
 configs/khadas-vim1s_defconfig | 14 ++++++++++++++
 1 file changed, 14 insertions(+)

diff --git a/configs/khadas-vim1s_defconfig b/configs/khadas-vim1s_defconfig
index af9d14644..0dffaada8 100644
--- a/configs/khadas-vim1s_defconfig
+++ b/configs/khadas-vim1s_defconfig
@@ -14,6 +14,7 @@ CONFIG_DM_RESET=y
 CONFIG_MESON_S4=y
 CONFIG_SYS_LOAD_ADDR=0x20000000
 CONFIG_IDENT_STRING=" vim1s"
+CONFIG_DEBUG_UART=y
 CONFIG_REMAKE_ELF=y
 CONFIG_FIT=y
 CONFIG_FIT_SIGNATURE=y
@@ -29,8 +30,10 @@ CONFIG_CMD_PWM=y
 CONFIG_CMD_GPT=y
 CONFIG_CMD_I2C=y
 CONFIG_CMD_MMC=y
+CONFIG_CMD_USB=y
 CONFIG_CMD_WDT=y
 CONFIG_CMD_RTC=y
+CONFIG_CMD_REGULATOR=y
 CONFIG_OF_CONTROL=y
 CONFIG_OF_UPSTREAM=y
 CONFIG_SARADC_MESON=y
@@ -49,8 +52,11 @@ CONFIG_DM_ETH_PHY=y
 CONFIG_ETH_DESIGNWARE_MESON8B=y
 CONFIG_MDIO_MUX_MESON_G12A=y
 CONFIG_PHY_MESON_GXL=y
+CONFIG_MESON_G12A_USB_PHY=y
 CONFIG_PINCTRL=y
 CONFIG_PINCTRL_MESON_S4=y
+CONFIG_POWER_DOMAIN=y
+CONFIG_MESON_SECURE_POWER_DOMAIN=y
 CONFIG_DM_REGULATOR=y
 CONFIG_REGULATOR_PWM=y
 CONFIG_DM_REGULATOR_FIXED=y
@@ -60,7 +66,15 @@ CONFIG_PWM_MESON=y
 CONFIG_DM_RTC=y
 CONFIG_RTC_PCF8563=y
 CONFIG_BAUDRATE=888888
+CONFIG_DEBUG_UART_ANNOUNCE=y
+CONFIG_DEBUG_UART_SKIP_INIT=y
 CONFIG_MESON_SERIAL=y
+CONFIG_USB=y
+CONFIG_USB_XHCI_HCD=y
+CONFIG_USB_XHCI_GENERIC=y
+CONFIG_USB_DWC3=y
+CONFIG_USB_DWC3_MESON_G12A=y
+CONFIG_USB_KEYBOARD=y
 CONFIG_WDT=y
 CONFIG_WDT_MESON_GXBB=y
 # CONFIG_TOOLS_MKEFICAPSULE is not set
-- 
2.53.0

