From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Piotr Oniszczuk <piotr.oniszczuk@gmail.com>
Date: Thu, 26 Nov 2026 17:31:42 +0100
Subject: [PATCH] arm64: dts: amlogic: tanix-tx5: add the GPU supply

The GPU of the Tanix TX5 is fed by VDDEE, which is fixed on this board.
Without a supply the OPP core complains at every boot:

  panfrost fe400000.gpu: error -ENODEV: _opp_set_regulators: no regulator (mali) found

Describe VDDEE as a fixed regulator and use it as the GPU supply. The
GPU OPPs have no voltage, so the regulator is never changed.

Signed-off-by: Piotr Oniszczuk <piotr.oniszczuk@gmail.com>
---
 .../dts/amlogic/amlogic-s7-s905y5-tanix-tx5.dts     | 13 +++++++++++++
 1 file changed, 13 insertions(+)

diff --git a/arch/arm64/boot/dts/amlogic/amlogic-s7-s905y5-tanix-tx5.dts b/arch/arm64/boot/dts/amlogic/amlogic-s7-s905y5-tanix-tx5.dts
index 47debf5..8bccb3c 100644
--- a/arch/arm64/boot/dts/amlogic/amlogic-s7-s905y5-tanix-tx5.dts
+++ b/arch/arm64/boot/dts/amlogic/amlogic-s7-s905y5-tanix-tx5.dts
@@ -99,6 +99,18 @@
 		enable-active-high;
 	};
 
+	/*
+	 * VDDEE feeds the GPU. It is fixed on this board (the vendor GPU DVFS
+	 * table uses one voltage for every frequency) and not controlled by
+	 * Linux; it is only declared so the GPU gets its "mali" supply.
+	 */
+	vddee: regulator-vddee {
+		compatible = "regulator-fixed";
+		regulator-name = "VDDEE";
+		vin-supply = <&main_12v>;
+		regulator-always-on;
+	};
+
 	vddio_ao1v8: regulator-vddio-ao1v8 {
 		compatible = "regulator-fixed";
 		regulator-name = "VDD_AO18_LDO";
@@ -168,6 +180,7 @@
 };
 
 &gpu {
+	mali-supply = <&vddee>;
 	status = "okay";
 };
 
