From 8f2dc4ec7c31da02c1906967860f705514c7f9fa Mon Sep 17 00:00:00 2001
From: Jernej Skrabec <jernej.skrabec@gmail.com>
Date: Sat, 5 Sep 2026 05:40:53 +0200
Subject: [PATCH 198/211] arm64: dts: allwinner: a733: Clock the TCON TV from
 the HDMI PHY

The HDMI PHY's PLL is what actually clocks the timing controller, so name
it rather than the CCU clock that only feeds the transmitter side. The PHY
gains the oscillator its PLL runs from, and hands the PLL out as a clock.

Signed-off-by: Jernej Skrabec <jernej.skrabec@gmail.com>
---
 arch/arm64/boot/dts/allwinner/sun60i-a733.dtsi | 9 ++++++---
 1 file changed, 6 insertions(+), 3 deletions(-)

diff --git a/arch/arm64/boot/dts/allwinner/sun60i-a733.dtsi b/arch/arm64/boot/dts/allwinner/sun60i-a733.dtsi
index 4fb8bcea4b..f2fabfb5a4 100644
--- a/arch/arm64/boot/dts/allwinner/sun60i-a733.dtsi
+++ b/arch/arm64/boot/dts/allwinner/sun60i-a733.dtsi
@@ -1199,12 +1199,15 @@ hdmi_out: port@1 {
 		hdmi_phy: hdmi-phy@5600000 {
 			compatible = "allwinner,sun60i-a733-hdmi-phy";
 			reg = <0x05600000 0x10000>;
-			clocks = <&ccu CLK_BUS_HDMI_TV>, <&ccu CLK_HDMI_TV>;
-			clock-names = "bus", "mod";
+			clocks = <&ccu CLK_BUS_HDMI_TV>, <&ccu CLK_HDMI_TV>,
+				 <&osc26M>;
+			clock-names = "bus", "mod", "pll-0";
+			clock-output-names = "hdmi-phy-clk";
 			resets = <&ccu RST_BUS_HDMI_SUB>;
 			reset-names = "phy";
 			syscon = <&syscon>;
 			power-domains = <&pck600 PD_VO1>;
+			#clock-cells = <0>;
 			#phy-cells = <0>;
 		};
 
@@ -1213,7 +1216,7 @@ tcon_tv0: lcd-controller@5730000 {
 				     "allwinner,sun50i-h616-tcon-tv";
 			reg = <0x05730000 0x1000>;
 			interrupts = <GIC_SPI 57 IRQ_TYPE_LEVEL_HIGH>;
-			clocks = <&ccu CLK_BUS_TCON_TV0>, <&ccu CLK_HDMI_TV>;
+			clocks = <&ccu CLK_BUS_TCON_TV0>, <&hdmi_phy>;
 			clock-names = "ahb", "tcon-ch1";
 			resets = <&ccu RST_BUS_TCON_TV0>;
 			reset-names = "lcd";
-- 
