
# to regenerate run:
# mkimage -C none -A arm -T script -d aml_autoscript.src aml_autoscript
#
# Script is based on excellent work of https://github.com/devmfc (million thx devmfc!)
# Extened for overlays loading and mainline u-boot chainloading
# by Piotr Oniszczuk <piotr.oniszczuk@gmail.com> of MiniMyth2 project

setenv default_boot_order 	'sd usb emmc org'
setenv boot_script_order 	'bootscript cfgload s905_autoscript boot.scr'

setenv	cmd_make_compat		'cmd_read="fatload ${devtype} ${devnum}:${distro_bootpart}"; device=${devtype};devnr=${devnum};partnr=${distro_bootpart};partnum=${distro_bootpart};autoscript_source=${devtype}'
setenv	cmd_bootsript_load	'for scrpt in "${boot_script_order}"; do fatload ${devtype} ${devnum}:${distro_bootpart} ${loadaddr} ${scrpt} && run cmd_make_compat && autoscr ${loadaddr}; done;'
setenv	cmd_boot_emmc  		'setenv devtype mmc; setenv devnum 1; for partnum in "1 2 1b 1c"; do setenv distro_bootpart ${partnum}; run cmd_bootsript_load; done'
setenv	cmd_boot_sd  		'if mmcinfo; then setenv devtype mmc; setenv devnum 0; setenv distro_bootpart 1; run cmd_bootsript_load; fi'
setenv	cmd_boot_usb 		'if usb storage; then ; else usb start; fi; setenv devtype usb; setenv distro_bootpart 1; for devnum in "0 1 2 3"; do setenv devnum ${devnum}; run cmd_bootsript_load; done'
setenv	cmd_boot_get_order	'boot_order="${default_boot_order}"; if test "${onetime_boot_order}" != "" ; then boot_order=${onetime_boot_order}; setenv onetime_boot_order; saveenv; fi; if test "${bootfromnand}" = "1"; then setenv bootfromnand 0; saveenv; boot_order="org ${boot_order}"; fi; echo "resulting boot_order:${boot_order}";'

test "${cmd_boot_org}" = "" && setenv cmd_boot_org "${bootcmd}"
setenv	bootcmd	 		'run cmd_boot_get_order; for var in "${boot_order}"; do run cmd_boot_${var}; done; run cmd_boot_org'

# Whether this script stores the environment permanently (saveenv), and with
# it the multiboot bootcmd built above, is controlled by persist_env in
# boot.config on the SD card / USB disk the box was started from:
#   persist_env=no     do not run saveenv: nothing is changed permanently and
#                      the update button of the box has to be used every time
#   persist_env=yes    run saveenv: permanently install the multiboot bootcmd
#                      (small risk that your u-boot boot procedure will not
#                      work anymore). Also "1"; "0" is the same as "no"
# Without boot.config, or without persist_env in it, persist_default is used.
# Only the persist_env key is read from boot.config here, nothing else of it is
# imported (and so nothing else is stored by saveenv).
setenv persist_default	'no'
# scratch address for boot.config: must not be ${loadaddr}, where this script itself lives
setenv cfg_addr		0x10000000
setenv cmd_cfg_try		'if fatload ${devtype} ${devnum}:${distro_bootpart} ${cfg_addr} boot.config; then setenv cfg_found 1; env import -t ${cfg_addr} ${filesize} persist_env; fi'
setenv cmd_cfg_find		'setenv cfg_found; setenv persist_env; if mmcinfo; then setenv devtype mmc; setenv devnum 0; setenv distro_bootpart 1; run cmd_cfg_try; fi; if test "${cfg_found}" = ""; then if usb storage; then ; else usb start; fi; setenv devtype usb; setenv distro_bootpart 1; for devnum in "0 1 2 3"; do setenv devnum ${devnum}; if test "${cfg_found}" = ""; then run cmd_cfg_try; fi; done; fi'

run cmd_cfg_find
test "${persist_env}" = "" && setenv persist_env "${persist_default}"
setenv do_save 1
test "${persist_env}" = "no" && setenv do_save 0
test "${persist_env}" = "0" && setenv do_save 0

# leave nothing of the above in the environment that might get stored
setenv persist_env; setenv persist_default; setenv cfg_found; setenv cfg_addr
setenv devtype; setenv devnum; setenv distro_bootpart
setenv cmd_cfg_try; setenv cmd_cfg_find

if test "${do_save}" = "1"; then
	setenv do_save
	echo "persist_env: saving the environment (saveenv)"
	saveenv
else
	setenv do_save
	echo "persist_env=no: not saving the environment, nothing is changed permanently"
fi

run bootcmd
