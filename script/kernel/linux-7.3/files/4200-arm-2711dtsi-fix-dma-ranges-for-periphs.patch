Add missing DMA ranges also for peripherials.

diff --speed-large-files --no-dereference --minimal -Naur linux-7.3-rc6/arch/arm/boot/dts/broadcom/bcm2711.dtsi linux-7.3-rc6/arch/arm/boot/dts/broadcom/bcm2711.dtsi
--- linux-7.3-rc6/arch/arm/boot/dts/broadcom/bcm2711.dtsi	2026-10-06 10:36:13.798231287 +0200
+++ linux-7.3-rc6/arch/arm/boot/dts/broadcom/bcm2711.dtsi	2026-10-08 09:55:11.103113616 +0200
@@ -48,7 +48,8 @@
 			 <0x7c000000  0x0 0xfc000000  0x02000000>,
 			 <0x40000000  0x0 0xff800000  0x00800000>;
 		/* Emulate a contiguous 30-bit address range for DMA */
-		dma-ranges = <0xc0000000  0x0 0x00000000  0x40000000>;
+		dma-ranges = <0xc0000000  0x0 0x00000000  0x40000000>,
+			     <0x7c000000 0x0 0xfc000000 0x03800000>;
 
