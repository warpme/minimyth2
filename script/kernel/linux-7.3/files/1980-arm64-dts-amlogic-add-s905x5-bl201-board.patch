diff --speed-large-files --no-dereference --minimal -Naur linux-7.3.5/arch/arm64/boot/dts/amlogic/amlogic-s6-s905x5-bl201.dts linux-7.3.5/arch/arm64/boot/dts/amlogic/amlogic-s6-s905x5-bl201.dts
--- linux-7.3.5/arch/arm64/boot/dts/amlogic/amlogic-s6-s905x5-bl201.dts	1970-01-01 01:00:00.000000000 +0100
+++ linux-7.3.5/arch/arm64/boot/dts/amlogic/amlogic-s6-s905x5-bl201.dts	2026-11-19 13:20:24.733172670 +0100
@@ -0,0 +1,351 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+/*
+ * Copyright (c) Piotr Oniszczuk <piotr.oniszczuk@gmail.com>
+ */
+
+/dts-v1/;
+
+#include "amlogic-s6.dtsi"
+
+/ {
+	model = "Amlogic S905X5 BL201 Development Board";
+	compatible = "amlogic,bl201", "amlogic,s6";
+	interrupt-parent = <&gic>;
+	#address-cells = <2>;
+	#size-cells = <2>;
+
+	aliases {
+		serial0 = &uart_b;
+		serial1 = &uart_a;
+		serial2 = &uart_c;
+		i2c0 = &i2c0;
+		i2c1 = &i2c1;
+		i2c2 = &i2c2;
+		i2c3 = &i2c3;
+		i2c4 = &i2c4;
+		i2c5 = &i2c5;
+		spi1 = &spicc0;
+		mmc0 = &sd;
+		mmc1 = &emmc;
+	};
+
+	chosen {
+		stdout-path = "serial0:921600n8";
+	};
+
+	memory@0 {
+		device_type = "memory";
+		reg = <0x0 0x000000 0x0 0xe0000000>,
+		      <0x1 0x000000 0x0 0x20000000>;
+	};
+
+	reserved-memory {
+		#address-cells = <2>;
+		#size-cells = <2>;
+		ranges;
+
+		/* 128 MiB MTE tag area */
+		mte_reserved: mte@c000000 {
+			compatible = "shared-dma-pool";
+			reg = <0x0 0x0c000000 0x0 0x8000000>;
+			no-map;
+		};
+
+		/* secure monitor / TEE */
+		secmon_reserved: secmon@5000000 {
+			compatible = "shared-dma-pool";
+			reg = <0x0 0x05000000 0x0 0x1b00000>;
+			no-map;
+		};
+
+		eth_reserved: eth@14000000 {
+			compatible = "shared-dma-pool";
+			reg = <0x0 0x14000000 0x0 0x2400>;
+			no-map;
+		};
+
+		/* global autoconfigured region for contiguous allocations */
+		linux,cma {
+			compatible = "shared-dma-pool";
+			reusable;
+			size = <0x0 0x800000>;
+			alignment = <0x0 0x400000>;
+			linux,cma-default;
+			alloc-ranges = <0x0 0x0 0x0 0xe0000000>;
+		};
+	};
+
+	hdmi-connector {
+		compatible = "hdmi-connector";
+		type = "a";
+
+		port {
+			hdmi_connector_in: endpoint {
+				remote-endpoint = <&hdmi_tx_tmds_out>;
+			};
+		};
+	};
+
+	vin_12v_reg: regulator-vin-12v {
+		compatible = "regulator-fixed";
+		regulator-name = "DC_IN";
+		regulator-min-microvolt = <12000000>;
+		regulator-max-microvolt = <12000000>;
+		regulator-boot-on;
+		regulator-always-on;
+	};
+
+	vddao_5v_reg: regulator-vddao-5v {
+		compatible = "regulator-fixed";
+		regulator-name = "VDDAO_5V";
+		regulator-min-microvolt = <5000000>;
+		regulator-max-microvolt = <5000000>;
+		vin-supply = <&vin_12v_reg>;
+		regulator-boot-on;
+		regulator-always-on;
+	};
+
+	vdd3v3_ao_reg: regulator-vdd3v3-ao {
+		compatible = "regulator-fixed";
+		regulator-name = "VDDAO_3.3V";
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+		vin-supply = <&vin_12v_reg>;
+		regulator-boot-on;
+		regulator-always-on;
+	};
+
+	vdd1v8_dcdc_reg: regulator-vdd1v8-dcdc {
+		compatible = "regulator-fixed";
+		regulator-name = "VDD1V8_DCDC";
+		regulator-min-microvolt = <1800000>;
+		regulator-max-microvolt = <1800000>;
+		vin-supply = <&vin_12v_reg>;
+		regulator-boot-on;
+		regulator-always-on;
+	};
+
+	vdd2h_reg: regulator-vdd2h {
+		compatible = "regulator-fixed";
+		regulator-name = "VDD2H";
+		regulator-min-microvolt = <1100000>;
+		regulator-max-microvolt = <1100000>;
+		vin-supply = <&vin_12v_reg>;
+		regulator-boot-on;
+		regulator-always-on;
+	};
+
+	vddq_lpddr4x_reg: regulator-vddq-lpddr4x {
+		compatible = "regulator-fixed";
+		regulator-name = "VDDQ_LPDDR4X";
+		regulator-min-microvolt = <600000>;
+		regulator-max-microvolt = <600000>;
+		vin-supply = <&vin_12v_reg>;
+		regulator-boot-on;
+		regulator-always-on;
+	};
+
+	vcc5v_reg: regulator-vcc5v {
+		compatible = "regulator-fixed";
+		regulator-name = "VCC5V";
+		regulator-min-microvolt = <5000000>;
+		regulator-max-microvolt = <5000000>;
+		vin-supply = <&vddao_5v_reg>;
+		gpios = <&gpioh 7 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		startup-delay-us = <7000>;
+		regulator-boot-on;
+		regulator-always-on;
+	};
+
+	vcc3v3_reg: regulator-vcc3v3 {
+		compatible = "regulator-fixed";
+		regulator-name = "VCC3V3";
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+		vin-supply = <&vdd3v3_ao_reg>;
+		/* BSP: GPIOF_2 low/high = enable/disable, no enable-active-high */
+		gpios = <&gpiof 2 GPIO_ACTIVE_HIGH>;
+		startup-delay-us = <7000>;
+		regulator-boot-on;
+		regulator-always-on;
+	};
+
+	vdd3v3_soc_reg: regulator-vdd3v3-soc {
+		compatible = "regulator-fixed";
+		regulator-name = "VDDIO_SOC";
+		regulator-min-microvolt = <3100000>;
+		regulator-max-microvolt = <3100000>;
+		vin-supply = <&vdd3v3_ao_reg>;
+		regulator-boot-on;
+		regulator-always-on;
+	};
+
+	vdd1v8_ldo_reg: regulator-vdd1v8-ldo {
+		compatible = "regulator-fixed";
+		regulator-name = "VDD1V8_LDO";
+		regulator-min-microvolt = <1800000>;
+		regulator-max-microvolt = <1800000>;
+		vin-supply = <&vdd3v3_ao_reg>;
+		regulator-boot-on;
+		regulator-always-on;
+	};
+
+	sound {
+		compatible = "amlogic,axg-sound-card";
+		model = "S905X5-BL201";
+		audio-aux-devs = <&tdmout_a>, <&tdmout_b>, <&tdmout_c>;
+		audio-routing = "TDMOUT_A IN 0", "FRDDR_A OUT 0",
+				"TDMOUT_A IN 1", "FRDDR_B OUT 0",
+				"TDMOUT_A IN 2", "FRDDR_C OUT 0",
+				"TDM_A Playback", "TDMOUT_A OUT",
+				"TDMOUT_B IN 0", "FRDDR_A OUT 1",
+				"TDMOUT_B IN 1", "FRDDR_B OUT 1",
+				"TDMOUT_B IN 2", "FRDDR_C OUT 1",
+				"TDM_B Playback", "TDMOUT_B OUT",
+				"TDMOUT_C IN 0", "FRDDR_A OUT 2",
+				"TDMOUT_C IN 1", "FRDDR_B OUT 2",
+				"TDMOUT_C IN 2", "FRDDR_C OUT 2",
+				"TDM_C Playback", "TDMOUT_C OUT";
+		clocks = <&clkc_pll CLKID_HIFI_PLL>;
+		assigned-clocks = <&clkc_pll CLKID_HIFI_PLL>;
+		assigned-clock-rates = <1179648000>;
+
+		dai-link-0 {
+			sound-dai = <&frddr_a>;
+		};
+
+		dai-link-1 {
+			sound-dai = <&frddr_b>;
+		};
+
+		dai-link-2 {
+			sound-dai = <&frddr_c>;
+		};
+
+		/* HDMI audio: TDM_A -> tohdmitx -> HDMI TX */
+		dai-link-3 {
+			sound-dai = <&tdmif_a>;
+			dai-format = "i2s";
+			dai-tdm-slot-tx-mask-0 = <1 1>;
+			mclk-fs = <256>;
+
+			codec {
+				sound-dai = <&tohdmitx TOHDMITX_I2S_IN_A>;
+			};
+		};
+
+		dai-link-4 {
+			sound-dai = <&tohdmitx TOHDMITX_I2S_OUT>;
+
+			codec {
+				sound-dai = <&hdmi_tx>;
+			};
+		};
+	};
+};
+
+&ext_mdio {
+	external_phy: ethernet-phy@0 {
+		/* PHY address is not given in the BSP dts, 0 is a guess */
+		compatible = "ethernet-phy-ieee802.3-c22";
+		reg = <0>;
+		max-speed = <1000>;
+	};
+};
+
+&ethmac {
+	pinctrl-0 = <&eth_pins>, <&eth_rgmii_pins>;
+	pinctrl-names = "default";
+	phy-mode = "rgmii";
+	phy-handle = <&external_phy>;
+	amlogic,tx-delay-ns = <2>;
+	status = "okay";
+};
+
+&i2c0 {
+	pinctrl-0 = <&i2c0_pins4>;
+	pinctrl-names = "default";
+	clock-frequency = <300000>;
+	status = "okay";
+
+	/*
+	 * BSP: silergy,sy602x audio amplifier @0x2a and aw9523b LED
+	 * driver @0x5b - no mainline bindings/drivers for the S6 setup.
+	 */
+};
+
+&i2c5 {
+	pinctrl-0 = <&i2c5_pins3>;
+	pinctrl-names = "default";
+	clock-frequency = <100000>;
+	status = "okay";
+
+	/* BSP: camera sensor @0x1a (no mainline driver binding used) */
+};
+
+/* SD card */
+&sd {
+	pinctrl-0 = <&sdcard_pins>;
+	pinctrl-1 = <&sdcard_clk_gate_pins>;
+	pinctrl-names = "default", "clk-gate";
+	bus-width = <4>;
+	cap-sd-highspeed;
+	max-frequency = <50000000>;
+	disable-wp;
+	cd-gpios = <&gpioc 6 GPIO_ACTIVE_HIGH>;
+	vmmc-supply = <&vcc3v3_reg>;
+	status = "okay";
+};
+
+/* eMMC */
+&emmc {
+	pinctrl-0 = <&emmc_pins>, <&emmc_ds_pins>;
+	pinctrl-1 = <&emmc_clk_gate_pins>;
+	pinctrl-names = "default", "clk-gate";
+	bus-width = <8>;
+	cap-mmc-highspeed;
+	mmc-hs200-1_8v;
+	mmc-hs400-1_8v;
+	max-frequency = <200000000>;
+	non-removable;
+	disable-wp;
+	vmmc-supply = <&vcc3v3_reg>;
+	vqmmc-supply = <&vdd1v8_ldo_reg>;
+	status = "okay";
+};
+
+&uart_a {
+	pinctrl-0 = <&uart_a_pins>;
+	pinctrl-names = "default";
+	uart-has-rtscts;
+	status = "okay";
+};
+
+&uart_b {
+	pinctrl-0 = <&uart_b_pins>;
+	pinctrl-names = "default";
+	status = "okay";
+};
+
+&hdmi_tx {
+	status = "okay";
+};
+
+&hdmi_tx_tmds_out {
+	remote-endpoint = <&hdmi_connector_in>;
+};
+
+&vpu {
+	status = "okay";
+};
+
+&vdec {
+	status = "okay";
+};
+
+&cecb {
+	pinctrl-names = "default";
+	pinctrl-0 = <&hdmitx_cec_pins>;
+	status = "okay";
+};
diff --speed-large-files --no-dereference --minimal -Naur linux-7.3.5/arch/arm64/boot/dts/amlogic/Makefile linux-7.3.5/arch/arm64/boot/dts/amlogic/Makefile
--- linux-7.3.5/arch/arm64/boot/dts/amlogic/Makefile	2026-11-19 13:26:28.288515878 +0100
+++ linux-7.3.5/arch/arm64/boot/dts/amlogic/Makefile	2026-11-19 13:25:36.308970979 +0100
@@ -4,6 +4,7 @@
 dtb-$(CONFIG_ARCH_MESON) += amlogic-a9-a311y3-by401.dtb
 dtb-$(CONFIG_ARCH_MESON) += amlogic-c3-c302x-aw409.dtb
 dtb-$(CONFIG_ARCH_MESON) += amlogic-c3-c308l-aw419.dtb
+dtb-$(CONFIG_ARCH_MESON) += amlogic-s6-s905x5-bl201.dtb
 dtb-$(CONFIG_ARCH_MESON) += amlogic-s6-s905x5-bl209.dtb
 dtb-$(CONFIG_ARCH_MESON) += amlogic-s7-s805x3-bp201.dtb
 dtb-$(CONFIG_ARCH_MESON) += amlogic-s7d-s905x5m-bm202.dtb
--

MiniMyth2

