-
-#define MAX_CHANNELS 2
-
-#define MID_SIDE 0
-#define LEFT_SIDE 1
-#define RIGHT_SIDE 2
-
-typedef struct SonicContext {
-    int version;
-    int minor_version;
-    int lossless, decorrelation;
-
-    int num_taps, downsampling;
-    double quantization;
