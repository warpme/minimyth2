From 81ce2a13d8279f88847c3d2f24ec44967d4b8b7f Mon Sep 17 00:00:00 2001
From: Piotr Oniszczuk <piotr.oniszczuk@gmail.com>
Date: Wed, 25 Nov 2026 14:30:11 +0100
Subject: [PATCH] clk: meson: add Amlogic S7 peripherals clock controller
 driver

Add the peripherals clock controller driver of the Amlogic S7 SoC family
(S805X3, S905Y5), converted from the Amlogic BSP s7 clock driver to the
mainline meson clock controller style, like the S4 and S6 drivers.

The system and AXI bus clocks are set up by the firmware and are read
only, the peripheral clocks hang below them. The parents provided by the
PLL clock controller and the gp1 PLL (SCMI) are taken from the device
tree. The BSP specific gate status check is dropped.

Signed-off-by: Piotr Oniszczuk <piotr.oniszczuk@gmail.com>
---
 drivers/clk/meson/Kconfig          |   13 +
 drivers/clk/meson/Makefile         |    1 +
 drivers/clk/meson/s7-peripherals.c | 3809 ++++++++++++++++++++++++++++
 3 files changed, 3823 insertions(+)
 create mode 100644 drivers/clk/meson/s7-peripherals.c

diff --git a/drivers/clk/meson/Kconfig b/drivers/clk/meson/Kconfig
index 22da2b5f8..7b0050256 100644
--- a/drivers/clk/meson/Kconfig
+++ b/drivers/clk/meson/Kconfig
@@ -243,6 +243,19 @@ config COMMON_CLK_S7_PLL
 	  PLLs and the fixed PLL dividers, which are the parents of most
 	  peripherals. Say Y if you want the board to work.
 
+config COMMON_CLK_S7_PERIPHERALS
+	tristate "S7 SoC peripherals clock controller support"
+	depends on ARM64 || COMPILE_TEST
+	default ARCH_MESON
+	select COMMON_CLK_MESON_CLKC_UTILS
+	select COMMON_CLK_MESON_REGMAP
+	select COMMON_CLK_MESON_DUALDIV
+	help
+	  Support for the peripherals clock controller on Amlogic S805X3 and
+	  S905Y5 based devices, AKA S7. It provides the system and AXI bus
+	  gates and the clocks of the peripherals (mmc, ethernet, video,
+	  gpu, pwm, ...). Say Y if you want peripherals to work.
+
 config COMMON_CLK_S4_PLL
 	tristate "S4 SoC PLL clock controllers support"
 	depends on ARM64
diff --git a/drivers/clk/meson/Makefile b/drivers/clk/meson/Makefile
index 0b4d7f2b1..dc6cf5a02 100644
--- a/drivers/clk/meson/Makefile
+++ b/drivers/clk/meson/Makefile
