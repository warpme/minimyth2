+ * Copyright (C) 2026 Christian Hewitt <christianshewitt@gmail.com>
+ *
+ * HEVC request decoding with the open firmware (ohevc-sl).
+ */
+
+#include <linux/hrtimer.h>
+#include <linux/ktime.h>
+#include <linux/slab.h>
+#include <media/v4l2-mem2mem.h>
+#include <media/videobuf2-dma-contig.h>
+
+#include "codec_hevc.h"
+#include "dos_regs.h"
+#include "hevc_regs.h"
+#include "amvdec_helpers.h"
+#include "codec_hevc_common.h"
+#include "amvdec_hevc.h"
+#include "codec_hevc_open_rec.h"
+
+struct codec_hevc_open;
+
+struct codec_hevc {
+	/* Protect the data structure */
+	struct mutex lock;
+
+	/* Open firmware (ohevc-sl) state */
+	struct codec_hevc_open *open;
+
+	/* Common part of the HEVC decoder */
+	struct codec_hevc_common common;
+};
+
+static int codec_hevc_open_start(struct amvdec_session *sess, struct codec_hevc *hevc);
+static void codec_hevc_open_stop(struct amvdec_session *sess, struct codec_hevc *hevc);
+static irqreturn_t codec_hevc_open_threaded_isr(struct amvdec_session *sess);
+
+/*
+ * None of the vendor image's workspace, AUX buffer or session registers: the
+ * core is reset and programmed before every picture (codec_hevc_open_kick()).
+ * The firmware bounds every wait and the codec has its own timeout.
+ */
+static int codec_hevc_start(struct amvdec_session *sess)
+{
+	struct codec_hevc *hevc;
+	int ret;
+
+	hevc = kzalloc_obj(*hevc);
+	if (!hevc)
+		return -ENOMEM;
+
+	mutex_init(&hevc->lock);
+	ret = codec_hevc_open_start(sess, hevc);
+	if (ret) {
+		mutex_destroy(&hevc->lock);
+		kfree(hevc);
+		return ret;
+	}
+	sess->priv = hevc;
+	return 0;
+}
+
+static int codec_hevc_stop(struct amvdec_session *sess)
+{
+	struct codec_hevc *hevc = sess->priv;
+
+	/* Before hevc->lock: the timeout work takes it. */
+	if (hevc->open)
+		codec_hevc_open_stop(sess, hevc);
+	mutex_destroy(&hevc->lock);
+	return 0;
+}
+
+static irqreturn_t codec_hevc_threaded_isr(struct amvdec_session *sess)
+{
+	if (!sess->priv)
+		return IRQ_HANDLED;
+	return codec_hevc_open_threaded_isr(sess);
+}
+
+static irqreturn_t codec_hevc_isr(struct amvdec_session *sess)
+{
+	return IRQ_WAKE_THREAD;
+}
+
+struct amvdec_codec_ops meson_amvdec_codec_hevc_ops = {
+	.start = codec_hevc_start,
+	.stop = codec_hevc_stop,
+	.isr = codec_hevc_isr,
+	.threaded_isr = codec_hevc_threaded_isr,
+};
+
+/* ======================================================================== */
+/*     Open firmware (ohevc-sl): stateless HEVC, one command                */
+/*     per coded picture, everything in parameter records (abi-hevc.md).     */
+/* ======================================================================== */
+
+/*
+ * The host side of the ABI is the Python stand-in hevc_host.py (prepare(),
+ * pic_record(), slice_record(), scaling(), stream_bytes(), session_writes(),
+ * Layout) and the runner hevc_run.py, which decode bit-exact on the VIM3.
+ * This is that host fed from the V4L2 stateless controls instead of a header
+ * parser (record rules and the control mapping: codec_hevc_open_rec.h).  The
+ * client (FFmpeg) owns POC, RPS, DPB management and output order; the driver
+ * decodes in decode order and completes each request.  Serial: one picture
+ * in flight, the request-job flow of the stateless path (esparser_queue() ->
+ * meson_amvdec_codec_hevc_open_feed(), threaded ISR ->
+ * meson_amvdec_request_signal() -> the feed worker retires the request), as
+ * the open VP9 path.
+ */
+static uint hevc_open_timeout_ms = 1000;
+module_param(hevc_open_timeout_ms, uint, 0644);
+MODULE_PARM_DESC(hevc_open_timeout_ms,
+		 "HEVC: fail a picture the firmware has not answered after this many ms");
+static uint hevc_open_fbc8 = 1;
+module_param(hevc_open_fbc8, uint, 0644);
+MODULE_PARM_DESC(hevc_open_fbc8,
+		 "HEVC, 8-bit into NV12M: 1 = compressed (FBC) references + NV12 double write, as Main 10 does (G12A/G12B/SM1; read at session start; default 1: ~50% faster at 4K on G12B); 0 = NV12 references");
+#ifdef AMVDEC_OUCODE_DEV
+static uint hevc_open_debug;
+module_param(hevc_open_debug, uint, 0644);
+MODULE_PARM_DESC(hevc_open_debug,
+		 "HEVC firmware record debug word (abi-hevc.md 4.1 word 88: 2 no TOP_INFO bit 7 feedback, 4 no long-term marks, 0x10 CMD_FETCH 0x8000, 0x20 MV row jump once, 0x2000 v2 CTU loop: no v3 fast path); driver test bits: 0x10000 NV12 reference reads on odd POCs, 0x20000 always");
+static uint hevc_bench;
+module_param(hevc_bench, uint, 0644);
+MODULE_PARM_DESC(hevc_bench,
+		 "HEVC: log the per-picture time split every N pictures (0 = off): done->feed (retire + client), feed->built (records, stream copy), core reset+reload+programme on the kick path, kick->done; with hevc_prof also kick->first CTU, CTU loop, tail drain");
+static uint hevc_prof;
+module_param(hevc_prof, uint, 0644);
+MODULE_PARM_DESC(hevc_prof,
+		 "HEVC (profiling only): sample the firmware stage (SCRATCH_J) every N us while a picture decodes, split kick->done into setup / slice setup / CTU loop / tail drain in the hevc_bench line (0 = off, minimum 2)");
+static bool hevc_prof_pc;
+module_param(hevc_prof_pc, bool, 0644);
+MODULE_PARM_DESC(hevc_prof_pc,
+		 "HEVC (profiling only, with hevc_prof): also histogram the AMRISC PC (HEVC MPC_E), printed at session stop");
+static uint hevc_open_early_reset;
+module_param(hevc_open_early_reset, uint, 0644);
+MODULE_PARM_DESC(hevc_open_early_reset,
+		 "HEVC (experiment, measured no gain): reset the core, reload the image and write the session programme in the IRQ thread right after a picture completes (while the client prepares the next request) instead of on the next kick (read per picture)");
+#else
+/* Development build only (OUCODE_DEV=1): diagnostics, constant off here. */
+static const uint hevc_open_debug;
+static const uint hevc_bench;
+static const uint hevc_prof;
+static const bool hevc_prof_pc;
+static const uint hevc_open_early_reset;
+#endif
+
+#define OHEVC_FW_PATH		"meson/vdec/ohevc_sl.bin"
+#define HEVC_MPC_E		0xcc20	/* CBUS 0x3308: HEVC AMRISC execute-stage PC */
+#define OHEVC_CMD_DECODE	1
+#define OHEVC_STATUS_DONE	0x80
+#define OHEVC_STATUS_ERROR	0x81
+
+/* SCRATCH_2 with 0x80: warnings (bit 15 = debug stop, only with hevc_open_debug bit 0) */
+#define OHEVC_DONE_WARNINGS	(BIT(0) | BIT(1) | BIT(2) | BIT(15))
+
+#define OHEVC_WS_ALIGN		SZ_64K
+/* stream buffer: the picture's NAL units (start codes, zero padding), then zeros */
+#define OHEVC_FIFO_PAD		SZ_1K		/* covered by the write pointer (harness fifo_pad) */
+#define OHEVC_FIFO_SLACK	SZ_4K		/* zeros beyond it */
+#define OHEVC_FIFO_ALIGN	8
+#define OHEVC_MAX_BUFS		64		/* CAPTURE vb2 indices tracked */
+
+static const char * const ohevc_err_str[] = {
+	[1] = "bad record",
+	[2] = "unsupported",
+	[3] = "start code not found",
+	[4] = "NAL header",
+	[5] = "slice header length",
+	[6] = "bad slice record",
+	[7] = "CTU timeout",
+	[8] = "slice ended early",
+	[9] = "pipeline idle timeout",
+	[10] = "LMEM DMA timeout",
+	[11] = "CABAC timeout",
+};
+
+static const char * const ohevc_why_str[] = {
+	[OHEVC_OK] = "ok",
+	[OHEVC_BAD_FORMAT] = "not 8/10-bit 4:2:0 within the firmware limits (equal depths; 10-bit and AM21C need FBC on G12A/SM1; at most 4096x8192)",
+	[OHEVC_BAD_TILES] = "tile layout",
+	[OHEVC_BAD_SLICES] = "slice segment addresses",
+	[OHEVC_BAD_NAL] = "slice NAL unit not where data_byte_offset/bit_size put it",
+	[OHEVC_BAD_HEADER] = "slice header / NAL header / weight denominators",
+	[OHEVC_BAD_REF] = "reference lists outside the current RPS",
+	[OHEVC_BAD_STREAM] = "stream buffer",
+};
+
+/* output of a picture (abi-hevc.md 6) */
+enum {
+	OHEVC_OUT_NV12,			/* 8-bit, NV12M */
+	OHEVC_OUT_FBC_NV12,		/* Main 10 into NV12M: private FBC references + double write */
+	OHEVC_OUT_FBC,			/* AM21C: compressed only */
+};
+
+/* What a CAPTURE buffer holds for later pictures. */
+struct codec_hevc_open_buf {
+	u64 ts;				/* timestamp the picture was decoded with */
+	bool valid;			/* decoded by this session, usable as a reference */
+	u8 mode;			/* OHEVC_OUT_* it was decoded in */
+	void *mv_vaddr;			/* its MV buffer (MPRED), read as collocated */
+	dma_addr_t mv_paddr;
+	size_t mv_size;
+};
+
+struct codec_hevc_open {
+	struct amvdec_session *sess;
+	u32 soc;
+	u32 stream_ctl;			/* HEVC_STREAM_CONTROL reset bits (0x0eb14000 on G12B) */
+
+	void *ws_alloc;
+	dma_addr_t ws_alloc_paddr;
+	u8 *ws;
+	dma_addr_t ws_paddr;
+
+	void *fw_vaddr;			/* private copy of the image, reloaded every picture */
+	dma_addr_t fw_paddr;
+
+	struct codec_hevc_open_buf buf[OHEVC_MAX_BUFS];
+
+	/*
+	 * Stand-in for a reference nothing decoded in this session (FFmpeg
+	 * generates the unavailable pictures of 8.3.3 after a CRA/BLA, or a
+	 * reference was lost): grey (1 << (BitDepth - 1)), zeroed MVs.
+	 */
+	void *grey_y, *grey_uv, *grey_mv;
+	dma_addr_t grey_y_paddr, grey_uv_paddr, grey_mv_paddr;
+	size_t grey_size, grey_mv_size;
+
+	void *fifo_vaddr;
+	dma_addr_t fifo_paddr;
+	size_t fifo_size;
+
+	u16 rec[OHEVC_PIC_WORDS];
+	u16 *srec;			/* OHEVC_MAX_SLICES slice records */
+	u8 lut[1000];
+	u16 lutw[OHEVC_LUT_WORDS];
+	struct v4l2_ctrl_hevc_scaling_matrix sm;
+	struct ohevc_in in;
+
+	/* the picture in flight */
+	atomic_t running;
+	struct vb2_v4l2_buffer *dst;
+	u32 dst_idx;
+	u64 dst_ts;
+	struct ohevc_info info;
+	s32 poc;
+	u32 nsl, nal_type, greys;
+	u32 linrefs;			/* 8-bit FBC pictures decoded from NV12 references (missing one) */
+	u8 mode;
+	struct delayed_work timeout;
+	ktime_t deadline;
+
+	bool fbc8;			/* hevc_open_fbc8 latched: 8-bit NV12M via FBC + double write */
+	/*
+	 * hevc_open_early_reset: the core was reset, the image reloaded and
+	 * the session programme written after the last picture; the next
+	 * kick only writes the stream and the command.
+	 */
+	bool core_ready;
+
+	/* hevc_bench (all us): t_feed = open_feed() entered, t_built = records and stream written */
+	ktime_t t_kick, t_done, t_feed, t_built;
+	u64 sum_hw, sum_gap, sum_feed, sum_build, sum_prep, sum_eprep;
+	u32 max_hw, max_gap, n_hw, n_gap, n_feed, n_prep, n_eprep, max_prep;
+	u32 prep_us;			/* reset+reload+programme of the picture in flight (0: early) */
+
+	/* hevc_prof: SCRATCH_J / MPC_E sampler while a picture decodes */
+	struct hrtimer prof_timer;
+	bool prof_on;
+	ktime_t p_ctu, p_drain;		/* first sample in the CTU loop (0x30), in the drain (0x40) */
+	u32 p_stage[4];			/* samples: setup (< 0x20), slice setup, CTU loop, drain */
+	u64 sum_first, sum_ctu, sum_tail;
+	u32 n_first, n_tail;
+	u64 prof_stage[4];
+	u32 *prof_pc;			/* 4096 counters (hevc_prof_pc) */
+	u32 prof_samples;
+};
+
+/*
+ * Firmware SoC profile (abi-hevc.md): G12A/G12B and SM1 as measured; the
+ * GXBB and GXL/GXLX/GXM profiles (8-bit NV12 only, LMEM DMA in 4-halfword
+ * pieces from ohevc-sl v0.2.2) are offered for testing.
+ * GXBB references reach the MC as ANC2AXI commands carrying address bits
+ * 31:16 only: CAPTURE planes must be 64 KiB aligned (checked per picture).
+ */
+static bool codec_hevc_open_soc(struct amvdec_core *core, u32 *soc)
+{
+	switch (core->platform->revision) {
+	case AMVDEC_REVISION_G12A:
+		*soc = OHEVC_SOC_G12A;
+		return true;
+	case AMVDEC_REVISION_SM1:
+		*soc = OHEVC_SOC_SM1;
+		return true;
+	case AMVDEC_REVISION_GXBB:
+		*soc = OHEVC_SOC_GXBB;
+		return true;
+	case AMVDEC_REVISION_GXL:
+	case AMVDEC_REVISION_GXLX:
+	case AMVDEC_REVISION_GXM:
+		*soc = OHEVC_SOC_GXL;
+		return true;
+	default:
+		return false;
+	}
+}
+
+static void codec_hevc_open_free_grey(struct device *dev, struct codec_hevc_open *o)
+{
+	if (o->grey_y)
+		dma_free_coherent(dev, o->grey_size, o->grey_y, o->grey_y_paddr);
+	if (o->grey_uv)
+		dma_free_coherent(dev, o->grey_size / 2, o->grey_uv, o->grey_uv_paddr);
+	if (o->grey_mv)
+		dma_free_coherent(dev, o->grey_mv_size, o->grey_mv, o->grey_mv_paddr);
+	o->grey_y = o->grey_uv = o->grey_mv = NULL;
+	o->grey_size = o->grey_mv_size = 0;
+}
+
+static void codec_hevc_open_free(struct device *dev, struct codec_hevc_open *o)
+{
+	int i;
+
+	for (i = 0; i < OHEVC_MAX_BUFS; i++)
+		if (o->buf[i].mv_vaddr)
+			dma_free_coherent(dev, o->buf[i].mv_size, o->buf[i].mv_vaddr,
+					  o->buf[i].mv_paddr);
+	codec_hevc_open_free_grey(dev, o);
+	if (o->fifo_vaddr)
+		dma_free_coherent(dev, o->fifo_size, o->fifo_vaddr, o->fifo_paddr);
+	if (o->fw_vaddr)
+		dma_free_coherent(dev, AMVDEC_FW_SIZE, o->fw_vaddr, o->fw_paddr);
+	if (o->ws_alloc)
+		dma_free_coherent(dev, OHEVC_WS_SIZE + OHEVC_WS_ALIGN, o->ws_alloc,
+				  o->ws_alloc_paddr);
+	kvfree(o->srec);
+	kfree(o);
+}
+
+static void codec_hevc_open_timeout(struct work_struct *work);
+static void codec_hevc_open_early_prep(struct amvdec_session *sess, struct codec_hevc *hevc);
+
+/*
+ * hevc_prof: sample the firmware stage (SCRATCH_J: < 0x20 boot and picture
+ * setup, 0x2x slice-segment setup incl. the start-code search, 0x3x CTU loop,
+ * 0x40 picture drain) and optionally the PC while a picture is in flight.
+ * Hard-IRQ context; reads HEVC registers only while o->running (the core is
+ * powered from the kick until the verdict, and the verdict path cancels the
+ * timer before anything else).
+ */
+static enum hrtimer_restart codec_hevc_open_prof_fn(struct hrtimer *t)
+{
+	struct codec_hevc_open *o = container_of(t, struct codec_hevc_open, prof_timer);
+	struct amvdec_core *core = o->sess->core;
+	u32 st, cls;
+
+	if (!READ_ONCE(o->prof_on) || !atomic_read(&o->running))
+		return HRTIMER_NORESTART;
+	st = meson_amvdec_read_dos(core, HEVC_ASSIST_SCRATCH_J) & 0xff;
+	cls = st < 0x20 ? 0 : st < 0x30 ? 1 : st < 0x40 ? 2 : 3;
+	o->p_stage[cls]++;
+	if (cls == 2 && !o->p_ctu)
+		o->p_ctu = ktime_get();
+	else if (cls == 3 && !o->p_drain)
+		o->p_drain = ktime_get();
+	if (o->prof_pc)
+		o->prof_pc[meson_amvdec_read_dos(core, HEVC_MPC_E) & 0xfff]++;
+	o->prof_samples++;
+	hrtimer_forward_now(t, us_to_ktime(max(READ_ONCE(hevc_prof), 2u)));
+	return HRTIMER_RESTART;
+}
+
+static void codec_hevc_open_prof_start(struct codec_hevc_open *o)
+{
+	u32 us = READ_ONCE(hevc_prof);
+
+	if (!us)
+		return;
+	if (READ_ONCE(hevc_prof_pc) && !o->prof_pc)
+		o->prof_pc = kcalloc(4096, sizeof(*o->prof_pc), GFP_KERNEL);
+	o->p_ctu = 0;
+	o->p_drain = 0;
+	memset(o->p_stage, 0, sizeof(o->p_stage));
+	WRITE_ONCE(o->prof_on, true);
+	hrtimer_start(&o->prof_timer, us_to_ktime(max(us, 2u)), HRTIMER_MODE_REL);
+}
+
+/* Process context (threaded ISR, timeout work, stop). */
+static void codec_hevc_open_prof_stop(struct codec_hevc_open *o)
+{
+	WRITE_ONCE(o->prof_on, false);
+	hrtimer_cancel(&o->prof_timer);
+}
+
+static void codec_hevc_open_prof_print(struct amvdec_session *sess, struct codec_hevc_open *o)
+{
+	char line[256];
+	int i, n = 0, len = 0;
+
+	if (!o->prof_pc || !o->prof_samples)
+		return;
+	dev_info(sess->core->dev_dec, "hevc prof: %u samples (PC:count, word addresses of ohevc_sl.bin.sym)\n",
+		 o->prof_samples);
+	for (i = 0; i < 4096; i++) {
+		if (!o->prof_pc[i])
+			continue;
+		len += scnprintf(line + len, sizeof(line) - len, " %x:%u", i, o->prof_pc[i]);
+		if (++n % 12 == 0) {
+			dev_info(sess->core->dev_dec, "hevc prof:%s\n", line);
+			len = 0;
+		}
+	}
+	if (len)
+		dev_info(sess->core->dev_dec, "hevc prof:%s\n", line);
+}
+
+static int codec_hevc_open_start(struct amvdec_session *sess, struct codec_hevc *hevc)
+{
+	struct amvdec_core *core = sess->core;
+	struct codec_hevc_open *o;
+	u32 ctl;
+
+	BUILD_BUG_ON(OHEVC_MAX_SLICES != AMVDEC_HEVC_MAX_SLICES);
+	o = kzalloc_obj(*o);
+	if (!o)
+		return -ENOMEM;
+	o->sess = sess;
+	if (!codec_hevc_open_soc(core, &o->soc)) {
+		kfree(o);
+		return -EINVAL;
+	}
+	atomic_set(&o->running, 0);
+	INIT_DELAYED_WORK(&o->timeout, codec_hevc_open_timeout);
+	hrtimer_setup(&o->prof_timer, codec_hevc_open_prof_fn, CLOCK_MONOTONIC, HRTIMER_MODE_REL);
+
+	o->srec = kvmalloc_array(OHEVC_MAX_SLICES * OHEVC_SLICE_WORDS, sizeof(u16), GFP_KERNEL);
+	/*
+	 * One allocation, 64 KiB aligned by hand, zeroed: the deblock
+	 * parameters must start zeroed (ohevc-sl never clears them) and the
+	 * SAO-MMU map is read by the G12A map DMA even for NV12 output.
+	 */
+	o->ws_alloc = dma_alloc_coherent(core->dev, OHEVC_WS_SIZE + OHEVC_WS_ALIGN,
+					 &o->ws_alloc_paddr, GFP_KERNEL);
+	o->fw_vaddr = dma_alloc_coherent(core->dev, AMVDEC_FW_SIZE, &o->fw_paddr,
+					 GFP_KERNEL);
+	if (!o->srec || !o->ws_alloc || !o->fw_vaddr) {
+		dev_err(core->dev, "HEVC open fw: workspace allocation failed\n");
+		codec_hevc_open_free(core->dev, o);
+		return -ENOMEM;
+	}
+	memset(o->ws_alloc, 0, OHEVC_WS_SIZE + OHEVC_WS_ALIGN);
+	o->ws_paddr = ALIGN(o->ws_alloc_paddr, OHEVC_WS_ALIGN);
+	o->ws = (u8 *)o->ws_alloc + (o->ws_paddr - o->ws_alloc_paddr);
+
+	/* amvdec_hevc_load_firmware() has just put the image there */
+	memcpy(o->fw_vaddr, core->fw_vaddr, AMVDEC_FW_SIZE);
+
+	/*
+	 * Frame-mode stream input needs HEVC_STREAM_CONTROL's reset bits
+	 * (measured on G12B for ovp9-sl: with them zeroed the start-code
+	 * search never matches).  The core was just reset and conf_esparser()
+	 * has not run: keep what is there, without fetch, parser-fed WP and
+	 * endian.
+	 */
+	ctl = meson_amvdec_read_dos(core, HEVC_STREAM_CONTROL);
+	o->stream_ctl = ctl & ~(BIT(3) | BIT(0) | (7 << 4));
+	if (!o->stream_ctl && amvdec_is_g12(core)) {
+		dev_warn(core->dev,
+			 "HEVC open fw: HEVC_STREAM_CONTROL reads %#x at start; using the G12B reset value\n",
+			 ctl);
+		o->stream_ctl = 0x0eb14000;
+	}
+
+	/* The image boots when __vdec_hevc_start() releases it and idles on SCRATCH_0. */
+	meson_amvdec_write_dos(core, HEVC_ASSIST_SCRATCH_0, 0);
+	meson_amvdec_write_dos(core, HEVC_ASSIST_MBOX1_CLR_REG, 1);
+	meson_amvdec_write_dos(core, HEVC_ASSIST_MBOX1_MASK, 1);
+
+	/*
+	 * hevc_open_fbc8: 8-bit into NV12M the Main 10 way - compressed
+	 * references in private MMU-mode headers and bodies, the NV12M planes
+	 * written by the double write only.  The references are read compressed
+	 * (less DDR traffic for motion compensation than linear NV12).
+	 */
+	o->fbc8 = READ_ONCE(hevc_open_fbc8) && o->soc >= OHEVC_SOC_G12A &&
+		  sess->pixfmt_cap == V4L2_PIX_FMT_NV12M;
+	hevc->common.dw8 = o->fbc8;
+
+	hevc->open = o;
+	dev_info(core->dev_dec, "HEVC: open firmware %s (soc profile %u, stream control %#x%s)\n",
+		 OHEVC_FW_PATH, o->soc, o->stream_ctl,
+		 o->fbc8 ? ", 8-bit via FBC references + NV12 double write" : "");
+	return 0;
+}
+
+static void codec_hevc_open_bench_log(struct amvdec_session *sess, struct codec_hevc_open *o)
+{
+	struct device *dev = sess->core->dev_dec;
+	u64 st = o->prof_stage[0] + o->prof_stage[1] + o->prof_stage[2] + o->prof_stage[3];
+
+	dev_info(dev,
+		 "hevc bench (open%s): %u pictures, kick->done avg %llu us max %u us, done->kick avg %llu us max %u us, %u grey references, %u pictures with NV12 reference reads; last picture %ux%u CTB %u, %u CTUs, %u segments, %u stream bytes\n",
+		 o->fbc8 ? ", fbc8" : "", o->n_hw, div_u64(o->sum_hw, o->n_hw), o->max_hw,
+		 o->n_gap ? div_u64(o->sum_gap, o->n_gap) : 0, o->max_gap, o->greys, o->linrefs,
+		 o->info.w, o->info.h, 1u << o->info.log2_ctb, o->info.ctbs, o->nsl, o->info.stream_len);
+	dev_info(dev,
+		 "hevc bench split: done->feed avg %llu us, feed->built avg %llu us, reset+reload+programme on the kick path avg %llu us max %u us (%u pictures), early in the IRQ thread avg %llu us (%u)\n",
+		 o->n_feed ? div_u64(o->sum_feed, o->n_feed) : 0,
+		 o->n_feed ? div_u64(o->sum_build, o->n_feed) : 0,
+		 o->n_prep ? div_u64(o->sum_prep, o->n_prep) : 0, o->max_prep, o->n_prep,
+		 o->n_eprep ? div_u64(o->sum_eprep, o->n_eprep) : 0, o->n_eprep);
+	if (o->n_first || st)
+		dev_info(dev,
+			 "hevc bench prof: kick->first CTU avg %llu us, CTU loop avg %llu us, tail drain avg %llu us (%u/%u pictures); samples setup %llu slice %llu ctu %llu drain %llu\n",
+			 o->n_first ? div_u64(o->sum_first, o->n_first) : 0,
+			 o->n_tail ? div_u64(o->sum_ctu, o->n_tail) : 0,
+			 o->n_tail ? div_u64(o->sum_tail, o->n_tail) : 0, o->n_first, o->n_tail,
+			 o->prof_stage[0], o->prof_stage[1], o->prof_stage[2], o->prof_stage[3]);
+}
+
+/* After the core has been halted and quiesced (__vdec_hevc_stop()). */
+static void codec_hevc_open_stop(struct amvdec_session *sess, struct codec_hevc *hevc)
+{
+	struct codec_hevc_open *o = hevc->open;
+
+	cancel_delayed_work_sync(&o->timeout);
+	codec_hevc_open_prof_stop(o);
+	mutex_lock(&hevc->lock);
+	hevc->open = NULL;
+	mutex_unlock(&hevc->lock);
+	if (hevc_bench && o->n_hw)
+		codec_hevc_open_bench_log(sess, o);
+	codec_hevc_open_prof_print(sess, o);
+	kfree(o->prof_pc);
+	o->prof_pc = NULL;
+	/* the request in flight, if any, is cancelled by vdec_stop_streaming() */
+	codec_hevc_open_free(sess->core->dev, o);
+	/*
+	 * The core is halted and quiesced: private FBC headers and bodies go
+	 * back, the codec's references on AM21C CAPTURE memory are dropped
+	 * (a body lives on while the display still holds its frame).
+	 */
+	mutex_lock(&hevc->lock);
+	meson_amvdec_codec_hevc_free_fbc_buffers(sess, &hevc->common);
+	mutex_unlock(&hevc->lock);
+}
+
+static void codec_hevc_open_bench_done(struct amvdec_session *sess, struct codec_hevc_open *o)
+{
+	u32 us, i;
+
+	o->t_done = ktime_get();
+	if (!hevc_bench || !o->t_kick)
+		return;
+	us = ktime_us_delta(o->t_done, o->t_kick);
+	o->sum_hw += us;
+	o->max_hw = max(o->max_hw, us);
+	if (o->p_ctu) {
+		o->sum_first += ktime_us_delta(o->p_ctu, o->t_kick);
+		o->n_first++;
+		if (o->p_drain) {
+			o->sum_ctu += ktime_us_delta(o->p_drain, o->p_ctu);
+			o->sum_tail += ktime_us_delta(o->t_done, o->p_drain);
+			o->n_tail++;
+		}
+	}
+	for (i = 0; i < ARRAY_SIZE(o->p_stage); i++)
+		o->prof_stage[i] += o->p_stage[i];
+	o->p_ctu = 0;
+	o->p_drain = 0;
+	memset(o->p_stage, 0, sizeof(o->p_stage));
+	if (++o->n_hw % hevc_bench == 0)
+		codec_hevc_open_bench_log(sess, o);
+}
+
+static irqreturn_t codec_hevc_open_threaded_isr(struct amvdec_session *sess)
+{
+	struct codec_hevc *hevc = sess->priv;
+	struct amvdec_core *core = sess->core;
+	struct device *dev = core->dev_dec;
+	struct codec_hevc_open *o;
+	struct vb2_v4l2_buffer *dst;
+	u32 st, s2, s3, s4;
+	bool ok = true;
+
+	mutex_lock(&hevc->lock);
+	o = hevc->open;
+	if (!o) {
+		/* codec_hevc_open_stop() ran first: the core is halted and gated */
+		mutex_unlock(&hevc->lock);
+		return IRQ_HANDLED;
+	}
+	meson_amvdec_write_dos(core, HEVC_ASSIST_MBOX1_CLR_REG, 1);
+	st = meson_amvdec_read_dos(core, HEVC_ASSIST_SCRATCH_0);
+	if ((st != OHEVC_STATUS_DONE && st != OHEVC_STATUS_ERROR) ||
+	    atomic_cmpxchg(&o->running, 1, 0) != 1) {
+		/* not a verdict, or one the timeout already answered */
+		mutex_unlock(&hevc->lock);
+		return IRQ_HANDLED;
+	}
+	s2 = meson_amvdec_read_dos(core, HEVC_ASSIST_SCRATCH_2);
+	s3 = meson_amvdec_read_dos(core, HEVC_ASSIST_SCRATCH_3);
+	s4 = meson_amvdec_read_dos(core, HEVC_ASSIST_SCRATCH_4);
+	/* Acknowledge (ABI: the host clears it to 0). */
+	meson_amvdec_write_dos(core, HEVC_ASSIST_SCRATCH_0, 0);
+	cancel_delayed_work(&o->timeout);
+	codec_hevc_open_prof_stop(o);
+	codec_hevc_open_bench_done(sess, o);
+	/* The status was read relaxed: order what follows after it. */
+	rmb();
+
+	if (st == OHEVC_STATUS_ERROR) {
+		u32 code = s2 & 0xff;
+
+		/* After 0x81 the firmware must be reloaded: every kick does. */
+		dev_err_ratelimited(dev,
+				    "HEVC open fw: picture failed: error %u (%s) stage %#x detail %#x segment %u/%u (progress %#x) POC %d NAL %u %ux%u\n",
+				    code, code < ARRAY_SIZE(ohevc_err_str) && ohevc_err_str[code] ?
+				    ohevc_err_str[code] : "?", (s2 >> 8) & 0xff, s3, s4, o->nsl,
+				    meson_amvdec_read_dos(core, HEVC_ASSIST_SCRATCH_J),
+				    o->poc, o->nal_type, o->info.w, o->info.h);
+		if (code == 1)
+			dev_err_once(dev,
+				     "HEVC open fw: record rejected - if every picture fails like this, meson/vdec/ohevc_sl.bin is older than this driver: install firmware/hevc/ohevc_sl.bin from the same openucode revision (ohevc-sl v0.2.1)\n");
+		ok = false;
+	} else {
+		if (s2 & OHEVC_DONE_WARNINGS)
+			dev_warn_ratelimited(dev, "HEVC open fw: POC %d done with warnings %#x\n",
+					     o->poc, s2);
+		if (s3 != o->info.ctbs)
+			dev_warn_ratelimited(dev, "HEVC open fw: POC %d: %u of %u CTUs decoded\n",
+					     o->poc, s3, o->info.ctbs);
+	}
+	/* The buffer is a reference for later pictures only when it decoded. */
+	o->buf[o->dst_idx].valid = ok;
+	o->buf[o->dst_idx].ts = o->dst_ts;
+	o->buf[o->dst_idx].mode = o->mode;
+	dst = o->dst;
+	o->dst = NULL;
+	mutex_unlock(&hevc->lock);
+
+	if (!ok)
+		sess->request_job.error = true;
+	meson_amvdec_request_signal(sess, dst);
+	/*
+	 * hevc_open_early_reset: the retirement and the client's next request
+	 * run on other CPUs (the feed worker is WQ_UNBOUND); reset and reload
+	 * the idle core meanwhile.  A feed that is faster takes the lock
+	 * first and does it itself.  vdec_poweroff()'s synchronize_irq() waits
+	 * for this before the core is stopped or @o freed.
+	 */
+	if (ok && READ_ONCE(hevc_open_early_reset))
+		codec_hevc_open_early_prep(sess, hevc);
+	return IRQ_HANDLED;
+}
+
+/*
+ * The firmware bounds every wait and answers 0x81 itself; this catches a lost
+ * interrupt or a hung core.  A stale run (the picture it was armed for has
+ * completed and the next one started) sees the new deadline and re-arms.
+ */
+static void codec_hevc_open_timeout(struct work_struct *work)
+{
+	struct codec_hevc_open *o = container_of(to_delayed_work(work),
+						 struct codec_hevc_open, timeout);
+	struct amvdec_session *sess = o->sess;
+	struct codec_hevc *hevc = sess->priv;
+	struct amvdec_core *core = sess->core;
+	struct vb2_v4l2_buffer *dst;
+	ktime_t now = ktime_get();
+
+	mutex_lock(&hevc->lock);
+	if (!atomic_read(&o->running)) {
+		mutex_unlock(&hevc->lock);
+		return;
+	}
+	if (ktime_before(now, o->deadline)) {
+		mod_delayed_work(system_dfl_wq, &o->timeout,
+				 usecs_to_jiffies(ktime_us_delta(o->deadline, now)) + 1);
+		mutex_unlock(&hevc->lock);
+		return;
+	}
+	if (atomic_cmpxchg(&o->running, 1, 0) != 1) {
+		mutex_unlock(&hevc->lock);
+		return;
+	}
+	codec_hevc_open_prof_stop(o);
+	dev_err(core->dev_dec,
+		"HEVC open fw: no answer after %u ms: status %#x progress %#x scratch2 %#x scratch3 %#x segment %u stream rd %#x wr %#x level %#x shift bytes %#x lcu %#x (POC %d)\n",
+		hevc_open_timeout_ms,
+		meson_amvdec_read_dos(core, HEVC_ASSIST_SCRATCH_0),
+		meson_amvdec_read_dos(core, HEVC_ASSIST_SCRATCH_J),
+		meson_amvdec_read_dos(core, HEVC_ASSIST_SCRATCH_2),
+		meson_amvdec_read_dos(core, HEVC_ASSIST_SCRATCH_3),
+		meson_amvdec_read_dos(core, HEVC_ASSIST_SCRATCH_4),
+		meson_amvdec_read_dos(core, HEVC_STREAM_RD_PTR),
+		meson_amvdec_read_dos(core, HEVC_STREAM_WR_PTR),
+		meson_amvdec_read_dos(core, HEVC_STREAM_LEVEL),
+		meson_amvdec_read_dos(core, HEVC_SHIFT_BYTE_COUNT),
+		meson_amvdec_read_dos(core, HEVC_PARSER_LCU_START), o->poc);
+	/* Halt it; the next picture resets the core and reloads the image anyway. */
+	meson_amvdec_write_dos(core, HEVC_MPSR, 0);
+	meson_amvdec_write_dos(core, HEVC_CPSR, 0);
+	o->buf[o->dst_idx].valid = false;
+	dst = o->dst;
+	o->dst = NULL;
+	mutex_unlock(&hevc->lock);
+
+	sess->request_job.error = true;
+	meson_amvdec_request_signal(sess, dst);
+}
+
+/*
+ * One coded picture: the session programme of hevc_host.session_writes(), the
+ * stream window of the harness's ah_host_stream(), SCRATCH_1/0, start.  The
+ * core is reset and the image reloaded first, as the harness (power cycle per
+ * picture) and the vendor's multi-instance run() do, so nothing from the
+ * previous picture's engines or shifter survives - and a 0x81 needs the
+ * reload anyway.
+ */
+static int codec_hevc_open_core_prep(struct amvdec_session *sess, struct codec_hevc_open *o)
+{
+	struct amvdec_core *core = sess->core;
+	u32 pic = (3 << 29) | BIT(27) | BIT(24) | BIT(22) | BIT(7) | BIT(4) | BIT(0);
+	u32 v;
+	int i, ret;
+
+	ret = meson_amvdec_hevc_fw_reset_reload(core, o->fw_paddr);
+	if (ret) {
+		dev_err(core->dev_dec, "HEVC open fw: core reset failed (%d)\n", ret);
+		return ret;
+	}
+
+	/* --- session programme (hevc_host.session_writes()), before the stream fetch */
+	v = meson_amvdec_read_dos(core, HEVC_PARSER_INT_CONTROL) & ~(0xfc000000 | pic);
+	meson_amvdec_write_dos(core, HEVC_PARSER_INT_CONTROL, v | pic);
+	/* start codes, emulation-prevention removal on */
+	meson_amvdec_write_dos_bits(core, HEVC_SHIFT_STATUS, BIT(1) | BIT(0));
+	meson_amvdec_write_dos(core, HEVC_SHIFT_CONTROL, (3 << 6) | BIT(5) | BIT(2) | BIT(0));
+	/* HEVC_SHIFT_STARTCODE keeps its reset value, as on the harness where
+	 * ohevc-sl was proven: writing 1 made the reader stop one byte early
+	 * (NAL header 0x0126 found, measured 2026-09-29). */
+	meson_amvdec_write_dos(core, HEVC_CABAC_CONTROL, BIT(0));
+	meson_amvdec_write_dos(core, HEVC_PARSER_CORE_CONTROL, BIT(0));
+	meson_amvdec_write_dos(core, HEVC_PARSER_CMD_WRITE, BIT(16));
+	for (i = 0; i < ARRAY_SIZE(meson_amvdec_hevc_parser_cmd); ++i)
+		meson_amvdec_write_dos(core, HEVC_PARSER_CMD_WRITE,
+				       meson_amvdec_hevc_parser_cmd[i]);
+	meson_amvdec_write_dos(core, HEVC_PARSER_CMD_SKIP_0, PARSER_CMD_SKIP_CFG_0);
+	meson_amvdec_write_dos(core, HEVC_PARSER_CMD_SKIP_1, PARSER_CMD_SKIP_CFG_1);
+	meson_amvdec_write_dos(core, HEVC_PARSER_CMD_SKIP_2, PARSER_CMD_SKIP_CFG_2);
+	meson_amvdec_write_dos(core, HEVC_PARSER_IF_CONTROL, BIT(5) | BIT(2) | BIT(0));
+	meson_amvdec_write_dos(core, HEVCD_IPP_TOP_CNTL, BIT(0));
+	meson_amvdec_write_dos(core, HEVCD_IPP_TOP_CNTL, BIT(1));
+	meson_amvdec_write_dos(core, HEVC_ASSIST_MBOX1_CLR_REG, 1);
+	meson_amvdec_write_dos(core, HEVC_PSCALE_CTRL, 0);
+	/* NV12: 2-plane reference reads */
+	meson_amvdec_write_dos(core, HEVCD_MPP_DECOMP_CTL1, BIT(31));
+	if (o->soc == OHEVC_SOC_SM1)
+		meson_amvdec_write_dos(core, HEVC_DBLK_CFG3, 0x4010);
+	/*
+	 * The G12A map DMA reads HEVC_ASSIST_MMU_MAP_ADDR even for NV12: point
+	 * it at the zeroed map before anything runs (ohevc-sl writes the same
+	 * value from the record).
+	 */
+	if (o->soc >= OHEVC_SOC_G12A)
+		meson_amvdec_write_dos(core, HEVC_ASSIST_MMU_MAP_ADDR,
+				       o->ws_paddr + OHEVC_WS_MMU_MAP);
+	return 0;
+}
+
+/*
+ * hevc_open_early_reset, from the threaded ISR after a picture decoded: the
+ * core is idle (the firmware drained it before 0x80) and nothing runs until
+ * the next kick, which then skips this part.
+ */
+static void codec_hevc_open_early_prep(struct amvdec_session *sess, struct codec_hevc *hevc)
+{
+	struct codec_hevc_open *o;
+	ktime_t t0;
+
+	mutex_lock(&hevc->lock);
+	o = hevc->open;
+	if (o && !atomic_read(&o->running) && !o->core_ready) {
+		t0 = ktime_get();
+		o->core_ready = !codec_hevc_open_core_prep(sess, o);
+		if (hevc_bench && o->core_ready) {
+			o->sum_eprep += ktime_us_delta(ktime_get(), t0);
+			o->n_eprep++;
+		}
+	}
+	mutex_unlock(&hevc->lock);
+}
+
+static int codec_hevc_open_kick(struct amvdec_session *sess, struct codec_hevc_open *o,
+				u32 bytes)
+{
+	struct amvdec_core *core = sess->core;
+	dma_addr_t src = o->fifo_paddr;
+	u32 tmo = hevc_open_timeout_ms ?: 1000;
+	ktime_t t0;
+	int ret;
+
+	/* the core reset, the image reload and the session programme */
+	o->prep_us = 0;
+	if (!o->core_ready) {
+		t0 = ktime_get();
+		ret = codec_hevc_open_core_prep(sess, o);
+		if (ret)
+			return ret;
+		o->prep_us = ktime_us_delta(ktime_get(), t0);
+		if (hevc_bench) {
+			o->sum_prep += o->prep_us;
+			o->max_prep = max(o->max_prep, o->prep_us);
+			o->n_prep++;
+		}
+	}
+	o->core_ready = false;
+
+	/*
+	 * --- stream: frame mode over the driver's buffer.  No ESPARSER
+	 * (DOS_GEN_CTRL0 and CONTROL bit 3 clear: with them the write pointer
+	 * reads back 0 and the core fetches around the ring), reset bits kept,
+	 * endian 6:4 = 7, FIFO_CTL bit 29, fetch on last.
+	 */
+	meson_amvdec_write_dos(core, DOS_GEN_CTRL0, 0);
+	meson_amvdec_write_dos(core, HEVC_STREAM_CONTROL, o->stream_ctl);
+	meson_amvdec_write_dos(core, HEVC_STREAM_START_ADDR, src);
+	meson_amvdec_write_dos(core, HEVC_STREAM_END_ADDR, src + o->fifo_size);
+	meson_amvdec_write_dos(core, HEVC_STREAM_RD_PTR, src);
+	meson_amvdec_write_dos(core, HEVC_STREAM_WR_PTR,
+			       round_down(src + bytes + OHEVC_FIFO_PAD, OHEVC_FIFO_ALIGN));
+	meson_amvdec_write_dos(core, HEVC_STREAM_CONTROL, o->stream_ctl | (7 << 4));
+	meson_amvdec_write_dos_bits(core, HEVC_STREAM_FIFO_CTL, BIT(29));
+	meson_amvdec_write_dos(core, HEVC_STREAM_CONTROL, o->stream_ctl | (7 << 4) | BIT(0));
+
+	/* --- command */
+	meson_amvdec_write_dos(core, HEVC_ASSIST_MBOX1_CLR_REG, 1);
+	meson_amvdec_write_dos(core, HEVC_ASSIST_MBOX1_MASK, 1);
+	meson_amvdec_write_dos(core, HEVC_ASSIST_SCRATCH_2, 0);
+	meson_amvdec_write_dos(core, HEVC_ASSIST_SCRATCH_3, 0);
+	meson_amvdec_write_dos(core, HEVC_ASSIST_SCRATCH_4, 0);
+	meson_amvdec_write_dos(core, HEVC_ASSIST_SCRATCH_1, o->ws_paddr + OHEVC_WS_RECORD);
+	meson_amvdec_write_dos(core, HEVC_ASSIST_SCRATCH_0, OHEVC_CMD_DECODE);
+
+	/* The records, the LUT, the stream and the MV buffers before the start. */
+	wmb();
+	atomic_set(&o->running, 1);
+	o->deadline = ktime_add_ms(ktime_get(), tmo);
+	mod_delayed_work(system_dfl_wq, &o->timeout, msecs_to_jiffies(tmo) + 1);
+	o->t_kick = ktime_get();
+	if (hevc_bench && o->t_done) {
+		u32 us = ktime_us_delta(o->t_kick, o->t_done);
+
+		o->sum_gap += us;
+		o->max_gap = max(o->max_gap, us);
+		o->n_gap++;
+		if (ktime_after(o->t_feed, o->t_done)) {
+			o->sum_feed += ktime_us_delta(o->t_feed, o->t_done);
+			o->sum_build += ktime_us_delta(o->t_built, o->t_feed);
+			o->n_feed++;
+		}
+	}
+	meson_amvdec_hevc_fw_start(core);
+	codec_hevc_open_prof_start(o);
+	return 0;
+}
+
+/* FBC header of a CAPTURE buffer: the AM21C plane, else the private one. */
+static dma_addr_t codec_hevc_open_fbc_head(struct amvdec_session *sess, struct codec_hevc *hevc,
+					   struct vb2_buffer *vb)
+{
+	if (sess->pixfmt_cap == V4L2_PIX_FMT_AM21C)
+		return vb->num_planes ? vb2_dma_contig_plane_dma_addr(vb, 0) : 0;
+	return vb->index < MAX_REF_PIC_NUM ? hevc->common.mmu_header_paddr[vb->index] : 0;
+}
+
+/* The MV buffer of CAPTURE buffer @idx, large enough for a w x h picture. */
+static int codec_hevc_open_mv(struct device *dev, struct codec_hevc_open *o, u32 idx,
+			      u32 w, u32 h)
+{
+	struct codec_hevc_open_buf *b = &o->buf[idx];
+	size_t need = PAGE_ALIGN(OHEVC_MV_SIZE(w, h));
+
+	if (b->mv_vaddr && b->mv_size >= need)
+		return 0;
+	if (b->mv_vaddr)
+		dma_free_coherent(dev, b->mv_size, b->mv_vaddr, b->mv_paddr);
+	b->mv_size = 0;
+	b->valid = false;
+	b->mv_vaddr = dma_alloc_coherent(dev, need, &b->mv_paddr, GFP_KERNEL);
+	if (!b->mv_vaddr)
+		return -ENOMEM;
+	b->mv_size = need;
+	return 0;
+}
+
+/* The grey stand-in reference, planes laid out as a CAPTURE buffer of this size. */
+static int codec_hevc_open_grey(struct device *dev, struct codec_hevc_open *o,
+				u32 out_size, u32 w, u32 h)
+{
+	size_t ysz = ALIGN(out_size, SZ_64K), mvsz = PAGE_ALIGN(OHEVC_MV_SIZE(w, h));
+
+	if (o->grey_y && o->grey_size >= ysz && o->grey_mv_size >= mvsz)
+		return 0;
+	codec_hevc_open_free_grey(dev, o);
+	/* 64 KiB multiples: GXBB's ANC2AXI keeps address bits 31:16 only */
+	o->grey_y = dma_alloc_coherent(dev, ysz, &o->grey_y_paddr, GFP_KERNEL);
+	o->grey_uv = dma_alloc_coherent(dev, ysz / 2, &o->grey_uv_paddr, GFP_KERNEL);
+	o->grey_mv = dma_alloc_coherent(dev, mvsz, &o->grey_mv_paddr, GFP_KERNEL);
+	o->grey_size = ysz;
+	o->grey_mv_size = mvsz;
+	if (!o->grey_y || !o->grey_uv || !o->grey_mv) {
+		codec_hevc_open_free_grey(dev, o);
+		return -ENOMEM;
+	}
+	memset(o->grey_y, 0x80, ysz);
+	memset(o->grey_uv, 0x80, ysz / 2);
+	memset(o->grey_mv, 0, mvsz);
+	return 0;
+}
+
+static int codec_hevc_open_fifo(struct device *dev, struct codec_hevc_open *o, size_t len)
+{
+	size_t need = ALIGN(len + OHEVC_FIFO_PAD + OHEVC_FIFO_SLACK, SZ_64K);
+
+	if (o->fifo_vaddr && o->fifo_size >= need)
+		return 0;
+	if (o->fifo_vaddr)
+		dma_free_coherent(dev, o->fifo_size, o->fifo_vaddr, o->fifo_paddr);
+	o->fifo_size = 0;
+	o->fifo_vaddr = dma_alloc_coherent(dev, need, &o->fifo_paddr, GFP_KERNEL);
+	if (!o->fifo_vaddr)
+		return -ENOMEM;
+	o->fifo_size = need;
+	return 0;
+}
+
+/*
+ * Decode the picture of @vb (the request job's OUTPUT buffer, frame-based:
+ * every slice segment of the picture, each after 00 00 01) into the job's
+ * CAPTURE buffer, with the references the job resolved per DPB entry.
+ * sess->request_job.slices holds the SLICE_PARAMS array.  Errors before the
+ * kick leave both buffers to the caller; after it, completion comes from the
+ * ISR or the timeout.
+ */
+int meson_amvdec_codec_hevc_open_feed(struct amvdec_session *sess,
+				      struct vb2_buffer *vb,
+				      const struct v4l2_ctrl_hevc_sps *sps,
+				      const struct v4l2_ctrl_hevc_pps *pps,
+				      const struct v4l2_ctrl_hevc_decode_params *dp,
+				      const struct v4l2_ctrl_hevc_scaling_matrix *sm)
+{
+	struct codec_hevc *hevc = sess->priv;
+	struct amvdec_core *core = sess->core;
+	struct device *dev = core->dev_dec;
+	u32 w = sps->pic_width_in_luma_samples, h = sps->pic_height_in_luma_samples;
+	u32 out_size = meson_amvdec_get_output_size(sess);
+	u32 payload = vb2_get_plane_payload(vb, 0);
+	const u8 *data = vb2_plane_vaddr(vb, 0);
+	u32 nsl = sess->request_job.num_slices;
+	struct codec_hevc_open *o;
+	struct vb2_buffer *dst;
+	bool have[OHEVC_MAX_DPB], used[OHEVC_MAX_DPB];
+	struct ohevc_in *in;
+	enum ohevc_why why;
+	u32 i, greys = 0;
+	bool is10;
+	int ret, mode;
+
+	if (!hevc || !sess->request_job.dst || !sess->request_job.slices)
+		return -EINVAL;
+	dst = &sess->request_job.dst->vb2_buf;
+
+	mutex_lock(&hevc->lock);
+	o = hevc->open;
+	ret = -EBUSY;
+	if (!o || atomic_read(&o->running))
+		goto out;
+	in = &o->in;
+	if (hevc_bench)
+		o->t_feed = ktime_get();
+
+	/*
+	 * --- output (abi-hevc.md 6): 8-bit into NV12M as before; Main 10 into
+	 * NV12M = FBC references in driver-private headers and bodies plus the
+	 * 8-bit NV12 double write; AM21C (any depth) = FBC only, header = the
+	 * CAPTURE plane, body = the pages the CAPTURE memory owns.
+	 */
+	ret = -EINVAL;
+	is10 = sps->bit_depth_luma_minus8 == 2;
+	if (sess->pixfmt_cap == V4L2_PIX_FMT_AM21C)
+		mode = OHEVC_OUT_FBC;
+	else if (sess->pixfmt_cap == V4L2_PIX_FMT_NV12M)
+		mode = is10 || o->fbc8 ? OHEVC_OUT_FBC_NV12 : OHEVC_OUT_NV12;
+	else
+		mode = -1;
+	if (mode < 0 || w != sess->width || h != sess->height ||
+	    dst->index >= (mode == OHEVC_OUT_NV12 ? OHEVC_MAX_BUFS : MAX_REF_PIC_NUM) ||
+	    (mode != OHEVC_OUT_FBC &&
+	     (dst->num_planes < 2 || vb2_plane_size(dst, 0) < out_size ||
+	      vb2_plane_size(dst, 1) < out_size / 2)) ||
+	    (mode == OHEVC_OUT_FBC &&
+	     (dst->num_planes < 1 || vb2_plane_size(dst, 0) < AM21C_HEADER_SIZE))) {
+		dev_err_ratelimited(dev,
+				    "HEVC open fw: %ux%u %u-bit into CAPTURE %u (%ux%u, format %p4cc) not possible\n",
+				    w, h, 8 + sps->bit_depth_luma_minus8, dst->index, sess->width,
+				    sess->height, &sess->pixfmt_cap);
+		goto out;
+	}
+	if (mode != OHEVC_OUT_NV12 &&
+	    (o->soc < OHEVC_SOC_G12A || sps->bit_depth_chroma_minus8 != sps->bit_depth_luma_minus8 ||
+	     sess->bitdepth != 8 + sps->bit_depth_luma_minus8)) {
+		dev_err_ratelimited(dev,
+				    "HEVC open fw: compressed output needs G12A/SM1 and equal luma/chroma depth (%u/%u, session %u)\n",
+				    8 + sps->bit_depth_luma_minus8, 8 + sps->bit_depth_chroma_minus8,
+				    sess->bitdepth);
+		ret = -EOPNOTSUPP;
+		goto out;
+	}
+	if (!data || !payload || !nsl) {
+		dev_err_ratelimited(dev, "HEVC open fw: empty OUTPUT buffer or no slice parameters\n");
+		goto out;
+	}
+	memset(in, 0, sizeof(*in));
+	in->nv12 = mode != OHEVC_OUT_FBC;
+	in->fbc = mode != OHEVC_OUT_NV12;
+	if (in->nv12) {
+		in->out_y = vb2_dma_contig_plane_dma_addr(dst, 0);
+		in->out_uv = vb2_dma_contig_plane_dma_addr(dst, 1);
+		in->out_size = out_size;
+	}
+	if (o->soc == OHEVC_SOC_GXBB && ((in->out_y | in->out_uv) & (SZ_64K - 1))) {
+		dev_err_ratelimited(dev, "HEVC open fw: GXBB needs 64 KiB aligned CAPTURE planes\n");
+		goto out;
+	}
+	if (in->fbc) {
+		/*
+		 * The destination's header and body (AM21C: the body is grown
+		 * on the CAPTURE memory and held by the codec until it stops;
+		 * NV12M: the downsample-mode private header and body).
+		 */
+		ret = meson_amvdec_codec_hevc_ensure_frame_buffer(sess, &hevc->common, dst, is10);
+		if (ret)
+			goto out;
+		ret = -EINVAL;
+		in->fbc_head = codec_hevc_open_fbc_head(sess, hevc, dst);
+		in->fbc_body = meson_amvdec_codec_hevc_fbc_body_addr(sess, &hevc->common, dst);
+		if (!in->fbc_head || !in->fbc_body) {
+			dev_err_ratelimited(dev, "HEVC open fw: CAPTURE %u has no FBC header/body\n",
+					    dst->index);
+			goto out;
+		}
+	}
+
+	/*
+	 * --- references: per DPB entry, decoded here in this output mode.
+	 * Otherwise NV12: the grey stand-in; FBC: the decoded entry nearest in
+	 * POC (a grey compressed picture cannot be made without decoding one).
+	 * 8-bit FBC + NV12 (hevc_open_fbc8): every decoded picture also has its
+	 * exact NV12 copy, so a picture with a missing reference in its current
+	 * RPS reads all its references from the NV12 planes (ABI v2.1 linear
+	 * references) with the grey NV12 stand-in, as the NV12 path does; its
+	 * own output stays FBC + NV12 for the pictures after it.
+	 */
+	if (dp->num_active_dpb_entries > OHEVC_MAX_DPB)
+		goto out;
+	for (i = 0; i < dp->num_active_dpb_entries; i++) {
+		struct vb2_buffer *ref = sess->request_job.refs[i];
+		const struct codec_hevc_open_buf *b = ref && ref->index < OHEVC_MAX_BUFS ?
+						      &o->buf[ref->index] : NULL;
+
+		have[i] = ref && b && sess->request_job.ref_ts[i] == dp->dpb[i].timestamp &&
+			  b->valid && b->ts == dp->dpb[i].timestamp && b->mode == mode &&
+			  b->mv_size >= OHEVC_MV_SIZE(w, h);
+	}
+	/*
+	 * Only the current RPS (StCurrBefore, StCurrAfter, LtCurr) reaches the
+	 * record: the other entries need no stand-in.
+	 */
+	memset(used, 0, sizeof(used));
+	for (i = 0; i < (u32)dp->num_poc_st_curr_before + dp->num_poc_st_curr_after +
+		    dp->num_poc_lt_curr && i < OHEVC_MAX_DPB; i++) {
+		u32 j = i < dp->num_poc_st_curr_before ? dp->poc_st_curr_before[i] :
+			i < (u32)dp->num_poc_st_curr_before + dp->num_poc_st_curr_after ?
+			dp->poc_st_curr_after[i - dp->num_poc_st_curr_before] :
+			dp->poc_lt_curr[i - dp->num_poc_st_curr_before - dp->num_poc_st_curr_after];
+
+		if (j < dp->num_active_dpb_entries) {
+			used[j] = true;
+			if (!have[j] && mode == OHEVC_OUT_FBC_NV12 && !is10)
+				in->linref = true;
+		}
+	}
+	/* test only (OUCODE_DEV): hevc_open_debug bit 16 = NV12 reference reads on odd POCs, bit 17 = always */
+	if (mode == OHEVC_OUT_FBC_NV12 && !is10 &&
+	    ((READ_ONCE(hevc_open_debug) & BIT(17)) ||
+	     ((READ_ONCE(hevc_open_debug) & BIT(16)) && (dp->pic_order_cnt_val & 1))))
+		in->linref = true;
+	for (i = 0; i < dp->num_active_dpb_entries; i++) {
+		struct vb2_buffer *ref = sess->request_job.refs[i];
+		const struct codec_hevc_open_buf *b;
+
+		if (!have[i])
+			continue;
+		b = &o->buf[ref->index];
+		have[i] = false;
+		if (in->fbc && !in->linref) {
+			in->ref[i].y = codec_hevc_open_fbc_head(sess, hevc, ref);
+			in->ref[i].uv = in->ref[i].y;
+			if (!in->ref[i].y)
+				continue;
+		} else {
+			if (ref->num_planes < 2)
+				continue;
+			in->ref[i].y = vb2_dma_contig_plane_dma_addr(ref, 0);
+			in->ref[i].uv = vb2_dma_contig_plane_dma_addr(ref, 1);
+		}
+		in->ref[i].mv = b->mv_paddr;
+		have[i] = true;
+	}
+	for (i = 0; i < dp->num_active_dpb_entries; i++) {
+		u32 j, best = U32_MAX;
+		s64 d, bestd = S64_MAX;
+
+		if (have[i] || !used[i])
+			continue;
+		greys++;
+		dev_dbg(dev, "HEVC open fw: DPB entry %u (POC %d, timestamp %llu) not decoded here: %s\n",
+			i, dp->dpb[i].pic_order_cnt_val, dp->dpb[i].timestamp,
+			in->fbc && !in->linref ? "nearest decoded" : "grey");
+		if (!in->fbc || in->linref) {
+			ret = codec_hevc_open_grey(core->dev, o, out_size, w, h);
+			if (ret)
+				goto out;
+			ret = -EINVAL;
+			if (o->soc == OHEVC_SOC_GXBB &&
+			    ((o->grey_y_paddr | o->grey_uv_paddr) & (SZ_64K - 1))) {
+				dev_err_ratelimited(dev, "HEVC open fw: grey reference planes not 64 KiB aligned\n");
+				goto out;
+			}
+			in->ref[i].y = o->grey_y_paddr;
+			in->ref[i].uv = o->grey_uv_paddr;
+			in->ref[i].mv = o->grey_mv_paddr;
+			continue;
+		}
+		for (j = 0; j < dp->num_active_dpb_entries; j++) {
+			if (!have[j])
+				continue;
+			d = abs((s64)dp->dpb[j].pic_order_cnt_val - dp->dpb[i].pic_order_cnt_val);
+			if (d < bestd) {
+				bestd = d;
+				best = j;
+			}
+		}
+		if (best == U32_MAX) {
+			dev_err_ratelimited(dev,
+					    "HEVC open fw: POC %d: no decoded reference to stand in for POC %d (FBC)\n",
+					    dp->pic_order_cnt_val, dp->dpb[i].pic_order_cnt_val);
+			goto out;
+		}
+		in->ref[i] = in->ref[best];
+	}
+
+	/* --- buffers that must fit this picture */
+	ret = codec_hevc_open_mv(core->dev, o, dst->index, w, h);
+	if (!ret)
+		ret = codec_hevc_open_fifo(core->dev, o, OHEVC_STREAM_NEED(payload, nsl));
+	if (ret)
+		goto out;
+
+	/* --- records and stream; the CAPTURE buffer stops being a reference now */
+	o->buf[dst->index].valid = false;
+	if (sm)
+		o->sm = *sm;
+	in->sps = sps;
+	in->pps = pps;
+	in->dp = dp;
+	in->sl = sess->request_job.slices;
+	in->nsl = nsl;
+	in->sm = sm ? &o->sm : NULL;
+	in->data = data;
+	in->len = payload;
+	in->soc = o->soc;
+	/* debug bits 3, 6, 9 need host state of the collocated picture the driver does not keep */
+	in->debug = READ_ONCE(hevc_open_debug) & 0xffff & ~(BIT(3) | BIT(6) | BIT(9));
+	in->mv_wr = o->buf[dst->index].mv_paddr;
+	in->ws = o->ws_paddr;
+	why = ohevc_build(in, o->rec, o->srec, o->lut, o->fifo_vaddr,
+			  o->fifo_size - OHEVC_FIFO_PAD - OHEVC_FIFO_SLACK, &o->info);
+	if (why != OHEVC_OK) {
+		dev_err_ratelimited(dev,
+				    "HEVC open fw: picture refused: %s (%ux%u CTB %u, POC %d, segment %u of %u)\n",
+				    ohevc_why_str[why], w, h, 1u << o->info.log2_ctb,
+				    dp->pic_order_cnt_val, o->info.bad_slice, nsl);
+		ret = why == OHEVC_BAD_FORMAT ? -EOPNOTSUPP : -EINVAL;
+		goto out;
+	}
+	/* FBC: the SAO-MMU map lists this picture's body pages (abi-hevc.md 6) */
+	if (in->fbc) {
+		ret = meson_amvdec_codec_hevc_fill_mmu_map_at(sess, &hevc->common, dst, is10,
+							      (u32 *)(o->ws + OHEVC_WS_MMU_MAP));
+		if (ret) {
+			dev_err_ratelimited(dev, "HEVC open fw: SAO-MMU map of CAPTURE %u failed (%d)\n",
+					    dst->index, ret);
+			goto out;
+		}
+	}
+	ohevc_write_words((u16 *)(o->ws + OHEVC_WS_RECORD), o->rec, OHEVC_PIC_WORDS);
+	for (i = 0; i < nsl; i++)
+		ohevc_write_words((u16 *)(o->ws + OHEVC_WS_SLICES) + i * OHEVC_SLICE_WORDS,
+				  o->srec + i * OHEVC_SLICE_WORDS, OHEVC_SLICE_WORDS);
+	if (o->rec[OHEVC_P_FLAGS] & OHEVC_PF_SCALING) {
+		for (i = 0; i < OHEVC_LUT_WORDS; i++)
+			o->lutw[i] = o->lut[2 * i] | o->lut[2 * i + 1] << 8;
+		ohevc_write_words((u16 *)(o->ws + OHEVC_WS_LUT), o->lutw, OHEVC_LUT_WORDS);
+	}
+	/* only what the fetch can reach: the buffer may be sized for a far larger picture */
+	memset((u8 *)o->fifo_vaddr + o->info.stream_len, 0,
+	       min_t(size_t, o->fifo_size - o->info.stream_len,
+		     OHEVC_FIFO_PAD + OHEVC_FIFO_SLACK));
+	if (hevc_bench)
+		o->t_built = ktime_get();
+
+	o->dst = sess->request_job.dst;
+	o->dst_idx = dst->index;
+	o->dst_ts = sess->request_job.timestamp;
+	o->mode = mode;
+	o->poc = dp->pic_order_cnt_val;
+	o->nsl = nsl;
+	o->nal_type = sess->request_job.slices[0].nal_unit_type;
+	o->greys += greys;
+	o->linrefs += in->linref;
+	dev_dbg(dev,
+		"hevc open fw: POC %d NAL %u %ux%u CTB %u buf %u segments %u refs %u/%u (grey %u) scaling %u bytes %u\n",
+		o->poc, o->nal_type, w, h, 1u << o->info.log2_ctb, dst->index, nsl,
+		o->info.ntable, dp->num_active_dpb_entries, greys,
+		!!(o->rec[OHEVC_P_FLAGS] & OHEVC_PF_SCALING), o->info.stream_len);
+
+	ret = codec_hevc_open_kick(sess, o, o->info.stream_len);
+	if (ret) {
+		o->dst = NULL;
+		mutex_unlock(&hevc->lock);
+		/* the core did not quiesce: nothing more can run on it */
+		meson_amvdec_abort(sess);
+		return ret;
+	}
+out:
+	mutex_unlock(&hevc->lock);
+	return ret;
+}
diff --speed-large-files --no-dereference --minimal -Naur linux-7.2.8/drivers/media/platform/amlogic/amvdec/codec_hevc_common.c linux-7.2.8/drivers/media/platform/amlogic/amvdec/codec_hevc_common.c
--- linux-7.2.8/drivers/media/platform/amlogic/amvdec/codec_hevc_common.c	1970-01-01 01:00:00.000000000 +0100
+++ linux-7.2.8/drivers/media/platform/amlogic/amvdec/codec_hevc_common.c	2026-10-02 08:55:53.000000000 +0200
@@ -0,0 +1,1307 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Copyright (C) 2018 Maxime Jourdan <mjourdan@baylibre.com>
+ * Copyright (C) 2026 Christian Hewitt <christianshewitt@gmail.com>
+ *
+ * HEVC and VP9 capture backing and framebuffer compression.
+ */
+
+#include <linux/device.h>
+#include <linux/dma-buf.h>
+#include <linux/dma-mapping.h>
+#include <linux/mm.h>
+#include <linux/module.h>
+#include <linux/refcount.h>
+
+#include <media/v4l2-mem2mem.h>
+#include <media/videobuf2-dma-contig.h>
+
+#include "codec_hevc_common.h"
+#include "amvdec_helpers.h"
+#include "hevc_regs.h"
+
+#define MMU_COMPRESS_HEADER_SIZE 0x48000
+#define MMU_MAP_SIZE 0x4800
+
+/*
+ * Chunked backing for MMU-mode compressed bodies.
+ *
+ * In MMU mode the hardware reaches body pages only through the frame
+ * page map, so the body needs no contiguity at all: it is assembled
+ * from single pages, grouped into fixed-size chunks purely as a unit of
+ * bookkeeping.  That removes the 16 MiB contiguous allocation a 4K
+ * 10-bit frame used to need.
+ *
+ * The pages come from dma_alloc_pages() one at a time.  A PAGE_SIZE
+ * request short-circuits dma_alloc_contiguous(), so it is served by the
+ * page allocator and never touches CMA - which is what takes ~256 MiB
+ * of a 4K 10-bit session out of the contended pool.  It is not
+ * alloc_pages(): dma_alloc_pages() applies the device's DMA mask (this
+ * one has the default 32-bit coherent mask) and retries from a lower
+ * zone, a check raw page allocation would skip.
+ *
+ * The pages are CACHED, unlike the coherent range they replace, and
+ * nothing in this driver ever reads or writes a body through the CPU -
+ * only the decoder and the display do, at the point of coherency.  So
+ * the cache is handled exactly twice: invalidate after allocation, to
+ * drop the dirty lines dma_alloc_pages() leaves behind when it zeroes
+ * the page (they would otherwise write back over decoded data), and
+ * invalidate again before the page goes back to the allocator, so no
+ * speculatively-loaded stale line outlives it.
+ *
+ * Who owns a body depends on who can read it:
+ *
+ *  - Downsampling (10-bit decoded to NV12M): the body is decoder-private
+ *    scratch, the display sees only the NV12M planes.  It lives in
+ *    codec_hevc_common and is freed when the codec stops, after the
+ *    hardware has been stopped.
+ *
+ *  - AM21C: the CAPTURE plane is only the compression header, and the
+ *    header holds the addresses of the body pages.  The VD1 overlay
+ *    scans the body through a DMA-BUF of that plane, and keeps doing so
+ *    until its next commit - after the buffer was requeued, after
+ *    STREAMOFF, after REQBUFS(0), after the V4L2 fd is closed.  So the
+ *    body belongs to the CAPTURE buffer's memory (struct amvdec_cap_buf
+ *    below), and is freed only when the last holder of that memory lets
+ *    go.  See meson_amvdec_cap_memops.
+ */
+#define FBC_CHUNK_PAGES	256u
+#define FBC_CHUNK_SIZE	(FBC_CHUNK_PAGES << PAGE_SHIFT)	/* 1 MiB */
+
+static unsigned int
+codec_hevc_capture_buffers(struct amvdec_session *sess,
+			   struct vb2_buffer *bufs[MAX_REF_PIC_NUM]);
+
+struct fbc_chunk {
+	struct page **pages;	/* FBC_CHUNK_PAGES single pages */
+	dma_addr_t  *dma;	/* their bus addresses, in the same order */
+};
+
+static void fbc_chunk_free(struct device *dev, struct fbc_chunk *c)
+{
+	u32 i;
+
+	if (c->pages) {
+		for (i = 0; i < FBC_CHUNK_PAGES; ++i) {
+			if (!c->pages[i])
+				continue;
+			/*
+			 * The decoder wrote this page without going through
+			 * the cache; drop anything the CPU may have pulled in
+			 * speculatively before the page is reused.
+			 */
+			dma_sync_single_for_cpu(dev, c->dma[i], PAGE_SIZE,
+						DMA_FROM_DEVICE);
+			dma_free_pages(dev, PAGE_SIZE, c->pages[i], c->dma[i],
+				       DMA_FROM_DEVICE);
+		}
+	}
+
+	kfree(c->pages);
+	kfree(c->dma);
+	kfree(c);
+}
+
+static struct fbc_chunk *fbc_chunk_alloc(struct device *dev)
+{
+	struct fbc_chunk *c;
+	u32 i;
+
+	c = kzalloc(sizeof(*c), GFP_KERNEL);
+	if (!c)
+		return NULL;
+
+	c->pages = kcalloc(FBC_CHUNK_PAGES, sizeof(*c->pages), GFP_KERNEL);
+	c->dma   = kcalloc(FBC_CHUNK_PAGES, sizeof(*c->dma), GFP_KERNEL);
+	if (!c->pages || !c->dma)
+		goto err;
+
+	for (i = 0; i < FBC_CHUNK_PAGES; ++i) {
+		/*
+		 * __GFP_NORETRY, not bare GFP_KERNEL: an order-0 GFP_KERNEL
+		 * allocation does not fail, it reclaims and then invokes the
+		 * OOM killer.  A 4K session asks for ~65k of these, and a
+		 * decode that cannot get memory must fail cleanly - the
+		 * caller turns this into -ENOMEM - rather than kill the
+		 * player to make room for itself.  __GFP_NOWARN keeps a
+		 * handled failure off the console.
+		 */
+		c->pages[i] = dma_alloc_pages(dev, PAGE_SIZE, &c->dma[i],
+					      DMA_FROM_DEVICE,
+					      GFP_KERNEL | __GFP_NORETRY |
+					      __GFP_NOWARN);
+		if (!c->pages[i])
+			goto err;
+
+		/* Drop the dirty lines left by the zeroing above */
+		dma_sync_single_for_device(dev, c->dma[i], PAGE_SIZE,
+					   DMA_FROM_DEVICE);
+	}
+
+	return c;
+
+err:
+	fbc_chunk_free(dev, c);
+	return NULL;
+}
+
+static void fbc_chunks_free(struct device *dev, struct fbc_chunk **chunks,
+			    u32 nr)
+{
+	u32 i;
+
+	if (!chunks)
+		return;
+	for (i = 0; i < nr; ++i)
+		if (chunks[i])
+			fbc_chunk_free(dev, chunks[i]);
+	kfree(chunks);
+}
+
+/*
+ * CAPTURE buffer memory: vb2-dma-contig, plus the AM21C compressed body.
+ *
+ * Every CAPTURE plane is allocated (or imported) by vb2-dma-contig as
+ * usual; the mem_priv vb2 holds is this wrapper around it.  For AM21C
+ * the wrapper also carries the frame's body, so the body lives exactly
+ * as long as something can still reach the frame.  The holders, each
+ * owning one reference:
+ *
+ *  1. vb2, from alloc until put - i.e. until REQBUFS(0), a reallocating
+ *     REQBUFS, or the close of the fd.  vb2 frees buffers only after
+ *     stop_streaming, which has stopped the decoder.
+ *  2. every DMA-BUF exported from the plane (EXPBUF), until the DMA-BUF
+ *     itself is released - which is after the last fd, DRM GEM import
+ *     and attachment is gone, i.e. after the display has committed
+ *     another frame.  vb2-dma-contig's own export keeps the header
+ *     alive the same way; the release hook below extends that to the
+ *     body.
+ *  3. the codec (struct codec_hevc_common.cap_buf[]), for every buffer
+ *     it has programmed into the decoder, until the codec stops.  If
+ *     the decoder cannot be stopped the codec state is deliberately
+ *     leaked, and so is this reference: a runaway decoder then scribbles
+ *     on pages nobody else owns.
+ *
+ * The body only ever grows (a larger picture, or 8-bit to 10-bit, with
+ * the same buffers): chunks are appended and none is freed or moved
+ * while the buffer lives, so a header decoded earlier and still on
+ * screen never points at a page that has been given away.  Its size is
+ * capped by the MMU map (18 chunks for 4K 10-bit).
+ *
+ * Imported CAPTURE DMA-BUFs cannot carry a body - the driver never
+ * learns when the exporter's other users are done with them - so
+ * AM21C is refused for V4L2_MEMORY_DMABUF (see vdec_queue_setup()).
+ */
+struct amvdec_cap_buf {
+	void *inner;			/* vb2-dma-contig mem_priv, until put */
+	refcount_t refcount;
+	bool imported;
+	struct device *dev;		/* referenced while a body exists */
+	struct fbc_chunk **chunks;
+	u32 nr_chunks;
+};
+
+/* One per exported DMA-BUF: the exporter's ops with release hooked. */
+struct amvdec_cap_export {
+	struct dma_buf_ops ops;
+	const struct dma_buf_ops *inner_ops;
+	struct amvdec_cap_buf *buf;
+};
+
+static void amvdec_cap_buf_put(struct amvdec_cap_buf *buf)
+{
+	if (!refcount_dec_and_test(&buf->refcount))
+		return;
+
+	if (buf->dev) {
+		fbc_chunks_free(buf->dev, buf->chunks, buf->nr_chunks);
+		put_device(buf->dev);
+	}
+	kfree(buf);
+}
+
+static struct amvdec_cap_buf *amvdec_cap_buf_wrap(void *inner, bool imported)
+{
+	struct amvdec_cap_buf *buf;
+
+	buf = kzalloc(sizeof(*buf), GFP_KERNEL);
+	if (!buf)
+		return NULL;
+
+	buf->inner = inner;
+	buf->imported = imported;
+	refcount_set(&buf->refcount, 1);
+	return buf;
+}
+
+static void *amvdec_cap_alloc(struct vb2_buffer *vb, struct device *dev,
+			      unsigned long size)
+{
+	struct amvdec_cap_buf *buf;
+	void *inner;
+
+	inner = vb2_dma_contig_memops.alloc(vb, dev, size);
+	if (IS_ERR_OR_NULL(inner))
+		return inner;
+
+	buf = amvdec_cap_buf_wrap(inner, false);
+	if (!buf) {
+		vb2_dma_contig_memops.put(inner);
+		return ERR_PTR(-ENOMEM);
+	}
+	return buf;
+}
+
+static void amvdec_cap_put(void *buf_priv)
+{
+	struct amvdec_cap_buf *buf = buf_priv;
+
+	vb2_dma_contig_memops.put(buf->inner);
+	buf->inner = NULL;
+	amvdec_cap_buf_put(buf);
+}
+
+static void amvdec_cap_dmabuf_release(struct dma_buf *dbuf)
+{
+	struct amvdec_cap_export *exp =
+		container_of(dbuf->ops, struct amvdec_cap_export, ops);
+	struct amvdec_cap_buf *buf = exp->buf;
+
+	/* Let the exporter drop its reference on the plane first */
+	dbuf->ops = exp->inner_ops;
+	dbuf->ops->release(dbuf);
+
+	/* then the body, which is what the display was scanning */
+	amvdec_cap_buf_put(buf);
+	kfree(exp);
+	module_put(THIS_MODULE);
+}
+
+static struct dma_buf *amvdec_cap_get_dmabuf(struct vb2_buffer *vb,
+					     void *buf_priv,
+					     unsigned long flags)
+{
+	struct amvdec_cap_buf *buf = buf_priv;
+	struct amvdec_cap_export *exp;
+	struct dma_buf *dbuf;
+
+	exp = kzalloc(sizeof(*exp), GFP_KERNEL);
+	if (!exp)
+		return NULL;
+
+	dbuf = vb2_dma_contig_memops.get_dmabuf(vb, buf->inner, flags);
+	if (IS_ERR_OR_NULL(dbuf)) {
+		kfree(exp);
+		return dbuf;
+	}
+
+	/*
+	 * vb2-dma-contig's DMA-BUF keeps the plane (the header) alive by
+	 * itself, but knows nothing of the body.  Give this DMA-BUF its own
+	 * copy of the exporter's ops with release hooked, so the body is
+	 * held for exactly as long.  The DMA-BUF is not visible to anyone
+	 * yet (vb2 installs the fd after this returns), and the DMA-BUF core
+	 * reads ->ops only through the pointer, never by identity.
+	 */
+	exp->inner_ops = dbuf->ops;
+	exp->ops = *dbuf->ops;
+	exp->ops.release = amvdec_cap_dmabuf_release;
+	exp->buf = buf;
+	refcount_inc(&buf->refcount);
+	/* the release hook is this module's code */
+	__module_get(THIS_MODULE);
+	dbuf->ops = &exp->ops;
+
+	return dbuf;
+}
+
+static void *amvdec_cap_attach_dmabuf(struct vb2_buffer *vb,
+				      struct device *dev,
+				      struct dma_buf *dbuf,
+				      unsigned long size)
+{
+	struct amvdec_cap_buf *buf;
+	void *inner;
+
+	inner = vb2_dma_contig_memops.attach_dmabuf(vb, dev, dbuf, size);
+	if (IS_ERR_OR_NULL(inner))
+		return inner;
+
+	buf = amvdec_cap_buf_wrap(inner, true);
+	if (!buf) {
+		vb2_dma_contig_memops.detach_dmabuf(inner);
+		return ERR_PTR(-ENOMEM);
+	}
+	return buf;
+}
+
+static void amvdec_cap_detach_dmabuf(void *buf_priv)
+{
+	struct amvdec_cap_buf *buf = buf_priv;
+
+	vb2_dma_contig_memops.detach_dmabuf(buf->inner);
+	buf->inner = NULL;
+	amvdec_cap_buf_put(buf);
+}
+
+static int amvdec_cap_map_dmabuf(void *buf_priv)
+{
+	struct amvdec_cap_buf *buf = buf_priv;
+
+	return vb2_dma_contig_memops.map_dmabuf(buf->inner);
+}
+
+static void amvdec_cap_unmap_dmabuf(void *buf_priv)
+{
+	struct amvdec_cap_buf *buf = buf_priv;
+
+	vb2_dma_contig_memops.unmap_dmabuf(buf->inner);
+}
+
+static void amvdec_cap_prepare(void *buf_priv)
+{
+	struct amvdec_cap_buf *buf = buf_priv;
+
+	if (vb2_dma_contig_memops.prepare)
+		vb2_dma_contig_memops.prepare(buf->inner);
+}
+
+static void amvdec_cap_finish(void *buf_priv)
+{
+	struct amvdec_cap_buf *buf = buf_priv;
+
+	if (vb2_dma_contig_memops.finish)
+		vb2_dma_contig_memops.finish(buf->inner);
+}
+
+static void *amvdec_cap_vaddr(struct vb2_buffer *vb, void *buf_priv)
+{
+	struct amvdec_cap_buf *buf = buf_priv;
+
+	return vb2_dma_contig_memops.vaddr(vb, buf->inner);
+}
+
+static void *amvdec_cap_cookie(struct vb2_buffer *vb, void *buf_priv)
+{
+	struct amvdec_cap_buf *buf = buf_priv;
+
+	return vb2_dma_contig_memops.cookie(vb, buf->inner);
+}
+
+static unsigned int amvdec_cap_num_users(void *buf_priv)
+{
+	struct amvdec_cap_buf *buf = buf_priv;
+
+	return vb2_dma_contig_memops.num_users(buf->inner);
+}
+
+static int amvdec_cap_mmap(void *buf_priv, struct vm_area_struct *vma)
+{
+	struct amvdec_cap_buf *buf = buf_priv;
+
+	/* A CPU mapping reaches the header only, never the body */
+	return vb2_dma_contig_memops.mmap(buf->inner, vma);
+}
+
+const struct vb2_mem_ops meson_amvdec_cap_memops = {
+	.alloc		= amvdec_cap_alloc,
+	.put		= amvdec_cap_put,
+	.get_dmabuf	= amvdec_cap_get_dmabuf,
+	.prepare	= amvdec_cap_prepare,
+	.finish		= amvdec_cap_finish,
+	.attach_dmabuf	= amvdec_cap_attach_dmabuf,
+	.detach_dmabuf	= amvdec_cap_detach_dmabuf,
+	.map_dmabuf	= amvdec_cap_map_dmabuf,
+	.unmap_dmabuf	= amvdec_cap_unmap_dmabuf,
+	.vaddr		= amvdec_cap_vaddr,
+	.cookie		= amvdec_cap_cookie,
+	.num_users	= amvdec_cap_num_users,
+	.mmap		= amvdec_cap_mmap,
+};
+
+static struct amvdec_cap_buf *amvdec_cap_buf_of(struct vb2_buffer *vb)
+{
+	if (vb->vb2_queue->mem_ops != &meson_amvdec_cap_memops ||
+	    vb->num_planes < 1)
+		return NULL;
+
+	return vb->planes[0].mem_priv;
+}
+
+/*
+ * Make @buf's body at least @nr_chunks long.  Existing chunks are kept in
+ * place (a displayed header may point into them); only the tail is added.
+ * On failure the body is left as it was.
+ */
+static int amvdec_cap_buf_grow(struct device *dev, struct amvdec_cap_buf *buf,
+			       u32 nr_chunks)
+{
+	struct fbc_chunk **chunks;
+	u32 i;
+
+	if (buf->nr_chunks >= nr_chunks)
+		return 0;
+
+	if (buf->dev && buf->dev != dev)
+		return -EINVAL;
+
+	chunks = kcalloc(nr_chunks, sizeof(*chunks), GFP_KERNEL);
+	if (!chunks)
+		return -ENOMEM;
+
+	for (i = buf->nr_chunks; i < nr_chunks; ++i) {
+		chunks[i] = fbc_chunk_alloc(dev);
+		if (!chunks[i]) {
+			while (i-- > buf->nr_chunks)
+				fbc_chunk_free(dev, chunks[i]);
+			kfree(chunks);
+			return -ENOMEM;
+		}
+	}
+
+	if (!buf->dev)
+		buf->dev = get_device(dev);
+	if (buf->nr_chunks)
+		memcpy(chunks, buf->chunks, buf->nr_chunks * sizeof(*chunks));
+	kfree(buf->chunks);
+	buf->chunks = chunks;
+	buf->nr_chunks = nr_chunks;
+	return 0;
+}
+
+/* Drop the codec's references on the CAPTURE memory it programmed. */
+static void codec_hevc_release_cap_bufs(struct codec_hevc_common *comm)
+{
+	u32 i;
+
+	for (i = 0; i < MAX_REF_PIC_NUM; ++i) {
+		if (!comm->cap_buf[i])
+			continue;
+		amvdec_cap_buf_put(comm->cap_buf[i]);
+		comm->cap_buf[i] = NULL;
+	}
+}
+
+/*
+ * Take the codec's reference on @vb's memory and give it an AM21C body of
+ * @nr_chunks.
+ */
+static int codec_hevc_hold_cap_buf(struct device *dev,
+				   struct codec_hevc_common *comm,
+				   struct vb2_buffer *vb, u32 nr_chunks)
+{
+	struct amvdec_cap_buf *buf = amvdec_cap_buf_of(vb);
+	u32 idx = vb->index;
+
+	if (!buf || buf->imported || idx >= MAX_REF_PIC_NUM)
+		return -EINVAL;
+
+	/* Never more than the frame MMU map can describe (18 MiB) */
+	if (nr_chunks > DIV_ROUND_UP(MMU_MAP_SIZE / sizeof(u32), FBC_CHUNK_PAGES))
+		return -EINVAL;
+
+	if (comm->cap_buf[idx] != buf) {
+		if (comm->cap_buf[idx])
+			amvdec_cap_buf_put(comm->cap_buf[idx]);
+		refcount_inc(&buf->refcount);
+		comm->cap_buf[idx] = buf;
+	}
+
+	return amvdec_cap_buf_grow(dev, buf, nr_chunks);
+}
+
+/* Chunks backing @vb's body, NULL if it has none the codec holds. */
+static struct fbc_chunk **codec_hevc_body_chunks(struct amvdec_session *sess,
+						 struct codec_hevc_common *comm,
+						 struct vb2_buffer *vb,
+						 u32 *nr_chunks)
+{
+	u32 idx = vb->index;
+
+	*nr_chunks = 0;
+	if (idx >= MAX_REF_PIC_NUM)
+		return NULL;
+
+	if (sess->pixfmt_cap == V4L2_PIX_FMT_AM21C) {
+		struct amvdec_cap_buf *buf = comm->cap_buf[idx];
+
+		/* only memory the codec holds a reference on */
+		if (!buf || buf != amvdec_cap_buf_of(vb))
+			return NULL;
+		*nr_chunks = buf->nr_chunks;
+		return buf->chunks;
+	}
+
+	*nr_chunks = comm->fbc_nr_chunks;
+	return comm->fbc_chunks[idx];
+}
+
+/*
+ * What the session's CAPTURE buffers need, including the open firmware's
+ * 8-bit compressed-reference mode (comm->dw8: FBC references + NV12 double
+ * write, i.e. the 10-bit downsample layout at 8 bits).
+ */
+static bool codec_hevc_comm_fbc(struct amvdec_session *sess, struct codec_hevc_common *comm,
+				int is_10bit)
+{
+	return codec_hevc_use_fbc(sess->pixfmt_cap, is_10bit) || comm->dw8;
+}
+
+static bool codec_hevc_comm_downsample(struct amvdec_session *sess,
+				       struct codec_hevc_common *comm, int is_10bit)
+{
+	return codec_hevc_use_downsample(sess->pixfmt_cap, is_10bit) || comm->dw8;
+}
+
+static bool codec_hevc_comm_mmu(struct amvdec_session *sess, struct codec_hevc_common *comm,
+				int is_10bit)
+{
+	u32 revision = sess->core->platform->revision;
+
+	return codec_hevc_use_mmu(revision, sess->pixfmt_cap, is_10bit) ||
+	       (comm->dw8 && revision >= AMVDEC_REVISION_G12A);
+}
+
+static u32 codec_hevc_body_nr_chunks(struct amvdec_session *sess,
+				     struct codec_hevc_common *comm, int is_10bit)
+{
+	u32 use_mmu = codec_hevc_comm_mmu(sess, comm, is_10bit);
+
+	return DIV_ROUND_UP(meson_amvdec_amfbc_body_size(sess->width,
+							 sess->height,
+							 is_10bit, use_mmu),
+			    FBC_CHUNK_SIZE);
+}
+
+dma_addr_t meson_amvdec_codec_hevc_fbc_body_addr(struct amvdec_session *sess,
+						 struct codec_hevc_common *comm,
+						 struct vb2_buffer *vb)
+{
+	struct fbc_chunk **chunks;
+	u32 nr;
+
+	/*
+	 * Vestigial in MMU mode - HEVCD_MPP_DECOMP_CTL2 is zeroed there and
+	 * the hardware walks the page map instead - but still programmed,
+	 * and codec_hevc_frame_buffer_backed() tests it for zero.  The
+	 * body's first page is the faithful answer.
+	 */
+	chunks = codec_hevc_body_chunks(sess, comm, vb, &nr);
+	if (chunks && nr && chunks[0])
+		return chunks[0]->dma[0];
+
+	if (vb->index >= MAX_REF_PIC_NUM)
+		return 0;
+	return comm->fbc_buffer_paddr[vb->index];
+}
+
+const u16 meson_amvdec_hevc_parser_cmd[] = {
+	0x0401,	0x8401,	0x0800,	0x0402,
+	0x9002,	0x1423,	0x8CC3,	0x1423,
+	0x8804,	0x9825,	0x0800,	0x04FE,
+	0x8406,	0x8411,	0x1800,	0x8408,
+	0x8409,	0x8C2A,	0x9C2B,	0x1C00,
+	0x840F,	0x8407,	0x8000,	0x8408,
+	0x2000,	0xA800,	0x8410,	0x04DE,
+	0x840C,	0x840D,	0xAC00,	0xA000,
+	0x08C0,	0x08E0,	0xA40E,	0xFC00,
+	0x7C00
+};
+
+static int codec_hevc_setup_buffers_gxbb(struct amvdec_session *sess,
+					 struct codec_hevc_common *comm,
+					 int is_10bit)
+{
+	struct amvdec_core *core = sess->core;
+	struct vb2_buffer *bufs[MAX_REF_PIC_NUM];
+	const bool fbc = codec_hevc_use_fbc(sess->pixfmt_cap, is_10bit);
+	dma_addr_t fill_y = 0, fill_uv = 0;
+	unsigned int idx, n;
+	u32 val;
+	int i;
+
+	/*
+	 * GXBB commands encode their slot number; repeating the last command
+	 * cannot fill the tail. Program every index, including allocated buffers
+	 * which are not currently queued. Use a real surface for unused slots.
+	 * Adapted from Christian Hewitt's chewitt/linux commit 7279a4a03e9c.
+	 */
+	n = codec_hevc_capture_buffers(sess, bufs);
+	if (!n)
+		return 0;
+	for (idx = 0; idx < n; idx++) {
+		if (!bufs[idx])
+			continue;
+		fill_y = fbc ? comm->fbc_buffer_paddr[idx] :
+			vb2_dma_contig_plane_dma_addr(bufs[idx], 0);
+		if (!fill_y)
+			continue;
+		if (!fbc)
+			fill_uv = vb2_dma_contig_plane_dma_addr(bufs[idx], 1);
+		break;
+	}
+	if (!fill_y)
+		return 0;
+
+	meson_amvdec_write_dos(core, HEVCD_MPP_ANC2AXI_TBL_CONF_ADDR, 0);
+	memset(comm->anc_y_paddr, 0, sizeof(comm->anc_y_paddr));
+
+	for (idx = 0; idx < MAX_REF_PIC_NUM; idx++) {
+		struct vb2_buffer *vb = idx < n ? bufs[idx] : NULL;
+		dma_addr_t buf_y_paddr = 0, buf_uv_paddr = 0;
+
+		if (vb && fbc) {
+			buf_y_paddr = comm->fbc_buffer_paddr[idx];
+		} else if (vb) {
+			buf_y_paddr = vb2_dma_contig_plane_dma_addr(vb, 0);
+			buf_uv_paddr = vb2_dma_contig_plane_dma_addr(vb, 1);
+		}
+		if (!buf_y_paddr) {
+			buf_y_paddr = fill_y;
+			buf_uv_paddr = fill_uv;
+		}
+		/* Only address bits 31:16 survive the command encoding. */
+		if ((buf_y_paddr | buf_uv_paddr) & (SZ_64K - 1)) {
+			dev_err_ratelimited(core->dev,
+					    "CAPTURE buffer %u planes %pad/%pad not 64 KiB aligned\n",
+				idx, &buf_y_paddr, &buf_uv_paddr);
+			memset(comm->anc_y_paddr, 0, sizeof(comm->anc_y_paddr));
+			return -EINVAL;
+		}
+		comm->anc_y_paddr[idx] = buf_y_paddr;
+
+		if (fbc) {
+			val = buf_y_paddr | (idx << 8) | 1;
+			meson_amvdec_write_dos(core, HEVCD_MPP_ANC2AXI_TBL_CMD_ADDR,
+					 val);
+		} else {
+			val = buf_y_paddr | ((idx * 2) << 8) | 1;
+			meson_amvdec_write_dos(core, HEVCD_MPP_ANC2AXI_TBL_CMD_ADDR,
+					 val);
+			val = buf_uv_paddr | ((idx * 2 + 1) << 8) | 1;
+			meson_amvdec_write_dos(core, HEVCD_MPP_ANC2AXI_TBL_CMD_ADDR,
+					 val);
+		}
+	}
+
+	meson_amvdec_write_dos(core, HEVCD_MPP_ANC2AXI_TBL_CONF_ADDR, 1);
+	meson_amvdec_write_dos(core, HEVCD_MPP_ANC_CANVAS_ACCCONFIG_ADDR, 1);
+	for (i = 0; i < 32; ++i)
+		meson_amvdec_write_dos(core, HEVCD_MPP_ANC_CANVAS_DATA_ADDR, 0);
+	return 0;
+}
+
+static void codec_hevc_setup_buffers_gxl(struct amvdec_session *sess,
+					 struct codec_hevc_common *comm,
+					 int is_10bit)
+{
+	struct amvdec_core *core = sess->core;
+	struct vb2_buffer *bufs[MAX_REF_PIC_NUM];
+	const bool fbc = codec_hevc_comm_fbc(sess, comm, is_10bit);
+	dma_addr_t fill_y = 0, fill_uv = 0;
+	unsigned int idx, n;
+	int i;
+
+	/*
+	 * The ANC2AXI table auto-increments from slot 0, and the reference
+	 * lists address it by vb2_buf.index (index*2 / index*2+1 for the
+	 * two-plane formats).  So it must be written densely, one slot per
+	 * index, exactly as the vendor driver does over MAX_REF_PIC_NUM -
+	 * not one slot per queued buffer in queue order, which scrambles
+	 * every slot after the first buffer that happens to be absent.
+	 *
+	 * A slot with no buffer behind it is never referenced by a correct
+	 * decode; point it at a real buffer anyway so that a corrupt
+	 * reference reads valid memory instead of address zero.
+	 */
+	n = codec_hevc_capture_buffers(sess, bufs);
+	if (!n)
+		return;
+	dev_dbg(core->dev, "setup %ux%u nbuf=%u 10bit=%d fbc=%d\n",
+		sess->width, sess->height, n, is_10bit, fbc);
+
+	meson_amvdec_write_dos(core, HEVCD_MPP_ANC2AXI_TBL_CONF_ADDR,
+			 BIT(2) | BIT(1));
+	memset(comm->anc_y_paddr, 0, sizeof(comm->anc_y_paddr));
+
+	for (idx = 0; idx < n; idx++) {
+		struct vb2_buffer *vb = bufs[idx];
+		dma_addr_t buf_y_paddr, buf_uv_paddr = 0;
+
+		if (vb) {
+			if (codec_hevc_comm_downsample(sess, comm, is_10bit)) {
+				if (codec_hevc_comm_mmu(sess, comm, is_10bit))
+					buf_y_paddr = comm->mmu_header_paddr[idx];
+				else
+					buf_y_paddr = comm->fbc_buffer_paddr[idx];
+			} else {
+				buf_y_paddr = vb2_dma_contig_plane_dma_addr(vb, 0);
+			}
+			if (!fbc)
+				buf_uv_paddr =
+					vb2_dma_contig_plane_dma_addr(vb, 1);
+
+			comm->anc_y_paddr[idx] = buf_y_paddr;
+			if (!fill_y && buf_y_paddr) {
+				fill_y = buf_y_paddr;
+				fill_uv = buf_uv_paddr;
+			}
+		}
+
+		if (!vb || !buf_y_paddr) {
+			buf_y_paddr = fill_y;
+			buf_uv_paddr = fill_uv;
+		}
+
+		meson_amvdec_write_dos(core, HEVCD_MPP_ANC2AXI_TBL_DATA,
+				 buf_y_paddr >> 5);
+		if (!fbc)
+			meson_amvdec_write_dos(core, HEVCD_MPP_ANC2AXI_TBL_DATA,
+					 buf_uv_paddr >> 5);
+	}
+
+	meson_amvdec_write_dos(core, HEVCD_MPP_ANC2AXI_TBL_CONF_ADDR, 1);
+	meson_amvdec_write_dos(core, HEVCD_MPP_ANC_CANVAS_ACCCONFIG_ADDR, 1);
+	for (i = 0; i < 32; ++i)
+		meson_amvdec_write_dos(core, HEVCD_MPP_ANC_CANVAS_DATA_ADDR, 0);
+}
+
+static void meson_amvdec_codec_hevc_free_mmu_headers(struct amvdec_session *sess,
+				 struct codec_hevc_common *comm)
+{
+	struct device *dev = sess->core->dev;
+	int i;
+
+	for (i = 0; i < MAX_REF_PIC_NUM; ++i) {
+		if (comm->mmu_header_vaddr[i]) {
+			meson_amvdec_dma_free_guarded(dev, comm->mmu_header_paddr[i],
+						&comm->mmu_header_guard[i]);
+			comm->mmu_header_vaddr[i] = NULL;
+			comm->mmu_header_paddr[i] = 0;
+		}
+	}
+}
+
+/*
+ * Collect the session's CAPTURE buffers, by index.
+ *
+ * Everything that programs a per-buffer resource - FBC bodies, MMU
+ * headers, the ANC2AXI canvas table - used to walk only the buffers
+ * QUEUED to the driver at that moment.  The canvas table is indexed by
+ * vb2_buf.index (the HEVC and VP9 reference lists write
+ * ref->vbuf->vb2_buf.index as the canvas id), so a walk over a queue
+ * with a gap in it lands every later buffer in the wrong slot.  The
+ * old rule that every buffer be queued before streaming hid that; a
+ * zero-copy client that keeps frames on the display across a seek
+ * breaks it, and then either deadlocks (if start is refused) or
+ * decodes against scrambled references (if it is not).
+ *
+ * An MMAP buffer has a valid DMA address from allocation, queued or
+ * not, so take every allocated buffer.  An imported DMABUF is mapped
+ * only while queued, so for those keep the queued-only walk.
+ *
+ * Fills bufs[] by index (NULL for an index with no buffer) and returns
+ * one past the highest index present, or 0 if there are none.
+ */
+static unsigned int
+codec_hevc_capture_buffers(struct amvdec_session *sess,
+			   struct vb2_buffer *bufs[MAX_REF_PIC_NUM])
+{
+	struct vb2_queue *q = v4l2_m2m_get_dst_vq(sess->m2m_ctx);
+	struct v4l2_m2m_buffer *buf;
+	unsigned int n = 0;
+	unsigned int i;
+
+	memset(bufs, 0, sizeof(*bufs) * MAX_REF_PIC_NUM);
+
+	if (q->memory == VB2_MEMORY_MMAP) {
+		for (i = 0; i < MAX_REF_PIC_NUM; i++) {
+			struct vb2_buffer *vb = vb2_get_buffer(q, i);
+			unsigned int p;
+
+			if (!vb)
+				continue;
+			/*
+			 * CREATE_BUFS publishes a buffer in the queue before it
+			 * allocates its planes, and the client calls it while
+			 * pictures are being decoded.  A buffer without memory
+			 * has no address to map yet and cannot be in use.
+			 */
+			for (p = 0; p < vb->num_planes; p++)
+				if (!READ_ONCE(vb->planes[p].mem_priv))
+					break;
+			if (p < vb->num_planes)
+				continue;
+			bufs[i] = vb;
+			n = i + 1;
+		}
+		return n;
+	}
+
+	v4l2_m2m_for_each_dst_buf(sess->m2m_ctx, buf) {
+		struct vb2_buffer *vb = &buf->vb.vb2_buf;
+
+		if (vb->index >= MAX_REF_PIC_NUM)
+			continue;
+		bufs[vb->index] = vb;
+		if (vb->index + 1 > n)
+			n = vb->index + 1;
+	}
+	if (meson_amvdec_request_jobs(sess)) {
+		/* The job and its references are no longer on the ready queue. */
+		for (i = 0; i <= ARRAY_SIZE(sess->request_job.refs); i++) {
+			struct vb2_buffer *vb = i == ARRAY_SIZE(sess->request_job.refs) ?
+				(sess->request_job.dst ? &sess->request_job.dst->vb2_buf : NULL) :
+				sess->request_job.refs[i];
+			if (!vb || vb->index >= MAX_REF_PIC_NUM)
+				continue;
+			bufs[vb->index] = vb;
+			n = max(n, vb->index + 1);
+		}
+	}
+	return n;
+}
+
+static int codec_hevc_alloc_mmu_headers(struct amvdec_session *sess,
+					struct codec_hevc_common *comm)
+{
+	struct device *dev = sess->core->dev;
+	struct vb2_buffer *bufs[MAX_REF_PIC_NUM];
+	unsigned int idx, n;
+
+	n = codec_hevc_capture_buffers(sess, bufs);
+	for (idx = 0; idx < n; idx++) {
+		dma_addr_t paddr;
+		void *vaddr;
+
+		/* Per-index: resume() runs more than once per session */
+		if (!bufs[idx] || comm->mmu_header_vaddr[idx])
+			continue;
+
+		/* Handled: failure frees what was taken and returns -ENOMEM. */
+		vaddr = meson_amvdec_dma_alloc_guarded(dev, MMU_COMPRESS_HEADER_SIZE,
+						 &paddr, GFP_KERNEL | __GFP_NOWARN,
+							&comm->mmu_header_guard[idx]);
+		if (!vaddr) {
+			meson_amvdec_codec_hevc_free_mmu_headers(sess, comm);
+			return -ENOMEM;
+		}
+
+		comm->mmu_header_vaddr[idx] = vaddr;
+		comm->mmu_header_paddr[idx] = paddr;
+	}
+
+	return 0;
+}
+
+/* Free the decoder-private (downsample) bodies.  The decoder is idle. */
+static void codec_hevc_free_private_bodies(struct device *dev,
+					   struct codec_hevc_common *comm)
+{
+	u32 i;
+
+	for (i = 0; i < MAX_REF_PIC_NUM; ++i) {
+		fbc_chunks_free(dev, comm->fbc_chunks[i], comm->fbc_nr_chunks);
+		comm->fbc_chunks[i] = NULL;
+	}
+	comm->fbc_nr_chunks = 0;
+}
+
+void meson_amvdec_codec_hevc_free_fbc_buffers(struct amvdec_session *sess,
+				 struct codec_hevc_common *comm)
+{
+	struct device *dev = sess->core->dev;
+	int i;
+
+	/*
+	 * Called with the decoder stopped.  Downsample bodies are private
+	 * scratch - the display only ever sees the NV12M planes - so they
+	 * go straight back.  AM21C bodies are not ours to free: dropping the
+	 * codec's reference leaves them to the CAPTURE memory and any
+	 * DMA-BUF the display still holds (see struct amvdec_cap_buf).
+	 */
+	codec_hevc_free_private_bodies(dev, comm);
+	codec_hevc_release_cap_bufs(comm);
+
+	/* Non-MMU FBC bodies are contiguous and privately owned */
+	for (i = 0; i < MAX_REF_PIC_NUM; ++i) {
+		if (!comm->fbc_buffer_vaddr[i])
+			continue;
+		meson_amvdec_dma_free_guarded(dev, comm->fbc_buffer_paddr[i],
+					&comm->fbc_buffer_guard[i]);
+		comm->fbc_buffer_vaddr[i] = NULL;
+		comm->fbc_buffer_paddr[i] = 0;
+	}
+
+	if (comm->mmu_map_vaddr) {
+		meson_amvdec_dma_free_guarded(dev, comm->mmu_map_paddr,
+					&comm->mmu_map_guard);
+		comm->mmu_map_vaddr = NULL;
+		comm->mmu_map_paddr = 0;
+	}
+
+	meson_amvdec_codec_hevc_free_mmu_headers(sess, comm);
+}
+
+static int codec_hevc_alloc_fbc_buffers(struct amvdec_session *sess,
+					struct codec_hevc_common *comm,
+					int codec_10bit)
+{
+	struct device *dev = sess->core->dev;
+	struct vb2_buffer *bufs[MAX_REF_PIC_NUM];
+	unsigned int idx, n;
+	u32 use_mmu;
+	u32 am21_size;
+	u32 nr_chunks;
+	const u32 is_10bit = sess->bitdepth == 10 ? 1 : 0;
+	int ret;
+
+	use_mmu = codec_hevc_comm_mmu(sess, comm, is_10bit);
+
+	am21_size = meson_amvdec_amfbc_size(sess->width, sess->height, is_10bit,
+				      use_mmu);
+	comm->fbc_buffer_size = am21_size;
+
+	n = codec_hevc_capture_buffers(sess, bufs);
+
+	if (!use_mmu) {
+		/* Contiguous body, allocated per index and privately owned */
+		for (idx = 0; idx < n; idx++) {
+			dma_addr_t paddr;
+			void *vaddr;
+
+			if (!bufs[idx] || comm->fbc_buffer_vaddr[idx])
+				continue;
+
+			vaddr = meson_amvdec_dma_alloc_guarded(dev, am21_size, &paddr,
+							 GFP_KERNEL | __GFP_NOWARN,
+							&comm->fbc_buffer_guard[idx]);
+			if (!vaddr) {
+				dev_err_ratelimited(dev,
+					"Failed to allocate %u-byte FBC reference %u of %u\n",
+					am21_size, idx, n);
+				meson_amvdec_codec_hevc_free_fbc_buffers(sess, comm);
+				return -ENOMEM;
+			}
+
+			comm->fbc_buffer_vaddr[idx] = vaddr;
+			comm->fbc_buffer_paddr[idx] = paddr;
+		}
+
+		return 0;
+	}
+
+	/*
+	 * MMU mode: the body is described page by page in the frame map, so
+	 * assemble it from chunks - no large contiguous range needed.
+	 */
+	nr_chunks = codec_hevc_body_nr_chunks(sess, comm, is_10bit);
+
+	if (!codec_hevc_comm_downsample(sess, comm, is_10bit)) {
+		/*
+		 * Sized from the depth the codec programs, which is also what
+		 * codec_hevc_frame_buffer_backed() and fill_mmu_map() check.
+		 */
+		nr_chunks = max(nr_chunks,
+				codec_hevc_body_nr_chunks(sess, comm, codec_10bit));
+
+		/*
+		 * AM21C: the body belongs to the CAPTURE buffer's memory.
+		 * Per-index and idempotent - recovery re-runs setup, and
+		 * players grow the CAPTURE queue after the first resolution
+		 * event.  A failure leaves every other buffer's body alone
+		 * (they may be on screen) and fails only the frames that
+		 * would have used this one.
+		 */
+		for (idx = 0; idx < n; idx++) {
+			if (!bufs[idx])
+				continue;
+			ret = codec_hevc_hold_cap_buf(dev, comm, bufs[idx],
+						      nr_chunks);
+			if (ret) {
+				dev_err_ratelimited(dev,
+						    "Failed to give CAPTURE buffer %u an FBC body (%u chunks): %d\n",
+						    idx, nr_chunks, ret);
+				return ret;
+			}
+		}
+		return 0;
+	}
+
+	/*
+	 * Downsampling: the body is decoder-private.  A geometry change
+	 * happens between pictures, with the decoder idle and the old
+	 * bodies unreachable by the display, so re-take them outright.
+	 */
+	if (comm->fbc_nr_chunks && comm->fbc_nr_chunks != nr_chunks)
+		codec_hevc_free_private_bodies(dev, comm);
+	comm->fbc_nr_chunks = nr_chunks;
+
+	for (idx = 0; idx < n; idx++) {
+		u32 i;
+
+		if (!bufs[idx])
+			continue;
+
+		/*
+		 * Per-index idempotency: recovery re-runs and staged buffer
+		 * negotiation (players may grow the CAPTURE queue after the
+		 * first resolution event) must fill in exactly the missing
+		 * bodies - an all-or-nothing guard left grown buffers
+		 * bodyless (map entries pointing nowhere = confetti frames).
+		 */
+		if (comm->fbc_chunks[idx])
+			continue;
+
+		comm->fbc_chunks[idx] = kcalloc(nr_chunks,
+						sizeof(*comm->fbc_chunks[idx]),
+						GFP_KERNEL);
+		if (!comm->fbc_chunks[idx]) {
+			meson_amvdec_codec_hevc_free_fbc_buffers(sess, comm);
+			return -ENOMEM;
+		}
+
+		/* No fallback when memory is exhausted: a clean -ENOMEM. */
+		for (i = 0; i < nr_chunks; ++i) {
+			comm->fbc_chunks[idx][i] = fbc_chunk_alloc(dev);
+			if (!comm->fbc_chunks[idx][i])
+				break;
+		}
+
+		if (i < nr_chunks) {
+			dev_err(dev, "Failed to assemble FBC body %u (%u/%u chunks)\n",
+				idx, i, nr_chunks);
+			meson_amvdec_codec_hevc_free_fbc_buffers(sess, comm);
+			return -ENOMEM;
+		}
+	}
+
+	ret = codec_hevc_alloc_mmu_headers(sess, comm);
+	if (ret) {
+		meson_amvdec_codec_hevc_free_fbc_buffers(sess, comm);
+		return ret;
+	}
+
+	return 0;
+}
+
+static int meson_amvdec_codec_hevc_setup_buffers(struct amvdec_session *sess,
+			     struct codec_hevc_common *comm,
+			     int is_10bit)
+{
+	struct amvdec_core *core = sess->core;
+	struct device *dev = core->dev;
+	int ret;
+
+	/* resume() may run more than once per session - allocate only once */
+	if (codec_hevc_comm_mmu(sess, comm, is_10bit) && !comm->dw8 &&
+	    !comm->mmu_map_vaddr) {
+		comm->mmu_map_vaddr = meson_amvdec_dma_alloc_guarded(dev, MMU_MAP_SIZE,
+							       &comm->mmu_map_paddr,
+									GFP_KERNEL,
+									&comm->mmu_map_guard);
+		if (!comm->mmu_map_vaddr)
+			return -ENOMEM;
+	}
+
+	if (codec_hevc_comm_mmu(sess, comm, is_10bit) ||
+	    codec_hevc_comm_downsample(sess, comm, is_10bit)) {
+		ret = codec_hevc_alloc_fbc_buffers(sess, comm, is_10bit);
+		if (ret)
+			return ret;
+	}
+
+	if (core->platform->revision == AMVDEC_REVISION_GXBB)
+		return codec_hevc_setup_buffers_gxbb(sess, comm, is_10bit);
+
+	codec_hevc_setup_buffers_gxl(sess, comm, is_10bit);
+	return 0;
+}
+
+static bool codec_hevc_frame_buffer_backed(struct amvdec_session *sess,
+					   struct codec_hevc_common *comm,
+					   struct vb2_buffer *vb, int is_10bit)
+{
+	u32 idx = vb->index;
+
+	if (!codec_hevc_comm_fbc(sess, comm, is_10bit))
+		return true;	/* plain NV12: the vb2 planes are the frame */
+
+	if (codec_hevc_comm_mmu(sess, comm, is_10bit)) {
+		u32 nr;
+
+		if (codec_hevc_comm_downsample(sess, comm, is_10bit) &&
+		    !comm->mmu_header_paddr[idx])
+			return false;
+
+		/*
+		 * The body must cover the current picture: an AM21C body
+		 * sized for an earlier, smaller picture is grown by setup.
+		 */
+		if (!codec_hevc_body_chunks(sess, comm, vb, &nr) ||
+		    nr < codec_hevc_body_nr_chunks(sess, comm, is_10bit))
+			return false;
+	}
+
+	return meson_amvdec_codec_hevc_fbc_body_addr(sess, comm, vb) != 0;
+}
+
+/* The luma address the ANC2AXI slot of @vb must hold for this session. */
+static dma_addr_t codec_hevc_anc_y_addr(struct amvdec_session *sess,
+					struct codec_hevc_common *comm,
+					struct vb2_buffer *vb, int is_10bit)
+{
+	const u32 revision = sess->core->platform->revision;
+	u32 idx = vb->index;
+
+	if (revision == AMVDEC_REVISION_GXBB)
+		return codec_hevc_use_fbc(sess->pixfmt_cap, is_10bit) ?
+			comm->fbc_buffer_paddr[idx] :
+			vb2_dma_contig_plane_dma_addr(vb, 0);
+
+	if (!codec_hevc_comm_downsample(sess, comm, is_10bit))
+		return vb2_dma_contig_plane_dma_addr(vb, 0);
+
+	return codec_hevc_comm_mmu(sess, comm, is_10bit) ?
+		comm->mmu_header_paddr[idx] : comm->fbc_buffer_paddr[idx];
+}
+
+/*
+ * True when meson_amvdec_codec_hevc_ensure_frame_buffer() has nothing to do
+ * for @vb (no allocation, no register write): the open VP9 pipeline calls it
+ * while another frame decodes only then.
+ */
+bool meson_amvdec_codec_hevc_frame_buffer_ready(struct amvdec_session *sess,
+						struct codec_hevc_common *comm,
+						struct vb2_buffer *vb, int is_10bit)
+{
+	u32 idx = vb->index;
+
+	return idx < MAX_REF_PIC_NUM &&
+	       codec_hevc_frame_buffer_backed(sess, comm, vb, is_10bit) &&
+	       comm->anc_y_paddr[idx] &&
+	       comm->anc_y_paddr[idx] == codec_hevc_anc_y_addr(sess, comm, vb, is_10bit);
+}
+
+int meson_amvdec_codec_hevc_ensure_frame_buffer(struct amvdec_session *sess,
+				   struct codec_hevc_common *comm,
+				   struct vb2_buffer *vb, int is_10bit)
+{
+	u32 idx = vb->index;
+
+	if (idx >= MAX_REF_PIC_NUM)
+		return -EINVAL;
+
+	if (meson_amvdec_codec_hevc_frame_buffer_ready(sess, comm, vb, is_10bit))
+		return 0;
+
+	/*
+	 * A buffer that was not allocated when the session was set up -
+	 * queued late, or added with CREATE_BUFS.  Setup is per-index
+	 * idempotent, so run it again for the ones that are missing.
+	 */
+	if (meson_amvdec_codec_hevc_setup_buffers(sess, comm, is_10bit) ||
+	    !codec_hevc_frame_buffer_backed(sess, comm, vb, is_10bit) ||
+	    !comm->anc_y_paddr[idx] ||
+	    comm->anc_y_paddr[idx] != codec_hevc_anc_y_addr(sess, comm, vb, is_10bit)) {
+		dev_err_ratelimited(sess->core->dev,
+				    "CAPTURE buffer %u has no decoder mapping - dropping frame\n",
+				    idx);
+		return -ENOMEM;
+	}
+
+	return 0;
+}
+
+/*
+ * The SAO-MMU map of @vb's body written to @mmu_map (MMU_MAP_SIZE bytes):
+ * the open firmware (codec_hevc.c) keeps its map in its own workspace.
+ */
+int meson_amvdec_codec_hevc_fill_mmu_map_at(struct amvdec_session *sess,
+					    struct codec_hevc_common *comm,
+					    struct vb2_buffer *vb,
+					    u32 is_10bit, u32 *mmu_map)
+{
+	u32 use_mmu;
+	u32 body_size;
+	u32 nb_pages;
+	struct fbc_chunk **chunks;
+	u32 nr_chunks;
+	u32 i;
+
+	if (vb->index >= MAX_REF_PIC_NUM || !mmu_map)
+		return -EINVAL;
+
+	use_mmu = codec_hevc_comm_mmu(sess, comm, is_10bit);
+	if (!use_mmu)
+		return 0;
+
+	/*
+	 * Only the compressed body is mapped; the header lives in its own
+	 * buffer (the vb2 plane in AM21C mode, a private allocation when
+	 * downsampling).  This matches the vendor's page count.
+	 */
+	body_size = meson_amvdec_amfbc_body_size(sess->width, sess->height,
+					   is_10bit, use_mmu);
+	nb_pages = DIV_ROUND_UP(body_size, PAGE_SIZE);
+
+	if (nb_pages > MMU_MAP_SIZE / sizeof(u32)) {
+		/*
+		 * The map covers up to 4608 4K pages (18 MiB of FBC body);
+		 * 4Kx2K 10-bit needs 4080.  Anything bigger cannot be
+		 * described, so refuse the frame rather than handing the
+		 * firmware a truncated map and letting later pages escape.
+		 */
+		dev_err_ratelimited(sess->core->dev,
+				    "FBC buffer (%u pages) exceeds MMU map capacity\n",
+				    nb_pages);
+		return -EINVAL;
+	}
+
+	chunks = codec_hevc_body_chunks(sess, comm, vb, &nr_chunks);
+	if (chunks) {
+		for (i = 0; i < nb_pages; ++i) {
+			u32 ci = i / FBC_CHUNK_PAGES;
+			struct fbc_chunk *c;
+
+			/*
+			 * nb_pages and the body's chunk count are derived from the
+			 * session geometry at two different times.  If they
+			 * ever disagree, this walks off the chunk array and
+			 * programs whatever it finds as a page frame number -
+			 * and the decoder then DMAs into that physical
+			 * address.  The damage lands in whatever owns that
+			 * memory, arbitrarily far from this driver, so fail
+			 * the frame instead.
+			 */
+			if (ci >= nr_chunks) {
+				dev_err_ratelimited(sess->core->dev,
+						    "FBC chunk %u >= %u (nb_pages %u, buf %u) - refusing to map\n",
+					ci, nr_chunks, nb_pages,
+					vb->index);
+				return -EINVAL;
+			}
+
+			c = chunks[ci];
+			if (!c) {
+				dev_err_ratelimited(sess->core->dev,
+						    "FBC chunk %u of buffer %u is NULL - refusing to map\n",
+					ci, vb->index);
+				return -EINVAL;
+			}
+
+			mmu_map[i] = c->dma[i % FBC_CHUNK_PAGES] >> PAGE_SHIFT;
+		}
+	} else {
+		u32 first_page =
+			comm->fbc_buffer_paddr[vb->index] >> PAGE_SHIFT;
+
+		if (!first_page)
+			return -EINVAL;
+
+		for (i = 0; i < nb_pages; ++i)
+			mmu_map[i] = first_page + i;
+	}
+
+	return 0;
+}
diff --speed-large-files --no-dereference --minimal -Naur linux-7.2.8/drivers/media/platform/amlogic/amvdec/codec_hevc_common.h linux-7.2.8/drivers/media/platform/amlogic/amvdec/codec_hevc_common.h
--- linux-7.2.8/drivers/media/platform/amlogic/amvdec/codec_hevc_common.h	1970-01-01 01:00:00.000000000 +0100
+++ linux-7.2.8/drivers/media/platform/amlogic/amvdec/codec_hevc_common.h	2026-10-02 08:55:53.000000000 +0200
@@ -0,0 +1,135 @@
+/* SPDX-License-Identifier: GPL-2.0+ */
+/*
+ * Copyright (C) 2018 BayLibre, SAS
+ * Author: Maxime Jourdan <mjourdan@baylibre.com>
+ * Copyright (C) 2026 Christian Hewitt <christianshewitt@gmail.com>
+ *
+ * HEVC and VP9 capture backing and framebuffer compression.
+ */
+
+#ifndef __MESON_AMVDEC_HEVC_COMMON_H_
+#define __MESON_AMVDEC_HEVC_COMMON_H_
+
+#include "amvdec.h"
+
+#define PARSER_CMD_SKIP_CFG_0 0x0000090b
+#define PARSER_CMD_SKIP_CFG_1 0x1b14140f
+#define PARSER_CMD_SKIP_CFG_2 0x001b1910
+
+#define VDEC_HEVC_PARSER_CMD_LEN 37
+extern const u16 meson_amvdec_hevc_parser_cmd[VDEC_HEVC_PARSER_CMD_LEN];
+
+#define MAX_REF_PIC_NUM	24
+
+struct fbc_chunk;
+struct amvdec_cap_buf;
+
+/*
+ * vb2 memory ops for the CAPTURE queue: vb2-dma-contig, with the AM21C
+ * compressed body tied to the lifetime of the plane and of every DMA-BUF
+ * exported from it.
+ */
+extern const struct vb2_mem_ops meson_amvdec_cap_memops;
+
+struct codec_hevc_common {
+	/*
+	 * Non-MMU FBC (pre-G12A): the compressed body must be physically
+	 * contiguous because the hardware strides through it directly.
+	 */
+	void      *fbc_buffer_vaddr[MAX_REF_PIC_NUM];
+	dma_addr_t fbc_buffer_paddr[MAX_REF_PIC_NUM];
+	struct amvdec_dma_guard fbc_buffer_guard[MAX_REF_PIC_NUM];
+
+	/*
+	 * MMU FBC (G12A+): the body is reached only through the per-frame
+	 * page map, so it needs no contiguity at all - it is assembled
+	 * from fixed-size chunks.  When downsampling, the body is private
+	 * to the decoder and held here.
+	 */
+	struct fbc_chunk **fbc_chunks[MAX_REF_PIC_NUM];
+	u32        fbc_nr_chunks;
+
+	/*
+	 * AM21C: the body belongs to the CAPTURE buffer's memory, which the
+	 * display may keep scanning after the codec is gone.  The codec
+	 * holds a reference on each buffer's memory it has programmed,
+	 * dropped in meson_amvdec_codec_hevc_free_fbc_buffers().
+	 */
+	struct amvdec_cap_buf *cap_buf[MAX_REF_PIC_NUM];
+	/* size the fbc buffers were allocated with - used to free them
+	 * correctly if the session dimensions changed in between
+	 */
+	u32        fbc_buffer_size;
+
+	void      *mmu_header_vaddr[MAX_REF_PIC_NUM];
+	dma_addr_t mmu_header_paddr[MAX_REF_PIC_NUM];
+	struct amvdec_dma_guard mmu_header_guard[MAX_REF_PIC_NUM];
+
+	/*
+	 * Luma address last written to each ANC2AXI slot, 0 when the slot
+	 * holds a filler.  CAPTURE buffers created after the session was set
+	 * up (CREATE_BUFS, or a client that grows its pool) have no slot until
+	 * the table is written again; decoding into one sends the picture to
+	 * whatever address the slot happens to hold.
+	 */
+	dma_addr_t anc_y_paddr[MAX_REF_PIC_NUM];
+
+	void      *mmu_map_vaddr;
+	dma_addr_t mmu_map_paddr;
+	struct amvdec_dma_guard mmu_map_guard;
+
+	/*
+	 * Open HEVC firmware (codec_hevc.c hevc_open_fbc8): 8-bit decoded into
+	 * NV12M through compressed references - the Main 10 downsample
+	 * machinery (private MMU-mode headers and bodies, NV12 double write)
+	 * at 8 bits.  Set only on G12A/SM1 for an NV12M CAPTURE queue by the
+	 * open path, never by the vendor path.
+	 */
+	bool       dw8;
+};
+
+/* Returns 1 if we must use framebuffer compression */
+static inline int codec_hevc_use_fbc(u32 pixfmt, int is_10bit)
+{
+	return is_10bit || pixfmt == V4L2_PIX_FMT_AM21C;
+}
+
+/* Returns 1 if we are decoding 10-bit but outputting 8-bit NV12 */
+static inline int codec_hevc_use_downsample(u32 pixfmt, int is_10bit)
+{
+	return is_10bit && pixfmt != V4L2_PIX_FMT_AM21C;
+}
+
+/* Returns 1 if we are decoding using the IOMMU */
+static inline int codec_hevc_use_mmu(u32 revision, u32 pixfmt, int is_10bit)
+{
+	return revision >= AMVDEC_REVISION_G12A &&
+	       codec_hevc_use_fbc(pixfmt, is_10bit);
+}
+
+/* Base address of a frame's compressed body, whichever backing is in use */
+dma_addr_t meson_amvdec_codec_hevc_fbc_body_addr(struct amvdec_session *sess,
+						 struct codec_hevc_common *comm,
+						 struct vb2_buffer *vb);
+void meson_amvdec_codec_hevc_free_fbc_buffers(struct amvdec_session *sess,
+				 struct codec_hevc_common *comm);
+
+/*
+ * Make sure a CAPTURE buffer about to receive a frame has the per-buffer
+ * backing the decode head will be pointed at.  Returns 0, or -ENOMEM if it
+ * could not be provided - in which case the frame must be dropped rather
+ * than decoded into address zero.
+ */
+bool meson_amvdec_codec_hevc_frame_buffer_ready(struct amvdec_session *sess,
+						struct codec_hevc_common *comm,
+						struct vb2_buffer *vb, int is_10bit);
+int meson_amvdec_codec_hevc_ensure_frame_buffer(struct amvdec_session *sess,
+				   struct codec_hevc_common *comm,
+				   struct vb2_buffer *vb, int is_10bit);
+
+int meson_amvdec_codec_hevc_fill_mmu_map_at(struct amvdec_session *sess,
+					    struct codec_hevc_common *comm,
+					    struct vb2_buffer *vb,
+					    u32 is_10bit, u32 *mmu_map);
+
+#endif
