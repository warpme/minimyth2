+/*
+ * Live dump of hevc_reglist.  Only possible while the HEVC domain is up,
+ * which outside a run means a failed stop left it up (hevc_state 2).
+ */
+static ssize_t ah_regs_read(struct file *file, char __user *ubuf, size_t count, loff_t *ppos)
+{
+	struct amvdec_core *core = at_core;
+	char *buf;
+	int n = 0, i;
+
+	if (!core)
+		return -ENODEV;
+	buf = kmalloc(AT_MAX_REGS * 16 + 16, GFP_KERNEL);
+	if (!buf)
+		return -ENOMEM;
+	mutex_lock(&at_lock);
+	if (!ah_powered) {
+		mutex_unlock(&at_lock);
+		kfree(buf);
+		return -EIO;
+	}
+	for (i = 0; i < ah_nregs; i++)
+		n += scnprintf(buf + n, AT_MAX_REGS * 16 - n, "%03x=%08x%s", ah_reglist[i],
+			       ah_read(core, AH_BASE + ah_reglist[i] * 4), (i % 8 == 7) ? "\n" : " ");
+	mutex_unlock(&at_lock);
+	n += scnprintf(buf + n, 16, "\n");
+	i = simple_read_from_buffer(ubuf, count, ppos, buf, n);
+	kfree(buf);
+	return i;
+}
+
+static const struct file_operations ah_regs_fops = {
+	.owner = THIS_MODULE,
+	.read = ah_regs_read,
+};
