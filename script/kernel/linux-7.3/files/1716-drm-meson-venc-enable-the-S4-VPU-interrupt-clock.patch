From b566effcc6a90e6a38226f568df7ce92c5430bfd Mon Sep 17 00:00:00 2001
From: Christian Hewitt <christianshewitt@gmail.com>
Date: Mon, 5 Oct 2026 05:10:39 +0000
Subject: [PATCH 230/269] drm/meson: venc: enable the S4 VPU interrupt clock

On S4 the VPU interrupt clock is bit 25 of CLKCTRL_SYS_CLK_EN0_REG2, as
on G12 where it is bit 25 of HHI_GCLK_MPEG2. Bit 4 is the HDMI TX APB
clock, which was being set instead.

Fixes: 00952e79eca4 ("drm/meson: add DRM support for S4 series SoCs")
Assisted-by: Claude:claude-opus-5-5
Signed-off-by: Christian Hewitt <christianshewitt@gmail.com>
---
 drivers/gpu/drm/meson/meson_venc.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/drivers/gpu/drm/meson/meson_venc.c b/drivers/gpu/drm/meson/meson_venc.c
index a89773af6..b265bc027 100644
--- a/drivers/gpu/drm/meson/meson_venc.c
+++ b/drivers/gpu/drm/meson/meson_venc.c
@@ -2314,7 +2314,7 @@ void meson_venc_enable_vsync(struct meson_drm *priv)
 	}
 
 	if (meson_vpu_is_compatible(priv, VPU_COMPATIBLE_S4))
-		regmap_update_bits(priv->clkctrl, CLKCTRL_SYS_CLK_EN0_REG2, BIT(4), BIT(4));
+		regmap_update_bits(priv->clkctrl, CLKCTRL_SYS_CLK_EN0_REG2, BIT(25), BIT(25));
 	else
 		regmap_update_bits(priv->hhi, HHI_GCLK_MPEG2, BIT(25), BIT(25));
 }
