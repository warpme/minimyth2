+static void codec_h264_dump_lmem(struct amvdec_session *sess,
+				 const char *tag, u32 status, u32 frame_status)
+{
+	struct codec_h264 *h264 = sess->priv;
+	const u16 *lmem = h264->lmem_vaddr;
+	u32 seq = h264->lmem_dump_seq++;
+	bool nonzero = false;
+	unsigned int i;
+
+	if (!READ_ONCE(h264_lmem_dump) || !lmem)
+		return;
+
+	for (i = 0; i < LMEM_DUMP_WORDS; i++) {
+		if (lmem[i]) {
+			nonzero = true;
+			break;
+		}
+	}
+
+	dev_dbg(sess->core->dev_dec,
+		 "H264_LMEM seq=%u tag=%s status=%08x frame_status=%08x paddr=%pad words=%u nonzero=%u\n",
+		 seq, tag, status, frame_status, &h264->lmem_paddr,
+		 LMEM_DUMP_WORDS, nonzero);
+	if (!nonzero && seq)
+		return;
+
+	for (i = 0; i < LMEM_DUMP_WORDS; i += 8)
+		dev_dbg(sess->core->dev_dec,
+			 "H264_LMEM seq=%u off=%03x %04x %04x %04x %04x %04x %04x %04x %04x\n",
+			 seq, i, lmem[i], lmem[i + 1], lmem[i + 2],
+			 lmem[i + 3], lmem[i + 4], lmem[i + 5],
+			 lmem[i + 6], lmem[i + 7]);
+}
+
+static u16 codec_h264_multi_lmem_word(const struct codec_h264 *h264, u32 i)
+{
+	const u16 *lmem = h264->lmem_vaddr;
+
+	return lmem[(i & ~3) + 3 - (i & 3)];
+}
