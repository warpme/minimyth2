diff --speed-large-files --no-dereference --minimal -Naur linux-7.3.1/drivers/tee/optee/smc_abi.c linux-7.3.1/drivers/tee/optee/smc_abi.c
--- linux-7.3.1/drivers/tee/optee/smc_abi.c	2026-11-06 11:08:30.047608639 +0100
+++ linux-7.3.1/drivers/tee/optee/smc_abi.c	2026-11-06 11:07:12.829316378 +0100
@@ -1773,8 +1773,9 @@
 	 * land. Use the reserved pool it also provides.
 	 */
 	if ((sec_caps & OPTEE_SMC_SEC_CAP_HAVE_RESERVED_SHM) &&
-	    (of_machine_is_compatible("amlogic,s4") ||
-	     of_machine_is_compatible("amlogic,sc2")))
+	    (of_machine_is_compatible("amlogic,s4")  ||
+	     of_machine_is_compatible("amlogic,sc2") ||
+	     of_machine_is_compatible("amlogic,t7")))
 		sec_caps &= ~OPTEE_SMC_SEC_CAP_DYNAMIC_SHM;
 
 	/*
@@ -1782,8 +1783,9 @@
 	 * ("ree system is not ready") until told that the normal world has
 	 * booted. The vendor tee-supplicant does this on start.
 	 */
-	if (of_machine_is_compatible("amlogic,s4") ||
-	    of_machine_is_compatible("amlogic,sc2")) {
+	if (of_machine_is_compatible("amlogic,s4")  ||
+	    of_machine_is_compatible("amlogic,sc2") ||
+	    of_machine_is_compatible("amlogic,t7")) {
 		struct arm_smccc_res res;
 
 		invoke_fn(OPTEE_SMC_AMLOGIC_SYS_BOOT_COMPLETE,
