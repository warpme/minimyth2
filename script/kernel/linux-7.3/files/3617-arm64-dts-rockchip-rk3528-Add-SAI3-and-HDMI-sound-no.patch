Developed-by: Piotr Oniszczuk <piotr.oniszczuk@gmail.com>
Signed-off-by: Piotr Oniszczuk <piotr.oniszczuk@gmail.com>



From e0260cd04277677024bd354b32ec101dee73affe Mon Sep 17 00:00:00 2001
From: Piotr Oniszczuk <piotr.oniszczuk@gmail.com>
Date: Sun, 22 Nov 2026 17:37:13 +0100
Subject: [PATCH] arm64: dts: rockchip: rk3528: Add SAI3 and HDMI sound nodes

Add the SAI3 controller, which is internally connected to the HDMI
transmitter, and a simple-audio-card node for HDMI audio, that boards
with HDMI output can enable.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 arch/arm64/boot/dts/rockchip/rk3528.dtsi | 33 ++++++++++++++++++++++++
 1 file changed, 33 insertions(+)

diff --git a/arch/arm64/boot/dts/rockchip/rk3528.dtsi b/arch/arm64/boot/dts/rockchip/rk3528.dtsi
index 54dbff915..bf2c0d394 100644
--- a/arch/arm64/boot/dts/rockchip/rk3528.dtsi
+++ b/arch/arm64/boot/dts/rockchip/rk3528.dtsi
@@ -106,6 +106,22 @@ scmi_clk: protocol@14 {
 		};
 	};
 
+	hdmi_sound: hdmi-sound {
+		compatible = "simple-audio-card";
+		simple-audio-card,name = "HDMI";
+		simple-audio-card,format = "i2s";
+		simple-audio-card,mclk-fs = <128>;
+		status = "disabled";
+
+		simple-audio-card,codec {
+			sound-dai = <&hdmi>;
+		};
+
+		simple-audio-card,cpu {
+			sound-dai = <&sai3>;
+		};
+	};
+
 	cpu_opp_table: opp-table-cpu {
 		compatible = "operating-points-v2";
 		opp-shared;
@@ -1153,6 +1169,23 @@ saradc: adc@ffae0000 {
 			status = "disabled";
 		};
 
+		sai3: sai@ffb70000 {
+			compatible = "rockchip,rk3528-sai", "rockchip,rk3576-sai";
+			reg = <0x0 0xffb70000 0x0 0x1000>;
+			interrupts = <GIC_SPI 128 IRQ_TYPE_LEVEL_HIGH>;
+			clocks = <&cru MCLK_SAI_I2S3>, <&cru HCLK_SAI_I2S3>;
+			clock-names = "mclk", "hclk";
+			dmas = <&dmac 5>;
+			dma-names = "tx";
+			power-domains = <&power RK3528_PD_VO>;
+			resets = <&cru SRST_M_SAI_I2S3>, <&cru SRST_H_SAI_I2S3>;
+			reset-names = "m", "h";
+			rockchip,sai-tx-route = <0 1 2 3>;
+			#sound-dai-cells = <0>;
+			sound-name-prefix = "SAI3";
+			status = "disabled";
+		};
+
 		gmac0: ethernet@ffbd0000 {
 			compatible = "rockchip,rk3528-gmac", "snps,dwmac-4.20a";
 			reg = <0x0 0xffbd0000 0x0 0x10000>;
-- 
