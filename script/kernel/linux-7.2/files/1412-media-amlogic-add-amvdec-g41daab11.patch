+; 2. DDR->LMEM from buf+0x1000 (host prefilled halfword i = 0xa000+i) into LMEM 0x200, COUNT=64, CTRL=0xc200
+;    S1..S4 = LMEM[0x200,0x201,0x202,0x23f]; S5 = LMEM[0x240] (should be untouched)
