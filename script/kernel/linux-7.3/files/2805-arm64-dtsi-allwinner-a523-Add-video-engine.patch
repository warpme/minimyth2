Patch from MiniMyth2 project

Developed-by: Piotr Oniszczuk <piotr.oniszczuk@gmail.com>
Signed-off-by: Piotr Oniszczuk <piotr.oniszczuk@gmail.com>


arm64: dts: allwinner: a523: Add video engine (cedrus) and VE SRAM switches

diff --git linux-7.3.6/arch/arm64/boot/dts/allwinner/sun55i-a523.dtsi linux-7.3.6/arch/arm64/boot/dts/allwinner/sun55i-a523.dtsi
index 1fd49e8..ed1cbb8 100644
--- linux-7.3.6/arch/arm64/boot/dts/allwinner/sun55i-a523.dtsi
+++ linux-7.3.6/arch/arm64/boot/dts/allwinner/sun55i-a523.dtsi
@@ -160,6 +160,18 @@
 			status = "disabled";
 		};
 
+		video-codec@1c0e000 {
+			compatible = "allwinner,sun55i-a523-video-engine";
+			reg = <0x01c0e000 0x1000>;
+			clocks = <&ccu CLK_BUS_VE>, <&ccu CLK_VE>,
+				 <&ccu CLK_MBUS_VE>;
+			clock-names = "ahb", "mod", "ram";
+			resets = <&ccu RST_BUS_VE>;
+			interrupts = <GIC_SPI 120 IRQ_TYPE_LEVEL_HIGH>;
+			allwinner,sram = <&ve_sram 1>, <&de2_sram 1>;
+			power-domains = <&pck600 PD_VE>;
+		};
+
 		pio: pinctrl@2000000 {
 			compatible = "allwinner,sun55i-a523-pinctrl";
 			reg = <0x2000000 0x800>;
@@ -624,6 +636,40 @@
 			#address-cells = <1>;
 			#size-cells = <1>;
 			ranges;
+
+			/*
+			 * SRAM switches used by the video engine (BSP cedar:
+			 * SYS_CFG 0x0 bit 0 and 0x4 bit 24 cleared = owned by
+			 * the VE). Same register layout as H616; with bit 24
+			 * in its boot-mode state VE register accesses hang.
+			 * The SRAM addresses below are not used by the driver.
+			 */
+			sram_c: sram@28000 {
+				compatible = "mmio-sram";
+				reg = <0x00028000 0x30000>;
+				#address-cells = <1>;
+				#size-cells = <1>;
+				ranges = <0 0x00028000 0x30000>;
+
+				de2_sram: sram-section@0 {
+					compatible = "allwinner,sun50i-h616-sram-c",
+						     "allwinner,sun50i-a64-sram-c";
+					reg = <0x00000 0x30000>;
+				};
+			};
+
+			sram@1a00000 {
+				compatible = "mmio-sram";
+				reg = <0x01a00000 0x200000>;
+				#address-cells = <1>;
+				#size-cells = <1>;
+				ranges = <0 0x01a00000 0x200000>;
+
+				ve_sram: sram-section@0 {
+					compatible = "allwinner,sun50i-h616-ve-sram";
+					reg = <0x000000 0x200000>;
+				};
+			};
 		};
 
 		dma: dma-controller@3002000 {
