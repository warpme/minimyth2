@@ -16,4 +16,8 @@ int meson_amvdec_codec_hevc_decoder_cmd(struct amvdec_session *sess, struct v4l2
 void meson_amvdec_codec_hevc_stateful_eos(struct amvdec_session *sess);
 void meson_amvdec_codec_hevc_cancel_drain(struct amvdec_session *sess);
 
+void meson_amvdec_codec_hevc_arm_restream(struct amvdec_session *sess);
+bool meson_amvdec_codec_hevc_restream_pending(struct amvdec_session *sess);
