diff --git a/mythtv/external/FFmpeg/libavfilter/vulkan/blackdetect.comp.glsl b/mythtv/external/FFmpeg/libavfilter/vulkan/blackdetect.comp.glsl
new file mode 100644
index 00000000000..d0a2a078e0b
--- /dev/null
+++ b/mythtv/external/FFmpeg/libavfilter/vulkan/blackdetect.comp.glsl
@@ -0,0 +1,64 @@
+/*
+ * Copyright 2025 (c) Niklas Haas
+ *
+ * This file is part of FFmpeg.
+ *
+ * FFmpeg is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
