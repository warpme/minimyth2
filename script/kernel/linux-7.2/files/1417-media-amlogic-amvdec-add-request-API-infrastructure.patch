Patch from MiniMyth2 project

Developed-by: Piotr Oniszczuk <piotr.oniszczuk@gmail.com>
Signed-off-by: Piotr Oniszczuk <piotr.oniszczuk@gmail.com>



From 9153a10ba14a1c08bfa7852da4eca7026a721437 Mon Sep 17 00:00:00 2001
From: gus bourg <gus@bourg.net>
Date: Thu, 24 Sep 2026 20:15:28 -0700
Subject: [PATCH 09/17] media: amlogic: amvdec: add request API infrastructure

Add media requests, codec controls, job ownership and request-aware
buffer completion. Allow codec-specific stateless geometry floors and
keep completed or cancelled request cleanup quiet.

Assisted-by: Claude:claude-opus-5-5
Assisted-by: Claude:claude-fable-5-1
Assisted-by: Codex:gpt-5.6
Assisted-by: Codex:gpt-6.0
---
 drivers/media/platform/amlogic/amvdec/Kconfig |   1 +
 .../media/platform/amlogic/amvdec/amvdec.c    | 216 ++++++++++++++++--
 .../media/platform/amlogic/amvdec/amvdec.h    |  22 ++
 .../platform/amlogic/amvdec/amvdec_helpers.c  | 139 ++++++++++-
 .../platform/amlogic/amvdec/amvdec_helpers.h  |  58 +++++
 .../platform/amlogic/amvdec/amvdec_platform.h |   2 +
 .../amlogic/amvdec/codec_hevc_common.c        |  12 +
 .../media/platform/amlogic/amvdec/esparser.c  |  86 ++++++-
 8 files changed, 507 insertions(+), 29 deletions(-)

diff --git a/drivers/media/platform/amlogic/amvdec/Kconfig b/drivers/media/platform/amlogic/amvdec/Kconfig
index 301f11bbe4..90a6f6aa22 100644
--- a/drivers/media/platform/amlogic/amvdec/Kconfig
+++ b/drivers/media/platform/amlogic/amvdec/Kconfig
@@ -4,6 +4,7 @@ config VIDEO_MESON_AMVDEC
 	tristate "Amlogic video decoder driver"
 	depends on V4L_MEM2MEM_DRIVERS
 	depends on VIDEO_DEV && HAS_DMA
+	select MEDIA_CONTROLLER
 	depends on ARCH_MESON || COMPILE_TEST
 	select VIDEOBUF2_DMA_CONTIG
 	select V4L2_MEM2MEM_DEV
diff --git a/drivers/media/platform/amlogic/amvdec/amvdec.c b/drivers/media/platform/amlogic/amvdec/amvdec.c
index 0a54a749a5..7de142c3a1 100644
--- a/drivers/media/platform/amlogic/amvdec/amvdec.c
+++ b/drivers/media/platform/amlogic/amvdec/amvdec.c
@@ -28,6 +28,12 @@
 #include "esparser.h"
 #include "amvdec_helpers.h"
 
+/* Fixed at load: the formats a node exposes never change once registered. */
+
+static bool stateless;
+module_param(stateless, bool, 0444);
+MODULE_PARM_DESC(stateless, "Expose the stateless (request API) formats this SoC supports instead of the stateful ones");
+
 struct dummy_buf {
 	struct vb2_v4l2_buffer vb;
 	struct list_head list;
@@ -228,6 +234,7 @@ static void vdec_m2m_device_run(void *priv)
 {
 	struct amvdec_session *sess = priv;
 
+	WRITE_ONCE(sess->m2m_run_armed, true);
 	schedule_work(&sess->esparser_queue_work);
 }
 
@@ -251,7 +258,8 @@ static void process_num_buffers(struct vb2_queue *q,
 	const struct amvdec_format *fmt_out = sess->fmt_out;
 	unsigned int q_num_bufs = vb2_get_num_buffers(q);
 	unsigned int buffers_total = q_num_bufs + *num_buffers;
-	u32 min_buf_capture = v4l2_ctrl_g_ctrl(sess->ctrl_min_buf_capture);
+	u32 min_buf_capture = stateless ? 1 :
+		v4l2_ctrl_g_ctrl(sess->ctrl_min_buf_capture);
 
 	if (q_num_bufs + *num_buffers < min_buf_capture)
 		*num_buffers = min_buf_capture - q_num_bufs;
@@ -277,7 +285,15 @@ static void process_num_buffers(struct vb2_queue *q,
 	 * start_streaming() - the decoder sat in NEEDS_RESUME for good
 	 * while the player's clock ran on over a frozen picture.
 	 */
-	if (fmt_out->codec_ops->resume)
+	/*
+	 * A stateless client owns CAPTURE buffer selection: it attaches one
+	 * buffer to each request and queues nothing ahead of STREAMON.  Any
+	 * minimum at all makes VIDIOC_STREAMON(CAPTURE) fail with EINVAL
+	 * before a single picture is submitted.
+	 */
+	if (amvdec_pixfmt_is_stateless(fmt_out->pixfmt))
+		q->min_queued_buffers = 0;
+	else if (fmt_out->codec_ops->resume)
 		q->min_queued_buffers = fmt_out->min_buffers;
 	else
 		q->min_queued_buffers = max(fmt_out->min_buffers,
@@ -636,13 +652,36 @@ static void vdec_vb2_buf_queue(struct vb2_buffer *vb)
 		v4l2_m2m_last_buffer_done(m2m_ctx, vbuf);
 		return;
 	}
-	if (vb->type == V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE &&
+	if (!amvdec_pixfmt_is_stateless(sess->fmt_out->pixfmt) &&
+	    vb->type == V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE &&
 	    meson_amvdec_refresh_capture_canvases(sess, vb)) {
 		vb2_buffer_done(vb, VB2_BUF_STATE_ERROR);
 		return;
 	}
 	v4l2_m2m_buf_queue(m2m_ctx, vbuf);
 	vdec_debug_state(sess, "qbuf", vb->type, vb->index);
+	if (amvdec_pixfmt_is_stateless(sess->fmt_out->pixfmt) &&
+	    vb->type == V4L2_BUF_TYPE_VIDEO_OUTPUT_MPLANE)
+		dev_dbg(sess->core->dev,
+			"request input index=%u src=%u queued=%d work_busy=%u\n",
+			 vb->index, v4l2_m2m_num_src_bufs_ready(m2m_ctx),
+			 atomic_read(&sess->esparser_queued_bufs),
+			 work_busy(&sess->esparser_queue_work));
+
+	/* H.264 and MPEG-1/2 are the request codecs on vdec_1. Returned
+	 * CAPTURE buffers still have to pass through the AMRISC firmware's
+	 * recycle queue; the request-format return below only replaces
+	 * source scheduling. Codecs with no recycle op (HEVC, VP9) drop out
+	 * of vdec_codec_needs_recycle() on their own.
+	 */
+	if (amvdec_pixfmt_is_stateless(sess->fmt_out->pixfmt) &&
+	    sess->streamon_cap &&
+	    vb->type == V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE &&
+	    vdec_codec_needs_recycle(sess))
+		vdec_queue_recycle(sess, vb);
+
+	if (amvdec_pixfmt_is_stateless(sess->fmt_out->pixfmt))
+		return;
 
 	/*
 	 * Only MPEG1/2 may take this path.  The parser below looks for the
@@ -757,6 +796,8 @@ static int vdec_start_streaming(struct vb2_queue *q, unsigned int count)
 	sess->wrap_count = 0;
 	sess->pixelaspect.numerator = 1;
 	sess->pixelaspect.denominator = 1;
+	if (amvdec_pixfmt_is_stateless(sess->fmt_out->pixfmt))
+		sess->bitdepth = 8;
 	atomic_set(&sess->esparser_queued_bufs, 0);
 	if (sess->ctrl_min_buf_capture)
 		v4l2_ctrl_s_ctrl(sess->ctrl_min_buf_capture, 1);
@@ -883,6 +924,8 @@ static void vdec_stop_streaming(struct vb2_queue *q)
 			vb2_queue_error(&sess->m2m_ctx->cap_q_ctx.q);
 			sess->status = STATUS_STOPPED;
 		} else {
+			if (meson_amvdec_request_jobs(sess))
+				meson_amvdec_request_retire(sess, true);
 			vdec_free_canvas(sess);
 			dma_free_coherent(sess->core->dev, sess->vififo_size,
 					  sess->vififo_vaddr, sess->vififo_paddr);
@@ -894,14 +937,25 @@ static void vdec_stop_streaming(struct vb2_queue *q)
 		}
 	}
 
+	/*
+	 * Whatever state the session was in, the job in flight holds one
+	 * buffer of each queue.  Both go back before either queue is torn
+	 * down, or vb2 finds a buffer it never got back.
+	 */
+	if (meson_amvdec_request_jobs(sess))
+		meson_amvdec_request_retire(sess, true);
+
 	if (q->type == V4L2_BUF_TYPE_VIDEO_OUTPUT_MPLANE) {
 		sess->init_src_change_done = 0;
 		sess->h264_source_geometry_valid = false;
 	}
 
 	if (q->type == V4L2_BUF_TYPE_VIDEO_OUTPUT_MPLANE) {
-		while ((buf = v4l2_m2m_src_buf_remove(sess->m2m_ctx)))
+		while ((buf = v4l2_m2m_src_buf_remove(sess->m2m_ctx))) {
+			v4l2_ctrl_request_complete(buf->vb2_buf.req_obj.req,
+						   &sess->ctrl_handler);
 			v4l2_m2m_buf_done(buf, VB2_BUF_STATE_ERROR);
+		}
 
 		sess->streamon_out = 0;
 	} else {
@@ -927,8 +981,10 @@ static void vdec_stop_streaming(struct vb2_queue *q)
 static int vdec_vb2_buf_prepare(struct vb2_buffer *vb)
 {
 	struct vb2_v4l2_buffer *vbuf = to_vb2_v4l2_buffer(vb);
+	struct amvdec_session *sess = vb2_get_drv_priv(vb->vb2_queue);
 
-	if (V4L2_TYPE_IS_OUTPUT(vb->type)) {
+	if (V4L2_TYPE_IS_OUTPUT(vb->type) &&
+	    !amvdec_pixfmt_is_stateless(sess->fmt_out->pixfmt)) {
 		u64 needed = (u64)max_t(u32, vb2_get_plane_payload(vb, 0),
 				       ESPARSER_MIN_PACKET_SIZE) +
 			     ESPARSER_SEARCH_PATTERN_SIZE;
@@ -941,12 +997,27 @@ static int vdec_vb2_buf_prepare(struct vb2_buffer *vb)
 	return 0;
 }
 
+static int vdec_buf_out_validate(struct vb2_buffer *vb)
+{
+	to_vb2_v4l2_buffer(vb)->field = V4L2_FIELD_NONE;
+	return 0;
+}
+
+static void vdec_buf_request_complete(struct vb2_buffer *vb)
+{
+	struct amvdec_session *sess = vb2_get_drv_priv(vb->vb2_queue);
+
+	v4l2_ctrl_request_complete(vb->req_obj.req, &sess->ctrl_handler);
+}
+
 static const struct vb2_ops vdec_vb2_ops = {
 	.queue_setup = vdec_queue_setup,
 	.start_streaming = vdec_start_streaming,
 	.stop_streaming = vdec_stop_streaming,
 	.buf_queue = vdec_vb2_buf_queue,
 	.buf_prepare = vdec_vb2_buf_prepare,
+	.buf_out_validate = vdec_buf_out_validate,
+	.buf_request_complete = vdec_buf_request_complete,
 };
 
 static int
@@ -1034,8 +1105,18 @@ vdec_try_fmt_common(struct amvdec_session *sess, u32 size,
 		pixmp->width = sess->width;
 		pixmp->height = sess->height;
 	} else {
-		pixmp->width = clamp(pixmp->width, (u32)256, fmt_out->max_width);
-		pixmp->height = clamp(pixmp->height, (u32)144, fmt_out->max_height);
+		/*
+		 * Match what VIDIOC_ENUM_FRAMESIZES advertises: one macroblock
+		 * for the stateless formats, where the coded size comes from
+		 * the stream and conformance coverage is the point, and the
+		 * shipped figure for the stateful path.
+		 */
+		pixmp->width = clamp(pixmp->width,
+				     amvdec_min_coded_width(fmt_out->pixfmt),
+				     fmt_out->max_width);
+		pixmp->height = clamp(pixmp->height,
+				      amvdec_min_coded_height(fmt_out->pixfmt),
+				      fmt_out->max_height);
 	}
 	output_size = get_output_size(pixmp->width, pixmp->height);
 
@@ -1043,7 +1124,8 @@ vdec_try_fmt_common(struct amvdec_session *sess, u32 size,
 		if (!pfmt[0].sizeimage)
 			pfmt[0].sizeimage = sess->src_buffer_size;
 		/* The parser pads short packets and fetches a trailing start code. */
-		pfmt[0].sizeimage = max_t(u32, pfmt[0].sizeimage,
+		if (!amvdec_pixfmt_is_stateless(fmt_out->pixfmt))
+			pfmt[0].sizeimage = max_t(u32, pfmt[0].sizeimage,
 				ESPARSER_MIN_PACKET_SIZE + ESPARSER_SEARCH_PATTERN_SIZE);
 		pfmt[0].bytesperline = 0;
 		pixmp->num_planes = 1;
@@ -1146,6 +1228,14 @@ static int vdec_s_fmt(struct file *file, void *fh, struct v4l2_format *f)
 	    vb2_is_busy(v4l2_m2m_get_src_vq(sess->m2m_ctx)))
 		return -EBUSY;
 
+	/* Request policy cannot change underneath allocated buffers. */
+	if ((amvdec_pixfmt_is_stateless(sess->fmt_out->pixfmt) ||
+	     (V4L2_TYPE_IS_OUTPUT(f->type) &&
+	      amvdec_pixfmt_is_stateless(pixmp->pixelformat))) &&
+	    (vb2_is_busy(v4l2_m2m_get_src_vq(sess->m2m_ctx)) ||
+	     vb2_is_busy(v4l2_m2m_get_dst_vq(sess->m2m_ctx))))
+		return -EBUSY;
+
 	orig_pixmp = *pixmp;
 
 	fmt_out = vdec_try_fmt_common(sess, num_formats, f);
@@ -1241,8 +1331,19 @@ static int vdec_enum_framesizes(struct file *file, void *fh,
 
 	fsize->type = V4L2_FRMSIZE_TYPE_CONTINUOUS;
 
-	fsize->stepwise.min_width = 256;
-	fsize->stepwise.min_height = 144;
+	/*
+	 * 256 is an inherited figure, not a measured hardware limit, and it is
+	 * above QCIF - which most of the JVT-AVC_V1 conformance vectors are.
+	 * A stateless client checks VIDIOC_ENUM_FRAMESIZES before setting up
+	 * and silently falls back to software when the size is refused, so
+	 * this one constant hid the majority of the suite.
+	 *
+	 * Advertise down to one macroblock for the stateless formats, where
+	 * conformance coverage is the point, and leave the stateful path on
+	 * the figure it has shipped with.
+	 */
+	fsize->stepwise.min_width = amvdec_min_coded_width(fsize->pixel_format);
+	fsize->stepwise.min_height = amvdec_min_coded_height(fsize->pixel_format);
 	fsize->stepwise.max_width = fmt->max_width;
 	fsize->stepwise.step_width = 1;
 	fsize->stepwise.max_height = fmt->max_height;
@@ -1251,6 +1352,15 @@ static int vdec_enum_framesizes(struct file *file, void *fh,
 	return 0;
 }
 
+static int vdec_try_decoder_cmd(struct file *file, void *fh,
+				struct v4l2_decoder_cmd *cmd)
+{
+	if (stateless)
+		return v4l2_m2m_ioctl_stateless_try_decoder_cmd(file, fh, cmd);
+
+	return v4l2_m2m_ioctl_try_decoder_cmd(file, fh, cmd);
+}
+
 /* Caller holds sess->lock, which also protects CAPTURE buffer allocation. */
 int meson_amvdec_resume_capture(struct amvdec_session *sess)
 {
@@ -1318,6 +1428,21 @@ vdec_decoder_cmd(struct file *file, void *fh, struct v4l2_decoder_cmd *cmd)
 	struct device *dev = sess->core->dev;
 	int ret;
 
+	if (stateless) {
+		ret = v4l2_m2m_ioctl_stateless_decoder_cmd(file, fh, cmd);
+		/* Preserve generic FLUSH/HOLD semantics. At end of input the
+		 * codec can also release pictures held for display reordering.
+		 * OUTPUT completion is required before this codec-level drain.
+		 */
+		if (!ret && sess->streamon_out && sess->streamon_cap &&
+		    codec_ops->drain &&
+		    !v4l2_m2m_num_src_bufs_ready(sess->m2m_ctx)) {
+			vdec_wait_inactive(sess);
+			codec_ops->drain(sess);
+		}
+		return ret;
+	}
+
 	ret = v4l2_m2m_ioctl_try_decoder_cmd(file, fh, cmd);
 	if (ret)
 		return ret;
@@ -1381,6 +1506,8 @@ static int vdec_subscribe_event(struct v4l2_fh *fh,
 	switch (sub->type) {
 	case V4L2_EVENT_EOS:
 	case V4L2_EVENT_SOURCE_CHANGE:
+		if (stateless)
+			return -EINVAL;
 		return v4l2_event_subscribe(fh, sub, 0, NULL);
 	case V4L2_EVENT_CTRL:
 		return v4l2_ctrl_subscribe_event(fh, sub);
@@ -1423,7 +1550,7 @@ static const struct v4l2_ioctl_ops vdec_ioctl_ops = {
 	.vidioc_enum_framesizes = vdec_enum_framesizes,
 	.vidioc_subscribe_event = vdec_subscribe_event,
 	.vidioc_unsubscribe_event = v4l2_event_unsubscribe,
-	.vidioc_try_decoder_cmd = v4l2_m2m_ioctl_try_decoder_cmd,
+	.vidioc_try_decoder_cmd = vdec_try_decoder_cmd,
 	.vidioc_decoder_cmd = vdec_decoder_cmd,
 	.vidioc_g_pixelaspect = vdec_g_pixelaspect,
 };
@@ -1441,7 +1568,9 @@ static int m2m_queue_init(void *priv, struct vb2_queue *src_vq,
 	src_vq->mem_ops = &vb2_dma_contig_memops;
 	src_vq->drv_priv = sess;
 	src_vq->buf_struct_size = sizeof(struct dummy_buf);
-	src_vq->min_queued_buffers = 1;
+	src_vq->supports_requests = stateless;
+	src_vq->requires_requests = stateless;
+	src_vq->min_queued_buffers = stateless ? 0 : 1;
 	src_vq->dev = sess->core->dev;
 	src_vq->lock = &sess->lock;
 	ret = vb2_queue_init(src_vq);
@@ -1464,7 +1593,7 @@ static int m2m_queue_init(void *priv, struct vb2_queue *src_vq,
 	dst_vq->mem_ops = &vb2_dma_contig_memops;
 	dst_vq->drv_priv = sess;
 	dst_vq->buf_struct_size = sizeof(struct dummy_buf);
-	dst_vq->min_queued_buffers = 1;
+	dst_vq->min_queued_buffers = stateless ? 0 : 1;
 	dst_vq->dev = sess->core->dev;
 	dst_vq->lock = &sess->lock;
 	return vb2_queue_init(dst_vq);
@@ -1479,10 +1608,11 @@ static int vdec_init_ctrls(struct amvdec_session *sess)
 	if (ret)
 		return ret;
 
-	sess->ctrl_min_buf_capture =
-		v4l2_ctrl_new_std(ctrl_handler, NULL,
-				  V4L2_CID_MIN_BUFFERS_FOR_CAPTURE,
-				  1, 32, 1, 1);
+	if (!stateless)
+		sess->ctrl_min_buf_capture =
+			v4l2_ctrl_new_std(ctrl_handler, NULL,
+					  V4L2_CID_MIN_BUFFERS_FOR_CAPTURE,
+					  1, 32, 1, 1);
 
 	ret = ctrl_handler->error;
 	if (ret) {
@@ -1646,6 +1776,23 @@ static const struct of_device_id vdec_dt_match[] = {
 };
 MODULE_DEVICE_TABLE(of, vdec_dt_match);
 
+static int vdec_request_validate(struct media_request *req)
+{
+	unsigned int count = vb2_request_buffer_cnt(req);
+
+	if (!count)
+		return -ENOENT;
+	if (count > 1)
+		return -EINVAL;
+
+	return vb2_request_validate(req);
+}
+
+static const struct media_device_ops vdec_media_ops = {
+	.req_validate = vdec_request_validate,
+	.req_queue = v4l2_m2m_request_queue,
+};
+
 static int vdec_probe(struct platform_device *pdev)
 {
 	struct device *dev = &pdev->dev;
@@ -1689,6 +1836,11 @@ static int vdec_probe(struct platform_device *pdev)
 
 	of_id = of_match_node(vdec_dt_match, dev->of_node);
 	core->platform = of_id->data;
+	if (stateless) {
+		if (!core->platform->stateless)
+			return -ENODEV;
+		core->platform = core->platform->stateless;
+	}
 
 	if (core->platform->revision == AMVDEC_REVISION_G12A ||
 	    core->platform->revision == AMVDEC_REVISION_SM1) {
@@ -1740,10 +1892,18 @@ static int vdec_probe(struct platform_device *pdev)
 		goto err_v4l2_unregister;
 	}
 
+	core->mdev.dev = dev;
+	strscpy(core->mdev.model, "meson-amvdec", sizeof(core->mdev.model));
+	strscpy(core->mdev.bus_info, "platform:meson-amvdec",
+		sizeof(core->mdev.bus_info));
+	media_device_init(&core->mdev);
+	core->mdev.ops = &vdec_media_ops;
+	core->v4l2_dev.mdev = &core->mdev;
+
 	vdev = video_device_alloc();
 	if (!vdev) {
 		ret = -ENOMEM;
-		goto err_m2m_release;
+		goto err_media_cleanup;
 	}
 
 	core->vdev_dec = vdev;
@@ -1768,11 +1928,26 @@ static int vdec_probe(struct platform_device *pdev)
 		goto err_vdev_release;
 	}
 
+	ret = v4l2_m2m_register_media_controller(core->m2m_dev, vdev,
+						 MEDIA_ENT_F_PROC_VIDEO_DECODER);
+	if (ret)
+		goto err_video_unregister;
+
+	ret = media_device_register(&core->mdev);
+	if (ret)
+		goto err_mc_unregister;
+
 	return 0;
 
+err_mc_unregister:
+	v4l2_m2m_unregister_media_controller(core->m2m_dev);
+err_video_unregister:
+	video_unregister_device(vdev);
+	goto err_media_cleanup;
 err_vdev_release:
 	video_device_release(vdev);
-err_m2m_release:
+err_media_cleanup:
+	media_device_cleanup(&core->mdev);
 	v4l2_m2m_release(core->m2m_dev);
 err_v4l2_unregister:
 	v4l2_device_unregister(&core->v4l2_dev);
@@ -1785,7 +1960,10 @@ static void vdec_remove(struct platform_device *pdev)
 
 	meson_amvdec_codec_hevc_fbc_pool_drain();
 	meson_amvdec_codec_hevc_workspace_release();
+	media_device_unregister(&core->mdev);
+	v4l2_m2m_unregister_media_controller(core->m2m_dev);
 	video_unregister_device(core->vdev_dec);
+	media_device_cleanup(&core->mdev);
 	v4l2_m2m_release(core->m2m_dev);
 	v4l2_device_unregister(&core->v4l2_dev);
 }
diff --git a/drivers/media/platform/amlogic/amvdec/amvdec.h b/drivers/media/platform/amlogic/amvdec/amvdec.h
index fa6a4e4bfa..dbead1f6a5 100644
--- a/drivers/media/platform/amlogic/amvdec/amvdec.h
+++ b/drivers/media/platform/amlogic/amvdec/amvdec.h
@@ -13,6 +13,7 @@
 #include <media/videobuf2-v4l2.h>
 #include <media/v4l2-ctrls.h>
 #include <media/v4l2-device.h>
+#include <media/media-device.h>
 #include <linux/soc/amlogic/meson-canvas.h>
 
 #include "amvdec_platform.h"
@@ -121,6 +122,7 @@ struct amvdec_core {
 
 	struct video_device *vdev_dec;
 	struct v4l2_device v4l2_dev;
+	struct media_device mdev;
