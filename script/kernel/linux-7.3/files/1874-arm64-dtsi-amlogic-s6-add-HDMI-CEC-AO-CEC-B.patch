From 0f33aed8e4bee018dbb43a62d54d81d7151d343f Mon Sep 17 00:00:00 2001
From: Piotr Oniszczuk <piotr.oniszczuk@gmail.com>
Date: Wed, 18 Nov 2026 18:04:37 +0100
Subject: [PATCH] arm64: dts: amlogic: s6: add HDMI CEC (AO-CEC-B)

Add the AO-CEC-B controller (0xfe044040, SPI 180) with the 32768 Hz core
clock from the CECB clock tree, and the HDMI CEC pin on GPIOH_3. Enable
it on the BL201 board. The block is programmed like the S4 one, so the
S4 compatible is used as the fallback.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 arch/arm64/boot/dts/amlogic/amlogic-s6.dtsi   | 21 +++++++++++++++++++
 1 file changed, 27 insertions(+)

diff --git a/arch/arm64/boot/dts/amlogic/amlogic-s6.dtsi b/arch/arm64/boot/dts/amlogic/amlogic-s6.dtsi
index c5a5cbd0e..ef505212d 100644
--- a/arch/arm64/boot/dts/amlogic/amlogic-s6.dtsi
+++ b/arch/arm64/boot/dts/amlogic/amlogic-s6.dtsi
@@ -692,6 +692,13 @@ hdmitx_ddc_pins: group-ddc-pins {
 					};
 				};
 
+				func-cec {
+					hdmitx_cec_pins: group-cec-pins {
+						pinmux = <AML_PINMUX(AMLOGIC_GPIO_H, 3, 1)>;
+						bias-disable;
+					};
+				};
+
 				func-remote {
 					remote_pins: group-pins {
 						pinmux = <AML_PINMUX(AMLOGIC_GPIO_F, 3, 1)>;
@@ -892,6 +899,20 @@ canvas: video-lut@36048 {
 				reg = <0x0 0x36048 0x0 0x14>;
 			};
 
+			cecb: cec@44040 {
+				compatible = "amlogic,meson-s6-ao-cec",
+					     "amlogic,meson-s4-ao-cec";
+				reg = <0x0 0x44040 0x0 0x14>;
+				interrupts = <GIC_SPI 180 IRQ_TYPE_EDGE_RISING>;
+				clocks = <&clkc_periphs CLKID_CECB_CLK>;
+				clock-names = "core";
+				assigned-clocks = <&clkc_periphs CLKID_CECB_CLK>;
+				assigned-clock-parents = <&clkc_periphs CLKID_CECB_DUAL>;
+				assigned-clock-rates = <32768>;
+				hdmi-phandle = <&hdmi_tx>;
+				status = "disabled";
+			};
+
 			clk_msr: clock-measure@48000 {
 				compatible = "amlogic,s6-clk-measure";
 				reg = <0x0 0x48000 0x0 0x1c>;
-- 
2.43.0

