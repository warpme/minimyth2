From 608b8bc62e0b62b80983900d7e7595dd530f382c Mon Sep 17 00:00:00 2001
From: Piotr Oniszczuk <piotr.oniszczuk@gmail.com>
Date: Sat, 21 Nov 2026 18:48:57 +0100
Subject: [PATCH 07/10] net: dwc_eth_qos: meson: add Amlogic S6 support

The Amlogic S6 has the same dwmac 4.x (QoS) MAC and PRG_ETH glue as the
T7: the PRG_ETH0/1 registers follow the G12A layout and the MDIO lines
reach the external PHY through a G12A style multiplexer.

Match the "amlogic,s6-dwmac" compatible with the existing Meson glue.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: Piotr Oniszczuk <piotr.oniszczuk@gmail.com>
---
 drivers/net/Kconfig             | 3 ++-
 drivers/net/dwc_eth_qos.c       | 4 ++++
 drivers/net/dwc_eth_qos_meson.c | 2 +-
 3 files changed, 7 insertions(+), 2 deletions(-)

diff --git a/drivers/net/Kconfig b/drivers/net/Kconfig
index 15d21a02..1d35681f 100644
--- a/drivers/net/Kconfig
+++ b/drivers/net/Kconfig
@@ -252,7 +252,8 @@ config DWC_ETH_QOS_MESON
 	depends on DWC_ETH_QOS && ARCH_MESON
 	help
 	  The Synopsys Designware Ethernet QOS (dwmac 4.x) IP block with the
-	  Amlogic PRG_ETH glue, as used on the Amlogic T7 (A311D2) SoC.
+	  Amlogic PRG_ETH glue, as used on the Amlogic T7 (A311D2) and S6
+	  (S905X5) SoCs.
 
 config DWC_ETH_QOS_MTK
 	bool "Synopsys DWC Ethernet QOS device support for MediaTek SoCs"
diff --git a/drivers/net/dwc_eth_qos.c b/drivers/net/dwc_eth_qos.c
index 6bbe836a..397fec8f 100644
--- a/drivers/net/dwc_eth_qos.c
+++ b/drivers/net/dwc_eth_qos.c
@@ -1670,6 +1670,10 @@ static const struct udevice_id eqos_ids[] = {
 		.compatible = "amlogic,t7-dwmac",
 		.data = (ulong)&eqos_meson_config
 	},
+	{
+		.compatible = "amlogic,s6-dwmac",
+		.data = (ulong)&eqos_meson_config
+	},
 #endif
 #if IS_ENABLED(CONFIG_DWC_ETH_QOS_SUNXI)
 	{
diff --git a/drivers/net/dwc_eth_qos_meson.c b/drivers/net/dwc_eth_qos_meson.c
index 104c62a4..ac200dbe 100644
--- a/drivers/net/dwc_eth_qos_meson.c
+++ b/drivers/net/dwc_eth_qos_meson.c
@@ -1,7 +1,7 @@
 // SPDX-License-Identifier: GPL-2.0+
 /*
  * Amlogic glue for the Synopsys DWC Ethernet QoS (dwmac 4.x) controller,
- * as found on the T7 (A311D2) SoC.
+ * as found on the T7 (A311D2) and S6 (S905X5) SoCs.
  *
  * The PRG_ETH0/PRG_ETH1 programming follows the Linux dwmac-meson8b
  * driver (G12A variant: RX delay in PRG_ETH1).
-- 
2.43.0

