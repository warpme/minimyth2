From 2844a0157d79cb959c227756df23146c465d485a Mon Sep 17 00:00:00 2001
From: Jernej Skrabec <jernej.skrabec@gmail.com>
Date: Sat, 5 Sep 2026 06:22:15 +0200
Subject: [PATCH 205/211] arm64: dts: allwinner: cubie-a7a: Name the GPU supply

DCDC4 feeds the GPU core, so hand it to the GPU for scaling, and tell
the regulator how fast it ramps. Without the ramp delay the operating
point core raises the GPU clock the moment the new voltage is
requested, while the rail is still climbing, and the GPU locks up or
returns wrong pixels on frequency changes; the CPU rails already carry
the same value for the same reason.

Signed-off-by: Jernej Skrabec <jernej.skrabec@gmail.com>
---
 arch/arm64/boot/dts/allwinner/sun60i-a733-cubie-a7a.dts | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/arch/arm64/boot/dts/allwinner/sun60i-a733-cubie-a7a.dts b/arch/arm64/boot/dts/allwinner/sun60i-a733-cubie-a7a.dts
index d9fcbddf38..19ee6a0c1a 100644
--- a/arch/arm64/boot/dts/allwinner/sun60i-a733-cubie-a7a.dts
+++ b/arch/arm64/boot/dts/allwinner/sun60i-a733-cubie-a7a.dts
@@ -166,6 +166,7 @@ &gmac0 {
 };
 
 &gpu {
+	power-supply = <&reg_dcdc4>;
 	status = "okay";
 };
 
@@ -331,6 +332,7 @@ reg_dcdc4: dcdc4 {
 				regulator-always-on;
 				regulator-min-microvolt = <800000>;
 				regulator-max-microvolt = <960000>;
+				regulator-ramp-delay = <250>;
 				regulator-name = "vdd-gpu";
 			};
 
