From 19eb14df90f523d6ff481ad0828e1f07b2850b58 Mon Sep 17 00:00:00 2001
From: Piotr Oniszczuk <piotr.oniszczuk@gmail.com>
Date: Sat, 21 Nov 2026 18:50:19 +0100
Subject: [PATCH 08/10] arm: meson: add Amlogic S6 SoC support

Add the Amlogic S6 (S905X5) SoC family, as a new MESON_S6 platform
next to S4 and T7:

- the watchdog left running by the secure firmware is disabled,
- the boot device and the BL31/BL32 zones are read from the SYSCTRL
  SEC_STATUS registers, with the same layout as on S4,
- the secure monitor (0x05000000 - 0x06b00000) and the MTE tag storage
  (0x0c000000 - 0x14000000) zones that the vendor device tree reserves
  as no-map are left out of the memory map and reserved for the OS,
- the DRAM above 4 GiB is described by a second bank, passed to the OS
  and mapped with its size from the device tree,
- the load addresses are placed above the secure zones, leaving 128 MiB
  for the kernel image.

The first 4 KiB of the image are skipped with the boot0 hook, as on S4
and T7, because BL2 clobbers them.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: Piotr Oniszczuk <piotr.oniszczuk@gmail.com>
---
 arch/arm/include/asm/arch-meson/s6.h |  52 +++++++++
 arch/arm/mach-meson/Kconfig          |   8 ++
 arch/arm/mach-meson/Makefile         |   1 +
 arch/arm/mach-meson/board-s6.c       | 166 +++++++++++++++++++++++++++
 include/configs/meson64.h            |  15 +++
 5 files changed, 242 insertions(+)
 create mode 100644 arch/arm/include/asm/arch-meson/s6.h
 create mode 100644 arch/arm/mach-meson/board-s6.c

diff --git a/arch/arm/include/asm/arch-meson/s6.h b/arch/arm/include/asm/arch-meson/s6.h
new file mode 100644
index 00000000..079cc568
--- /dev/null
+++ b/arch/arm/include/asm/arch-meson/s6.h
@@ -0,0 +1,52 @@
+/* SPDX-License-Identifier: GPL-2.0+ */
+/*
+ * Copyright (c) 2026 Piotr Oniszczuk <piotr.oniszczuk@gmail.com>
+ */
+
+#ifndef __S6_H__
+#define __S6_H__
+
+#include <linux/bitops.h>
+#include <linux/sizes.h>
+
+#define S6_WDT_CTRL			0xfe002100
+#define S6_WDT_CTRL_EN			BIT(18)
+
+/*
+ * The secure firmware reports the boot device and its reserved memory
+ * zones in the SYSCTRL SEC_STATUS registers, with the same layout as on
+ * S4.
+ */
+#define S6_SYSCTRL_BASE			0xfe010000
+#define S6_SYSCTRL_ADDR(off)		(S6_SYSCTRL_BASE + ((off) << 2))
+
+#define S6_SEC_STATUS_REG2		S6_SYSCTRL_ADDR(0xc2)
+#define S6_SEC_STATUS_REG15		S6_SYSCTRL_ADDR(0xcf)
+#define S6_SEC_STATUS_REG16		S6_SYSCTRL_ADDR(0xd0)
+#define S6_SEC_STATUS_REG17		S6_SYSCTRL_ADDR(0xd1)
+
+#define S6_BOOT_DEVICE_MASK		0xF0
+#define S6_BOOT_DEVICE_SHIFT		4
+#define S6_BL31_RSVMEM_SIZE_MASK	0xFFFF0000
+#define S6_BL31_RSVMEM_SIZE_SHIFT	16
+#define S6_BL32_RSVMEM_SIZE_MASK	0xFFFF
+#define S6_RSVMEM_SIZE_64K_UNITS	0x00F00000
+
+/*
+ * Memory owned by the secure world, as reserved (no-map) by the vendor
+ * device tree: the secure monitor / TEE zone and the MTE tag storage.
+ * Both are left unmapped in the S6 memory map, so that U-Boot never
+ * touches them.
+ */
+#define S6_SECMON_RSVMEM_START		0x05000000UL
+#define S6_SECMON_RSVMEM_SIZE		0x01b00000UL
+#define S6_MTE_RSVMEM_START		0x0c000000UL
+#define S6_MTE_RSVMEM_SIZE		0x08000000UL
+
+/* The first DRAM bank ends where the peripherals start */
+#define S6_DRAM_BANK0_MAX		0xe0000000UL
+/* Further DRAM is mapped above 4 GiB */
+#define S6_DRAM_BANK1_START		0x100000000UL
+#define S6_DRAM_BANK1_MAX		0x100000000UL
+
+#endif /* __S6_H__ */
diff --git a/arch/arm/mach-meson/Kconfig b/arch/arm/mach-meson/Kconfig
index bd261a6d..1c0cb291 100644
--- a/arch/arm/mach-meson/Kconfig
+++ b/arch/arm/mach-meson/Kconfig
@@ -82,6 +82,13 @@ config MESON_T7
 	help
 	  Select this if your SoC is an A311D2
 
+config MESON_S6
+	bool "S6"
+	select MESON64_COMMON
+	select ENABLE_ARM_SOC_BOOT0_HOOK
+	help
+	  Select this if your SoC is an S905X5
+
 endchoice
 
 config SYS_SOC
@@ -107,6 +114,7 @@ config SYS_BOARD
 	default "s400" if MESON_AXG
 	default "u200" if MESON_G12A
 	default "vim4" if MESON_T7
+	default "bl201" if MESON_S6
 	default ""
 	help
 	  This option contains information about board name.
diff --git a/arch/arm/mach-meson/Makefile b/arch/arm/mach-meson/Makefile
index ef8e8ddb..e1494354 100644
--- a/arch/arm/mach-meson/Makefile
+++ b/arch/arm/mach-meson/Makefile
@@ -19,3 +19,4 @@ obj-$(CONFIG_MESON_G12A) += board-g12a.o
 obj-$(CONFIG_MESON_A1) += board-a1.o
 obj-$(CONFIG_MESON_S4) += board-s4.o
 obj-$(CONFIG_MESON_T7) += board-t7.o
+obj-$(CONFIG_MESON_S6) += board-s6.o
diff --git a/arch/arm/mach-meson/board-s6.c b/arch/arm/mach-meson/board-s6.c
new file mode 100644
index 00000000..96f26a63
--- /dev/null
+++ b/arch/arm/mach-meson/board-s6.c
@@ -0,0 +1,166 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Copyright (c) 2026 Piotr Oniszczuk <piotr.oniszczuk@gmail.com>
+ *
+ * Amlogic S6 (S905X5) SoC support, based on the T7 and S4 support.
+ */
+
+#include <fdtdec.h>
+#include <init.h>
+#include <asm/arch/boot.h>
+#include <asm/arch/mem.h>
+#include <asm/arch/s6.h>
+#include <asm/armv8/mmu.h>
+#include <asm/global_data.h>
+#include <asm/io.h>
+#include <linux/errno.h>
+#include <linux/kernel.h>
+#include <linux/sizes.h>
+#include <linux/string.h>
+
+DECLARE_GLOBAL_DATA_PTR;
+
+int board_init(void)
+{
+	/*
+	 * The secure firmware may boot BL33 with the watchdog running,
+	 * disable it.
+	 */
+	writel(readl(S6_WDT_CTRL) & ~S6_WDT_CTRL_EN, S6_WDT_CTRL);
+
+	return 0;
+}
+
+int meson_get_boot_device(void)
+{
+	return (readl(S6_SEC_STATUS_REG2) & S6_BOOT_DEVICE_MASK)
+		>> S6_BOOT_DEVICE_SHIFT;
+}
+
+/*
+ * Reserve the secure world memory for the OS: the BL31 and BL32 zones
+ * that the secure firmware reports in SEC_STATUS_REG15 (sizes), REG16
+ * (BL32 start) and REG17 (BL31 start), as on S4, and the whole secure
+ * monitor and MTE tag zones that are not mapped by U-Boot.
+ */
+void meson_init_reserved_memory(void *fdt)
+{
+	u64 bl31_size, bl31_start;
+	u64 bl32_size, bl32_start;
+	u64 unit = SZ_1K;
+	u32 reg;
+
+	reg = readl(S6_SEC_STATUS_REG15);
+	if (reg & S6_RSVMEM_SIZE_64K_UNITS)
+		unit = SZ_64K;
+
+	bl31_size = ((reg & S6_BL31_RSVMEM_SIZE_MASK)
+			>> S6_BL31_RSVMEM_SIZE_SHIFT) * unit;
+	bl32_size = (reg & S6_BL32_RSVMEM_SIZE_MASK) * unit;
+
+	bl31_start = readl(S6_SEC_STATUS_REG17);
+	bl32_start = readl(S6_SEC_STATUS_REG16);
+
+	if (bl31_start && bl31_size)
+		meson_board_add_reserved_memory(fdt, bl31_start, bl31_size);
+
+	if (bl32_start && bl32_size)
+		meson_board_add_reserved_memory(fdt, bl32_start, bl32_size);
+
+	meson_board_add_reserved_memory(fdt, S6_SECMON_RSVMEM_START,
+					S6_SECMON_RSVMEM_SIZE);
+	meson_board_add_reserved_memory(fdt, S6_MTE_RSVMEM_START,
+					S6_MTE_RSVMEM_SIZE);
+}
+
+phys_size_t get_effective_memsize(void)
+{
+	/* Keep U-Boot in the first DRAM bank, below the peripherals */
+	return min(gd->ram_size, (phys_size_t)S6_DRAM_BANK0_MAX);
+}
+
+static struct mm_region s6_mem_map[] = {
+	{
+		/* DRAM below the secure monitor zone */
+		.virt = 0x00000000UL,
+		.phys = 0x00000000UL,
+		.size = S6_SECMON_RSVMEM_START,
+		.attrs = PTE_BLOCK_MEMTYPE(MT_NORMAL) |
+			 PTE_BLOCK_INNER_SHARE
+	}, {
+		/* DRAM between the secure monitor and the MTE tag zones */
+		.virt = S6_SECMON_RSVMEM_START + S6_SECMON_RSVMEM_SIZE,
+		.phys = S6_SECMON_RSVMEM_START + S6_SECMON_RSVMEM_SIZE,
+		.size = S6_MTE_RSVMEM_START -
+			(S6_SECMON_RSVMEM_START + S6_SECMON_RSVMEM_SIZE),
+		.attrs = PTE_BLOCK_MEMTYPE(MT_NORMAL) |
+			 PTE_BLOCK_INNER_SHARE
+	}, {
+		/* DRAM from the MTE tag zone to the end of the first bank */
+		.virt = S6_MTE_RSVMEM_START + S6_MTE_RSVMEM_SIZE,
+		.phys = S6_MTE_RSVMEM_START + S6_MTE_RSVMEM_SIZE,
+		.size = S6_DRAM_BANK0_MAX -
+			(S6_MTE_RSVMEM_START + S6_MTE_RSVMEM_SIZE),
+		.attrs = PTE_BLOCK_MEMTYPE(MT_NORMAL) |
+			 PTE_BLOCK_INNER_SHARE
+	}, {
+		/* Peripherals, GIC, ... */
+		.virt = 0xe0000000UL,
+		.phys = 0xe0000000UL,
+		.size = 0x20000000UL,
+		.attrs = PTE_BLOCK_MEMTYPE(MT_DEVICE_NGNRNE) |
+			 PTE_BLOCK_NON_SHARE |
+			 PTE_BLOCK_PXN | PTE_BLOCK_UXN
+	}, {
+		/*
+		 * DRAM above 4 GiB. Sized for the largest configuration so
+		 * that enough page tables get reserved, trimmed to the real
+		 * size in dram_init_banksize().
+		 */
+		.virt = S6_DRAM_BANK1_START,
+		.phys = S6_DRAM_BANK1_START,
+		.size = S6_DRAM_BANK1_MAX,
+		.attrs = PTE_BLOCK_MEMTYPE(MT_NORMAL) |
+			 PTE_BLOCK_INNER_SHARE
+	}, {
+		/* List terminator */
+		0,
+	}
+};
+
+#define S6_MEM_MAP_BANK1	4
+
+struct mm_region *mem_map = s6_mem_map;
+
+/*
+ * The first bank may be followed by DRAM above 4 GiB (4 GiB boards and
+ * above), pass all the banks of the device tree to the OS and only map
+ * the DRAM that is really there.
+ */
+int dram_init_banksize(void)
+{
+	phys_size_t bank1_size = 0;
+	int ret, i;
+
+	ret = fdtdec_setup_memory_banksize();
+	if (ret)
+		return ret;
+
+	gd->dram[0].size = min_t(phys_size_t, gd->dram[0].size,
+				 get_effective_memsize());
+
+	for (i = 1; i < CONFIG_NR_DRAM_BANKS; i++) {
+		if (gd->dram[i].start == S6_DRAM_BANK1_START)
+			bank1_size = gd->dram[i].size;
+	}
+
+	if (bank1_size)
+		s6_mem_map[S6_MEM_MAP_BANK1].size =
+			min_t(phys_size_t, bank1_size, S6_DRAM_BANK1_MAX);
+	else
+		/* No DRAM above 4 GiB: end the memory map before it */
+		memset(&s6_mem_map[S6_MEM_MAP_BANK1], 0,
+		       sizeof(s6_mem_map[S6_MEM_MAP_BANK1]));
+
+	return 0;
+}
diff --git a/include/configs/meson64.h b/include/configs/meson64.h
index 83c216b9..0394841f 100644
--- a/include/configs/meson64.h
+++ b/include/configs/meson64.h
@@ -148,6 +148,21 @@
 #define KERNEL_COMP_ADDR_R	__stringify(0x12000000)
 #define KERNEL_COMP_SIZE	"0x4000000"
 #define RAMDISK_ADDR_R		__stringify(0x16000000)
+#elif defined(CONFIG_MESON_S6)
+/*
+ * 0x05000000 - 0x06b00000 (secure monitor) and 0x0c000000 - 0x14000000
+ * (MTE tags) belong to the secure world and are not mapped, keep all load
+ * addresses above them.
+ */
+#define PXEFILE_ADDR_R		__stringify(0x14100000)
+#define FDTOVERLAY_ADDR_R	__stringify(0x14200000)
+#define SCRIPT_ADDR_R		__stringify(0x14300000)
+#define FDT_ADDR_R		__stringify(0x14400000)
+/* 128 MiB for the kernel image, then the decompression buffer and initrd */
+#define KERNEL_ADDR_R		__stringify(0x15000000)
+#define KERNEL_COMP_ADDR_R	__stringify(0x1d000000)
+#define KERNEL_COMP_SIZE	"0x4000000"
+#define RAMDISK_ADDR_R		__stringify(0x21000000)
 #else
 #define KERNEL_ADDR_R		__stringify(0x08080000)
 #define FDT_ADDR_R		__stringify(0x08008000)
-- 
