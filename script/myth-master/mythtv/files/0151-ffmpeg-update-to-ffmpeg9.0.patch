diff --git a/mythtv/external/FFmpeg/libavformat/pdvenc.c b/mythtv/external/FFmpeg/libavformat/pdvenc.c
new file mode 100644
index 00000000000..4f70fd3ad8f
--- /dev/null
+++ b/mythtv/external/FFmpeg/libavformat/pdvenc.c
@@ -0,0 +1,223 @@
+/*
+ * PDV muxer
+ *
+ * Copyright (c) 2026 Priyanshu Thapliyal <priyanshuthapliyal2005@gmail.com>
+ *
+ * This file is part of FFmpeg.
