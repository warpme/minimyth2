 drivers/gpu/drm/rockchip/rockchip_drm_vop2.c |  67 +++-
 drivers/gpu/drm/rockchip/rockchip_drm_vop2.h |  28 ++
 drivers/gpu/drm/rockchip/rockchip_vop2_reg.c | 373 +++++++++++++++++++
 3 files changed, 465 insertions(+), 3 deletions(-)

diff --git a/drivers/gpu/drm/rockchip/rockchip_drm_vop2.c b/drivers/gpu/drm/rockchip/rockchip_drm_vop2.c
index 2713ce0..2d8f0c3 100644
--- a/drivers/gpu/drm/rockchip/rockchip_drm_vop2.c
+++ b/drivers/gpu/drm/rockchip/rockchip_drm_vop2.c
@@ -337,7 +337,8 @@ static bool vop2_output_uv_swap(u32 bus_format, u32 output_mode)
 
 static bool vop2_output_rg_swap(struct vop2 *vop2, u32 bus_format)
 {
-	if (vop2->version == VOP_VERSION_RK3588 ||
+	if (vop2->version == VOP_VERSION_RK3528 ||
+	    vop2->version == VOP_VERSION_RK3588 ||
 	    vop2->version == VOP_VERSION_RK3576) {
 		if (bus_format == MEDIA_BUS_FMT_YUV8_1X24 ||
 		    bus_format == MEDIA_BUS_FMT_YUV10_1X30)
@@ -564,7 +565,23 @@ static void vop2_setup_scale(struct vop2 *vop2, const struct vop2_win *win,
 
 	info = drm_format_info(pixel_format);
 
-	if (src_h >= (4 * dst_h)) {
+	/*
+	 * The RK3528 VOP processes 2 pixels per cycle, so for sources wider
+	 * than 1920 the vertical pre-scale down (gt2/gt4) needs to kick in
+	 * earlier to keep up:
+	 * dst_h / src_h in [1, 0.65)     gt2 = 0, gt4 = 0
+	 * dst_h / src_h in [0.65, 0.35)  gt2 = 1, gt4 = 0
+	 * dst_h / src_h in [0.35, 0)     gt2 = 0, gt4 = 1
+	 */
+	if (vop2->version == VOP_VERSION_RK3528 && src_w > 1920) {
+		if (src_h >= (100 * dst_h / 35)) {
+			gt4 = 1;
+			src_h >>= 2;
+		} else if (src_h >= (100 * dst_h / 65)) {
+			gt2 = 1;
+			src_h >>= 1;
+		}
+	} else if (src_h >= (4 * dst_h)) {
 		gt4 = 1;
 		src_h >>= 2;
 	} else if (src_h >= (2 * dst_h)) {
@@ -621,7 +638,15 @@ static void vop2_setup_scale(struct vop2 *vop2, const struct vop2_win *win,
 		gt4 = 0;
 		gt2 = 0;
 
-		if (cbcr_src_h >= (4 * dst_h)) {
+		if (vop2->version == VOP_VERSION_RK3528 && src_w > 1920) {
+			if (cbcr_src_h >= (100 * dst_h / 35)) {
+				gt4 = 1;
+				cbcr_src_h >>= 2;
+			} else if (cbcr_src_h >= (100 * dst_h / 65)) {
+				gt2 = 1;
+				cbcr_src_h >>= 1;
+			}
+		} else if (cbcr_src_h >= (4 * dst_h)) {
 			gt4 = 1;
 			cbcr_src_h >>= 2;
 		} else if (cbcr_src_h >= (2 * dst_h)) {
@@ -895,6 +920,14 @@ static void vop2_enable(struct vop2 *vop2)
 	}
 
 	version = vop2_readl(vop2, RK3568_VERSION_INFO);
+	/*
+	 * The build number (bits 15:0) differs between RK3528 chip revisions
+	 * (e.g. 0x1263 vs 0x4334), only check the major/minor version there.
+	 */
+	if (vop2->version == VOP_VERSION_RK3528)
+		version = (version & GENMASK(31, 16)) |
+			  (vop2->version & GENMASK(15, 0));
+
 	if (version != vop2->version) {
 		drm_err(vop2->drm, "Hardware version(0x%08x) mismatch\n", version);
 		return;
@@ -924,6 +957,25 @@ static void vop2_enable(struct vop2 *vop2)
 	regmap_clear_bits(vop2->map, RK3568_SYS_AUTO_GATING_CTRL,
 			  RK3568_SYS_AUTO_GATING_CTRL__AUTO_GATING_EN);
 
+	if (vop2->version == VOP_VERSION_RK3528) {
+		/*
+		 * The aclk pre auto gating may disable the aclk in some
+		 * unexpected cases detected by hardware, e.g. when the post
+		 * scaler is in use, resulting in an abnormal display.
+		 */
+		regmap_clear_bits(vop2->map, RK3568_SYS_AUTO_GATING_CTRL,
+				  RK3528_SYS_AUTO_GATING_CTRL__ACLK_PRE_AUTO_GATING_EN);
+
+		/*
+		 * Split the Esmart line buffers as 4K (Esmart0) + 2K (Esmart2)
+		 * + 2K (Esmart3); Esmart1 has no line buffer in this mode.
+		 */
+		regmap_update_bits(vop2->map, RK3568_LUT_PORT_SEL,
+				   RK3528_LUT_PORT_SEL__ESMART_LB_MODE,
+				   FIELD_PREP(RK3528_LUT_PORT_SEL__ESMART_LB_MODE,
+					      RK3528_ESMART_LB_MODE_4K_2K_2K));
+	}
+
 	vop2_writel(vop2, RK3568_SYS0_INT_CLR,
 		    VOP2_INT_BUS_ERRPR << 16 | VOP2_INT_BUS_ERRPR);
 	vop2_writel(vop2, RK3568_SYS0_INT_EN,
@@ -1131,6 +1183,15 @@ static int vop2_plane_atomic_check(struct drm_plane *plane,
 		return -EINVAL;
 	}
 
+	if ((win->data->max_output.width && dest_w > win->data->max_output.width) ||
+	    (win->data->max_output.height && dest_h > win->data->max_output.height)) {
+		drm_dbg_kms(vop2->drm, "Invalid destination: %dx%d. max output for %s: %dx%d\n",
+			    dest_w, dest_h, win->data->name,
+			    win->data->max_output.width,
+			    win->data->max_output.height);
+		return -EINVAL;
+	}
+
 	/*
 	 * Src.x1 can be odd when do clip, but yuv plane start point
 	 * need align with 2 pixel.
