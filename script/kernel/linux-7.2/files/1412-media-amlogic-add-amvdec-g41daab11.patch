+void meson_amvdec_amrisc_test_init(struct amvdec_core *core)
+{
+	at_image = kzalloc(AT_IMAGE_SIZE, GFP_KERNEL);
+	at_result = kzalloc(AT_RESULT_SIZE, GFP_KERNEL);
+	at_reglist = kcalloc(AT_MAX_REGS, sizeof(u32), GFP_KERNEL);
+	ah_reglist = kcalloc(AT_MAX_REGS, sizeof(u32), GFP_KERNEL);
+	ah_prog = kcalloc(AH_PROG_MAX, sizeof(*ah_prog), GFP_KERNEL);
+	at_alloc = dma_alloc_coherent(core->dev, AT_ALLOC_SIZE, &at_alloc_map,
+				      GFP_KERNEL);
+	if (!at_image || !at_result || !at_reglist || !ah_reglist || !ah_prog || !at_alloc)
+		goto fail;
+	memset(at_alloc, 0, AT_ALLOC_SIZE);
+	/* firmware sees the data region, not the low canary */
+	at_alloc_map += AT_CANARY_SIZE;
+
+	at_fb_alloc = dma_alloc_coherent(core->dev, AT_FB_ALLOC_SIZE, &at_fb_map,
+					 GFP_KERNEL);
+	if (at_fb_alloc) {
+		int i;
+
+		memset(at_fb_alloc, 0, AT_FB_ALLOC_SIZE);
+		at_fb_map += AT_CANARY_SIZE;
+		at_canvas_ok = true;
+		for (i = 0; i < AT_NUM_CANVAS; i++) {
+			if (meson_canvas_alloc(core->canvas, &at_canvas[i])) {
+				at_canvas_ok = false;
+				dev_warn(core->dev, "amrisc-test: only %d canvases\n", i);
+				break;
+			}
+		}
+	}
+	at_canary_fill();
+	at_arch = dma_alloc_coherent(core->dev, AT_ARCH_SIZE, &at_arch_map, GFP_KERNEL);
+	ah_lmem_alloc = dma_alloc_coherent(core->dev, AH_LMEM_ALLOC_SIZE, &ah_lmem_map,
+					   GFP_KERNEL);
+	if (ah_lmem_alloc) {
+		memset(ah_lmem_alloc, 0, AH_LMEM_ALLOC_SIZE);
+		ah_lmem_map += AT_CANARY_SIZE;
+		at_canary_fill_one(ah_lmem_alloc, AH_LMEM_SIZE);
+	}
+
+	at_dir = debugfs_create_dir("amrisc-test", NULL);
+	if (IS_ERR_OR_NULL(at_dir))
+		goto fail;
+
+	debugfs_create_file("image", 0200, at_dir, NULL, &at_image_fops);
+	debugfs_create_file("run", 0200, at_dir, NULL, &at_run_fops);
+	debugfs_create_file("result", 0400, at_dir, NULL, &at_result_fops);
+	debugfs_create_file("buf", 0600, at_dir, NULL, &at_buf_fops);
+	debugfs_create_file("buf_paddr", 0400, at_dir, NULL, &at_buf_paddr_fops);
+	debugfs_create_file("fb", 0600, at_dir, NULL, &at_fb_fops);
+	debugfs_create_file("fb_paddr", 0400, at_dir, NULL, &at_fb_paddr_fops);
+	debugfs_create_file("archive", 0400, at_dir, NULL, &at_arch_fops);
+	debugfs_create_u32("archive_frames", 0400, at_dir, &at_arch_frames);
+	debugfs_create_u32("fb_w", 0600, at_dir, &at_fb_w);
+	debugfs_create_u32("fb_h", 0600, at_dir, &at_fb_h);
+	debugfs_create_file("reglist", 0200, at_dir, NULL, &at_reglist_fops);
+	debugfs_create_file("regs", 0400, at_dir, NULL, &at_regs_fops);
+	debugfs_create_u32("run_ms", 0600, at_dir, &at_run_ms);
+	debugfs_create_u32("load_only", 0600, at_dir, &at_load_only);
+	debugfs_create_u32("imem_dma_ctrl", 0600, at_dir, &at_imem_dma_ctrl);
+	debugfs_create_u32("imem_dma_count", 0600, at_dir, &at_imem_dma_count);
+	debugfs_create_u32("arg0", 0600, at_dir, &at_arg0);
+	debugfs_create_u32("arg1", 0600, at_dir, &at_arg1);
+	debugfs_create_u32("scratch0", 0600, at_dir, &at_scratch0);
+	debugfs_create_u32("scratch1", 0600, at_dir, &at_scratch1);
+	debugfs_create_u32("auto_ack", 0600, at_dir, &at_auto_ack);
+	debugfs_create_u32("fifo_bytes", 0600, at_dir, &at_fifo_bytes);
+	debugfs_create_u32("fifo_pad", 0600, at_dir, &at_fifo_pad);
+	debugfs_create_u32("mpeg12_init", 0600, at_dir, &at_mpeg12_init);
+	/* HEVC-core AMRISC */
+	debugfs_create_u32("core", 0600, at_dir, &at_core_sel);
+	debugfs_create_u32("hevc_stream_bytes", 0600, at_dir, &ah_stream_bytes);
+	debugfs_create_u32("hevc_stream_ctl", 0600, at_dir, &ah_stream_ctl);
+	debugfs_create_u32("hevc_wait", 0600, at_dir, &ah_wait);
+	debugfs_create_u32("hevc_lmem_words", 0600, at_dir, &ah_lmem_words);
+	debugfs_create_u32("hevc_lmem_ctrl", 0600, at_dir, &ah_lmem_ctrl);
+	debugfs_create_u32("hevc_irq_us", 0400, at_dir, &ah_irq_us);
+	debugfs_create_file("hevc_reglist", 0200, at_dir, NULL, &ah_reglist_fops);
+	debugfs_create_file("hevc_prog", 0200, at_dir, NULL, &ah_prog_fops);
+	debugfs_create_file("hevc_regs", 0400, at_dir, NULL, &ah_regs_fops);
+	debugfs_create_file("hevc_lmem", 0400, at_dir, NULL, &ah_lmem_fops);
+	debugfs_create_file("hevc_lmem_paddr", 0400, at_dir, NULL, &ah_lmem_paddr_fops);
+	debugfs_create_file("hevc_state", 0400, at_dir, NULL, &ah_state_fops);
+	at_core = core;
+	dev_info(core->dev, "amrisc-test harness registered, buf at %pad fb at %pad\n",
+		 &at_alloc_map, &at_fb_map);
+	return;
+
+fail:
+	if (at_alloc)
+		dma_free_coherent(core->dev, AT_ALLOC_SIZE, at_alloc, at_alloc_map);
+	kfree(at_image);
+	kfree(at_result);
+	kfree(at_reglist);
+	kfree(ah_reglist);
+	ah_reglist = NULL;
+	kfree(ah_prog);
+	ah_prog = NULL;
+	at_alloc = NULL;
+	at_image = NULL;
+	at_result = NULL;
+	at_reglist = NULL;
+	at_dir = NULL;
+}
+
+void meson_amvdec_amrisc_test_exit(void)
+{
+	mutex_lock(&at_lock);
+	debugfs_remove_recursive(at_dir);
+	at_dir = NULL;
+	if (ah_stuck) {
+		/*
+		 * A failed HEVC stop left the core powered with its DMC ports
+		 * parked: it may still address the harness buffers.  Leak them
+		 * rather than hand them back to the allocator.
+		 */
+		dev_warn(at_core->dev,
+			 "amrisc-test: HEVC core left up by a failed stop, DMA buffers leaked\n");
+		at_alloc = NULL;
+		at_fb_alloc = NULL;
+		at_arch = NULL;
+		ah_lmem_alloc = NULL;
+	}
+	if (ah_lmem_alloc)
+		dma_free_coherent(at_core->dev, AH_LMEM_ALLOC_SIZE, ah_lmem_alloc,
+				  ah_lmem_map - AT_CANARY_SIZE);
+	ah_lmem_alloc = NULL;
+	if (at_alloc)
+		dma_free_coherent(at_core->dev, AT_ALLOC_SIZE, at_alloc,
+				  at_alloc_map - AT_CANARY_SIZE);
+	if (at_arch)
+		dma_free_coherent(at_core->dev, AT_ARCH_SIZE, at_arch, at_arch_map);
+	at_arch = NULL;
+	if (at_fb_alloc) {
+		int i;
+
+		for (i = 0; i < AT_NUM_CANVAS && (at_canvas_ok || i < AT_NUM_CANVAS); i++)
+			if (at_canvas[i])
+				meson_canvas_free(at_core->canvas, at_canvas[i]);
+		dma_free_coherent(at_core->dev, AT_FB_ALLOC_SIZE, at_fb_alloc,
+				  at_fb_map - AT_CANARY_SIZE);
+		at_fb_alloc = NULL;
+	}
+	at_core = NULL;
+	kfree(at_image);
+	kfree(at_result);
+	kfree(at_reglist);
+	kfree(ah_reglist);
+	kfree(ah_prog);
+	ah_prog = NULL;
+	at_alloc = NULL;
+	at_image = NULL;
+	at_result = NULL;
+	at_reglist = NULL;
+	ah_reglist = NULL;
+	mutex_unlock(&at_lock);
+}
