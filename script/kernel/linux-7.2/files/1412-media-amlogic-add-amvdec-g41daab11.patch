+	static char line[1 << 20];
+	char name[256] = "";
+	static struct v4l2_ctrl_hevc_sps sps;
+	static struct v4l2_ctrl_hevc_pps pps;
+	static struct v4l2_ctrl_hevc_decode_params dp;
+	static struct v4l2_ctrl_hevc_scaling_matrix sm;
