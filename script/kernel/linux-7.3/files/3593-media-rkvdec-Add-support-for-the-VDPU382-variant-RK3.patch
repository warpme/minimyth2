+
 static const struct rkvdec_coded_fmt_desc vdpu383_coded_fmts[] = {
 	{
 		.fourcc = V4L2_PIX_FMT_HEVC_SLICE,
@@ -1468,6 +1527,14 @@ static void rkvdec_device_run(void *priv)
 		return;
 	}
 
+	if (rkvdec->variant->ops->prepare) {
+		ret = rkvdec->variant->ops->prepare(rkvdec);
+		if (ret) {
+			rkvdec_job_finish(ctx, VB2_BUF_STATE_ERROR);
+			return;
+		}
+	}
+
 	ret = desc->ops->run(ctx);
 	if (ret)
 		rkvdec_job_finish(ctx, VB2_BUF_STATE_ERROR);
@@ -1531,9 +1598,24 @@ static int rkvdec_add_ctrls(struct rkvdec_ctx *ctx,
 	unsigned int i;
 
 	for (i = 0; i < ctrls->num_ctrls; i++) {
-		const struct v4l2_ctrl_config *cfg = &ctrls->ctrls[i].cfg;
+		struct v4l2_ctrl_config cfg = ctrls->ctrls[i].cfg;
+
+		/* Limit the advertised capabilities of the VDPU382 */
+		if (ctx->dev->variant->is_vdpu382) {
+			switch (cfg.id) {
+			case V4L2_CID_MPEG_VIDEO_HEVC_LEVEL:
+				cfg.max = V4L2_MPEG_VIDEO_HEVC_LEVEL_5_1;
+				break;
+			case V4L2_CID_MPEG_VIDEO_H264_PROFILE:
+				cfg.max = V4L2_MPEG_VIDEO_H264_PROFILE_HIGH;
+				break;
+			case V4L2_CID_MPEG_VIDEO_H264_LEVEL:
+				cfg.max = V4L2_MPEG_VIDEO_H264_LEVEL_5_1;
+				break;
+			}
+		}
 
-		v4l2_ctrl_new_custom(&ctx->ctrl_hdl, cfg, ctx);
+		v4l2_ctrl_new_custom(&ctx->ctrl_hdl, &cfg, ctx);
 		if (ctx->ctrl_hdl.error)
 			return ctx->ctrl_hdl.error;
 	}
@@ -1780,6 +1862,87 @@ static irqreturn_t vdpu381_irq_handler(struct rkvdec_ctx *ctx)
 	return IRQ_HANDLED;
 }
 
+#define VDPU382_CACHE_NUM		3
+#define VDPU382_CACHE_STRIDE		0x40
+#define VDPU382_CACHE_CLEAR		0x00
+#define VDPU382_CACHE_CONFIG		0x0c
+#define VDPU382_CACHE_PERMIT_CACHEABLE	BIT(0)
+#define VDPU382_CACHE_PERMIT_READ_ALLOC	BIT(1)
+#define VDPU382_CACHE_LINE_SIZE_64B	BIT(4)
+#define VDPU382_REG_RESET_CTRL		0x334
+#define VDPU382_ERROR_AUTO_RST_DISABLE	BIT(4)
+#define VDPU382_STA_INT_ERR_MASK	GENMASK(7, 3)
+
+/*
+ * On VDPU382 the decoder is reset together with its IOMMU. Reprogram the
+ * IOMMU through an empty domain, as done by rkvdec_iommu_restore(), and
+ * also pulse the CRU resets, if any, while the empty domain is attached.
+ */
+static void vdpu382_reset(struct rkvdec_dev *rkvdec)
+{
+	if (rkvdec->empty_domain)
+		iommu_attach_device(rkvdec->empty_domain, rkvdec->dev);
+
+	if (rkvdec->resets) {
+		reset_control_assert(rkvdec->resets);
+		udelay(5);
+		reset_control_deassert(rkvdec->resets);
+	}
+
+	if (rkvdec->empty_domain)
+		iommu_detach_device(rkvdec->empty_domain, rkvdec->dev);
+
+	writel(0, rkvdec->regs + VDPU381_REG_STA_INT);
+	rkvdec->needs_reset = false;
+}
+
+static int vdpu382_prepare(struct rkvdec_dev *rkvdec)
+{
+	u32 val = VDPU382_CACHE_PERMIT_CACHEABLE |
+		  VDPU382_CACHE_PERMIT_READ_ALLOC |
+		  VDPU382_CACHE_LINE_SIZE_64B;
+	unsigned int i;
+
+	if (rkvdec->needs_reset)
+		vdpu382_reset(rkvdec);
+
+	for (i = 0; i < VDPU382_CACHE_NUM; i++) {
+		void __iomem *cache = rkvdec->cache + i * VDPU382_CACHE_STRIDE;
+
+		writel(val, cache + VDPU382_CACHE_CONFIG);
+		writel(1, cache + VDPU382_CACHE_CLEAR);
+	}
+
+	/* Recover from errors in the IRQ handler, with the IOMMU attached */
+	writel(VDPU382_ERROR_AUTO_RST_DISABLE,
+	       rkvdec->regs + VDPU382_REG_RESET_CTRL);
+
+	return 0;
+}
+
+static irqreturn_t vdpu382_irq_handler(struct rkvdec_ctx *ctx)
+{
+	struct rkvdec_dev *rkvdec = ctx->dev;
+	enum vb2_buffer_state state;
+	u32 status;
+
+	status = readl(rkvdec->regs + VDPU381_REG_STA_INT);
+	writel(0, rkvdec->regs + VDPU381_REG_STA_INT);
+
+	if ((status & VDPU381_STA_INT_DEC_RDY_STA) &&
+	    !(status & VDPU382_STA_INT_ERR_MASK)) {
+		state = VB2_BUF_STATE_DONE;
+	} else {
+		state = VB2_BUF_STATE_ERROR;
+		vdpu382_reset(rkvdec);
+	}
+
+	if (cancel_delayed_work(&rkvdec->watchdog_work))
+		rkvdec_job_finish(ctx, state);
+
+	return IRQ_HANDLED;
+}
+
 static irqreturn_t vdpu383_irq_handler(struct rkvdec_ctx *ctx)
 {
 	struct rkvdec_dev *rkvdec = ctx->dev;
@@ -1900,7 +2063,10 @@ static void rkvdec_watchdog_func(struct work_struct *work)
 	ctx = v4l2_m2m_get_curr_priv(rkvdec->m2m_dev);
 	if (ctx) {
 		dev_err(rkvdec->dev, "Frame processing timed out!\n");
-		writel(RKVDEC_IRQ_DIS, rkvdec->regs + RKVDEC_REG_INTERRUPT);
+		if (rkvdec->variant->ops->reset)
+			rkvdec->variant->ops->reset(rkvdec);
+		else
+			writel(RKVDEC_IRQ_DIS, rkvdec->regs + RKVDEC_REG_INTERRUPT);
 		rkvdec_job_finish(ctx, VB2_BUF_STATE_ERROR);
 	}
 }
@@ -2027,6 +2193,23 @@ static const struct rcb_size_info vdpu383_rcb_sizes[] = {
 	{180,	PIC_HEIGHT},	// filterd_tile_col
 };
 
+static const struct rkvdec_variant_ops vdpu382_variant_ops = {
+	.irq_handler = vdpu382_irq_handler,
+	.prepare = vdpu382_prepare,
+	.reset = vdpu382_reset,
+	.colmv_size = rkvdec_colmv_size,
+	.flatten_matrices = transpose_and_flatten_matrices,
+};
+
+static const struct rkvdec_variant vdpu382_variant = {
+	.coded_fmts = vdpu382_coded_fmts,
+	.num_coded_fmts = ARRAY_SIZE(vdpu382_coded_fmts),
+	.rcb_sizes = vdpu381_rcb_sizes,
+	.num_rcb_sizes = ARRAY_SIZE(vdpu381_rcb_sizes),
+	.ops = &vdpu382_variant_ops,
+	.is_vdpu382 = true,
+};
+
 static const struct rkvdec_variant_ops vdpu383_variant_ops = {
 	.irq_handler = vdpu383_irq_handler,
 	.colmv_size = vdpu383_colmv_size,
@@ -2058,6 +2241,10 @@ static const struct of_device_id of_rkvdec_match[] = {
 		.compatible = "rockchip,rk3568-vdec",
 		.data = &vdpu346_variant,
 	},
+	{
+		.compatible = "rockchip,rk3528-vdec",
+		.data = &vdpu382_variant,
+	},
 	{
 		.compatible = "rockchip,rk3588-vdec",
 		.data = &vdpu381_variant,
@@ -2115,6 +2302,19 @@ static int rkvdec_probe(struct platform_device *pdev)
 			return PTR_ERR(rkvdec->link);
 	}
 
+	if (rkvdec->variant->is_vdpu382) {
+		rkvdec->cache = devm_platform_ioremap_resource_byname(pdev, "cache");
+		if (IS_ERR(rkvdec->cache))
+			return PTR_ERR(rkvdec->cache);
+
+		rkvdec->resets = devm_reset_control_array_get_optional_exclusive(&pdev->dev);
+		if (IS_ERR(rkvdec->resets))
+			return dev_err_probe(&pdev->dev, PTR_ERR(rkvdec->resets),
+					     "failed to get resets\n");
+
+		rkvdec->needs_reset = true;
+	}
+
 	ret = dma_set_coherent_mask(&pdev->dev, DMA_BIT_MASK(32));
 	if (ret) {
 		dev_err(&pdev->dev, "Could not set DMA coherent mask.\n");
@@ -2230,6 +2430,9 @@ static int rkvdec_runtime_suspend(struct device *dev)
 {
 	struct rkvdec_dev *rkvdec = dev_get_drvdata(dev);
 
+	if (rkvdec->variant->is_vdpu382)
+		rkvdec->needs_reset = true;
+
 	clk_bulk_disable_unprepare(rkvdec->num_clocks, rkvdec->clocks);
 	return 0;
 }
