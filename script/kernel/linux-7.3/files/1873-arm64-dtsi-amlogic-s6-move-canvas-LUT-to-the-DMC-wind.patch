From 3e2a8164906061e795a651dde0eccdd2e5cfb44d Mon Sep 17 00:00:00 2001
From: Piotr Oniszczuk <piotr.oniszczuk@gmail.com>
Date: Wed, 18 Nov 2026 17:52:59 +0100
Subject: [PATCH 9/9] arm64: dts: amlogic: s6: move canvas LUT to the DMC
 window

The vendor DT puts the DMC at 0xfe036000, so the canvas LUT is at
0xfe036048 as on S4/T7, not at the G12A address 0xff638048 used by the
earlier VPU patch.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 arch/arm64/boot/dts/amlogic/amlogic-s6.dtsi | 12 ++++++------
 1 file changed, 6 insertions(+), 6 deletions(-)

diff --git a/arch/arm64/boot/dts/amlogic/amlogic-s6.dtsi b/arch/arm64/boot/dts/amlogic/amlogic-s6.dtsi
index 0177b7a61..c5a5cbd0e 100644
--- a/arch/arm64/boot/dts/amlogic/amlogic-s6.dtsi
+++ b/arch/arm64/boot/dts/amlogic/amlogic-s6.dtsi
@@ -886,6 +886,12 @@ vdec: video-decoder@320000 {
 				status = "disabled";
 			};
 
+			/* Canvas LUT in the DMC window (0xfe036000), as on S4/T7 */
+			canvas: video-lut@36048 {
+				compatible = "amlogic,canvas";
+				reg = <0x0 0x36048 0x0 0x14>;
+			};
+
 			clk_msr: clock-measure@48000 {
 				compatible = "amlogic,s6-clk-measure";
 				reg = <0x0 0x48000 0x0 0x1c>;
@@ -1343,12 +1349,6 @@ emmc: mmc@fe08c000 {
 			assigned-clock-rates = <24000000>;
 		};
 
-		/* Canvas LUT in the DMC, same offset as on G12A */
-		canvas: video-lut@ff638048 {
-			compatible = "amlogic,canvas";
-			reg = <0x0 0xff638048 0x0 0x14>;
-		};
-
 		vpu: vpu@ff000000 {
 			compatible = "amlogic,meson-s6-vpu";
 			reg = <0x0 0xff000000 0x0 0x40000>,
-- 
2.43.0

