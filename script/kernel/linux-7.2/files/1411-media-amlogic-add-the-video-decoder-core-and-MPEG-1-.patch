+ * meson_amvdec_esparser_queue_eos() - write End Of Stream sequence to the ESPARSER
+ *
+ * @core: vdec core struct
+ * @data: EOS sequence
+ * @len: length of EOS sequence
+ */
+int meson_amvdec_esparser_queue_eos(struct amvdec_core *core, const u8 *data, u32 len);
+
+/**
+ * meson_amvdec_esparser_queue_all_src() - work handler that writes as many src buffers
+ * as possible to the ESPARSER
+ *
+ * @work: work struct
+ */
+void meson_amvdec_esparser_queue_all_src(struct work_struct *work);
+
