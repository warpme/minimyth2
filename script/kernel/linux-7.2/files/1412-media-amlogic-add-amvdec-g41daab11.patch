diff --speed-large-files --no-dereference --minimal -Naur linux-7.2.8/drivers/media/platform/amlogic/amvdec/tests/t11_slotcall.s linux-7.2.8/drivers/media/platform/amlogic/amvdec/tests/t11_slotcall.s
--- linux-7.2.8/drivers/media/platform/amlogic/amvdec/tests/t11_slotcall.s	1970-01-01 01:00:00.000000000 +0100
+++ linux-7.2.8/drivers/media/platform/amlogic/amvdec/tests/t11_slotcall.s	2026-10-02 08:55:53.000000000 +0200
@@ -0,0 +1,67 @@
+; T11 - side effects of suppressed control transfers in a taken branch's delay slot.
+; S0 = MSP after `beq taken; call sub` (0x3f = push suppressed, 0x3e = pushed)
+; S1 = 0xbb if the fall-through after the slot ran (should stay 0)
+; S2 = 1 if sub executed (should stay 0)
+; S3 = r6 after `beq taken; dbnz r6` with r6=5 (5 = no decrement, 4 = decremented)
+; S4 = MSP after `beq taken; ret` (0x3f = ret suppressed and no pop; else changed)
+; S9 = 0xdd end
+.org 0x0
+    jmp start
+    nop
+.org 0x20
+    ret
+    ei
+    ret
+    ei
+    ret
+    ei
+    ret
+    ei
+    ret
+    ei
+    ret
+    ei
+    ret
+    ei
+    ret
+    ei
+    ret
+    ei
+.org 0x40
+start:
+    movi r0, #0xffff
+    mtsp MCPU_INTR_MSK, r0
+    movi r4, #0
+    movi r20, #0
+    beq r4, #0, tk1
+    call sub
+    mtspi AV_SCRATCH_1, #0xbb
+tk1:
+    mfsp r5, MSP
+    mtsp AV_SCRATCH_0, r5
+    mtsp AV_SCRATCH_2, r20
+    movi r6, #5
+    beq r4, #0, tk2
+    dbnz r6, tk1
+tk2:
+    mtsp AV_SCRATCH_3, r6
+    call depth1
+    nop
+    mtspi AV_SCRATCH_9, #0xdd
+end:
+    jmp end
+    nop
+
+depth1:
+    ; inside a call (MSP = 0x3e): a suppressed ret must not pop
+    beq r4, #0, tk3
+    ret
+tk3:
+    mfsp r5, MSP
+    mtsp AV_SCRATCH_4, r5
+    ret
+    nop
+sub:
+    movi r20, #1
+    ret
+    nop
