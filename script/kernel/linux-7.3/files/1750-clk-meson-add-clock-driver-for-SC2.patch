+static int meson_sc2_dvfs_setup(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	int ret;
+
+	/* Setup clock notifier for cpu_clk_postmux0 */
+	sc2_cpu_clk_postmux0_nb_data.fclk_div2 = &sc2_fclk_div2.hw;
+	ret = devm_clk_notifier_register(dev, sc2_cpu_clk_postmux0.hw.clk,
+					 &sc2_cpu_clk_postmux0_nb_data.nb);
+	if (ret)
+		return dev_err_probe(dev, ret,
+				     "failed to register the cpu_clk_postmux0 notifier\n");
+
+	/* Setup clock notifier for sys_pll */
+	ret = devm_clk_notifier_register(dev, sc2_sys_pll.hw.clk,
+					 &sc2_sys_pll_nb_data.nb);
+	if (ret)
+		return dev_err_probe(dev, ret,
+				     "failed to register the sys_pll notifier\n");
+
+	/* Setup clock notifier for dsu: set dsu_clk_premux1 parent to fclk_div2 (1G) */
+	ret = clk_set_parent(sc2_dsu_clk_premux1.hw.clk, sc2_fclk_div2.hw.clk);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to set the dsu parent\n");
+
+	ret = devm_clk_notifier_register(dev, sc2_dsu_clk_postmux0.hw.clk,
+					 &sc2_dsu_clk_postmux0_nb_data.nb);
+	if (ret)
+		return dev_err_probe(dev, ret,
+				     "failed to register the dsu notifier\n");
+
+	return 0;
+}
+
+static struct regmap *sc2_regmap_resource(struct platform_device *pdev,
+					  const char *name)
+{
+	struct device *dev = &pdev->dev;
+	struct regmap_config cfg = {
+		.reg_bits	= 32,
+		.val_bits	= 32,
+		.reg_stride	= 4,
+	};
+	struct resource *res;
+	void __iomem *base;
+
+	res = platform_get_resource_byname(pdev, IORESOURCE_MEM, name);
+	if (!res)
+		return ERR_PTR(-ENOENT);
+
+	base = devm_ioremap_resource(dev, res);
+	if (IS_ERR(base))
+		return ERR_CAST(base);
+
+	cfg.max_register = resource_size(res) - 4;
+	cfg.name = devm_kasprintf(dev, GFP_KERNEL, "%s-%s", dev_name(dev), name);
+	if (!cfg.name)
+		return ERR_PTR(-ENOMEM);
+
+	return devm_regmap_init_mmio(dev, base, &cfg);
+}
+
+static int meson_sc2_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct regmap *basic_map;
+	struct regmap *pll_map;
+	struct regmap *cpu_clk_map;
+	int ret, i;
+
+	/* Get regmap for different clock area */
+	basic_map = sc2_regmap_resource(pdev, "basic");
+	if (IS_ERR(basic_map))
+		return dev_err_probe(dev, PTR_ERR(basic_map),
+				     "basic clk registers not found\n");
+
+	pll_map = sc2_regmap_resource(pdev, "pll");
+	if (IS_ERR(pll_map))
+		return dev_err_probe(dev, PTR_ERR(pll_map),
+				     "pll clk registers not found\n");
+
+	cpu_clk_map = sc2_regmap_resource(pdev, "cpu_clk");
+	if (IS_ERR(cpu_clk_map))
+		return dev_err_probe(dev, PTR_ERR(cpu_clk_map),
+				     "cpu clk registers not found\n");
+
+	/* Populate regmap for the regmap backed clocks */
+	for (i = 0; i < ARRAY_SIZE(sc2_clk_regmaps); i++)
+		sc2_clk_regmaps[i]->map = basic_map;
+
+	for (i = 0; i < ARRAY_SIZE(sc2_cpu_clk_regmaps); i++)
+		sc2_cpu_clk_regmaps[i]->map = cpu_clk_map;
+
+	for (i = 0; i < ARRAY_SIZE(sc2_pll_clk_regmaps); i++)
+		sc2_pll_clk_regmaps[i]->map = pll_map;
+
+	ret = regmap_write(pll_map, ANACTRL_MPLL_CTRL0, 0x00000543);
+	if (ret)
+		return ret;
+
+	for (i = 0; i < sc2_hw_onecell_data.num; i++) {
+		/* array might be sparse */
+		if (!sc2_hw_onecell_data.hws[i])
+			continue;
+
+		ret = devm_clk_hw_register(dev, sc2_hw_onecell_data.hws[i]);
+		if (ret)
+			return dev_err_probe(dev, ret, "Clock registration failed\n");
+	}
+
+	/* DVFS notifiers are best effort: the clocks are usable without them */
+	ret = meson_sc2_dvfs_setup(pdev);
+	if (ret)
+		dev_warn(dev, "cpu/dsu dvfs clock setup failed: %d\n", ret);
+
+	return devm_of_clk_add_hw_provider(dev, of_clk_hw_onecell_get,
+					   &sc2_hw_onecell_data);
+}
+
+static const struct of_device_id clkc_match_table[] = {
+	{ .compatible = "amlogic,sc2-clkc" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, clkc_match_table);
+
+static struct platform_driver sc2_driver = {
+	.probe	= meson_sc2_probe,
+	.driver	= {
+		.name		= "sc2-clkc",
+		.of_match_table	= clkc_match_table,
+	},
+};
+module_platform_driver(sc2_driver);
+
+MODULE_DESCRIPTION("Amlogic SC2 clock controller driver");
+MODULE_LICENSE("GPL");
+MODULE_IMPORT_NS("CLK_MESON");
