+
+static void usage(FILE *out, const char *argv0)
+{
+	fprintf(out,
+"usage: %s [options] <video_ucode.bin>\n"
+"\n"
+"Load a signed Amlogic video microcode package through the vendor video\n"
+"firmware trusted application.\n"
+"\n"
+"Inspection (no TEE access):\n"
+"  -l, --list             list the entries of the package\n"
+"  -C, --check            check the package structure and exit\n"
+"  -S, --soc <name>       restrict --list to entries for <name> (e.g. s4, s4d)\n"
+"  -R, --require <name>   fail if the package has no non-empty entry for <name>\n"
+"      --no-check         skip the structure check before loading\n"
+"\n"
+"Loading:\n"
+"  -w, --wait <seconds>   wait for /dev/teepriv0 and /dev/tee0 first\n"
+"  -s, --strict           fail if the final chunk returns TEEC_ERROR_BUSY\n"
+"  -c, --chunk-size <n>   bytes per chunk (default 0x%x, %d..%d)\n"
+"  -u, --uuid <uuid>      trusted application UUID\n"
+"  -t, --timing           print timing information\n"
+"\n"
+"General:\n"
+"  -v, --verbose          more output (per chunk results)\n"
+"  -q, --quiet            only print errors\n"
+"  -h, --help             show this help\n"
+"\n"
+"Exit status: 0 ok, 1 failure, 2 usage, 3 invalid package, 4 TEE init,\n"
+"5 cannot open the trusted application session, 6 load failed.\n",
+		argv0, CHUNK_SIZE_DEFAULT, CHUNK_SIZE_MIN, CHUNK_SIZE_MAX);
+}
+
+static int parse_number(const char *s, size_t *out)
+{
+	char *end;
+	unsigned long long v;
+
+	errno = 0;
+	v = strtoull(s, &end, 0);
+	if (errno || end == s || *end || v > SIZE_MAX)
+		return -1;
+
+	*out = v;
+	return 0;
+}
+
+static int parse_args(int argc, char **argv, struct options *opt)
+{
+	static const struct option longopts[] = {
+		{ "list",	no_argument,	   NULL, 'l' },
+		{ "check",	no_argument,	   NULL, 'C' },
+		{ "soc",	required_argument, NULL, 'S' },
+		{ "require",	required_argument, NULL, 'R' },
+		{ "no-check",	no_argument,	   NULL, 1 },
+		{ "wait",	required_argument, NULL, 'w' },
+		{ "strict",	no_argument,	   NULL, 's' },
+		{ "chunk-size",	required_argument, NULL, 'c' },
+		{ "uuid",	required_argument, NULL, 'u' },
+		{ "timing",	no_argument,	   NULL, 't' },
+		{ "verbose",	no_argument,	   NULL, 'v' },
+		{ "quiet",	no_argument,	   NULL, 'q' },
+		{ "help",	no_argument,	   NULL, 'h' },
+		{ NULL, 0, NULL, 0 }
+	};
+	size_t n;
+	int c;
+
+	opt->uuid = default_uuid;
+	opt->chunk_size = CHUNK_SIZE_DEFAULT;
+
+	while ((c = getopt_long(argc, argv, "lCS:R:w:sc:u:tvqh", longopts, NULL)) != -1) {
+		switch (c) {
+		case 'l':
+			opt->list = true;
+			break;
+		case 'C':
+			opt->check_only = true;
+			break;
+		case 'S':
+			opt->list_soc = optarg;
+			break;
+		case 'R':
+			opt->require_soc = optarg;
+			break;
+		case 1:
+			opt->no_check = true;
+			break;
+		case 'w':
+			if (parse_number(optarg, &n) || n > 3600) {
+				err("invalid --wait value \"%s\" (0..3600)", optarg);
+				return -1;
+			}
+			opt->wait_sec = n;
+			break;
+		case 's':
+			opt->strict = true;
+			break;
+		case 'c':
+			if (parse_number(optarg, &n) || n < CHUNK_SIZE_MIN ||
+			    n > CHUNK_SIZE_MAX) {
+				err("invalid --chunk-size \"%s\" (%d..%d)", optarg,
+				    CHUNK_SIZE_MIN, CHUNK_SIZE_MAX);
+				return -1;
+			}
+			opt->chunk_size = n;
+			break;
+		case 'u':
+			if (parse_uuid(optarg, &opt->uuid)) {
+				err("invalid UUID \"%s\"", optarg);
+				return -1;
+			}
+			break;
+		case 't':
+			opt->timing = true;
+			break;
+		case 'v':
+			verbosity = 2;
+			break;
+		case 'q':
+			verbosity = 0;
+			break;
+		case 'h':
+			usage(stdout, argv[0]);
+			exit(EXIT_OK);
+		default:
+			return -1;
+		}
+	}
+
+	if (optind != argc - 1) {
+		fprintf(stderr, "usage: %s [options] <video_ucode.bin>\n"
+			"try '%s --help'\n", argv[0], argv[0]);
+		return -1;
+	}
+	opt->path = argv[optind];
+
+	return 0;
+}
+
+int main(int argc, char **argv)
+{
+	struct options opt = { 0 };
+	struct package pkg;
+	unsigned char *fw;
+	size_t size;
+	int ret;
+
+	if (parse_args(argc, argv, &opt))
