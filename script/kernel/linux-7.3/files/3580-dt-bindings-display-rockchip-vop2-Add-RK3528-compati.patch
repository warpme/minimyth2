From fb37bda6ce7aebf3e8f147528e7e6b21dcdf0c8a Mon Sep 17 00:00:00 2001
From: Piotr Oniszczuk <piotr.oniszczuk@gmail.com>
Date: Sun, 22 Nov 2026 13:03:54 +0100
Subject: [PATCH 3580/3586] dt-bindings: display: rockchip: vop2: Add RK3528
 compatible

The RK3528 VOP is a VOP2 (VOP3 generation) display controller with two
video ports: VP0 (up to 4096x2304, drives the HDMI TX) and VP1 (up to
720x576, drives the TV encoder).

As there are only two video ports, the RK3528 VOP has only four clocks:
aclk, hclk, dclk_vp0 and dclk_vp1. Interface polarities are controlled
by the VOP itself, so no GRF phandle is needed.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../display/rockchip/rockchip-vop2.yaml       | 43 ++++++++++++++++++-
 1 file changed, 41 insertions(+), 2 deletions(-)

diff --git a/Documentation/devicetree/bindings/display/rockchip/rockchip-vop2.yaml b/Documentation/devicetree/bindings/display/rockchip/rockchip-vop2.yaml
index 93da1fb..ae07f8c 100644
--- a/Documentation/devicetree/bindings/display/rockchip/rockchip-vop2.yaml
+++ b/Documentation/devicetree/bindings/display/rockchip/rockchip-vop2.yaml
@@ -19,12 +19,14 @@ maintainers:
 properties:
   compatible:
     enum:
+      - rockchip,rk3528-vop
       - rockchip,rk3566-vop
       - rockchip,rk3568-vop
       - rockchip,rk3576-vop
       - rockchip,rk3588-vop
 
   reg:
+    minItems: 1
     items:
       - description:
           Must contain one entry corresponding to the base address and length
@@ -34,6 +36,7 @@ properties:
           LUT address.
 
   reg-names:
+    minItems: 1
     items:
       - const: vop
       - const: gamma-lut
@@ -57,7 +60,7 @@ properties:
 
   # See compatible-specific constraints below.
   clocks:
-    minItems: 5
+    minItems: 4
     items:
       - description: Clock for ddr buffer transfer via axi.
       - description: Clock for the ahb bus to R/W the regs.
@@ -70,7 +73,7 @@ properties:
       - {}
 
   clock-names:
-    minItems: 5
+    minItems: 4
     items:
       - const: aclk
       - const: hclk
@@ -133,6 +136,40 @@ required:
   - ports
 
 allOf:
+  - if:
+      properties:
+        compatible:
+          contains:
+            const: rockchip,rk3528-vop
+    then:
+      properties:
+        reg:
+          maxItems: 1
+
+        reg-names:
+          maxItems: 1
+
+        clocks:
+          maxItems: 4
+
+        clock-names:
+          maxItems: 4
+
+        interrupts:
+          maxItems: 1
+
+        interrupt-names: false
+
+        ports:
+          required:
+            - port@0
+            - port@1
+
+        rockchip,grf: false
+        rockchip,vo1-grf: false
+        rockchip,vop-grf: false
+        rockchip,pmu: false
+
   - if:
       properties:
         compatible:
@@ -143,9 +180,11 @@ allOf:
     then:
       properties:
         clocks:
+          minItems: 5
           maxItems: 5
 
         clock-names:
+          minItems: 5
           maxItems: 5
 
         interrupts:
