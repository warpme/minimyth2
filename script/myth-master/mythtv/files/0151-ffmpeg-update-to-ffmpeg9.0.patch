index 00000000000..998e46c5725
--- /dev/null
+++ b/mythtv/external/FFmpeg/libswscale/rational64.c
@@ -0,0 +1,146 @@
+/*
+ * 64-bit rational numbers
+ * Copyright (c) 2025 Niklas Haas
