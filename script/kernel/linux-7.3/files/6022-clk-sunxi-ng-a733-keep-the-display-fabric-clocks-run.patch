From 169d67414c6625c8979183e83bf8ef0d291fd427 Mon Sep 17 00:00:00 2001
From: Jernej Skrabec <jernej.skrabec@gmail.com>
Date: Fri, 4 Sep 2026 13:18:51 +0200
Subject: [PATCH 175/211] clk: sunxi-ng: a733: keep the display fabric clocks
 running

The display engine reaches memory through an AHB gate and an MBUS gate that
belong to no device of their own. The vendor code turns them on alongside
the engine; nothing in the clock tree does. Mark them critical, the same way
the other fabric gates on this SoC are handled.

Signed-off-by: Jernej Skrabec <jernej.skrabec@gmail.com>
---
 drivers/clk/sunxi-ng/ccu-sun60i-a733.c | 8 ++++++--
 1 file changed, 6 insertions(+), 2 deletions(-)

diff --git a/drivers/clk/sunxi-ng/ccu-sun60i-a733.c b/drivers/clk/sunxi-ng/ccu-sun60i-a733.c
index 1a434fdf15..33618ebc70 100644
--- a/drivers/clk/sunxi-ng/ccu-sun60i-a733.c
+++ b/drivers/clk/sunxi-ng/ccu-sun60i-a733.c
@@ -503,8 +503,12 @@ static SUNXI_CCU_GATE_HWS(ahb_vid_cout0_clk, "ahb-vid-cout0", ahb_hws,
 			  0x5c0, BIT(3), 0);
 static SUNXI_CCU_GATE_HWS(ahb_vid_cout1_clk, "ahb-vid-cout1", ahb_hws,
 			  0x5c0, BIT(4), 0);
+/*
+ * The display engine reaches memory through these two gates, and nothing
+ * else turns them on, so keep them running.
+ */
 static SUNXI_CCU_GATE_HWS(ahb_de_clk, "ahb-de", ahb_hws,
-			  0x5c0, BIT(5), 0);
+			  0x5c0, BIT(5), CLK_IS_CRITICAL);
 static SUNXI_CCU_GATE_HWS(ahb_npu_clk, "ahb-npu", ahb_hws,
 			  0x5c0, BIT(6), 0);
 static SUNXI_CCU_GATE_HWS(ahb_gpu0_clk, "ahb-gpu0", ahb_hws,
@@ -531,7 +535,7 @@ static SUNXI_CCU_GATE_HWS(mbus_iommu0_clk, "mbus-iommu0", mbus_hws,
 static SUNXI_CCU_GATE_HWS(mbus_iommu1_clk, "mbus-iommu1", mbus_hws,
 			  0x5e0, BIT(1), 0);
 static SUNXI_CCU_GATE_HWS(mbus_desys_clk, "mbus-desys", mbus_hws,
-			  0x5e0, BIT(11), 0);
+			  0x5e0, BIT(11), CLK_IS_CRITICAL);
 static SUNXI_CCU_GATE_HWS(mbus_ve_enc0_gate_clk, "mbus-ve-enc0-gate", mbus_hws,
 			  0x5e0, BIT(12), 0);
 static SUNXI_CCU_GATE_HWS(mbus_ve_dec0_gate_clk, "mbus-ve-dec0-gate", mbus_hws,
-- 
