From 506eb7eb5325617864941fd8f11d99d9140d140a Mon Sep 17 00:00:00 2001
From: Piotr Oniszczuk <piotr.oniszczuk@gmail.com>
Date: Fri, 20 Nov 2026 10:48:11 +0000
Subject: [PATCH 05/12] pinctrl: meson: add Amlogic T7 pinctrl driver

Add a pinctrl/GPIO driver for the Amlogic T7 SoC, which shares the
register layout of the S4. Bank and mux register offsets are taken from
the Linux pinctrl-amlogic-t7 driver.

All 157 pins are usable as GPIOs; the eMMC (bank B), SD card (bank C)
and Ethernet (bank Z, LEDs on bank H) functions are described.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: Piotr Oniszczuk <piotr.oniszczuk@gmail.com>
---
 drivers/pinctrl/meson/Kconfig            |   7 +
 drivers/pinctrl/meson/Makefile           |   1 +
 drivers/pinctrl/meson/pinctrl-meson-t7.c | 429 +++++++++++++++++++++++
 3 files changed, 437 insertions(+)
 create mode 100644 drivers/pinctrl/meson/pinctrl-meson-t7.c

diff --git a/drivers/pinctrl/meson/Kconfig b/drivers/pinctrl/meson/Kconfig
index 2e076c3..6e22173 100644
--- a/drivers/pinctrl/meson/Kconfig
+++ b/drivers/pinctrl/meson/Kconfig
@@ -37,4 +37,11 @@ config PINCTRL_MESON_S4
 	bool "Amlogic Meson S4 SoC pinctrl driver"
 	select PINCTRL_MESON_AXG_PMX
 
+config PINCTRL_MESON_T7
+	bool "Amlogic T7 SoC pinctrl driver"
+	select PINCTRL_MESON_AXG_PMX
+	help
+	  Enable the pin controller and GPIO driver of the Amlogic T7 SoC
+	  family, such as the A311D2 found on the Khadas VIM4.
+
 endif
diff --git a/drivers/pinctrl/meson/Makefile b/drivers/pinctrl/meson/Makefile
index ce7cbc3..1865118 100644
--- a/drivers/pinctrl/meson/Makefile
+++ b/drivers/pinctrl/meson/Makefile
@@ -9,3 +9,4 @@ obj-$(CONFIG_PINCTRL_MESON_AXG)		+= pinctrl-meson-axg.o
 obj-$(CONFIG_PINCTRL_MESON_G12A)	+= pinctrl-meson-g12a.o
 obj-$(CONFIG_PINCTRL_MESON_A1)		+= pinctrl-meson-a1.o
 obj-$(CONFIG_PINCTRL_MESON_S4)		+= pinctrl-meson-s4.o
+obj-$(CONFIG_PINCTRL_MESON_T7)		+= pinctrl-meson-t7.o
diff --git a/drivers/pinctrl/meson/pinctrl-meson-t7.c b/drivers/pinctrl/meson/pinctrl-meson-t7.c
new file mode 100644
index 0000000..edcf88b
--- /dev/null
+++ b/drivers/pinctrl/meson/pinctrl-meson-t7.c
@@ -0,0 +1,429 @@
