--- linux-7.3-rc3/drivers/staging/media/meson/vdec/codec_hevc_common.c	2026-09-13 23:38:02.000000000 +0200
+++ linux-7.3-rc3/drivers/staging/media/meson/vdec/codec_hevc_common.c	2026-09-20 12:19:13.000000000 +0200
@@ -3,6 +3,9 @@
