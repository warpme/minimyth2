+    %assign X SWS_COMP_TEST(MASK, 0)
+    %assign Y SWS_COMP_TEST(MASK, 1)
+    %assign Z SWS_COMP_TEST(MASK, 2)
+    %assign W SWS_COMP_TEST(MASK, 3)
+    %assign COMPS (X + Y + Z + W)
