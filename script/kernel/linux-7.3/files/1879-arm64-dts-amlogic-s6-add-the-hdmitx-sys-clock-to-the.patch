From 5eb655eba7b3671d198ef4befeb471e2fb4050ba Mon Sep 17 00:00:00 2001
From: Piotr Oniszczuk <piotr.oniszczuk@gmail.com>
Date: Fri, 27 Nov 2026 11:20:10 +0100
Subject: [PATCH] arm64: dts: amlogic: s6: add the hdmitx sys clock to the HDMI
 TX

The HDMI TX top level registers need cts_hdmitx_sys_clk.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Signed-off-by: Piotr Oniszczuk <piotr.oniszczuk@gmail.com>
---
 arch/arm64/boot/dts/amlogic/amlogic-s6.dtsi | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/arch/arm64/boot/dts/amlogic/amlogic-s6.dtsi b/arch/arm64/boot/dts/amlogic/amlogic-s6.dtsi
index 47b003e15..d3d460d98 100644
--- a/arch/arm64/boot/dts/amlogic/amlogic-s6.dtsi
+++ b/arch/arm64/boot/dts/amlogic/amlogic-s6.dtsi
@@ -1457,8 +1457,9 @@ hdmi_tx: hdmi-tx@fe300000 {
 			 */
 			clocks = <&clkc_periphs CLKID_SYS_HDMITX_APB>,
 				 <&clkc_periphs CLKID_HDMITX_PRIF>,
-				 <&clkc_periphs CLKID_HDMITX_200M>;
-			clock-names = "pclk", "prif", "i2c";
+				 <&clkc_periphs CLKID_HDMITX_200M>,
+				 <&clkc_periphs CLKID_HDMITX_SYS>;
+			clock-names = "pclk", "prif", "i2c", "sys";
 			assigned-clocks = <&clkc_periphs CLKID_HDMITX_PRIF>,
 					  <&clkc_periphs CLKID_HDMITX_200M>;
 			assigned-clock-rates = <200000000>, <200000000>;
-- 
2.43.0

