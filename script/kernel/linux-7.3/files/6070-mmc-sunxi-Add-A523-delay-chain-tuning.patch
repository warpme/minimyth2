From e627cbd63183911332500b7d130929fa2b959d5c Mon Sep 17 00:00:00 2001
From: Jernej Skrabec <jernej.skrabec@gmail.com>
Date: Sat, 22 Aug 2026 07:11:19 +0200
Subject: [PATCH 083/211] mmc: sunxi: Add A523 delay-chain tuning

Switch A523 SDR50, SDR104 and HS200 to 1x mode and scan the sampling
delay. Match the SDK scan parameters and FIFO threshold settings. Keep
older generations on their existing timing paths.

DDR50 keeps using the 2x timing mode and its phase settings: the
sampling scan finds no working delay at all in DDR mode, while the
phase table works, and both were checked on a Cubie A5E.

Signed-off-by: Jernej Skrabec <jernej.skrabec@gmail.com>
---
 drivers/mmc/host/sunxi-mmc.c | 175 +++++++++++++++++++++++++++++++++--
 1 file changed, 168 insertions(+), 7 deletions(-)

diff --git a/drivers/mmc/host/sunxi-mmc.c b/drivers/mmc/host/sunxi-mmc.c
index ae9aec8d8b..036a92a974 100644
--- a/drivers/mmc/host/sunxi-mmc.c
+++ b/drivers/mmc/host/sunxi-mmc.c
@@ -71,6 +71,7 @@
 /* New registers introduced in A64 */
 #define SDXC_REG_A12A		0x058 /* SMC Auto Command 12 Register */
 #define SDXC_REG_SD_NTSR	0x05C /* SMC New Timing Set Register */
+#define SDXC_REG_THLD		0x100 /* SMC card threshold control */
 #define SDXC_REG_DRV_DL		0x140 /* Drive Delay Control Register */
 #define SDXC_REG_SAMP_DL_REG	0x144 /* SMC sample delay control */
 #define SDXC_REG_DS_DL_REG	0x148 /* SMC data strobe delay control */
@@ -228,6 +229,14 @@
 #define SDXC_CLK_HIGH_SPEED	5
 #define SDXC_CLK_MODES		6
 
+/* SDXC_REG_THLD bits */
+#define SDXC_CARD_RD_THLD	GENMASK(27, 16)
+#define SDXC_CARD_RD_THLD_ENB	BIT(0)
+
+/* SDXC_REG_SAMP_DL bits */
+#define SDXC_SAMP_DL_SW		GENMASK(5, 0)
+#define SDXC_SAMP_DL_SW_EN	BIT(7)
+
 /* SDXC_REG_SD_NTSR bits */
 #define SDXC_2X_TIMING_MODE	BIT(31)
 #define SDXC_STIMING_DAT_PH	GENMASK(9, 8)
@@ -271,6 +280,7 @@ struct sunxi_mmc_cfg {
 	const struct sunxi_mmc_clk_delay *clk_delays;
 
 	const struct sunxi_mmc_timing *timings;
+	bool can_tune;
 
 	/* does the IP block support autocalibration? */
 	bool can_calibrate;
@@ -323,6 +333,9 @@ struct sunxi_mmc_host {
 	/* vqmmc */
 	bool		vqmmc_enabled;
 
+	u32		sample_delay;
+	bool		tuning;
+
 	/* timings */
 	bool		use_new_timings;
 };
@@ -489,7 +502,11 @@ static void sunxi_mmc_send_manual_stop(struct sunxi_mmc_host *host,
 			   1, 1000000);
 
 	if (!(ri & SDXC_COMMAND_DONE) || (ri & SDXC_INTERRUPT_ERROR_BIT)) {
-		dev_err(mmc_dev(host->mmc), "send stop command failed\n");
+		if (host->tuning)
+			dev_dbg(mmc_dev(host->mmc), "send stop command failed\n");
+		else
+			dev_err_ratelimited(mmc_dev(host->mmc),
+					    "send stop command failed\n");
 		if (req->stop)
 			req->stop->resp[0] = -ETIMEDOUT;
 	} else {
@@ -657,7 +674,11 @@ static irqreturn_t sunxi_mmc_handle_manual_stop(int irq, void *dev_id)
 		return IRQ_HANDLED;
 	}
 
-	dev_err(mmc_dev(host->mmc), "data error, sending stop command\n");
+	if (host->tuning)
+		dev_dbg(mmc_dev(host->mmc), "data error, sending stop command\n");
+	else
+		dev_err_ratelimited(mmc_dev(host->mmc),
+				    "data error, sending stop command\n");
 
 	/*
 	 * We will never have more than one outstanding request,
@@ -811,6 +832,71 @@ static void sunxi_mmc_set_timing_phase(struct sunxi_mmc_host *host,
 	mmc_writel(host, REG_SD_NTSR, rval);
 }
 
+#define SUNXI_MMC_SAMPLE_DELAYS		64
+#define SUNXI_MMC_SAMPLE_WINDOW_MIN	12
+#define SUNXI_MMC_TUNING_RETRIES	20
+
+/*
+ * The sample delay chain is only connected to the input latches in 1x
+ * mode, so tuned timings must run with the 2x timing mode disabled.
+ */
+static bool sunxi_mmc_timing_needs_tuning(struct sunxi_mmc_host *host,
+					  struct mmc_ios *ios)
+{
+	if (!host->cfg->can_tune)
+		return false;
+
+	switch (ios->timing) {
+	case MMC_TIMING_UHS_SDR50:
+	case MMC_TIMING_UHS_SDR104:
+	case MMC_TIMING_MMC_HS200:
+		return true;
+	default:
+		return false;
+	}
+}
+
+/* Leave the RX trigger level free when the block is buffered in the FIFO. */
+#define SUNXI_MMC_FIFO_BYTES		1024
+#define SUNXI_MMC_FIFO_RX_TRIGGER	(7 * 4)
+
+static bool sunxi_mmc_timing_needs_threshold(struct mmc_ios *ios)
+{
+	return ios->timing == MMC_TIMING_UHS_SDR50 ||
+	       ios->timing == MMC_TIMING_UHS_SDR104 ||
+	       ios->timing == MMC_TIMING_MMC_HS200;
+}
+
+static void sunxi_mmc_set_read_threshold(struct sunxi_mmc_host *host,
+					 struct mmc_data *data)
+{
+	u32 rval;
+
+	if (!host->cfg->can_tune)
+		return;
+
+	rval = mmc_readl(host, REG_THLD);
+
+	rval &= ~(SDXC_CARD_RD_THLD | SDXC_CARD_RD_THLD_ENB);
+
+	if ((data->flags & MMC_DATA_READ) &&
+	    sunxi_mmc_timing_needs_threshold(&host->mmc->ios) &&
+	    data->blksz + SUNXI_MMC_FIFO_RX_TRIGGER <= SUNXI_MMC_FIFO_BYTES)
+		rval |= FIELD_PREP(SDXC_CARD_RD_THLD, data->blksz) |
+			SDXC_CARD_RD_THLD_ENB;
+
+	mmc_writel(host, REG_THLD, rval);
+}
+
+static void sunxi_mmc_set_sample_delay(struct sunxi_mmc_host *host, u32 delay)
+{
+	u32 rval = mmc_readl(host, REG_SAMP_DL_REG);
+
+	rval &= ~SDXC_SAMP_DL_SW;
+	rval |= FIELD_PREP(SDXC_SAMP_DL_SW, delay) | SDXC_SAMP_DL_SW_EN;
+	mmc_writel(host, REG_SAMP_DL_REG, rval);
+}
+
 static int sunxi_mmc_clk_set_rate(struct sunxi_mmc_host *host,
 				  struct mmc_ios *ios)
 {
@@ -887,7 +973,10 @@ static int sunxi_mmc_clk_set_rate(struct sunxi_mmc_host *host,
 	if (host->use_new_timings) {
 		/* Don't touch the delay bits */
 		rval = mmc_readl(host, REG_SD_NTSR);
-		rval |= SDXC_2X_TIMING_MODE;
+		if (sunxi_mmc_timing_needs_tuning(host, ios))
+			rval &= ~SDXC_2X_TIMING_MODE;
+		else
+			rval |= SDXC_2X_TIMING_MODE;
 		mmc_writel(host, REG_SD_NTSR, rval);
 	}
 
@@ -898,9 +987,13 @@ static int sunxi_mmc_clk_set_rate(struct sunxi_mmc_host *host,
 
 	sunxi_mmc_set_timing_phase(host, ios, rate);
 
-	ret = sunxi_mmc_calibrate(host, SDXC_REG_SAMP_DL_REG);
-	if (ret)
-		return ret;
+	if (sunxi_mmc_timing_needs_tuning(host, ios)) {
+		sunxi_mmc_set_sample_delay(host, host->sample_delay);
+	} else {
+		ret = sunxi_mmc_calibrate(host, SDXC_REG_SAMP_DL_REG);
+		if (ret)
+			return ret;
+	}
 
 	/*
 	 * FIXME:
@@ -1144,6 +1237,7 @@ static void sunxi_mmc_request(struct mmc_host *mmc, struct mmc_request *mrq)
 	if (data) {
 		mmc_writel(host, REG_BLKSZ, data->blksz);
 		mmc_writel(host, REG_BCNTR, data->blksz * data->blocks);
+		sunxi_mmc_set_read_threshold(host, data);
 		sunxi_mmc_start_dma(host, data);
 	}
 
@@ -1163,6 +1257,59 @@ static int sunxi_mmc_card_busy(struct mmc_host *mmc)
 	return !!(mmc_readl(host, REG_STAS) & SDXC_CARD_DATA_BUSY);
 }
 
+static bool sunxi_mmc_test_delay(struct mmc_host *mmc, u32 opcode)
+{
+	unsigned int i;
+
+	for (i = 0; i < SUNXI_MMC_TUNING_RETRIES; i++)
+		if (mmc_send_tuning(mmc, opcode, NULL))
+			return false;
+
+	return true;
+}
+
+static int sunxi_mmc_execute_tuning(struct mmc_host *mmc, u32 opcode)
+{
+	struct sunxi_mmc_host *host = mmc_priv(mmc);
+	unsigned int delay, start = 0, len = 0, best_start = 0, best_len = 0;
+	u32 old_delay = host->sample_delay;
+
+	host->tuning = true;
+
+	for (delay = 0; delay < SUNXI_MMC_SAMPLE_DELAYS; delay++) {
+		sunxi_mmc_set_sample_delay(host, delay);
+
+		if (sunxi_mmc_test_delay(mmc, opcode)) {
+			if (!len)
+				start = delay;
+			len++;
+			if (len > best_len) {
+				best_len = len;
+				best_start = start;
+			}
+		} else {
+			len = 0;
+		}
+	}
+
+	host->tuning = false;
+
+	if (best_len < SUNXI_MMC_SAMPLE_WINDOW_MIN) {
+		sunxi_mmc_set_sample_delay(host, old_delay);
+		dev_err(mmc_dev(mmc),
+			"widest sampling window at %u Hz is %u delays, too narrow to use\n",
+			mmc->actual_clock, best_len);
+		return -EIO;
+	}
+
+	host->sample_delay = best_start + best_len / 2;
+	dev_dbg(mmc_dev(mmc), "sampling with delay %u, window %u wide\n",
+		host->sample_delay, best_len);
+	sunxi_mmc_set_sample_delay(host, host->sample_delay);
+
+	return 0;
+}
+
 static const struct mmc_host_ops sunxi_mmc_ops = {
 	.request	 = sunxi_mmc_request,
 	.set_ios	 = sunxi_mmc_set_ios,
@@ -1174,6 +1321,18 @@ static const struct mmc_host_ops sunxi_mmc_ops = {
 	.card_busy	 = sunxi_mmc_card_busy,
 };
 
+static const struct mmc_host_ops sunxi_mmc_tuning_ops = {
+	.request	 = sunxi_mmc_request,
+	.set_ios	 = sunxi_mmc_set_ios,
+	.get_ro		 = mmc_gpio_get_ro,
+	.get_cd		 = mmc_gpio_get_cd,
+	.enable_sdio_irq = sunxi_mmc_enable_sdio_irq,
+	.start_signal_voltage_switch = sunxi_mmc_volt_switch,
+	.card_hw_reset	 = sunxi_mmc_hw_reset,
+	.card_busy	 = sunxi_mmc_card_busy,
+	.execute_tuning	 = sunxi_mmc_execute_tuning,
+};
+
 static const struct sunxi_mmc_clk_delay sunxi_mmc_clk_delays[] = {
 	[SDXC_CLK_400K]		= { .output = 180, .sample = 180 },
 	[SDXC_CLK_25M]		= { .output = 180, .sample =  75 },
@@ -1272,6 +1431,7 @@ static const struct sunxi_mmc_cfg sun55i_a523_cfg = {
 	.mask_data0 = true,
 	.needs_new_timings = true,
 	.timings = sun55i_a523_timings,
+	.can_tune = true,
 };
 
 static const struct sunxi_mmc_cfg sun50i_a100_emmc_cfg = {
@@ -1490,7 +1650,8 @@ static int sunxi_mmc_probe(struct platform_device *pdev)
 		host->use_new_timings = true;
 	}
 
-	mmc->ops		= &sunxi_mmc_ops;
+	mmc->ops		= host->cfg->can_tune ? &sunxi_mmc_tuning_ops :
+							&sunxi_mmc_ops;
 	mmc->max_blk_count	= 8192;
 	mmc->max_blk_size	= 4096;
 	mmc->max_segs		= PAGE_SIZE / sizeof(struct sunxi_idma_des);
-- 
2.53.0

