diff --speed-large-files --no-dereference --minimal -Naur linux-7.3-rc6/arch/arm64/boot/dts/amlogic/meson-s4.dtsi linux-7.3-rc6/arch/arm64/boot/dts/amlogic/meson-s4.dtsi
