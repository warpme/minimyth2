From 6b5b620068d8156fed225bdbf1ebdac10a8f80ae Mon Sep 17 00:00:00 2001
From: Christian Hewitt <christianshewitt@gmail.com>
Date: Wed, 7 Oct 2026 12:22:08 +0000
Subject: [PATCH 257/268] firmware: meson_sm: add the DVFS table index service

Newer Amlogic SoCs are binned at manufacture and the bin is stored in
efuse. The BL31 firmware reports it through function 0x82000088, which
returns the index of the CPU DVFS table the chip should use. Higher
indices are better silicon that runs the same frequencies at lower
voltages.

Add a command index for it so the cpufreq code can pick the matching
voltages.

Assisted-by: Claude:claude-opus-5-5
Signed-off-by: Christian Hewitt <christianshewitt@gmail.com>
---
 drivers/firmware/meson/meson_sm.c       | 1 +
 include/linux/firmware/meson/meson_sm.h | 1 +
 2 files changed, 2 insertions(+)

diff --git a/drivers/firmware/meson/meson_sm.c b/drivers/firmware/meson/meson_sm.c
index c8255168d..cb6bf5ae7 100644
--- a/drivers/firmware/meson/meson_sm.c
+++ b/drivers/firmware/meson/meson_sm.c
@@ -50,6 +50,7 @@ static const struct meson_sm_chip gxbb_chip = {
 		CMD(SM_A1_PWRC_GET,		0x82000095),
 		CMD(SM_PLL_CLK,			0x82000098),
 		CMD(SM_CPU_CLK,			0x82000099),
+		CMD(SM_GET_DVFS_TABLE_INDEX,	0x82000088),
 		{ /* sentinel */ },
 	},
 };
diff --git a/include/linux/firmware/meson/meson_sm.h b/include/linux/firmware/meson/meson_sm.h
index 2a0adb9d4..5543cbddf 100644
--- a/include/linux/firmware/meson/meson_sm.h
+++ b/include/linux/firmware/meson/meson_sm.h
@@ -17,6 +17,7 @@ enum {
 	SM_A1_PWRC_GET,
 	SM_PLL_CLK,
 	SM_CPU_CLK,
+	SM_GET_DVFS_TABLE_INDEX,
 };
 
 struct meson_sm_firmware;
-- 
