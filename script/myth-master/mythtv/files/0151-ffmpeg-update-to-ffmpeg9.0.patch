+int ff_sws_uop_cmp(const SwsUOp *a, const SwsUOp *b)
+{
+    if (a->type != b->type)
+        return (int) a->type - b->type;
+    if (a->uop != b->uop)
+        return (int) a->uop - b->uop;
+    if (a->mask != b->mask)
+        return (int) a->mask - b->mask;
+    return memcmp(&a->par, &b->par, sizeof(a->par));
