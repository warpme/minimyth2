From 0cf3a911f3c6f13ebdbcc05cdfb4da97aedcb8d6 Mon Sep 17 00:00:00 2001
From: Christian Hewitt <christianshewitt@gmail.com>
Date: Sat, 3 Oct 2026 17:45:44 +0000
Subject: [PATCH 25/32] WIP: board: amlogic: vim1s: pick the env MMC and set
 serial#

Select the environment MMC device from the boot device as the VIM3 does,
keep a MAC address that is already in the environment, and derive
serial# from the MAC address.

Assisted-by: Claude:claude-opus-5-5
Signed-off-by: Christian Hewitt <christianshewitt@gmail.com>
---
 board/amlogic/vim1s/vim1s.c | 48 +++++++++++++++++++++++++++----------
 1 file changed, 36 insertions(+), 12 deletions(-)

diff --git a/board/amlogic/vim1s/vim1s.c b/board/amlogic/vim1s/vim1s.c
index d58f3b629..d5012a583 100644
--- a/board/amlogic/vim1s/vim1s.c
+++ b/board/amlogic/vim1s/vim1s.c
@@ -5,22 +5,46 @@
 
 #include <env.h>
 #include <net-common.h>
+#include <asm/arch/boot.h>
+#include <asm/arch/s4.h>
 #include <asm/io.h>
 
-#define SYSCTRL_SEC_STATUS_REG18	0xfe010348
+int mmc_get_env_dev(void)
+{
+	switch (meson_get_boot_device()) {
+	case BOOT_DEVICE_EMMC:
+		return 0;
+	case BOOT_DEVICE_SD:
+		return 1;
+	default:
+		return -1;
+	}
+}
 
 int misc_init_r(void)
 {
-	/* This procedure copied from Khadas's downstream fork */
-	u32 val = readl(SYSCTRL_SEC_STATUS_REG18);
-	unsigned char addr[ARP_HLEN] = {
-		0x02,
-		0xad,
-		val >> 24,
-		0x01,
-		(val >> 8) & 0xff,
-		val & 0xff,
-	};
+	u8 mac_addr[ARP_HLEN];
+	char serial[13];
+	u32 val;
+
+	if (!eth_env_get_enetaddr("ethaddr", mac_addr)) {
+		/* This procedure copied from Khadas's downstream fork */
+		val = readl(S4_SEC_STATUS_REG18);
+		mac_addr[0] = 0x02;
+		mac_addr[1] = 0xad;
+		mac_addr[2] = val >> 24;
+		mac_addr[3] = 0x01;
+		mac_addr[4] = (val >> 8) & 0xff;
+		mac_addr[5] = val & 0xff;
+		eth_env_set_enetaddr("ethaddr", mac_addr);
+	}
+
+	if (!env_get("serial#")) {
+		snprintf(serial, sizeof(serial), "%02X%02X%02X%02X%02X%02X",
+			 mac_addr[0], mac_addr[1], mac_addr[2],
+			 mac_addr[3], mac_addr[4], mac_addr[5]);
+		env_set("serial#", serial);
+	}
 
-	return eth_env_set_enetaddr("ethaddr", addr);
+	return 0;
 }
