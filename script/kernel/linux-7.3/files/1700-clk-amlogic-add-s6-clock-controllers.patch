+		},
+		.n = {
+			.reg_off = ANACTRL_CSIPLL_CTRL0,
+			.shift   = 16,
+			.width   = 3,
+		},
+		.l = {
+			.reg_off = ANACTRL_CSIPLL_CTRL0,
+			.shift   = 31,
+			.width   = 1,
+		},
+		.rst = {
