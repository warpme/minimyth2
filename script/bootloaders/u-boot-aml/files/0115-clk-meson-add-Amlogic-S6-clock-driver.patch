+
+/*
+ * The I2C and PWM bus gates are chained in the Linux driver: I2C_M_B..F
+ * are children of I2C_M_A and PWM_B..J are children of PWM_A. Enable the
+ * parent gate as well so that a single controller works on its own.
+ */
+static int meson_s6_chained_parent(ulong id)
+{
+	switch (id) {
+	case CLKID_SYS_I2C_M_B:
+	case CLKID_SYS_I2C_M_C:
+	case CLKID_SYS_I2C_M_D:
+	case CLKID_SYS_I2C_M_E:
+	case CLKID_SYS_I2C_M_F:
+		return CLKID_SYS_I2C_M_A;
+	case CLKID_SYS_PWM_B:
+	case CLKID_SYS_PWM_C:
+	case CLKID_SYS_PWM_D:
+	case CLKID_SYS_PWM_E:
+	case CLKID_SYS_PWM_F:
+	case CLKID_SYS_PWM_G:
+	case CLKID_SYS_PWM_H:
+	case CLKID_SYS_PWM_I:
+	case CLKID_SYS_PWM_J:
+		return CLKID_SYS_PWM_A;
+	default:
+		return -ENOENT;
+	}
+}
+
+/*
+ * The fixed PLL divider gates belong to the secure firmware: never touch
+ * them, only check that the requested divider is running.
+ */
+static int meson_s6_pll_enable(struct clk *clk)
+{
+	struct meson_clk_data *data = (void *)dev_get_driver_data(clk->dev);
+	struct meson_clk *priv = dev_get_priv(clk->dev);
+	const struct meson_clk_info *info;
+
+	if (clk->id >= data->num_clocks || !data->clocks[clk->id])
+		return -ENOENT;
+
+	info = data->clocks[clk->id];
+	if (info->type != MESON_CLK_GATE)
+		return 0;
+
+	if (!GET_PARM_VALUE(priv, info->parm)) {
+		log_warning("%s is disabled by the firmware\n", info->name);
+		return -EACCES;
+	}
+
+	return 0;
+}
+
+static int meson_s6_clk_enable(struct clk *clk)
+{
+	struct clk parent = { .dev = clk->dev };
+	int ret;
+
+	if (meson_s6_is_pll(clk->dev))
+		return meson_s6_pll_enable(clk);
+
+	ret = meson_s6_chained_parent(clk->id);
+	if (ret >= 0) {
+		parent.id = ret;
+		ret = meson_clk_enable(&parent);
+		if (ret)
+			return ret;
+	}
+
+	return meson_clk_enable(clk);
+}
+
+static int meson_s6_clk_disable(struct clk *clk)
+{
+	/* Leave the firmware owned fixed PLL dividers alone */
+	if (meson_s6_is_pll(clk->dev))
+		return 0;
+
+	return meson_clk_disable(clk);
+}
+
+static ulong meson_s6_clk_set_rate(struct clk *clk, ulong rate)
+{
+	if (meson_s6_is_pll(clk->dev))
+		return -EINVAL;
+
+	switch (clk->id) {
+	case CLKID_SD_EMMC_A_DIV:
+	case CLKID_SD_EMMC_B_DIV:
+	case CLKID_SD_EMMC_C_DIV:
+		return meson_composite_set_rate(clk, rate);
+	case CLKID_SD_EMMC_A:
+	case CLKID_SD_EMMC_B:
+	case CLKID_SD_EMMC_C: {
+		struct clk parent = {
+			.dev = clk->dev,
+			.id = meson_clk_get_parent(clk),
+		};
+
+		return meson_s6_clk_set_rate(&parent, rate);
+	}
+	}
+
+	return -EINVAL;
+}
+
+static int meson_s6_clk_set_parent(struct clk *clk, struct clk *parent)
+{
+	if (meson_s6_is_pll(clk->dev))
+		return -EINVAL;
+
+	return meson_clk_set_parent(clk, parent);
+}
+
+static int meson_s6_clk_probe(struct udevice *dev)
+{
+	struct meson_clk *priv = dev_get_priv(dev);
+
+	return regmap_init_mem(dev_ofnode(dev), &priv->map);
+}
+
+static const struct udevice_id meson_s6_clk_ids[] = {
+	{
+		.compatible = "amlogic,s6-peripherals-clkc",
+		.data = (ulong)&meson_s6_peripherals_info,
+	},
+	{
+		.compatible = "amlogic,s6-pll-clkc",
+		.data = (ulong)&meson_s6_pll_info,
+	},
+	{ }
+};
+
+static struct clk_ops meson_s6_clk_ops = {
+	.disable	= meson_s6_clk_disable,
+	.enable		= meson_s6_clk_enable,
+	.get_rate	= meson_clk_get_rate,
+	.set_rate	= meson_s6_clk_set_rate,
+	.set_parent	= meson_s6_clk_set_parent,
+#if IS_ENABLED(CONFIG_CMD_CLK)
+	.dump		= meson_clk_dump,
+#endif
+};
+
+U_BOOT_DRIVER(meson_clk_s6) = {
+	.name		= "meson-clk-s6",
+	.id		= UCLASS_CLK,
+	.of_match	= meson_s6_clk_ids,
+	.priv_auto	= sizeof(struct meson_clk),
+	.ops		= &meson_s6_clk_ops,
+	.probe		= meson_s6_clk_probe,
+};
