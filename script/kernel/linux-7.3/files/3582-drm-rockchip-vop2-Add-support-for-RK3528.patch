+#define RK3528_OVL_SYS_PORT_SEL_IMD		0x504
+#define RK3528_OVL_SYS_CLUSTER0_CTRL		0x510
+#define RK3528_OVL_SYS_ESMART0_CTRL		0x520
+#define RK3528_OVL_SYS_ESMART1_CTRL		0x524
+#define RK3528_OVL_SYS_ESMART2_CTRL		0x528
+#define RK3528_OVL_SYS_ESMART3_CTRL		0x52c
+
 /* OVL registers for Video Port definition */
 #define RK3576_OVL_CTRL(vp)			(0x600 + (vp) * 0x100)
 #define RK3576_OVL_LAYER_SEL(vp)		(0x604 + (vp) * 0x100)
@@ -774,6 +789,19 @@ enum dst_factor_mode {
 
 #define POLFLAG_DCLK_INV	BIT(3)
 
+#define RK3528_OVL_SYS_PORT_SEL__CLUSTER0		GENMASK(1, 0)
+#define RK3528_OVL_SYS_PORT_SEL__ESMART0		GENMASK(17, 16)
+#define RK3528_OVL_SYS_PORT_SEL__ESMART1		GENMASK(21, 20)
+#define RK3528_OVL_SYS_PORT_SEL__ESMART2		GENMASK(25, 24)
+#define RK3528_OVL_SYS_PORT_SEL__ESMART3		GENMASK(29, 28)
+#define RK3528_OVL_SYS_CLUSTER0_CTRL__DLY_NUM		GENMASK(15, 0)
+#define RK3528_OVL_SYS_ESMART_CTRL__DLY_NUM		GENMASK(7, 0)
+
+#define RK3528_SYS_AUTO_GATING_CTRL__ACLK_PRE_AUTO_GATING_EN	BIT(7)
+
+#define RK3528_LUT_PORT_SEL__ESMART_LB_MODE		GENMASK(27, 26)
+#define RK3528_ESMART_LB_MODE_4K_2K_2K			2
+
 #define RK3576_OVL_CTRL__YUV_MODE			BIT(0)
 #define RK3576_OVL_BG_MIX_CTRL__BG_DLY			GENMASK(31, 24)
 
