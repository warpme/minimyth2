diff --speed-large-files --no-dereference --minimal -Naur linux-7.2.8/drivers/media/platform/amlogic/amvdec/amrisc_test.c linux-7.2.8/drivers/media/platform/amlogic/amvdec/amrisc_test.c
--- linux-7.2.8/drivers/media/platform/amlogic/amvdec/amrisc_test.c	1970-01-01 01:00:00.000000000 +0100
+++ linux-7.2.8/drivers/media/platform/amlogic/amvdec/amrisc_test.c	2026-10-02 08:55:53.000000000 +0200
@@ -0,0 +1,1458 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * debugfs harness for running small test images on the VDEC_1 AMRISC or
+ * on the HEVC-core AMRISC (the second AMRISC of the DOS block).
+ *
+ *   /sys/kernel/debug/amrisc-test/
+ *     image           write: raw IMEM image (<= 16 KiB)
+ *     imem_dma_ctrl   IMEM_DMA_CTRL value used for the load (default 0x78000)
+ *     imem_dma_count  IMEM_DMA_COUNT value (default 4096 words)
+ *     run_ms          run time before the snapshot (default 100)
+ *     load_only       1 = power bracket + IMEM DMA only, never start the CPU
+ *     arg0, arg1      written to AV_SCRATCH_K / AV_SCRATCH_L before start
+ *     buf             64 KiB DMA buffer (read/write); buf_paddr = its address
+ *     reglist         write: space separated CBUS indices (hex) to dump
+ *     run             write anything: power up, load, start, sample, stop,
+ *                     power down, check canaries
+ *     result          read: text report of the last run
+ *
+ *   HEVC core (see the HEVC-core section below):
+ *     core            0 = VDEC_1 (default), 1 = HEVC core
+ *     hevc_stream_bytes >0: program HEVC_STREAM_* over buf (payload bytes,
+ *                     fifo_pad more are covered by the write pointer)
+ *     hevc_stream_ctl !0: final HEVC_STREAM_CONTROL value (default: driver bits)
+ *     hevc_wait       0 = run run_ms; 1 = stop at the first mailbox IRQ
+ *                     (MBOX0/1_IRQ_REG != 0); 2 = also at SCRATCH_0 0x80/0x81
+ *     hevc_irq_us     read: first mailbox IRQ after start, us (0 = none)
+ *     hevc_reglist    write: HEVC-local indices (hex, < 0x1000) to dump
+ *     hevc_regs       read: live dump, only while the domain is up (stuck)
+ *     hevc_lmem_words >0: host LMEM DMA of that many halfwords after the halt
+ *     hevc_lmem_ctrl  LMEM_DMA_CTRL base for that dump (default 0x8000)
+ *     hevc_lmem, hevc_lmem_paddr  the dump buffer (8 KiB, canaried)
+ *     hevc_state      read: 0 down, 1 up, 2 left up by a failed stop
+ *     hevc_prog       write: host register programme, one "idx value [mask]"
+ *                     per line (hex; idx = HEVC-local index < 0x1000); applied
+ *                     in order after the image load and the stream setup,
+ *                     before SCRATCH_K/L/0/1 and the start; with a mask the
+ *                     write is read-modify-write of the mask bits.  Empty
+ *                     write clears it.  Needed by stateless firmware that
+ *                     expects the driver's session init (ovp9-sl: parser
+ *                     command table, shifter, IPP, output format).  The
+ *                     programme may point hardware DMA anywhere: runners
+ *                     must only name addresses inside buf, fb or hevc_lmem.
+ *   arg0/arg1 go to HEVC_ASSIST_SCRATCH_K/L and scratch0/scratch1 to
+ *   HEVC_ASSIST_SCRATCH_0/1 before start; the report has the same tags as
+ *   for VDEC_1 plus "core: hevc", "pc-trace", "mbox-irq", "*-stream".
+ *
+ * The bracket is the driver's own session start/stop sequence with no
+ * VIFIFO, no ESPARSER and the host MBOX1 IRQ masked.  The only DMA target
+ * an image can legitimately reach is `buf`, which sits between two 4 KiB
+ * canary pages that are verified after every run.  Refuses to run while a
+ * decode session owns the core.
+ */
+
+#include <linux/debugfs.h>
+#include <linux/delay.h>
+#include <linux/dma-mapping.h>
+#include <linux/ktime.h>
+#include <linux/slab.h>
+#include <linux/uaccess.h>
+
+#include "amvdec.h"
+#include "amvdec_helpers.h"
+#include "amrisc_test.h"
+#include "dos_regs.h"
+#include "hevc_regs.h"
+
+/* AMRISC control block, CBUS 0x300.. (byte offset = index * 4) */
+#define AT_MSP			0x0c00
+#define AT_MPSR			0x0c04
+#define AT_MINT_VEC_BASE	0x0c08
+#define AT_MCPU_INTR_GRP	0x0c0c
+#define AT_MCPU_INTR_MSK	0x0c10
+#define AT_MCPU_INTR_REQ	0x0c14
+#define AT_MPC_P		0x0c18
+#define AT_MPC_D		0x0c1c
+#define AT_MPC_E		0x0c20
+#define AT_MPC_W		0x0c24
+#define AT_CPSR			0x0c84
+#define AT_IMEM_DMA_CTRL	0x0d00
+#define AT_IMEM_DMA_ADR		0x0d04
+#define AT_IMEM_DMA_COUNT	0x0d08
+#define AT_LMEM_DMA_CTRL	0x0d40
+#define AT_LMEM_DMA_ADR		0x0d44
+#define AT_LMEM_DMA_COUNT	0x0d48
+#define AT_WRRSP_LMEM		0x0d4c
+#define AT_ASSIST_MBOX1_IRQ	0x01d0
+#define AT_ASSIST_MBOX1_CLR	0x01d4
+#define AT_ASSIST_MBOX1_MASK	0x01d8
+#define AT_AV_SCRATCH_0		0x2700
+#define AT_AV_SCRATCH_K		0x2750
+#define AT_AV_SCRATCH_L		0x2754
+#define AT_NUM_SCRATCH		22	/* AV_SCRATCH_0..9, A..L */
+
+#define AT_IMAGE_SIZE		AMVDEC_FW_SIZE
+#define AT_RESULT_SIZE		(64 * 1024)
+#define AT_PC_SAMPLES		16
+#define AT_CANARY_SIZE		4096
+#define AT_BUF_SIZE		(1024 * 1024)
+#define AT_FIFO_SIZE		AT_BUF_SIZE	/* the whole buf is the VIFIFO */
+#define AT_FB_ALLOC_SIZE	(AT_FB_SIZE + 2 * AT_CANARY_SIZE)
+#define AT_FB_SLOT		(2 * 1024 * 1024)	/* 1280x720 NV12 + co-located MVs */
+#define AT_FB_NUM		20
+#define AT_FB_WS_OFF		(AT_FB_NUM * AT_FB_SLOT)
+#define AT_FB_WS_SIZE		(4 * 1024 * 1024)	/* firmware workspace after the frame slots */
+#define AT_FB_SIZE		(AT_FB_NUM * AT_FB_SLOT + AT_FB_WS_SIZE)
+#define AT_NUM_CANVAS		(2 * AT_FB_NUM)
+#define AT_ALLOC_SIZE		(AT_BUF_SIZE + 2 * AT_CANARY_SIZE)
+#define AT_MAX_REGS		1024
+#define AT_ARCH_SIZE		(48 * 1024 * 1024)	/* auto-ack archive of output frames */
+
+static struct amvdec_core *at_core;
+static struct dentry *at_dir;
+static u8 *at_image;
+static size_t at_image_len;
+static char *at_result;
+static size_t at_result_len;
+static u32 at_run_ms = 100;
+static u32 at_load_only;
+static u32 at_imem_dma_ctrl = 0x8000 | (7 << 16);
+static u32 at_imem_dma_count = AT_IMAGE_SIZE / 4;
+static u32 at_arg0, at_arg1;
+static u32 at_scratch0, at_scratch1;
+static u32 at_auto_ack;	/* legacy contract: clear MREG_BUFFEROUT as pictures come out */
+static void *at_arch;		/* 1 = ack only; 2 = ack, archive the frame, release the buffer */
+static dma_addr_t at_arch_map;
+static u32 at_arch_frames;	/* written to AV_SCRATCH_0/1 before start (stateless ABI) */
+static void *at_fb_alloc;
+static dma_addr_t at_fb_map;	/* data region (after low canary) */
+static u8 at_canvas[AT_NUM_CANVAS];
+static bool at_canvas_ok;
+static u32 at_fb_w = 256, at_fb_h = 144;
+static u32 at_fifo_pad = 0x400;	/* bytes past the payload the WP covers (zeros in buf) */
+static u32 at_fifo_bytes;	/* >0: host programs VIFIFO over buf like the driver */
+static u32 at_mpeg12_init;	/* 1: host codec_mpeg12 start writes */
+static void *at_alloc;		/* canary | buf | canary */
+static dma_addr_t at_alloc_map;
+static u32 *at_reglist;
+static unsigned int at_nregs;
+static DEFINE_MUTEX(at_lock);
+
+static const struct { const char *name; u32 off; } at_ctrl_regs[] = {
+	{ "MSP", AT_MSP }, { "MPSR", AT_MPSR },
+	{ "MINT_VEC_BASE", AT_MINT_VEC_BASE },
+	{ "MCPU_INTR_GRP", AT_MCPU_INTR_GRP },
+	{ "MCPU_INTR_MSK", AT_MCPU_INTR_MSK },
+	{ "MCPU_INTR_REQ", AT_MCPU_INTR_REQ },
+	{ "MPC_P", AT_MPC_P }, { "MPC_D", AT_MPC_D },
+	{ "MPC_E", AT_MPC_E }, { "MPC_W", AT_MPC_W },
+	{ "CPSR", AT_CPSR },
+	{ "IMEM_DMA_CTRL", AT_IMEM_DMA_CTRL },
+	{ "LMEM_DMA_CTRL", AT_LMEM_DMA_CTRL },
+	{ "LMEM_DMA_ADR", AT_LMEM_DMA_ADR },
+	{ "LMEM_DMA_COUNT", AT_LMEM_DMA_COUNT },
+	{ "WRRSP_LMEM", AT_WRRSP_LMEM },
+	{ "ASSIST_MBOX1_IRQ", AT_ASSIST_MBOX1_IRQ },
+	{ "ASSIST_MBOX1_MASK", AT_ASSIST_MBOX1_MASK },
+};
+
+static __printf(1, 2) void at_printf(const char *fmt, ...)
+{
+	va_list args;
+	int n;
+
+	if (at_result_len >= AT_RESULT_SIZE - 1)
+		return;
+	va_start(args, fmt);
+	n = vsnprintf(at_result + at_result_len,
+		      AT_RESULT_SIZE - at_result_len, fmt, args);
+	va_end(args);
+	if (n > 0)
+		at_result_len = min_t(size_t, at_result_len + n,
+				      AT_RESULT_SIZE - 1);
+}
+
+static void at_snapshot(struct amvdec_core *core, const char *tag)
+{
+	int i;
+
+	at_printf("%s:", tag);
+	for (i = 0; i < ARRAY_SIZE(at_ctrl_regs); i++)
+		at_printf(" %s=%08x", at_ctrl_regs[i].name,
+			  meson_amvdec_read_dos(core, at_ctrl_regs[i].off));
+	at_printf("\n%s-scratch:", tag);
+	for (i = 0; i < AT_NUM_SCRATCH; i++)
+		at_printf(" %08x",
+			  meson_amvdec_read_dos(core, AT_AV_SCRATCH_0 + 4 * i));
+	at_printf("\n");
+}
+
+static void at_regdump(struct amvdec_core *core, const char *tag)
+{
+	unsigned int i;
+
+	if (!at_nregs)
+		return;
+	at_printf("%s-regs:", tag);
+	for (i = 0; i < at_nregs; i++)
+		at_printf("%s%03x=%08x", (i % 8) ? " " : "\n ", at_reglist[i],
+			  meson_amvdec_read_dos(core, at_reglist[i] * 4));
+	at_printf("\n");
+}
+
+static u32 at_canary_word(unsigned int i, bool hi)
+{
+	return (hi ? 0xc5000000 : 0xca000000) ^ (i * 0x9e3779b1u);
+}
+
+static void at_canary_fill_one(void *base, size_t data)
+{
+	u32 *lo = base, *hi = base + AT_CANARY_SIZE + data;
+	unsigned int i;
+
+	for (i = 0; i < AT_CANARY_SIZE / 4; i++) {
+		lo[i] = at_canary_word(i, false);
+		hi[i] = at_canary_word(i, true);
+	}
+}
+
+static void at_canary_check_one(const char *name, void *base, size_t data)
+{
+	u32 *lo = base, *hi = base + AT_CANARY_SIZE + data;
+	unsigned int i, bad_lo = 0, bad_hi = 0;
+
+	for (i = 0; i < AT_CANARY_SIZE / 4; i++) {
+		if (lo[i] != at_canary_word(i, false) && !bad_lo++)
+			at_printf("%s CANARY-LO CORRUPT at +%#x: %08x\n", name, i * 4, lo[i]);
+		if (hi[i] != at_canary_word(i, true) && !bad_hi++)
+			at_printf("%s CANARY-HI CORRUPT at +%#x: %08x\n", name, i * 4, hi[i]);
+	}
+	at_printf("canary-%s: lo %s (%u) hi %s (%u)\n", name,
+		  bad_lo ? "CORRUPT" : "ok", bad_lo,
+		  bad_hi ? "CORRUPT" : "ok", bad_hi);
+}
+
+static void at_canary_fill(void)
+{
+	at_canary_fill_one(at_alloc, AT_BUF_SIZE);
+	if (at_fb_alloc)
+		at_canary_fill_one(at_fb_alloc, AT_FB_SIZE);
+}
+
+static void at_canary_check(void)
+{
+	at_canary_check_one("buf", at_alloc, AT_BUF_SIZE);
+	if (at_fb_alloc)
+		at_canary_check_one("fb", at_fb_alloc, AT_FB_SIZE);
+}
+
+static int at_load_image(struct amvdec_core *core)
+{
+	void *buf;
+	dma_addr_t map;
+	int i;
+
+	buf = dma_alloc_coherent(core->dev, AT_IMAGE_SIZE, &map, GFP_KERNEL);
+	if (!buf)
+		return -ENOMEM;
+	memset(buf, 0, AT_IMAGE_SIZE);
+	memcpy(buf, at_image, at_image_len);
+
+	meson_amvdec_write_dos(core, AT_MPSR, 0);
+	meson_amvdec_write_dos(core, AT_CPSR, 0);
+	meson_amvdec_clear_dos_bits(core, MDEC_PIC_DC_CTRL, BIT(31));
+
+	meson_amvdec_write_dos(core, AT_IMEM_DMA_ADR, map);
+	meson_amvdec_write_dos(core, AT_IMEM_DMA_COUNT, at_imem_dma_count);
+	meson_amvdec_write_dos(core, AT_IMEM_DMA_CTRL, at_imem_dma_ctrl);
+
+	for (i = 0; i < 100000; i++) {
+		if (!(meson_amvdec_read_dos(core, AT_IMEM_DMA_CTRL) & 0x8000))
+			break;
+		udelay(10);
+	}
+	dma_free_coherent(core->dev, AT_IMAGE_SIZE, buf, map);
+	if (i == 100000) {
+		at_printf("error: IMEM DMA did not complete\n");
+		return -ETIMEDOUT;
+	}
+	at_printf("imem-dma: %zu bytes, ctrl=%08x count=%u, busy %d0 us\n",
+		  at_image_len, at_imem_dma_ctrl, at_imem_dma_count, i);
+	return 0;
+}
+
+/* VIFIFO over `buf`, same sequence as codec_mpeg12_sl_input() + fill enable */
+static void at_host_fifo(struct amvdec_core *core)
+{
+	dma_addr_t src = at_alloc_map;
+	u32 wp = round_down(src + at_fifo_bytes + at_fifo_pad, 8);
+
+	meson_amvdec_write_dos(core, DOS_GEN_CTRL0, 0);
+	meson_amvdec_write_dos(core, POWER_CTL_VLD, BIT(4));
+	meson_amvdec_write_dos(core, VLD_MEM_VIFIFO_CONTROL, 0);
+	meson_amvdec_write_dos(core, VLD_MEM_VIFIFO_START_PTR, src);
+	meson_amvdec_write_dos(core, VLD_MEM_VIFIFO_END_PTR, src + AT_FIFO_SIZE - 8);
+	meson_amvdec_write_dos(core, VLD_MEM_VIFIFO_CURR_PTR, src);
+	meson_amvdec_write_dos(core, VLD_MEM_VIFIFO_CONTROL, 1);
+	meson_amvdec_write_dos(core, VLD_MEM_VIFIFO_CONTROL, 0);
+	meson_amvdec_write_dos(core, VLD_MEM_VIFIFO_BUF_CNTL, 2);
+	meson_amvdec_write_dos(core, VLD_MEM_VIFIFO_RP, src);
+	meson_amvdec_write_dos(core, VLD_MEM_VIFIFO_WP, wp);
+	meson_amvdec_write_dos(core, VLD_MEM_VIFIFO_BUF_CNTL, 3);
+	meson_amvdec_write_dos(core, VLD_MEM_VIFIFO_BUF_CNTL, 2);
+	meson_amvdec_write_dos(core, VLD_MEM_VIFIFO_CONTROL,
+			       (0x11 << 16) | BIT(10) | (7 << 3));
+	meson_amvdec_write_dos(core, VIFF_BIT_CNT, at_fifo_bytes * 8);
+	meson_amvdec_write_dos_bits(core, VLD_MEM_VIFIFO_CONTROL, 0x6);
+	at_printf("host-fifo: start=%pad wp=%08x bytes=%u\n", &src, wp, at_fifo_bytes);
+}
+
+/*
+ * codec_mpeg12.c start(): the registers the host sets before MPSR=1.
+ * mpeg12_init=1: VLD-side registers only.  mpeg12_init=2: also the legacy
+ * single-instance contract: 8 NV12 frame slots in `fb` as canvas pairs in
+ * AV_SCRATCH_0..7, workspace at fb+512K (MREG_CO_MV_START = +5K), MREG_CMD,
+ * MDEC_PIC_DC_CTRL bit 17 (2-plane output).
+ */
+static void at_host_mpeg12(struct amvdec_core *core)
+{
+	u32 w = ALIGN(at_fb_w, 64), h = ALIGN(at_fb_h, 32);
+	int i;
+
+	meson_amvdec_write_dos(core, MPEG1_2_REG, 0);
+	meson_amvdec_write_dos(core, PSCALE_CTRL, 0);
+	meson_amvdec_write_dos(core, PIC_HEAD_INFO, 0x380);
+	meson_amvdec_write_dos(core, M4_CONTROL_REG, 0);
+	if (at_mpeg12_init < 2 || !at_fb_alloc || !at_canvas_ok) {
+		at_printf("host-mpeg12-init: vld regs only\n");
+		return;
+	}
+	if (at_mpeg12_init == 3) {
+		/* stateless: canvases configured, words reported, nothing in scratch */
+		at_printf("canvas-words:");
+		for (i = 0; i < AT_FB_NUM; i++) {
+			dma_addr_t y = at_fb_map + i * AT_FB_SLOT, uv = y + w * h;
+			u8 cy = at_canvas[2 * i], cuv = at_canvas[2 * i + 1];
+
+			meson_canvas_config(core->canvas, cy, y, w, h,
+					    MESON_CANVAS_WRAP_NONE,
+					    MESON_CANVAS_BLKMODE_LINEAR,
+					    MESON_CANVAS_ENDIAN_SWAP64);
+			meson_canvas_config(core->canvas, cuv, uv, w, h / 2,
+					    MESON_CANVAS_WRAP_NONE,
+					    MESON_CANVAS_BLKMODE_LINEAR,
+					    MESON_CANVAS_ENDIAN_SWAP64);
+			at_printf(" %08x", (cuv << 16) | (cuv << 8) | cy);
+		}
+		at_printf("\n");
+		meson_amvdec_write_dos_bits(core, MDEC_PIC_DC_CTRL, BIT(17));
+		return;
+	}
+	if (w * h + w * h / 2 > AT_FB_SLOT) {
+		at_printf("host-mpeg12-init: %ux%u does not fit a slot\n", w, h);
+		return;
+	}
+	for (i = 0; i < AT_FB_NUM; i++) {
+		dma_addr_t y = at_fb_map + i * AT_FB_SLOT, uv = y + w * h;
+		u8 cy = at_canvas[2 * i], cuv = at_canvas[2 * i + 1];
+
+		meson_canvas_config(core->canvas, cy, y, w, h,
+				    MESON_CANVAS_WRAP_NONE,
+				    MESON_CANVAS_BLKMODE_LINEAR,
+				    MESON_CANVAS_ENDIAN_SWAP64);
+		meson_canvas_config(core->canvas, cuv, uv, w, h / 2,
+				    MESON_CANVAS_WRAP_NONE,
+				    MESON_CANVAS_BLKMODE_LINEAR,
+				    MESON_CANVAS_ENDIAN_SWAP64);
+		meson_amvdec_write_dos(core, AT_AV_SCRATCH_0 + 4 * i,
+				       (cuv << 16) | (cuv << 8) | cy);
+	}
+	/* the legacy firmware may allocate 8 buffers: alias 6/7 onto slots 4/5 */
+	for (; i < 8; i++)
+		meson_amvdec_write_dos(core, AT_AV_SCRATCH_0 + 4 * i,
+				       meson_amvdec_read_dos(core, AT_AV_SCRATCH_0 + 4 * (i - 2)));
+	meson_amvdec_write_dos(core, AT_AV_SCRATCH_0 + 4 * 0xb,
+			       at_fb_map + AT_FB_WS_OFF + 5 * SZ_1K);
+	meson_amvdec_write_dos(core, AT_AV_SCRATCH_0 + 4 * 0xa,
+			       (at_fb_w << 16) | at_fb_h);
+	meson_amvdec_write_dos(core, AT_AV_SCRATCH_0 + 4 * 8, 0);
+	meson_amvdec_write_dos(core, AT_AV_SCRATCH_0 + 4 * 9, 0);
+	meson_amvdec_write_dos(core, AT_AV_SCRATCH_0 + 4 * 0xc, 0);
+	meson_amvdec_write_dos(core, AT_AV_SCRATCH_0 + 4 * 0xe, 0);
+	meson_amvdec_write_dos(core, AT_AV_SCRATCH_0 + 4 * 0xf, 0);
+	meson_amvdec_write_dos_bits(core, MDEC_PIC_DC_CTRL, BIT(17));
+	at_printf("host-mpeg12-init: legacy, %ux%u (%ux%u aligned), canvases %u/%u.., fb=%pad ws=%pad\n",
+		  at_fb_w, at_fb_h, w, h, at_canvas[0], at_canvas[1], &at_fb_map,
+		  &(dma_addr_t){ at_fb_map + AT_FB_WS_OFF });
+}
+
+/*
+ * ---------------------------------------------------------------------------
+ * HEVC-core AMRISC (core = 1)
+ *
+ * The HEVC core's register file sits at dos byte 0xc000: its firmware-local
+ * CBUS index i (the numbering of amrisc/data/cbus_hevc.json and of the
+ * "local" addresses in the ucode docs) is dos byte 0xc000 + 4 * i.  Its
+ * AMRISC control block is the VDEC_1 one moved by 0xc000 (MPSR 0xcc04,
+ * MPC_P..W 0xcc18..0xcc24, CPSR 0xcc84, IMEM DMA 0xcd00.., LMEM DMA
+ * 0xcd40..), its mailboxes are HEVC_ASSIST_MBOX0/1 (0xc1c0.., 0xc1d0..) and
+ * the vendor firmware's host handshake registers are HEVC_ASSIST_SCRATCH_0..N
+ * (0xc300..0xc35c; SCRATCH_0 = HEVC/VP9_DEC_STATUS_REG).
+ *
+ * SAFETY: reading or writing any register in 0xc000..0xfbff with the HEVC
+ * domain down hangs the SoC.  Every such access goes through ah_read() /
+ * ah_write(), which refuse unless ah_powered is set; ah_powered is only ever
+ * set by the power bracket in amvdec_hevc.c.  The DOS top registers
+ * (0xfc00.., DOS_SW_RESET3 etc.) are outside the domain.
+ * ---------------------------------------------------------------------------
+ */
+#define AH_BASE			0xc000	/* local index i -> dos byte AH_BASE + 4 * i */
+#define AH_LOCAL_MAX		0x1000
+#define AH_CTRL(vdec1_off)	(AH_BASE + (vdec1_off))	/* AT_* control offsets moved to the HEVC block */
+#define AH_MPSR			AH_CTRL(AT_MPSR)
+#define AH_MPC_P		AH_CTRL(AT_MPC_P)
+#define AH_CPSR			AH_CTRL(AT_CPSR)
+#define AH_IMEM_DMA_CTRL	AH_CTRL(AT_IMEM_DMA_CTRL)
+#define AH_IMEM_DMA_ADR		AH_CTRL(AT_IMEM_DMA_ADR)
+#define AH_IMEM_DMA_COUNT	AH_CTRL(AT_IMEM_DMA_COUNT)
+#define AH_LMEM_DMA_CTRL	AH_CTRL(AT_LMEM_DMA_CTRL)
+#define AH_LMEM_DMA_ADR		AH_CTRL(AT_LMEM_DMA_ADR)
+#define AH_LMEM_DMA_COUNT	AH_CTRL(AT_LMEM_DMA_COUNT)
+#define AH_WRRSP_LMEM		AH_CTRL(AT_WRRSP_LMEM)
+#define AH_MBOX0_IRQ		0xc1c0
+#define AH_MBOX0_CLR		0xc1c4
+#define AH_MBOX0_MASK		0xc1c8
+#define AH_MBOX1_IRQ		0xc1d0
+#define AH_MBOX1_CLR		HEVC_ASSIST_MBOX1_CLR_REG	/* 0xc1d4 */
+#define AH_MBOX1_MASK		HEVC_ASSIST_MBOX1_MASK		/* 0xc1d8 */
+#define AH_NUM_SCRATCH		24	/* HEVC_ASSIST_SCRATCH_0..9, A..N */
+#define AH_LMEM_MAX		4096	/* halfwords the host dump can hold */
+#define AH_LMEM_SIZE		(AH_LMEM_MAX * 2)
+#define AH_LMEM_ALLOC_SIZE	(AH_LMEM_SIZE + 2 * AT_CANARY_SIZE)
+#define AH_LMEM_CHUNK		0x100	/* halfwords per host LMEM DMA */
+#define AH_PC_TRACE		256
+
+static u32 at_core_sel;			/* 0 = VDEC_1 (default), 1 = HEVC core */
+static bool ah_powered;			/* HEVC domain up: HEVC registers may be touched */
+static bool ah_stuck;			/* a power down failed: domain left up, runs refused */
+static u32 ah_stream_bytes;		/* >0: host programs HEVC_STREAM_* over buf */
+static u32 ah_stream_ctl;		/* !0: final HEVC_STREAM_CONTROL instead of the driver's bits */
+static u32 ah_wait;			/* 0 run_ms; 1 until a mailbox IRQ; 2 also SCRATCH_0 0x80/0x81 */
+static u32 ah_lmem_words;		/* >0: host LMEM -> hevc_lmem dump after the halt */
+static u32 ah_lmem_ctrl = 0x8000;	/* LMEM_DMA_CTRL base (| LMEM address); bit 14 clear = LMEM -> DDR */
+static u32 ah_irq_us;			/* first mailbox IRQ seen after start, us (0 = none) */
+static void *ah_lmem_alloc;		/* canary | lmem | canary */
+static dma_addr_t ah_lmem_map;
+static u32 *ah_reglist;
+static unsigned int ah_nregs;
+#define AH_PROG_MAX		512
+static u32 (*ah_prog)[3];		/* hevc_prog: local index, value, mask (0 = plain write) */
+static unsigned int ah_nprog;
+
+static const struct { const char *name; u32 off; } ah_extra_regs[] = {
+	{ "MBOX0_IRQ", AH_MBOX0_IRQ }, { "MBOX0_MASK", AH_MBOX0_MASK },
+};
+
+static const struct { const char *name; u32 off; } ah_stream_regs[] = {
+	{ "CONTROL", HEVC_STREAM_CONTROL }, { "START", HEVC_STREAM_START_ADDR },
+	{ "END", HEVC_STREAM_END_ADDR }, { "WR", HEVC_STREAM_WR_PTR },
+	{ "RD", HEVC_STREAM_RD_PTR }, { "LEVEL", HEVC_STREAM_LEVEL },
+	{ "FIFO_CTL", HEVC_STREAM_FIFO_CTL },
+	{ "SHIFT_BYTE_COUNT", HEVC_SHIFT_BYTE_COUNT },
+};
+
+static u32 ah_read(struct amvdec_core *core, u32 off)
+{
+	if (WARN_ONCE(!ah_powered, "amrisc-test: HEVC register %#x read with the domain down\n", off))
+		return 0xdeadbeef;
+	return meson_amvdec_read_dos(core, off);
+}
+
+static void ah_write(struct amvdec_core *core, u32 off, u32 val)
+{
+	if (WARN_ONCE(!ah_powered, "amrisc-test: HEVC register %#x written with the domain down\n", off))
+		return;
+	meson_amvdec_write_dos(core, off, val);
+}
+
+static void ah_snapshot(struct amvdec_core *core, const char *tag)
+{
+	int i;
+
+	at_printf("%s:", tag);
+	for (i = 0; i < ARRAY_SIZE(at_ctrl_regs); i++)
+		at_printf(" %s=%08x", at_ctrl_regs[i].name,
+			  ah_read(core, AH_CTRL(at_ctrl_regs[i].off)));
+	for (i = 0; i < ARRAY_SIZE(ah_extra_regs); i++)
+		at_printf(" %s=%08x", ah_extra_regs[i].name,
+			  ah_read(core, ah_extra_regs[i].off));
+	at_printf("\n%s-scratch:", tag);
+	for (i = 0; i < AH_NUM_SCRATCH; i++)
+		at_printf(" %08x", ah_read(core, HEVC_ASSIST_SCRATCH_0 + 4 * i));
+	at_printf("\n");
+	if (!ah_stream_bytes)
+		return;
+	at_printf("%s-stream:", tag);
+	for (i = 0; i < ARRAY_SIZE(ah_stream_regs); i++)
+		at_printf(" %s=%08x", ah_stream_regs[i].name,
+			  ah_read(core, ah_stream_regs[i].off));
+	at_printf("\n");
+}
+
+static void ah_regdump(struct amvdec_core *core, const char *tag)
+{
+	unsigned int i;
+
+	if (!ah_nregs)
+		return;
+	at_printf("%s-regs:", tag);
+	for (i = 0; i < ah_nregs; i++)
+		at_printf("%s%03x=%08x", (i % 8) ? " " : "\n ", ah_reglist[i],
+			  ah_read(core, AH_BASE + ah_reglist[i] * 4));
+	at_printf("\n");
+}
+
+/* amvdec_hevc_load_firmware() with the harness image and IMEM DMA knobs */
+static int ah_load_image(struct amvdec_core *core)
+{
+	void *buf;
+	dma_addr_t map;
+	int i;
+
+	buf = dma_alloc_coherent(core->dev, AT_IMAGE_SIZE, &map, GFP_KERNEL);
+	if (!buf)
+		return -ENOMEM;
+	memset(buf, 0, AT_IMAGE_SIZE);
+	memcpy(buf, at_image, at_image_len);
+
+	ah_write(core, AH_MPSR, 0);
+	ah_write(core, AH_CPSR, 0);
+
+	ah_write(core, AH_IMEM_DMA_ADR, map);
+	ah_write(core, AH_IMEM_DMA_COUNT, at_imem_dma_count);
+	ah_write(core, AH_IMEM_DMA_CTRL, at_imem_dma_ctrl);
+
+	for (i = 0; i < 100000; i++) {
+		if (!(ah_read(core, AH_IMEM_DMA_CTRL) & 0x8000))
+			break;
+		udelay(10);
+	}
+	if (i == 100000) {
+		/* the engine may still read it: leak rather than free under DMA */
+		at_printf("error: HEVC IMEM DMA did not complete (image buffer leaked)\n");
+		return -ETIMEDOUT;
+	}
+	dma_free_coherent(core->dev, AT_IMAGE_SIZE, buf, map);
+	at_printf("imem-dma: %zu bytes, ctrl=%08x count=%u, busy %d0 us\n",
+		  at_image_len, at_imem_dma_ctrl, at_imem_dma_count, i);
+	return 0;
+}
+
+/*
+ * HEVC_STREAM_* over `buf`, frame-based input as the vendor's
+ * vdec_prepare_input() / vdec_enable_input() program it for the HEVC core:
+ * fetch off, window and read/write pointers, stream endian (bits 6:4), then
+ * FIFO_CTL bit 29 and fetch on. No ESPARSER: DOS_GEN_CTRL0 and CONTROL bit 3
+ * (parser-fed write pointer) stay clear - with them set the write pointer
+ * reads back 0 and the core fetches around the whole ring (measured
+ * 2026-09-29, VIM3). Verified: CONTROL 0x0eb14071 lets ovp9-sl find the
+ * AMLV frame.
+ */
+static void ah_host_stream(struct amvdec_core *core)
+{
+	dma_addr_t src = at_alloc_map;
+	u32 end = src + AT_FIFO_SIZE;
+	u32 wp = min_t(u32, round_down(src + ah_stream_bytes + at_fifo_pad, 8), end);
+	u32 ctl;
+
+	meson_amvdec_write_dos(core, DOS_GEN_CTRL0, 0);
+	/* keep the other CONTROL bits (reset value 0x0eb14000): zeroing them
+	 * stops the start-code search from ever matching (measured 2026-09-29) */
+	ah_write(core, HEVC_STREAM_CONTROL, ah_read(core, HEVC_STREAM_CONTROL) & ~(BIT(3) | BIT(0)));
+	ah_write(core, HEVC_STREAM_START_ADDR, src);
+	ah_write(core, HEVC_STREAM_END_ADDR, end);
+	ah_write(core, HEVC_STREAM_RD_PTR, src);
+	ah_write(core, HEVC_STREAM_WR_PTR, wp);
+	ah_write(core, HEVC_STREAM_CONTROL, ah_read(core, HEVC_STREAM_CONTROL) | (7 << 4));
+	ah_write(core, HEVC_STREAM_FIFO_CTL,
+		 ah_read(core, HEVC_STREAM_FIFO_CTL) | BIT(29));
+
+	if (ah_stream_ctl) {
+		ctl = ah_stream_ctl;
+	} else {
+		/* vendor frame mode: endian 6:4 = 7, fetch on (0x0eb14071 on G12B) */
+		ctl = ah_read(core, HEVC_STREAM_CONTROL) | (7 << 4) | BIT(0);
+	}
+	ah_write(core, HEVC_STREAM_CONTROL, ctl);
+	at_printf("host-stream: start=%pad end=%08x wp=%08x bytes=%u control=%08x\n",
+		  &src, end, wp, ah_stream_bytes, ctl);
+}
+
+static bool ah_wait_idle(struct amvdec_core *core, unsigned int us)
+{
+	unsigned int i;
+
+	for (i = 0; i < us / 10; i++) {
+		if (!(ah_read(core, AH_LMEM_DMA_CTRL) & 0x8000) &&
+		    !(ah_read(core, AH_WRRSP_LMEM) & 0xfff))
+			return true;
+		udelay(10);
+	}
+	return false;
+}
+
+/* Host-driven LMEM -> DDR copy after the halt, in AH_LMEM_CHUNK pieces */
+static void ah_lmem_dump(struct amvdec_core *core)
+{
+	u32 n = min_t(u32, ah_lmem_words, AH_LMEM_MAX), off;
+
+	if (!ah_lmem_alloc) {
+		at_printf("lmem-dump: no buffer\n");
+		return;
+	}
+	if (!ah_wait_idle(core, 10000)) {
+		at_printf("lmem-dump: skipped, LMEM DMA busy after the halt (ctrl=%08x wrrsp=%08x)\n",
+			  ah_read(core, AH_LMEM_DMA_CTRL), ah_read(core, AH_WRRSP_LMEM));
+		return;
+	}
+	memset(ah_lmem_alloc + AT_CANARY_SIZE, 0x5a, AH_LMEM_SIZE);
+	for (off = 0; off < n; off += AH_LMEM_CHUNK) {
+		u32 cnt = min_t(u32, AH_LMEM_CHUNK, n - off);
+
+		ah_write(core, AH_LMEM_DMA_ADR, ah_lmem_map + off * 2);
+		ah_write(core, AH_LMEM_DMA_COUNT, cnt);
+		ah_write(core, AH_LMEM_DMA_CTRL, ah_lmem_ctrl | off);
+		if (!ah_wait_idle(core, 10000)) {
+			at_printf("lmem-dump: chunk at %#x did not complete (ctrl=%08x wrrsp=%08x)\n",
+				  off, ah_read(core, AH_LMEM_DMA_CTRL),
+				  ah_read(core, AH_WRRSP_LMEM));
+			return;
+		}
+	}
+	at_printf("lmem-dump: %u halfwords at %pad ctrl=%08x|addr (8-byte groups halfword-reversed)\n",
+		  n, &ah_lmem_map, ah_lmem_ctrl);
+}
+
+static u32 ah_mbox(struct amvdec_core *core)
+{
+	return (ah_read(core, AH_MBOX0_IRQ) & 0xffff) |
+	       (ah_read(core, AH_MBOX1_IRQ) << 16);
+}
+
+/* Called with core->lock and core->claim_lock held, no session, result reset */
+static int at_run_hevc(struct amvdec_core *core)
+{
+	static u32 trace[AH_PC_TRACE];	/* serialized by at_lock */
+	u32 pc[AT_PC_SAMPLES];
+	unsigned int ntrace = 0;
+	ktime_t t0;
+	int ret, ret2, i;
+
+	if (ah_stuck) {
+		at_printf("error: the HEVC core was left powered by a failed stop; reload the module\n");
+		return -EIO;
+	}
+
+	at_printf("core: hevc\n");
+	at_printf("image: %zu bytes, run_ms=%u, load_only=%u, arg0=%08x arg1=%08x scratch0=%08x scratch1=%08x wait=%u buf=%pad\n",
+		  at_image_len, at_run_ms, at_load_only, at_arg0, at_arg1,
+		  at_scratch0, at_scratch1, ah_wait, &at_alloc_map);
+	if (at_fifo_bytes || at_mpeg12_init || at_auto_ack)
+		at_printf("note: fifo_bytes/mpeg12_init/auto_ack are VDEC_1 knobs, ignored on the HEVC core\n");
+	at_canary_fill();
+	if (ah_lmem_alloc)
+		at_canary_fill_one(ah_lmem_alloc, AH_LMEM_SIZE);
+	ah_irq_us = 0;
+
+	ret = meson_amvdec_hevc_test_power_up(core, &ah_powered);
+	if (ret) {
+		at_printf("error: HEVC power up failed %d, domain %s\n", ret,
+			  ah_powered ? "LEFT UP (ports parked)" : "down");
+		if (ah_powered)
+			ah_stuck = true;
+		goto out;
+	}
+
+	/* Host-side IRQs stay masked: the harness only ever polls */
+	ah_write(core, AH_MBOX1_MASK, 0);
+	ah_write(core, AH_MBOX0_MASK, 0);
+	ah_write(core, AH_MBOX1_CLR, 1);
+	ah_write(core, AH_MBOX0_CLR, 1);
+
+	ah_snapshot(core, "reset");
+	ah_regdump(core, "reset");
+
+	ret = ah_load_image(core);
+	if (ret)
+		goto down;
+
+	/*
+	 * Session programme (shifter, parser, IPP...) before the stream fetch is
+	 * enabled, as the vendor does (hw init, then vdec_enable_input): with the
+	 * fetch on first, the shifter consumed the AMLV envelope's length words
+	 * unconfigured and no start code ever validated (measured 2026-09-29).
+	 */
+	for (i = 0; i < ah_nprog; i++) {
+		u32 off = AH_BASE + ah_prog[i][0] * 4, v = ah_prog[i][1];
+
+		if (ah_prog[i][2])
+			v = (ah_read(core, off) & ~ah_prog[i][2]) | (v & ah_prog[i][2]);
+		ah_write(core, off, v);
+	}
+	if (ah_nprog)
+		at_printf("hevc-prog: %u writes\n", ah_nprog);
+	if (ah_stream_bytes)
+		ah_host_stream(core);
+	ah_write(core, HEVC_ASSIST_SCRATCH_K, at_arg0);
+	ah_write(core, HEVC_ASSIST_SCRATCH_L, at_arg1);
+	ah_write(core, HEVC_ASSIST_SCRATCH_0, at_scratch0);
+	ah_write(core, HEVC_ASSIST_SCRATCH_1, at_scratch1);
+	ah_snapshot(core, "loaded");
+	if (at_load_only)
+		goto down;
+
+	t0 = ktime_get();
+	meson_amvdec_hevc_test_start(core);
+	for (i = 0; i < AT_PC_SAMPLES; i++) {
+		pc[i] = ah_read(core, AH_MPC_P);
+		udelay(2);
+	}
+	if (ah_wait) {
+		/* poll: PC ring for profiling, stop at the first mailbox IRQ (or status) */
+		s64 limit = (s64)at_run_ms * 1000, us;
+
+		while ((us = ktime_us_delta(ktime_get(), t0)) < limit) {
+			u32 st;
+
+			trace[ntrace++ % AH_PC_TRACE] = ah_read(core, AH_MPC_P);
+			if (ah_mbox(core)) {
+				ah_irq_us = max_t(s64, us, 1);
+				break;
+			}
+			st = ah_read(core, HEVC_ASSIST_SCRATCH_0);
+			if (ah_wait == 2 && (st == 0x80 || st == 0x81))
+				break;
+			usleep_range(20, 40);
+		}
+	} else if (at_run_ms) {
+		msleep(at_run_ms);
+	}
+	at_printf("pc-early:");
+	for (i = 0; i < AT_PC_SAMPLES; i++)
+		at_printf(" %04x", pc[i]);
+	at_printf("\n");
+	if (ntrace) {
+		unsigned int first = ntrace > AH_PC_TRACE ? ntrace - AH_PC_TRACE : 0;
+
+		at_printf("pc-trace: %u samples, last %u:", ntrace, ntrace - first);
+		for (i = first; i < ntrace; i++)
+			at_printf(" %04x", trace[i % AH_PC_TRACE]);
+		at_printf("\n");
+	}
+	{
+		u32 m = ah_mbox(core);
+
+		at_printf("mbox-irq: mbox0=%x mbox1=%x first-seen-us=%u", m & 0xffff,
+			  m >> 16, ah_irq_us);
+		if (m) {
+			ah_write(core, AH_MBOX1_CLR, 1);
+			ah_write(core, AH_MBOX0_CLR, 1);
+			m = ah_mbox(core);
+			at_printf(" after-clear mbox0=%x mbox1=%x", m & 0xffff, m >> 16);
+		}
+		at_printf("\n");
+	}
+	ah_snapshot(core, "run");
+	ah_write(core, AH_MPSR, 0);
+	ah_write(core, AH_CPSR, 0);
+	at_printf("elapsed-us: %lld\n", ktime_us_delta(ktime_get(), t0));
+	ah_snapshot(core, "halted");
+	ah_regdump(core, "halted");
+	if (ah_lmem_words)
+		ah_lmem_dump(core);
+
+down:
+	ret2 = meson_amvdec_hevc_test_power_down(core, &ah_powered);
+	if (ret2) {
+		ah_stuck = true;
+		at_printf("error: HEVC power down failed %d: domain LEFT UP, DMC ports parked, buffers retained, HEVC runs refused until reload\n",
+			  ret2);
+		ret = ret ?: ret2;
+	}
+	at_canary_check();
+	if (ah_lmem_alloc)
+		at_canary_check_one("lmem", ah_lmem_alloc, AH_LMEM_SIZE);
+out:
+	at_printf("status: %s\n", ret ? "error" : "ok");
+	return ret;
+}
+
+static int at_run(void)
+{
+	struct amvdec_core *core = at_core;
+	u32 pc[AT_PC_SAMPLES];
+	ktime_t t0;
+	int ret, i;
+
+	if (!core)
+		return -ENODEV;
+	if (!at_image_len)
+		return -EINVAL;
+
+	if (at_core_sel > 1)
+		return -EINVAL;
+
+	/*
+	 * claim_lock too: vdec_start_streaming() claims the core under it and
+	 * vdec_poweroff() holds it until the hardware is stopped, so neither a
+	 * new session nor a session teardown can overlap a harness run.
+	 */
+	mutex_lock(&core->lock);
+	mutex_lock(&core->claim_lock);
+	if (core->cur_sess) {
+		mutex_unlock(&core->claim_lock);
+		mutex_unlock(&core->lock);
+		return -EBUSY;
+	}
+
+	at_result_len = 0;
+	if (at_core_sel == 1) {
+		ret = at_run_hevc(core);
+		goto out;
+	}
+	at_arch_frames = 0;
+	at_printf("image: %zu bytes, run_ms=%u, load_only=%u, arg0=%08x arg1=%08x buf=%pad\n",
+		  at_image_len, at_run_ms, at_load_only, at_arg0, at_arg1,
+		  &at_alloc_map);
+	at_printf("fb-geometry: base=%pad slot=%x slots=%u ws=%x\n", &at_fb_map,
+		  AT_FB_SLOT, AT_FB_NUM, AT_FB_WS_OFF);
+	at_canary_fill();
+
+	ret = meson_amvdec_1_test_power_up(core);
+	if (ret) {
+		at_printf("error: power up failed %d\n", ret);
+		goto out;
+	}
+
+	/* Host-side IRQ stays masked: the harness only ever polls */
+	meson_amvdec_write_dos(core, AT_ASSIST_MBOX1_MASK, 0);
+	meson_amvdec_write_dos(core, AT_ASSIST_MBOX1_CLR, 1);
+
+	at_snapshot(core, "reset");
+	at_regdump(core, "reset");
+
+	ret = at_load_image(core);
+	if (ret)
+		goto down;
+
+	if (at_fifo_bytes)
+		at_host_fifo(core);
+	if (at_mpeg12_init)
+		at_host_mpeg12(core);
+	meson_amvdec_write_dos(core, AT_AV_SCRATCH_K, at_arg0);
+	meson_amvdec_write_dos(core, AT_AV_SCRATCH_L, at_arg1);
+	if (at_mpeg12_init == 3) {
+		meson_amvdec_write_dos(core, AT_AV_SCRATCH_0, at_scratch0);
+		meson_amvdec_write_dos(core, AT_AV_SCRATCH_0 + 4, at_scratch1);
+	}
+	at_snapshot(core, "loaded");
+	if (at_load_only)
+		goto down;
+
+	t0 = ktime_get();
+	meson_amvdec_write_dos(core, AT_MPSR, 1);
+	for (i = 0; i < AT_PC_SAMPLES; i++) {
+		pc[i] = meson_amvdec_read_dos(core, AT_MPC_P);
+		udelay(2);
+	}
+	if (at_auto_ack) {
+		u32 t, n = 0;
+
+		at_printf("auto-ack:");
+		for (t = 0; t < at_run_ms; t++) {
+			u32 out = meson_amvdec_read_dos(core, AT_AV_SCRATCH_0 + 4 * 9);
+
+			if (out) {
+				u32 w = ALIGN(at_fb_w, 64), h = ALIGN(at_fb_h, 32);
+				u32 fsz = w * h * 3 / 2, idx = (out - 1) & 7;
+
+				at_printf(" [%u ms] out=%u picinfo=%08x", t, out,
+					  meson_amvdec_read_dos(core, AT_AV_SCRATCH_0 + 4 * 5));
+				if (at_auto_ack == 2 && at_arch && (at_arch_frames + 1) * fsz <= AT_ARCH_SIZE) {
+					u32 slot = idx < AT_FB_NUM ? idx : idx - 2;
+
+					memcpy(at_arch + at_arch_frames * fsz,
+					       at_fb_alloc + AT_CANARY_SIZE + slot * AT_FB_SLOT, fsz);
+					at_arch_frames++;
+				}
+				meson_amvdec_write_dos(core, AT_AV_SCRATCH_0 + 4 * 9, 0);
+				if (at_auto_ack == 2)	/* release the buffer: MREG_BUFFERIN = idx + 1 */
+					meson_amvdec_write_dos(core, AT_AV_SCRATCH_0 + 4 * 8, out);
+				n++;
+			}
+			/* user-data (AV_SCRATCH_M) and sequence-info (G) notifications want an ack */
+			if (meson_amvdec_read_dos(core, AT_AV_SCRATCH_0 + 4 * 0x16)) {
+				at_printf(" [%u ms] userdata", t);
+				meson_amvdec_write_dos(core, AT_AV_SCRATCH_0 + 4 * 0x16, 0);
+			}
+			if (meson_amvdec_read_dos(core, AT_AV_SCRATCH_0 + 4 * 0x10))
+				meson_amvdec_write_dos(core, AT_AV_SCRATCH_0 + 4 * 0x10, 0);
+			usleep_range(1000, 1200);
+		}
+		at_printf(" (%u pictures, %u archived)\n", n, at_arch_frames);
+	} else if (at_mpeg12_init == 3) {
+		/* stateless command: leave as soon as the firmware reports done/error */
+		u32 t;
+
+		for (t = 0; t < at_run_ms; t++) {
+			u32 st = meson_amvdec_read_dos(core, AT_AV_SCRATCH_0);
+
+			if (st == 0x80 || st == 0x81)
+				break;
+			usleep_range(200, 400);
+		}
+	} else if (at_run_ms)
+		msleep(at_run_ms);
+	at_printf("pc-early:");
+	for (i = 0; i < AT_PC_SAMPLES; i++)
+		at_printf(" %04x", pc[i]);
+	at_printf("\n");
+	at_snapshot(core, "run");
+	meson_amvdec_write_dos(core, AT_MPSR, 0);
+	at_printf("elapsed-us: %lld\n", ktime_us_delta(ktime_get(), t0));
+	at_snapshot(core, "halted");
+	at_regdump(core, "halted");
+
+down:
+	meson_amvdec_1_test_power_down(core);
+	at_canary_check();
+	at_printf("status: %s\n", ret ? "error" : "ok");
+out:
+	mutex_unlock(&core->claim_lock);
+	mutex_unlock(&core->lock);
+	return ret;
+}
