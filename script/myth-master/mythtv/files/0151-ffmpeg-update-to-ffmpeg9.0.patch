+        .text
+        .option push
+    .ifnb \ext
+        arch \ext
+    .endif
+    .if \export
+        .global EXTERN\name
+#ifdef __ELF__
+        .type   EXTERN\name, %function
+        .if !\visible
+            .hidden EXTERN\name
+        .endif
+#elif defined(__MACH__)
+        .if !\visible
+            .private_extern EXTERN\name
+        .endif
+#endif
+EXTERN\name:
