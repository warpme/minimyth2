From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Piotr Oniszczuk <piotr.oniszczuk@gmail.com>
Date: Thu, 26 Nov 2026 17:34:24 +0100
Subject: [PATCH] arm64: dts: amlogic: tanix-tx5: enable the IR receiver

Enable the IR receiver of the Tanix TX5 on GPIOD_5. The Tanix remote
uses the same codes as the Beelink GS1 one, so use the rc-beelink-gs1
keymap.

Signed-off-by: Piotr Oniszczuk <piotr.oniszczuk@gmail.com>
---
 .../arm64/boot/dts/amlogic/amlogic-s7-s905y5-tanix-tx5.dts | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/arch/arm64/boot/dts/amlogic/amlogic-s7-s905y5-tanix-tx5.dts b/arch/arm64/boot/dts/amlogic/amlogic-s7-s905y5-tanix-tx5.dts
index 8bccb3c..b25d863 100644
--- a/arch/arm64/boot/dts/amlogic/amlogic-s7-s905y5-tanix-tx5.dts
+++ b/arch/arm64/boot/dts/amlogic/amlogic-s7-s905y5-tanix-tx5.dts
@@ -204,6 +204,13 @@
 	status = "okay";
 };
 
+&ir {
+	linux,rc-map-name = "rc-beelink-gs1";
+	pinctrl-0 = <&remote_input_pins>;
+	pinctrl-names = "default";
+	status = "okay";
+};
+
 &sd {
 	pinctrl-0 = <&sdcard_pins>;
 	pinctrl-1 = <&sdcard_clk_gate_pins>;
-- 
2.43.0

