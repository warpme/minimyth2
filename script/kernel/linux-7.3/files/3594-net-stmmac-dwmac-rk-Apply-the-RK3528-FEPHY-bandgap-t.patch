Patch from MiniMyth2 project

Developed-by: Piotr Oniszczuk <piotr.oniszczuk@gmail.com>
Signed-off-by: Piotr Oniszczuk <piotr.oniszczuk@gmail.com>



From d26a293aa8fa66f5000d8e40bb973cd98e167dc3 Mon Sep 17 00:00:00 2001
From: Piotr Oniszczuk <piotr.oniszczuk@gmail.com>
Date: Tue, 24 Nov 2026 11:55:23 +0100
Subject: [PATCH 2/3] net: stmmac: dwmac-rk: Apply the RK3528 FEPHY bandgap
 trim from OTP

The bandgap reference of the RK3528 integrated FEPHY is trimmed in the
factory, with the value stored in OTP. The vendor kernel writes it to
VO_GRF_MACPHY_CON1 while powering the PHY up; mainline left the reset
default.

Read the optional "bgs" nvmem cell from the integrated PHY node and
program it during the FEPHY power-up, before the PHY leaves reset.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../net/ethernet/stmicro/stmmac/dwmac-rk.c    | 55 ++++++++++++++++++-
 1 file changed, 53 insertions(+), 2 deletions(-)

diff --git a/drivers/net/ethernet/stmicro/stmmac/dwmac-rk.c b/drivers/net/ethernet/stmicro/stmmac/dwmac-rk.c
index 72bdbcb5e..a5299266a 100644
--- a/drivers/net/ethernet/stmicro/stmmac/dwmac-rk.c
+++ b/drivers/net/ethernet/stmicro/stmmac/dwmac-rk.c
@@ -14,6 +14,7 @@
 #include <linux/phy.h>
 #include <linux/of_net.h>
 #include <linux/module.h>
+#include <linux/nvmem-consumer.h>
 #include <linux/of.h>
 #include <linux/platform_device.h>
 #include <linux/regulator/consumer.h>
@@ -104,6 +105,8 @@ struct rk_priv_data {
 	struct clk *clk_phy;
 
 	struct reset_control *phy_reset;
+	/* Bandgap trim of the integrated FEPHY, from OTP, or -1 if absent */
+	int fephy_bgs;
 
 	int tx_delay;
 	int rx_delay;
@@ -298,9 +301,11 @@ static void rk_gmac_integrated_ephy_powerdown(struct rk_priv_data *priv)
 #define RK_FEPHY_INTERNAL_RMII_SEL	GRF_BIT(6)
 #define RK_FEPHY_24M_CLK_SEL		GRF_FIELD(9, 8, 3)
 #define RK_FEPHY_PHY_ID			GRF_BIT(11)
+#define RK_FEPHY_BGS_MASK		GENMASK_U16(3, 0)
 
 static void rk_gmac_integrated_fephy_powerup(struct rk_priv_data *priv,
-					     unsigned int reg)
+					     unsigned int reg,
+					     unsigned int bgs_reg)
 {
 	reset_control_assert(priv->phy_reset);
 	usleep_range(20, 30);
@@ -310,6 +315,12 @@ static void rk_gmac_integrated_fephy_powerup(struct rk_priv_data *priv,
 		     RK_FEPHY_INTERNAL_RMII_SEL |
 		     RK_FEPHY_24M_CLK_SEL |
 		     RK_FEPHY_PHY_ID);
+
+	/* Apply the factory bandgap trim, if the OTP provides one */
+	if (bgs_reg && priv->fephy_bgs >= 0)
+		regmap_write(priv->grf, bgs_reg,
+			     FIELD_PREP_WM16(RK_FEPHY_BGS_MASK,
+					     priv->fephy_bgs));
 	usleep_range(10000, 12000);
 
 	reset_control_deassert(priv->phy_reset);
@@ -779,7 +790,8 @@ static void rk3528_set_to_rgmii(struct rk_priv_data *bsp_priv,
 
 static void rk3528_integrated_phy_powerup(struct rk_priv_data *bsp_priv)
 {
-	rk_gmac_integrated_fephy_powerup(bsp_priv, RK3528_VO_GRF_MACPHY_CON0);
+	rk_gmac_integrated_fephy_powerup(bsp_priv, RK3528_VO_GRF_MACPHY_CON0,
+					 RK3528_VO_GRF_MACPHY_CON1);
 }
 
 static void rk3528_integrated_phy_powerdown(struct rk_priv_data *bsp_priv)
@@ -1211,6 +1223,38 @@ static void rk_phy_powerdown(struct rk_priv_data *bsp_priv)
 		dev_err(bsp_priv->dev, "fail to disable phy-supply\n");
 }
 
+static int rk_gmac_read_fephy_bgs(struct rk_priv_data *bsp_priv,
+				  struct device *dev,
+				  struct device_node *phy_node)
+{
+	struct nvmem_cell *cell;
+	size_t len;
+	u8 *buf;
+
+	bsp_priv->fephy_bgs = -1;
+
+	/* The trim cell sits in the integrated PHY node, next to "txlevel" */
+	cell = of_nvmem_cell_get(phy_node, "bgs");
+	if (IS_ERR(cell)) {
+		if (PTR_ERR(cell) == -EPROBE_DEFER)
+			return -EPROBE_DEFER;
+		return 0;
+	}
+
+	buf = nvmem_cell_read(cell, &len);
+	nvmem_cell_put(cell);
+	if (IS_ERR(buf)) {
+		dev_warn(dev, "failed to read the FEPHY bgs cell: %pe\n", buf);
+		return 0;
+	}
+
+	if (len == 1)
+		bsp_priv->fephy_bgs = buf[0] & RK_FEPHY_BGS_MASK;
+	kfree(buf);
+
+	return 0;
+}
+
 static struct rk_priv_data *rk_gmac_setup(struct platform_device *pdev,
 					  struct plat_stmmacenet_data *plat,
 					  const struct rk_gmac_ops *ops)
@@ -1315,6 +1359,13 @@ static struct rk_priv_data *rk_gmac_setup(struct platform_device *pdev,
 				dev_err(&pdev->dev, "No PHY reset control found.\n");
 				bsp_priv->phy_reset = NULL;
 			}
+
+			ret = rk_gmac_read_fephy_bgs(bsp_priv, dev,
+						     plat->phy_node);
+			if (ret) {
+				reset_control_put(bsp_priv->phy_reset);
+				return ERR_PTR(ret);
+			}
 		}
 	}
 	dev_info(dev, "integrated PHY? (%s).\n",
