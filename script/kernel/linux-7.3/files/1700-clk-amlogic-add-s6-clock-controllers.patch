+
+/*
+ * The fixed PLL is owned by the firmware and reached through SCMI, the
+ * dividers and gates below are only handed out for the consumers. The
+ * gates are initialized by the firmware as well and must not be changed.
+ */
+static const struct clk_parent_data s6_fixed_pll_pdata = { .fw_name = "fixed_pll" };
+
+#define S6_FCLK_DIV(_name, _m, _d, _bit)				\
+static struct clk_fixed_factor s6_##_name##_div = {			\
+	.mult = (_m),						\
+	.div = (_d),							\
