+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+# Copyright (C) 2019 Amlogic, Inc. All rights reserved
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/clock/amlogic,s6-pll-clkc.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Amlogic S6 PLL Clock Controller
+
+maintainers:
+  - Piotr Oniszczuk <piotr.oniszczuk@gmail.com>
+
+properties:
+  compatible:
+    const: amlogic,s6-pll-clkc
+
+  reg:
+    maxItems: 1
+
+  clocks:
+    items:
+      - description: input fixed pll
+      - description: input gp0 pll oscillator
+      - description: input hifi pll oscillator
+      - description: input hifi1 pll oscillator
+      - description: input mclk pll oscillator
+
+  clock-names:
+    items:
+      - const: fixed_pll
+      - const: gp0_pll_src
+      - const: hifi_pll_src
+      - const: hifi1_pll_src
+      - const: mclk_pll_src
+
+  "#clock-cells":
+    const: 1
+
+required:
+  - compatible
+  - reg
+  - clocks
+  - clock-names
+  - "#clock-cells"
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/clock/amlogic,s6-scmi-clkc.h>
+
+    clock-controller@fe008000 {
+      compatible = "amlogic,s6-pll-clkc";
+      reg = <0xfe008000 0x38c>;
+      clocks = <&scmi_clk CLKID_FIXED_PLL>,
+               <&scmi_clk CLKID_GP0_PLL_SRC>,
+               <&scmi_clk CLKID_HIFI0_PLL_SRC>,
+               <&scmi_clk CLKID_ETH_HIFI1_PLL_SRC>,
+               <&scmi_clk CLKID_CSI_PLL_SRC>;
+      clock-names = "fixed_pll", "gp0_pll_src", "hifi_pll_src",
+                    "hifi1_pll_src", "mclk_pll_src";
+      #clock-cells = <1>;
+    };
