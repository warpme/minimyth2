From 8047a373b34c6c0f9897536df0905be8db11b6df Mon Sep 17 00:00:00 2001
From: Jernej Skrabec <jernej.skrabec@gmail.com>
Date: Sat, 5 Sep 2026 00:57:09 +0200
Subject: [PATCH 190/211] arm64: dts: allwinner: a733: Add the system
 controller

The HDMI PHY needs it for the transmit resistance calibration.

Signed-off-by: Jernej Skrabec <jernej.skrabec@gmail.com>
---
 arch/arm64/boot/dts/allwinner/sun60i-a733.dtsi | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/arch/arm64/boot/dts/allwinner/sun60i-a733.dtsi b/arch/arm64/boot/dts/allwinner/sun60i-a733.dtsi
index f150117c31..4fb8bcea4b 100644
--- a/arch/arm64/boot/dts/allwinner/sun60i-a733.dtsi
+++ b/arch/arm64/boot/dts/allwinner/sun60i-a733.dtsi
@@ -667,6 +667,15 @@ spi4: spi@2544000 {
 			#size-cells = <0>;
 		};
 
+		syscon: syscon@3000000 {
+			compatible = "allwinner,sun60i-a733-system-control",
+				     "allwinner,sun50i-a64-system-control";
+			reg = <0x03000000 0x1000>;
+			#address-cells = <1>;
+			#size-cells = <1>;
+			ranges;
+		};
+
 		sid: efuse@3006000 {
 			compatible = "allwinner,sun60i-a733-sid",
 				     "allwinner,sun50i-a64-sid";
@@ -1194,6 +1203,7 @@ hdmi_phy: hdmi-phy@5600000 {
 			clock-names = "bus", "mod";
 			resets = <&ccu RST_BUS_HDMI_SUB>;
 			reset-names = "phy";
+			syscon = <&syscon>;
 			power-domains = <&pck600 PD_VO1>;
 			#phy-cells = <0>;
 		};
-- 
