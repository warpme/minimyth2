diff --git a/arch/arm/dts/amlogic-s6-u-boot.dtsi b/arch/arm/dts/amlogic-s6-u-boot.dtsi
new file mode 100644
index 00000000..3ead0d2a
--- /dev/null
+++ b/arch/arm/dts/amlogic-s6-u-boot.dtsi
@@ -0,0 +1,102 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+/*
+ * Copyright (c) 2026 Piotr Oniszczuk <piotr.oniszczuk@gmail.com>
+ *
+ * U-Boot additions for the Amlogic S6 SoC family.
+ *
+ * The fixed PLL, the sys and axi clocks are owned by the secure firmware
+ * and reached through SCMI on Linux. U-Boot has no SCMI support enabled
+ * for S6, it takes them as fixed-rate clocks at the rates BL2 leaves them
+ * running at.
+ */
+
+#include <dt-bindings/clock/amlogic,s6-peripherals-clkc.h>
+#include <dt-bindings/clock/amlogic,s6-pll-clkc.h>
+
+/ {
+	soc {
+		bootph-all;
+	};
+
+	fixed_pll: clock-fixed-pll {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <2000000000>;
+		clock-output-names = "fixed_pll";
+	};
+
+	sys_clk: clock-sys {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <166666666>;
+		clock-output-names = "sys_clk";
+	};
+
+	/* Only the parent of the AXI gates, its rate is not used */
+	axi_clk: clock-axi {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <500000000>;
+		clock-output-names = "axi_clk";
+	};
+};
+
+&xtal {
+	bootph-all;
+};
+
+&apb {
+	bootph-all;
+};
+
+&clkc_pll {
+	clocks = <&fixed_pll>;
+	clock-names = "fixed_pll";
+};
+
+&clkc_periphs {
+	clocks = <&xtal>,
+		 <&clkc_pll CLKID_FCLK_DIV2>,
+		 <&clkc_pll CLKID_FCLK_DIV2P5>,
+		 <&clkc_pll CLKID_FCLK_DIV3>,
+		 <&clkc_pll CLKID_FCLK_DIV4>,
+		 <&clkc_pll CLKID_FCLK_DIV5>,
+		 <&clkc_pll CLKID_FCLK_DIV7>,
+		 <&sys_clk>,
+		 <&axi_clk>;
+	clock-names = "xtal", "fclk_div2", "fclk_div2p5",
+		      "fclk_div3", "fclk_div4", "fclk_div5",
+		      "fclk_div7", "sys_clk", "axi_clk";
+};
+
+&periphs_pinctrl {
+	bootph-all;
+};
+
+&uart_b {
+	bootph-all;
+};
+
+&uart_b_pins {
+	bootph-all;
+};
+
+&ethmac {
+	/* S6 has a dwmac 4.x (QoS) core with the G12A style PRG_ETH glue */
+	compatible = "amlogic,s6-dwmac",
+		     "amlogic,meson-axg-dwmac",
+		     "snps,dwmac-4.00";
+	/*
+	 * The MDIO multiplexer registers sit behind the eth_phy gate: the
+	 * MAC glue routes the multiplexer to the external PHY, so enable it
+	 * together with the MAC clocks.
+	 */
+	clocks = <&clkc_periphs CLKID_SYS_ETH_MAC>,
+		 <&clkc_pll CLKID_FCLK_DIV2>,
+		 <&clkc_pll CLKID_FCLK50M>,
+		 <&clkc_periphs CLKID_SYS_ETH_PHY>,
+		 <&clkc_periphs CLKID_SYS_ETH>,
+		 <&clkc_periphs CLKID_ETH_CLK125M>;
+	clock-names = "stmmaceth", "clkin0", "clkin1", "ethphy",
+		      "eth", "eth_125m";
+};
