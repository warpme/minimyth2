diff --speed-large-files --no-dereference --minimal -Naur linux-7.3-rc3/drivers/phy/allwinner/Kconfig linux-7.3-rc3/drivers/phy/allwinner/Kconfig
--- linux-7.3-rc3/drivers/phy/allwinner/Kconfig	2026-09-16 21:48:58.942166562 +0200
+++ linux-7.3-rc3/drivers/phy/allwinner/Kconfig	2026-09-16 21:48:05.619510120 +0200
@@ -66,3 +66,15 @@
 	  Enable this to support the Ethernet PHY operation of the AC200
 	  mixed signal chip. This driver just enables and configures the
 	  PHY, the PHY itself is supported by a standard driver.
+
+config PHY_SUN60I_A733_COMBOPHY
+	tristate "Allwinner A733 SerDes combo PHY driver"
+	depends on ARCH_SUNXI || COMPILE_TEST
+	depends on HAS_IOMEM
+	select GENERIC_PHY
+	select MFD_SYSCON
+	help
+	  Enable this to support the combo PHY of the Allwinner A733 SerDes
+	  subsystem. The PHY is a Cadence design behind an Allwinner wrapper
+	  and sits between the PCIe controller and the M.2 or mini PCIe slot
+	  of the board. Say Y here if you want to use PCIe on such a board.
