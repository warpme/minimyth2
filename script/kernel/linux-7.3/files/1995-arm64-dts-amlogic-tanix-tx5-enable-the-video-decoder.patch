From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Piotr Oniszczuk <piotr.oniszczuk@gmail.com>
Date: Thu, 26 Nov 2026 12:47:58 +0100
Subject: [PATCH] arm64: dts: amlogic: tanix-tx5: enable the video decoder

Enable the video decoder of the Tanix TX5.

Signed-off-by: Piotr Oniszczuk <piotr.oniszczuk@gmail.com>
---
 arch/arm64/boot/dts/amlogic/amlogic-s7-s905y5-tanix-tx5.dts | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/arch/arm64/boot/dts/amlogic/amlogic-s7-s905y5-tanix-tx5.dts b/arch/arm64/boot/dts/amlogic/amlogic-s7-s905y5-tanix-tx5.dts
index 94715e7..716c38d 100644
--- a/arch/arm64/boot/dts/amlogic/amlogic-s7-s905y5-tanix-tx5.dts
+++ b/arch/arm64/boot/dts/amlogic/amlogic-s7-s905y5-tanix-tx5.dts
@@ -210,3 +210,7 @@
 	vqmmc-supply = <&vddio_ao1v8>;
 	status = "okay";
 };
+
+&vdec {
+	status = "okay";
+};
