+			regmap_clear_bits(vop2->map, RK3528_OVL_SYS_CLUSTER0_CTRL,
+					  RK3528_OVL_SYS_CLUSTER0_CTRL__DLY_NUM);
+			break;
+		case ROCKCHIP_VOP2_ESMART0:
+			regmap_clear_bits(vop2->map, RK3528_OVL_SYS_ESMART0_CTRL,
+					  RK3528_OVL_SYS_ESMART_CTRL__DLY_NUM);
+			break;
+		case ROCKCHIP_VOP2_ESMART1:
+			regmap_clear_bits(vop2->map, RK3528_OVL_SYS_ESMART1_CTRL,
+					  RK3528_OVL_SYS_ESMART_CTRL__DLY_NUM);
+			break;
+		case ROCKCHIP_VOP2_ESMART2:
+			regmap_clear_bits(vop2->map, RK3528_OVL_SYS_ESMART2_CTRL,
+					  RK3528_OVL_SYS_ESMART_CTRL__DLY_NUM);
+			break;
+		case ROCKCHIP_VOP2_ESMART3:
+			regmap_clear_bits(vop2->map, RK3528_OVL_SYS_ESMART3_CTRL,
+					  RK3528_OVL_SYS_ESMART_CTRL__DLY_NUM);
+			break;
