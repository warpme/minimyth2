Patch from MiniMyth2 project

Developed-by: Piotr Oniszczuk <piotr.oniszczuk@gmail.com>
Signed-off-by: Piotr Oniszczuk <piotr.oniszczuk@gmail.com>



From c6f146d84cb81e1c815b4790df7ac315391e7f08 Mon Sep 17 00:00:00 2001
From: Piotr Oniszczuk <piotr.oniszczuk@gmail.com>
Date: Sun, 22 Nov 2026 13:06:31 +0100
Subject: [PATCH 3583/3586] dt-bindings: phy: rockchip,rk3228-hdmi-phy: Add
 RK3528 compatible

The RK3528 has an Innosilicon HDMI 2.0 PHY very similar to the one found
on RK3328. Its pre-PLL is always fed by the 24 MHz oscillator, so it has
only two input clocks: the APB clock (sysclk) and the oscillator
reference (refoclk).

The RK3528 PHY sits in the VO power domain, so allow a power-domains
property.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../phy/rockchip,rk3228-hdmi-phy.yaml         | 43 +++++++++++++++++++
 1 file changed, 43 insertions(+)

diff --git a/Documentation/devicetree/bindings/phy/rockchip,rk3228-hdmi-phy.yaml b/Documentation/devicetree/bindings/phy/rockchip,rk3228-hdmi-phy.yaml
index ac15bf8..21b83fb 100644
--- a/Documentation/devicetree/bindings/phy/rockchip,rk3228-hdmi-phy.yaml
+++ b/Documentation/devicetree/bindings/phy/rockchip,rk3228-hdmi-phy.yaml
@@ -14,14 +14,17 @@ properties:
     enum:
       - rockchip,rk3228-hdmi-phy
       - rockchip,rk3328-hdmi-phy
+      - rockchip,rk3528-hdmi-phy
 
   reg:
     maxItems: 1
 
   clocks:
+    minItems: 2
     maxItems: 3
 
   clock-names:
+    minItems: 2
     items:
       - const: sysclk
       - const: refoclk
@@ -46,6 +49,9 @@ properties:
     items:
       - const: cpu-version
 
+  power-domains:
+    maxItems: 1
+
   '#phy-cells':
     const: 0
 
@@ -69,6 +75,22 @@ allOf:
       properties:
         interrupts: false
 
+  - if:
+      properties:
+        compatible:
+          contains:
+            enum:
+              - rockchip,rk3228-hdmi-phy
+              - rockchip,rk3328-hdmi-phy
+
+    then:
+      properties:
+        clocks:
+          minItems: 3
+
+        clock-names:
+          minItems: 3
+
   - if:
       properties:
         compatible:
@@ -79,6 +101,27 @@ allOf:
       required:
         - interrupts
 
+  - if:
+      properties:
+        compatible:
+          contains:
+            const: rockchip,rk3528-hdmi-phy
+
+    then:
+      properties:
+        clocks:
+          maxItems: 2
+
+        clock-names:
+          maxItems: 2
+
+        nvmem-cells: false
+
+        nvmem-cell-names: false
+
+      required:
+        - interrupts
+
 additionalProperties: false
 
 examples:
