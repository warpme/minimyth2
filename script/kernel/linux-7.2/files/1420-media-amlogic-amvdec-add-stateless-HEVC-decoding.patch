+				   unsigned int count, struct hevc_rps *out)
+{
+	unsigned int i, j;
+
+	if (count > HEVC_RPS_MAX_SETS || (count && (!src || !out)))
+		return -EINVAL;
+	for (i = 0; i < count; i++) {
+		const struct v4l2_ctrl_hevc_ext_sps_st_rps *s = src + i;
+		struct hevc_rps *r = out + i;
