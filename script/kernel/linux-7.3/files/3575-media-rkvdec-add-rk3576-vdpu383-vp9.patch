diff --speed-large-files --no-dereference --minimal -Naur -r a/drivers/media/platform/rockchip/rkvdec/rkvdec-vdpu383-vp9-regs.h b/drivers/media/platform/rockchip/rkvdec/rkvdec-vdpu383-vp9-regs.h
--- a/drivers/media/platform/rockchip/rkvdec/rkvdec-vdpu383-vp9-regs.h	1970-01-01 01:00:00.000000000 +0100
+++ b/drivers/media/platform/rockchip/rkvdec/rkvdec-vdpu383-vp9-regs.h	2026-11-17 10:13:47.914004163 +0100
@@ -0,0 +1,61 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * Rockchip Video Decoder VDPU383 VP9 registers description
+ *
+ * VP9 uses three of the four VDPU383 register blocks as they are (common,
+ * h26x_params and common_addr from rkvdec-vdpu383-regs.h). The codec address
+ * block has the same layout as for HEVC and H.264 but a different meaning:
+ *
+ *  - reg170-172 are the only reference frames (last, golden, altref), not 16
+ *    DPB entries;
+ *  - reg181-185 are the segment id maps, the key frame probabilities and the
+ *    probability contexts the frame reads and writes;
+ *  - reg217 is the only colmv reference (the previous frame).
+ */
+
+#ifndef _RKVDEC_VDPU383_VP9_REGS_H_
+#define _RKVDEC_VDPU383_VP9_REGS_H_
+
+#include <linux/build_bug.h>
+#include <linux/types.h>
+
+#include "rkvdec-vdpu383-regs.h"
+
+struct vdpu383_regs_vp9_addr {
+	u32 reg168_decout_base;
+	u32 reg169_error_ref_base;
+	u32 reg170_last_ref_base;
+	u32 reg171_golden_ref_base;
+	u32 reg172_altref_ref_base;
+	u32 reg173_180_unused_ref[8];
+	u32 reg181_segid_last_base;
+	u32 reg182_segid_cur_base;
+	u32 reg183_kf_prob_base;
+	u32 reg184_lastprob_base;
+	u32 reg185_updateprob_base;
+	u32 reg186_191_reserved[6];
+	u32 reg192_payload_cur_base;
+	u32 reg193_fbc_payload_offset;
+	u32 reg194_payload_error_ref_base;
+	u32 reg195_payload_ref0_base;
+	u32 reg196_payload_ref1_base;
+	u32 reg197_payload_ref2_base;
+	u32 reg198_210_unused_payload[13];
+	u32 reg211_215_reserved[5];
+	u32 reg216_colmv_cur_base;
+	u32 reg217_colmv_ref_base;
+	u32 reg218_232_unused_colmv[15];
+};
+
+struct vdpu383_regs_vp9 {
+	struct vdpu383_regs_common		common;		/* 8-30 */
+	struct vdpu383_regs_h26x_params		h26x_params;	/* 64-74, 80-106 */
+	struct vdpu383_regs_common_addr		common_addr;	/* 128-134, 140-161 */
+	struct vdpu383_regs_vp9_addr		vp9_addr;	/* 168-232 */
+} __packed;
+
+/* The codec address block must take the same space as for HEVC and H.264 */
+static_assert(sizeof(struct vdpu383_regs_vp9_addr) ==
+	      sizeof(struct vdpu383_regs_h26x_addr));
+
+#endif /* _RKVDEC_VDPU383_VP9_REGS_H_ */
diff --speed-large-files --no-dereference --minimal -Naur -r a/drivers/media/platform/rockchip/rkvdec/rkvdec-vdpu383-vp9.c b/drivers/media/platform/rockchip/rkvdec/rkvdec-vdpu383-vp9.c
--- a/drivers/media/platform/rockchip/rkvdec/rkvdec-vdpu383-vp9.c	1970-01-01 01:00:00.000000000 +0100
+++ b/drivers/media/platform/rockchip/rkvdec/rkvdec-vdpu383-vp9.c	2026-11-17 10:13:32.202904568 +0100
@@ -0,0 +1,1017 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Rockchip VDPU383 (RK3576) VP9 backend
+ *
+ * Based on the VDPU381 VP9 backend (RK3588) for the driver structure, and on
+ * the RK3576 VP9 port by Simon <simon@symple.nz> (Symple Solutions Ltd.) for
+ * everything that is specific to the VDPU383 block: the "global header"
+ * buffer, the hardware probability tables, the VP9 view of the codec address
+ * registers and the register write order.
+ *
+ * Unlike VDPU381, the VDPU383 parses the compressed header and adapts the
+ * probabilities itself. The driver only has to supply the probability context
+ * the frame starts from (reg184), a place to store the adapted one (reg185)
+ * and, for key frames, the key frame probability table (reg183). There is no
+ * symbol counting by software, hence no count table.
+ */
+
+#include <linux/kernel.h>
+#include <linux/math64.h>
+#include <linux/wordpart.h>
+#include <media/v4l2-mem2mem.h>
+#include <media/v4l2-vp9.h>
+
+#include "rkvdec.h"
+#include "rkvdec-rcb.h"
+#include "rkvdec-vdpu383-regs.h"
+#include "rkvdec-vdpu383-vp9-regs.h"
+
+/* Probability context buffer, one per VP9 frame context (hardware format) */
+#define RKVDEC_VP9_PROBE_SIZE		4864
+/* Key frame default probability table (hardware format) */
+#define RKVDEC_VP9_PROB_KF_SIZE		1312
+/*
+ * Segment id map size: ceil(width/64) * ceil(height/64) * 256 / 4.
+ * Use an 8K-safe value to cover all supported resolutions.
+ */
+#define RKVDEC_VP9_MAX_SEGMAP_SIZE	524288
+
+#define VP9_NUM_FRAME_CTX		4
+
+/*
+ * Size of the "global header" buffer holding the frame parameters the
+ * hardware reads from reg131: 2 * (ALIGN(1299, 128) / 8) bytes.
+ */
+#define VDPU383_VP9_GBL_SIZE		352
+#define VDPU383_VP9_GBL_LEN		(VDPU383_VP9_GBL_SIZE / 16)
+
+/*
+ * Extra bytes of stream the hardware is allowed to fetch behind the payload
+ * (the unit is 16 bytes, see reg066).
+ */
+#define VDPU383_VP9_STRM_PAD		0x80
+
+/* Data structure describing the auxiliary buffer used by the hardware */
+struct rkvdec_vdpu383_vp9_priv_tbl {
+	u8 gbl[VDPU383_VP9_GBL_SIZE] __aligned(128);
+	/*
+	 * Probability context the hardware writes back to after each frame
+	 * that refreshes its frame context (reg185).
+	 */
+	u8 probs[VP9_NUM_FRAME_CTX][RKVDEC_VP9_PROBE_SIZE] __aligned(128);
+	/*
+	 * Pristine spec defaults. Read through reg184 for contexts that the
+	 * hardware has not written yet. It must not be the same buffer as the
+	 * one reg185 points to, or the write back would destroy the defaults.
+	 */
+	u8 prob_default[RKVDEC_VP9_PROBE_SIZE] __aligned(128);
+	u8 kf_probs[RKVDEC_VP9_PROB_KF_SIZE] __aligned(128);
+	u8 segmap[2][RKVDEC_VP9_MAX_SEGMAP_SIZE] __aligned(128);
+};
+
+struct rkvdec_vdpu383_vp9_frame_info {
+	u32 valid : 1;
+	u32 segmapid : 1;
+	u32 frame_context_idx : 2;
+	u32 flags;
+	u64 timestamp;
+	u16 width;
+	u16 height;
+	struct v4l2_vp9_segmentation seg;
+	struct v4l2_vp9_loop_filter lf;
+};
+
+struct rkvdec_vdpu383_vp9_run {
+	struct rkvdec_run base;
+	const struct v4l2_ctrl_vp9_frame *decode_params;
+};
+
+struct rkvdec_vdpu383_vp9_ctx {
+	struct rkvdec_aux_buf priv_tbl;
+	/*
+	 * Only used to let v4l2_vp9_reset_frame_ctx() compute the effective
+	 * frame context index, the probabilities live in the hardware format
+	 * in priv_tbl.
+	 */
+	struct v4l2_vp9_frame_context frame_context[VP9_NUM_FRAME_CTX];
+	/* Whether the hardware has written the context to priv_tbl.probs[] */
+	bool prob_ctx_valid[VP9_NUM_FRAME_CTX];
+	struct rkvdec_vdpu383_vp9_frame_info cur;
+	struct rkvdec_vdpu383_vp9_frame_info last;
+	struct vdpu383_regs_vp9 regs;
+};
+
+/*
+ * Hardware probability buffer packing.
+ *
+ * Lays a struct v4l2_vp9_frame_context out the way the VDPU383 reads it.
+ * The format has no public documentation.
+ */
+struct vp9_prob_packer {
+	__le64 *buf;
+	u32 idx;
+};
+
+static void pp_put(struct vp9_prob_packer *p, u64 val, u32 nbits)
+{
+	while (nbits) {
+		u32 word = p->idx >> 6;
+		u32 off  = p->idx & 63;
+		u32 n    = min_t(u32, nbits, 64 - off);
+		u64 mask = n == 64 ? ~0ULL : ((1ULL << n) - 1);
+
+		p->buf[word] |= cpu_to_le64((val & mask) << off);
+		val  >>= n;
+		nbits -= n;
+		p->idx += n;
+	}
+}
+
+static void pp_align(struct vp9_prob_packer *p, u32 align_bits)
+{
+	p->idx = ALIGN(p->idx, align_bits);
+}
+
+static void pack_vp9_probs_hw(u8 *buf,
+			      const struct v4l2_vp9_frame_context *probs)
+{
+	struct vp9_prob_packer pp = { .buf = (__le64 *)buf, .idx = 0 };
+	int i, j, k, m, n;
+	int byte_count;
+
+	memset(buf, 0, RKVDEC_VP9_PROBE_SIZE);
+
+	/* Section 1 — 5 × 128 bits: sb info */
+	/* partition probs[16][3]. MPP uses pic_param->prob.partition which
+	 * carries kf_partition_probs for KEY frames or the saved/forward-
+	 * updated INTER table for INTER frames. We pass that through via
+	 * the v4l2_vp9_frame_context the caller hands us.
+	 */
+	for (i = 0; i < 16; i++)
+		for (j = 0; j < 3; j++)
+			pp_put(&pp, probs->partition[i][j], 8);
+
+	/* Segment-id pred probs (3) + tree probs (7) — packed as zero. */
+	for (i = 0; i < 3 + 7; i++)
+		pp_put(&pp, 0, 8);
+
+	/* Skip flag probs (3 contexts) */
+	for (i = 0; i < 3; i++)
+		pp_put(&pp, probs->skip[i], 8);
+
+	/* tx_size probs */
+	for (i = 0; i < 2; i++)
+		for (j = 0; j < 3; j++)
+			pp_put(&pp, probs->tx32[i][j], 8);
+	for (i = 0; i < 2; i++)
+		for (j = 0; j < 2; j++)
+			pp_put(&pp, probs->tx16[i][j], 8);
+	for (i = 0; i < 2; i++)
+		pp_put(&pp, probs->tx8[i][0], 8);
+
+	/* intra_inter (4 contexts) */
+	for (i = 0; i < 4; i++)
+		pp_put(&pp, probs->is_inter[i], 8);
+
+	pp_align(&pp, 128);
+
+	/* Section 2 — 6 × 128 bits: intra y_mode + inter block info */
+	for (i = 0; i < 4; i++)
+		for (j = 0; j < 9; j++)
+			pp_put(&pp, probs->y_mode[i][j], 8);
+
+	for (i = 0; i < 5; i++)
+		pp_put(&pp, probs->comp_mode[i], 8);
+	for (i = 0; i < 5; i++)
+		pp_put(&pp, probs->comp_ref[i], 8);
+	for (i = 0; i < 5; i++)
+		for (j = 0; j < 2; j++)
+			pp_put(&pp, probs->single_ref[i][j], 8);
+
+	for (i = 0; i < 7; i++)
+		for (j = 0; j < 3; j++)
+			pp_put(&pp, probs->inter_mode[i][j], 8);
+
+	for (i = 0; i < 4; i++)
+		for (j = 0; j < 2; j++)
+			pp_put(&pp, probs->interp_filter[i][j], 8);
+
+	pp_align(&pp, 128);
+
+	/* Section 3 — 128 × 128 bits: coef probs (intra, then inter) */
+	for (i = 0; i < 4; i++)
+		for (j = 0; j < 2; j++) {
+			byte_count = 0;
+			for (k = 0; k < 6; k++)
+				for (m = 0; m < 6; m++)
+					for (n = 0; n < 3; n++) {
+						pp_put(&pp, probs->coef[i][j][0][k][m][n], 8);
+						if (++byte_count == 27) {
+							pp_align(&pp, 128);
+							byte_count = 0;
+						}
+					}
+			pp_align(&pp, 128);
+		}
+	for (i = 0; i < 4; i++)
+		for (j = 0; j < 2; j++) {
+			byte_count = 0;
+			for (k = 0; k < 6; k++)
+				for (m = 0; m < 6; m++)
+					for (n = 0; n < 3; n++) {
+						pp_put(&pp, probs->coef[i][j][1][k][m][n], 8);
+						if (++byte_count == 27) {
+							pp_align(&pp, 128);
+							byte_count = 0;
+						}
+					}
+			pp_align(&pp, 128);
+		}
+
+	/* Section 4 — intra uv_mode, packed in 4 aligned chunks */
+	for (i = 0; i < 3; i++)
+		for (j = 0; j < 9; j++)
+			pp_put(&pp, probs->uv_mode[i][j], 8);
+	pp_align(&pp, 128);
+	for (i = 3; i < 6; i++)
+		for (j = 0; j < 9; j++)
+			pp_put(&pp, probs->uv_mode[i][j], 8);
+	pp_align(&pp, 128);
+	for (i = 6; i < 9; i++)
+		for (j = 0; j < 9; j++)
+			pp_put(&pp, probs->uv_mode[i][j], 8);
+	pp_align(&pp, 128);
+	for (i = 9; i < 10; i++)
+		for (j = 0; j < 9; j++)
+			pp_put(&pp, probs->uv_mode[i][j], 8);
+	pp_align(&pp, 128);
+	pp_put(&pp, 0, 8);
+	pp_align(&pp, 128);
+
+	/* Section 5 — mv probs (6 × 128 bits) */
+	for (i = 0; i < 3; i++)
+		pp_put(&pp, probs->mv.joint[i], 8);
+	for (i = 0; i < 2; i++)
+		pp_put(&pp, probs->mv.sign[i], 8);
+	for (i = 0; i < 2; i++)
+		for (j = 0; j < 10; j++)
+			pp_put(&pp, probs->mv.classes[i][j], 8);
+	for (i = 0; i < 2; i++)
+		pp_put(&pp, probs->mv.class0_bit[i], 8);
+	for (i = 0; i < 2; i++)
+		for (j = 0; j < 10; j++)
+			pp_put(&pp, probs->mv.bits[i][j], 8);
+	for (i = 0; i < 2; i++)
+		for (j = 0; j < 2; j++)
+			for (k = 0; k < 3; k++)
+				pp_put(&pp, probs->mv.class0_fr[i][j][k], 8);
+	for (i = 0; i < 2; i++)
+		for (j = 0; j < 3; j++)
+			pp_put(&pp, probs->mv.fr[i][j], 8);
+	for (i = 0; i < 2; i++)
+		pp_put(&pp, probs->mv.class0_hp[i], 8);
+	for (i = 0; i < 2; i++)
+		pp_put(&pp, probs->mv.hp[i], 8);
+
+	pp_align(&pp, 128);
+	pp_put(&pp, 0, 8);
+	pp_align(&pp, 128);
+}
+
+/* -----------------------------------------------------------------------
+ * KF probability table packing (unchanged from prior version)
+ */
+static const u8 vdpu383_vp9_kf_partition_probs[16][3] = {
+	{ 158,  97,  94 }, {  93,  24,  99 }, {  85, 119,  44 }, {  62,  59,  67 },
+	{ 149,  53,  53 }, {  94,  20,  48 }, {  83,  53,  24 }, {  52,  18,  18 },
+	{ 150,  40,  39 }, {  78,  12,  26 }, {  67,  33,  11 }, {  24,   7,   5 },
+	{ 174,  35,  49 }, {  68,  11,  27 }, {  57,  15,   9 }, {  12,   3,   3 },
+};
+
+static void populate_kf_probs(u8 *buf)
+{
+	int off = 0, i, j, k, bc;
+
+	memset(buf, 0, RKVDEC_VP9_PROB_KF_SIZE);
+
+	for (i = 0; i < 16; i++)
+		for (j = 0; j < 3; j++)
+			buf[off++] = vdpu383_vp9_kf_partition_probs[i][j];
+
+	for (i = 0; i < 10; i++) {
+		bc = 0;
+		for (j = 0; j < 10; j++) {
+			for (k = 0; k < 9; k++) {
+				buf[off++] = v4l2_vp9_kf_y_mode_prob[i][j][k];
+				if (++bc == 27) {
+					off = ALIGN(off, 16);
+					bc = 0;
+				}
+			}
+		}
+		if (i < 4) {
+			int flat_start = i * 23;
+			int flat_end   = (i < 3) ? flat_start + 23 : flat_start + 21;
+			int m;
+
+			for (m = flat_start; m < flat_end; m++)
+				buf[off + (m - flat_start)] =
+					v4l2_vp9_kf_uv_mode_prob[m / 9][m % 9];
+		}
+		off = ALIGN(off + 23, 16);
+	}
+}
+
+static void init_probs(struct rkvdec_vdpu383_vp9_ctx *vp9_ctx)
+{
+	struct rkvdec_vdpu383_vp9_priv_tbl *tbl = vp9_ctx->priv_tbl.cpu;
+	int i;
+
+	for (i = 0; i < VP9_NUM_FRAME_CTX; i++)
+		vp9_ctx->frame_context[i] = v4l2_vp9_default_probs;
+
+	/*
+	 * reg184 reads the defaults from prob_default until the hardware
+	 * has written a context. The per-context buffers start out zeroed,
+	 * the hardware writes back everything it needs.
+	 */
+	pack_vp9_probs_hw(tbl->prob_default, &v4l2_vp9_default_probs);
+	populate_kf_probs(tbl->kf_probs);
+}
+
+/* Global header buffer: bit-packed frame parameters read by the hardware */
+struct vdpu383_gbl_packer {
+	__le64 *buf;
+	u32 idx;
+};
+
+static void gbl_put(struct vdpu383_gbl_packer *p, u64 val, u32 nbits)
+{
+	while (nbits) {
+		u32 word = p->idx >> 6;
+		u32 off  = p->idx & 63;
+		u32 n    = min_t(u32, nbits, 64 - off);
+		u64 mask = n == 64 ? ~0ULL : ((1ULL << n) - 1);
+
+		p->buf[word] |= cpu_to_le64((val & mask) << off);
+		val  >>= n;
+		nbits -= n;
+		p->idx += n;
+	}
+}
+
+static void gbl_align64(struct vdpu383_gbl_packer *p)
+{
+	p->idx = ALIGN(p->idx, 64);
+}
+
+static struct rkvdec_decoded_buffer *
+get_ref_buf(struct rkvdec_ctx *ctx, struct vb2_v4l2_buffer *dst, u64 timestamp)
+{
+	struct v4l2_m2m_ctx *m2m_ctx = ctx->fh.m2m_ctx;
+	struct vb2_queue *cap_q = &m2m_ctx->cap_q_ctx.q;
+	struct vb2_buffer *buf;
+
+	/*
+	 * If a ref is unused or invalid, address of current destination
+	 * buffer is returned.
+	 */
+	buf = vb2_find_buffer(cap_q, timestamp);
+	if (!buf)
+		buf = &dst->vb2_buf;
+
+	return vb2_to_rkvdec_decoded_buf(buf);
+}
+
+static void update_dec_buf_info(struct rkvdec_decoded_buffer *buf,
+				const struct v4l2_ctrl_vp9_frame *dec_params)
+{
+	buf->vp9.width = dec_params->frame_width_minus_1 + 1;
+	buf->vp9.height = dec_params->frame_height_minus_1 + 1;
+	buf->vp9.bit_depth = dec_params->bit_depth;
+}
+
+static void update_ctx_cur_info(struct rkvdec_vdpu383_vp9_ctx *vp9_ctx,
+				struct rkvdec_decoded_buffer *buf,
+				const struct v4l2_ctrl_vp9_frame *dec_params)
+{
+	vp9_ctx->cur.valid = true;
+	vp9_ctx->cur.flags = dec_params->flags;
+	vp9_ctx->cur.timestamp = buf->base.vb.vb2_buf.timestamp;
+	vp9_ctx->cur.width = dec_params->frame_width_minus_1 + 1;
+	vp9_ctx->cur.height = dec_params->frame_height_minus_1 + 1;
+	vp9_ctx->cur.seg = dec_params->seg;
+	vp9_ctx->cur.lf = dec_params->lf;
+}
+
+static bool frame_is_intra(u32 flags)
+{
+	return flags & (V4L2_VP9_FRAME_FLAG_KEY_FRAME |
+			V4L2_VP9_FRAME_FLAG_INTRA_ONLY);
+}
+
+static void config_global_hdr(struct rkvdec_ctx *ctx,
+			      const struct v4l2_ctrl_vp9_frame *fp,
+			      struct rkvdec_decoded_buffer *ref_bufs[3])
+{
+	struct rkvdec_vdpu383_vp9_ctx *vp9_ctx = ctx->priv;
+	struct rkvdec_vdpu383_vp9_priv_tbl *tbl = vp9_ctx->priv_tbl.cpu;
+	const struct rkvdec_vdpu383_vp9_frame_info *last = &vp9_ctx->last;
+	struct vdpu383_gbl_packer bp = {
+		.buf = (__le64 *)tbl->gbl,
+		.idx = 0,
+	};
+	bool is_intra = frame_is_intra(fp->flags);
+	u32 frame_type = (fp->flags & V4L2_VP9_FRAME_FLAG_KEY_FRAME) ? 0 : 1;
+	u32 w = fp->frame_width_minus_1 + 1;
+	u32 h = fp->frame_height_minus_1 + 1;
+	bool seg_on = !!(fp->seg.flags & V4L2_VP9_SEGMENTATION_FLAG_ENABLED);
+	u32 ref_w[3], ref_h[3];
+	bool use_prev_mvs, last_wh_eq;
+	int i, j;
+
+	/*
+	 * Dimensions of the references. Key and intra only frames have none,
+	 * the hardware wants zero. A reference that was never decoded (or that
+	 * is not there any more) reads as the current frame.
+	 */
+	for (i = 0; i < 3; i++) {
+		u32 rw = ref_bufs[i]->vp9.width ?: w;
+		u32 rh = ref_bufs[i]->vp9.height ?: h;
+
+		ref_w[i] = is_intra ? 0 : rw;
+		ref_h[i] = is_intra ? 0 : rh;
+	}
+
+	memset(tbl->gbl, 0, sizeof(tbl->gbl));
+
+	gbl_put(&bp, frame_type, 1);
+	gbl_put(&bp, !!(fp->flags & V4L2_VP9_FRAME_FLAG_ERROR_RESILIENT), 1);
+	gbl_put(&bp, fp->bit_depth - 8, 3);
+	gbl_put(&bp, 1, 2);
+	gbl_put(&bp, w, 16);
+	gbl_put(&bp, h, 16);
+
+	gbl_put(&bp, is_intra ? 1 : 0, 1);
+	gbl_put(&bp, !!(fp->ref_frame_sign_bias & V4L2_VP9_SIGN_BIAS_LAST), 1);
+	gbl_put(&bp, !!(fp->ref_frame_sign_bias & V4L2_VP9_SIGN_BIAS_GOLDEN), 1);
+	gbl_put(&bp, !!(fp->ref_frame_sign_bias & V4L2_VP9_SIGN_BIAS_ALT), 1);
+
+	gbl_put(&bp, !!(fp->flags & V4L2_VP9_FRAME_FLAG_ALLOW_HIGH_PREC_MV), 1);
+	/* V4L2 already gives the interpolation filter, not the bitstream literal */
+	gbl_put(&bp, is_intra ? 0 : fp->interpolation_filter, 3);
+	gbl_put(&bp, !!(fp->flags & V4L2_VP9_FRAME_FLAG_PARALLEL_DEC_MODE), 1);
+	gbl_put(&bp, !!(fp->flags & V4L2_VP9_FRAME_FLAG_REFRESH_FRAME_CTX), 1);
+
+	gbl_put(&bp, fp->lf.level, 6);
+	gbl_put(&bp, fp->lf.sharpness, 3);
+	gbl_put(&bp, !!(fp->lf.flags & V4L2_VP9_LOOP_FILTER_FLAG_DELTA_ENABLED), 1);
+	gbl_put(&bp, !!(fp->lf.flags & V4L2_VP9_LOOP_FILTER_FLAG_DELTA_UPDATE), 1);
+	for (i = 0; i < 4; i++)
+		gbl_put(&bp, (u32)(s32)fp->lf.ref_deltas[i] & 0x7f, 7);
+	for (i = 0; i < 2; i++)
+		gbl_put(&bp, (u32)(s32)fp->lf.mode_deltas[i] & 0x7f, 7);
+
+	gbl_put(&bp, fp->quant.base_q_idx, 8);
+	gbl_put(&bp, (u32)(s32)fp->quant.delta_q_y_dc & 0x1f, 5);
+	gbl_put(&bp, (u32)(s32)fp->quant.delta_q_uv_dc & 0x1f, 5);
+	gbl_put(&bp, (u32)(s32)fp->quant.delta_q_uv_ac & 0x1f, 5);
+	gbl_put(&bp, (!fp->quant.base_q_idx && !fp->quant.delta_q_y_dc &&
+		      !fp->quant.delta_q_uv_dc && !fp->quant.delta_q_uv_ac) ? 1 : 0,
+		1);
+
+	/*
+	 * Without segmentation V4L2 leaves the tree and prediction
+	 * probabilities at 0xff, the hardware expects zero then.
+	 */
+	for (i = 0; i < 3; i++)
+		gbl_put(&bp, seg_on ? fp->seg.pred_probs[i] : 0, 8);
+	for (i = 0; i < 7; i++)
+		gbl_put(&bp, seg_on ? fp->seg.tree_probs[i] : 0, 8);
+	gbl_put(&bp, seg_on, 1);
+	gbl_put(&bp, !!(fp->seg.flags & V4L2_VP9_SEGMENTATION_FLAG_UPDATE_MAP), 1);
+	gbl_put(&bp, !!(fp->seg.flags & V4L2_VP9_SEGMENTATION_FLAG_TEMPORAL_UPDATE), 1);
+	gbl_put(&bp, !!(fp->seg.flags & V4L2_VP9_SEGMENTATION_FLAG_ABS_OR_DELTA_UPDATE), 1);
+
+	use_prev_mvs = !(fp->flags & V4L2_VP9_FRAME_FLAG_ERROR_RESILIENT) &&
+		       last->valid && w == last->width && h == last->height &&
+		       !frame_is_intra(last->flags) &&
+		       (last->flags & V4L2_VP9_FRAME_FLAG_SHOW_FRAME);
+	gbl_put(&bp, use_prev_mvs, 1);
+
+	for (i = 0; i < 8; i++)
+		for (j = 0; j < 4; j++)
+			gbl_put(&bp, (fp->seg.feature_enabled[i] >> j) & 1, 1);
+
+	for (i = 0; i < 8; i++) {
+		gbl_put(&bp, (u32)(s32)fp->seg.feature_data[i][0] & 0x1ff, 9);
+		gbl_put(&bp, (u32)(s32)fp->seg.feature_data[i][1] & 0x7f, 7);
+		gbl_put(&bp, fp->seg.feature_data[i][2] & 0x3, 2);
+	}
+
+	gbl_put(&bp, fp->compressed_header_size, 16);
+
+	for (i = 0; i < 3; i++) {
+		gbl_put(&bp, ref_w[i], 16);
+		gbl_put(&bp, ref_h[i], 16);
+	}
+
+	for (i = 0; i < 2; i++)
+		gbl_put(&bp, (u32)(s32)last->lf.mode_deltas[i] & 0x7f, 7);
+	for (i = 0; i < 4; i++)
+		gbl_put(&bp, (u32)(s32)last->lf.ref_deltas[i] & 0x7f, 7);
+	gbl_put(&bp, !!(last->seg.flags & V4L2_VP9_SEGMENTATION_FLAG_ENABLED), 1);
+	gbl_put(&bp, last->valid && (last->flags & V4L2_VP9_FRAME_FLAG_SHOW_FRAME), 1);
+	gbl_put(&bp, !!(fp->flags & V4L2_VP9_FRAME_FLAG_INTRA_ONLY), 1);
+	last_wh_eq = last->valid && last->width == w && last->height == h;
+	gbl_put(&bp, last_wh_eq, 1);
+	/*
+	 * Color space of the last frame. V4L2 does not carry it and the OUTPUT
+	 * buffers have no kernel mapping to parse it from the bitstream.
+	 */
+	gbl_put(&bp, 0, 3);
+	gbl_put(&bp, !last->valid || (last->flags & V4L2_VP9_FRAME_FLAG_KEY_FRAME), 1);
+	gbl_put(&bp, 0, 1);
+	gbl_put(&bp, 1, 1);
+	gbl_put(&bp, 1, 1);
+	gbl_put(&bp, 1, 1);
+
+	/*
+	 * Motion vector scaling factors (Q14, reference size over frame size).
+	 * 16 for frames that have no reference.
+	 */
+	for (i = 0; i < 3; i++) {
+		u32 sx = is_intra ? 16 : div_u64((u64)ref_w[i] << 14, w);
+		u32 sy = is_intra ? 16 : div_u64((u64)ref_h[i] << 14, h);
+
+		gbl_put(&bp, sx & 0xffff, 16);
+		gbl_put(&bp, sy & 0xffff, 16);
+	}
+
+	{
+		u32 tile_cols = 1u << fp->tile_cols_log2;
+		u32 tile_rows = 1u << fp->tile_rows_log2;
+		u32 sb_cols = ALIGN(w, 64) / 64;
+		u32 sb_rows = ALIGN(h, 64) / 64;
+
+		gbl_put(&bp, tile_cols, 7);
+		gbl_put(&bp, tile_rows, 3);
+
+		/* Width of each of the (up to) 64 tile columns, in superblocks */
+		for (i = 0; i < 64; i++) {
+			u32 start = ((u32)i * sb_cols) >> fp->tile_cols_log2;
+			u32 end = ((u32)(i + 1) * sb_cols) >> fp->tile_cols_log2;
+
+			gbl_put(&bp, min(end, sb_cols) - min(start, sb_cols), 10);
+		}
+		/* Height of each of the (up to) 4 tile rows, in superblocks */
+		for (j = 0; j < 4; j++) {
+			u32 start = ((u32)j * sb_rows) >> fp->tile_rows_log2;
+			u32 end = ((u32)(j + 1) * sb_rows) >> fp->tile_rows_log2;
+
+			gbl_put(&bp, min(end, sb_rows) - min(start, sb_rows), 10);
+		}
+	}
+
+	gbl_align64(&bp);
+}
+
+/*
+ * reg128-161 (common_addr), reg162-167 (unused) and reg168-232 (vp9_addr) are
+ * written as one burst of 105 registers.
+ */
+#define VDPU383_VP9_ADDR_BURST_REGS	105
+#define VDPU383_VP9_CODEC_ADDR_IDX					\
+	((VDPU383_OFFSET_CODEC_ADDR_REGS - VDPU383_OFFSET_COMMON_ADDR_REGS) / \
+	 sizeof(u32))
+
+static void rkvdec_write_regs(struct rkvdec_ctx *ctx)
+{
+	struct rkvdec_dev *rkvdec = ctx->dev;
+	struct rkvdec_vdpu383_vp9_ctx *vp9_ctx = ctx->priv;
+	struct vdpu383_regs_vp9 *regs = &vp9_ctx->regs;
+	u32 addr_regs[VDPU383_VP9_ADDR_BURST_REGS] = { };
+
+	BUILD_BUG_ON(VDPU383_VP9_CODEC_ADDR_IDX * sizeof(u32) <
+		     sizeof(regs->common_addr));
+	BUILD_BUG_ON((VDPU383_VP9_CODEC_ADDR_IDX * sizeof(u32)) +
+		     sizeof(regs->vp9_addr) != sizeof(addr_regs));
+
+	/*
+	 * The registers have to be written in increasing order, so the common
+	 * and the codec specific addresses go out in a single burst.
+	 */
+	memcpy(addr_regs, &regs->common_addr, sizeof(regs->common_addr));
+	memcpy(&addr_regs[VDPU383_VP9_CODEC_ADDR_IDX], &regs->vp9_addr,
+	       sizeof(regs->vp9_addr));
+
+	rkvdec_memcpy_toio(rkvdec->regs + VDPU383_OFFSET_COMMON_REGS,
+			   &regs->common, sizeof(regs->common));
+	rkvdec_memcpy_toio(rkvdec->regs + VDPU383_OFFSET_CODEC_PARAMS_REGS,
+			   &regs->h26x_params, sizeof(regs->h26x_params));
+	rkvdec_memcpy_toio(rkvdec->regs + VDPU383_OFFSET_COMMON_ADDR_REGS,
+			   addr_regs, sizeof(addr_regs));
+}
+
+static void config_registers(struct rkvdec_ctx *ctx,
+			     const struct rkvdec_vdpu383_vp9_run *run,
+			     struct rkvdec_decoded_buffer *ref_bufs[3],
+			     struct rkvdec_decoded_buffer *mv_ref)
+{
+	const struct v4l2_ctrl_vp9_frame *fp = run->decode_params;
+	struct rkvdec_vdpu383_vp9_ctx *vp9_ctx = ctx->priv;
+	const struct v4l2_pix_format_mplane *dst_fmt = &ctx->decoded_fmt.fmt.pix_mp;
+	struct vdpu383_regs_vp9 *regs = &vp9_ctx->regs;
+	dma_addr_t priv_dma = vp9_ctx->priv_tbl.dma;
+	dma_addr_t dst_addr = vb2_dma_contig_plane_dma_addr(&run->base.bufs.dst->vb2_buf, 0);
+	dma_addr_t src_addr = vb2_dma_contig_plane_dma_addr(&run->base.bufs.src->vb2_buf, 0);
+	u32 strm_off = fp->uncompressed_header_size & ~0xfu;
+	u32 strm_len = vb2_get_plane_payload(&run->base.bufs.src->vb2_buf, 0);
+	u32 hor_virstride = dst_fmt->plane_fmt[0].bytesperline / 16;
+	u32 y_virstride = hor_virstride * dst_fmt->height;
+	u32 ctx_idx = vp9_ctx->cur.frame_context_idx;
+	bool is_intra = frame_is_intra(fp->flags);
+	dma_addr_t segid_cur, segid_last;
+	u32 pixels = dst_fmt->width * dst_fmt->height;
+	u32 hw_len;
+	int i;
+
+	memset(regs, 0, sizeof(*regs));
+
+	regs->common.reg008_dec_mode = VDPU383_MODE_VP9;
+
+	/* Activate block gating */
+	regs->common.reg010_block_gating_en.strmd_auto_gating_e = 1;
+	regs->common.reg010_block_gating_en.inter_auto_gating_e = 1;
+	regs->common.reg010_block_gating_en.intra_auto_gating_e = 1;
+	regs->common.reg010_block_gating_en.transd_auto_gating_e = 1;
+	regs->common.reg010_block_gating_en.recon_auto_gating_e = 1;
+	regs->common.reg010_block_gating_en.filterd_auto_gating_e = 1;
+	regs->common.reg010_block_gating_en.bus_auto_gating_e = 1;
+	regs->common.reg010_block_gating_en.ctrl_auto_gating_e = 1;
+	regs->common.reg010_block_gating_en.rcb_auto_gating_e = 1;
+	regs->common.reg010_block_gating_en.err_prc_auto_gating_e = 1;
+
+	/* Set timeout threshold */
+	if (pixels < RKVDEC_1080P_PIXELS)
+		regs->common.reg013_core_timeout_threshold = VDPU383_TIMEOUT_1080p;
+	else if (pixels < RKVDEC_4K_PIXELS)
+		regs->common.reg013_core_timeout_threshold = VDPU383_TIMEOUT_4K;
+	else if (pixels < RKVDEC_8K_PIXELS)
+		regs->common.reg013_core_timeout_threshold = VDPU383_TIMEOUT_8K;
+	else
+		regs->common.reg013_core_timeout_threshold = VDPU383_TIMEOUT_MAX;
+
+	regs->common.reg016_error_ctrl_set.error_proc_disable = 1;
+
+	/*
+	 * Required for VP9: with the CABAC error detection masks at zero every
+	 * block is taken as an error and replaced by a fill value, only a small
+	 * part of the picture is decoded.
+	 */
+	regs->common.reg020_cabac_error_en_lowbits = 0xffffffdf;
+	regs->common.reg021_cabac_error_en_highbits = 0x3fffffff;
+
+	/* AXI performance counters and address alignment, as the vendor does */
+	regs->common.reg028_debug_perf_latency_ctrl0.axi_perf_work_e = 1;
+	regs->common.reg028_debug_perf_latency_ctrl0.axi_cnt_type = 1;
+	regs->common.reg028_debug_perf_latency_ctrl0.rd_latency_id = 11;
+	regs->common.reg029_debug_perf_latency_ctrl1.addr_align_type = 1;
+	regs->common.reg029_debug_perf_latency_ctrl1.aw_cnt_id_type = 1;
+	regs->common.reg029_debug_perf_latency_ctrl1.ar_count_id = 17;
+
+	/*
+	 * The stream starts at the 16 byte boundary the uncompressed header
+	 * ends in, the rest of the header is skipped bit-wise.
+	 */
+	regs->h26x_params.reg065_strm_start_bit = 8 * (fp->uncompressed_header_size & 0xf);
+	hw_len = ((strm_len + 15) & ~15u) + VDPU383_VP9_STRM_PAD;
+	/* Never let the hardware fetch behind the end of the buffer */
+	hw_len = min_t(u32, hw_len,
+		       vb2_plane_size(&run->base.bufs.src->vb2_buf, 0) - strm_off);
+	regs->h26x_params.reg066_stream_len = hw_len;
+	regs->h26x_params.reg067_global_len = VDPU383_VP9_GBL_LEN;
+
+	regs->h26x_params.reg068_hor_virstride = hor_virstride;
+	regs->h26x_params.reg069_raster_uv_hor_virstride = hor_virstride;
+	regs->h26x_params.reg070_y_virstride = y_virstride;
+
+	regs->h26x_params.reg080_error_ref_hor_virstride = hor_virstride;
+	regs->h26x_params.reg081_error_ref_raster_uv_hor_virstride = hor_virstride;
+	regs->h26x_params.reg082_error_ref_virstride = y_virstride;
+
+	/*
+	 * Strides of the three references. Intra frames have none: the
+	 * hardware is told so by zero strides.
+	 */
+	if (!is_intra) {
+		regs->h26x_params.reg083_ref0_hor_virstride = hor_virstride;
+		regs->h26x_params.reg084_ref0_raster_uv_hor_virstride = hor_virstride;
+		regs->h26x_params.reg085_ref0_virstride = y_virstride;
+		regs->h26x_params.reg086_ref1_hor_virstride = hor_virstride;
+		regs->h26x_params.reg087_ref1_raster_uv_hor_virstride = hor_virstride;
+		regs->h26x_params.reg088_ref1_virstride = y_virstride;
+		regs->h26x_params.reg089_ref2_hor_virstride = hor_virstride;
+		regs->h26x_params.reg090_ref2_raster_uv_hor_virstride = hor_virstride;
+		regs->h26x_params.reg091_ref2_virstride = y_virstride;
+	}
+
+	/* Input stream and global header */
+	regs->common_addr.reg128_strm_base = src_addr + strm_off;
+	regs->common_addr.reg131_gbl_base = priv_dma + offsetof(struct rkvdec_vdpu383_vp9_priv_tbl, gbl);
+
+	/* Set RCB addresses */
+	for (i = 0; i < rkvdec_rcb_buf_count(ctx); i++) {
+		regs->common_addr.reg140_162_rcb_info[i].offset = rkvdec_rcb_buf_dma_addr(ctx, i);
+		regs->common_addr.reg140_162_rcb_info[i].size = rkvdec_rcb_buf_size(ctx, i);
+	}
+
+	/*
+	 * Output and references. Unused reference, payload and colmv slots are
+	 * left at zero: the hardware takes anything else there for an
+	 * additional reference.
+	 */
+	regs->vp9_addr.reg168_decout_base = dst_addr;
+	regs->vp9_addr.reg169_error_ref_base = dst_addr;
+	regs->vp9_addr.reg170_last_ref_base =
+		vb2_dma_contig_plane_dma_addr(&ref_bufs[0]->base.vb.vb2_buf, 0);
+	regs->vp9_addr.reg171_golden_ref_base =
+		vb2_dma_contig_plane_dma_addr(&ref_bufs[1]->base.vb.vb2_buf, 0);
+	regs->vp9_addr.reg172_altref_ref_base =
+		vb2_dma_contig_plane_dma_addr(&ref_bufs[2]->base.vb.vb2_buf, 0);
+
+	regs->vp9_addr.reg192_payload_cur_base = dst_addr;
+	regs->vp9_addr.reg194_payload_error_ref_base = dst_addr;
+	regs->vp9_addr.reg195_payload_ref0_base = regs->vp9_addr.reg170_last_ref_base;
+	regs->vp9_addr.reg196_payload_ref1_base = regs->vp9_addr.reg171_golden_ref_base;
+	regs->vp9_addr.reg197_payload_ref2_base = regs->vp9_addr.reg172_altref_ref_base;
+
+	/* Segment id maps */
+	segid_cur = priv_dma + offsetof(struct rkvdec_vdpu383_vp9_priv_tbl, segmap) +
+		    RKVDEC_VP9_MAX_SEGMAP_SIZE * vp9_ctx->cur.segmapid;
+	segid_last = priv_dma + offsetof(struct rkvdec_vdpu383_vp9_priv_tbl, segmap) +
+		     RKVDEC_VP9_MAX_SEGMAP_SIZE * !vp9_ctx->cur.segmapid;
+	regs->vp9_addr.reg181_segid_last_base = segid_last;
+	regs->vp9_addr.reg182_segid_cur_base = segid_cur;
+
+	/*
+	 * Probabilities: key frame table, the context the frame starts from
+	 * and where the adapted context is stored. The latter must not be
+	 * the pristine defaults.
+	 */
+	regs->vp9_addr.reg183_kf_prob_base = priv_dma +
+		offsetof(struct rkvdec_vdpu383_vp9_priv_tbl, kf_probs);
+	if (vp9_ctx->prob_ctx_valid[ctx_idx])
+		regs->vp9_addr.reg184_lastprob_base = priv_dma +
+			offsetof(struct rkvdec_vdpu383_vp9_priv_tbl, probs[ctx_idx]);
+	else
+		regs->vp9_addr.reg184_lastprob_base = priv_dma +
+			offsetof(struct rkvdec_vdpu383_vp9_priv_tbl, prob_default);
+	regs->vp9_addr.reg185_updateprob_base = priv_dma +
+		offsetof(struct rkvdec_vdpu383_vp9_priv_tbl, probs[ctx_idx]);
+
+	/*
+	 * Collocated motion vectors. The hardware reads reg217 whatever the
+	 * frame header says, so point it at our own buffer when there are no
+	 * previous ones.
+	 */
+	regs->vp9_addr.reg216_colmv_cur_base = dst_addr + ctx->colmv_offset;
+	regs->vp9_addr.reg217_colmv_ref_base =
+		vb2_dma_contig_plane_dma_addr(&mv_ref->base.vb.vb2_buf, 0) +
+		ctx->colmv_offset;
+}
+
+/*
+ * Number of VP9 frame contexts the frame resets, see 7.2 and 6.2
+ * setup_past_independence()/reset_frame_context in the VP9 specification.
+ */
+static void invalidate_probs(struct rkvdec_vdpu383_vp9_ctx *vp9_ctx,
+			     const struct v4l2_ctrl_vp9_frame *fp)
+{
+	if ((fp->flags & (V4L2_VP9_FRAME_FLAG_KEY_FRAME |
+			  V4L2_VP9_FRAME_FLAG_ERROR_RESILIENT)) ||
+	    fp->reset_frame_context == V4L2_VP9_RESET_FRAME_CTX_ALL)
+		memset(vp9_ctx->prob_ctx_valid, 0, sizeof(vp9_ctx->prob_ctx_valid));
+	else if (fp->reset_frame_context == V4L2_VP9_RESET_FRAME_CTX_SPEC)
+		vp9_ctx->prob_ctx_valid[fp->frame_context_idx] = false;
+}
+
+static int validate_dec_params(struct rkvdec_ctx *ctx,
+			       const struct v4l2_ctrl_vp9_frame *dec_params)
+{
+	unsigned int aligned_width, aligned_height;
+
+	aligned_width = round_up(dec_params->frame_width_minus_1 + 1, 64);
+	aligned_height = round_up(dec_params->frame_height_minus_1 + 1, 16);
+
+	/*
+	 * Userspace should update the capture/decoded format when the
+	 * resolution changes.
+	 */
+	if (aligned_width != ctx->decoded_fmt.fmt.pix_mp.width ||
+	    aligned_height != ctx->decoded_fmt.fmt.pix_mp.height) {
+		dev_err(ctx->dev->dev,
+			"unexpected bitstream resolution %dx%d\n",
+			dec_params->frame_width_minus_1 + 1,
+			dec_params->frame_height_minus_1 + 1);
+		return -EINVAL;
+	}
+
+	return 0;
+}
+
+static int rkvdec_vdpu383_vp9_run(struct rkvdec_ctx *ctx)
+{
+	struct rkvdec_dev *rkvdec = ctx->dev;
+	struct rkvdec_vdpu383_vp9_ctx *vp9_ctx = ctx->priv;
+	struct rkvdec_vdpu383_vp9_run run = { };
+	const struct v4l2_ctrl_vp9_frame *fp;
+	struct rkvdec_decoded_buffer *dst, *ref_bufs[3], *mv_ref;
+	struct v4l2_ctrl *ctrl;
+	u32 timeout_threshold;
+	bool is_intra;
+	int ret;
+
+	rkvdec_run_preamble(ctx, &run.base);
+
+	ctrl = v4l2_ctrl_find(&ctx->ctrl_hdl, V4L2_CID_STATELESS_VP9_FRAME);
+	if (WARN_ON(!ctrl)) {
+		ret = -EINVAL;
+		goto err_postamble;
+	}
+	fp = ctrl->p_cur.p;
+	run.decode_params = fp;
+
+	ret = validate_dec_params(ctx, fp);
+	if (ret)
+		goto err_postamble;
+
+	is_intra = frame_is_intra(fp->flags);
+
+	/*
+	 * By this point userspace has done all parts of 6.2
+	 * uncompressed_header() except for the frame context reset in
+	 * setup_past_independence(). The effective frame context index is 0
+	 * for key frames, intra only and error resilient frames.
+	 */
+	vp9_ctx->cur.frame_context_idx =
+		v4l2_vp9_reset_frame_ctx(fp, vp9_ctx->frame_context);
+	invalidate_probs(vp9_ctx, fp);
+
+	dst = vb2_to_rkvdec_decoded_buf(&run.base.bufs.dst->vb2_buf);
+	update_dec_buf_info(dst, fp);
+	update_ctx_cur_info(vp9_ctx, dst, fp);
+
+	ref_bufs[0] = get_ref_buf(ctx, &dst->base.vb, fp->last_frame_ts);
+	ref_bufs[1] = get_ref_buf(ctx, &dst->base.vb, fp->golden_frame_ts);
+	ref_bufs[2] = get_ref_buf(ctx, &dst->base.vb, fp->alt_frame_ts);
+
+	/* The map is only replaced by frames that rewrite it */
+	vp9_ctx->cur.segmapid = vp9_ctx->last.segmapid;
+	if (!is_intra &&
+	    !(fp->flags & V4L2_VP9_FRAME_FLAG_ERROR_RESILIENT) &&
+	    (!(fp->seg.flags & V4L2_VP9_SEGMENTATION_FLAG_ENABLED) ||
+	     (fp->seg.flags & V4L2_VP9_SEGMENTATION_FLAG_UPDATE_MAP)))
+		vp9_ctx->cur.segmapid++;
+
+	/*
+	 * Previous motion vectors come from the previous frame, if there is
+	 * one that may be used, otherwise from the frame itself.
+	 */
+	if (!is_intra && !(fp->flags & V4L2_VP9_FRAME_FLAG_ERROR_RESILIENT) &&
+	    vp9_ctx->last.valid &&
+	    !frame_is_intra(vp9_ctx->last.flags) &&
+	    (vp9_ctx->last.flags & V4L2_VP9_FRAME_FLAG_SHOW_FRAME))
+		mv_ref = get_ref_buf(ctx, &dst->base.vb, vp9_ctx->last.timestamp);
+	else
+		mv_ref = dst;
+
+	config_global_hdr(ctx, fp, ref_bufs);
+	config_registers(ctx, &run, ref_bufs, mv_ref);
+
+	/* Read caches, as the vendor driver sets them up */
+	writel(VDPU383_CACHE_CACHEABLE | VDPU383_CACHE_READ_ALLOC |
+	       VDPU383_CACHE_LINE_64, rkvdec->regs + VDPU383_REG_CACHE0_SIZE);
+	writel(VDPU383_CACHE_CLR, rkvdec->regs + VDPU383_REG_CACHE0_CLR);
+	writel(VDPU383_CACHE_MAX_READS, rkvdec->regs + VDPU383_REG_CACHE_MAX_READS);
+
+	rkvdec_write_regs(ctx);
+
+	rkvdec_run_postamble(ctx, &run.base);
+
+	timeout_threshold = vp9_ctx->regs.common.reg013_core_timeout_threshold;
+	rkvdec_schedule_watchdog(rkvdec, timeout_threshold);
+
+	/* Make sure the registers have reached the hardware, then start it */
+	wmb();
+	(void)readl(rkvdec->regs + VDPU383_OFFSET_COMMON_REGS);
+
+	writel(timeout_threshold, rkvdec->link + VDPU383_LINK_TIMEOUT_THRESHOLD);
+	writel(VDPU383_IP_CRU_MODE, rkvdec->link + VDPU383_LINK_IP_ENABLE);
+	writel(VDPU383_DEC_E_BIT, rkvdec->link + VDPU383_LINK_DEC_ENABLE);
+
+	return 0;
+
+err_postamble:
+	rkvdec_run_postamble(ctx, &run.base);
+	return ret;
+}
+
+static void rkvdec_vdpu383_vp9_done(struct rkvdec_ctx *ctx,
+				    struct vb2_v4l2_buffer *src_buf,
+				    struct vb2_v4l2_buffer *dst_buf,
+				    enum vb2_buffer_state result)
+{
+	struct rkvdec_vdpu383_vp9_ctx *vp9_ctx = ctx->priv;
+
+	/*
+	 * 6.1.2 refresh_probs(): the hardware has adapted the probabilities
+	 * and saved them to the frame context it was told to use.
+	 */
+	if (result == VB2_BUF_STATE_DONE &&
+	    (vp9_ctx->cur.flags & V4L2_VP9_FRAME_FLAG_REFRESH_FRAME_CTX))
+		vp9_ctx->prob_ctx_valid[vp9_ctx->cur.frame_context_idx] = true;
+
+	vp9_ctx->last = vp9_ctx->cur;
+}
+
+static int rkvdec_vdpu383_vp9_start(struct rkvdec_ctx *ctx)
+{
+	struct rkvdec_dev *rkvdec = ctx->dev;
+	struct rkvdec_vdpu383_vp9_priv_tbl *priv_tbl;
+	struct rkvdec_vdpu383_vp9_ctx *vp9_ctx;
+	int ret;
+
+	vp9_ctx = kzalloc(sizeof(*vp9_ctx), GFP_KERNEL);
+	if (!vp9_ctx)
+		return -ENOMEM;
+
+	BUILD_BUG_ON(sizeof(priv_tbl->probs[0]) % 16);
+	BUILD_BUG_ON(sizeof(priv_tbl->gbl) != VDPU383_VP9_GBL_SIZE);
+	priv_tbl = dma_alloc_coherent(rkvdec->dev, sizeof(*priv_tbl),
+				      &vp9_ctx->priv_tbl.dma, GFP_KERNEL);
+	if (!priv_tbl) {
+		ret = -ENOMEM;
+		goto err_free_ctx;
+	}
+
+	vp9_ctx->priv_tbl.size = sizeof(*priv_tbl);
+	vp9_ctx->priv_tbl.cpu = priv_tbl;
+
+	init_probs(vp9_ctx);
+
+	ctx->priv = vp9_ctx;
+	return 0;
+
+err_free_ctx:
+	kfree(vp9_ctx);
+	return ret;
+}
+
+static void rkvdec_vdpu383_vp9_stop(struct rkvdec_ctx *ctx)
+{
+	struct rkvdec_vdpu383_vp9_ctx *vp9_ctx = ctx->priv;
+	struct rkvdec_dev *rkvdec = ctx->dev;
+
+	dma_free_coherent(rkvdec->dev, vp9_ctx->priv_tbl.size,
+			  vp9_ctx->priv_tbl.cpu, vp9_ctx->priv_tbl.dma);
+	kfree(vp9_ctx);
+}
+
+static int rkvdec_vdpu383_vp9_adjust_fmt(struct rkvdec_ctx *ctx,
+					 struct v4l2_format *f)
+{
+	struct v4l2_pix_format_mplane *fmt = &f->fmt.pix_mp;
+
+	fmt->num_planes = 1;
+	if (!fmt->plane_fmt[0].sizeimage)
+		fmt->plane_fmt[0].sizeimage = fmt->width * fmt->height * 2;
+	return 0;
+}
+
+static enum rkvdec_image_fmt
+rkvdec_vdpu383_vp9_get_image_fmt(struct rkvdec_ctx *ctx, struct v4l2_ctrl *ctrl)
+{
+	const struct v4l2_ctrl_vp9_frame *frame = ctrl->p_new.p_vp9_frame;
+
+	if (ctrl->id != V4L2_CID_STATELESS_VP9_FRAME)
+		return RKVDEC_IMG_FMT_ANY;
+
+	switch (frame->bit_depth) {
+	case 8:
+		return RKVDEC_IMG_FMT_420_8BIT;
+	case 10:
+		return RKVDEC_IMG_FMT_420_10BIT;
+	default:
+		return RKVDEC_IMG_FMT_ANY;
+	}
+}
+
+const struct rkvdec_coded_fmt_ops rkvdec_vdpu383_vp9_fmt_ops = {
+	.adjust_fmt = rkvdec_vdpu383_vp9_adjust_fmt,
+	.start = rkvdec_vdpu383_vp9_start,
+	.stop = rkvdec_vdpu383_vp9_stop,
+	.run = rkvdec_vdpu383_vp9_run,
+	.done = rkvdec_vdpu383_vp9_done,
+	.get_image_fmt = rkvdec_vdpu383_vp9_get_image_fmt,
+};
