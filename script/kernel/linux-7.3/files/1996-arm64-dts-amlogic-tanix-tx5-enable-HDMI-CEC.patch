From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Piotr Oniszczuk <piotr.oniszczuk@gmail.com>
Date: Thu, 26 Nov 2026 14:17:06 +0100
Subject: [PATCH] arm64: dts: amlogic: tanix-tx5: enable HDMI CEC

Enable the CEC B controller of the Tanix TX5 on the HDMI CEC pin.

Signed-off-by: Piotr Oniszczuk <piotr.oniszczuk@gmail.com>
---
 arch/arm64/boot/dts/amlogic/amlogic-s7-s905y5-tanix-tx5.dts | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/arch/arm64/boot/dts/amlogic/amlogic-s7-s905y5-tanix-tx5.dts b/arch/arm64/boot/dts/amlogic/amlogic-s7-s905y5-tanix-tx5.dts
index 716c38d..2e74d91 100644
--- a/arch/arm64/boot/dts/amlogic/amlogic-s7-s905y5-tanix-tx5.dts
+++ b/arch/arm64/boot/dts/amlogic/amlogic-s7-s905y5-tanix-tx5.dts
@@ -196,6 +196,12 @@
 	status = "okay";
 };
 
+&cecb {
+	pinctrl-0 = <&hdmitx_cec_pins>;
+	pinctrl-names = "default";
+	status = "okay";
+};
+
 &emmc {
 	pinctrl-0 = <&emmc_pins>, <&emmc_clk_pins>, <&emmc_ds_pins>;
 	pinctrl-1 = <&emmc_clk_gate_pins>;
-- 
2.43.0

