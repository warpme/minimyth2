+/*
+ * The T7 microcode stores the RPM block with each group of four words in
+ * reverse order; the vendor driver undoes that when it reads the block.
+ */
+static void av1_rpm_swap(u16 *r)
+{
+	int i;
+
+	for (i = 0; i < ALIGN(AV1_RPM_WORDS, 4); i += 4) {
+		swap(r[i], r[i + 3]);
+		swap(r[i + 1], r[i + 2]);
+	}
+}
+
 static void av1_check_rpm(struct amvdec_session *sess, struct codec_av1 *av1)
 {
 	const struct v4l2_ctrl_av1_frame *f = &av1->req.frame;
@@ -1303,6 +1317,8 @@
