 static int codec_h264_can_recycle(struct amvdec_core *core)
 {
+	/*
+	 * The multi firmware has no recycle mailbox - it takes returned
+	 * frames through the buffer info table instead - and it uses
+	 * AV_SCRATCH_8 for its workspace pointer, so recycling into these
+	 * registers would corrupt it.
+	 */
+	if (READ_ONCE(h264_multi_blob))
+		return 0;
+
 	return !amvdec_read_dos(core, AV_SCRATCH_7) ||
 	       !amvdec_read_dos(core, AV_SCRATCH_8);
 }
