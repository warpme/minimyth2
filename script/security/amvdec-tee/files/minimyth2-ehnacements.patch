+/* Wait for the TEE character devices, which appear once the driver and
+ * tee-supplicant are up. Returns 0 on success, -1 on timeout. */
+static int wait_for_tee(unsigned int seconds)
+{
+	static const char * const nodes[] = { "/dev/teepriv0", "/dev/tee0" };
+	double deadline = now_sec() + seconds;
+	size_t i;
+
+	for (;;) {
+		bool all = true;
+
+		for (i = 0; i < sizeof(nodes) / sizeof(nodes[0]); i++)
+			if (access(nodes[i], F_OK))
+				all = false;
+
+		if (all)
+			return 0;
+
+		if (now_sec() >= deadline)
+			break;
+
+		usleep(200 * 1000);
+	}
+
+	err("%s did not appear within %u s (driver loaded, tee-supplicant running?)",
+	    !access(nodes[0], F_OK) ? nodes[1] : nodes[0], seconds);
+	return -1;
+}
