+};
+
+static const struct udevice_id meson_t7_pinctrl_match[] = {
+	{
+		.compatible = "amlogic,t7-periphs-pinctrl",
+		.data = (ulong)&meson_t7_periphs_pinctrl_data,
+	},
+	{ /* sentinel */ }
+};
+
+static int meson_t7_pinctrl_probe(struct udevice *dev)
+{
+	struct meson_pinctrl *priv = dev_get_priv(dev);
+	int ret = meson_pinctrl_probe(dev);
