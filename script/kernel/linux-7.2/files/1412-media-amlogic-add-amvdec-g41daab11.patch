diff --speed-large-files --no-dereference --minimal -Naur linux-7.2.8/drivers/media/platform/amlogic/amvdec/tests/t4_irq.s linux-7.2.8/drivers/media/platform/amlogic/amvdec/tests/t4_irq.s
--- linux-7.2.8/drivers/media/platform/amlogic/amvdec/tests/t4_irq.s	1970-01-01 01:00:00.000000000 +0100
+++ linux-7.2.8/drivers/media/platform/amlogic/amvdec/tests/t4_irq.s	2026-10-02 08:55:53.000000000 +0200
@@ -0,0 +1,87 @@
+; T4 - ei/di, MCPU_INTR_MSK polarity, software interrupt via MCPU_INTR_REQ,
+; latching, and whether an ISR must clear the request.
+; SCRATCH_E = ISR count after REQ with bit3 MASKED (expect 0)
+; SCRATCH_F = ISR count after unmask but under DI (expect 0 if di works)
+; SCRATCH_G = ISR count shortly after EI (>=1 if request latched)
+; SCRATCH_B = ISR count (live), SCRATCH_D = main-loop count (live)
+; SCRATCH_H = MCPU_INTR_REQ as seen inside the ISR, SCRATCH_I = MCPU_INTR_GRP
+; SCRATCH_J = MSP inside the ISR; SCRATCH_K = REQ read back in main after ISR
+.org 0x0
+    jmp start
+    nop
+.org 0x20
+    ret
+    ei
+    ret
+    ei
+    ret
+    ei
+    jmp isr3
+    nop
+    ret
+    ei
+    ret
+    ei
+    ret
+    ei
+    ret
+    ei
+    ret
+    ei
+.org 0x40
+start:
+    movi r20, #0
+    movi r22, #0
+    movi r0, #0xffff
+    mtsp MCPU_INTR_MSK, r0
+    ei
+    ; phase 1: request bit 3 while masked
+    movi r1, #0x8
+    mtsp MCPU_INTR_REQ, r1
+    movi r2, #0x400
+p1: dbnz r2, p1
+    nop
+    mtsp AV_SCRATCH_E, r20
+    ; phase 2: unmask bit 3 under di
+    di
+    movi r0, #0xfff7
+    mtsp MCPU_INTR_MSK, r0
+    mtsp MCPU_INTR_REQ, r1
+    movi r2, #0x400
+p2: dbnz r2, p2
+    nop
+    mtsp AV_SCRATCH_F, r20
+    ; phase 3: ei
+    ei
+    movi r2, #0x400
+p3: dbnz r2, p3
+    nop
+    mtsp AV_SCRATCH_G, r20
+    mfsp r5, MCPU_INTR_REQ
+    mtsp AV_SCRATCH_K, r5
+    ; phase 4: live loop; request one more interrupt every 0x100 iterations
+    movi r4, #0x100
+    movi r3, #0
+main:
+    addi r22, r22, #1
+    mtsp AV_SCRATCH_D, r22
+    addi r3, r3, #1
+    bne r3, r4, main
+    nop
+    movi r3, #0
+    mtsp MCPU_INTR_REQ, r1
+    jmp main
+    nop
+isr3:
+    mfsp r21, MCPU_INTR_REQ
+    mtsp AV_SCRATCH_H, r21
+    mfsp r21, MCPU_INTR_GRP
+    mtsp AV_SCRATCH_I, r21
+    mfsp r21, MSP
+    mtsp AV_SCRATCH_J, r21
+    addi r20, r20, #1
+    mtsp AV_SCRATCH_B, r20
+    movi r21, #0
+    mtsp MCPU_INTR_REQ, r21
+    ret
+    ei
