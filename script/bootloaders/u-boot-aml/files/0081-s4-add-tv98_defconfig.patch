--- u-boot-5508406582f6f7120dce0c4b3059819a41788db2/arch/arm/dts/meson-s4-s905w2-tv98-u-boot.dtsi	1970-01-01 01:00:00.000000000 +0100
+++ u-boot-5508406582f6f7120dce0c4b3059819a41788db2/arch/arm/dts/meson-s4-s905w2-tv98-u-boot.dtsi	2026-10-22 21:16:08.357536043 +0200
@@ -0,0 +1,22 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * U-Boot specific additions for the TV98 (Amlogic S905W2).
+ *
+ * The console UART has to be bound before relocation, which U-Boot only
+ * does for nodes marked with bootph-all, including all of their parents.
+ * Without it the build stops with "No serial driver found".
+ */
+
+/ {
+	soc {
+		bootph-all;
+	};
+};
+
+&apb4 {
+	bootph-all;
+};
+
+&uart_b {
+	bootph-all;
+};
