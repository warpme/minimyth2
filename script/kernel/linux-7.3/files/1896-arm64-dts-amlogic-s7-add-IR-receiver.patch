From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Piotr Oniszczuk <piotr.oniszczuk@gmail.com>
Date: Thu, 26 Nov 2026 17:34:24 +0100
Subject: [PATCH] arm64: dts: amlogic: s7: add IR receiver

Add the IR receiver of the Amlogic S7 SoC and its input pin (GPIOD_5,
function 1). It is the same block as on S4, at the same offset of the
peripherals bus, with interrupt 22 as in the vendor device tree.

Signed-off-by: Piotr Oniszczuk <piotr.oniszczuk@gmail.com>
---
 arch/arm64/boot/dts/amlogic/amlogic-s7.dtsi | 14 ++++++++++++++
 1 file changed, 14 insertions(+)

diff --git a/arch/arm64/boot/dts/amlogic/amlogic-s7.dtsi b/arch/arm64/boot/dts/amlogic/amlogic-s7.dtsi
index 44dc822..bd54541 100644
--- a/arch/arm64/boot/dts/amlogic/amlogic-s7.dtsi
+++ b/arch/arm64/boot/dts/amlogic/amlogic-s7.dtsi
@@ -557,6 +557,13 @@
 					};
 				};
 
+				func-remote-input {
+					remote_input_pins: group-remote-input {
+						pinmux = <AML_PINMUX(AMLOGIC_GPIO_D, 5, 1)>;
+						bias-disable;
+					};
+				};
+
 				func-sdcard {
 					sdcard_pins: group-sdcard-default {
 						pinmux = <AML_PINMUX(AMLOGIC_GPIO_C, 0, 1)>,
@@ -649,6 +656,13 @@
 				reg = <0x0 0x48000 0x0 0x1c>;
 			};
 
+			ir: ir@84040 {
+				compatible = "amlogic,meson-s7-ir", "amlogic,meson-s4-ir";
+				reg = <0x0 0x84040 0x0 0x30>;
+				interrupts = <GIC_SPI 22 IRQ_TYPE_EDGE_RISING>;
+				status = "disabled";
+			};
+
 			sdio: mmc@88000 {
 				compatible = "amlogic,s7-mmc", "amlogic,meson-axg-mmc";
 				reg = <0x0 0x88000 0x0 0x800>;
-- 
2.43.0

