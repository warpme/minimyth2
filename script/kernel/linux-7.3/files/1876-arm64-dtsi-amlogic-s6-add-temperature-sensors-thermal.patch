Patch from MiniMyth2 project

Developed-by: Piotr Oniszczuk <piotr.oniszczuk@gmail.com>
Signed-off-by: Piotr Oniszczuk <piotr.oniszczuk@gmail.com>



From ef1f9adbcf531d9baa39c1d4efdedb15a718e671 Mon Sep 17 00:00:00 2001
From: Piotr Oniszczuk <piotr.oniszczuk@gmail.com>
Date: Wed, 18 Nov 2026 18:14:25 +0100
Subject: [PATCH] arm64: dts: amlogic: s6: add temperature sensors, thermal zones and OPP bins

Add the PLL (0xfe020000) and CPU (0xfe022000) temperature sensors with
the vendor trip points and CPU cooling, and the per-bin voltages of the
vendor CPU OPP tables (up to 2.0 GHz) next to the default ones.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 arch/arm64/boot/dts/amlogic/amlogic-s6.dtsi | 106 ++++++++++++++++++++
 1 file changed, 106 insertions(+)

diff --git a/arch/arm64/boot/dts/amlogic/amlogic-s6.dtsi b/arch/arm64/boot/dts/amlogic/amlogic-s6.dtsi
index ef505212d..be214e04b 100644
--- a/arch/arm64/boot/dts/amlogic/amlogic-s6.dtsi
+++ b/arch/arm64/boot/dts/amlogic/amlogic-s6.dtsi
@@ -16,6 +16,7 @@
 #include <dt-bindings/reset/amlogic,meson-axg-audio-arb.h>
 #include <dt-bindings/reset/amlogic,meson-g12a-audio-reset.h>
 #include <dt-bindings/sound/meson-g12a-tohdmitx.h>
+#include <dt-bindings/thermal/thermal.h>
 
 / {
 	cpus {
@@ -150,41 +151,124 @@ cpu_opp_table: opp-table-cpu {
 		opp-500000000 {
 			opp-hz = /bits/ 64 <500000000>;
 			opp-microvolt = <799000>;
+			opp-microvolt-bin1 = <789000>;
+			opp-microvolt-bin2 = <779000>;
+			opp-microvolt-bin3 = <759000>;
 		};
 
 		opp-666666000 {
 			opp-hz = /bits/ 64 <666666000>;
 			opp-microvolt = <799000>;
+			opp-microvolt-bin1 = <789000>;
+			opp-microvolt-bin2 = <779000>;
+			opp-microvolt-bin3 = <759000>;
 		};
 
 		opp-1000000000 {
 			opp-hz = /bits/ 64 <1000000000>;
 			opp-microvolt = <799000>;
+			opp-microvolt-bin1 = <789000>;
+			opp-microvolt-bin2 = <779000>;
+			opp-microvolt-bin3 = <759000>;
 		};
 
 		opp-1200000000 {
 			opp-hz = /bits/ 64 <1200000000>;
 			opp-microvolt = <839000>;
+			opp-microvolt-bin1 = <809000>;
+			opp-microvolt-bin2 = <799000>;
+			opp-microvolt-bin3 = <779000>;
 		};
 
 		opp-1404000000 {
 			opp-hz = /bits/ 64 <1404000000>;
 			opp-microvolt = <859000>;
+			opp-microvolt-bin1 = <829000>;
+			opp-microvolt-bin2 = <819000>;
+			opp-microvolt-bin3 = <799000>;
 		};
 
 		opp-1608000000 {
 			opp-hz = /bits/ 64 <1608000000>;
 			opp-microvolt = <879000>;
+			opp-microvolt-bin1 = <849000>;
+			opp-microvolt-bin2 = <839000>;
+			opp-microvolt-bin3 = <809000>;
 		};
 
 		opp-1800000000 {
 			opp-hz = /bits/ 64 <1800000000>;
 			opp-microvolt = <909000>;
+			opp-microvolt-bin1 = <879000>;
+			opp-microvolt-bin2 = <869000>;
+			opp-microvolt-bin3 = <819000>;
 		};
 
 		opp-2004000000 {
 			opp-hz = /bits/ 64 <2004000000>;
 			opp-microvolt = <919000>;
+			opp-microvolt-bin1 = <899000>;
+			opp-microvolt-bin2 = <889000>;
+			opp-microvolt-bin3 = <839000>;
+		};
+	};
+
+	thermal-zones {
+		pll_thermal: pll-thermal {
+			polling-delay = <1000>;
+			polling-delay-passive = <100>;
+			thermal-sensors = <&pll_tsensor>;
+
+			trips {
+				pll_passive: pll-passive {
+					temperature = <85000>; /* millicelsius */
+					hysteresis = <5000>; /* millicelsius */
+					type = "passive";
+				};
+
+				pll_critical: pll-critical {
+					temperature = <105000>; /* millicelsius */
+					hysteresis = <1000>; /* millicelsius */
+					type = "critical";
+				};
+			};
+		};
+
+		cpu_thermal: cpu-thermal {
+			polling-delay = <1000>;
+			polling-delay-passive = <100>;
+			thermal-sensors = <&cpu_tsensor>;
+
+			trips {
+				cpu_passive: cpu-passive {
+					temperature = <85000>; /* millicelsius */
+					hysteresis = <5000>; /* millicelsius */
+					type = "passive";
+				};
+
+				cpu_hot: cpu-hot {
+					temperature = <95000>; /* millicelsius */
+					hysteresis = <5000>; /* millicelsius */
+					type = "hot";
+				};
+
+				cpu_critical: cpu-critical {
+					temperature = <105000>; /* millicelsius */
+					hysteresis = <1000>; /* millicelsius */
+					type = "critical";
+				};
+			};
+
+			cooling-maps {
+				map-cpu {
+					trip = <&cpu_passive>;
+					cooling-device =
+						<&cpu0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
+						<&cpu1 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
+						<&cpu2 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
+						<&cpu3 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
+				};
+			};
 		};
 	};
 
@@ -913,6 +997,28 @@ cecb: cec@44040 {
 				status = "disabled";
 			};
 
+			pll_tsensor: temperature-sensor@20000 {
+				compatible = "amlogic,s6-thermal";
+				reg = <0x0 0x20000 0x0 0x50>;
+				interrupts = <GIC_SPI 30 IRQ_TYPE_LEVEL_HIGH>;
+				clocks = <&clkc_periphs CLKID_SYS_TS_PLL>,
+					 <&clkc_periphs CLKID_TS>;
+				clock-names = "bus", "core";
+				#thermal-sensor-cells = <0>;
+				amlogic,secure-monitor = <&sm 1>;
+			};
+
+			cpu_tsensor: temperature-sensor@22000 {
+				compatible = "amlogic,s6-thermal";
+				reg = <0x0 0x22000 0x0 0x50>;
+				interrupts = <GIC_SPI 22 IRQ_TYPE_LEVEL_HIGH>;
+				clocks = <&clkc_periphs CLKID_SYS_TS_CORE>,
+					 <&clkc_periphs CLKID_TS>;
+				clock-names = "bus", "core";
+				#thermal-sensor-cells = <0>;
+				amlogic,secure-monitor = <&sm 2>;
+			};
+
 			clk_msr: clock-measure@48000 {
 				compatible = "amlogic,s6-clk-measure";
 				reg = <0x0 0x48000 0x0 0x1c>;
-- 
2.43.0

--

MiniMyth2

