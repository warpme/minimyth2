+	 */
+	if (abort_session) {
+		codec_h264_multi_vendor_stop(sess, "done-error");
+		codec_h264_multi_abort(sess);
+	}
+
+	v4l2_m2m_job_finish(sess->m2m_dev, sess->m2m_ctx);
+}
+
+/*
+ * Called only before direct VLD feed, while the session worker owns the job.
+ * The rejected destination is newly queued; already-DONE CAPTUREs are untouched.
+ */
+void codec_h264_multi_discard_capture(struct amvdec_session *sess, u32 vb2_idx)
+{
+	struct codec_h264 *h264 = sess->priv;
+	u32 fw;
+
+	if (!h264)
+		return;
+	/* Header synthesis updates this cache before firmware sees the bytes. */
+	h264->multi_headers_valid = false;
+	if (vb2_idx >= ARRAY_SIZE(sess->vb2_idx_to_fw_idx))
+		return;
+	fw = sess->vb2_idx_to_fw_idx[vb2_idx];
+	if (fw >= H264_MULTI_MAX_FW_BUFS || fw >= sess->num_fw_bufs ||
+	    sess->fw_idx_to_vb2_idx[fw] != vb2_idx)
+		return;
+	h264->multi_field_slots[fw].valid = false;
+}
+
+void codec_h264_multi_hold_src(struct amvdec_session *sess,
+			       struct vb2_v4l2_buffer *vbuf)
+{
+	struct codec_h264 *h264 = sess->priv;
+
+	if (h264) {
+		h264->multi_src_vbuf = vbuf;
+		if (!vbuf) {
+			h264->multi_decoded_fields = 0;
+			h264->multi_slice_data = NULL;
+			h264->multi_slice_size = 0;
+		}
+	}
+}
+
+int codec_h264_multi_feed_buffer(struct amvdec_session *sess,
+				 struct vb2_buffer *vb)
+{
+	struct codec_h264 *h264 = sess->priv;
+	struct amvdec_core *core = sess->core;
+	dma_addr_t src_dma = vb2_dma_contig_plane_dma_addr(vb, 0);
+	u32 payload = vb2_get_plane_payload(vb, 0);
+	u32 fifo_size = round_down(vb2_plane_size(vb, 0), VDEC_FIFO_ALIGN);
+	int i, ret;
+
+	/* WP includes read-ahead, but must stay inside the allocated ring. */
+	if (!payload || fifo_size <= VLD_PADDING_SIZE ||
+	    payload >= fifo_size - VLD_PADDING_SIZE ||
+	    !IS_ALIGNED(src_dma, VDEC_FIFO_ALIGN))
+		return -EINVAL;
+	/* Headers have been synthesized already; retain the actual DMA payload. */
+	h264->multi_slice_data = vb2_plane_vaddr(vb, 0);
+	h264->multi_slice_size = payload;
+	h264->multi_slice_cursor = 0;
+	h264->multi_slice_count = 0;
+	h264->multi_slice_type_mask = 0;
+	h264->multi_slice_uniform = false;
+	h264->multi_slice_mv_offset = 0;
+	h264->multi_done_error = false;
+	if (!h264->multi_slice_data)
+		return -EINVAL;
+	if (!h264->multi_pic_valid)
+		return h264->multi_params_error ? h264->multi_params_error : -EINVAL;
+	ret = codec_h264_multi_field_preflight(sess);
+	if (!ret && !h264->multi_request_picture.field_pic)
+		ret = codec_h264_multi_frame_preflight(sess);
+	if (ret) {
+		dev_err_ratelimited(core->dev_dec, "H264_FIELD source rejected: %d\n", ret);
+		/* No feed occurred; esparser retires only this request. */
+		return ret;
+	}
+
+	/* The vendor clears padding on every frame-block fill. Never expose
+	 * bytes left by an earlier OUTPUT when VLD reads beyond this payload.
+	 */
+	memset((u8 *)h264->multi_slice_data + payload, 0, VLD_PADDING_SIZE);
+	dma_sync_single_for_device(core->dev, src_dma + payload,
+				   VLD_PADDING_SIZE, DMA_TO_DEVICE);
+
+	h264->multi_src_dma = src_dma;
+	h264->multi_src_payload = payload;
+	h264->multi_src_crc = crc32_le(0, h264->multi_slice_data, payload);
+
+	dev_dbg(core->dev_dec,
+		 "H264_MULTI_FEED_ENTER pic=%u paddr=%pad payload=%u crc=%08x\n",
+		 h264->multi_pic_count, &src_dma, payload, h264->multi_src_crc);
+	codec_h264_multi_dump_recovery_regs(sess, "feed-enter");
+	codec_h264_multi_maybe_recovery_reset(sess);
+
+	/*
+	 * Halt the processors first. The VLD reset below is not safe with the
+	 * AMRISC live - doing it under a running firmware hung the SoC hard.
+	 * S4 gets this for free because it stops the hardware at the end of
+	 * every picture; this driver keeps it running, so stop it here.
+	 */
+	amvdec_write_dos(core, MPSR, 0);
+	amvdec_write_dos(core, CPSR, 0);
+	for (i = 0; i < 1000; i++) {
+		if (!(amvdec_read_dos(core, IMEM_DMA_CTRL) & 0x8000))
+			break;
+		udelay(10);
+	}
+	for (i = 0; i < 1000; i++) {
+		if (!(amvdec_read_dos(core, LMEM_DMA_CTRL) & 0x8000))
+			break;
+		udelay(10);
+	}
+
+	/*
+	 * The multi firmware is restarted for every picture: this is the
+	 * multi-instance model, where each access unit is a fresh decode
+	 * against a context the host restores. Resetting the VLD while the
+	 * AMRISC is still running is what hung the SoC, so the order below
+	 * follows the S4 stateless driver exactly - set up the input, restore
+	 * the context, then reset and restart the processors.
+	 */
+
+	/* ---- input: the VLD FIFO *is* the OUTPUT buffer ---- */
+	amvdec_write_dos(core, VLD_MEM_VIFIFO_CONTROL, 0);
+	amvdec_write_dos(core, DOS_SW_RESET0, BIT(5) | BIT(4) | BIT(3));
+	amvdec_write_dos(core, DOS_SW_RESET0, 0);
+	amvdec_write_dos(core, POWER_CTL_VLD, BIT(4));
+
+	amvdec_write_dos(core, VLD_MEM_VIFIFO_START_PTR, src_dma);
+	amvdec_write_dos(core, VLD_MEM_VIFIFO_END_PTR,
+			 src_dma + fifo_size - VDEC_FIFO_ALIGN);
+	amvdec_write_dos(core, VLD_MEM_VIFIFO_CURR_PTR,
+			 round_down(src_dma, VDEC_FIFO_ALIGN));
+
+	amvdec_write_dos(core, VLD_MEM_VIFIFO_CONTROL, 1);
+	amvdec_write_dos(core, VLD_MEM_VIFIFO_CONTROL, 0);
+	amvdec_write_dos(core, VLD_MEM_VIFIFO_BUF_CNTL, 2);
+
+	amvdec_write_dos(core, VLD_MEM_VIFIFO_RP,
+			 round_down(src_dma, VDEC_FIFO_ALIGN));
+	amvdec_write_dos(core, VLD_MEM_VIFIFO_WP,
+			 round_down(src_dma + payload + VLD_PADDING_SIZE,
+				    VDEC_FIFO_ALIGN));
+
+	amvdec_write_dos(core, VLD_MEM_VIFIFO_BUF_CNTL, 3);
+	amvdec_write_dos(core, VLD_MEM_VIFIFO_BUF_CNTL, 2);
+	amvdec_write_dos(core, VLD_MEM_VIFIFO_CONTROL,
+			 (0x11 << 16) | BIT(10) | (7 << 3));
+
+	amvdec_write_dos(core, AV_SCRATCH_1, 0);
+	amvdec_write_dos(core, M4_CONTROL_REG, BIT(13));
+	amvdec_write_dos(core, H264_DECODE_SIZE, payload);
+	amvdec_write_dos(core, VIFF_BIT_CNT, payload * 8);
+
+	/* ---- restore the per-picture hardware context ---- */
+	amvdec_write_dos(core, POWER_CTL_VLD,
+			 amvdec_read_dos(core, POWER_CTL_VLD) |
+			 BIT(9) | BIT(6));
+	amvdec_write_dos(core, PSCALE_CTRL, 0);
+	amvdec_write_dos(core, ASSIST_MBOX1_CLR_REG, 1);
+	amvdec_write_dos(core, ASSIST_MBOX1_MASK, 1);
+
+	amvdec_write_dos_bits(core, MDEC_PIC_DC_CTRL, BIT(17));
+	amvdec_clear_dos_bits(core, MDEC_PIC_DC_CTRL, BIT(16));
+	amvdec_write_dos_bits(core, MDEC_PIC_DC_CTRL, 0xbfu << 24);
+	amvdec_clear_dos_bits(core, MDEC_PIC_DC_CTRL, 0xbfu << 24);
+	amvdec_clear_dos_bits(core, MDEC_PIC_DC_CTRL, BIT(31));
+	amvdec_clear_dos_bits(core, MDEC_PIC_DC_MUX_CTRL, BIT(31));
+	amvdec_write_dos(core, MDEC_EXTIF_CFG1, 0);
+	amvdec_write_dos(core, MDEC_PIC_DC_THRESH, 0x404038aa);
+
+	amvdec_write_dos(core, DPB_STATUS_REG, 0);
+	if (h264->lmem_paddr)
+		amvdec_write_dos(core, LMEM_DUMP_ADR, h264->lmem_paddr);
+	amvdec_write_dos(core, FRAME_COUNTER_REG, h264->multi_pic_count);
+	amvdec_write_dos(core, AV_SCRATCH_8,
+			 codec_h264_multi_workspace_base(h264));
+	amvdec_write_dos(core, AV_SCRATCH_F,
+			 (amvdec_read_dos(core, AV_SCRATCH_F) & 0xffffffc3) |
+			 BIT(4));
+	amvdec_clear_dos_bits(core, AV_SCRATCH_F, BIT(6));
+	amvdec_write_dos(core, IQIDCT_CONTROL, 0x200);
+
+	/* ---- decode mode and stream-input enables ---- */
+	amvdec_write_dos(core, H264_DECODE_MODE, DECODE_MODE_MULTI_FRAMEBASE);
+	amvdec_write_dos(core, HEAD_PADING_REG, 0);
+	amvdec_write_dos(core, H264_DECODE_SEQINFO, h264->multi_seq_cfg);
+
+	/*
+	 * Sequence words, after the VLD reset that would otherwise clear them.
+	 * AV_SCRATCH_1 is deliberately left at the 0 written in the input
+	 * section: the S4 driver clears it there and never restores it, so the
+	 * firmware takes the sequence from H264_DECODE_SEQINFO instead.
+	 */
+	amvdec_write_dos(core, AV_SCRATCH_2, h264->multi_seq_cfg2);
+	amvdec_write_dos(core, AV_SCRATCH_B, h264->multi_seq_cfgb);
+	/*
+	 * INIT_FLAG_REG is AV_SCRATCH_2. S4 writes the sequence word there
+	 * early and INIT_FLAG_REG = 1 last, so the firmware sees 1; keep that
+	 * order rather than clobbering the flag with the sequence word.
+	 */
+	amvdec_write_dos(core, INIT_FLAG_REG, 1);
+	amvdec_write_dos(core, AV_SCRATCH_0, h264->multi_seq_scratch0);
+	amvdec_write_dos(core, NAL_SEARCH_CTL, h264->multi_nal_search_or);
+
+	amvdec_write_dos_bits(core, VLD_MEM_VIFIFO_CONTROL, 0x6);
+	amvdec_write_dos_bits(core, NAL_SEARCH_CTL, BIT(16));
+	amvdec_write_dos_bits(core, MDEC_EXTIF_CFG2, 0x20);
+	amvdec_clear_dos_bits(core, NAL_SEARCH_CTL, 0x2);
+	amvdec_clear_dos_bits(core, VDEC_ASSIST_MMC_CTRL1, BIT(3));
+
+	/* ---- restart the processors, then ask for the slice head ---- */
+	amvdec_read_dos(core, DOS_SW_RESET0);
+	amvdec_read_dos(core, DOS_SW_RESET0);
+	amvdec_read_dos(core, DOS_SW_RESET0);
+	amvdec_write_dos(core, DOS_SW_RESET0, BIT(12) | BIT(11));
+	amvdec_write_dos(core, DOS_SW_RESET0, 0);
+	amvdec_read_dos(core, DOS_SW_RESET0);
+	amvdec_read_dos(core, DOS_SW_RESET0);
+	amvdec_read_dos(core, DOS_SW_RESET0);
+	amvdec_write_dos(core, MPSR, 1);
+
+	h264->multi_pic_started = false;
+	h264->multi_hw_started = true;
+	amvdec_write_dos_action(core, DPB_STATUS_REG,
+				H264_ACTION_SEARCH_HEAD);
+
+	dev_dbg(core->dev_dec,
+		 "H264_MULTI_FEED pic=%u paddr=%pad payload=%u\n",
+		 h264->multi_pic_count, &src_dma, payload);
+	h264->multi_pic_count++;
+	return 0;
+}
+
+static void codec_h264_input_queued(struct amvdec_session *sess, u32 size)
+{
+	struct codec_h264 *h264 = sess->priv;
+
+	if (!h264 || !h264->multi_blob)
+		return;
+
+	/*
+	 * Frame-based decode: the firmware is told exactly how many bytes this
+	 * access unit occupies rather than left to scan a stream. That matches
+	 * one request per picture, so the size comes from the transfer that
+	 * just landed in the VIFIFO.
+	 */
+	amvdec_write_dos(sess->core, M4_CONTROL_REG, BIT(13));
+	amvdec_write_dos(sess->core, H264_DECODE_SIZE, size);
+	amvdec_write_dos(sess->core, VIFF_BIT_CNT, size * 8);
+
+	if (h264->multi_search_started)
+		return;
+
+	h264->multi_search_started = true;
+	amvdec_write_dos_action(sess->core, DPB_STATUS_REG,
+				H264_ACTION_SEARCH_HEAD);
+	dev_dbg(sess->core->dev_dec,
+		 "H264_MULTI_INPUT_QUEUED size=%#x bits=%#x dpb_status=search-head\n",
+		 size, size * 8);
+}
+
 struct amvdec_codec_ops codec_h264_ops = {
 	.start = codec_h264_start,
 	.stop = codec_h264_stop,
-	.load_extended_firmware = codec_h264_load_extended_firmware,
+	.pre_stop = codec_h264_pre_stop,
+	.job_abort = codec_h264_job_abort,
+	.firmware_path = codec_h264_firmware_path,
+	.load_firmware = codec_h264_load_firmware,
+	.post_start = codec_h264_post_start,
+	.input_queued = codec_h264_input_queued,
 	.isr = codec_h264_isr,
 	.threaded_isr = codec_h264_threaded_isr,
 	.can_recycle = codec_h264_can_recycle,
