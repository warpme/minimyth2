From 05ae00827996a873527d2a49c969b9df28640021 Mon Sep 17 00:00:00 2001
From: Piotr Oniszczuk <piotr.oniszczuk@gmail.com>
Date: Thu, 19 Nov 2026 16:16:44 +0100
Subject: [PATCH 17/17] arm64: dts: amlogic: s6: add USB support

Add the USB2/USB3 PHYs and the two CRG xHCI controllers of the S6 and
enable them on the BL201 board. VBUS of the second port, shared between the
USB2 and the USB3 pins, is switched by GPIOH_8 (open drain).

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Signed-off-by: Piotr Oniszczuk <piotr.oniszczuk@gmail.com>
---
 .../dts/amlogic/amlogic-s6-s905x5-bl201.dts   | 31 ++++++++

diff --git a/arch/arm64/boot/dts/amlogic/amlogic-s6-s905x5-bl201.dts b/arch/arm64/boot/dts/amlogic/amlogic-s6-s905x5-bl201.dts
index 1c3661242..e62a0549a 100644
--- a/arch/arm64/boot/dts/amlogic/amlogic-s6-s905x5-bl201.dts
+++ b/arch/arm64/boot/dts/amlogic/amlogic-s6-s905x5-bl201.dts
@@ -123,6 +123,16 @@ vdd1v8_dcdc_reg: regulator-vdd1v8-dcdc {
 		regulator-always-on;
 	};
 
+	usb_pwr: regulator-usb-pwr {
+		compatible = "regulator-fixed";
+		regulator-name = "USB_PWR";
+		regulator-min-microvolt = <5000000>;
+		regulator-max-microvolt = <5000000>;
+		vin-supply = <&vddao_5v_reg>;
+		gpio = <&gpioh 8 GPIO_OPEN_DRAIN>;
+		enable-active-high;
+	};
+
 	vdd2h_reg: regulator-vdd2h {
 		compatible = "regulator-fixed";
 		regulator-name = "VDD2H";
@@ -347,3 +357,24 @@ &cecb {
 	pinctrl-0 = <&hdmitx_cec_pins>;
 	status = "okay";
 };
+
+&usb2_phy0 {
+	status = "okay";
+};
+
+&usb2_phy1 {
+	phy-supply = <&usb_pwr>;
+	status = "okay";
+};
+
+&usb3_phy {
+	status = "okay";
+};
+
+&usb2_drd {
+	status = "okay";
+};
+
+&usb3_drd {
+	status = "okay";
+};
