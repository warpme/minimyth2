From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Piotr Oniszczuk <piotr.oniszczuk@gmail.com>
Date: Thu, 26 Nov 2026 11:22:38 +0100
Subject: [PATCH 1993/1994] arm64: dts: amlogic: tanix-tx5: add HDMI sound card

Add the sound card of the Tanix TX5 with the HDMI output. The audio
goes from TDM B to the HDMI transmitter through tohdmitx, like in the
vendor device tree (i2s2hdmi on TDM B).

S7 has no MPLL, so the hifi PLL is set to 491.52 MHz (like the vendor
device tree) for the 48 kHz rates and the hifi1 PLL to 451.584 MHz for
the 44.1 kHz rates.

Signed-off-by: Piotr Oniszczuk <piotr.oniszczuk@gmail.com>
---
 .../amlogic/amlogic-s7-s905y5-tanix-tx5.dts   | 50 +++++++++++++++++++
 1 file changed, 50 insertions(+)

diff --git a/arch/arm64/boot/dts/amlogic/amlogic-s7-s905y5-tanix-tx5.dts b/arch/arm64/boot/dts/amlogic/amlogic-s7-s905y5-tanix-tx5.dts
index 578f0e0..a7483bf 100644
--- a/arch/arm64/boot/dts/amlogic/amlogic-s7-s905y5-tanix-tx5.dts
+++ b/arch/arm64/boot/dts/amlogic/amlogic-s7-s905y5-tanix-tx5.dts
@@ -98,6 +98,56 @@
 		vin-supply = <&vddao_3v3>;
 		regulator-always-on;
 	};
+
+	sound {
+		compatible = "amlogic,axg-sound-card";
+		model = "TANIX-TX5";
+		audio-aux-devs = <&tdmout_b>;
+		audio-routing = "TDMOUT_B IN 0", "FRDDR_A OUT 1",
+				"TDMOUT_B IN 1", "FRDDR_B OUT 1",
+				"TDMOUT_B IN 2", "FRDDR_C OUT 1",
+				"TDM_B Playback", "TDMOUT_B OUT";
+		/* hifi_pll for the 48 kHz rates, hifi1_pll for 44.1 kHz */
+		clocks = <&clkc_pll CLKID_HIFI_PLL>,
+			 <&clkc_pll CLKID_HIFI1_PLL>;
+		assigned-clocks = <&clkc_pll CLKID_HIFI_PLL>,
+				  <&clkc_pll CLKID_HIFI1_PLL>;
+		assigned-clock-rates = <491520000>,
+				       <451584000>;
+
+		dai-link-0 {
+			sound-dai = <&frddr_a>;
+		};
+
+		dai-link-1 {
+			sound-dai = <&frddr_b>;
+		};
+
+		dai-link-2 {
+			sound-dai = <&frddr_c>;
+		};
+
+		/* 2ch HDMI interface */
+		dai-link-3 {
+			sound-dai = <&tdmif_b>;
+			dai-format = "i2s";
+			dai-tdm-slot-tx-mask-0 = <1 1>;
+			mclk-fs = <256>;
+
+			codec {
+				sound-dai = <&tohdmitx TOHDMITX_I2S_IN_B>;
+			};
+		};
+
+		/* HDMI transmitter, fed from TDM B by tohdmitx */
+		dai-link-4 {
+			sound-dai = <&tohdmitx TOHDMITX_I2S_OUT>;
+
+			codec {
+				sound-dai = <&hdmi_tx>;
+			};
+		};
+	};
 };
 
 &uart_b {
