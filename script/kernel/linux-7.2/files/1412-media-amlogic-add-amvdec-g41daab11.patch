diff --speed-large-files --no-dereference --minimal -Naur linux-7.2.8/drivers/media/platform/amlogic/amvdec/tools/ohevc_rec_gen.py linux-7.2.8/drivers/media/platform/amlogic/amvdec/tools/ohevc_rec_gen.py
--- linux-7.2.8/drivers/media/platform/amlogic/amvdec/tools/ohevc_rec_gen.py	1970-01-01 01:00:00.000000000 +0100
+++ linux-7.2.8/drivers/media/platform/amlogic/amvdec/tools/ohevc_rec_gen.py	2026-10-02 08:55:53.000000000 +0200
@@ -0,0 +1,308 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-2.0-only
+"""Equivalence check input for the driver's open-HEVC record code (codec_hevc_open_rec.h).
+
+For every picture of an HEVC stream the reference host (hevc_host.HostHEVC, the stand-in whose
+records decode bit-exact on the VIM3) builds its picture record, slice-segment records, scaling
+LUT and stream buffer.  This script also builds the V4L2 stateless controls the way FFmpeg's
+v4l2_request_hevc.c fills them (frame-based, ANNEX_B start codes) - including what FFmpeg
+derives or leaves stale:
+
+  * OUTPUT buffer = 00 00 01 + the NAL unit as FFmpeg's h2645 splitter cuts it (up to the next
+    00 00 01, so trailing zero bytes stay), data_byte_offset = NAL start + sh->data_offset
+    (unescaped header bytes), bit_size = (NAL bytes - data_offset) * 8;
+  * DPB = every picture marked as reference except the current one, in an order unrelated to
+    the RPS (reversed here), poc_st_curr_before/after / poc_lt_curr and ref_idx_l0/l1 as indices
+    into it; no EXT_SPS_ST/LT_RPS controls;
+  * pred_weight_table: deltas of the derived weights, derived luma offsets, the clipped
+    ChromaOffset (7-56), no flags, at most 15 entries per list (FFmpeg's loop bound);
+  * SCALING_MATRIX: the final matrices in raster order (PPS list, else SPS list, else Table 7-5/6);
+  * stale fields: mvd_l1_zero on P, cabac_init / collocated_ref_idx on I, collocated_from_l0
+    without TMVP, beta/tc after an override that disables deblocking; PCM fields when PCM is off
+    (0 - 1 etc.).
+
+The addresses (capture planes, MV buffers, workspace) are the stand-in's Layout with the
+workspace regions moved to the driver's OHEVC_WS_* offsets.
+
+usage: [OHEVC_OUT=fbc|fbc+nv12] [HEVC_LINREF=all|alt] [OHEVC_BITSIZE=segment] ohevc_rec_gen.py OUT.txt OUT.bin stream|fluster-dir|case:NAME [...]
+env HEVC_HOST_DIR (default /home/dev/amrisc-test/fw/hevc)
+"""
+import glob, os, sys
+
+sys.path.insert(0, os.environ.get('HEVC_HOST_DIR', '/home/dev/amrisc-test/fw/hevc'))
+import hevc_bits as HB
+import hevc_host as HH
+
+# driver workspace offsets (codec_hevc_open_rec.h OHEVC_WS_*)
+WS = dict(ipp=0x000000, sao_abv=0x004000, sao_vb=0x044000, dblk_para=0x0c4000, dblk_data=0x104000,
+          dblk_data2=0x184000, mpred_abv=0x204000, mmu_map=0x20c000, lut=0x214000, record=0x215000,
+          slices=0x216000, mmu_vbh=0x261000)
+
+# uapi flags
+SPS_F = dict(separate_colour_plane=1 << 0, scaling_list_enabled=1 << 1, amp=1 << 2, sao=1 << 3,
+             pcm=1 << 4, pcm_loop_filter_disabled=1 << 5, long_term_refs_present=1 << 6,
+             temporal_mvp=1 << 7, strong_intra_smoothing=1 << 8)
+PPS_F = dict(dependent_slices=1 << 0, output_flag_present=1 << 1, sign_data_hiding=1 << 2,
+             cabac_init_present=1 << 3, constrained_intra_pred=1 << 4, transform_skip=1 << 5,
+             cu_qp_delta_enabled=1 << 6, slice_chroma_qp_offsets_present=1 << 7, weighted_pred=1 << 8,
+             weighted_bipred=1 << 9, transquant_bypass=1 << 10, tiles_enabled=1 << 11,
+             entropy_coding_sync=1 << 12, lf_across_tiles=1 << 13, lf_across_slices=1 << 14,
+             dbk_override_enabled=1 << 15, dbk_disabled=1 << 16, lists_modification_present=1 << 17,
+             slice_header_extension_present=1 << 18, dbk_control_present=1 << 19, uniform_spacing=1 << 20)
+SL_SAO_L, SL_SAO_C, SL_TMVP, SL_MVD_L1_ZERO, SL_CABAC_INIT, SL_COL_L0, SL_INT_MV, SL_DBK_DIS, SL_LF, SL_DEP = \
+    (1 << i for i in range(10))
+DPB_LT = 1
+DEC_IRAP, DEC_IDR, DEC_NOOUT = 1, 2, 4
+SOC = HH.SOC['g12b']
+# output mode (hevc_host.HostHEVC out=): '' = NV12 for 8-bit, FBC + NV12 double write for 10-bit
+# (NV12M CAPTURE); 'fbc' = compressed only (AM21C CAPTURE); 'fbc+nv12' = both at every depth
+OUT = os.environ.get('OHEVC_OUT') or None
+# OHEVC_BITSIZE=segment: bit_size as FFmpeg 8 v4l2-request counts it (whole segment + 3-byte start code)
+BITSIZE_SEGMENT = os.environ.get('OHEVC_BITSIZE') == 'segment'
+
+
+def layout(w, h):
+    """hevc_host.Layout placement (addresses only) with the driver's workspace offsets; every
+    slot also has an FBC header and body (ABI v2)."""
+    L = HH.Layout.__new__(HH.Layout)
+    need = HH.out_size(w, h) * 3 // 2 + ((w + 63) & ~63) * ((h + 63) & ~63) // 8
+    L.fbc = True
+    L.head_off = (need + 0xffff) & ~0xffff
+    L.body_off = L.head_off + HH.FBC_HEAD_SIZE
+    need = L.body_off + HH.amfbc_body_size(w, h, True, True)
+    L.slot = (need + 0xfffff) & ~0xfffff
+    L.base, L.nbuf = 0x10000000, 20
+    L.mv_off = HH.out_size(w, h) * 3 // 2
+    ws = L.base + 20 * L.slot
+    L.ws = ws
+    for k, v in WS.items():
+        setattr(L, k, ws + v)
+    L.ws_end = ws + 0x400000
+    L.max_slices = 800
+    return L
+
+
+def raster(coded, n):
+    diag = HB.DIAG4 if n == 4 else HB.DIAG8
+    out = [0] * (len(diag))
+    for i, (x, y) in enumerate(diag):
+        out[y * (4 if n == 4 else 8) + x] = coded[i]
+    return out
+
+
+def matrix(sps, pps):
+    """FFmpeg: pps list if coded, else the SPS list (defaults when not coded)."""
+    sl = pps['scaling_list'] if pps['scaling_list'] is not None else sps['scaling_list']
+    res = HB.resolve_scaling(sl)
+    v = []
+    for m in range(6):
+        v += raster(res[(0, m)][0], 4)
+    for m in range(6):
+        v += raster(res[(1, m)][0], 8)
+    for m in range(6):
+        v += raster(res[(2, m)][0], 8)
+    for m in (0, 3):
+        v += raster(res[(3, m)][0], 8)
+    v += [res[(2, m)][1] for m in range(6)]
+    v += [res[(3, m)][1] for m in (0, 3)]
+    return v
+
+
+def clip(lo, hi, v):
+    return max(lo, min(hi, v))
+
+
+def main():
+    out_txt, out_bin, streams = sys.argv[1], sys.argv[2], sys.argv[3:]
+    txt = open(out_txt, 'w')
+    binf = open(out_bin, 'wb')
+    for path in streams:
+        if os.path.isdir(path):                 # a fluster vector directory (hevc_cases.fluster())
+            fs = sorted(glob.glob(os.path.join(path, '*.bit')) + glob.glob(os.path.join(path, '*.bin')) +
+                        glob.glob(os.path.join(path, '*', '*.bit')) + glob.glob(os.path.join(path, '*', '*.bin')))
+            fs = [f for f in fs if not f.endswith('.md5') and 'yuv' not in f.lower()]
+            if not fs:
+                print(f'# skip {path}: no stream', file=sys.stderr)
+                continue
+            path = fs[0]
+        if path.startswith('case:'):            # a synthetic hevc_cases.py stream (real headers)
+            import hevc_cases
+            data = hevc_cases.load(path[5:])
+            name = path
+        elif not os.path.exists(path):
+            print(f"# skip {path}: missing", file=sys.stderr)
+            continue
+        else:
+            data = open(path, "rb").read()
+            name = os.path.splitext(os.path.basename(path))[0]
+        maxw = maxh = 0
+        try:
+            for n in HB.nal_units(data):
+                if n['type'] == HB.NAL_SPS and n['layer'] == 0:
+                    s = HB.parse_sps(n['rbsp'])
+                    maxw, maxh = max(maxw, s['width']), max(maxh, s['height'])
