+        ff = dict(mvd=0, cabac=0, col_l0=0, col_idx=0, beta=0, tc=0, sm=[0] * (6 * 16 + 14 * 64 + 8))
+        ts_of = {}                  # id(picture entry) -> capture timestamp
+        tsn = 0
+        txt.write(f'S {name}\n')
