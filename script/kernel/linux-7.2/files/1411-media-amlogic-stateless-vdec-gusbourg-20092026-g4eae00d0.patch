+		codec_h264_uses_multi_blob() && codec_h264_multi_direct_vld();
+	struct vb2_v4l2_buffer *dst = NULL;
+	u32 plane;
+
+	if (direct) {
+		WRITE_ONCE(sess->m2m_run_armed, false);
+		dst = v4l2_m2m_dst_buf_remove(sess->m2m_ctx);
+		codec_h264_multi_discard_capture(sess, dst ? dst->vb2_buf.index : U32_MAX);
