diff --speed-large-files --no-dereference --minimal -Naur linux-7.2.8/arch/arm64/boot/dts/amlogic/meson-sm1-x96-air.dts linux-7.2.8/arch/arm64/boot/dts/amlogic/meson-sm1-x96-air.dts
--- linux-7.2.8/arch/arm64/boot/dts/amlogic/meson-sm1-x96-air.dts	2026-09-26 17:57:40.789357391 +0200
+++ linux-7.2.8/arch/arm64/boot/dts/amlogic/meson-sm1-x96-air.dts	2026-09-26 17:57:17.368433809 +0200
@@ -69,6 +69,18 @@
 			};
 		};
 	};
+
+	openvfd {
+		compatible = "open,vfd";
+		dev_name = "openvfd";
+		openvfd_gpio_clk = <&gpio GPIOA_15 GPIO_ACTIVE_HIGH>;
+		openvfd_gpio_dat = <&gpio GPIOA_14 GPIO_ACTIVE_HIGH>;
+		openvfd_gpio_stb = <&gpio_ao GPIOAO_10 GPIO_ACTIVE_LOW>;
+		openvfd_chars = [04 00 01 02 03];
+		openvfd_dot_bits = [00 01 02 03 04 05 06];
+		openvfd_display_type = <0x02000100>;
+		status = "okay";
+	};
 };
 
