From 5a093cd4aeb6f4bf1dac7d9c149d043c311c3d40 Mon Sep 17 00:00:00 2001
From: Jernej Skrabec <jernej.skrabec@gmail.com>
Date: Fri, 22 May 2026 16:51:14 +0000
Subject: [PATCH 2725/2728] drm/sun4i: Add A523 dw-hdmi compatible

A523/A527/T527 reuses the Synopsys DesignWare HDMI controller. Add a
new compatible with quirks matching H6 (mode_valid up to 594 MHz,
DRM-style infoframe support). Additionally, A523 mode_valid rejects
modes whose TMDS rate can't be generated by the Innosilicon PHY.

H6 / H616 quirks are not changed.

Signed-off-by: Jernej Skrabec <jernej.skrabec@gmail.com>
---
 drivers/gpu/drm/sun4i/sun8i_dw_hdmi.c | 24 ++++++++++++++++++++++++
 1 file changed, 24 insertions(+)

diff --git a/drivers/gpu/drm/sun4i/sun8i_dw_hdmi.c b/drivers/gpu/drm/sun4i/sun8i_dw_hdmi.c
index 9abd8de..7610e27 100644
--- a/drivers/gpu/drm/sun4i/sun8i_dw_hdmi.c
+++ b/drivers/gpu/drm/sun4i/sun8i_dw_hdmi.c
@@ -59,6 +59,21 @@ sun8i_dw_hdmi_mode_valid_h6(struct dw_hdmi *hdmi, void *data,
 	return MODE_OK;
 }
 
+static enum drm_mode_status
+sun8i_dw_hdmi_mode_valid_a523(struct dw_hdmi *hdmi, void *data,
+			      const struct drm_display_info *info,
+			      const struct drm_display_mode *mode)
+{
+	enum drm_mode_status status;
+
+	status = sun8i_dw_hdmi_mode_valid_h6(hdmi, data, info, mode);
+	if (status != MODE_OK)
+		return status;
+
+	/* PHY PLL supports only rates from its table */
+	return sun55i_hdmi_phy_mode_valid(mode);
+}
+
 static bool sun8i_dw_hdmi_node_is_tcon_top(struct device_node *node)
 {
 	return IS_ENABLED(CONFIG_DRM_SUN8I_TCON_TOP) &&
@@ -302,6 +317,11 @@ static const struct sun8i_dw_hdmi_quirks sun50i_h6_quirks = {
 	.use_drm_infoframe = true,
 };
 
+static const struct sun8i_dw_hdmi_quirks sun55i_a523_quirks = {
+	.mode_valid = sun8i_dw_hdmi_mode_valid_a523,
+	.use_drm_infoframe = true,
+};
+
 static const struct of_device_id sun8i_dw_hdmi_dt_ids[] = {
 	{
 		.compatible = "allwinner,sun8i-a83t-dw-hdmi",
@@ -311,6 +331,10 @@ static const struct of_device_id sun8i_dw_hdmi_dt_ids[] = {
 		.compatible = "allwinner,sun50i-h6-dw-hdmi",
 		.data = &sun50i_h6_quirks,
 	},
+	{
+		.compatible = "allwinner,sun55i-a523-dw-hdmi",
+		.data = &sun55i_a523_quirks,
+	},
 	{ /* sentinel */ },
 };
 MODULE_DEVICE_TABLE(of, sun8i_dw_hdmi_dt_ids);
-- 
