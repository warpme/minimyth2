+# SPDX-License-Identifier: GPL-2.0
+# Makefile for the Amlogic meson-amvdec video decoder driver (openucode)
+
+meson-amvdec-objs = esparser.o amvdec.o amvdec_helpers.o amvdec_platform.o
+meson-amvdec-objs += amvdec_1.o amvdec_hevc.o
+meson-amvdec-objs += codec_mpeg12.o
+meson-amvdec-objs += codec_h264.o codec_hevc_common.o codec_vp9.o codec_hevc.o
+
+# In tree: CONFIG_VIDEO_MESON_AMVDEC.  Out of tree (make -C <kernel> M=$PWD):
+# always built as a module.
+ifeq ($(CONFIG_VIDEO_MESON_AMVDEC),)
+obj-m += meson-amvdec.o
+else
+obj-$(CONFIG_VIDEO_MESON_AMVDEC) += meson-amvdec.o
+endif
+
+# Kernels built without CONFIG_V4L2_H264 (Armbian on the Odroid-C2): carry the
+# reference-list builder ourselves.  make ... BUNDLE_H264=1
+ifeq ($(BUNDLE_H264),1)
+meson-amvdec-objs += v4l2-h264.o
+endif
+
+# Development build (make ... OUCODE_DEV=1): the amrisc-test debugfs harness,
+# the *_bench / *_prof / hevc_open_debug / hevc_prof_pc / hevc_dbg diagnostic
+# parameters and the forced linear-reference test bits.  Off by default: the
+# default build is what testers get.
+ifeq ($(OUCODE_DEV),1)
+meson-amvdec-objs += amrisc_test.o
+ccflags-y += -DAMVDEC_OUCODE_DEV
