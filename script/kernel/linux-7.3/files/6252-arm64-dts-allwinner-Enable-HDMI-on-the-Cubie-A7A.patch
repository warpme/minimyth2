From c5933e178b7a893ed3b4a8c8de88b481660b1c4e Mon Sep 17 00:00:00 2001
From: Jernej Skrabec <jernej.skrabec@gmail.com>
Date: Sat, 5 Sep 2026 00:43:24 +0200
Subject: [PATCH 187/211] arm64: dts: allwinner: Enable HDMI on the Cubie A7A

The board brings the HDMI signals out to a type A connector, and its
1.8 V supply comes from CLDO2.

Signed-off-by: Jernej Skrabec <jernej.skrabec@gmail.com>
---
 .../dts/allwinner/sun60i-a733-cubie-a7a.dts   | 22 +++++++++++++++++++
 1 file changed, 22 insertions(+)

diff --git a/arch/arm64/boot/dts/allwinner/sun60i-a733-cubie-a7a.dts b/arch/arm64/boot/dts/allwinner/sun60i-a733-cubie-a7a.dts
index 74eb3f5d90..7751b544c3 100644
--- a/arch/arm64/boot/dts/allwinner/sun60i-a733-cubie-a7a.dts
+++ b/arch/arm64/boot/dts/allwinner/sun60i-a733-cubie-a7a.dts
@@ -25,6 +25,17 @@ chosen {
 		stdout-path = "serial0:115200n8";
 	};
 
+	hdmi_connector: hdmi-connector {
+		compatible = "hdmi-connector";
+		type = "a";
+
+		port {
+			hdmi_con_in: endpoint {
+				remote-endpoint = <&hdmi_out_con>;
+			};
+		};
+	};
+
 	ext_osc32k: ext-osc32k-clk {
 		#clock-cells = <0>;
 		compatible = "fixed-clock";
@@ -594,3 +605,14 @@ &uart0 {
 &de {
 	status = "okay";
 };
+
+&hdmi {
+	hvcc-supply = <&reg_cldo2>;
+	status = "okay";
+};
+
+&hdmi_out {
+	hdmi_out_con: endpoint {
+		remote-endpoint = <&hdmi_con_in>;
+	};
+};
-- 
