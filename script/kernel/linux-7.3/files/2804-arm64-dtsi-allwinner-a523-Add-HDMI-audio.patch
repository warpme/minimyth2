Patch from MiniMyth2 project

Developed-by: Piotr Oniszczuk <piotr.oniszczuk@gmail.com>
Signed-off-by: Piotr Oniszczuk <piotr.oniszczuk@gmail.com>


arm64: dts: allwinner: a523: Add HDMI audio (I2S2 -> DW HDMI)

diff --git linux-7.3.6/arch/arm64/boot/dts/allwinner/sun55i-a523.dtsi linux-7.3.6/arch/arm64/boot/dts/allwinner/sun55i-a523.dtsi
index 3576f0a..1fd49e8 100644
--- linux-7.3.6/arch/arm64/boot/dts/allwinner/sun55i-a523.dtsi
+++ linux-7.3.6/arch/arm64/boot/dts/allwinner/sun55i-a523.dtsi
@@ -93,6 +93,31 @@
 		interrupts = <GIC_PPI 7 IRQ_TYPE_LEVEL_HIGH>;
 	};
 
+	/*
+	 * HDMI audio: I2S2 is internally wired to the DW HDMI I2S input
+	 * (no external pins). Up to 8 channels on 4 data lines, 2 x 32 bit
+	 * slots per line, CPU is bit/frame clock provider.
+	 */
+	sound_hdmi: sound-hdmi {
+		compatible = "simple-audio-card";
+		simple-audio-card,name = "allwinner-hdmi";
+		simple-audio-card,format = "i2s";
+		simple-audio-card,mclk-fs = <128>;
+		simple-audio-card,bitclock-master = <&sound_hdmi_cpu>;
+		simple-audio-card,frame-master = <&sound_hdmi_cpu>;
+		status = "disabled";
+
+		simple-audio-card,codec {
+			sound-dai = <&hdmi>;
+		};
+
+		sound_hdmi_cpu: simple-audio-card,cpu {
+			sound-dai = <&i2s2>;
+			dai-tdm-slot-num = <2>;
+			dai-tdm-slot-width = <32>;
+		};
+	};
+
 	psci {
 		compatible = "arm,psci-0.2";
 		method = "smc";
@@ -1346,6 +1371,7 @@
 			compatible = "allwinner,sun55i-a523-dw-hdmi";
 			reg = <0x5520000 0x10000>;
 			reg-io-width = <1>;
+			#sound-dai-cells = <0>;
 			interrupts = <GIC_SPI 93 IRQ_TYPE_LEVEL_HIGH>;
 			/*
 			 * A523 CCU has no TMDS clock, TMDS is generated by the
