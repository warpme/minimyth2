+EXPORT_SYMBOL_GPL(amvdec_dma_guards_enabled);
+
+static void amvdec_dma_fill_guards(const struct amvdec_dma_guard *guard)
+{
+	if (!guard->raw_vaddr || !guard->raw_size)
+		return;
+	memset(guard->raw_vaddr, DMA_GUARD_PATTERN, PAGE_SIZE);
+	memset((u8 *)guard->raw_vaddr + PAGE_SIZE + guard->size,
+	       DMA_GUARD_PATTERN, PAGE_SIZE);
+}
+
+void *amvdec_dma_alloc_guarded(struct device *dev, size_t size,
+				       dma_addr_t *dma_handle, gfp_t gfp,
+				       struct amvdec_dma_guard *guard)
+{
+	void *raw;
+	dma_addr_t raw_dma;
+	size_t aligned = PAGE_ALIGN(size);
+	size_t raw_size;
+
+	memset(guard, 0, sizeof(*guard));
+	if (!amvdec_dma_guards_enabled()) {
+		raw = dma_alloc_coherent(dev, size, dma_handle, gfp);
+		if (raw) {
+			guard->raw_vaddr = raw;
+			guard->raw_paddr = *dma_handle;
+			guard->raw_size = size;
+			guard->size = size;
+		}
+		return raw;
+	}
+
+	raw_size = PAGE_SIZE + aligned + PAGE_SIZE;
+	raw = dma_alloc_coherent(dev, raw_size, &raw_dma, gfp);
+	if (!raw)
+		return NULL;
+
+	guard->raw_vaddr = raw;
+	guard->raw_paddr = raw_dma;
+	guard->raw_size = raw_size;
+	guard->size = aligned;
+	*dma_handle = raw_dma + PAGE_SIZE;
+	amvdec_dma_fill_guards(guard);
+
+	return (u8 *)raw + PAGE_SIZE;
+}
+EXPORT_SYMBOL_GPL(amvdec_dma_alloc_guarded);
+
+void amvdec_dma_free_guarded(struct device *dev, dma_addr_t visible_paddr,
+				     struct amvdec_dma_guard *guard)
+{
+	if (!guard->raw_vaddr)
+		return;
+
+	dma_free_coherent(dev, guard->raw_size, guard->raw_vaddr,
+			  guard->raw_paddr ? guard->raw_paddr : visible_paddr);
+	memset(guard, 0, sizeof(*guard));
