From 3f5e4661d695484d2d6f2764f2021c038d87a956 Mon Sep 17 00:00:00 2001
From: Piotr Oniszczuk <piotr.oniszczuk@gmail.com>
Date: Fri, 20 Nov 2026 10:48:12 +0000
Subject: [PATCH 09/12] configs: khadas-vim4: enable MMC, Ethernet, pinctrl and
 network boot

Enable the T7 pinctrl, the MMC controller, the dwc_eth_qos MAC with the
Amlogic glue and the Realtek PHY, the secure power domains and the
GPIO/fixed regulators on the Khadas VIM4, plus the clk, gpio, mmc and
mii commands. Enable MISC_INIT_R so the board generates a stable MAC
address from the SoC serial number.

Also enable lwIP networking with wget (including HTTPS) and PXE over
HTTP, drop the EFI loader and boot by default from a network boot script.
Enable MbedTLS and the hardware RNG (plus the rng command) so that wget
can use HTTPS.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: Piotr Oniszczuk <piotr.oniszczuk@gmail.com>
---
 configs/khadas-vim4_defconfig | 57 +++++++++++++++++++++++++++++++++++
 1 file changed, 57 insertions(+)
 create mode 100644 configs/khadas-vim4_defconfig

diff --git a/configs/khadas-vim4_defconfig b/configs/khadas-vim4_defconfig
new file mode 100644
index 0000000..3a69bb8
--- /dev/null
+++ b/configs/khadas-vim4_defconfig
@@ -0,0 +1,57 @@
+CONFIG_ARM=y
+CONFIG_POSITION_INDEPENDENT=y
+CONFIG_ARCH_MESON=y
+CONFIG_TEXT_BASE=0x00000000
+CONFIG_NR_DRAM_BANKS=1
+CONFIG_ENV_SIZE=0x2000
+CONFIG_DM_GPIO=y
+CONFIG_DEFAULT_DEVICE_TREE="amlogic/amlogic-t7-a311d2-khadas-vim4"
+CONFIG_OF_LIBFDT_OVERLAY=y
+CONFIG_MESON_T7=y
+CONFIG_SYS_LOAD_ADDR=0x10000000
+CONFIG_DEBUG_UART_BASE=0xfe078000
+CONFIG_DEBUG_UART_CLOCK=24000000
+CONFIG_IDENT_STRING=" khadas-vim4"
+CONFIG_DEBUG_UART=y
+CONFIG_OF_BOARD_SETUP=y
+# CONFIG_DISPLAY_CPUINFO is not set
+# CONFIG_DISPLAY_BOARDINFO is not set
+CONFIG_MISC_INIT_R=y
+# CONFIG_CMD_BDI is not set
+# CONFIG_CMD_IMI is not set
+CONFIG_CMD_CLK=y
+CONFIG_CMD_GPIO=y
+CONFIG_CMD_MMC=y
+CONFIG_CMD_CACHE=y
+CONFIG_OF_CONTROL=y
+CONFIG_MMC_MESON_GX=y
+CONFIG_DWC_ETH_QOS=y
+CONFIG_DWC_ETH_QOS_MESON=y
+CONFIG_PHY_REALTEK=y
+CONFIG_PINCTRL=y
+CONFIG_PINCTRL_MESON_T7=y
+CONFIG_POWER_DOMAIN=y
+CONFIG_MESON_SECURE_POWER_DOMAIN=y
+CONFIG_DM_REGULATOR=y
+CONFIG_DM_REGULATOR_FIXED=y
+CONFIG_DM_REGULATOR_GPIO=y
+CONFIG_BAUDRATE=921600
+CONFIG_DEBUG_UART_ANNOUNCE=y
+CONFIG_DEBUG_UART_SKIP_INIT=y
+CONFIG_MESON_SERIAL=y
+CONFIG_CMD_WGET=y
+CONFIG_LIB_RAND=y
+CONFIG_PROT_TCP=y
+CONFIG_EFI_LOADER=n
+CONFIG_BOOTMETH_EFI=n
+CONFIG_BOOTMETH_PXE=y
+CONFIG_BOOTMETH_SCRIPT=y
+CONFIG_NET_LWIP=y
+CONFIG_CMD_WGET_LWIP=y
+CONFIG_BOOTCOMMAND="if dhcp ${scriptaddr} /PXEclient/pxelinux.cfg/amlogic-t7-a311d2-khadas-vim4.scr; then source ${scriptaddr}; fi; run distro_bootcmd"
+CONFIG_WGET_HTTPS=y
+CONFIG_PXE_HTTP=y
+CONFIG_DM_RNG=y
+CONFIG_RNG_MESON=y
+CONFIG_MBEDTLS_LIB=y
+CONFIG_CMD_RNG=y
-- 
