+	[CLKID_MCLK0]		= &s6_mclk0.hw,
+	[CLKID_FCLK50M_DIV]	= &s6_fclk50m_div.hw,
+	[CLKID_FCLK50M]		= &s6_fclk50m.hw,
+	[CLKID_FCLK_DIV2_DIV]	= &s6_fclk_div2_div.hw,
+	[CLKID_FCLK_DIV2]	= &s6_fclk_div2.hw,
+	[CLKID_FCLK_DIV2P5_DIV]	= &s6_fclk_div2p5_div.hw,
