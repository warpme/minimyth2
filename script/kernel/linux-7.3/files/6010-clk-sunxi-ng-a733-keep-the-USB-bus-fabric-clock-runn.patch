From d270f745dea4c93577f33c6030c9819beb858bf8 Mon Sep 17 00:00:00 2001
From: Jernej Skrabec <jernej.skrabec@gmail.com>
Date: Wed, 2 Sep 2026 22:12:07 +0200
Subject: [PATCH 046/211] clk: sunxi-ng: a733: keep the USB bus fabric clock
 running

The "ahb-usb-sys" gate feeds the bus fabric in front of the USB2.0 host
and OTG controllers. No device node can reference it, so mark it
critical like the other fabric gates instead of letting
clk_disable_unused() take the controllers off the bus.

Signed-off-by: Jernej Skrabec <jernej.skrabec@gmail.com>
---
 drivers/clk/sunxi-ng/ccu-sun60i-a733.c | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/drivers/clk/sunxi-ng/ccu-sun60i-a733.c b/drivers/clk/sunxi-ng/ccu-sun60i-a733.c
index 747aff4fe8..a5bd51b152 100644
--- a/drivers/clk/sunxi-ng/ccu-sun60i-a733.c
+++ b/drivers/clk/sunxi-ng/ccu-sun60i-a733.c
@@ -511,8 +511,9 @@ static SUNXI_CCU_GATE_HWS(ahb_gpu0_clk, "ahb-gpu0", ahb_hws,
 			  0x5c0, BIT(7), 0);
 static SUNXI_CCU_GATE_HWS(ahb_serdes_clk, "ahb-serdes", ahb_hws,
 			  0x5c0, BIT(8), 0);
+/* Bus fabric in front of the USB controllers, nothing references it. */
 static SUNXI_CCU_GATE_HWS(ahb_usb_sys_clk, "ahb-usb-sys", ahb_hws,
-			  0x5c0, BIT(9), 0);
+			  0x5c0, BIT(9), CLK_IS_CRITICAL);
 static SUNXI_CCU_GATE_HWS(ahb_msi_lite0_clk, "ahb-msi-lite0", ahb_hws,
 			  0x5c0, BIT(16), CLK_IS_CRITICAL);
 static SUNXI_CCU_GATE_HWS(ahb_store_clk, "ahb-store", ahb_hws,
