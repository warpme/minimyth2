Developed-by: Piotr Oniszczuk <piotr.oniszczuk@gmail.com>
Signed-off-by: Piotr Oniszczuk <piotr.oniszczuk@gmail.com>



From 28dc9c794256d5f453a25f979d1651693a464574 Mon Sep 17 00:00:00 2001
From: Piotr Oniszczuk <piotr.oniszczuk@gmail.com>
Date: Sun, 22 Nov 2026 13:10:59 +0100
Subject: [PATCH] arm64: dts: rockchip: rk3528-rock-2a: Enable HDMI output

Enable the VOP, the HDMI TX controller and the HDMI PHY on the Radxa
ROCK 2A and add the HDMI type A connector.

DCLK_VOP0 is fed by the HDMI PHY pixel clock (clk_hdmiphy_pixel_io), so
that any pixel clock supported by the PHY pre-PLL can be used.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../boot/dts/rockchip/rk3528-rock-2a.dts      | 47 +++++++++++++++++++
 1 file changed, 47 insertions(+)

diff --git a/arch/arm64/boot/dts/rockchip/rk3528-rock-2a.dts b/arch/arm64/boot/dts/rockchip/rk3528-rock-2a.dts
index 5e17ec2..e3ed825 100644
--- a/arch/arm64/boot/dts/rockchip/rk3528-rock-2a.dts
+++ b/arch/arm64/boot/dts/rockchip/rk3528-rock-2a.dts
@@ -2,6 +2,7 @@
 
 /dts-v1/;
 
+#include <dt-bindings/soc/rockchip,vop2.h>
 #include "rk3528-rock-2.dtsi"
 
 / {
@@ -12,6 +13,17 @@
 		ethernet0 = &gmac1;
 	};
 
+	hdmi-con {
+		compatible = "hdmi-connector";
+		type = "a";
+
+		port {
+			hdmi_con_in: endpoint {
+				remote-endpoint = <&hdmi_out_con>;
+			};
+		};
+	};
+
 	vcc5v0_usb30_otg: regulator-5v0-vcc-usb30-otg {
 		compatible = "regulator-fixed";
 		enable-active-high;
@@ -36,6 +48,28 @@
 	status = "okay";
 };
 
+&hdmi {
+	avdd-0v9-supply = <&vdd_0v9>;
+	avdd-1v8-supply = <&vcc_1v8>;
+	status = "okay";
+};
+
+&hdmi_in {
+	hdmi_in_vp0: endpoint {
+		remote-endpoint = <&vp0_out_hdmi>;
+	};
+};
+
+&hdmi_out {
+	hdmi_out_con: endpoint {
+		remote-endpoint = <&hdmi_con_in>;
+	};
+};
+
+&hdmiphy {
+	status = "okay";
+};
+
 &leds {
 	pinctrl-names = "default";
 	pinctrl-0 = <&state_led_b>, <&sys_led_g>;
@@ -90,3 +124,16 @@
 	phy-supply = <&vcc5v0_usb30_otg>;
 	status = "okay";
 };
+
+&vop {
+	assigned-clocks = <&cru DCLK_VOP0>;
+	assigned-clock-parents = <&hdmiphy>;
+	status = "okay";
+};
+
+&vp0 {
+	vp0_out_hdmi: endpoint@ROCKCHIP_VOP2_EP_HDMI0 {
+		reg = <ROCKCHIP_VOP2_EP_HDMI0>;
+		remote-endpoint = <&hdmi_in_vp0>;
+	};
+};
