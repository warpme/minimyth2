+    avctx->color_trc       = trc;
+    avctx->colorspace      = colorspace;
+    avctx->color_range     = range;
+
+    frame->color_primaries = primaries;
+    frame->color_trc       = trc;
+    frame->colorspace      = colorspace;
+    frame->color_range     = range;
