DEFAULT MiniMyth2
MENU TITLE Boot Menu
PROMPT 0
TIMEOUT 0

LABEL MiniMyth2
  LINUX /mm2-nfs-networkboot-latest/boot/Image
  FDT   /mm2-nfs-networkboot-latest/boot/dtbs/amlogic/meson-s4-s905y4-khadas-vim1s.dtb

  # to overwrite edid add: drm.edid_firmware=edid/s2-tek.bin
  # to force hdmi instead of dvi add: video=HDMI-A-1:e

  # mount nfsroot with DHCP
  APPEND root=/dev/nfs nfsroot=192.168.1.254:/var/tftpboot/PXEclient/mm2-nfs-networkboot-latest/rootfs,v3 ip=dhcp earlycon=meson,0xfe07a000 console=ttyS0,921600n8 no_console_suspend consoleblank=0 8250.nr_uarts=0 cma=384M debug

