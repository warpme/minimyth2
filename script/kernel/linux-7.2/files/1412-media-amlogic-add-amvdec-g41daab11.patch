@@ -0,0 +1,124 @@
+; T10b - VIFIFO + VLD start-code search with the VLD interrupt routed to vector 2.
+; arg0 = buf paddr (FIFO buf[0..0x8000)), arg1 = payload bytes.
+; ISR (vector 2, r7 latched from VLD_STATUS_CTRL in the vector slot):
+;   S0 = r7, S1 = ISR count, S2 = start code byte, S3 = horizontal_size, S4 = vertical_size,
+;   S5 = aspect|frame_rate<<8, S6 = bit_rate[17:2], S7 = MSP in ISR
+; Main loop samples every 0x10000 iterations: S8 = VLD_STATUS_CTRL, S9 = VIFIFO LEVEL,
+;   SA = RP, SB = BYTES_AVAIL, SC = VIFF_BIT_CNT, SD = CURR_PTR, SE = loop count, SF = 0xdd at end
+.org 0x0
+    jmp start
+    nop
+.org 0x20
+    ret
+    ei
+    ret
+    ei
+    jmp isr2
+    mfsp r7, VLD_STATUS_CTRL
+    ret
+    ei
+    ret
+    ei
+    ret
+    ei
+    ret
+    ei
+    ret
+    ei
+    ret
+    ei
+.org 0x40
+start:
+    movi r0, #0xffff
+    mtsp MCPU_INTR_MSK, r0
+    movi r22, #0
+    movi r23, #0
+    movi r24, #0
+    movhi r24, #0x1
+    mfsp r10, AV_SCRATCH_K
+    mfsp r11, AV_SCRATCH_L
+    ; driver order: FIFO control off, pulse VLD resets, VLD power
+    mtspi VLD_MEM_VIFIFO_CONTROL, #0
+    movi r1, #0x38
+    mtsp DOS_SW_RESET0, r1
+    mtspi DOS_SW_RESET0, #0
+    mtspi POWER_CTL_VLD, #0x10
+    mtsp VLD_MEM_VIFIFO_START_PTR, r10
+    movi r12, #0x7ff8
+    add r13, r10, r12
+    mtsp VLD_MEM_VIFIFO_END_PTR, r13
+    mtsp VLD_MEM_VIFIFO_CURR_PTR, r10
+    mtspi VLD_MEM_VIFIFO_CONTROL, #1
+    mtspi VLD_MEM_VIFIFO_CONTROL, #0
+    mtspi VLD_MEM_VIFIFO_BUF_CNTL, #2
+    mtsp VLD_MEM_VIFIFO_RP, r10
+    addi r14, r11, #0x47
+    shri r14, r14, #3
+    shli r14, r14, #3
+    add r14, r14, r10
+    mtsp VLD_MEM_VIFIFO_WP, r14
+    mtspi VLD_MEM_VIFIFO_BUF_CNTL, #3
+    mtspi VLD_MEM_VIFIFO_BUF_CNTL, #2
+    movi r15, #0x0438
+    movhi r15, #0x11
+    mtsp VLD_MEM_VIFIFO_CONTROL, r15
+    shli r16, r11, #3
+    mtsp VIFF_BIT_CNT, r16
+    ; vendor init bits
+    mfsp r17, VLD_STATUS_CTRL
+    bclr r17, r17, 6
+    bset r17, r17, 8
+    mtsp VLD_STATUS_CTRL, r17
+    mtspi M4_CONTROL_REG, #0
+    movi r0, #0xfffb
+    mtsp MCPU_INTR_MSK, r0
+    ei
+    mtspi VLD_STATUS_CTRL, #2
+    movi r20, #0
+    movi r21, #0
+main:
+    addi r20, r20, #1
+    addi r21, r21, #1
+    bne r21, r24, main
+    nop
+    movi r21, #0
+    mfsp r8, VLD_STATUS_CTRL
+    mtsp AV_SCRATCH_8, r8
+    mfsp r8, VLD_MEM_VIFIFO_LEVEL
+    mtsp AV_SCRATCH_9, r8
+    mfsp r8, VLD_MEM_VIFIFO_RP
+    mtsp AV_SCRATCH_A, r8
+    mfsp r8, VLD_MEM_VIFIFO_BYTES_AVAIL
+    mtsp AV_SCRATCH_B, r8
+    mfsp r8, VIFF_BIT_CNT
+    mtsp AV_SCRATCH_C, r8
+    mfsp r8, VLD_MEM_VIFIFO_CURR_PTR
+    mtsp AV_SCRATCH_D, r8
+    mtsp AV_SCRATCH_E, r20
+    mtspi AV_SCRATCH_F, #0xdd
+    jmp main
+    nop
+isr2:
+    mtsp AV_SCRATCH_0, r7
+    addi r22, r22, #1
+    mtsp AV_SCRATCH_1, r22
+    mfsp r9, MSP
+    mtsp AV_SCRATCH_7, r9
+    bne r22, #1, isr_done
+    nop
+    getbits r8, 8
+    mtsp AV_SCRATCH_2, r8
+    getbits r8, 12
+    mtsp AV_SCRATCH_3, r8
+    getbits r8, 12
+    mtsp AV_SCRATCH_4, r8
+    getbits r8, 4
+    getbits r9, 4
+    shli r9, r9, #8
+    or r8, r8, r9
+    mtsp AV_SCRATCH_5, r8
+    getbits r8, 16
+    mtsp AV_SCRATCH_6, r8
+isr_done:
+    ret
+    ei
