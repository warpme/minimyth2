+static ssize_t at_reglist_parse(const char __user *ubuf, size_t count,
+				u32 *list, unsigned int *nlist, u32 limit)
+{
+	char *text, *p, *tok;
+	unsigned int n = 0;
+	int ret = 0;
+
+	if (count > 16384)
+		return -EINVAL;
+	text = memdup_user_nul(ubuf, count);
+	if (IS_ERR(text))
+		return PTR_ERR(text);
+
+	mutex_lock(&at_lock);
+	p = text;
+	while ((tok = strsep(&p, " \t\n\r,")) != NULL) {
+		u32 v;
+
+		if (!*tok)
+			continue;
+		if (n >= AT_MAX_REGS || kstrtou32(tok, 16, &v) || v >= limit) {
+			ret = -EINVAL;
+			break;
+		}
+		list[n++] = v;
+	}
+	if (!ret)
+		*nlist = n;
+	mutex_unlock(&at_lock);
+	kfree(text);
+	return ret ? ret : count;
+}
+
+/* VDEC_1 side: CBUS indices below the HEVC block (0x3000 = dos 0xc000) */
+static ssize_t at_reglist_write(struct file *file, const char __user *ubuf,
+				size_t count, loff_t *ppos)
+{
+	return at_reglist_parse(ubuf, count, at_reglist, &at_nregs, 0x3000);
+}
+
+/* HEVC side: HEVC-core local indices 0..0xfff (dos byte 0xc000 + 4 * index) */
+static ssize_t ah_reglist_write(struct file *file, const char __user *ubuf,
+				size_t count, loff_t *ppos)
+{
+	return at_reglist_parse(ubuf, count, ah_reglist, &ah_nregs, AH_LOCAL_MAX);
+}
+
+/* hevc_prog: "idx value [mask]" lines, hex; '#' starts a comment line */
+static ssize_t ah_prog_write(struct file *file, const char __user *ubuf,
+			     size_t count, loff_t *ppos)
+{
+	char *text, *p, *line;
+	unsigned int n = 0;
+	int ret = 0;
+
+	if (count > 64 * 1024)
+		return -EINVAL;
+	text = memdup_user_nul(ubuf, count);
+	if (IS_ERR(text))
+		return PTR_ERR(text);
+
+	mutex_lock(&at_lock);
+	p = text;
+	while ((line = strsep(&p, "\n")) != NULL) {
+		u32 idx, val, mask = 0;
+		int k;
+
+		line = skip_spaces(line);
+		if (!*line || *line == '#')
+			continue;
+		k = sscanf(line, "%x %x %x", &idx, &val, &mask);
+		if (k < 2 || idx >= AH_LOCAL_MAX || n >= AH_PROG_MAX) {
+			ret = -EINVAL;
+			break;
+		}
+		ah_prog[n][0] = idx;
+		ah_prog[n][1] = val;
+		ah_prog[n][2] = k == 3 ? mask : 0;
+		n++;
+	}
+	ah_nprog = ret ? 0 : n;
+	mutex_unlock(&at_lock);
+	kfree(text);
+	return ret ? ret : count;
+}
+
+static const struct file_operations ah_prog_fops = {
+	.owner = THIS_MODULE,
+	.open = simple_open,
+	.write = ah_prog_write,
