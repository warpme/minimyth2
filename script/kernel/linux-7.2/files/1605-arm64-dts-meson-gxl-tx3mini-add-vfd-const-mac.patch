diff --speed-large-files --no-dereference --minimal -Naur linux-7.2.7/arch/arm64/boot/dts/amlogic/meson-gxl-s905w-tx3-mini.dts linux-7.2.7/arch/arm64/boot/dts/amlogic/meson-gxl-s905w-tx3-mini.dts
--- linux-7.2.7/arch/arm64/boot/dts/amlogic/meson-gxl-s905w-tx3-mini.dts	2026-09-21 15:09:00.000000000 +0200
+++ linux-7.2.7/arch/arm64/boot/dts/amlogic/meson-gxl-s905w-tx3-mini.dts	2026-09-26 17:46:17.759292902 +0200
@@ -19,6 +19,18 @@
 		device_type = "memory";
 		reg = <0x0 0x0 0x0 0x40000000>; /* 1 GiB or 2 GiB */
 	};
+
+	openvfd {
+		compatible = "open,vfd";
+		dev_name = "openvfd";
+		openvfd_gpio_clk = <&gpio GPIODV_27 GPIO_ACTIVE_HIGH>;
+		openvfd_gpio_dat = <&gpio GPIODV_26 GPIO_ACTIVE_HIGH>;
+		openvfd_gpio_stb = <&gpio_ao GPIOAO_4 GPIO_ACTIVE_HIGH>;
+		openvfd_chars = [04 03 02 01 00];
+		openvfd_dot_bits = [00 01 03 02 04 05 06];
+		openvfd_display_type = <0x01000001>;
+		status = "okay";
+	};
 };
 
 &ir {
@@ -28,3 +40,7 @@
 &usb {
 	dr_mode = "host";
 };
+
+&ethmac {
+	local-mac-address = [3a 31 a3 df 6e 40];
+};
