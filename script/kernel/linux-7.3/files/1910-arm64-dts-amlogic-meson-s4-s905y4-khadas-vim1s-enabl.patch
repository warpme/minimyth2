arm64: dts: amlogic: meson-s4-s905y4-khadas-vim1s: enable
 HDMI CEC

Enable the AO-CEC-B controller and route it to the HDMI CEC pin so that
the CEC bus of the HDMI connector can be used.

---
 .../arm64/boot/dts/amlogic/meson-s4-s905y4-khadas-vim1s.dts | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/arch/arm64/boot/dts/amlogic/meson-s4-s905y4-khadas-vim1s.dts b/arch/arm64/boot/dts/amlogic/meson-s4-s905y4-khadas-vim1s.dts
index 5737547..71286ef 100644
--- a/arch/arm64/boot/dts/amlogic/meson-s4-s905y4-khadas-vim1s.dts
+++ b/arch/arm64/boot/dts/amlogic/meson-s4-s905y4-khadas-vim1s.dts
@@ -540,6 +540,12 @@
 	hdmi-supply = <&hdmi_5v>;
 };
 
+&cecb {
+	pinctrl-0 = <&hdmitx_cec_pins>;
+	pinctrl-names = "default";
+	status = "okay";
+};
+
 &emmc {
 	status = "okay";
 	pinctrl-0 = <&emmc_pins>, <&emmc_ds_pins>;
-- 
