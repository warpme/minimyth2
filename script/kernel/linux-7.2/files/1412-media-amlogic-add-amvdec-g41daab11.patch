diff --speed-large-files --no-dereference --minimal -Naur linux-7.2.8/drivers/media/platform/amlogic/amvdec/tests/t6_alu.s linux-7.2.8/drivers/media/platform/amlogic/amvdec/tests/t6_alu.s
--- linux-7.2.8/drivers/media/platform/amlogic/amvdec/tests/t6_alu.s	1970-01-01 01:00:00.000000000 +0100
+++ linux-7.2.8/drivers/media/platform/amlogic/amvdec/tests/t6_alu.s	2026-10-02 08:55:53.000000000 +0200
@@ -0,0 +1,123 @@
+; T6 - shifts, ext/ins operand order, subs flags and jCC (signed vs unsigned).
+; r1=0x80000010:
+;  SCRATCH_0 = shr  r1>>4 (expect 0x08000001 logical)   SCRATCH_1 = sar (0xf8000001)
+;  SCRATCH_2 = shri r1>>4                                SCRATCH_3 = sari
+;  SCRATCH_4 = shl r1<<1 (0x00000020)                    SCRATCH_5 = xori r1^0x0ff
+; ext/ins with r6=0x12345678, r9=0x5, r8=0xffffffff:
+;  SCRATCH_6 = r7 after `ext r7, r6, 8, 8`; SCRATCH_7 = r6 after it
+;  SCRATCH_8 = r8 after `ins r8, r9, 8, 4`; SCRATCH_9 = r9 after it
+; flags: SCRATCH_A = bitmask of taken jCC after subs 5-7
+;        (bit0 jne bit1 jeq bit2 jgt bit3 jle bit4 jge bit5 jlt); expect 0x29 signed
+;        SCRATCH_B = same after subs 0xffffffff-1: signed -> 0x29, unsigned -> 0x15
+;        SCRATCH_C = same after subs 7-7: expect 0x1a (jeq jle jge)
+; SCRATCH_D = dbnz count: r15=5 loop -> iterations executed (5 or 6)
+; SCRATCH_E = 0xdd end
+.org 0x0
+    jmp start
+    nop
+.org 0x20
+    ret
+    ei
+    ret
+    ei
+    ret
+    ei
+    ret
+    ei
+    ret
+    ei
+    ret
+    ei
+    ret
+    ei
+    ret
+    ei
+    ret
+    ei
+.org 0x40
+start:
+    movi r0, #0xffff
+    mtsp MCPU_INTR_MSK, r0
+    movi r1, #0x0010
+    movhi r1, #0x8000
+    movi r2, #4
+    shr r3, r1, r2
+    mtsp AV_SCRATCH_0, r3
+    sar r3, r1, r2
+    mtsp AV_SCRATCH_1, r3
+    shri r3, r1, #4
+    mtsp AV_SCRATCH_2, r3
+    sari r3, r1, #4
+    mtsp AV_SCRATCH_3, r3
+    movi r2, #1
+    shl r3, r1, r2
+    mtsp AV_SCRATCH_4, r3
+    xori r3, r1, #0xff
+    mtsp AV_SCRATCH_5, r3
+    movi r6, #0x5678
+    movhi r6, #0x1234
+    movi r7, #0
+    ext r7, r6, 8, 8
+    mtsp AV_SCRATCH_6, r7
+    mtsp AV_SCRATCH_7, r6
+    movi r8, #0xffff
+    movhi r8, #0xffff
+    movi r9, #5
+    ins r8, r9, 8, 4
+    mtsp AV_SCRATCH_8, r8
+    mtsp AV_SCRATCH_9, r9
+    ; flags case 1: 5 - 7
+    movi r11, #5
+    movi r12, #7
+    movi r13, #0
+    subs r10, r11, r12
+    call jcc_probe
+    nop
+    mtsp AV_SCRATCH_A, r13
+    ; case 2: 0xffffffff - 1
+    movi r11, #0xffff
+    movhi r11, #0xffff
+    movi r12, #1
+    movi r13, #0
+    subs r10, r11, r12
+    call jcc_probe
+    nop
+    mtsp AV_SCRATCH_B, r13
+    ; case 3: 7 - 7
+    movi r11, #7
+    movi r12, #7
+    movi r13, #0
+    subs r10, r11, r12
+    call jcc_probe
+    nop
+    mtsp AV_SCRATCH_C, r13
+    ; dbnz count
+    movi r15, #5
+    movi r14, #0
+dl: addi r14, r14, #1
+    dbnz r15, dl
+    nop
+    mtsp AV_SCRATCH_D, r14
+    mtspi AV_SCRATCH_E, #0xdd
+end:
+    jmp end
+    nop
+
+; each probe: jCC over one 'ori' that sets a bit; taken => bit NOT set, so invert at end
+jcc_probe:
+    movi r13, #0
+    jne q1
+    ori r13, r13, #0x1
+q1: jeq q2
+    ori r13, r13, #0x2
+q2: jgt q3
+    ori r13, r13, #0x4
+q3: jle q4
+    ori r13, r13, #0x8
+q4: jge q5
+    ori r13, r13, #0x10
+q5: jlt q6
+    ori r13, r13, #0x20
+q6: xori r13, r13, #0x3f
+    ret
+    nop
diff --speed-large-files --no-dereference --minimal -Naur linux-7.2.8/drivers/media/platform/amlogic/amvdec/tests/t6b_flags.s linux-7.2.8/drivers/media/platform/amlogic/amvdec/tests/t6b_flags.s
--- linux-7.2.8/drivers/media/platform/amlogic/amvdec/tests/t6b_flags.s	1970-01-01 01:00:00.000000000 +0100
+++ linux-7.2.8/drivers/media/platform/amlogic/amvdec/tests/t6b_flags.s	2026-10-02 08:55:53.000000000 +0200
@@ -0,0 +1,170 @@
+; T6b - subs flags and jCC. bitmask of TAKEN jCC:
+; bit0 jne bit1 jeq bit2 jgt bit3 jle bit4 jge bit5 jlt
+; SCRATCH_A: 5-7        expect 0x29 (jne jle jlt)
+; SCRATCH_B: 0xffffffff-1  signed -> 0x29 ; unsigned -> 0x15 (jne jgt jge)
+; SCRATCH_C: 7-7        expect 0x1a (jeq jle jge)
+; SCRATCH_D: 7-5        expect 0x15
+; SCRATCH_E: 0x7fffffff-(-1) : overflow case; signed-with-overflow -> jgt(0x15), naive N flag -> jlt(0x29)
+; SCRATCH_F: flags after plain `sub` (5-7) following subs 7-5: 0x15 if sub does not touch flags
+; SCRATCH_0: bits from bCC family on r=5 vs #7: bit0 bne bit1 beq bit2 bgt bit3 ble bit4 bge bit5 blt  expect 0x29
+; SCRATCH_1: same r=0xffffffff vs #1: signed 0x29 / unsigned 0x15
+; SCRATCH_2: andis 0x30 & 0x0f -> Z set: expect jeq taken -> 0x1a
+; SCRATCH_9 = 0xdd end
+.org 0x0
+    jmp start
+    nop
+.org 0x20
+    ret
+    ei
+    ret
+    ei
+    ret
+    ei
+    ret
+    ei
+    ret
+    ei
+    ret
+    ei
+    ret
+    ei
+    ret
+    ei
+    ret
+    ei
+.org 0x40
+start:
+    movi r0, #0xffff
+    mtsp MCPU_INTR_MSK, r0
+    movi r11, #5
+    movi r12, #7
+    subs r10, r11, r12
+    call jcc_probe
+    nop
+    mtsp AV_SCRATCH_A, r13
+    movi r11, #0xffff
+    movhi r11, #0xffff
+    movi r12, #1
+    subs r10, r11, r12
+    call jcc_probe
+    nop
+    mtsp AV_SCRATCH_B, r13
+    movi r11, #7
+    movi r12, #7
+    subs r10, r11, r12
+    call jcc_probe
+    nop
+    mtsp AV_SCRATCH_C, r13
+    movi r11, #7
+    movi r12, #5
+    subs r10, r11, r12
+    call jcc_probe
+    nop
+    mtsp AV_SCRATCH_D, r13
+    movi r11, #0xffff
+    movhi r11, #0x7fff
+    movi r12, #0xffff
+    movhi r12, #0xffff
+    subs r10, r11, r12
+    call jcc_probe
+    nop
+    mtsp AV_SCRATCH_E, r13
+    movi r11, #7
+    movi r12, #5
+    subs r10, r11, r12
+    movi r11, #5
+    movi r12, #7
+    sub r10, r11, r12
+    call jcc_probe
+    nop
+    mtsp AV_SCRATCH_F, r13
+    ; bCC family, immediate form
+    movi r11, #5
+    call bcc_probe
+    nop
+    mtsp AV_SCRATCH_0, r13
+    movi r11, #0xffff
+    movhi r11, #0xffff
+    call bcc_probe1
+    nop
+    mtsp AV_SCRATCH_1, r13
+    ; andis
+    movi r11, #0x30
+    andis r10, r11, #0x0f
+    call jcc_probe
+    nop
+    mtsp AV_SCRATCH_2, r13
+    mtspi AV_SCRATCH_9, #0xdd
+end:
+    jmp end
+    nop
+
+jcc_probe:
+    movi r13, #0
+    jne q1
+    nop
+    ori r13, r13, #0x1
+q1: jeq q2
+    nop
+    ori r13, r13, #0x2
+q2: jgt q3
+    nop
+    ori r13, r13, #0x4
+q3: jle q4
+    nop
+    ori r13, r13, #0x8
+q4: jge q5
+    nop
+    ori r13, r13, #0x10
+q5: jlt q6
+    nop
+    ori r13, r13, #0x20
+q6: xori r13, r13, #0x3f
