From cb8a4bd11ad3ba8d1cd23f7f6e68a998912fb553 Mon Sep 17 00:00:00 2001
From: Piotr Oniszczuk <piotr.oniszczuk@gmail.com>
Date: Wed, 25 Nov 2026 14:29:52 +0100
Subject: [PATCH] dt-bindings: clock: add Amlogic S7 peripherals clock
 controller

Add the bindings and the clock IDs of the peripherals clock controller
of the Amlogic S7 SoC family (S805X3, S905Y5). The clock IDs follow the
Amlogic BSP s7 clock driver, without the PLLs which are provided by the
PLL clock controller.

Signed-off-by: Piotr Oniszczuk <piotr.oniszczuk@gmail.com>
---
 .../clock/amlogic,s7-peripherals-clkc.yaml    |  89 +++++++
 .../clock/amlogic,s7-peripherals-clkc.h       | 251 ++++++++++++++++++
 2 files changed, 340 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/clock/amlogic,s7-peripherals-clkc.yaml
 create mode 100644 include/dt-bindings/clock/amlogic,s7-peripherals-clkc.h

diff --git a/Documentation/devicetree/bindings/clock/amlogic,s7-peripherals-clkc.yaml b/Documentation/devicetree/bindings/clock/amlogic,s7-peripherals-clkc.yaml
new file mode 100644
index 000000000..9301c9ffa
--- /dev/null
+++ b/Documentation/devicetree/bindings/clock/amlogic,s7-peripherals-clkc.yaml
@@ -0,0 +1,89 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/clock/amlogic,s7-peripherals-clkc.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Amlogic S7 Peripherals Clock Controller
+
+maintainers:
+  - Piotr Oniszczuk <piotr.oniszczuk@gmail.com>
+
+description:
+  The peripherals clock controller of the Amlogic S7 SoC family (S805X3,
+  S905Y5). It provides the system and AXI bus clocks with their gates and
+  the clocks of the peripherals.
+
+properties:
+  compatible:
+    const: amlogic,s7-peripherals-clkc
+
+  reg:
+    maxItems: 1
+
+  clocks:
+    minItems: 10
+    items:
+      - description: input oscillator (usually at 24MHz)
+      - description: input fixed pll div2
+      - description: input fixed pll div2p5
+      - description: input fixed pll div3
+      - description: input fixed pll div4
+      - description: input fixed pll div5
+      - description: input fixed pll div7
+      - description: input gp0 pll
+      - description: input hifi pll
+      - description: input hifi1 pll
+      - description: input gp1 pll, provided by the firmware (optional)
+
+  clock-names:
+    minItems: 10
+    items:
+      - const: xtal
+      - const: fclk_div2
+      - const: fclk_div2p5
+      - const: fclk_div3
+      - const: fclk_div4
+      - const: fclk_div5
+      - const: fclk_div7
+      - const: gp0_pll
+      - const: hifi_pll
+      - const: hifi1_pll
+      - const: gp1_pll
+
+  "#clock-cells":
+    const: 1
+
+required:
+  - compatible
+  - reg
+  - clocks
+  - clock-names
+  - "#clock-cells"
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/clock/amlogic,s7-pll-clkc.h>
+
+    clock-controller@fe000000 {
+      compatible = "amlogic,s7-peripherals-clkc";
+      reg = <0xfe000000 0x49c>;
+      clocks = <&xtal>,
+               <&clkc_pll CLKID_FCLK_DIV2>,
+               <&clkc_pll CLKID_FCLK_DIV2P5>,
+               <&clkc_pll CLKID_FCLK_DIV3>,
+               <&clkc_pll CLKID_FCLK_DIV4>,
+               <&clkc_pll CLKID_FCLK_DIV5>,
+               <&clkc_pll CLKID_FCLK_DIV7>,
+               <&clkc_pll CLKID_GP0_PLL>,
+               <&clkc_pll CLKID_HIFI_PLL>,
+               <&clkc_pll CLKID_HIFI1_PLL>;
+      clock-names = "xtal", "fclk_div2", "fclk_div2p5", "fclk_div3",
+                    "fclk_div4", "fclk_div5", "fclk_div7", "gp0_pll",
+                    "hifi_pll", "hifi1_pll";
+      #clock-cells = <1>;
+    };
+
+...
