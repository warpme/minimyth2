+#include "config.h"
+#include "config_components.h"
+
+#include "libavutil/intreadwrite.h"
+
+#include "h263.h"
+#include "h263data.h"
+#include "h263dec.h"
+#include "hwaccel_internal.h"
+#include "hwconfig.h"
+#include "internal.h"
+#include "mathops.h"
+#include "mpeg4videodec.h"
+#include "mpeg4videodefs.h"
+#include "mpegvideo.h"
+#include "v4l2_request.h"
+#include "v4l2_request_dump.h"
+#include "v4l2-stateless-mpeg4.h"
+
+typedef struct V4L2RequestControlsMPEG4 {
+    V4L2RequestPictureContext pic;
+    struct v4l2_ctrl_mpeg4_vol vol;
+    struct v4l2_ctrl_mpeg4_vop vop;
+    struct v4l2_ctrl_mpeg4_quantisation quantisation;
+} V4L2RequestControlsMPEG4;
+
+/*
+ * Only the MPEG-4 decoder has a Mpeg4DecContext: the private context of the
+ * H.263 decoder is a bare H263DecContext.
+ */
+static inline const Mpeg4DecContext *mpeg4_ctx(const AVCodecContext *avctx)
+{
+    return avctx->codec_id == AV_CODEC_ID_MPEG4 ? avctx->priv_data : NULL;
+}
+
+/* Reconstruct bitstream intra_dc_vlc_thr */
+static int mpeg4_get_intra_dc_vlc_thr(const Mpeg4DecContext *ctx)
+{
+    switch (ctx->intra_dc_threshold) {
+    case 99: return 0;
+    case 13: return 1;
+    case 15: return 2;
+    case 17: return 3;
+    case 19: return 4;
+    case 21: return 5;
+    case 23: return 6;
+    case 0:  return 7;
+    }
+    return 0;
+}
+
+/*
+ * H.263 source format: 1 to 5 for the standard picture formats, 6 for a custom
+ * picture format (signalled by PLUSPTYPE, whatever the size).
+ */
+static int h263_get_source_format(const H263DecContext *h)
+{
+    static const uint16_t sizes[][2] = {
+        { 128, 96 }, { 176, 144 }, { 352, 288 }, { 704, 576 }, { 1408, 1152 },
+    };
+
+    if (h->plus_ptype && h->custom_picture_format)
+        return 6;
+
+    for (int i = 0; i < FF_ARRAY_ELEMS(sizes); i++)
+        if (h->c.width == sizes[i][0] && h->c.height == sizes[i][1])
+            return i + 1;
+
+    return 6;
+}
+
+/*
+ * Modes of the H.263 picture header. The driver refuses the VOP control for
+ * the modes it does not decode. SAC, RPS, ISD, RPR and RRU are refused by the
+ * decoder itself and CPM is not kept by it, so they are never set here.
+ */
+static uint32_t h263_get_flags(const H263DecContext *h)
+{
+    const MPVContext *s = &h->c;
+    uint32_t flags = 0;
+
+    if (h->plus_ptype)
+        flags |= V4L2_H263_FLAG_PLUSPTYPE;
+    if (h->plus_ptype && h->custom_picture_format)
+        flags |= V4L2_H263_FLAG_CUSTOM_PICTURE_FORMAT;
+    if (h->plus_ptype && h->custom_pcf)
+        flags |= V4L2_H263_FLAG_CUSTOM_PCF;
+    if (h->umvplus || h->h263_long_vectors)
+        flags |= V4L2_H263_FLAG_UMV;
+    if (s->obmc)
+        flags |= V4L2_H263_FLAG_AP;
+    if (h->pb_frame == 3)
+        flags |= V4L2_H263_FLAG_IMPROVED_PB_FRAMES;
+    else if (h->pb_frame)
+        flags |= V4L2_H263_FLAG_PB_FRAMES;
+    if (s->h263_aic)
+        flags |= V4L2_H263_FLAG_AIC;
+    if (h->loop_filter)
+        flags |= V4L2_H263_FLAG_DF;
+    if (h->h263_slice_structured)
+        flags |= V4L2_H263_FLAG_SS;
+    if (h->alt_inter_vlc)
+        flags |= V4L2_H263_FLAG_AIV;
+    if (h->modified_quant)
+        flags |= V4L2_H263_FLAG_MQ;
+    /* B pictures only exist with the scalability mode (Annex O) */
+    if (s->pict_type == AV_PICTURE_TYPE_B)
+        flags |= V4L2_H263_FLAG_SCALABILITY;
+
+    return flags;
+}
+
+/*
+ * What the controls cannot describe at all. Everything else is refused by the
+ * driver from the controls: MPEG-4 tools through the VOL control, H.263 modes
+ * through the VOP control (see v4l2_request_mpeg4_init()).
+ */
+static int v4l2_request_mpeg4_supported(const AVCodecContext *avctx)
+{
+    const H263DecContext *h = avctx->priv_data;
+    const MPVContext *s = &h->c;
+    const Mpeg4DecContext *ctx = mpeg4_ctx(avctx);
+
+    return !ctx || (ctx->shape == RECT_SHAPE && !s->studio_profile);
+}
+
+/* Coding type of a reference VOP, for the reference description */
+static int mpeg4_ref_coding_type(const MPVWorkPicture *pic)
+{
+    if (!pic->ptr || !pic->ptr->f)
+        return V4L2_MPEG4_VOP_CODING_TYPE_I;
+
+    return av_clip(pic->ptr->f->pict_type - AV_PICTURE_TYPE_I,
+                   V4L2_MPEG4_VOP_CODING_TYPE_I, V4L2_MPEG4_VOP_CODING_TYPE_S);
+}
+
+static void v4l2_request_mpeg4_fill_vol(const AVCodecContext *avctx,
+                                        struct v4l2_ctrl_mpeg4_vol *vol)
+{
+    const H263DecContext *h = avctx->priv_data;
+    const MPVContext *s = &h->c;
+    const Mpeg4DecContext *ctx = mpeg4_ctx(avctx);
+
+    *vol = (struct v4l2_ctrl_mpeg4_vol) {
+        .video_object_layer_width  = s->width,
+        .video_object_layer_height = s->height,
+        .video_object_layer_verid  = 1,
+        .chroma_format             = CHROMA_420,
+        .quant_precision           = 5,
+        .bits_per_pixel            = 8,
+    };
+
+    if (!ctx) {
+        /* Values which ISO/IEC 14496-2 gives to short_video_header = 1 */
+        vol->flags = V4L2_MPEG4_VOL_FLAG_SHORT_VIDEO_HEADER |
+                     V4L2_MPEG4_VOL_FLAG_OBMC_DISABLE |
+                     V4L2_MPEG4_VOL_FLAG_RESYNC_MARKER_DISABLE |
+                     V4L2_MPEG4_VOL_FLAG_COMPLEXITY_ESTIMATION_DISABLE;
+        return;
+    }
+
+    vol->vop_time_increment_resolution = avctx->framerate.num;
+    vol->video_object_type_indication  = ctx->vo_type;
+    vol->video_object_layer_verid      = ctx->vol_verid;
+    vol->video_object_layer_shape      = ctx->shape;
+    vol->sprite_enable                 = ctx->vol_sprite_usage;
+    vol->quant_precision               = ctx->quant_precision;
+    vol->bits_per_pixel                = avctx->bits_per_raw_sample ?
+                                         avctx->bits_per_raw_sample : 8;
+
+    if (avctx->profile != AV_PROFILE_UNKNOWN &&
+        avctx->level != AV_LEVEL_UNKNOWN)
+        vol->profile_and_level_indication = avctx->profile << 4 |
+                                            (avctx->level & 0xf);
+
+    if (ctx->vol_sprite_usage != V4L2_MPEG4_SPRITE_NONE) {
+        vol->no_of_sprite_warping_points = ctx->num_sprite_warping_points;
+        vol->sprite_warping_accuracy     = ctx->sprite_warping_accuracy;
+        if (ctx->sprite_brightness_change)
+            vol->flags |= V4L2_MPEG4_VOL_FLAG_SPRITE_BRIGHTNESS_CHANGE;
+    }
+
+    if (ctx->fixed_vop_rate) {
+        vol->flags |= V4L2_MPEG4_VOL_FLAG_FIXED_VOP_RATE;
+        vol->fixed_vop_time_increment = ctx->fixed_vop_time_increment;
+    }
+    if (!s->progressive_sequence)
+        vol->flags |= V4L2_MPEG4_VOL_FLAG_INTERLACED;
+    if (ctx->obmc_disable)
+        vol->flags |= V4L2_MPEG4_VOL_FLAG_OBMC_DISABLE;
+    if (ctx->mpeg_quant)
+        vol->flags |= V4L2_MPEG4_VOL_FLAG_QUANT_TYPE;
+    if (s->quarter_sample)
+        vol->flags |= V4L2_MPEG4_VOL_FLAG_QUARTER_SAMPLE;
+    if (!ctx->cplx_estimation_trash_i && !ctx->cplx_estimation_trash_p &&
+        !ctx->cplx_estimation_trash_b)
+        vol->flags |= V4L2_MPEG4_VOL_FLAG_COMPLEXITY_ESTIMATION_DISABLE;
+    if (!ctx->resync_marker)
+        vol->flags |= V4L2_MPEG4_VOL_FLAG_RESYNC_MARKER_DISABLE;
+    if (h->data_partitioning)
+        vol->flags |= V4L2_MPEG4_VOL_FLAG_DATA_PARTITIONED;
+    if (h->data_partitioning && ctx->rvlc)
+        vol->flags |= V4L2_MPEG4_VOL_FLAG_REVERSIBLE_VLC;
+    if (ctx->new_pred)
+        vol->flags |= V4L2_MPEG4_VOL_FLAG_NEWPRED_ENABLE;
+    if (ctx->reduced_res_vop_enable)
+        vol->flags |= V4L2_MPEG4_VOL_FLAG_REDUCED_RESOLUTION_VOP_ENABLE;
+    if (ctx->scalability)
+        vol->flags |= V4L2_MPEG4_VOL_FLAG_SCALABILITY;
+    /* low_delay of the bitstream, not the value the decoder may have guessed */
+    if (ctx->vol_control_parameters && s->low_delay)
+        vol->flags |= V4L2_MPEG4_VOL_FLAG_LOW_DELAY;
+}
+
+static void v4l2_request_mpeg4_fill_vop(const AVCodecContext *avctx,
+                                        struct v4l2_ctrl_mpeg4_vop *vop)
+{
+    const H263DecContext *h = avctx->priv_data;
+    const MPVContext *s = &h->c;
+    const Mpeg4DecContext *ctx = mpeg4_ctx(avctx);
+
+    *vop = (struct v4l2_ctrl_mpeg4_vop) {
+        /* AV_PICTURE_TYPE_I/P/B/S are consecutive, like vop_coding_type */
+        .vop_coding_type    = s->pict_type - AV_PICTURE_TYPE_I,
+        .vop_quant          = s->qscale,
+        .vop_fcode_forward  = 1,
+        .vop_fcode_backward = 1,
+    };
+
+    /*
+     * References, with the coding types which the decoder of the B-VOP
+     * macroblocks needs to know (stateless: the driver does not remember).
+     */
+    switch (s->pict_type) {
+    case AV_PICTURE_TYPE_B:
+        if (s->next_pic.ptr)
+            vop->backward_ref_ts =
+                ff_v4l2_request_get_capture_timestamp(s->next_pic.ptr->f);
+        vop->backward_ref_vop_coding_type = mpeg4_ref_coding_type(&s->next_pic);
+        av_fallthrough;
+    case AV_PICTURE_TYPE_P:
+    case AV_PICTURE_TYPE_S:
+        if (s->last_pic.ptr)
+            vop->forward_ref_ts =
+                ff_v4l2_request_get_capture_timestamp(s->last_pic.ptr->f);
+        vop->forward_ref_vop_coding_type = mpeg4_ref_coding_type(&s->last_pic);
+    }
+
+    if (s->no_rounding)
+        vop->flags |= V4L2_MPEG4_VOP_FLAG_ROUNDING_TYPE;
+
+    if (!ctx) {
+        int gob_height = H263_GOB_HEIGHT(s->height);
+
+        vop->h263_flags             = h263_get_flags(h);
+        vop->temporal_reference     = h->picture_number & 0xff;
+        vop->source_format          = h263_get_source_format(h);
+        vop->num_macroblocks_in_gob = s->mb_width * gob_height;
+        vop->num_gobs_in_vop        = s->mb_height / gob_height;
+        return;
+    }
+
+    vop->intra_dc_vlc_thr = mpeg4_get_intra_dc_vlc_thr(ctx);
+    if (s->pict_type != AV_PICTURE_TYPE_I)
+        vop->vop_fcode_forward = ctx->f_code;
+    if (s->pict_type == AV_PICTURE_TYPE_B)
+        vop->vop_fcode_backward = ctx->b_code;
+
+    if (!s->progressive_sequence) {
+        if (s->top_field_first)
+            vop->flags |= V4L2_MPEG4_VOP_FLAG_TOP_FIELD_FIRST;
+        if (s->alternate_scan)
+            vop->flags |= V4L2_MPEG4_VOP_FLAG_ALTERNATE_VERTICAL_SCAN;
+    }
+
+    /*
+     * Time base. The decoder keeps the time of the VOP in ticks; the syntax
+     * elements are recovered from it. For a B-VOP modulo_time_base counts
+     * from the second of the forward reference, otherwise from the second of
+     * the previous reference VOP (the decoder has already moved last_time_base
+     * to it).
+     */
+    if (avctx->framerate.num > 0) {
+        int64_t seconds = s->time / avctx->framerate.num;
+
+        vop->vop_time_increment = s->time % avctx->framerate.num;
+        vop->modulo_time_base   = av_clip_uint8(seconds - s->last_time_base);
+    }
+
+    vop->complexity_estimation_bits = ctx->cplx_estimation_trash_i;
+    if (s->pict_type != AV_PICTURE_TYPE_I)
+        vop->complexity_estimation_bits += ctx->cplx_estimation_trash_p;
+    if (s->pict_type == AV_PICTURE_TYPE_B)
+        vop->complexity_estimation_bits += ctx->cplx_estimation_trash_b;
+
+    if (s->pict_type == AV_PICTURE_TYPE_B) {
+        vop->trb       = s->pb_time;
+        vop->trd       = s->pp_time;
+        vop->trb_field = s->pb_field_time;
+        vop->trd_field = s->pp_field_time;
+    }
+
+    if (s->pict_type == AV_PICTURE_TYPE_S) {
+        int points = FFMIN(ctx->num_sprite_warping_points,
+                           V4L2_MPEG4_NUM_SPRITE_WARPING_POINTS);
+
+        for (int i = 0; i < points; i++) {
+            vop->sprite_trajectory_du[i] = (int16_t)ctx->sprite_traj[i][0];
+            vop->sprite_trajectory_dv[i] = (int16_t)ctx->sprite_traj[i][1];
+        }
+    }
+}
+
+static void
+v4l2_request_mpeg4_fill_quantisation(const AVCodecContext *avctx,
+                                     struct v4l2_ctrl_mpeg4_quantisation *q)
+{
+    const H263DecContext *h = avctx->priv_data;
+    const MPVContext *s = &h->c;
+
+    /*
+     * The decoder holds complete matrices: the default ones unless the VOL
+     * loads its own, which it completes when the bitstream cuts them short.
+     */
+    for (int i = 0; i < 64; i++) {
+        int n = s->idsp.idct_permutation[ff_zigzag_direct[i]];
+
+        q->intra_quant_mat[i]    = s->intra_matrix[n];
+        q->nonintra_quant_mat[i] = s->inter_matrix[n];
+    }
+}
+
+/*
+ * In the Slice Structured mode of H.263 (Annex K) the picture header is
+ * followed by what remains of the header of the first slice (SEPB1, MBA and
+ * SEPB2), which the decoder reads with the picture header. This belongs to
+ * the slice layer: the picture header ends in front of it.
+ */
+static int v4l2_request_h263_slice_header_bits(const AVCodecContext *avctx)
+{
+    const H263DecContext *h = avctx->priv_data;
+    int i;
+
+    if (avctx->codec_id == AV_CODEC_ID_MPEG4 || !h->h263_slice_structured)
+        return 0;
+
+    for (i = 0; i < 6; i++)
+        if (h->c.mb_num - 1 <= ff_mba_max[i])
+            break;
+
+    return 2 + ff_mba_length[i];
+}
+
+/*
+ * The decoder has parsed the picture header: h->gb is on the first macroblock.
+ * Find the coded picture which surrounds that position in the packet (which
+ * may start with other headers and, for packed bitstreams, hold more VOPs).
+ */
+static int v4l2_request_mpeg4_find_picture(const AVCodecContext *avctx,
+                                           const uint8_t *buf, int size,
+                                           int *start, int *end)
+{
+    const H263DecContext *h = avctx->priv_data;
+    int mb_byte = get_bits_count(&h->gb) >> 3;
+    int i;
+
+    if (mb_byte > size)
+        return AVERROR_INVALIDDATA;
+
+    if (avctx->codec_id == AV_CODEC_ID_MPEG4) {
+        /* Last VOP start code in front of the first macroblock */
+        for (i = FFMIN(mb_byte, size) - 4; i >= 0; i--)
+            if (AV_RB32(buf + i) == VOP_STARTCODE)
+                break;
+        if (i < 0)
+            return AVERROR_INVALIDDATA;
+        *start = i;
+
+        /* Up to the next start code; resync markers are not start codes */
+        for (i = mb_byte; i + 3 <= size; i++)
+            if (AV_RB24(buf + i) == 1)
+                break;
+        *end = i + 3 <= size ? i : size;
+    } else {
+        /* Byte-aligned 22-bit picture start code */
+        for (i = 0; i + 3 <= FFMIN(mb_byte, size); i++)
+            if (!buf[i] && !buf[i + 1] && (buf[i + 2] & 0xfc) == 0x80)
+                break;
+        if (i + 3 > FFMIN(mb_byte, size))
+            return AVERROR_INVALIDDATA;
+        *start = i;
+        *end   = size;
+    }
+
+    return 0;
+}
+
+static int v4l2_request_mpeg4_start_frame(AVCodecContext *avctx,
+                                          av_unused const AVBufferRef *buf_ref,
+                                          const uint8_t *buffer, uint32_t size)
+{
+    const H263DecContext *h = avctx->priv_data;
+    const MPVContext *s = &h->c;
+    V4L2RequestControlsMPEG4 *controls = s->cur_pic.ptr->hwaccel_picture_private;
+    int start, end, ret;
+
+    if (!v4l2_request_mpeg4_supported(avctx))
+        return AVERROR(ENOSYS);
+
+    ret = v4l2_request_mpeg4_find_picture(avctx, buffer, size, &start, &end);
+    if (ret)
+        return ret;
+
+    ret = ff_v4l2_request_start_frame(avctx, &controls->pic, s->cur_pic.ptr->f);
+    if (ret)
+        return ret;
+
+    v4l2_request_mpeg4_fill_vol(avctx, &controls->vol);
+    v4l2_request_mpeg4_fill_vop(avctx, &controls->vop);
+    v4l2_request_mpeg4_fill_quantisation(avctx, &controls->quantisation);
+
+    /* Size of the VOP header, counted from the start code which begins it */
+    controls->vop.data_bit_offset = get_bits_count(&h->gb) - 8 * start -
+                                    v4l2_request_h263_slice_header_bits(avctx);
+
+    /* The whole VOP goes in one output buffer, video packets included. */
+    return ff_v4l2_request_append_output(avctx, &controls->pic,
+                                         buffer + start, end - start);
+}
+
+static int v4l2_request_mpeg4_decode_slice(av_unused AVCodecContext *avctx,
+                                           av_unused const uint8_t *buffer,
+                                           av_unused uint32_t size)
+{
+    /* h263dec.c calls this once, with the data which start_frame queued. */
+    return 0;
+}
+
+/* Debug: one record per request, see v4l2_request_dump.h */
+static void v4l2_request_mpeg4_dump(const AVCodecContext *avctx,
+                                    const V4L2RequestControlsMPEG4 *controls)
+{
+    const H263DecContext *h = avctx->priv_data;
+    const struct v4l2_ctrl_mpeg4_vol *vol = &controls->vol;
+    const struct v4l2_ctrl_mpeg4_vop *vop = &controls->vop;
+    FILE *f = v4l2_request_dump_file();
+
+    if (!f)
+        return;
+
+    fprintf(f, "begin %s\n", vol->flags & V4L2_MPEG4_VOL_FLAG_SHORT_VIDEO_HEADER ?
+            "h263" : "mpeg4");
+    fprintf(f, "capture_ts=%llu\n", (unsigned long long)
+            ff_v4l2_request_get_capture_timestamp(h->c.cur_pic.ptr->f));
+    fprintf(f, "buf.size=%u\nbuf.crc=%08x\n", controls->pic.output->bytesused,
+            v4l2_request_dump_crc(controls->pic.output->addr,
+                                  controls->pic.output->bytesused));
+
+    V4L2_REQUEST_DUMP(f, "vol", vol, flags);
+    V4L2_REQUEST_DUMP(f, "vol", vol, video_object_layer_width);
+    V4L2_REQUEST_DUMP(f, "vol", vol, video_object_layer_height);
+    V4L2_REQUEST_DUMP(f, "vol", vol, vop_time_increment_resolution);
+    V4L2_REQUEST_DUMP(f, "vol", vol, fixed_vop_time_increment);
+    V4L2_REQUEST_DUMP(f, "vol", vol, profile_and_level_indication);
+    V4L2_REQUEST_DUMP(f, "vol", vol, video_object_type_indication);
+    V4L2_REQUEST_DUMP(f, "vol", vol, video_object_layer_verid);
+    V4L2_REQUEST_DUMP(f, "vol", vol, chroma_format);
+    V4L2_REQUEST_DUMP(f, "vol", vol, video_object_layer_shape);
+    V4L2_REQUEST_DUMP(f, "vol", vol, sprite_enable);
+    V4L2_REQUEST_DUMP(f, "vol", vol, no_of_sprite_warping_points);
+    V4L2_REQUEST_DUMP(f, "vol", vol, sprite_warping_accuracy);
+    V4L2_REQUEST_DUMP(f, "vol", vol, quant_precision);
+    V4L2_REQUEST_DUMP(f, "vol", vol, bits_per_pixel);
+
+    V4L2_REQUEST_DUMP(f, "vop", vop, backward_ref_ts);
+    V4L2_REQUEST_DUMP(f, "vop", vop, forward_ref_ts);
+    V4L2_REQUEST_DUMP(f, "vop", vop, data_bit_offset);
+    V4L2_REQUEST_DUMP(f, "vop", vop, flags);
+    V4L2_REQUEST_DUMP(f, "vop", vop, trb);
+    V4L2_REQUEST_DUMP(f, "vop", vop, trd);
+    V4L2_REQUEST_DUMP(f, "vop", vop, trb_field);
+    V4L2_REQUEST_DUMP(f, "vop", vop, trd_field);
+    V4L2_REQUEST_DUMP(f, "vop", vop, h263_flags);
+    for (int i = 0; i < V4L2_MPEG4_NUM_SPRITE_WARPING_POINTS; i++)
+        fprintf(f, "vop.sprite_trajectory%d=%d,%d\n", i,
+                vop->sprite_trajectory_du[i], vop->sprite_trajectory_dv[i]);
+    V4L2_REQUEST_DUMP(f, "vop", vop, vop_time_increment);
+    V4L2_REQUEST_DUMP(f, "vop", vop, vop_quant);
+    V4L2_REQUEST_DUMP(f, "vop", vop, num_macroblocks_in_gob);
+    V4L2_REQUEST_DUMP(f, "vop", vop, vop_coding_type);
+    V4L2_REQUEST_DUMP(f, "vop", vop, intra_dc_vlc_thr);
+    V4L2_REQUEST_DUMP(f, "vop", vop, vop_fcode_forward);
+    V4L2_REQUEST_DUMP(f, "vop", vop, vop_fcode_backward);
+    V4L2_REQUEST_DUMP(f, "vop", vop, modulo_time_base);
+    V4L2_REQUEST_DUMP(f, "vop", vop, complexity_estimation_bits);
+    V4L2_REQUEST_DUMP(f, "vop", vop, temporal_reference);
+    V4L2_REQUEST_DUMP(f, "vop", vop, source_format);
+    V4L2_REQUEST_DUMP(f, "vop", vop, num_gobs_in_vop);
+    V4L2_REQUEST_DUMP(f, "vop", vop, forward_ref_vop_coding_type);
+    V4L2_REQUEST_DUMP(f, "vop", vop, backward_ref_vop_coding_type);
+
+    /* The quantisation control is only set with the first quantisation method */
+    if (vol->flags & V4L2_MPEG4_VOL_FLAG_QUANT_TYPE) {
+        v4l2_request_dump_hex(f, "q.intra", controls->quantisation.intra_quant_mat, 64);
+        v4l2_request_dump_hex(f, "q.nonintra", controls->quantisation.nonintra_quant_mat, 64);
+    }
+    fprintf(f, "end\n");
+    fflush(f);
+}
+
+static int v4l2_request_mpeg4_end_frame(AVCodecContext *avctx)
+{
+    const H263DecContext *h = avctx->priv_data;
+    const MPVContext *s = &h->c;
+    V4L2RequestControlsMPEG4 *controls = s->cur_pic.ptr->hwaccel_picture_private;
+    struct v4l2_ext_control control[3] = {
+        {
+            .id = V4L2_CID_STATELESS_MPEG4_VOL,
+            .ptr = &controls->vol,
+            .size = sizeof(controls->vol),
+        },
+        {
+            .id = V4L2_CID_STATELESS_MPEG4_VOP,
+            .ptr = &controls->vop,
+            .size = sizeof(controls->vop),
+        },
+    };
+    int count = 2;
+
+    /* Only the first inverse quantisation method uses the matrices. */
+    if (controls->vol.flags & V4L2_MPEG4_VOL_FLAG_QUANT_TYPE) {
+        control[count++] = (struct v4l2_ext_control) {
+            .id = V4L2_CID_STATELESS_MPEG4_QUANTISATION,
+            .ptr = &controls->quantisation,
+            .size = sizeof(controls->quantisation),
+        };
+    }
+
+    v4l2_request_mpeg4_dump(avctx, controls);
+
+    return ff_v4l2_request_decode_frame(avctx, &controls->pic, control, count);
+}
+
+static int v4l2_request_mpeg4_init(AVCodecContext *avctx)
+{
+    struct v4l2_ctrl_mpeg4_vol vol;
+    struct v4l2_ctrl_mpeg4_vop vop;
+    struct v4l2_ext_control control[] = {
+        {
+            .id = V4L2_CID_STATELESS_MPEG4_VOL,
+            .ptr = &vol,
+            .size = sizeof(vol),
+        },
+        {
+            .id = V4L2_CID_STATELESS_MPEG4_VOP,
+            .ptr = &vop,
+            .size = sizeof(vop),
+        },
+    };
+
+    if (!v4l2_request_mpeg4_supported(avctx))
+        return AVERROR(ENOSYS);
+
+    /*
+     * The first picture header has been parsed. The driver refuses a VOL which
+     * needs a tool it lacks (GMC, quarter sample, data partitioning, ...) and
+     * a VOP with H.263 modes it does not decode: the decoder then falls back
+     * to software.
+     */
+    v4l2_request_mpeg4_fill_vol(avctx, &vol);
+    v4l2_request_mpeg4_fill_vop(avctx, &vop);
+
+    return ff_v4l2_request_init(avctx, control, FF_ARRAY_ELEMS(control), NULL);
+}
+
+static int v4l2_request_mpeg4_frame_params(AVCodecContext *avctx,
+                                           AVBufferRef *hw_frames_ctx)
+{
+    return ff_v4l2_request_frame_params(avctx, hw_frames_ctx,
+                                        avctx->codec_id == AV_CODEC_ID_H263 ?
+                                        V4L2_PIX_FMT_H263_SLICE :
+                                        V4L2_PIX_FMT_MPEG4_SLICE, 8);
+}
