Signed-off-by: Piotr Oniszczuk <piotr.oniszczuk@gmail.com>



diff --speed-large-files --no-dereference --minimal -Naur u-boot-2026.07/dts/upstream/src/arm64/allwinner/sun50i-h616.dtsi u-boot-2026.07/dts/upstream/src/arm64/allwinner/sun50i-h616.dtsi
--- u-boot-2026.07/dts/upstream/src/arm64/allwinner/sun50i-h616.dtsi	2026-07-07 01:50:43.000000000 +0200
+++ u-boot-2026.07/dts/upstream/src/arm64/allwinner/sun50i-h616.dtsi	2026-07-31 20:14:50.184598909 +0200
@@ -226,6 +226,10 @@
 			cpu_speed_grade: cpu-speed-grade@0 {
 				reg = <0x0 2>;
 			};
+
+			ephy_calib: ephy_calib@2c {
+				reg = <0x2c 0x2>;
+			};
 		};
 
 		watchdog: watchdog@30090a0 {
@@ -263,11 +267,31 @@
 				drive-strength = <40>;
 			};
 
+			pwm5_pin: pwm5-pin {
+				pins = "PA12";
+				function = "pwm5";
+				bias-pull-up;
+			};
+
 			i2c0_pins: i2c0-pins {
 				pins = "PI5", "PI6";
 				function = "i2c0";
 			};
 
+			i2c3_pa_pins: i2c3-pa-pins {
+				pins = "PA10", "PA11";
+				function = "i2c3";
+				bias-pull-up;
+			};
+
+			i2c3_pa_pins_idle: i2c3-pa-pins-idle {
+				pins = "PA10", "PA11";
+				function = "gpio_out";
+				drive-open-drain;
+				bias-pull-up;
+				output-high;
+			};
+
 			i2c3_ph_pins: i2c3-ph-pins {
 				pins = "PH4", "PH5";
 				function = "i2c3";
@@ -341,6 +365,14 @@
 			};
 
 			/omit-if-no-ref/
+			rmii_pins: rmii-pins {
+				pins = "PA0", "PA1", "PA2", "PA3", "PA4",
+				       "PA5", "PA6", "PA7", "PA8", "PA9";
+				function = "emac1";
+				drive-strength = <40>;
+			};
+
+			/omit-if-no-ref/
 			spi0_pins: spi0-pins {
 				pins = "PC0", "PC2", "PC4";
 				function = "spi0";
@@ -760,6 +792,40 @@
 			status = "disabled";
 		};
 
+		pwm: pwm@300a000 {
+			compatible = "allwinner,sun50i-h616-pwm";
+			reg = <0x0300a000 0x400>;
+			clocks = <&ccu CLK_BUS_PWM>,
+			         <&osc24M>,
+			         <&ccu CLK_APB1>;
+			clock-names = "bus", "hosc", "apb0";
+			resets = <&ccu RST_BUS_PWM>;
+			status = "disabled";
+			#pwm-cells = <0x3>;
+		};
+
+		emac1: ethernet@5030000 {
+			compatible = "allwinner,sun50i-h616-emac1";
+			reg = <0x05030000 0x10000>;
+			interrupts = <GIC_SPI 15 IRQ_TYPE_LEVEL_HIGH>;
+			interrupt-names = "macirq";
+			resets = <&ccu RST_BUS_EMAC1>;
+			reset-names = "stmmaceth";
+			clocks = <&ccu CLK_BUS_EMAC1>;
+			clock-names = "stmmaceth";
+			syscon = <&syscon 1>;
+			pinctrl-names = "default";
+			pinctrl-0 = <&rmii_pins>;
+			phy-mode = "rmii";
+			status = "disabled";
+
+			mdio1: mdio {
+				compatible = "snps,dwmac-mdio";
+				#address-cells = <1>;
+				#size-cells = <0>;
+			};
+		};
+
 		usbotg: usb@5100000 {
 			compatible = "allwinner,sun50i-h616-musb",
 				     "allwinner,sun8i-h3-musb";
--

MiniMyth2

