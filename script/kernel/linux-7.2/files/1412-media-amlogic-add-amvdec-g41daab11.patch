diff --speed-large-files --no-dereference --minimal -Naur linux-7.2.8/drivers/media/platform/amlogic/amvdec/tests/t2_delay.s linux-7.2.8/drivers/media/platform/amlogic/amvdec/tests/t2_delay.s
--- linux-7.2.8/drivers/media/platform/amlogic/amvdec/tests/t2_delay.s	1970-01-01 01:00:00.000000000 +0100
+++ linux-7.2.8/drivers/media/platform/amlogic/amvdec/tests/t2_delay.s	2026-10-02 08:55:53.000000000 +0200
@@ -0,0 +1,86 @@
+; T2 - delay-slot semantics.
+; SCRATCH_4 = 1   : slot instruction executes on the TAKEN path (jmp)
+; SCRATCH_5 = 0x0d: control transfer in a taken branch's slot is SUPPRESSED
+;            0xba : it is NOT suppressed
+; SCRATCH_6 = 0x22: slot jmp of a NOT-taken branch executes normally
+; SCRATCH_3 = 1   : slot instruction executes on the NOT-taken path
+; SCRATCH_9 = 0xdd: end reached; SCRATCH_A = 0xca: call/ret round trip
+.org 0x0
+    jmp start
+    nop
+.org 0x20
+    ret
+    ei
+    ret
+    ei
+    ret
+    ei
+    ret
+    ei
+    ret
+    ei
+    ret
+    ei
+    ret
+    ei
+    ret
+    ei
+    ret
+    ei
+.org 0x40
+start:
+    movi r0, #0xffff
+    mtsp MCPU_INTR_MSK, r0
+    movi r3, #0x0
+    movi r4, #0x0
+    movi r5, #0x0
+    ; (a) taken jmp, ALU in slot
+    jmp a_tgt
+    movi r5, #1
+    movi r5, #0x77            ; skipped if jmp works
+a_tgt:
+    mtsp AV_SCRATCH_4, r5
+    ; (b) taken branch (r4 bit0 is zero -> btz taken), jmp in slot
+    btz r4, #0x1, b_taken
+    jmp b_bad
+    nop
+b_taken:
+    mtspi AV_SCRATCH_5, #0x0d
+    jmp c_test
+    nop
+b_bad:
+    mtspi AV_SCRATCH_5, #0xba
+    jmp c_test
+    nop
+    ; (c) not-taken branch (r4 bit0 zero -> btnz not taken), jmp in slot
+c_test:
+    btnz r4, #0x1, c_never
+    jmp c_slot
+    movi r3, #0x55            ; only if neither path transfers
+c_never:
+    mtspi AV_SCRATCH_6, #0x66
+    jmp d_test
+    nop
+c_slot:
+    mtspi AV_SCRATCH_6, #0x22
+    ; (d) not-taken branch, ALU in slot
+d_test:
+    btnz r4, #0x1, d_never
+    movi r3, #1
+    mtsp AV_SCRATCH_3, r3
+    jmp e_test
+    nop
+d_never:
+    mtspi AV_SCRATCH_3, #0xee
+    ; (e) call / ret
+e_test:
+    call sub
+    nop
+    mtspi AV_SCRATCH_9, #0xdd
+end:
+    jmp end
+    nop
+sub:
+    mtspi AV_SCRATCH_A, #0xca
+    ret
+    nop
