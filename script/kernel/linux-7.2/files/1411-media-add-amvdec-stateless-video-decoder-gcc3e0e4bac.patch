+static const struct v4l2_file_operations vdec_fops = {
+	.owner = THIS_MODULE,
+	.open = vdec_open,
+	.release = vdec_close,
+	.unlocked_ioctl = video_ioctl2,
+	.poll = vdec_fop_poll,
+	.mmap = v4l2_m2m_fop_mmap,
+};
