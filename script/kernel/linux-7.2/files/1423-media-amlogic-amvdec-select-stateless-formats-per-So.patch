Patch from MiniMyth2 project

Developed-by: Piotr Oniszczuk <piotr.oniszczuk@gmail.com>
Signed-off-by: Piotr Oniszczuk <piotr.oniszczuk@gmail.com>



From 5082a654d37ef084bbc106a96c0b32683d477c54 Mon Sep 17 00:00:00 2001
From: gus bourg <gus@bourg.net>
Date: Thu, 24 Sep 2026 20:18:21 -0700
Subject: [PATCH 15/17] media: amlogic: amvdec: select stateless formats per
 SoC

Advertise the stateless formats supported by each SoC and select the
matching single- or multi-instance firmware. Include GX, G12 and SM1
codec tables and capability limits.

Assisted-by: Claude:claude-opus-5-5
Assisted-by: Claude:claude-fable-5-1
Assisted-by: Codex:gpt-5.6
Assisted-by: Codex:gpt-6.0
---
 drivers/media/platform/amlogic/amvdec/Kconfig |   3 +-
 .../platform/amlogic/amvdec/amvdec_platform.c | 250 ++++++++++++++++++
 .../platform/amlogic/amvdec/amvdec_platform.h |   6 +
 3 files changed, 258 insertions(+), 1 deletion(-)

diff --git a/drivers/media/platform/amlogic/amvdec/Kconfig b/drivers/media/platform/amlogic/amvdec/Kconfig
index a1f17763b9..3fce20d83e 100644
--- a/drivers/media/platform/amlogic/amvdec/Kconfig
+++ b/drivers/media/platform/amlogic/amvdec/Kconfig
@@ -13,7 +13,8 @@ config VIDEO_MESON_AMVDEC
 	help
 	Support for the video decoder found in the Amlogic GXBB, GXL, GXM,
 	G12A, G12B and SM1 SoCs: stateful MPEG-1/2, MPEG-4, H.263, VC-1,
-	H.264, HEVC and VP9 decoding.
+	H.264, HEVC and VP9 decoding, and with stateless=1 the request-API
+	MPEG-2, H.264, HEVC and VP9 slice formats.
 
 	To compile this driver as a module, choose M here: the module will
 	be called meson-amvdec.
diff --git a/drivers/media/platform/amlogic/amvdec/amvdec_platform.c b/drivers/media/platform/amlogic/amvdec/amvdec_platform.c
index 2a267c81ea..a6ac0c29d0 100644
--- a/drivers/media/platform/amlogic/amvdec/amvdec_platform.c
+++ b/drivers/media/platform/amlogic/amvdec/amvdec_platform.c
@@ -344,6 +344,208 @@ static const struct amvdec_format amvdec_formats_g12a[] = {
 	},
 };
 
+/*
+ * Stateless formats on GXBB, GXL, GXLX and GXM: 1080p-class decoders.
+ * H.264 and MPEG-2 run on the VDEC_1 multi-instance firmware, H.264 fed
+ * straight from the OUTPUT buffer (meson_amvdec_codec_h264_multi_ops, as on every SoC);
+ * the H.264 image is per SoC family.  HEVC runs on the 16 KiB gxl_hevc
+ * firmware, Main (8-bit) only.  There is no stateless VP9 before G12.
+ */
+#define AMVDEC_FORMAT_GX_H264_SLICE(fw)					\
+	{								\
+		.pixfmt = V4L2_PIX_FMT_H264_SLICE,			\
+		.min_buffers = 16,					\
+		.max_buffers = 24,					\
+		.max_width = 1920,					\
+		/* 1080-line video has a macroblock-aligned coded height of 1088 */ \
+		.max_height = 1088,					\
+		.vdec_ops = &meson_amvdec_1_ops,				\
+		.codec_ops = &meson_amvdec_codec_h264_multi_ops,			\
+		.firmware_path = fw,					\
+		.pixfmts_cap = { V4L2_PIX_FMT_NV12M, 0 },		\
+		.flags = V4L2_FMT_FLAG_COMPRESSED,			\
+	}
+
+static const struct amvdec_format amvdec_formats_gx_stateless[] = {
+	AMVDEC_FORMAT_GX_H264_SLICE("meson/vdec/gxl_h264_multi.bin"), {
+		.pixfmt = V4L2_PIX_FMT_HEVC_SLICE,
+		.min_buffers = 16,
+		.max_buffers = 24,
+		.max_width = 1920,
+		.max_height = 1088,
+		.max_bit_depth = 8,
+		.vdec_ops = &meson_amvdec_hevc_ops,
+		.codec_ops = &meson_amvdec_codec_hevc_ops,
+		.firmware_path = "meson/vdec/gxl_hevc.bin",
+		.pixfmts_cap = { V4L2_PIX_FMT_NV12M, 0 },
+		.flags = V4L2_FMT_FLAG_COMPRESSED,
+	}, {
+		.pixfmt = V4L2_PIX_FMT_MPEG2_SLICE,
+		.min_buffers = 2,
+		.max_buffers = 24,
+		.max_width = 1920,
+		.max_height = 1088,
+		.vdec_ops = &meson_amvdec_1_ops,
+		.codec_ops = &meson_amvdec_codec_mpeg12_sl_ops,
+		.firmware_path = "meson/vdec/gxl_mpeg12_multi.bin",
+		.pixfmts_cap = { V4L2_PIX_FMT_NV12M, 0 },
+		.flags = V4L2_FMT_FLAG_COMPRESSED,
+	},
+};
+
+/* GXM: as the other GX parts, with its own H.264 multi-instance image */
+static const struct amvdec_format amvdec_formats_gxm_stateless[] = {
+	AMVDEC_FORMAT_GX_H264_SLICE("meson/vdec/gxm_h264_multi.bin"), {
+		.pixfmt = V4L2_PIX_FMT_HEVC_SLICE,
+		.min_buffers = 16,
+		.max_buffers = 24,
+		.max_width = 1920,
+		.max_height = 1088,
+		.max_bit_depth = 8,
+		.vdec_ops = &meson_amvdec_hevc_ops,
+		.codec_ops = &meson_amvdec_codec_hevc_ops,
+		.firmware_path = "meson/vdec/gxl_hevc.bin",
+		.pixfmts_cap = { V4L2_PIX_FMT_NV12M, 0 },
+		.flags = V4L2_FMT_FLAG_COMPRESSED,
+	}, {
+		.pixfmt = V4L2_PIX_FMT_MPEG2_SLICE,
+		.min_buffers = 2,
+		.max_buffers = 24,
+		.max_width = 1920,
+		.max_height = 1088,
+		.vdec_ops = &meson_amvdec_1_ops,
+		.codec_ops = &meson_amvdec_codec_mpeg12_sl_ops,
+		.firmware_path = "meson/vdec/gxl_mpeg12_multi.bin",
+		.pixfmts_cap = { V4L2_PIX_FMT_NV12M, 0 },
+		.flags = V4L2_FMT_FLAG_COMPRESSED,
+	},
+};
+
+static const struct amvdec_format amvdec_formats_g12a_stateless[] = {
+	{
+		/* Multi-instance firmware, fed straight from the OUTPUT buffer. */
+		.pixfmt = V4L2_PIX_FMT_H264_SLICE,
+		.min_buffers = 16,
+		.max_buffers = 24,
+		.max_width = 3840,
+		.max_height = 2160,
+		.vdec_ops = &meson_amvdec_1_ops,
+		.codec_ops = &meson_amvdec_codec_h264_multi_ops,
+		.firmware_path = "meson/vdec/g12a_h264_multi.bin",
+		.pixfmts_cap = { V4L2_PIX_FMT_NV12M, 0 },
+		.flags = V4L2_FMT_FLAG_COMPRESSED,
+	}, {
+		/* Stateless requests feed whole VP9 frames through the HEVC parser. */
+		.pixfmt = V4L2_PIX_FMT_VP9_FRAME,
+		.min_buffers = 16,
+		.max_buffers = 24,
+		.max_width = 3840,
+		.max_height = 2160,
+		.vdec_ops = &meson_amvdec_hevc_ops,
+		.codec_ops = &meson_amvdec_codec_vp9_ops,
+		.firmware_path = "meson/vdec/g12a_vp9.bin",
+		.pixfmts_cap = { V4L2_PIX_FMT_NV12M,
+				 V4L2_PIX_FMT_AM21C, 0 },
+		.flags = V4L2_FMT_FLAG_COMPRESSED,
+	}, {
+		/* Use the G12 HEVC firmware; MMU use is selected at runtime.
+		 * Main 10 or AM21C uses MMU; VPS/SPS/PPS are synthesized.
+		 */
+		.pixfmt = V4L2_PIX_FMT_HEVC_SLICE,
+		.min_buffers = 16,
+		.max_buffers = 24,
+		.max_width = 3840,
+		.max_height = 2160,
+		.vdec_ops = &meson_amvdec_hevc_ops,
+		.codec_ops = &meson_amvdec_codec_hevc_ops,
+		.firmware_path = "meson/vdec/g12a_hevc_mmu.bin",
+		.pixfmts_cap = { V4L2_PIX_FMT_NV12M,
+				 V4L2_PIX_FMT_AM21C, 0 },
+		.flags = V4L2_FMT_FLAG_COMPRESSED,
+	}, {
+		/*
+		 * Stateless MPEG-1/2.  The firmware parses picture headers, so
+		 * MPEG2_SLICE (slice data only) needs the sequence and picture
+		 * headers synthesized in-driver from the V4L2 controls, the same
+		 * way HEVC_SLICE does.
+		 */
+		.pixfmt = V4L2_PIX_FMT_MPEG2_SLICE,
+		.min_buffers = 2,
+		.max_buffers = 24,
+		.max_width = 1920,
+		/* 1080 lines are coded as 1088: whole macroblocks, in field pairs */
+		.max_height = 1088,
+		.vdec_ops = &meson_amvdec_1_ops,
+		.codec_ops = &meson_amvdec_codec_mpeg12_sl_ops,
+		.firmware_path = "meson/vdec/gxl_mpeg12_multi.bin",
+		.pixfmts_cap = { V4L2_PIX_FMT_NV12M, 0 },
+		.flags = V4L2_FMT_FLAG_COMPRESSED,
+	},
+};
+
+/* SM1: as G12A, with its own VP9 firmware image */
+static const struct amvdec_format amvdec_formats_sm1_stateless[] = {
+	{
+		/* Multi-instance firmware, fed straight from the OUTPUT buffer. */
+		.pixfmt = V4L2_PIX_FMT_H264_SLICE,
+		.min_buffers = 16,
+		.max_buffers = 24,
+		.max_width = 3840,
+		.max_height = 2160,
+		.vdec_ops = &meson_amvdec_1_ops,
+		.codec_ops = &meson_amvdec_codec_h264_multi_ops,
+		.firmware_path = "meson/vdec/sm1_h264_multi.bin",
+		.pixfmts_cap = { V4L2_PIX_FMT_NV12M, 0 },
+		.flags = V4L2_FMT_FLAG_COMPRESSED,
+	}, {
+		/* Stateless requests feed whole VP9 frames through the HEVC parser. */
+		.pixfmt = V4L2_PIX_FMT_VP9_FRAME,
+		.min_buffers = 16,
+		.max_buffers = 24,
+		.max_width = 3840,
+		.max_height = 2160,
+		.vdec_ops = &meson_amvdec_hevc_ops,
+		.codec_ops = &meson_amvdec_codec_vp9_ops,
+		.firmware_path = "meson/vdec/sm1_vp9_mmu.bin",
+		.pixfmts_cap = { V4L2_PIX_FMT_NV12M,
+				 V4L2_PIX_FMT_AM21C, 0 },
+		.flags = V4L2_FMT_FLAG_COMPRESSED,
+	}, {
+		/* Use the G12 HEVC firmware; MMU use is selected at runtime.
+		 * Main 10 or AM21C uses MMU; VPS/SPS/PPS are synthesized.
+		 */
+		.pixfmt = V4L2_PIX_FMT_HEVC_SLICE,
+		.min_buffers = 16,
+		.max_buffers = 24,
+		.max_width = 3840,
+		.max_height = 2160,
+		.vdec_ops = &meson_amvdec_hevc_ops,
+		.codec_ops = &meson_amvdec_codec_hevc_ops,
+		.firmware_path = "meson/vdec/sm1_hevc_mmu.bin",
+		.pixfmts_cap = { V4L2_PIX_FMT_NV12M,
+				 V4L2_PIX_FMT_AM21C, 0 },
+		.flags = V4L2_FMT_FLAG_COMPRESSED,
+	}, {
+		/*
+		 * Stateless MPEG-1/2.  The firmware parses picture headers, so
+		 * MPEG2_SLICE (slice data only) needs the sequence and picture
+		 * headers synthesized in-driver from the V4L2 controls, the same
+		 * way HEVC_SLICE does.
+		 */
+		.pixfmt = V4L2_PIX_FMT_MPEG2_SLICE,
+		.min_buffers = 2,
+		.max_buffers = 24,
+		.max_width = 1920,
+		/* 1080 lines are coded as 1088: whole macroblocks, in field pairs */
+		.max_height = 1088,
+		.vdec_ops = &meson_amvdec_1_ops,
+		.codec_ops = &meson_amvdec_codec_mpeg12_sl_ops,
+		.firmware_path = "meson/vdec/gxl_mpeg12_multi.bin",
+		.pixfmts_cap = { V4L2_PIX_FMT_NV12M, 0 },
+		.flags = V4L2_FMT_FLAG_COMPRESSED,
+	},
+};
+
 static const struct amvdec_format amvdec_formats_sm1[] = {
 	{
 		.pixfmt = V4L2_PIX_FMT_VP9,
@@ -394,40 +596,82 @@ static const struct amvdec_format amvdec_formats_sm1[] = {
 	},
 };
 
+const struct amvdec_platform meson_amvdec_platform_gxbb_stateless = {
+	.formats = amvdec_formats_gx_stateless,
+	.num_formats = ARRAY_SIZE(amvdec_formats_gx_stateless),
+	.revision = AMVDEC_REVISION_GXBB,
+};
+
+const struct amvdec_platform meson_amvdec_platform_gxl_stateless = {
+	.formats = amvdec_formats_gx_stateless,
+	.num_formats = ARRAY_SIZE(amvdec_formats_gx_stateless),
+	.revision = AMVDEC_REVISION_GXL,
+};
+
+const struct amvdec_platform meson_amvdec_platform_gxlx_stateless = {
+	.formats = amvdec_formats_gx_stateless,
+	.num_formats = ARRAY_SIZE(amvdec_formats_gx_stateless),
+	.revision = AMVDEC_REVISION_GXLX,
+};
+
+const struct amvdec_platform meson_amvdec_platform_gxm_stateless = {
+	.formats = amvdec_formats_gxm_stateless,
+	.num_formats = ARRAY_SIZE(amvdec_formats_gxm_stateless),
+	.revision = AMVDEC_REVISION_GXM,
+};
+
+const struct amvdec_platform meson_amvdec_platform_g12a_stateless = {
+	.formats = amvdec_formats_g12a_stateless,
+	.num_formats = ARRAY_SIZE(amvdec_formats_g12a_stateless),
+	.revision = AMVDEC_REVISION_G12A,
+};
+
+const struct amvdec_platform meson_amvdec_platform_sm1_stateless = {
+	.formats = amvdec_formats_sm1_stateless,
+	.num_formats = ARRAY_SIZE(amvdec_formats_sm1_stateless),
+	.revision = AMVDEC_REVISION_SM1,
+};
+
 const struct amvdec_platform meson_amvdec_platform_gxbb = {
 	.formats = amvdec_formats_gxbb,
 	.num_formats = ARRAY_SIZE(amvdec_formats_gxbb),
 	.revision = AMVDEC_REVISION_GXBB,
+	.stateless = &meson_amvdec_platform_gxbb_stateless,
 };
 
 const struct amvdec_platform meson_amvdec_platform_gxl = {
 	.formats = amvdec_formats_gxl,
 	.num_formats = ARRAY_SIZE(amvdec_formats_gxl),
 	.revision = AMVDEC_REVISION_GXL,
+	.stateless = &meson_amvdec_platform_gxl_stateless,
 };
 
 const struct amvdec_platform meson_amvdec_platform_gxlx = {
 	.formats = amvdec_formats_gxlx,
 	.num_formats = ARRAY_SIZE(amvdec_formats_gxlx),
 	.revision = AMVDEC_REVISION_GXLX,
+	.stateless = &meson_amvdec_platform_gxlx_stateless,
 };
 
 const struct amvdec_platform meson_amvdec_platform_gxm = {
 	.formats = amvdec_formats_gxm,
 	.num_formats = ARRAY_SIZE(amvdec_formats_gxm),
 	.revision = AMVDEC_REVISION_GXM,
+	.stateless = &meson_amvdec_platform_gxm_stateless,
 };
 
 const struct amvdec_platform meson_amvdec_platform_g12a = {
 	.formats = amvdec_formats_g12a,
 	.num_formats = ARRAY_SIZE(amvdec_formats_g12a),
 	.revision = AMVDEC_REVISION_G12A,
+	.stateless = &meson_amvdec_platform_g12a_stateless,
 };
 
 const struct amvdec_platform meson_amvdec_platform_sm1 = {
 	.formats = amvdec_formats_sm1,
 	.num_formats = ARRAY_SIZE(amvdec_formats_sm1),
 	.revision = AMVDEC_REVISION_SM1,
+	.stateless = &meson_amvdec_platform_sm1_stateless,
 };
 
 MODULE_FIRMWARE("meson/vdec/g12a_h264.bin");
@@ -439,7 +683,13 @@ MODULE_FIRMWARE("meson/vdec/gxl_vp9.bin");
 MODULE_FIRMWARE("meson/vdec/gxm_h264.bin");
 MODULE_FIRMWARE("meson/vdec/sm1_vp9_mmu.bin");
 MODULE_FIRMWARE("meson/vdec/g12a_hevc_mmu.bin");
+MODULE_FIRMWARE("meson/vdec/g12a_h264_multi.bin");
+MODULE_FIRMWARE("meson/vdec/gxl_h264_multi.bin");
+MODULE_FIRMWARE("meson/vdec/gxm_h264_multi.bin");
 MODULE_FIRMWARE("meson/vdec/gxl_hevc.bin");
+MODULE_FIRMWARE("meson/vdec/gxl_mpeg12_multi.bin");
+MODULE_FIRMWARE("meson/vdec/sm1_h264_multi.bin");
+MODULE_FIRMWARE("meson/vdec/sm1_hevc_mmu.bin");
 MODULE_FIRMWARE("meson/vdec/gxl_mpeg4_5.bin");
 MODULE_FIRMWARE("meson/vdec/gxl_h263.bin");
 MODULE_FIRMWARE("meson/vdec/g12a_vc1.bin");
diff --git a/drivers/media/platform/amlogic/amvdec/amvdec_platform.h b/drivers/media/platform/amlogic/amvdec/amvdec_platform.h
index e3012eacad..16fbbfaf57 100644
--- a/drivers/media/platform/amlogic/amvdec/amvdec_platform.h
+++ b/drivers/media/platform/amlogic/amvdec/amvdec_platform.h
@@ -33,6 +33,12 @@ extern const struct amvdec_platform meson_amvdec_platform_gxm;
 extern const struct amvdec_platform meson_amvdec_platform_gxl;
 extern const struct amvdec_platform meson_amvdec_platform_gxlx;
 extern const struct amvdec_platform meson_amvdec_platform_g12a;
+extern const struct amvdec_platform meson_amvdec_platform_gxbb_stateless;
+extern const struct amvdec_platform meson_amvdec_platform_gxl_stateless;
+extern const struct amvdec_platform meson_amvdec_platform_gxlx_stateless;
+extern const struct amvdec_platform meson_amvdec_platform_gxm_stateless;
+extern const struct amvdec_platform meson_amvdec_platform_g12a_stateless;
+extern const struct amvdec_platform meson_amvdec_platform_sm1_stateless;
 extern const struct amvdec_platform meson_amvdec_platform_sm1;
 
 #endif
