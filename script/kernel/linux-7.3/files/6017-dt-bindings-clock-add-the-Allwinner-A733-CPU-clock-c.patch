From 98aa36cc924de0c1da0d01152102da249ebd198a Mon Sep 17 00:00:00 2001
From: Jernej Skrabec <jernej.skrabec@gmail.com>
Date: Thu, 3 Sep 2026 10:47:59 +0200
Subject: [PATCH 069/211] dt-bindings: clock: add the Allwinner A733 CPU clock
 controller

The A733 clocks its two CPU clusters and the DSU from a block separate
from the CCU. It holds a linear PLL for each of the three, a generic
backup PLL, and a clock selector per consumer that can also fall back to
the oscillator or to a peripheral PLL output.

Signed-off-by: Jernej Skrabec <jernej.skrabec@gmail.com>
---
 .../clock/allwinner,sun60i-a733-cpu-ccu.yaml  | 61 +++++++++++++++++++
 .../dt-bindings/clock/sun60i-a733-cpu-ccu.h   | 17 ++++++
 2 files changed, 78 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/clock/allwinner,sun60i-a733-cpu-ccu.yaml
 create mode 100644 include/dt-bindings/clock/sun60i-a733-cpu-ccu.h

diff --git a/Documentation/devicetree/bindings/clock/allwinner,sun60i-a733-cpu-ccu.yaml b/Documentation/devicetree/bindings/clock/allwinner,sun60i-a733-cpu-ccu.yaml
new file mode 100644
index 0000000000..466fe7b12b
--- /dev/null
+++ b/Documentation/devicetree/bindings/clock/allwinner,sun60i-a733-cpu-ccu.yaml
@@ -0,0 +1,61 @@
+# SPDX-License-Identifier: (GPL-2.0+ OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/clock/allwinner,sun60i-a733-cpu-ccu.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Allwinner A733 CPU Clock Controller
+
+maintainers:
+  - Jernej Skrabec <jernej.skrabec@gmail.com>
+
+description:
+  The A733 clocks its CPU clusters and the DSU from a block separate from
+  the CCU. It holds one PLL per cluster, one for the DSU and a backup PLL,
+  plus a clock selector for each of the three consumers.
+
+properties:
+  compatible:
+    const: allwinner,sun60i-a733-cpu-ccu
+
+  reg:
+    maxItems: 1
+
+  clocks:
+    items:
+      - description: High Frequency Oscillator (DCXO)
+      - description: Peripheral PLL doubled output, backup for the clusters
+      - description: Peripheral PLL 600 MHz output, backup for the DSU
+
+  clock-names:
+    items:
+      - const: hosc
+      - const: pll-periph0-2x
+      - const: pll-periph0-600m
+
+  "#clock-cells":
+    const: 1
+
+required:
+  - compatible
+  - reg
+  - clocks
+  - clock-names
+  - "#clock-cells"
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/clock/sun60i-a733-ccu.h>
+
+    clock-controller@8870000 {
+        compatible = "allwinner,sun60i-a733-cpu-ccu";
+        reg = <0x08870000 0x4000>;
+        clocks = <&osc26M>, <&ccu CLK_PLL_PERIPH0_2X>,
+                 <&ccu CLK_PLL_PERIPH0_600M>;
+        clock-names = "hosc", "pll-periph0-2x", "pll-periph0-600m";
+        #clock-cells = <1>;
+    };
+
+...
diff --git a/include/dt-bindings/clock/sun60i-a733-cpu-ccu.h b/include/dt-bindings/clock/sun60i-a733-cpu-ccu.h
new file mode 100644
index 0000000000..2abe74c50d
--- /dev/null
+++ b/include/dt-bindings/clock/sun60i-a733-cpu-ccu.h
@@ -0,0 +1,17 @@
+/* SPDX-License-Identifier: (GPL-2.0-only OR MIT) */
+/*
+ * Copyright (C) 2026 Jernej Skrabec <jernej.skrabec@gmail.com>
+ */
+
+#ifndef _DT_BINDINGS_CLK_SUN60I_A733_CPU_CCU_H_
+#define _DT_BINDINGS_CLK_SUN60I_A733_CPU_CCU_H_
+
+#define CLK_PLL_CPU_BACK	0
+#define CLK_PLL_CPU_L		1
+#define CLK_PLL_CPU_B		2
+#define CLK_PLL_CPU_DSU		3
+#define CLK_CPU_L		4
+#define CLK_CPU_B		5
+#define CLK_CPU_DSU		6
+
+#endif /* _DT_BINDINGS_CLK_SUN60I_A733_CPU_CCU_H_ */
-- 
