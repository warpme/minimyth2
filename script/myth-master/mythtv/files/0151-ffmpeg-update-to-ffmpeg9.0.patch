diff --git a/mythtv/external/FFmpeg/tests/api/api-enc-parser-test.c b/mythtv/external/FFmpeg/tests/api/api-enc-parser-test.c
new file mode 100644
index 00000000000..0c37bcf52d7
--- /dev/null
+++ b/mythtv/external/FFmpeg/tests/api/api-enc-parser-test.c
@@ -0,0 +1,389 @@
+/*
