From a56afa86bd1af8a04105244ccf4200c6a7b9d10c Mon Sep 17 00:00:00 2001
From: Piotr Oniszczuk <piotr.oniszczuk@gmail.com>
Date: Sat, 21 Nov 2026 18:43:48 +0100
Subject: [PATCH 01/10] clk: meson: allow more than 255 clocks per controller

The number of clocks of a controller is stored in an u8. The Amlogic
S6 peripherals clock controller exposes 290 clock IDs, plus the
external inputs which are numbered after them, so the count would be
truncated and most of the clocks rejected as out of range.

Store the count in an unsigned int. No functional change for the
existing controllers.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: Piotr Oniszczuk <piotr.oniszczuk@gmail.com>
---
 drivers/clk/meson/clk_meson.h | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/drivers/clk/meson/clk_meson.h b/drivers/clk/meson/clk_meson.h
index 46ee5519..bb6275ac 100644
--- a/drivers/clk/meson/clk_meson.h
+++ b/drivers/clk/meson/clk_meson.h
@@ -105,7 +105,7 @@ struct meson_clk_info {
  *
  */
 struct meson_clk_data {
-	const u8 num_clocks;
+	const unsigned int num_clocks;
 	const struct meson_clk_info **clocks;
 };
 
